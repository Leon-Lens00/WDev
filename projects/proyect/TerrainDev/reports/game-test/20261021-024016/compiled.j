        endfunction

function TerrainDevProbe___Spawn takes integer kind,integer count returns nothing
    local integer i= 0
    local integer j
    local real y= TerrainDevProbe___sy + I2R(kind) * 300.
    local integer m
    loop
        exitwhen i == count
        set m=s__Missile_createXYZ(TerrainDevProbe___sx , y , 50. , TerrainDevProbe___sx + 1000. , y , 50.)
        set TerrainDevProbe___created=TerrainDevProbe___created + 1
        set TerrainDevProbe___trackedDummy[TerrainDevProbe___created]=s__Missile_dummy[m]
        set TerrainDevProbe___mode[m]=kind
        set TerrainDevProbe___age[m]=0
        call s__Missile__set_model(m,"Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl")
        set s__Missile_speed[(m)]=((1000.)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
        set s__Missile_owner[m]=Player(0)
        if kind == 0 then
            if i < 10 then
                call s__Missile__set_arc(m,0.3)
            elseif i < 20 then
                call s__Missile__set_curve(m,0.3)
            endif
            if TerrainDevProbe___created <= 30 then
                set TerrainDevProbe___firstDummy[i]=s__Missile_dummy[m]
            else
                set j=0
                loop
                    exitwhen j == 30
                    if TerrainDevProbe___firstDummy[j] == s__Missile_dummy[m] then
                        set TerrainDevProbe___reused=TerrainDevProbe___reused + 1
                        exitwhen true
                    endif
                    set j=j + 1
                endloop
            endif
        elseif kind == 1 then
            set s__Missile_collision[m]=80.
        elseif kind == 2 then
            set s__Missile_target[m]=TerrainDevProbe___homeTarget
            set s__Missile_turn[m]=0.2
        endif
        call s__TerrainDevProbe___Flight_launch(m)
        set i=i + 1
    endloop
endfunction

function TerrainDevProbe___Finish takes nothing returns nothing
    local group g= CreateGroup()
    local unit u
    local integer dummyCount= 0
    local integer pooled= 0
    local integer casterCount= 0
    local integer overflow= 0
    local integer liveUnpooled= 0
    local integer i= 1
    local integer seen= s__Table_create()
    // Locust units are not covered by GroupEnumUnitsInRect. Observe the handles
    // actually returned by Missile instead, deduplicating reused handles.
    loop
        exitwhen i > TerrainDevProbe___created
        set u=TerrainDevProbe___trackedDummy[i]
        if not (LoadBoolean(Table___ht, (((seen))), (GetHandleId(u)))) then // INLINED!!
            call SaveBoolean(Table___ht, (((seen))), (GetHandleId(u)), ( true)) // INLINED!!
            set dummyCount=dummyCount + 1
            if GetUnitUserData(u) == - 1 and UnitAlive(u) then
                set pooled=pooled + 1
            elseif not UnitAlive(u) then
                set overflow=overflow + 1
            else
                set liveUnpooled=liveUnpooled + 1
            endif
        endif
        set i=i + 1
    endloop
    call s__Table_destroy(seen)
    // The caster uses Locust too; its inherited building type is enumerable.
    call GroupEnumUnitsInRect(g, s__WorldBounds_world, null)
    loop
        set u=FirstOfGroup(g)
        exitwhen u == null
        call GroupRemoveUnit(g, u)
        if GetUnitTypeId(u) == 'dcst' then
            set casterCount=casterCount + 1
        endif
    endloop
    call DestroyGroup(g)
    if TerrainDevProbe___created != 90 or TerrainDevProbe___removed != 90 or TerrainDevProbe___finished != 70 or TerrainDevProbe___collided != 10 or TerrainDevProbe___cancelled != 10 then
        set TerrainDevProbe___failed=TerrainDevProbe___failed + 1
    endif
    // Angle buckets have a fixed capacity and legitimately discard surplus.
    // Require observed reuse, no live unpooled leftovers, and full accounting.
    if pooled < 1 or TerrainDevProbe___reused < 1 or pooled + overflow != dummyCount or liveUnpooled != 0 or casterCount != 1 or TerrainDevProbe___timerChecks != 1 or TerrainDevProbe___callbacks == 0 then
        set TerrainDevProbe___failed=TerrainDevProbe___failed + 1
    endif
    call PreloadGenClear()
    call PreloadGenStart()
    call Preload("TERRAINDEV RUN 20261021-024016 COMPLETE")
    call Preload("created=" + I2S(TerrainDevProbe___created) + " removed=" + I2S(TerrainDevProbe___removed) + " finished=" + I2S(TerrainDevProbe___finished) + " collided=" + I2S(TerrainDevProbe___collided) + " cancelled=" + I2S(TerrainDevProbe___cancelled))
    call Preload("dummies=" + I2S(dummyCount) + " pooled=" + I2S(pooled) + " overflow=" + I2S(overflow) + " liveUnpooled=" + I2S(liveUnpooled) + " casters=" + I2S(casterCount) + " reused=" + I2S(TerrainDevProbe___reused) + " timerChecks=" + I2S(TerrainDevProbe___timerChecks) + " callbacks=" + I2S(TerrainDevProbe___callbacks))
    call Preload("failures=" + I2S(TerrainDevProbe___failed))
    call PreloadGenEnd("Logs\\TerrainDev-20261021-024016-result.txt")
    call BJDebugMsg("TerrainDev integration: failures=" + I2S(TerrainDevProbe___failed) + " removed=" + I2S(TerrainDevProbe___removed) + "/90")
    call DestroyTimer(GetExpiredTimer())
    set u=null
    set g=null
endfunction

function TerrainDevProbe___SecondBatch takes nothing returns nothing
    call TerrainDevProbe___Spawn(0 , 30)
    call TerrainDevProbe___Spawn(1 , 10)
    call TerrainDevProbe___Spawn(2 , 10)
    call TerrainDevProbe___Spawn(3 , 10)
    call SetUnitX(TerrainDevProbe___homeTarget, TerrainDevProbe___sx + 850.)
    call SetUnitY(TerrainDevProbe___homeTarget, TerrainDevProbe___sy + 700.)
    call DestroyTimer(GetExpiredTimer())
endfunction

function TerrainDevProbe___TimerCheck takes nothing returns nothing
    if (LoadInteger(TimerUtils__ht, 0, GetHandleId((GetExpiredTimer())))) == 127 then // INLINED!!
        set TerrainDevProbe___timerChecks=TerrainDevProbe___timerChecks + 1
    endif
    call ReleaseTimer(GetExpiredTimer())
endfunction

function TerrainDevProbe___Begin takes nothing returns nothing
    local integer table= s__Table_create()
    local timer t= NewTimerEx(127)
    call SaveInteger(Table___ht, (table), (127), ( 251)) // INLINED!!
    if (LoadInteger(Table___ht, (table), (127))) != 251 or s__WorldBounds_maxX <= s__WorldBounds_minX or (( IssueTargetOrderById(IsDestructableTree__harvester, IsDestructableTree__HARVEST_ORDER_ID, (null)) ) and ( IssueImmediateOrderById(IsDestructableTree__harvester, 851973) )) then // INLINED!!
        set TerrainDevProbe___failed=TerrainDevProbe___failed + 1
    endif
    call RemoveSavedInteger(Table___ht, (table), (127)) // INLINED!!
    if (HaveSavedInteger(Table___ht, (table), (127))) then // INLINED!!
        set TerrainDevProbe___failed=TerrainDevProbe___failed + 1
    endif
    call s__Table_destroy(table)
    call TimerStart(t, 0.1, false, function TerrainDevProbe___TimerCheck)
    set TerrainDevProbe___sx=GetStartLocationX(0)
    set TerrainDevProbe___sy=GetStartLocationY(0)
    set TerrainDevProbe___hitTarget=CreateUnit(Player(15), 'hfoo', TerrainDevProbe___sx + 500., TerrainDevProbe___sy + 300., 0.)
    set TerrainDevProbe___homeTarget=CreateUnit(Player(15), 'hfoo', TerrainDevProbe___sx + 1000., TerrainDevProbe___sy + 600., 0.)
    call UnitAddAbility(TerrainDevProbe___hitTarget, 'Avul')
    call UnitAddAbility(TerrainDevProbe___homeTarget, 'Avul')
    call SetUnitPathing(TerrainDevProbe___hitTarget, false)
    call SetUnitPathing(TerrainDevProbe___homeTarget, false)
    call SetUnitX(TerrainDevProbe___hitTarget, TerrainDevProbe___sx + 500.)
    call SetUnitY(TerrainDevProbe___hitTarget, TerrainDevProbe___sy + 300.)
    call SetUnitX(TerrainDevProbe___homeTarget, TerrainDevProbe___sx + 1000.)
    call SetUnitY(TerrainDevProbe___homeTarget, TerrainDevProbe___sy + 600.)
