function DiagnosticsProbe__Idle takes nothing returns nothing
    call s__MissileStats_inspect()
    if s__MissileStats_active != 0 or s__MissileStats_pooled != 96 or s__MissileStats_tracked != 96 or s__MissileStats_preloadTotal != 96 or s__MissileStats_alarms != 0 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    if s__MissileStats_board == null or MultiboardGetRowCount(s__MissileStats_board) != 19 or MultiboardGetColumnCount(s__MissileStats_board) != 2 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    call DiagnosticsProbe__Log("idle")
    call DestroyTimer(GetExpiredTimer())
endfunction

function DiagnosticsProbe__Normal takes nothing returns nothing
    call s__MissileStats_inspect()
    if s__MissileStats_active != 0 or s__MissileStats_created != 90 or s__MissileStats_retired != 90 or s__MissileStats_peakActive != 60 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    if s__MissileStats_tracked != 96 or s__MissileStats_pooled != 96 or s__MissileStats_borrowed != 0 or s__MissileStats_pending != 0 or s__MissileStats_deferred != 0 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    if s__MissileStats_newTotal != 66 or s__MissileStats_reusedTotal != 24 or s__MissileStats_disposed != 66 or s__MissileStats_alarms != 0 or s__MissileStats_omitted != 0 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    set DiagnosticsProbe__normalDone=true
    call DiagnosticsProbe__Log("normal")
    call BJDebugMsg("Panel listo: -diag-diferido, -diag-negativo, -diag-recuperar")
    call DestroyTimer(GetExpiredTimer())
endfunction

