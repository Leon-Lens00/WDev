            call Missile__StartPeriodic(si__TerrainDevProbe___Flight)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__TerrainDevProbe___Flight_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__TerrainDevProbe___Flight_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile__RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile__StopPeriodic(si__TerrainDevProbe___Flight)
