function DiagnosticsProbe__DelayedCheck takes nothing returns nothing
    call s__MissileStats_inspect()
    if s__MissileStats_deferred != 1 or s__MissileStats_active != 0 or s__MissileStats_pooled != 95 or s__MissileStats_borrowed != 0 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    call DiagnosticsProbe__Log("deferred")
    call DestroyTimer(GetExpiredTimer())
endfunction

function DiagnosticsProbe__DelayedDone takes nothing returns nothing
    call s__MissileStats_inspect()
    if s__MissileStats_deferred != 0 or s__MissileStats_active != 0 or s__MissileStats_pooled != 96 or s__MissileStats_alarms != 0 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    set DiagnosticsProbe__delayDone=true
    call DiagnosticsProbe__Log("deferred-done")
    call DestroyTimer(GetExpiredTimer())
endfunction

function DiagnosticsProbe__StartDelay takes nothing returns nothing
    local real x= GetStartLocationX(0)
    local real y= GetStartLocationY(0)
    local integer m
    if not DiagnosticsProbe__normalDone or DiagnosticsProbe__delayStarted then
        return
    endif
    set DiagnosticsProbe__delayStarted=true
    set m=s__Missile_createXYZ(x , y , 50. , x + 300. , y , 50.)
    set s__Missile_speed[(m)]=((1000.)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
    call s__DiagnosticsProbe__Delayed_launch(m)
    call TimerStart(CreateTimer(), 1., false, function DiagnosticsProbe__DelayedCheck)
    call TimerStart(CreateTimer(), 6., false, function DiagnosticsProbe__DelayedDone)
endfunction

function DiagnosticsProbe__OverdueCheck takes nothing returns nothing
    call s__MissileStats_inspect()
    if s__MissileStats_pending != 1 or s__MissileStats_overdue != 1 or s__MissileStats_alarms != 1 or s__MissileStats_adoptedTotal != 1 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    call DiagnosticsProbe__Log("overdue")
    call DestroyTimer(GetExpiredTimer())
endfunction

function DiagnosticsProbe__Negative takes nothing returns nothing
    if not DiagnosticsProbe__delayDone or DiagnosticsProbe__stuck != null then
        return
    endif
    // Reproduce the original lifetime bug only in this diagnostic fixture.
    set DiagnosticsProbe__stuck=CreateUnit(Player(14), 'dumi', GetStartLocationX(0), GetStartLocationY(0), 0.)
    call RecycleMissile(DiagnosticsProbe__stuck)
    call PauseUnit(DiagnosticsProbe__stuck, true)
    call TimerStart(CreateTimer(), 6., false, function DiagnosticsProbe__OverdueCheck)
endfunction

function DiagnosticsProbe__RecoveredCheck takes nothing returns nothing
    call s__MissileStats_inspect()
    if s__MissileStats_pending != 0 or s__MissileStats_overdue != 0 or s__MissileStats_tracked != 96 or s__MissileStats_pooled != 96 or s__MissileStats_disposed != 67 or s__MissileStats_alarms != 1 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    set DiagnosticsProbe__stuck=null
    call DiagnosticsProbe__Log("recovered")
    call DestroyTimer(GetExpiredTimer())
endfunction

function DiagnosticsProbe__Recover takes nothing returns nothing
    if DiagnosticsProbe__stuck == null then
        return
    endif
    call PauseUnit(DiagnosticsProbe__stuck, false)
    call TimerStart(CreateTimer(), 4., false, function DiagnosticsProbe__RecoveredCheck)
endfunction

function DiagnosticsProbe__Invalid takes nothing returns nothing
    call RecycleMissile(null)
    if s__MissileStats_invalid != 1 or s__MissileStats_alarms != 2 then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    call DiagnosticsProbe__Log("invalid")
endfunction

function DiagnosticsProbe__Hidden takes nothing returns nothing
    if IsMultiboardDisplayed(s__MissileStats_board) then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    call DiagnosticsProbe__Log("hidden")
endfunction

function DiagnosticsProbe__Visible takes nothing returns nothing
    if not IsMultiboardDisplayed(s__MissileStats_board) then
        set DiagnosticsProbe__failures=DiagnosticsProbe__failures + 1
    endif
    call DiagnosticsProbe__Log("visible")
endfunction

function DiagnosticsProbe__Register takes string text,code action returns nothing
    local trigger t= CreateTrigger()
    call TriggerRegisterPlayerChatEvent(t, Player(0), text, true)
    call TriggerAddAction(t, action)
    set t=null
endfunction

function DiagnosticsProbe__Init takes nothing returns nothing
    call TimerStart(CreateTimer(), 0.5, false, function DiagnosticsProbe__Idle)
    call TimerStart(CreateTimer(), 17., false, function DiagnosticsProbe__Normal)
    call DiagnosticsProbe__Register("-diag-diferido" , function DiagnosticsProbe__StartDelay)
    call DiagnosticsProbe__Register("-diag-negativo" , function DiagnosticsProbe__Negative)
    call DiagnosticsProbe__Register("-diag-recuperar" , function DiagnosticsProbe__Recover)
    call DiagnosticsProbe__Register("-diag-invalido" , function DiagnosticsProbe__Invalid)
    call DiagnosticsProbe__Register("-diag-oculto" , function DiagnosticsProbe__Hidden)
    call DiagnosticsProbe__Register("-diag-visible" , function DiagnosticsProbe__Visible)
endfunction


