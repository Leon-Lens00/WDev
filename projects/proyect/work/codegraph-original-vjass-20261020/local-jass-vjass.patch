+import { afterEach, describe, expect, it } from 'vitest';
+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import { CodeGraph } from '../src';
+import { extractFromSource } from '../src/extraction/tree-sitter';
+import { detectLanguage, getSupportedLanguages } from '../src/extraction/grammars';
+import { createDatabase } from '../src/db/sqlite-adapter';
+import { ToolHandler } from '../src/mcp/tools';
+
+const fn = (name: string, body = '', prefix = '') => `${prefix}function ${name} takes nothing returns nothing\n${body}\nendfunction\n`;
+
+describe('JASS/vJASS structural extraction', () => {
+  it('detects all three extensions, including uppercase', () => {
+    expect(detectLanguage('a.j')).toBe('jass');
+    expect(detectLanguage('a.JASS')).toBe('jass');
+    expect(detectLanguage('a.VJASS')).toBe('vjass');
+    expect(getSupportedLanguages()).toEqual(expect.arrayContaining(['jass', 'vjass']));
+  });
+
+  it('extracts containers, fields, parameter/local types, returns and native signatures', () => {
+    const source = `type widget extends handle\nnative NativePing takes widget w returns integer\nlibrary Demo initializer Init requires optional Utils\nglobals\n private integer N = NativePing(null)\nendglobals\nstruct Counter\n real speed\n method tick takes Counter other returns thistype\n local Counter c = other\n call c.tick(this)\n return this\n endmethod\nendstruct\n${fn('Init')}endlibrary\n`;
+    const result = extractFromSource('demo.vjass', source);
+    expect(result.errors).toEqual([]);
+    expect(result.nodes.map(n => [n.kind, n.qualifiedName])).toEqual(expect.arrayContaining([
+      ['type_alias', 'widget'], ['function', 'NativePing'], ['parameter', 'NativePing.w'],
+      ['namespace', 'Demo'], ['variable', 'Demo.N'], ['struct', 'Demo.Counter'],
+      ['field', 'Demo.Counter.speed'], ['method', 'Demo.Counter.tick'],
+      ['parameter', 'Demo.Counter.tick.other'], ['variable', 'Demo.Counter.tick.c'],
+    ]));
+    expect(result.unresolvedReferences).toEqual(expect.arrayContaining([
+      expect.objectContaining({ referenceName: 'Utils', referenceKind: 'imports' }),
+      expect.objectContaining({ referenceName: 'Init', referenceKind: 'calls' }),
+      expect.objectContaining({ referenceName: 'NativePing', referenceKind: 'calls' }),
+      expect.objectContaining({ referenceName: 'c.tick', referenceKind: 'calls' }),
+    ]));
+    expect(result.nodes.find(n => n.qualifiedName === 'Demo.Counter.tick')?.endLine).toBe(13);
+  });
+
+  it('ignores literal/comment call-shaped text and preserves BOM/CRLF locations', () => {
+    const source = '\uFEFF' + fn('Run', ' local string x = "call Fake() //! textmacro M"\n local integer id = \'hfoo\'\n // call Comment()\n /* call Block() */\n call Real()').replace(/\n/g, '\r\n');
+    const result = extractFromSource('main.j', source);
+    expect(result.errors).toEqual([]);
+    expect(result.unresolvedReferences.filter(r => r.referenceKind === 'calls').map(r => [r.referenceName, r.line])).toEqual([['Real', 6]]);
+    expect(result.nodes.find(n => n.name === 'Run')?.startLine).toBe(1);
+  });
+
+  it('excludes templates and Zinc, exposes directives, and does not treat a commented directive as real', () => {
+    const source = `/*\n//! zinc\n*/\n//! textmacro M\n${fn('Template')}//! endtextmacro\n//! zinc\nfunction NotJass() {}\n//! endzinc\n//! runtextmacro M()\n//! import "not-followed.j"\n${fn('Real')}`;
+    const result = extractFromSource('main.j', source);
+    expect(result.nodes.filter(n => n.kind === 'function').map(n => n.name)).toEqual(['Real']);
+    expect(result.errors.filter(e => e.code === 'jass_partial_coverage')).toHaveLength(4);
+  });
+
+  it('reports malformed input instead of claiming a complete parse', () => {
+    for (const body of ['function Broken takes nothing returns nothing\n', 'endstruct\n', 'globals\n', '/* broken', '"broken\n', '//! zinc\n']) {
+      expect(extractFromSource('broken.j', body).errors.some(e => e.severity === 'error')).toBe(true);
+    }
+  });
+
+  it('captures explicit callbacks, qualified callbacks and potential dynamic boundaries', () => {
+    const result = extractFromSource('callback.j', fn('Wire', ' call TimerStart(t, 1., false, function Done)\n call Register(function Counter.done)\n call ExecuteFunc("Hidden")\n call Do.evaluate()'));
+    expect(result.unresolvedReferences.filter(r => r.referenceKind === 'function_ref').map(r => r.referenceName)).toEqual(['Done', 'Counter.done']);
+    expect(result.unresolvedReferences.some(r => r.referenceName === 'Hidden')).toBe(false);
+    expect(result.errors.filter(e => e.severity === 'warning')).toHaveLength(2);
+  });
+
+  it('does not invent this.method for a chained factory/index receiver', () => {
+    const result = extractFromSource('chain.vjass', fn('Run', ' call Factory().tick()\n call values[0].tick()'));
+    expect(result.unresolvedReferences.some(r => r.referenceName === 'this.tick')).toBe(false);
+    expect(result.errors.filter(e => e.severity === 'warning')).toHaveLength(2);
+  });
+
+  it('interfaces have bodyless method declarations and module expansion stays explicit', () => {
+    const result = extractFromSource('types.vjass', 'interface I\n method tick takes nothing returns nothing defaults nothing\nendinterface\nmodule M\n method ping takes nothing returns nothing\n endmethod\nendmodule\nstruct S\n implement M\nendstruct\n');
+    expect(result.errors.some(e => e.severity === 'error')).toBe(false);
+    expect(result.errors.some(e => /implement/.test(e.message))).toBe(true);
+    expect(result.nodes.find(n => n.qualifiedName === 'I.tick')?.isAbstract).toBe(true);
+  });
+
+  it('does not merge distinct operator bodies and makes missing access dispatch explicit', () => {
+    const result = extractFromSource('operators.vjass', 'struct S\n method operator value takes nothing returns integer\n return 0\n endmethod\n method operator value= takes integer v returns nothing\n endmethod\nendstruct\n');
+    expect(result.nodes.filter(n => n.kind === 'method').map(n => n.name)).toEqual(['operator value', 'operator value=']);
+    expect(result.errors.filter(e => e.code === 'jass_partial_coverage')).toHaveLength(2);
+  });
+
+  it('rejects escaped newlines in literals and resumes extraction on the next line', () => {
+    const result = extractFromSource('literal.j', fn('Run', ' local string x = "broken\\\n call Real()'));
+    expect(result.errors.some(e => e.code === 'jass_parse_error')).toBe(true);
+    expect(result.unresolvedReferences.some(r => r.referenceName === 'Real')).toBe(true);
+  });
+});
+
+describe('JASS/vJASS original CodeGraph SQLite/index/resolver/sync', { timeout: 60_000 }, () => {
+  let root: string;
+  let cg: CodeGraph | undefined;
+  const write = (file: string, source: string) => fs.writeFileSync(path.join(root, file), source);
+  const init = async (files: Record<string, string>) => {
+    root = fs.mkdtempSync(path.join(os.tmpdir(), 'codegraph-jass-'));
+    for (const [file, source] of Object.entries(files)) write(file, source);
+    cg = await CodeGraph.init(root);
+    const result = await cg.indexAll();
+    expect(result.success, JSON.stringify(result.errors)).toBe(true);
+    return cg;
+  };
+  const symbol = (qualified: string) => cg!.getNodesByQualifiedName(qualified)[0]!;
+  const callees = (qualified: string) => cg!.getCallees(symbol(qualified).id).map(c => c.node.qualifiedName).sort();
+  const edges = () => {
+    const { db } = createDatabase(path.join(root, '.codegraph', 'codegraph.db'), { readOnly: true });
+    try { return new Set((db.prepare('SELECT source,target,kind FROM edges').all() as Array<{ source: string; target: string; kind: string }>).map(e => `${e.source}|${e.target}|${e.kind}`)); }
+    finally { db.close(); }
+  };
+  afterEach(() => { cg?.destroy(); cg = undefined; if (root) fs.rmSync(root, { recursive: true, force: true }); });
+
+  it('persists native edges, cross-file callbacks, callers, impact and reopen', async () => {
+    await init({ 'api.j': fn('Ping'), 'callback.jass': fn('Done', ' call Ping()'),
+      'main.vjass': fn('Run', ' call Ping()\n call Register(function Done)'), 'native.j': 'native Register takes code callback returns nothing\n' });
+    expect(cg!.getFiles()).toHaveLength(4);
+    expect(callees('Run')).toEqual(['Done', 'Ping', 'Register']);
+    expect(cg!.getCallers(symbol('Ping').id).map(c => c.node.name).sort()).toEqual(['Done', 'Run']);
+    expect(cg!.getImpactRadius(symbol('Ping').id).nodes.has(symbol('Run').id)).toBe(true);
+    const before = edges();
+    cg!.destroy();
+    cg = await CodeGraph.open(root);
+    expect(edges()).toEqual(before);
+    expect(callees('Run')).toContain('Ping');
+    const explored = await new ToolHandler(cg).execute('codegraph_explore', { query: 'Run Ping Done' });
+    expect(explored.isError).not.toBe(true);
+    expect(explored.content[0]?.text).toContain('JASS/vJASS local support');
+    expect(explored.content[0]?.text).toContain('call Ping()');
+  });
+
+  it('uses scoped private functions, explicit public prefixes, exact case and no cross-language fallback', async () => {
+    await init({
+      'one.j': `library One\n${fn('Hidden', '', 'private ')}${fn('Exported', '', 'public ')}${fn('Inside', ' call Hidden()\n call Exported()')}endlibrary\n`,
+      'two.jass': `library Two\n${fn('Hidden', '', 'private ')}${fn('Inside', ' call Hidden()')}endlibrary\n`,
+      'main.vjass': fn('Run', ' call Hidden()\n call Exported()\n call One_Exported()\n call inside()\n call JsOnly()'),
+      'other.js': 'function JsOnly() {}\n',
+    });
+    expect(callees('One.Inside')).toEqual(['One.Exported', 'One.Hidden']);
+    expect(callees('Two.Inside')).toEqual(['Two.Hidden']);
+    expect(callees('Run')).toEqual(['One.Exported']);
+  });
+
+  it('resolves declared locals, parameters, fields, this/thistype and inherited methods without name guessing', async () => {
+    await init({
+      'types.vjass': `library Demo\nstruct Base\n method tick takes nothing returns nothing\n endmethod\nendstruct\nstruct Child extends Base\n Child child\n static method start takes nothing returns nothing\n endmethod\n method run takes Child other returns nothing\n local Child c = other\n call c.tick()\n call other.tick()\n call this.tick()\n call .tick()\n call this.child.tick()\n call thistype.start()\n call mystery.tick()\n endmethod\nendstruct\nendlibrary\n`,
+    });
+    expect(callees('Demo.Child.run')).toEqual(['Demo.Base.tick', 'Demo.Child.start']);
+    const { db } = createDatabase(path.join(root, '.codegraph', 'codegraph.db'), { readOnly: true });
+    try {
+      const rows = db.prepare("SELECT line,metadata FROM edges WHERE source=? AND kind='calls'").all(symbol('Demo.Child.run').id) as Array<{ line: number; metadata: string }>;
+      expect(rows).toHaveLength(6);
+      expect(rows.every(e => JSON.parse(e.metadata).jassStaticSubset)).toBe(true);
+    } finally { db.close(); }
+  });
+
+  it('does not resolve an ambiguous free function or unknown receiver to a unique method', async () => {
+    await init({ 'a.j': fn('Duplicate'), 'b.jass': fn('Duplicate'),
+      'type.vjass': 'struct S\n method tick takes nothing returns nothing\n endmethod\nendstruct\n',
+      'main.j': fn('Run', ' call Duplicate()\n call missing.tick()\n call tick()') });
+    expect(callees('Run')).toEqual([]);
+  });
+
+  it('syncs changes, additions, deletion and line shifts to the same edge set as a fresh rebuild', async () => {
+    await init({ 'api.j': fn('Ping'), 'main.vjass': fn('Run', ' call Ping()') });
+    write('api.j', '\n' + fn('Ping', ' call Pong()'));
+    write('new.jass', fn('Pong'));
+    await cg!.sync();
+    expect(callees('Ping')).toEqual(['Pong']);
+    expect(callees('Run')).toEqual(['Ping']);
+    fs.unlinkSync(path.join(root, 'new.jass'));
+    await cg!.sync();
+    expect(callees('Ping')).toEqual([]);
+    const synced = edges();
+    cg!.destroy();
+    cg = await CodeGraph.recreate(root);
+    await cg.indexAll();
+    expect(edges()).toEqual(synced);
+    expect(callees('Run')).toEqual(['Ping']);
+  });
+});
diff --git a/scripts/probe-jass.mjs b/scripts/probe-jass.mjs
new file mode 100644
index 0000000..954f621
--- /dev/null
+++ b/scripts/probe-jass.mjs
@@ -0,0 +1,62 @@
+// Deterministic local probes; not an agent A/B or a language-completeness claim.
+// Usage: node --liftoff-only scripts/probe-jass.mjs SOURCE_ROOT...
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+const { CodeGraph } = require('../dist');
+const { ToolHandler } = require('../dist/mcp/tools');
+
+const reports = [];
+for (const input of process.argv.slice(2)) {
+  const root = path.resolve(input);
+  const sources = fs.readdirSync(root).filter(f => /\.(?:j|jass|vjass)$/i.test(f)).sort();
+  const hashes = () => Object.fromEntries(sources.map(f => [f, crypto.createHash('sha256').update(fs.readFileSync(path.join(root, f))).digest('hex')]));
+  const before = hashes();
+  let cg = fs.existsSync(path.join(root, '.codegraph')) ? await CodeGraph.recreate(root) : await CodeGraph.init(root);
+  const started = performance.now();
+  try {
+    const indexed = await cg.indexAll();
+    assert.ok(indexed.success, JSON.stringify(indexed.errors));
+    assert.equal(cg.getStats().fileCount, sources.length);
+    const node = name => {
+      const found = cg.getNodesByQualifiedName(name);
+      assert.equal(found.length, 1, `ambiguous/missing ${name}`);
+      return found[0];
+    };
+    const pairs = [
+      ['CodeGraphProbe.Init', 'CodeGraphProbe.Counter.run'],
+      ['CodeGraphProbe.Counter.run', 'CodeGraphProbe.Ping'],
+      ['CodeGraphProbe.Done', 'CodeGraphProbe.Ping'],
+    ];
+    const handler = new ToolHandler(cg);
+    const flows = [];
+    for (const [from, to] of pairs) {
+      const route = cg.findPath(node(from).id, node(to).id, ['calls', 'references']);
+      assert.ok(route, `${from} must reach ${to}`);
+      const result = await handler.execute('codegraph_explore', { query: `${from} ${to}` });
+      assert.ok(!result.isError, JSON.stringify(result));
+      const text = result.content.map(c => c.text ?? '').join('\n');
+      assert.ok(text.includes('JASS/vJASS local support'));
+      assert.ok(text.includes('call ') || text.includes('function '));
+      const file = path.join(root, `.probe-${flows.length + 1}.txt`);
+      fs.writeFileSync(file, text);
+      flows.push({ from, to, graph_path: route, response_chars: text.length, output: file });
+    }
+    const stats = cg.getStats();
+    const errors = cg.getFiles().flatMap(f => (f.errors ?? []).map(e => ({ file: f.path, ...e })));
+    // A truly empty rebuild, not another indexAll over unchanged hashes.
+    cg.destroy();
+    cg = await CodeGraph.recreate(root);
+    await cg.indexAll();
+    assert.equal(cg.getStats().nodeCount, stats.nodeCount);
+    assert.equal(cg.getStats().edgeCount, stats.edgeCount);
+    assert.deepEqual(hashes(), before);
+    reports.push({ root, index_ms: indexed.durationMs, total_probe_ms: Math.round(performance.now() - started),
+      files: stats.fileCount, nodes: stats.nodeCount, edges: stats.edgeCount,
+      errors, flows, stable_rebuild_counts: true, source_hashes_unchanged: true, source_hashes: before });
+  } finally { cg.destroy(); }
+}
+console.log(JSON.stringify(reports, null, 2));
diff --git a/src/extraction/jass-extractor.ts b/src/extraction/jass-extractor.ts
new file mode 100644
index 0000000..fa0497e
--- /dev/null
+++ b/src/extraction/jass-extractor.ts
@@ -0,0 +1,284 @@
+import { Node, NodeKind, Edge, ExtractionResult, ExtractionError, UnresolvedReference } from '../types';
+import { generateNodeId } from './tree-sitter-helpers';
+
+interface Token { value: string; line: number; column: number }
+interface Block { keyword: string; node: Node }
+export interface JassLexed { lines: Token[][]; errors: ExtractionError[] }
+const IDENTIFIER = /^[A-Za-z_][A-Za-z_0-9]*$/;
+const MODIFIERS = new Set(['private', 'public', 'static', 'stub', 'constant', 'readonly', 'debug']);
+const STATEMENTS = new Set(['call', 'set', 'return', 'if', 'elseif', 'exitwhen', 'loop', 'then', 'else', 'endif', 'endloop', 'and', 'or', 'not']);
+const PRIMITIVES = new Set(['nothing', 'integer', 'real', 'boolean', 'string', 'code', 'handle', 'thistype']);
+const CONTAINERS: Record<string, NodeKind> = {
+  library: 'namespace', library_once: 'namespace', scope: 'namespace',
+  struct: 'struct', module: 'module', interface: 'interface',
+};
+
+/** Offset-preserving lexical pass; literals/comments never become executable tokens.
+ * Macro templates and Zinc blocks are deliberately excluded, not "parsed" as JASS.
+ */
+export function lexJass(source: string): JassLexed {
+  const masked = source.split('');
+  const errors: ExtractionError[] = [];
+  const directiveLines = new Set<number>();
+  let line = 1;
+  const blank = (start: number, end: number) => {
+    for (let p = start; p < end; p++) if (source[p] !== '\n' && source[p] !== '\r') masked[p] = ' ';
+  };
+  const warn = (message: string, at: number, severity: 'error' | 'warning' = 'warning') =>
+    errors.push({ message, line: at, severity, code: severity === 'error' ? 'jass_parse_error' : 'jass_partial_coverage' });
+  for (let i = 0; i < source.length;) {
+    if (source[i] === '\n') { line++; i++; continue; }
+    if (source.startsWith('//', i)) {
+      const start = i;
+      if (source.startsWith('//!', i) && source.slice(source.lastIndexOf('\n', i - 1) + 1, i).trim() === '') directiveLines.add(line);
+      while (i < source.length && source[i] !== '\n') i++;
+      blank(start, i);
+    } else if (source.startsWith('/*', i)) {
+      const start = i, at = line;
+      i += 2;
+      while (i < source.length && !source.startsWith('*/', i)) { if (source[i] === '\n') line++; i++; }
+      if (i === source.length) warn('Unclosed block comment; remaining source excluded.', at, 'error');
+      else i += 2;
+      blank(start, i);
+    } else if (source[i] === '"' || source[i] === "'") {
+      const quote = source[i]!, start = i++, at = line;
+      let closed = false;
+      while (i < source.length && source[i] !== '\n' && source[i] !== '\r') {
+        if (source[i] === '\\') {
+          // Escaping a newline does not make it a valid multiline JASS string.
+          i = Math.min(source.length, i + ((source[i + 1] === '\n' || source[i + 1] === '\r') ? 1 : 2));
+          continue;
+        }
+        if (source[i++] === quote) { closed = true; break; }
+      }
+      if (!closed) warn('Unclosed string/rawcode; literal excluded from extraction.', at, 'error');
+      blank(start, i);
+    } else { i++; }
+  }
+  const sourceLines = source.split(/\r?\n/);
+  const maskedLines = masked.join('').split(/\r?\n/);
+  let omitted: 'textmacro' | 'zinc' | null = null;
+  const lines = maskedLines.map((text, index) => {
+    const original = sourceLines[index] ?? '';
+    const directive = original.match(/^\s*\/\/!\s*(\w+)/)?.[1];
+    if (directive && directiveLines.has(index + 1)) {
+      if (directive === 'textmacro' || directive === 'zinc') {
+        if (omitted) warn(`Nested ${directive} region is unsupported.`, index + 1);
+        omitted = directive;
+      } else if (directive === 'endtextmacro' || directive === 'endzinc') {
+        const expected = directive === 'endzinc' ? 'zinc' : 'textmacro';
+        if (omitted !== expected) warn(`Unmatched ${directive} directive.`, index + 1, 'error');
+        omitted = null;
+      }
+      if (!directive.startsWith('end')) warn(`Directive ${directive} is not expanded; coverage is partial.`, index + 1);
+      return [];
+    }
+    if (omitted) return [];
+    return [...text.matchAll(/[A-Za-z_][A-Za-z_0-9]*|[^\s]/g)].map(m => ({ value: m[0], line: index + 1, column: m.index! }));
+  });
+  if (omitted) warn(`Unclosed ${omitted} region.`, sourceLines.length, 'error');
+  return { lines, errors };
+}
+
+/** Native CodeGraph extraction result, consumed by its normal SQLite/index/sync
+ * pipeline. This is a structural JASS/vJASS parser, not JassHelper or a VM.
+ */
+export class JassExtractor {
+  private nodes: Node[] = [];
+  private edges: Edge[] = [];
+  private refs: UnresolvedReference[] = [];
+  private errors: ExtractionError[] = [];
+  private stack: Block[] = [];
+  private globals = false;
+  private sourceLines: string[];
+  private file!: Node;
+
+  constructor(private filePath: string, private source: string, private language: 'jass' | 'vjass') {
+    this.sourceLines = source.split(/\r?\n/);
+  }
+
+  extract(): ExtractionResult {
+    const start = Date.now();
+    const lexed = lexJass(this.source);
+    this.errors = lexed.errors.map(e => ({ ...e, filePath: this.filePath }));
+    this.file = this.node('file', this.filePath, { value: this.filePath, line: 1, column: 0 }, null);
+    this.file.endLine = this.sourceLines.length;
+    this.file.endColumn = this.sourceLines.at(-1)?.length ?? 0;
+    for (const tokens of lexed.lines) this.parseLine(tokens);
+    for (const open of this.stack) this.error(`Missing end${open.keyword} for ${open.node.qualifiedName}.`, open.node.startLine);
+    if (this.globals) this.error('Missing endglobals.', this.sourceLines.length);
+    return { nodes: this.nodes, edges: this.edges, unresolvedReferences: this.refs,
+             errors: this.errors, durationMs: Date.now() - start };
+  }
+
+  private error(message: string, line: number, severity: 'error' | 'warning' = 'error'): void {
+    this.errors.push({ message, filePath: this.filePath, line, severity,
+                       code: severity === 'error' ? 'jass_parse_error' : 'jass_partial_coverage' });
+  }
+
+  private parent(): Node { return this.stack.at(-1)?.node ?? this.file; }
+
+  private node(kind: NodeKind, name: string, token: Token, parent: Node | null, signature?: string): Node {
+    const qualifiedName = parent && parent.kind !== 'file' ? `${parent.qualifiedName}.${name}` : name;
+    const node: Node = {
+      id: generateNodeId(this.filePath, kind, qualifiedName, token.line), kind, name, qualifiedName,
+      filePath: this.filePath, language: this.language, startLine: token.line, endLine: token.line,
+      startColumn: token.column, endColumn: this.sourceLines[token.line - 1]?.length ?? 0,
+      signature, updatedAt: Date.now(),
+    };
+    this.nodes.push(node);
+    if (parent) this.edges.push({ source: parent.id, target: node.id, kind: 'contains', provenance: 'heuristic' });
+    return node;
+  }
+
+  private ref(from: Node, name: string, kind: UnresolvedReference['referenceKind'], at: Token): void {
+    if ((kind === 'type_of' || kind === 'returns' || kind === 'extends') && PRIMITIVES.has(name)) return;
+    this.refs.push({ fromNodeId: from.id, referenceName: name, referenceKind: kind,
+                     line: at.line, column: at.column, filePath: this.filePath, language: this.language });
+  }
+
+  private parseLine(tokens: Token[]): void {
+    if (!tokens.length) return;
+    let p = 0;
+    const modifiers: string[] = [];
+    while (MODIFIERS.has(tokens[p]?.value ?? '')) modifiers.push(tokens[p++]!.value);
+    const head = tokens[p];
+    if (!head) return;
+    const word = head.value;
+    const parent = this.parent();
+    if (word.startsWith('end') && ['endfunction', 'endmethod', 'endlibrary', 'endscope', 'endstruct', 'endmodule', 'endinterface'].includes(word)) {
+      const open = this.stack.at(-1);
+      if (!open || `end${open.keyword}` !== word) { this.error(`Unmatched ${word}.`, head.line); return; }
+      open.node.endLine = head.line;
+      open.node.endColumn = this.sourceLines[head.line - 1]?.length ?? 0;
+      this.stack.pop();
+      return;
+    }
+    if (word === 'globals') { if (this.globals) this.error('Nested globals block.', head.line); this.globals = true; return; }
+    if (word === 'endglobals') { if (!this.globals) this.error('Unmatched endglobals.', head.line); this.globals = false; return; }
+    if (word === 'implement' || word === 'delegate' || word === 'hook' || word === 'key') {
+      this.error(`${word} expansion/dispatch is not modeled.`, head.line, 'warning'); return;
+    }
+    if ((word === 'if' && modifiers.includes('static')) || modifiers.includes('debug')) {
+      this.error('Conditional compilation is not evaluated; extracted references are potential paths.', head.line, 'warning');
+    }
+    const kind = CONTAINERS[word];
+    if (kind) {
+      const name = tokens[p + 1];
+      if (!name || !IDENTIFIER.test(name.value)) { this.error(`Missing ${word} name.`, head.line); return; }
+      const node = this.node(kind, name.value, head, parent, this.sourceLines[head.line - 1]?.trim());
+      this.visibility(node, modifiers);
+      this.stack.push({ keyword: word === 'library_once' ? 'library' : word, node });
+      let dependencies = false;
+      for (let i = p + 2; i < tokens.length; i++) {
+        const directive = tokens[i]!.value;
+        if (directive === 'extends' && tokens[i + 1]) this.ref(node, tokens[++i]!.value, 'extends', tokens[i]!);
+        else if (directive === 'initializer' && tokens[i + 1]) { dependencies = false; this.ref(node, tokens[++i]!.value, 'calls', tokens[i]!); }
+        else if (['requires', 'needs', 'uses'].includes(directive)) dependencies = true;
+        else if (dependencies && IDENTIFIER.test(directive) && directive !== 'optional') this.ref(node, directive, 'imports', tokens[i]!);
+      }
+      return;
+    }
+    if (word === 'type') {
+      const name = tokens[p + 1];
+      if (name && IDENTIFIER.test(name.value)) {
+        const node = this.node('type_alias', name.value, head, parent, this.sourceLines[head.line - 1]?.trim());
+        this.visibility(node, modifiers);
+        if (tokens[p + 2]?.value === 'extends' && tokens[p + 3]) this.ref(node, tokens[p + 3]!.value, 'extends', tokens[p + 3]!);
+      } else this.error('Missing type name.', head.line);
+      return;
+    }
+    if (word === 'function' || word === 'method' || word === 'native') {
+      const functionInterface = word === 'function' && tokens[p + 1]?.value === 'interface';
+      const name = tokens[p + (functionInterface ? 2 : 1)];
+      const takes = tokens.findIndex(t => t.value === 'takes');
+      const returns = tokens.findIndex(t => t.value === 'returns');
+      if (!name || !IDENTIFIER.test(name.value) || takes < 0 || returns <= takes || !tokens[returns + 1]) {
+        this.error(`Incomplete ${word} header. Multiline headers are not supported.`, head.line); return;
+      }
+      let declaredName = name.value;
+      if (word === 'method' && name.value === 'operator') {
+        declaredName = 'operator ' + tokens.slice(p + 2, takes).map(t => t.value).join('');
+        this.error('Operator getter/setter/index dispatch is not resolved.', head.line, 'warning');
+      }
+      const node = this.node(functionInterface ? 'type_alias' : word === 'method' ? 'method' : 'function', declaredName, head, parent, this.sourceLines[head.line - 1]?.trim());
+      this.visibility(node, modifiers);
+      node.isStatic = modifiers.includes('static');
+      node.isAbstract = parent.kind === 'interface';
+      node.returnType = tokens[returns + 1]!.value;
+      this.ref(node, node.returnType, 'returns', tokens[returns + 1]!);
+      const parameters = tokens.slice(takes + 1, returns);
+      for (let i = 0; i < parameters.length;) {
+        const type = parameters[i++];
+        if (!type || type.value === 'nothing') break;
+        const parameter = parameters[i++];
+        if (!parameter || !IDENTIFIER.test(parameter.value)) { this.error('Incomplete parameter declaration.', head.line); break; }
+        const declared = this.node('parameter', parameter.value, parameter, node, `${type.value} ${parameter.value}`);
+        this.ref(declared, type.value, 'type_of', type);
+        if (parameters[i]?.value === ',') i++;
+      }
+      if (word !== 'native' && !functionInterface && parent.kind !== 'interface') this.stack.push({ keyword: word, node });
+      if (functionInterface) this.error('Function-interface indirect dispatch is not resolved.', head.line, 'warning');
+      return;
+    }
+    let body = tokens.slice(p);
+    // Globals, struct fields and explicitly local declarations. The tokens
+    // after '=' are still visited, so initializer calls enter the same graph.
+    const local = word === 'local';
+    const declarationsAllowed = local || this.globals || ['struct', 'interface', 'module'].includes(parent.kind);
+    let at = local ? p + 1 : p;
+    const type = tokens[at++];
+    if (tokens[at]?.value === 'array') at++;
+    const variable = tokens[at];
+    if (declarationsAllowed && type && variable && IDENTIFIER.test(type.value) && IDENTIFIER.test(variable.value) &&
+        !['call', 'set', 'return', 'if', 'elseif', 'exitwhen', 'loop'].includes(type.value) &&
+        [undefined, '=', '['].includes(tokens[at + 1]?.value)) {
+      const node = this.node(local ? 'variable' : modifiers.includes('constant') ? 'constant' : this.globals ? 'variable' : 'field', variable.value, type, parent,
+                             this.sourceLines[type.line - 1]?.trim());
+      this.visibility(node, modifiers);
+      node.isStatic = modifiers.includes('static');
+      this.ref(node, type.value, 'type_of', type);
+      const equal = tokens.findIndex(t => t.value === '=');
+      body = equal < 0 ? [] : tokens.slice(equal + 1);
+      this.calls(body, node);
+      return;
+    }
+    this.calls(body, parent);
+  }
+
+  private visibility(node: Node, modifiers: string[]): void {
+    node.visibility = modifiers.includes('private') ? 'private' : 'public';
+    node.isExported = !modifiers.includes('private') && !['parameter', 'variable'].includes(node.kind);
+  }
+
+  private calls(tokens: Token[], owner: Node): void {
+    for (let i = 0; i < tokens.length; i++) {
+      const token = tokens[i]!;
+      if (STATEMENTS.has(token.value)) continue;
+      const callback = token.value === 'function';
+      const start = callback ? i + 1 : i;
+      const first = tokens[start];
+      if (!first || (!IDENTIFIER.test(first.value) && first.value !== '.')) continue;
+      if (!callback && tokens[i - 1]?.value === '.') continue;
+      let j = start;
+      let name = '';
+      if (tokens[j]?.value === '.') {
+        if (tokens[j - 1]?.value === ')' || tokens[j - 1]?.value === ']') {
+          this.error('Chained call/index receiver is not inferred.', first.line, 'warning');
+          name = '__jass_unresolved_receiver.';
+        } else name = 'this.';
+        j++;
+      }
+      if (!tokens[j] || !IDENTIFIER.test(tokens[j]!.value)) continue;
+      name += tokens[j++]!.value;
+      while (tokens[j]?.value === '.' && tokens[j + 1] && IDENTIFIER.test(tokens[j + 1]!.value)) {
+        name += '.' + tokens[j + 1]!.value; j += 2;
+      }
+      if (callback || tokens[j]?.value === '(') {
+        this.ref(owner, name, callback ? 'function_ref' : 'calls', first);
+        if (name === 'ExecuteFunc' || /\.(execute|evaluate)$/.test(name)) this.error(`Dynamic dispatch ${name} is not expanded.`, first.line, 'warning');
+        i = j - 1;
+      }
+    }
+  }
+}
