function sa__Wave_cancelReservedSpawn takes nothing returns boolean
local integer this=f__arg_this
local integer s=f__arg_integer1
local integer pid=f__arg_integer2
local boolean restoreRemaining=f__arg_boolean1
            if s == 0 then
return true
            endif
            set s__WaveSlot_active[s]=s__WaveSlot_active[s] - 1
            if s__WaveSlot_active[s] < 0 then
                set s__WaveSlot_active[s]=0
            endif
            if ( pid >= 0 ) and ( pid < WAVE_TRACKED_PLAYER_SLOTS ) then
                set s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid]=s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] - 1
                if s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] < 0 then
                    set s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid]=0
                endif
            endif
            set s__Wave_activeOnMap[this]=s__Wave_activeOnMap[this] - 1
            if s__WaveSlot_isBoss[s] then
                set s__Wave_activeBosses[this]=s__Wave_activeBosses[this] - 1
            else
                set s__Wave_activeUnits[this]=s__Wave_activeUnits[this] - 1
            endif
            if restoreRemaining then
                set s__WaveSlot_remaining[s]=s__WaveSlot_remaining[s] + 1
                set s__Wave_remainingToSpawn[this]=s__Wave_remainingToSpawn[this] + 1
                if s__WaveSlot_isBoss[s] then
                    set s__Wave_remainingBosses[this]=s__Wave_remainingBosses[this] + 1
                else
                    set s__Wave_remainingUnits[this]=s__Wave_remainingUnits[this] + 1
                endif
            else
                set s__Wave_totalToSpawn[this]=s__Wave_totalToSpawn[this] - 1
                set s__Wave_totalKilled[this]=s__Wave_totalKilled[this] - 1
                if s__WaveSlot_isBoss[s] then
                    set s__Wave_totalBosses[this]=s__Wave_totalBosses[this] - 1
                    set s__Wave_totalKilledBoss[this]=s__Wave_totalKilledBoss[this] - 1
                else
                    set s__Wave_totalUnits[this]=s__Wave_totalUnits[this] - 1
                    set s__Wave_totalKilledUnits[this]=s__Wave_totalKilledUnits[this] - 1
                endif
            endif
            call s__Wave_clampCoreCounters(this)
   return true
endfunction
function sa__Wave_tryDestroyAfterTermination takes nothing returns boolean
local integer this=f__arg_this
            if s__Wave_isDestroyed[this] then
return true
            endif
            if s__Wave_terminateRequested[this] and s__Wave_activeOnMap[this] <= 0 then
                call sc__Wave_fireFinishEventOnce(this)
                call sc__Wave_destroyWave(this)
            endif
   return true
endfunction
function sa__Wave_terminate takes nothing returns boolean
local integer this=f__arg_this
local boolean modeKillAlive=f__arg_boolean1
            if s__Wave_isDestroyed[this] then
return true
            endif
            set s__Wave_terminateRequested[this]=true
            set s__Wave_cancelPendingPermanently[this]=true
            set s__Wave_suppressEndCallback[this]=false
            set s__Wave_isRunning[this]=false
            set s__Wave_isPaused[this]=true
            set s__Wave_isFinishing[this]=true
            if s__Wave_loopTimer[this] != null then
                call PauseTimer(s__Wave_loopTimer[this])
            endif
            call s__Wave_cancelAllPendingSlots(this)
            set s__Wave_waveToken[this]=s__Wave_waveToken[this] + 1
            if modeKillAlive then
                call s__Wave_killAllTrackedUnits(this)
            endif
            call sc__Wave_refreshBoard(this)
            call s__Wave_tryDestroyAfterTermination(this)
   return true
endfunction
