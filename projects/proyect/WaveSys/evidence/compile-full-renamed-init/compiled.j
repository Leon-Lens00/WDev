function RegisterMovementSpell takes integer abilityId,string orderId returns nothing
    local integer oid= OrderId(orderId)
    call SaveBoolean(Table__ht, (((MovementSystem__registeredAbilityFlags))), (abilityId), ( true)) // INLINED!!
    call SaveReal(Table__ht, (((MovementSystem__registeredOrderByAbility))), (abilityId), (( I2R(oid))*1.0)) // INLINED!!
endfunction

//===========================================================================
function RegisterMovementSpellTarget takes integer abilityId,string orderId returns nothing
    call RegisterMovementSpell(abilityId , orderId)
endfunction

//===========================================================================
function ConfigureMovementSpellCastSession takes integer abilityId,real castDuration,boolean allowSmartRecast,integer maxSmartRecasts returns nothing
    if maxSmartRecasts < 0 then
        set maxSmartRecasts=0
    endif

    call SaveBoolean(Table__ht, (((MovementSystem__smartRecastEnabledByAbility))), (abilityId), ( allowSmartRecast)) // INLINED!!
    call SaveReal(Table__ht, (((MovementSystem__smartRecastCountByAbility))), (abilityId), (( I2R(maxSmartRecasts))*1.0)) // INLINED!!




endfunction

//===========================================================================
function RegisterMovementSpellRecast takes integer abilityId,string orderId returns nothing
    call RegisterMovementSpell(abilityId , orderId)
endfunction

//===========================================================================
function RegisterMovementSpellTargetRecast takes integer abilityId,string orderId returns nothing
    call RegisterMovementSpell((abilityId ) , ( orderId)) // INLINED!!
endfunction

//===========================================================================
function CancelMovementSpellSessionForUnit takes unit u returns nothing
    if u == null or GetUnitTypeId(u) == 0 then
        return
    endif
    call MovementSystem__DestroyMovementDataForUnit(u)
endfunction

//===========================================================================
function MovementSystem__OnPointOrder takes nothing returns boolean
    local unit u= GetTriggerUnit()
    local integer orderId= GetIssuedOrderId()
    local integer data
    local real x
    local real y

    if not MovementSystem__IsMoveCastTrackedUnit(u) then
        set u=null
        return false
    endif

    if ( orderId == MovementSystem__ORDER_ID_MOVE ) or ( orderId == MovementSystem__ORDER_ID_SMART ) then
        if MovementSystem__IsLeapBuffActive(u) then
            call MovementSystem__DestroyMovementDataForUnit(u)
            set u=null
            return false
        endif

        set x=GetOrderPointX()
        set y=GetOrderPointY()
        set data=MovementSystem__GetOrCreateMovementData(u)
        if data == 0 then
            set u=null
            return false
        endif

        if not s__MovementData_sessionActive[data] then
            call s__MovementData_rememberPoint(data,x , y)
        elseif s__MovementData_isPointTooClose(data,x , y) then
            call s__MovementData_rememberPoint(data,x , y)
        elseif not s__MovementData_isMoving[data] then
            call s__MovementData_applyMovePoint(data,x , y , false)
        elseif s__MovementData_recastsLeft[data] > 0 then
            call s__MovementData_consumeSmartRecast(data)
            call s__MovementData_applyMovePoint(data,x , y , true)
        else
            call IssueImmediateOrderById(u, MovementSystem__ORDER_ID_STOP)
            call s__MovementData_endSession(data)
        endif
    endif

    set u=null
    return false
endfunction

//===========================================================================
function MovementSystem__OnTargetOrder takes nothing returns boolean
    local unit u= GetTriggerUnit()
    local unit targetU= GetOrderTargetUnit()
    local integer orderId= GetIssuedOrderId()
    local integer data
    local real x
    local real y

    if not MovementSystem__IsMoveCastTrackedUnit(u) then
        set targetU=null
        set u=null
        return false
    endif

    if ( orderId == MovementSystem__ORDER_ID_SMART ) and ( targetU != null ) and ( GetUnitTypeId(targetU) != 0 ) then
        if MovementSystem__IsLeapBuffActive(u) then
            call MovementSystem__DestroyMovementDataForUnit(u)
            set targetU=null
            set u=null
            return false
        endif

        set x=GetUnitX(targetU)
        set y=GetUnitY(targetU)
        set data=MovementSystem__GetOrCreateMovementData(u)
        if data == 0 then
            set targetU=null
            set u=null
            return false
        endif

        if not s__MovementData_sessionActive[data] then
            call s__MovementData_rememberPoint(data,x , y)
        elseif s__MovementData_isPointTooClose(data,x , y) then
            call s__MovementData_rememberPoint(data,x , y)
        elseif not s__MovementData_isMoving[data] then
            call s__MovementData_applyMovePoint(data,x , y , false)
        elseif s__MovementData_recastsLeft[data] > 0 then
            call s__MovementData_consumeSmartRecast(data)
            call s__MovementData_applyMovePoint(data,x , y , true)
        else
            call IssueImmediateOrderById(u, MovementSystem__ORDER_ID_STOP)
            call s__MovementData_endSession(data)
        endif
    endif

    set targetU=null
    set u=null
    return false
endfunction

//===========================================================================
function MovementSystem__OnSpellEffect takes nothing returns boolean
    local unit u= GetTriggerUnit()
    local unit targetU= GetSpellTargetUnit()
    local integer abilityId= GetSpellAbilityId()
    local real tx= GetSpellTargetX()
    local real ty= GetSpellTargetY()
    local integer data

    if not MovementSystem__IsMoveCastTrackedUnit(u) then
        set targetU=null
        set u=null
        return false
    endif

    if abilityId == MovementSystem__LOADOUT_LEAP_SPELL_ID then
        call MovementSystem__DestroyMovementDataForUnit(u)
        set targetU=null
        set u=null
        return false
    endif

    if MovementSystem__IsLeapBuffActive(u) then
        call MovementSystem__DestroyMovementDataForUnit(u)
        set targetU=null
        set u=null
        return false
    endif

    if (LoadBoolean(Table__ht, (((MovementSystem__registeredAbilityFlags))), (abilityId))) then // INLINED!!
        set data=MovementSystem__GetOrCreateMovementData(u)
        if data == 0 then
            set targetU=null
            set u=null
            return false
        endif

        if ( targetU != null ) and ( GetUnitTypeId(targetU) != 0 ) then
            set tx=GetUnitX(targetU)
            set ty=GetUnitY(targetU)
        endif

        set s__MovementData_lastCastAbilityId[data]=abilityId
        set s__MovementData_lastCastOrderId[data]=R2I((LoadReal(Table__ht, (((MovementSystem__registeredOrderByAbility))), (abilityId)))) // INLINED!!
        set s__MovementData_lastCastTargetUnit[data]=null
        if ( targetU != null ) and ( GetUnitTypeId(targetU) != 0 ) then
            set s__MovementData_lastCastTargetUnit[data]=targetU
        endif
        call s__MovementData_setAimPoint(data,tx , ty)
        call SetUnitFacing(u, Atan2(ty - GetUnitY(u), tx - GetUnitX(u)) * bj_RADTODEG)
        call s__MovementData_beginOrRefreshSession(data,abilityId)

        if ( not s__MovementData_isMoving[data] ) and s__MovementData_hasLastSmart[data] then
            call s__MovementData_startMoveToStoredPoint(data)
        endif
    endif

    set targetU=null
    set u=null
    return false
endfunction

//===========================================================================
function MovementSystem__OnUnitDeath takes nothing returns boolean
    local unit u= GetTriggerUnit()
    call MovementSystem__DestroyMovementDataForUnit(u)
    set u=null
    return false
endfunction

//===========================================================================
function MovementSystem__Init takes nothing returns nothing
    set MovementSystem__registeredAbilityFlags=s__Table_create()
    set MovementSystem__registeredOrderByAbility=s__Table_create()
    set MovementSystem__smartRecastEnabledByAbility=s__Table_create()
    set MovementSystem__smartRecastCountByAbility=s__Table_create()
    set MovementSystem__ORDER_ID_MOVE=OrderId("move")
    set MovementSystem__ORDER_ID_SMART=OrderId("smart")
    set MovementSystem__ORDER_ID_STOP=OrderId("stop")

    set s__MovementData_table=s__Table_create() // INLINED!!

    call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER , function MovementSystem__OnPointOrder)
    call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER , function MovementSystem__OnTargetOrder)
    call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_EFFECT , function MovementSystem__OnSpellEffect)
    call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_DEATH , function MovementSystem__OnUnitDeath)
endfunction



    function StopAmbientTownSound takes nothing returns nothing
        if RestAmbientTownSound != null then
            call StopSound(RestAmbientTownSound, true, false)
            call KillSoundWhenDone(RestAmbientTownSound)
            set RestAmbientTownSound=null
        endif
    endfunction

