        function s__Client_getWaveStatusText takes integer userId returns string
            if MenuClient__WaveStatusText[userId] == null or MenuClient__WaveStatusText[userId] == "" then
                return "Wave"
            endif
            return MenuClient__WaveStatusText[userId]
        endfunction

        function s__Client_formatAmmoText takes integer ammo returns string
            if ammo == WEAPON_AMMO_INFINITE then
                return "|cff99ff99INF|r"
            endif
            return "|cffffcc00" + I2S(ammo) + "|r"
        endfunction

        function s__Client_formatWeaponSlotText takes player p,integer slot returns string
            local integer profileId= WeaponInventoryGetSlotProfile(p , slot)
            local integer ammo= WeaponInventoryGetSlotAmmo(p , slot)
            local string prefix= "  "
            if WeaponInventoryGetActiveSlot(p) == slot then
                set prefix="|cffffff00>|r "
            endif
            return prefix + WeaponProfileGetName(profileId) + "\nMunicion: " + s__Client_formatAmmoText(ammo)
        endfunction

        function s__Client_refreshWeaponHud takes integer this returns nothing
            local integer pid= s__User_id[s__Client_user[this]]
            local integer hudVersion= (WeaponInventoryCore__WeaponInventoryHudVersion[GetPlayerId((s__Client_player[this]))]) // INLINED!!
            local integer profile1
            local integer profile2

            if MenuClient__WeaponHudLastVersion[pid] != hudVersion then
                set profile1=WeaponInventoryGetSlotProfile(s__Client_player[this] , WEAPON_INVENTORY_SLOT_1)
                set profile2=WeaponInventoryGetSlotProfile(s__Client_player[this] , WEAPON_INVENTORY_SLOT_2)

                if s__s__Client_pictures[( pid * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_1] != 0 then
                    call s__UIPicture_setTexture(s__s__Client_pictures[( pid * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_1],WeaponProfileGetTexture(profile1))
                endif
                if s__s__Client_pictures[( pid * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_2] != 0 then
                    call s__UIPicture_setTexture(s__s__Client_pictures[( pid * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_2],WeaponProfileGetTexture(profile2))
                endif
                if s__s__Client_title[( pid * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_1] != 0 then
                    call SetTextTagText(s__UIText_text[s__s__Client_title[( pid * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_1]], s__Client_formatWeaponSlotText(s__Client_player[this] , WEAPON_INVENTORY_SLOT_1), 7 * 0.0027)
                endif
                if s__s__Client_title[( pid * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_2] != 0 then
                    call SetTextTagText(s__UIText_text[s__s__Client_title[( pid * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_2]], s__Client_formatWeaponSlotText(s__Client_player[this] , WEAPON_INVENTORY_SLOT_2), 7 * 0.0027)
                endif
                set MenuClient__WeaponHudLastVersion[pid]=hudVersion
            endif
        endfunction

        function s__Client_setWaveStatusTitle takes integer this,string value returns nothing
            if value == null or value == "" then
                set MenuClient__WaveStatusText[s__User_id[s__Client_user[this]]]="Wave"
            else
                set MenuClient__WaveStatusText[s__User_id[s__Client_user[this]]]=value
            endif
            if s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WAVE_STATUS] != 0 then
                call SetTextTagText(s__UIText_text[s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WAVE_STATUS]], s__Client_getWaveStatusText(s__User_id[s__Client_user[this]]), 8 * 0.0027)
            endif
        endfunction

