    function GetTerrainZ takes real x,real y returns real
        call MoveLocation(Camera_DummyLoc, x, y)
        return GetLocationZ(Camera_DummyLoc)
    endfunction
    
    function GetCameraDeltaZ takes nothing returns real
        return Camera___DeltaZ
    endfunction
    
    function Camera___Matrix4Perspective1 takes integer Output,real fovy,real Aspect,real zn,real zf returns integer
        return s__MATRIX4_SetValues(Output,2 * zn / fovy , 0 , 0 , 0 , 0 , 2 * zn / Aspect , 0 , 0 , 0 , 0 , zf / ( zf - zn ) , 1 , 0 , 0 , zn * zf / ( zn - zf ) , 0)
    endfunction

    function Camera___Matrix4Perspective2 takes integer Output,real n,real f,real r,real l,real t,real b returns integer
        return s__MATRIX4_SetValues(Output,2 * n / ( r - l ) , 0 , ( r + l ) / ( r - l ) , 0 , 0 , 2 * n / ( t - b ) , ( t + b ) / ( t - b ) , 0 , 0 , 0 , - ( f + n ) / ( f - n ) , - 2 * f * n / ( f - n ) , 0 , 0 , - 1 , 0)
    endfunction

    function Camera___Matrix4Look takes integer Output,integer PosCamera,integer AxisX,integer AxisY,integer AxisZ returns integer
        return s__MATRIX4_SetValues(Output,s__VECTOR3_x[AxisX] , s__VECTOR3_x[AxisY] , s__VECTOR3_x[AxisZ] , 0 , s__VECTOR3_y[AxisX] , s__VECTOR3_y[AxisY] , s__VECTOR3_y[AxisZ] , 0 , s__VECTOR3_z[AxisX] , s__VECTOR3_z[AxisY] , s__VECTOR3_z[AxisZ] , 0 , - Vec3Dot(AxisX , PosCamera) , - Vec3Dot(AxisY , PosCamera) , - Vec3Dot(AxisZ , PosCamera) , 1)
    endfunction

        
        function s__Camera_win2World takes integer this,real X,real Y,real Range returns integer
            local integer Output= s__VECTOR3__allocate()
            set s__VECTOR3_x[Output]=s__VECTOR3_x[s__Camera_eye[this]] + s__VECTOR3_x[s__Camera_axisZ[this]] * Range + X * s__VECTOR3_x[s__Camera_axisX[this]] * SCREEN_WIDTH * Range + Y * s__VECTOR3_x[s__Camera_axisY[this]] * SCREEN_HEIGHT * Range
            set s__VECTOR3_y[Output]=s__VECTOR3_y[s__Camera_eye[this]] + s__VECTOR3_y[s__Camera_axisZ[this]] * Range + X * s__VECTOR3_y[s__Camera_axisX[this]] * SCREEN_WIDTH * Range + Y * s__VECTOR3_y[s__Camera_axisY[this]] * SCREEN_HEIGHT * Range
            set s__VECTOR3_z[Output]=s__VECTOR3_z[s__Camera_eye[this]] + s__VECTOR3_z[s__Camera_axisZ[this]] * Range + X * s__VECTOR3_z[s__Camera_axisX[this]] * SCREEN_WIDTH * Range + Y * s__VECTOR3_z[s__Camera_axisY[this]] * SCREEN_HEIGHT * Range
            return Output
        endfunction

        function s__Camera_world2Win takes integer this,real X,real Y,real Z returns integer
            local integer Pos= s__VECTOR3_New_1(X , Y , Z)
            local boolean b
            call Vec3Transform_2(Pos , Pos , s__Camera_view[this])
            set b=s__VECTOR3_z[Pos] < 0
            call Vec3Transform_2(Pos , Pos , s__Camera_projection[this])
            if b then
                set s__VECTOR3_z[Pos]=- s__VECTOR3_z[Pos]
            endif
            return Pos
        endfunction
        
        function s__Camera_updateDistanceYawPitch takes integer this returns nothing
            local real dx= s__VECTOR3_x[s__Camera_at[this]] - s__VECTOR3_x[s__Camera_eye[this]]
            local real dy= s__VECTOR3_y[s__Camera_at[this]] - s__VECTOR3_y[s__Camera_eye[this]]
            local real dz= s__VECTOR3_z[s__Camera_at[this]] - s__VECTOR3_z[s__Camera_eye[this]]
            local real len2d
            set s__Camera_distance[this]=SquareRoot(dx * dx + dy * dy + dz * dz)
            set s__Camera_yaw[this]=Atan2(dy, dx)
            set len2d=SquareRoot(dx * dx + dy * dy)
            set s__Camera_pitch[this]=Atan2(dz, len2d)
        endfunction
        
        function s__Camera_updateAxisMatrix takes integer this returns nothing
            local integer mat
            call Vec3Normalize(s__Camera_axisZ[this] , Vec3Subtract(s__Camera_axisZ[this] , s__Camera_at[this] , s__Camera_eye[this]))
            set mat=Matrix3RotationAxis(s__MATRIX3__allocate() , s__Camera_axisZ[this] , - s__Camera_roll[this])
            call Vec3Normalize(s__Camera_axisX[this] , Vec3Cross(s__Camera_axisX[this] , s__Camera_axisZ[this] , s__VECTOR3_oneZ))
            call Vec3Transform_1(s__Camera_axisY[this] , Vec3Cross(s__Camera_axisY[this] , s__Camera_axisX[this] , s__Camera_axisZ[this]) , mat)
            call Vec3Transform_1(s__Camera_axisX[this] , s__Camera_axisX[this] , mat)
            call Camera___Matrix4Look(s__Camera_view[this] , s__Camera_eye[this] , s__Camera_axisX[this] , s__Camera_axisY[this] , s__Camera_axisZ[this])
            call s__MATRIX3_deallocate(mat)
        endfunction

        function s__Camera_applyCameraForPlayer takes integer this,player p,boolean ignoreChange returns boolean
            if GetLocalPlayer() == p then
                call SetCameraField(CAMERA_FIELD_ROTATION, s__Camera_yaw[this] * bj_RADTODEG, 0)
                call SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK, s__Camera_pitch[this] * bj_RADTODEG, 0)
                call SetCameraField(CAMERA_FIELD_ROLL, s__Camera_roll[this] * bj_RADTODEG, 0)
                call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, s__Camera_distance[this], 0)
                call SetCameraTargetController(Camera_DummyUnit[GetPlayerId(p)], s__VECTOR3_x[s__Camera_at[this]], s__VECTOR3_y[s__Camera_at[this]], false)
                call SetCameraField(CAMERA_FIELD_ZOFFSET, s__VECTOR3_z[s__Camera_at[this]] - Camera___DeltaZ, 0)
                call SetCameraField(CAMERA_FIELD_FARZ, 10000.00, 0.00)
            endif
            if s__Camera_change[this] or ignoreChange then
                set s__Camera_change[this]=false
                return true
            endif
            return false
        endfunction

        function s__Camera_setPosition takes integer this,real x,real y,real z returns nothing
            local real dx= x - s__VECTOR3_x[s__Camera_at[this]]
            local real dy= y - s__VECTOR3_y[s__Camera_at[this]]
            local real dz= z - s__VECTOR3_z[s__Camera_at[this]]
            set s__VECTOR3_x[s__Camera_eye[this]]=s__VECTOR3_x[s__Camera_eye[this]] + dx
            set s__VECTOR3_y[s__Camera_eye[this]]=s__VECTOR3_y[s__Camera_eye[this]] + dy
            set s__VECTOR3_z[s__Camera_eye[this]]=s__VECTOR3_z[s__Camera_eye[this]] + dz
            set s__VECTOR3_x[s__Camera_at[this]]=x
            set s__VECTOR3_y[s__Camera_at[this]]=y
            set s__VECTOR3_z[s__Camera_at[this]]=z
            set s__Camera_change[this]=true
        endfunction
        
        function s__Camera_setEyeAndAt takes integer this,real ex,real ey,real ez,real tx,real ty,real tz returns nothing
            set s__VECTOR3_x[s__Camera_eye[this]]=ex
            set s__VECTOR3_y[s__Camera_eye[this]]=ey
            set s__VECTOR3_z[s__Camera_eye[this]]=ez
            set s__VECTOR3_x[s__Camera_at[this]]=tx
            set s__VECTOR3_y[s__Camera_at[this]]=ty
            set s__VECTOR3_z[s__Camera_at[this]]=tz
            call s__Camera_updateDistanceYawPitch(this)
            call s__Camera_updateAxisMatrix(this)
            set s__Camera_change[this]=true
        endfunction
        
        function s__Camera_setYawPitchRoll takes integer this,real yaw,real pitch,real roll,boolean EyeLock returns nothing
            local real Z= s__Camera_distance[this] * Sin(pitch)
            local real XY= s__Camera_distance[this] * Cos(pitch)
            local real X= XY * Cos(yaw)
            local real Y= XY * Sin(yaw)
            set s__Camera_yaw[this]=yaw
            set s__Camera_pitch[this]=pitch
            set s__Camera_roll[this]=roll
            if EyeLock then
                set s__VECTOR3_x[s__Camera_at[this]]=s__VECTOR3_x[s__Camera_eye[this]] + X
                set s__VECTOR3_y[s__Camera_at[this]]=s__VECTOR3_y[s__Camera_eye[this]] + Y
                set s__VECTOR3_z[s__Camera_at[this]]=s__VECTOR3_z[s__Camera_eye[this]] + Z
            else
                set s__VECTOR3_x[s__Camera_eye[this]]=s__VECTOR3_x[s__Camera_at[this]] - X
                set s__VECTOR3_y[s__Camera_eye[this]]=s__VECTOR3_y[s__Camera_at[this]] - Y
                set s__VECTOR3_z[s__Camera_eye[this]]=s__VECTOR3_z[s__Camera_at[this]] - Z
            endif
            call s__Camera_updateAxisMatrix(this)
            set s__Camera_change[this]=true
        endfunction
        
        function s__Camera_create takes nothing returns integer
            local integer this= s__Camera__allocate()
            
            set s__Camera_customValue[this]=0
            set s__Camera_change[this]=true
            set s__Camera_eye[this]=s__VECTOR3_New_1(0.0 , - 922.668 , Camera___DeltaZ + 1367.912)
            set s__Camera_at[this]=s__VECTOR3_New_1(0 , 0 , Camera___DeltaZ)
            set s__Camera_distance[this]=0
            set s__Camera_yaw[this]=0
            set s__Camera_pitch[this]=0
            set s__Camera_roll[this]=0
            set s__Camera_axisX[this]=s__VECTOR3__allocate()
            set s__Camera_axisY[this]=s__VECTOR3__allocate()
            set s__Camera_axisZ[this]=s__VECTOR3__allocate()
            set s__Camera_view[this]=s__MATRIX4__allocate()
            set s__Camera_projection[this]=Camera___Matrix4Perspective2(s__MATRIX4__allocate() , 0.5 , 10000 , - SCREEN_WIDTH / 2 , SCREEN_WIDTH / 2 , - SCREEN_HEIGHT / 2 , SCREEN_HEIGHT / 2)
            call s__Camera_updateDistanceYawPitch(this)
            call s__Camera_updateAxisMatrix(this)
            
            return this
        endfunction
        
        function s__Camera_destroy takes integer this returns nothing
            call s__VECTOR3_deallocate(s__Camera_eye[this])
            call s__VECTOR3_deallocate(s__Camera_at[this])
            call s__VECTOR3_deallocate(s__Camera_axisX[this])
            call s__VECTOR3_deallocate(s__Camera_axisY[this])
            call s__VECTOR3_deallocate(s__Camera_axisZ[this])
            call s__MATRIX4_deallocate(s__Camera_view[this])
            call s__MATRIX4_deallocate(s__Camera_projection[this])
            call s__Camera_destroy(this)
        endfunction
        

    
//Implemented from module Camera___CamInitModule:
        function s__Camera___CamInit_Camera___CamInitModule__onInit takes nothing returns nothing
            local integer i= 0
            local integer user
            
            loop
                exitwhen i == s__User_AmountPlaying
                
                set user=(s__User_PlayingPlayer[(i)]) // INLINED!!
                
                set Camera_DummyUnit[s__User_id[user]]=CreateUnit(CAMERA_DUMMY_PLAYER, CAMERA_DUMMY_TYPE, 0, 0, 0)
                call ShowUnit(Camera_DummyUnit[s__User_id[user]], false)
                call PauseUnit(Camera_DummyUnit[s__User_id[user]], true)
                
                set i=i + 1
            endloop
            
            // init delta z
            call SetCameraPosition(CHECK_DELTAZ_X, CHECK_DELTAZ_Y)
            set Camera___DeltaZ=GetCameraTargetPositionZ() - 6
        endfunction
    


    function StopCameraEQNoise takes player whichPlayer returns nothing
        local integer id= GetPlayerId(whichPlayer)
        if ( CameraEQNoise__clock[id] != null ) then
            call ReleaseTimer(CameraEQNoise__clock[id])
            set CameraEQNoise__clock[id]=null
        endif
        if ( GetLocalPlayer() == whichPlayer ) then
            call CameraSetSourceNoise(0, 0)
            call CameraSetTargetNoise(0, 0)
        endif
    endfunction
    
    function CameraEQNoise__TimerExpire takes nothing returns nothing
        call StopCameraEQNoise(Player((LoadInteger(TimerUtils___ht, 0, GetHandleId((GetExpiredTimer())))))) // INLINED!!
    endfunction
    
    function CameraSetEQNoise takes player whichPlayer,real magnitude,real duration returns nothing
        local real richter= magnitude
        local integer id= GetPlayerId(whichPlayer)
        local real pow
        if ( richter > 5. ) then
            set richter=5.
        elseif ( richter < 2. ) then
            set richter=2.
        endif
        call StopCameraEQNoise(whichPlayer)
        set CameraEQNoise__clock[id]=NewTimerEx(id)
        call SetTimerDebugTag(CameraEQNoise__clock[id] , TIMER_DEBUG_TAG_OTHER)
        call TimerStart(CameraEQNoise__clock[id], duration, false, function CameraEQNoise__TimerExpire)
        set pow=magnitude * Pow(10, richter)
        if ( GetLocalPlayer() == whichPlayer ) then
            call CameraSetTargetNoiseEx(magnitude * 2., pow, true)
            call CameraSetSourceNoiseEx(magnitude * 2., pow, true)
        endif
    endfunction



    function FormatLoadoutDamageText takes real amount returns string
        local integer scaled
        local integer whole
        local integer frac
        local string fracText
        if amount < 0. then
            set amount=0.
        endif
        set scaled=R2I(amount * 100. + 0.5)
        set whole=scaled / 100
        set frac=scaled - whole * 100
        if frac < 10 then
            set fracText="0" + I2S(frac)
        else
            set fracText=I2S(frac)
        endif
        return "!! " + I2S(whole) + "." + fracText
    endfunction

    function ShowCustomLoadoutText takes unit target,string msg,integer r,integer g,integer b returns nothing
        local texttag t
        if target == null then
            return
        endif
        set t=CreateTrackedTextTag(TEXTTAG_DEBUG_DAMAGE)
        call SetTextTagText(t, msg, 0.020)
        call SetTextTagPosUnit(t, target, 90.)
        call SetTextTagColor(t, r, g, b, 255)
        call SetTextTagVelocity(t, 0.0, 0.035)
        call SetTextTagLifespan(t, 1.00)
        call SetTextTagFadepoint(t, 0.50)
        call SetTextTagPermanent(t, false)
        call TextTagDebug__TextTagDebugDec((TEXTTAG_DEBUG_DAMAGE)) // INLINED!!
        set t=null
    endfunction




    function InitInitialPlayerGold takes nothing returns nothing
        local integer i= 0
        local integer u
        local player p
        local integer currentGold

        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            if s__User_id[u] >= 0 and s__User_id[u] < InitialGoldConfig__MAX_HUMAN_PLAYER_SLOTS then
                set p=(s__User_handle[(u)]) // INLINED!!
                set currentGold=GetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD)
                call SetPlayerState(p, PLAYER_STATE_RESOURCE_GOLD, currentGold + InitialGoldConfig__INITIAL_PLAYER_GOLD)
            endif
            set i=i + 1
        endloop

        set p=null
    endfunction




// Legacy shotgun/pellet loadout disabled by Metal Slug weapon rework.
// U0A3 is now handled by LoadoutMetalSlugSpecial as a piercing AoE Shotgun blast.

function GetLoadoutControlMoveCastDuration takes nothing returns real
    return WeaponProfileGetCastDuration(WEAPON_PROFILE_SHOTGUN)
endfunction



// Legacy plasma leap missile disabled by Metal Slug weapon rework.
// U0A4 is now Rocket Launcher and is handled by LoadoutMetalSlugSpecial.

function GetLoadoutLeapMissileMoveCastDuration takes nothing returns real
    return WeaponProfileGetCastDuration(WEAPON_PROFILE_ROCKET_LAUNCHER)
endfunction



    function InitMenuClientDefaults takes nothing returns nothing
        set error=CreateSound("Sound\\Interface\\Warning\\Human\\KnightNoGold1.wav", false, false, false, 12700, 12700, "")
        set error_Neg=CreateSound("war3mapImported\\Error.mp3", false, false, false, 12700, 12700, "")
        set Message="BIENVENIDO!! me alegra que llegaras a tiempo no se como llegaste pero... espero no te pase lo mismo que a anteriores jugadores, los primeros que siempre ayudaron el pueblo cayeron... confio en ti"
    endfunction




function MovementSystem__IsLeapBuffActive takes unit u returns boolean
    if ( u == null ) or ( GetUnitTypeId(u) == 0 ) then
        return false
    endif
    return GetUnitAbilityLevel(u, MovementSystem__LEAP_BUFF_ID) > 0
endfunction

function MovementSystem__IsMoveCastTrackedUnit takes unit u returns boolean
    local player owner
    local integer pid

    if ( u == null ) or ( GetUnitTypeId(u) == 0 ) then
        return false
    endif

    set owner=GetOwningPlayer(u)
    set pid=GetPlayerId(owner)

    if ( pid < 0 ) or ( pid > MovementSystem__MAX_MOVECAST_PLAYER_ID ) then
        set owner=null
        return false
    endif

    if GetPlayerSlotState(owner) != PLAYER_SLOT_STATE_PLAYING then
        set owner=null
        return false
    endif

    if GetPlayerController(owner) != MAP_CONTROL_USER then
        set owner=null
        return false
    endif

    if not IsUnitType(u, UNIT_TYPE_HERO) then
        set owner=null
        return false
    endif

    set owner=null
    return true
endfunction

function MovementSystem__DistanceSq takes real ax,real ay,real bx,real by returns real
    return ( ax - bx ) * ( ax - bx ) + ( ay - by ) * ( ay - by )
endfunction



    function s__MovementData_init takes nothing returns nothing
        set s__MovementData_table=s__Table_create()
    endfunction

    function s__MovementData_create takes unit u returns integer
        local integer this= s__MovementData__allocate()

        if this == 0 then
            return 0
        endif

        set s__MovementData_source[this]=u
        set s__MovementData_moveTim[this]=null
        set s__MovementData_sessionTim[this]=null
        set s__MovementData_pulseTim[this]=null
        set s__MovementData_castText[this]=null
        set s__MovementData_lastSmartX[this]=0.
        set s__MovementData_lastSmartY[this]=0.
        set s__MovementData_hasLastSmart[this]=false
        set s__MovementData_moveX[this]=0.
        set s__MovementData_moveY[this]=0.
        set s__MovementData_hasMovePoint[this]=false
        set s__MovementData_aimX[this]=0.
        set s__MovementData_aimY[this]=0.
        set s__MovementData_hasAimPoint[this]=false
        set s__MovementData_lastCastAbilityId[this]=0
        set s__MovementData_lastCastOrderId[this]=0
        set s__MovementData_lastCastTargetUnit[this]=null
        set s__MovementData_isMoving[this]=false
        set s__MovementData_sessionActive[this]=false
        set s__MovementData_isDestroying[this]=false
        set s__MovementData_sessionRemaining[this]=0.
        set s__MovementData_recastsLeft[this]=0

        call SaveInteger(Table__ht, (s__MovementData_table), (GetHandleId(u)), ( this)) // INLINED!!
        return this
    endfunction

    function s__MovementData_has takes unit u returns boolean
        return ( u != null ) and (HaveSavedInteger(Table__ht, (s__MovementData_table), (GetHandleId(u)))) // INLINED!!
    endfunction

    function s__MovementData_get takes unit u returns integer
        if u == null then
            return 0
        endif
        return (LoadInteger(Table__ht, (s__MovementData_table), (GetHandleId(u)))) // INLINED!!
    endfunction

    function s__MovementData_forget takes unit u returns nothing
        if u != null then
            call RemoveSavedInteger(Table__ht, (s__MovementData_table), (GetHandleId(u))) // INLINED!!
        endif
    endfunction

    function s__MovementData_syncCastTextTagPosition takes integer this returns nothing
        if ( s__MovementData_castText[this] != null ) and ( s__MovementData_source[this] != null ) and ( GetUnitTypeId(s__MovementData_source[this]) != 0 ) then
            call SetTextTagPosUnit(s__MovementData_castText[this], s__MovementData_source[this], 90.)
        endif
    endfunction

    function s__MovementData_refreshCastTextTag takes integer this returns nothing
        local string msg

        if not s__MovementData_sessionActive[this] then
            call sc__MovementData_releaseCastTextTag(this)
            return
        endif

        if s__MovementData_castText[this] == null then
            set s__MovementData_castText[this]=CreateTrackedTextTag(TEXTTAG_DEBUG_MOVECAST)
            call SetTextTagPermanent(s__MovementData_castText[this], true)
            call SetTextTagVisibility(s__MovementData_castText[this], true)
        endif

        set msg="MoveCast: " + I2S(s__MovementData_recastsLeft[this])
        call SetTextTagText(s__MovementData_castText[this], msg, MovementSystem__CAST_TEXT_SIZE)
        call SetTextTagColor(s__MovementData_castText[this], MovementSystem__CAST_TEXT_R, MovementSystem__CAST_TEXT_G, MovementSystem__CAST_TEXT_B, 255)
        call SetTextTagVelocity(s__MovementData_castText[this], 0.0, 0.0)
        call SetTextTagPermanent(s__MovementData_castText[this], true)
        call SetTextTagLifespan(s__MovementData_castText[this], 60.0)
        call SetTextTagFadepoint(s__MovementData_castText[this], 60.0)
        call s__MovementData_syncCastTextTagPosition(this)
    endfunction

    function s__MovementData_releaseCastTextTag takes integer this returns nothing
        if s__MovementData_castText[this] != null then
            call SetTextTagPermanent(s__MovementData_castText[this], false)
            call SetTextTagVelocity(s__MovementData_castText[this], 0.0, MovementSystem__CAST_TEXT_RISE_SPEED)
            call SetTextTagLifespan(s__MovementData_castText[this], MovementSystem__CAST_TEXT_LIFESPAN)
            call SetTextTagFadepoint(s__MovementData_castText[this], MovementSystem__CAST_TEXT_FADEPOINT)
            call TextTagDebug__TextTagDebugDec((TEXTTAG_DEBUG_MOVECAST)) // INLINED!!
            set s__MovementData_castText[this]=null
        endif
    endfunction

    function s__MovementData_ensureMoveTimer takes integer this returns nothing
        if s__MovementData_moveTim[this] == null then
            set s__MovementData_moveTim[this]=NewTimerEx(this)
            call SetTimerDebugTag(s__MovementData_moveTim[this] , TIMER_DEBUG_TAG_MOVECAST)
            call TimerStart(s__MovementData_moveTim[this], MovementSystem__INTERVAL, true, function sc__MovementData_onMoveTick)
        endif
    endfunction

    function s__MovementData_ensureSessionTimer takes integer this returns nothing
        if s__MovementData_sessionTim[this] == null then
            set s__MovementData_sessionTim[this]=NewTimerEx(this)
            call SetTimerDebugTag(s__MovementData_sessionTim[this] , TIMER_DEBUG_TAG_MOVECAST)
            call TimerStart(s__MovementData_sessionTim[this], MovementSystem__INTERVAL, true, function sc__MovementData_onSessionTick)
        endif
    endfunction

    function s__MovementData_queuePulse takes integer this returns nothing
        if s__MovementData_pulseTim[this] != null then
            call ReleaseTimer(s__MovementData_pulseTim[this])
            set s__MovementData_pulseTim[this]=null
        endif
        set s__MovementData_pulseTim[this]=NewTimerEx(this)
        call SetTimerDebugTag(s__MovementData_pulseTim[this] , TIMER_DEBUG_TAG_MOVECAST)
        call TimerStart(s__MovementData_pulseTim[this], MovementSystem__PULSE_DELAY, false, function sc__MovementData_onPulse)
    endfunction

    function s__MovementData_rememberPoint takes integer this,real x,real y returns nothing
        set s__MovementData_lastSmartX[this]=x
        set s__MovementData_lastSmartY[this]=y
        set s__MovementData_hasLastSmart[this]=true
    endfunction

    function s__MovementData_setAimPoint takes integer this,real x,real y returns nothing
        set s__MovementData_aimX[this]=x
        set s__MovementData_aimY[this]=y
        set s__MovementData_hasAimPoint[this]=true
    endfunction

    function s__MovementData_isPointTooClose takes integer this,real x,real y returns boolean
        if ( s__MovementData_source[this] == null ) or ( GetUnitTypeId(s__MovementData_source[this]) == 0 ) then
            return true
        endif
        return MovementSystem__DistanceSq(GetUnitX(s__MovementData_source[this]) , GetUnitY(s__MovementData_source[this]) , x , y) <= MovementSystem__SMART_POINT_TOLERANCE_SQ
    endfunction

    function s__MovementData_applyMovePoint takes integer this,real x,real y,boolean queueAimPulse returns nothing
        if s__MovementData_isPointTooClose(this,x , y) then
            call s__MovementData_rememberPoint(this,x , y)
            return
        endif

        set s__MovementData_moveX[this]=x
        set s__MovementData_moveY[this]=y
        set s__MovementData_hasMovePoint[this]=true
        set s__MovementData_isMoving[this]=true

        call IssueImmediateOrderById(s__MovementData_source[this], MovementSystem__ORDER_ID_STOP)
        call s__MovementData_ensureMoveTimer(this)

        if queueAimPulse then
            call s__MovementData_queuePulse(this)
        endif

        call s__MovementData_syncCastTextTagPosition(this)
    endfunction

    function s__MovementData_beginOrRefreshSession takes integer this,integer abilityId returns nothing
        local integer maxRecasts= 0
        local boolean allowSmart= false
        local boolean freshSession= not s__MovementData_sessionActive[this]
        local string freshStr= "0"
        local string smartStr= "0"

        if freshSession then
            set freshStr="1"
        endif

        set allowSmart=(LoadBoolean(Table__ht, (((MovementSystem__smartRecastEnabledByAbility))), (abilityId))) // INLINED!!
        set maxRecasts=R2I((LoadReal(Table__ht, (((MovementSystem__smartRecastCountByAbility))), (abilityId)))) // INLINED!!
        if allowSmart then
            set smartStr="1"
        endif





        set s__MovementData_sessionActive[this]=true
        set s__MovementData_sessionRemaining[this]=MovementSystem__MOVECAST_SESSION_DURATION
        if freshSession then
            if allowSmart and ( maxRecasts > 0 ) then
                set s__MovementData_recastsLeft[this]=maxRecasts
            else
                set s__MovementData_recastsLeft[this]=0
            endif
        endif

        call s__MovementData_ensureSessionTimer(this)
        call s__MovementData_refreshCastTextTag(this)
    endfunction

    function s__MovementData_consumeSmartRecast takes integer this returns nothing
        if s__MovementData_recastsLeft[this] > 0 then
            set s__MovementData_recastsLeft[this]=s__MovementData_recastsLeft[this] - 1
            set s__MovementData_sessionRemaining[this]=MovementSystem__MOVECAST_SESSION_DURATION
            call s__MovementData_refreshCastTextTag(this)
        endif
    endfunction

    function s__MovementData_refreshSessionDuration takes integer this returns nothing
        if s__MovementData_sessionActive[this] then
            set s__MovementData_sessionRemaining[this]=MovementSystem__MOVECAST_SESSION_DURATION
            call s__MovementData_refreshCastTextTag(this)
        endif
    endfunction

    function s__MovementData_startMoveToStoredPoint takes integer this returns nothing
        if s__MovementData_isMoving[this] then
            return
        endif

        if not s__MovementData_hasLastSmart[this] then
            return
        endif

        call s__MovementData_applyMovePoint(this,s__MovementData_lastSmartX[this] , s__MovementData_lastSmartY[this] , false)
    endfunction

    function s__MovementData_stopMovement takes integer this returns nothing
        if s__MovementData_moveTim[this] != null then
            call ReleaseTimer(s__MovementData_moveTim[this])
            set s__MovementData_moveTim[this]=null
        endif
        set s__MovementData_isMoving[this]=false
        set s__MovementData_hasMovePoint[this]=false
    endfunction

    function s__MovementData_endSession takes integer this returns nothing
        if s__MovementData_sessionTim[this] != null then
            call ReleaseTimer(s__MovementData_sessionTim[this])
            set s__MovementData_sessionTim[this]=null
        endif

        if s__MovementData_pulseTim[this] != null then
            call ReleaseTimer(s__MovementData_pulseTim[this])
            set s__MovementData_pulseTim[this]=null
        endif

        call s__MovementData_stopMovement(this)
        call s__MovementData_releaseCastTextTag(this)

        set s__MovementData_sessionActive[this]=false
        set s__MovementData_sessionRemaining[this]=0.
        set s__MovementData_recastsLeft[this]=0
        set s__MovementData_hasAimPoint[this]=false
        set s__MovementData_lastCastAbilityId[this]=0
        set s__MovementData_lastCastOrderId[this]=0
        set s__MovementData_lastCastTargetUnit[this]=null
    endfunction

    function s__MovementData_endSessionAndRestoreMovement takes integer this returns nothing
        local unit u= s__MovementData_source[this]
        local boolean hadMove= s__MovementData_isMoving[this] and s__MovementData_hasMovePoint[this]
        local real targetX= s__MovementData_moveX[this]
        local real targetY= s__MovementData_moveY[this]

        call s__MovementData_endSession(this)

        if ( not hadMove ) or ( u == null ) or ( GetUnitTypeId(u) == 0 ) or ( not UnitAlive(u) ) then
            set u=null
            return
        endif

        if MovementSystem__IsLeapBuffActive(u) then
            set u=null
            return
        endif

        if MovementSystem__DistanceSq(GetUnitX(u) , GetUnitY(u) , targetX , targetY) > MovementSystem__SMART_POINT_TOLERANCE_SQ then
            call IssuePointOrder(u, "smart", targetX, targetY)
        endif

        set u=null
    endfunction

    function s__MovementData_endSessionByCollision takes integer this returns nothing
        call s__MovementData_endSession(this)
        if ( s__MovementData_source[this] != null ) and ( GetUnitTypeId(s__MovementData_source[this]) != 0 ) and UnitAlive(s__MovementData_source[this]) then
            call IssueImmediateOrderById(s__MovementData_source[this], MovementSystem__ORDER_ID_STOP)
        endif
    endfunction

    function s__MovementData_destroy takes integer this returns nothing
        local unit u

        if s__MovementData_isDestroying[this] then
            return
        endif
        set s__MovementData_isDestroying[this]=true
        set u=s__MovementData_source[this]

        call s__MovementData_endSession(this)
        call s__MovementData_forget(u)

        set s__MovementData_source[this]=null
        set s__MovementData_lastCastTargetUnit[this]=null
        set s__MovementData_hasLastSmart[this]=false
        set s__MovementData_isDestroying[this]=false
        call s__MovementData_deallocate(this)

        set u=null
    endfunction

    function s__MovementData_onMoveTick takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer this= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local real sx
        local real sy
        local real dx
        local real dy
        local real distSq
        local real dist
        local real step
        local real nx
        local real ny

        if this == 0 then
            set t=null
            return
        endif

        if s__MovementData_moveTim[this] != t then
            set t=null
            return
        endif

        if ( s__MovementData_source[this] == null ) or ( GetUnitTypeId(s__MovementData_source[this]) == 0 ) or ( not UnitAlive(s__MovementData_source[this]) ) then
            call s__MovementData_destroy(this)
            set t=null
            return
        endif

        if MovementSystem__IsLeapBuffActive(s__MovementData_source[this]) then
            call s__MovementData_destroy(this)
            set t=null
            return
        endif

        if ( not s__MovementData_sessionActive[this] ) or ( not s__MovementData_hasMovePoint[this] ) then
            call s__MovementData_stopMovement(this)
            set t=null
            return
        endif

        set sx=GetUnitX(s__MovementData_source[this])
        set sy=GetUnitY(s__MovementData_source[this])
        set dx=s__MovementData_moveX[this] - sx
        set dy=s__MovementData_moveY[this] - sy
        set distSq=dx * dx + dy * dy

        if distSq <= MovementSystem__ARRIVAL_THRESHOLD_SQ then
            call s__MovementData_endSession(this)
            set t=null
            return
        endif

        set dist=SquareRoot(distSq)
        set step=GetUnitMoveSpeed(s__MovementData_source[this]) * MovementSystem__INTERVAL
        if step <= 0. then
            call s__MovementData_endSessionByCollision(this)
            set t=null
            return
        endif
        if step > dist then
            set step=dist
        endif

        set nx=sx + dx / dist * step
        set ny=sy + dy / dist * step

        if not IsTerrainWalkable(nx , ny) then
            call s__MovementData_endSessionByCollision(this)
            set t=null
            return
        endif

        call SetUnitX(s__MovementData_source[this], nx)
        call SetUnitY(s__MovementData_source[this], ny)
        call s__MovementData_syncCastTextTagPosition(this)

        set t=null
    endfunction

    function s__MovementData_onSessionTick takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer this= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!

        if this == 0 then
            set t=null
            return
        endif

        if s__MovementData_sessionTim[this] != t then
            set t=null
            return
        endif

        if ( s__MovementData_source[this] == null ) or ( GetUnitTypeId(s__MovementData_source[this]) == 0 ) or ( not UnitAlive(s__MovementData_source[this]) ) then
            call s__MovementData_destroy(this)
            set t=null
            return
        endif

        if MovementSystem__IsLeapBuffActive(s__MovementData_source[this]) then
            call s__MovementData_destroy(this)
            set t=null
            return
        endif

        set s__MovementData_sessionRemaining[this]=s__MovementData_sessionRemaining[this] - MovementSystem__INTERVAL
        if s__MovementData_sessionRemaining[this] <= 0. then
            call s__MovementData_endSessionAndRestoreMovement(this)
        else
            call s__MovementData_refreshCastTextTag(this)
        endif

        set t=null
    endfunction

    function s__MovementData_onPulse takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer this= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!

        if this == 0 then
            set t=null
            return
        endif

        if s__MovementData_pulseTim[this] != t then
            set t=null
            return
        endif

        set s__MovementData_pulseTim[this]=null

        if ( s__MovementData_source[this] == null ) or ( GetUnitTypeId(s__MovementData_source[this]) == 0 ) or ( not UnitAlive(s__MovementData_source[this]) ) then
            call ReleaseTimer(t)
            set t=null
            return
        endif

        if MovementSystem__IsLeapBuffActive(s__MovementData_source[this]) then
            call s__MovementData_destroy(this)
            call ReleaseTimer(t)
            set t=null
            return
        endif

        if s__MovementData_sessionActive[this] and s__MovementData_hasAimPoint[this] and ( s__MovementData_lastCastOrderId[this] != 0 ) then
            if ( s__MovementData_lastCastTargetUnit[this] != null ) and ( GetUnitTypeId(s__MovementData_lastCastTargetUnit[this]) != 0 ) and UnitAlive(s__MovementData_lastCastTargetUnit[this]) then
                call IssueTargetOrderById(s__MovementData_source[this], s__MovementData_lastCastOrderId[this], s__MovementData_lastCastTargetUnit[this])
            else
                call IssuePointOrderById(s__MovementData_source[this], s__MovementData_lastCastOrderId[this], s__MovementData_aimX[this], s__MovementData_aimY[this])
            endif
        endif

        call ReleaseTimer(t)
        set t=null
    endfunction

function MovementSystem__GetOrCreateMovementData takes unit u returns integer
    local integer data

    if not MovementSystem__IsMoveCastTrackedUnit(u) then
        return 0
    endif

    if s__MovementData_has(u) then
        return s__MovementData_get(u)
    endif

    set data=s__MovementData_create(u)
    return data
endfunction

function MovementSystem__DestroyMovementDataForUnit takes unit u returns nothing
    local integer data

    if u == null then
        return
    endif

    if s__MovementData_has(u) then
        set data=s__MovementData_get(u)
        if data != 0 then
            call s__MovementData_destroy(data)
        endif
    endif
endfunction

