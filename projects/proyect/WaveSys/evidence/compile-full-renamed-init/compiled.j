        function s__DummyCaster_prep takes integer a,player p,integer l returns nothing
            call UnitAddAbility(DummyCaster__u, a)
            if ( 1 < l ) then
                call SetUnitAbilityLevel(DummyCaster__u, a, l)
            endif
            if ( null != p ) then
                call SetUnitOwner(DummyCaster__u, p, false)
            endif
        endfunction
        function s__DummyCaster_finish takes integer a returns nothing
            call SetUnitOwner(DummyCaster__u, DummyCaster__PLAYER_OWNER, false)
            call UnitRemoveAbility(DummyCaster__u, a)
        endfunction
        function s__DummyCaster_cast takes integer this,player p,integer level,integer order,real x,real y returns boolean
            local boolean b
            call SetUnitX(DummyCaster__u, x)
            call SetUnitY(DummyCaster__u, y)
            call s__DummyCaster_prep(this , p , level)
            set b=IssueImmediateOrderById(DummyCaster__u, order)
            call s__DummyCaster_finish(this)
            call SetUnitPosition(DummyCaster__u, 32256, 32256)
            return b
        endfunction
        function s__DummyCaster_castTarget takes integer this,player p,integer level,integer order,widget t returns boolean
            local boolean b
            call s__DummyCaster_prep(this , p , level)
            set b=IssueTargetOrderById(DummyCaster__u, order, t)
            call s__DummyCaster_finish(this)
            return b
        endfunction
        function s__DummyCaster_castPoint takes integer this,player p,integer level,integer order,real x,real y returns boolean
            local boolean b
            call s__DummyCaster_prep(this , p , level)
            set b=IssuePointOrderById(DummyCaster__u, order, x, y)
            call s__DummyCaster_finish(this)
            return b
        endfunction



    function HealthBarTextTags__HealthBarClockNoop takes nothing returns nothing
    endfunction

    function HealthBarTextTags__HealthBarNow takes nothing returns real
        return TimerGetElapsed(HealthBarTextTags__HealthBarClock)
    endfunction

    function HealthBarTextTags__HealthBarRefreshVisibleTotals takes nothing returns nothing
        set HealthBarTextTags__HealthBarVisibleCount=HealthBarTextTags__HealthBarHeroVisibleCount + HealthBarTextTags__HealthBarEnemyVisibleCount
        if HealthBarTextTags__HealthBarVisibleCount > HealthBarTextTags__HealthBarPeakVisibleCount then
            set HealthBarTextTags__HealthBarPeakVisibleCount=HealthBarTextTags__HealthBarVisibleCount
        endif
    endfunction

    function HealthBarTextTags__HealthBarEnemyKey takes integer targetHid returns integer
        return targetHid
    endfunction

    function HealthBarTextTags__HealthBarGetPercent takes unit whichUnit returns integer
        local real maxLife
        local real life
        local real ratio
        local integer percent

        if whichUnit == null or GetUnitTypeId(whichUnit) == 0 then
            return 0
        endif

        set maxLife=GetUnitState(whichUnit, UNIT_STATE_MAX_LIFE)
        if maxLife <= 0.405 then
            return 0
        endif

        set life=GetUnitState(whichUnit, UNIT_STATE_LIFE)
        if life < 0.00 then
            set life=0.00
        endif

        set ratio=life / maxLife
        if ratio < 0.00 then
            set ratio=0.00
        elseif ratio > 1.00 then
            set ratio=1.00
        endif

        set percent=R2I(ratio * 100.00 + 0.5)
        if percent < 0 then
            set percent=0
        elseif percent > 100 then
            set percent=100
        endif
        return percent
    endfunction

    function HealthBarTextTags__HealthBarGetFilledSegments takes integer percent returns integer
        local integer filled= R2I(( I2R(percent) * I2R(HealthBarTextTags__HEALTH_BAR_SEGMENTS) ) / 100.00 + 0.5)
        if filled < 0 then
            set filled=0
        elseif filled > HealthBarTextTags__HEALTH_BAR_SEGMENTS then
            set filled=HealthBarTextTags__HEALTH_BAR_SEGMENTS
        endif
        return filled
    endfunction

    function HealthBarTextTags__HealthBarGetBarText takes integer percent returns string
        local integer filled= HealthBarTextTags__HealthBarGetFilledSegments(percent)
        local string filledColor
        local string emptyColor= "|cff808080"
        local string result= ""
        local integer i= 0

        if filled >= 7 then
            set filledColor="|cff50ff50"
        elseif filled >= 4 then
            set filledColor="|cffffdc00"
        else
            set filledColor="|cffff5050"
        endif

        loop
            exitwhen i >= HealthBarTextTags__HEALTH_BAR_SEGMENTS
            if i < filled then
                set result=result + filledColor + "||"
            else
                set result=result + emptyColor + "||"
            endif
            set i=i + 1
        endloop

        return result + "|r |cffffffff" + I2S(percent) + "%|r"
    endfunction

    function HealthBarTextTags__HealthBarGetHeroText takes integer pid,integer percent returns string
        return s__User__get_nameColored(((pid))) + "\n" + HealthBarTextTags__HealthBarGetBarText(percent) // INLINED!!
    endfunction

    function HealthBarTextTags__HealthBarIsTrackedUnit takes unit whichUnit returns boolean
        return whichUnit != null and GetUnitTypeId(whichUnit) != 0
    endfunction

    function HealthBarTextTags__HealthBarIsEnemyDisplayTargetValid takes unit whichUnit returns boolean
        if not HealthBarTextTags__HealthBarIsTrackedUnit(whichUnit) then
            return false
        endif
        if IsUnitType(whichUnit, UNIT_TYPE_DEAD) then
            return false
        endif
        return true
    endfunction

    function HealthBarTextTags__HealthBarCreatePersistentTextTag takes nothing returns texttag
        local texttag tag= CreateTextTag()
        call SetTextTagPermanent(tag, true)
        call SetTextTagVisibility(tag, false)
        call SetTextTagVelocity(tag, 0.00, 0.00)
        call SetTextTagFadepoint(tag, 0.00)
        call SetTextTagLifespan(tag, 999999.00)
        return tag
    endfunction

    function HealthBarTextTags__HealthBarSetTagPosition takes texttag tag,unit u,real xOffset,real zOffset returns nothing
        call SetTextTagPos(tag, GetUnitX(u) + xOffset, GetUnitY(u), zOffset + GetUnitFlyHeight(u))
    endfunction

    function GetHealthBarEnemySlotCap takes nothing returns integer
        return HealthBarTextTags__HEALTH_BAR_ENEMY_CAP
    endfunction

    function GetHealthBarHeroSlotCap takes nothing returns integer
        if s__User_AmountPlaying > HealthBarTextTags__HEALTH_BAR_HERO_CAP then
            return HealthBarTextTags__HEALTH_BAR_HERO_CAP
        endif
        return s__User_AmountPlaying
    endfunction

    function GetHealthBarTextTagCap takes nothing returns integer
        return HealthBarTextTags__HEALTH_BAR_ENEMY_CAP + GetHealthBarHeroSlotCap()
    endfunction

    function GetHealthBarVisibleCount takes nothing returns integer
        return HealthBarTextTags__HealthBarVisibleCount
    endfunction

    function GetHealthBarPeakVisibleCount takes nothing returns integer
        return HealthBarTextTags__HealthBarPeakVisibleCount
    endfunction

    function HealthBarsRefreshHeroForPlayer takes integer pid returns nothing
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return
        endif
        set HealthBarTextTags__HeroBoundHandleId[pid]=0
        set HealthBarTextTags__HeroLastPercent[pid]=- 1
    endfunction

    function HealthBarTextTags__HealthBarUpdateHeroEntry takes integer pid returns boolean
        local unit hero= PlayerHero[pid]
        local texttag heroTag= HealthBarTextTags__HeroTag[pid]
        local integer hid= 0
        local integer percent

        if not s__User_isPlaying[((pid))] or not HealthBarTextTags__HealthBarIsTrackedUnit(hero) then // INLINED!!
            if heroTag != null then
                call SetTextTagVisibility(heroTag, false)
            endif
            set HealthBarTextTags__HeroBoundHandleId[pid]=0
            set HealthBarTextTags__HeroLastPercent[pid]=- 1
            set hero=null
            set heroTag=null
            return false
        endif

        if heroTag == null then
            set heroTag=HealthBarTextTags__HealthBarCreatePersistentTextTag()
            set HealthBarTextTags__HeroTag[pid]=heroTag
        endif

        set hid=GetHandleId(hero)
        if HealthBarTextTags__HeroBoundHandleId[pid] != hid then
            set HealthBarTextTags__HeroBoundHandleId[pid]=hid
            set HealthBarTextTags__HeroLastPercent[pid]=- 1
        endif

        set percent=HealthBarTextTags__HealthBarGetPercent(hero)
        call SetTextTagText(heroTag, HealthBarTextTags__HealthBarGetHeroText(pid , percent), HealthBarTextTags__HEALTH_BAR_HERO_TEXT_SIZE)
        call SetTextTagColor(heroTag, 255, 255, 255, HealthBarTextTags__HEALTH_BAR_ALPHA)
        call HealthBarTextTags__HealthBarSetTagPosition(heroTag , hero , HealthBarTextTags__HEALTH_BAR_HERO_X_OFFSET , HealthBarTextTags__HEALTH_BAR_HERO_Z)
        call SetTextTagVisibility(heroTag, true)
        set HealthBarTextTags__HeroLastPercent[pid]=percent

        set hero=null
        set heroTag=null
        return true
    endfunction

    function HealthBarTextTags__HealthBarHeroTick takes nothing returns nothing
        local integer pid= 0
        local integer visibleCount= 0

        loop
            exitwhen pid >= bj_MAX_PLAYER_SLOTS
            if HealthBarTextTags__HealthBarUpdateHeroEntry(pid) then
                set visibleCount=visibleCount + 1
            endif
            set pid=pid + 1
        endloop

        set HealthBarTextTags__HealthBarHeroVisibleCount=visibleCount
        call HealthBarTextTags__HealthBarRefreshVisibleTotals()
    endfunction

    function HealthBarTextTags__HealthBarEnemyClearSlot takes integer slotIndex returns nothing
        local integer key
        if slotIndex < 0 or slotIndex >= HealthBarTextTags__HEALTH_BAR_ENEMY_CAP then
            return
        endif
        if HealthBarTextTags__EnemyBarTargetHid[slotIndex] != 0 then
            set key=((HealthBarTextTags__EnemyBarTargetHid[slotIndex])) // INLINED!!
            if (HaveSavedInteger(Table__ht, (HealthBarTextTags__EnemySlotByTarget), (key))) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (HealthBarTextTags__EnemySlotByTarget), (key)) // INLINED!!
            endif
        endif
        set HealthBarTextTags__EnemyBarTarget[slotIndex]=null
        set HealthBarTextTags__EnemyBarTargetHid[slotIndex]=0
        set HealthBarTextTags__EnemyBarExpireAt[slotIndex]=0.00
        set HealthBarTextTags__EnemyBarLastPercent[slotIndex]=- 1
        call SetTextTagVisibility(HealthBarTextTags__EnemyBarTag[slotIndex], false)
    endfunction

    function HealthBarTextTags__HealthBarEnemyFindSlot takes unit target returns integer
        local integer hid= GetHandleId(target)
        local integer key= ((hid)) // INLINED!!
        local integer slotIndex= 0
        local integer oldestIndex= 0
        local real oldestExpire= 9999999.00
        local real now= (TimerGetElapsed(HealthBarTextTags__HealthBarClock)) // INLINED!!

        if (HaveSavedInteger(Table__ht, (HealthBarTextTags__EnemySlotByTarget), (key))) then // INLINED!!
            return (LoadInteger(Table__ht, (HealthBarTextTags__EnemySlotByTarget), (key))) // INLINED!!
        endif

        loop
            exitwhen slotIndex >= HealthBarTextTags__HEALTH_BAR_ENEMY_CAP
            if HealthBarTextTags__EnemyBarTarget[slotIndex] == null or HealthBarTextTags__EnemyBarExpireAt[slotIndex] <= now or not HealthBarTextTags__HealthBarIsEnemyDisplayTargetValid(HealthBarTextTags__EnemyBarTarget[slotIndex]) then
                call HealthBarTextTags__HealthBarEnemyClearSlot(slotIndex)
                return slotIndex
            endif
            if HealthBarTextTags__EnemyBarExpireAt[slotIndex] < oldestExpire then
                set oldestExpire=HealthBarTextTags__EnemyBarExpireAt[slotIndex]
                set oldestIndex=slotIndex
            endif
            set slotIndex=slotIndex + 1
        endloop

        call HealthBarTextTags__HealthBarEnemyClearSlot(oldestIndex)
        return oldestIndex
    endfunction

    function HealthBarTextTags__HealthBarEnemyRefreshSlot takes integer slotIndex returns boolean
        local unit target= HealthBarTextTags__EnemyBarTarget[slotIndex]
        local integer percent

        if not HealthBarTextTags__HealthBarIsEnemyDisplayTargetValid(target) then
            call HealthBarTextTags__HealthBarEnemyClearSlot(slotIndex)
            set target=null
            return false
        endif

        set percent=HealthBarTextTags__HealthBarGetPercent(target)
        if HealthBarTextTags__EnemyBarLastPercent[slotIndex] != percent then
            call SetTextTagText(HealthBarTextTags__EnemyBarTag[slotIndex], HealthBarTextTags__HealthBarGetBarText(percent), HealthBarTextTags__HEALTH_BAR_ENEMY_TEXT_SIZE)
            call SetTextTagColor(HealthBarTextTags__EnemyBarTag[slotIndex], 255, 255, 255, HealthBarTextTags__HEALTH_BAR_ALPHA)
            set HealthBarTextTags__EnemyBarLastPercent[slotIndex]=percent
        endif
        call HealthBarTextTags__HealthBarSetTagPosition(HealthBarTextTags__EnemyBarTag[slotIndex] , target , HealthBarTextTags__HEALTH_BAR_ENEMY_X_OFFSET , HealthBarTextTags__HEALTH_BAR_ENEMY_Z)
        call SetTextTagVisibility(HealthBarTextTags__EnemyBarTag[slotIndex], true)

        set target=null
        return true
    endfunction

    function HealthBarsNotifyEnemyDamagedByPid takes integer ownerPid,unit target returns nothing
        local integer slotIndex
        local integer key
        if ownerPid < 0 or ownerPid >= bj_MAX_PLAYER_SLOTS then
            return
        endif
        if not HealthBarTextTags__HealthBarIsEnemyDisplayTargetValid(target) then
            return
        endif

        set slotIndex=HealthBarTextTags__HealthBarEnemyFindSlot(target)
        set key=((GetHandleId(target))) // INLINED!!
        set HealthBarTextTags__EnemyBarTarget[slotIndex]=target
        set HealthBarTextTags__EnemyBarTargetHid[slotIndex]=GetHandleId(target)
        set HealthBarTextTags__EnemyBarExpireAt[slotIndex]=(TimerGetElapsed(HealthBarTextTags__HealthBarClock)) + HealthBarTextTags__HEALTH_BAR_ENEMY_TIMEOUT // INLINED!!
        call SaveInteger(Table__ht, (HealthBarTextTags__EnemySlotByTarget), (key), ( slotIndex)) // INLINED!!
        call HealthBarTextTags__HealthBarEnemyRefreshSlot(slotIndex)
    endfunction

    function HealthBarsNotifyEnemyDamaged takes unit source,unit target returns nothing
        local integer ownerPid
        if source == null or target == null then
            return
        endif
        if not HealthBarTextTags__HealthBarIsTrackedUnit(source) or not HealthBarTextTags__HealthBarIsTrackedUnit(target) then
            return
        endif
        set ownerPid=GetPlayerId(GetOwningPlayer(source))
        if ownerPid < 0 or ownerPid >= bj_MAX_PLAYER_SLOTS then
            return
        endif
        if not IsPlayerEnemy(GetOwningPlayer(target), Player(ownerPid)) then
            return
        endif
        call HealthBarsNotifyEnemyDamagedByPid(ownerPid , target)
    endfunction

    function HealthBarTextTags__HealthBarEnemyTick takes nothing returns nothing
        local integer slotIndex= 0
        local integer visibleCount= 0
        local real now= (TimerGetElapsed(HealthBarTextTags__HealthBarClock)) // INLINED!!

        loop
            exitwhen slotIndex >= HealthBarTextTags__HEALTH_BAR_ENEMY_CAP
            if HealthBarTextTags__EnemyBarTarget[slotIndex] != null then
                if HealthBarTextTags__EnemyBarExpireAt[slotIndex] <= now then
                    call HealthBarTextTags__HealthBarEnemyClearSlot(slotIndex)
                elseif HealthBarTextTags__HealthBarEnemyRefreshSlot(slotIndex) then
                    set visibleCount=visibleCount + 1
                endif
            endif
            set slotIndex=slotIndex + 1
        endloop

        set HealthBarTextTags__HealthBarEnemyVisibleCount=visibleCount
        call HealthBarTextTags__HealthBarRefreshVisibleTotals()
    endfunction

    function HealthBarTextTags__Init takes nothing returns nothing
        local integer i= 0

        set HealthBarTextTags__EnemySlotByTarget=s__Table_create()

        loop
            exitwhen i >= HealthBarTextTags__HEALTH_BAR_ENEMY_CAP
            set HealthBarTextTags__EnemyBarTag[i]=HealthBarTextTags__HealthBarCreatePersistentTextTag()
            set HealthBarTextTags__EnemyBarLastPercent[i]=- 1
            set i=i + 1
        endloop

        set i=0
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set HealthBarTextTags__HeroLastPercent[i]=- 1
            set i=i + 1
        endloop

        set HealthBarTextTags__HealthBarClock=CreateTimer()
        call TimerStart(HealthBarTextTags__HealthBarClock, 864000.00, false, function HealthBarTextTags__HealthBarClockNoop)

        set HealthBarTextTags__HealthBarHeroTicker=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(HealthBarTextTags__HealthBarHeroTicker , TIMER_DEBUG_TAG_OTHER)
        call TimerStart(HealthBarTextTags__HealthBarHeroTicker, HealthBarTextTags__HEALTH_BAR_HERO_PERIOD, true, function HealthBarTextTags__HealthBarHeroTick)

        set HealthBarTextTags__HealthBarEnemyTicker=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(HealthBarTextTags__HealthBarEnemyTicker , TIMER_DEBUG_TAG_OTHER)
        call TimerStart(HealthBarTextTags__HealthBarEnemyTicker, HealthBarTextTags__HEALTH_BAR_ENEMY_PERIOD, true, function HealthBarTextTags__HealthBarEnemyTick)
    endfunction


    function IsDestructableTree takes destructable d returns boolean
        //*  851973 is the order id for stunned, it will interrupt the preceding harvest order.
        return ( IssueTargetOrderById(IsDestructableTree___harvester, IsDestructableTree___HARVEST_ORDER_ID, d) ) and ( IssueImmediateOrderById(IsDestructableTree___harvester, 851973) )
    endfunction
    function IsDestructableDead takes destructable d returns boolean
        return ( GetWidgetLife(d) <= 0.405 )
    endfunction
    function IsDestructableAlive takes destructable d returns boolean
        return ( GetWidgetLife(d) > .405 )
    endfunction
    function IsTreeAlive takes destructable tree returns boolean
        return (GetWidgetLife((tree)) > .405) and (( IssueTargetOrderById(IsDestructableTree___harvester, IsDestructableTree___HARVEST_ORDER_ID, (tree)) ) and ( IssueImmediateOrderById(IsDestructableTree___harvester, 851973) )) // INLINED!!
    endfunction
    function KillTree takes destructable tree returns boolean
        if ( IsTreeAlive(tree) ) then
            call KillDestructable(tree)
            return true
        endif
        return false
    endfunction
