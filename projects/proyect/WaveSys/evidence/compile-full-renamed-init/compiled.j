    function MenuClient__GetDefaultMenuCameraHeight takes nothing returns real
        return 500.
    endfunction

    function MenuClient__GetDefaultMenuCameraOffset takes nothing returns real
        return 467.
    endfunction

    function MenuClient__GetMinMenuCameraHeight takes nothing returns real
        return 500.
    endfunction

    function MenuClient__GetMaxMenuCameraHeight takes nothing returns real
        return 4000.
    endfunction

    function MenuClient__GetMenuCameraHeightStep takes nothing returns real
        return 500.
    endfunction

    function MenuClient__GetMenuCameraOffsetForHeight takes real height returns real
        return (467.) + ( ( height - (500.) ) / 1000. ) * 667. // INLINED!!
    endfunction

    function MenuClient__GetMenuCameraFogEnd takes real height returns real
        return 3500. + ( height - (500.) ) * 1.75 // INLINED!!
    endfunction

    function MenuClient__ApplyMenuCameraFog takes player p,real height returns nothing
        if s__User_Local == p then
            call SetTerrainFogExBJ(0, 0.00, (3500. + ( ((height)*1.0) - (500.) ) * 1.75), 0.00, 24.00, 24.00, 24.00) // INLINED!!
        endif
    endfunction

    function MenuClient__ResetMenuCameraFog takes player p returns nothing
        if s__User_Local == p then
            call ResetTerrainFogBJ()
        endif
    endfunction

    function MenuClient__EnsureMenuCameraSettings takes integer pid returns nothing
        if MenuClient__PlayerMenuCameraHeight[pid] < (500.) then // INLINED!!
            set MenuClient__PlayerMenuCameraHeight[pid]=(500.) // INLINED!!
            set MenuClient__PlayerMenuCameraOffset[pid]=(467.) // INLINED!!
        endif
    endfunction

    function MenuClient__StepMenuCameraHeight takes integer pid,real delta returns nothing
        local real nextHeight
        call MenuClient__EnsureMenuCameraSettings(pid)
        set nextHeight=MenuClient__PlayerMenuCameraHeight[pid] + delta
        if nextHeight > (4000.) then // INLINED!!
            set nextHeight=(500.) // INLINED!!
        elseif nextHeight < (500.) then // INLINED!!
            set nextHeight=(4000.) // INLINED!!
        endif
        set MenuClient__PlayerMenuCameraHeight[pid]=nextHeight
        set MenuClient__PlayerMenuCameraOffset[pid]=((467.) + ( ( ((nextHeight)*1.0) - (500.) ) / 1000. ) * 667.) // INLINED!!
    endfunction





