    function PlayerMissileLoadout__Init takes nothing returns nothing
        local integer i= 0
        local player p
        set PlayerMissileLoadout__byHandle=s__Table_create()
        loop
            exitwhen i >= PlayerMissileLoadout__MAX_PLAYER_SLOTS
            set p=Player(i)
            call SetPlayerMissileLoadout(p , PlayerMissileLoadout__DEFAULT_CHOICE_ABILITY , PlayerMissileLoadout__DEFAULT_SPEED_BONUS , PlayerMissileLoadout__DEFAULT_DAMAGE_VALUE , PlayerMissileLoadout__DEFAULT_INSTANCE_COUNT , PlayerMissileLoadout__DEFAULT_MODEL_PATH , PlayerMissileLoadout__DEFAULT_OVERLAY_MODEL_PATH)
            call SetPlayerMissileHealOnHit(p , PlayerMissileLoadout__DEFAULT_HEAL_ON_HIT)
            call SetPlayerMissileUseRapidFireMissile(p , PlayerMissileLoadout__DEFAULT_USE_RAPID_FIRE_MISSILE)
            call SetPlayerMissileUseRapidFireControl(p , PlayerMissileLoadout__DEFAULT_USE_RAPID_FIRE_CONTROL)
            call SetPlayerMissileUseSmartRecast(p , PlayerMissileLoadout__DEFAULT_USE_SMART_RECAST)
            
            // Default Leap FX
            call SetPlayerLeapCasterFx(p , PlayerMissileLoadout__DEFAULT_LEAP_CASTER_FX1 , PlayerMissileLoadout__DEFAULT_LEAP_CASTER_FX2)
            call SetPlayerLeapDummyFx(p , PlayerMissileLoadout__DEFAULT_LEAP_DUMMY_FX1 , PlayerMissileLoadout__DEFAULT_LEAP_DUMMY_FX2)
            call SetPlayerLeapDummyScale(p , PlayerMissileLoadout__DEFAULT_LEAP_DUMMY_SCALE)
            call SetPlayerLeapDummyFlightOffset(p , PlayerMissileLoadout__DEFAULT_LEAP_DUMMY_FLIGHT_OFFSET)
            call SetPlayerLeapCompanionUnitId(p , PlayerMissileLoadout__DEFAULT_LEAP_COMPANION_UNIT_ID)
            call SetPlayerLeapImpactFx(p , PlayerMissileLoadout__DEFAULT_LEAP_IMPACT_FX)
            
            call SetPlayerOrbLevel(p , 1)
            call SetPlayerPointsOfMana(p , 1)
            
            set i=i + 1
        endloop
        set p=null
    endfunction


    function AuditInit_Vars takes nothing returns nothing
        call GameStateInitDefaults()
        call InitInitialWaveMultiboard()
        call RefreshTenderUnitByType(TenderUnitTypeId , TenderX , TenderY , TenderFacing) // INLINED!!
        call PreloadMapResources()
        call InitDefaultWaveOwnerResearches()
        call InitHostileNeutralAlliances()
        call InitInitialPlayerGold()
        call InitMovementSpellTargetConfig()
        call EnablePreSelect(true, false)
        call InitPlayerBountyStates()
        call InitMenuClientDefaults()
    endfunction

    function PreConfi__Init takes nothing returns nothing
        call AuditInit_Vars()
    endfunction


//******************************************************************************
// Sistema de missile basado en tipo de unidad.
// Spell es channeling: al iniciar, muestra dummy + FX; tras dummyDelay dispara.
// Si el canal se rompe (stun/muerte/endcast), se cancela y limpia.
//******************************************************************************


    function UnitTypeMissile___FilterUnits takes unit target,player owner returns boolean
        return UnitAlive(target) and IsUnitEnemy(target, owner) and not IsUnitType(target, UNIT_TYPE_STRUCTURE)
    endfunction

    function UnitTypeMissile___DamageArea takes unit source,player owner,real x,real y,real radius,real amount returns nothing
        local unit u
        if amount <= 0. or GetUnitTypeId(source) == 0 then
            return
        endif
        call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, x, y, radius, null)
        loop
            set u=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
            exitwhen u == null
            call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, u)
            if UnitTypeMissile___FilterUnits(u , owner) then
                call WaveRecordDamageCredit(source , u)
                call UnitDamageTarget(source, u, amount, false, false, UnitTypeMissile___ATTACK_TYPE, UnitTypeMissile___DAMAGE_TYPE, null)
            endif
        endloop
        set u=null
    endfunction

    function UnitTypeMissile___PlaySoundOnUnit takes string file,unit source returns nothing
        local sound s
        if ( file == null ) or ( file == "" ) or ( source == null ) or ( GetUnitTypeId(source) == 0 ) then
            return
        endif
        set s=CreateSound(file, false, false, false, 10, 10, "")
        call SetSoundPosition(s, GetUnitX(source), GetUnitY(source), 0.)
        call StartSound(s)
        call KillSoundWhenDone(s)
        set s=null
    endfunction

    function UnitTypeMissile___PlaySoundAt takes string file,real x,real y returns nothing
        local sound s
        if ( file == null ) or ( file == "" ) then
            return
        endif
        set s=CreateSound(file, false, false, false, 10, 10, "")
        call SetSoundPosition(s, x, y, 0.)
        call StartSound(s)
        call KillSoundWhenDone(s)
        set s=null
    endfunction

    function UnitTypeMissile___OnLingerExpire takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local real x= 0.
        local real y= 0.
        local string snd= UnitTypeMissile___lingerSound[dex]
        if UnitTypeMissile___lingerDummy[dex] != null then
            set x=GetUnitX(UnitTypeMissile___lingerDummy[dex])
            set y=GetUnitY(UnitTypeMissile___lingerDummy[dex])
        endif
        // Sound: when DEFAULT_DUMMY_MODEL is fully removed (after linger).
        call UnitTypeMissile___PlaySoundAt(snd , x , y)
        if UnitTypeMissile___lingerFx[dex] != null then
            call DestroyEffect(UnitTypeMissile___lingerFx[dex])
            set UnitTypeMissile___lingerFx[dex]=null
        endif
        if UnitTypeMissile___lingerDummy[dex] != null then
            call RemoveUnit(UnitTypeMissile___lingerDummy[dex])
            set UnitTypeMissile___lingerDummy[dex]=null
        endif
        set UnitTypeMissile___lingerSound[dex]=null
        call ReleaseTimer(t)
        call s__SpellIndex_destroy(dex)
        set t=null
    endfunction

    function UnitTypeMissile___StartLingerCleanup takes unit dummy,effect fx,string snd returns nothing
        local integer dex
        local timer t
        if ( dummy == null ) and ( fx == null ) then
            return
        endif
        set dex=s__SpellIndex__allocate()
        set UnitTypeMissile___lingerDummy[dex]=dummy
        set UnitTypeMissile___lingerFx[dex]=fx
        set UnitTypeMissile___lingerSound[dex]=snd
        set t=NewTimerEx(dex)
        call SetTimerDebugTag(t , TIMER_DEBUG_TAG_OTHER)
        call TimerStart(t, UnitTypeMissile___POINT_IMPACT_LINGER, false, function UnitTypeMissile___OnLingerExpire)
        set t=null
    endfunction

    function UnitTypeMissile___ReleasePointDataIfIdle takes integer pointDex returns nothing
        local real x= 0.
        local real y= 0.
        local string snd
        local string impactModel
        local effect newFx
        if pointDex == 0 then
            return
        endif
        if not UnitTypeMissile___pointClosed[pointDex] then
            return
        endif
        if UnitTypeMissile___pointPending[pointDex] > 0 then
            return
        endif
        if UnitTypeMissile___pointDummy[pointDex] != null then
            set x=GetUnitX(UnitTypeMissile___pointDummy[pointDex])
            set y=GetUnitY(UnitTypeMissile___pointDummy[pointDex])
        endif
        if UnitTypeMissile___pointHadImpact[pointDex] then
            // This point already had missile impact(s), finalize with impact FX + linger.
            if not UnitTypeMissile___pointImpactApplied[pointDex] then
                if UnitTypeMissile___pointFx[pointDex] != null then
                    call DestroyEffect(UnitTypeMissile___pointFx[pointDex])
                    set UnitTypeMissile___pointFx[pointDex]=null
                endif
                set impactModel=UnitTypeMissile___pointImpactFx[pointDex]
                if ( UnitTypeMissile___pointDummy[pointDex] != null ) and ( impactModel != null ) and ( impactModel != "" ) then
                    set newFx=AddSpecialEffectTarget(impactModel, UnitTypeMissile___pointDummy[pointDex], "origin")
                    set UnitTypeMissile___pointFx[pointDex]=newFx
                endif
                set UnitTypeMissile___pointImpactApplied[pointDex]=true
                set impactModel=null
            endif
            // Sound: special sound for last missile resolved in this point group.
            set snd=UnitTypeMissile___pointSoundLastMissile[pointDex]
            call UnitTypeMissile___PlaySoundAt(snd , x , y)
            call UnitTypeMissile___StartLingerCleanup(UnitTypeMissile___pointDummy[pointDex] , UnitTypeMissile___pointFx[pointDex] , UnitTypeMissile___pointSoundDummyClear[pointDex])
            set UnitTypeMissile___pointDummy[pointDex]=null
            set UnitTypeMissile___pointFx[pointDex]=null
        else
            set snd=UnitTypeMissile___pointSoundDummyClear[pointDex]
            // Sound: dummy removed without impact (e.g. canceled before any missile hit).
            call UnitTypeMissile___PlaySoundAt(snd , x , y)
            if UnitTypeMissile___pointFx[pointDex] != null then
                call DestroyEffect(UnitTypeMissile___pointFx[pointDex])
                set UnitTypeMissile___pointFx[pointDex]=null
            endif
            if UnitTypeMissile___pointDummy[pointDex] != null then
                call RemoveUnit(UnitTypeMissile___pointDummy[pointDex])
                set UnitTypeMissile___pointDummy[pointDex]=null
            endif
        endif
        set UnitTypeMissile___pointImpactFx[pointDex]=null
        set UnitTypeMissile___pointSoundImpact[pointDex]=null
        set UnitTypeMissile___pointSoundLastMissile[pointDex]=null
        set UnitTypeMissile___pointSoundDummyClear[pointDex]=null
        set UnitTypeMissile___pointPending[pointDex]=0
        set UnitTypeMissile___pointImpactApplied[pointDex]=false
        set UnitTypeMissile___pointClosed[pointDex]=false
        set UnitTypeMissile___pointHadImpact[pointDex]=false
        call s__SpellIndex_destroy((pointDex))
        set snd=null
        set newFx=null
    endfunction

    function UnitTypeMissile___ResolvePointFromMissile takes integer missile,boolean applyImpactFx returns nothing
        local integer pointDex= UnitTypeMissile___pointByMissile[missile]
        local string impactModel
        local string snd
        local effect newFx
        local real sx
        local real sy

        if UnitTypeMissile___pointDoneByMissile[missile] then
            return
        endif
        set UnitTypeMissile___pointDoneByMissile[missile]=true

        if pointDex == 0 then
            return
        endif

        // Sound: missile impact (normal and special use same flow).
        if applyImpactFx then
            set UnitTypeMissile___pointHadImpact[pointDex]=true
            set snd=UnitTypeMissile___pointSoundImpact[pointDex]
            call UnitTypeMissile___PlaySoundAt(snd , s__Missile_x[missile] , s__Missile_y[missile])
        endif

        set UnitTypeMissile___pointPending[pointDex]=UnitTypeMissile___pointPending[pointDex] - 1
        if UnitTypeMissile___pointPending[pointDex] <= 0 then
            set UnitTypeMissile___pointPending[pointDex]=0
            if applyImpactFx and ( not UnitTypeMissile___pointImpactApplied[pointDex] ) then
                if UnitTypeMissile___pointFx[pointDex] != null then
                    call DestroyEffect(UnitTypeMissile___pointFx[pointDex])
                    set UnitTypeMissile___pointFx[pointDex]=null
                endif
                set impactModel=UnitTypeMissile___pointImpactFx[pointDex]
                if ( UnitTypeMissile___pointDummy[pointDex] != null ) and ( impactModel != null ) and ( impactModel != "" ) then
                    set newFx=AddSpecialEffectTarget(impactModel, UnitTypeMissile___pointDummy[pointDex], "origin")
                    set UnitTypeMissile___pointFx[pointDex]=newFx
                endif
                set UnitTypeMissile___pointImpactApplied[pointDex]=true
                set impactModel=null
            endif
            // Keep point data alive while channel can still launch more shots.
            if not UnitTypeMissile___pointClosed[pointDex] then
                set UnitTypeMissile___pointByMissile[missile]=0
                set snd=null
                set newFx=null
                return
            endif
            set sx=s__Missile_x[missile]
            set sy=s__Missile_y[missile]
            if UnitTypeMissile___pointDummy[pointDex] != null then
                set sx=GetUnitX(UnitTypeMissile___pointDummy[pointDex])
                set sy=GetUnitY(UnitTypeMissile___pointDummy[pointDex])
            endif
            // Sound: special sound for last missile resolved in this point group.
            if applyImpactFx then
                set snd=UnitTypeMissile___pointSoundLastMissile[pointDex]
                call UnitTypeMissile___PlaySoundAt(snd , sx , sy)
            endif
            call UnitTypeMissile___StartLingerCleanup(UnitTypeMissile___pointDummy[pointDex] , UnitTypeMissile___pointFx[pointDex] , UnitTypeMissile___pointSoundDummyClear[pointDex])
            set UnitTypeMissile___pointDummy[pointDex]=null
            set UnitTypeMissile___pointFx[pointDex]=null
            set UnitTypeMissile___pointImpactFx[pointDex]=null
            set UnitTypeMissile___pointSoundImpact[pointDex]=null
            set UnitTypeMissile___pointSoundLastMissile[pointDex]=null
            set UnitTypeMissile___pointSoundDummyClear[pointDex]=null
            set UnitTypeMissile___pointPending[pointDex]=0
            set UnitTypeMissile___pointImpactApplied[pointDex]=false
            set UnitTypeMissile___pointClosed[pointDex]=false
            set UnitTypeMissile___pointHadImpact[pointDex]=false
            call s__SpellIndex_destroy((pointDex))
        endif

        set UnitTypeMissile___pointByMissile[missile]=0
        set snd=null
        set newFx=null
    endfunction

        function s__UnitTypeMissile___UnitTypeMissileCore_onCollide takes integer missile,unit hit returns boolean
            if not UnitTypeMissile___impactOnPathByMissile[missile] then
                return false
            endif
            if not UnitTypeMissile___FilterUnits(hit , s__Missile_owner[missile]) then
                return false
            endif
            call UnitTypeMissile___DamageArea(s__Missile_source[missile] , s__Missile_owner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , s__Missile_collision[missile] , s__Missile_damage[missile])
            call UnitTypeMissile___ResolvePointFromMissile(missile , true)
            return true
        endfunction

        function s__UnitTypeMissile___UnitTypeMissileCore_onFinish takes integer missile returns boolean
            call UnitTypeMissile___DamageArea(s__Missile_source[missile] , s__Missile_owner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , s__Missile_collision[missile] , s__Missile_damage[missile])
            call UnitTypeMissile___ResolvePointFromMissile(missile , true)
            return true
        endfunction

        function s__UnitTypeMissile___UnitTypeMissileCore_onRemove takes integer missile returns boolean
            if UnitTypeMissile___overlayFx[missile] != null then
                call DestroyEffect(UnitTypeMissile___overlayFx[missile])
                set UnitTypeMissile___overlayFx[missile]=null
            endif
            if not UnitTypeMissile___pointDoneByMissile[missile] then
                call UnitTypeMissile___ResolvePointFromMissile(missile , false)
            endif
            set UnitTypeMissile___pointByMissile[missile]=0
            set UnitTypeMissile___pointDoneByMissile[missile]=false
            set UnitTypeMissile___impactOnPathByMissile[missile]=false
            call s__SpellIndex_destroy((s__Missile_data[missile]))
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__UnitTypeMissile___UnitTypeMissileCore_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__UnitTypeMissile___UnitTypeMissileCore],missile)
            call Missile___StartPeriodic(si__UnitTypeMissile___UnitTypeMissileCore)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__UnitTypeMissile___UnitTypeMissileCore_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__UnitTypeMissile___UnitTypeMissileCore_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__UnitTypeMissile___UnitTypeMissileCore)
            endif
        endfunction
























        













    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__UnitTypeMissile___UnitTypeMissileCore_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__UnitTypeMissile___UnitTypeMissileCore])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__UnitTypeMissile___UnitTypeMissileCore_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.

                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            set b=s__Missile_collisionType[this] == Missile_COLLISION_TYPE_RECTANGLE
                            if b then
                                call s__Missile_groupEnumUnitsRectangle(this)
                            else
                                call GroupEnumUnitsInRange(Missile___GROUP, s__Missile_x[this], s__Missile_y[this], s__Missile_collision[this] + Missile_MAXIMUM_COLLISION_SIZE, null)
                            endif
                            loop
                                set u=FirstOfGroup(Missile___GROUP)
                                exitwhen u == null
                                call GroupRemoveUnit(Missile___GROUP, u)
                                if not HaveSavedHandle(Missile___HASH, this, GetHandleId(u)) then
                                    if IsUnitInRange(u, s__Missile_dummy[this], s__Missile_collision[this]) or b then
                                        // Eventually run z collision checks.

                                            set collideZ=Missile_GetLocZ(GetUnitX(u) , GetUnitY(u)) + GetUnitFlyHeight(u) - s__Missile_terrainZ[this]
                                            if ( collideZ + GetUnitBodySize(u) >= s__Missile_z[this] - (s__Missile_collision[(this)]) ) and ( collideZ <= s__Missile_z[this] + (s__Missile_collision[(this)]) ) then // INLINED!!
                                                // Mark as hit.
                                                call SaveUnitHandle(Missile___HASH, this, GetHandleId(u), u)
                                                if s__UnitTypeMissile___UnitTypeMissileCore_onCollide(this , u) then
                                                    call s__UnitTypeMissile___UnitTypeMissileCore_missileTerminateP(this)
                                                    exitwhen true
                                                endif
                                            endif
    








                                    endif
                                endif
                            endloop
                        endif

                    
                    // Runs destructable collision.






                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__UnitTypeMissile___UnitTypeMissileCore_onFinish(this) then
                                call s__UnitTypeMissile___UnitTypeMissileCore_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.





                
                    // Runs every Missile_TIMER_TIMEOUT.





                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__UnitTypeMissile___UnitTypeMissileCore_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__UnitTypeMissile___UnitTypeMissileCore)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__UnitTypeMissile___UnitTypeMissileCore )]=Condition(( function s__UnitTypeMissile___UnitTypeMissileCore_missileIterateP)) // INLINED!!
        endfunction

    function UnitTypeMissile___Cleanup takes integer dex,integer reason returns nothing
        local integer hid
        local integer pointDex
        local integer pointDex2
        local string snd
        if dex == 0 then
            return
        endif

        if s__SpellIndex_source[dex] != null then
            if reason == UnitTypeMissile___CLEANUP_REASON_INTERRUPTED then
                // Sound: caster interrupted (stun/death/cancel).
                set snd=UnitTypeMissile___castSoundInterrupted[dex]
                call UnitTypeMissile___PlaySoundOnUnit(snd , s__SpellIndex_source[dex])
            elseif reason == UnitTypeMissile___CLEANUP_REASON_COMPLETED then
                // Sound: channeling completed successfully.
                set snd=UnitTypeMissile___castSoundChannelComplete[dex]
                call UnitTypeMissile___PlaySoundOnUnit(snd , s__SpellIndex_source[dex])
            endif
            set hid=GetHandleId(s__SpellIndex_source[dex])
            if (HaveSavedInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) and ( (LoadInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) == dex ) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (UnitTypeMissile___activeData), (hid)) // INLINED!!
            endif
            call SetUnitTimeScale(s__SpellIndex_source[dex], 1.0)
            call SetUnitState(s__SpellIndex_source[dex], UNIT_STATE_MANA, 0.)
        endif
        set pointDex=UnitTypeMissile___castNormalPointData[dex]
        set pointDex2=UnitTypeMissile___castSpecialPointData[dex]
        if pointDex != 0 then
            set UnitTypeMissile___pointClosed[pointDex]=true
        endif
        if ( pointDex2 != 0 ) and ( pointDex2 != pointDex ) then
            set UnitTypeMissile___pointClosed[pointDex2]=true
        endif
        call UnitTypeMissile___ReleasePointDataIfIdle(pointDex)
        if pointDex2 != pointDex then
            call UnitTypeMissile___ReleasePointDataIfIdle(pointDex2)
        endif
        set UnitTypeMissile___castNormalPointData[dex]=0
        set UnitTypeMissile___castSpecialPointData[dex]=0

        if UnitTypeMissile___castFx[dex] != null then
            call DestroyEffect(UnitTypeMissile___castFx[dex])
            set UnitTypeMissile___castFx[dex]=null
        endif
        if UnitTypeMissile___castWaitFx[dex] != null then
            call DestroyEffect(UnitTypeMissile___castWaitFx[dex])
            set UnitTypeMissile___castWaitFx[dex]=null
        endif
        if UnitTypeMissile___castDummy[dex] != null then
            call RemoveUnit(UnitTypeMissile___castDummy[dex])
            set UnitTypeMissile___castDummy[dex]=null
        endif

        if s__SpellIndex_clock[dex] != null then
            call ReleaseTimer(s__SpellIndex_clock[dex])
            set s__SpellIndex_clock[dex]=null
        endif
        if UnitTypeMissile___delayedAnimTimer[dex] != null then
            call ReleaseTimer(UnitTypeMissile___delayedAnimTimer[dex])
            set UnitTypeMissile___delayedAnimTimer[dex]=null
        endif

        set UnitTypeMissile___castX[dex]=0.
        set UnitTypeMissile___castY[dex]=0.
        set UnitTypeMissile___castAngle[dex]=0.
        set UnitTypeMissile___castDistance[dex]=0.
        set UnitTypeMissile___castTargetX[dex]=0.
        set UnitTypeMissile___castTargetY[dex]=0.
        set UnitTypeMissile___castUseRapid[dex]=false
        set UnitTypeMissile___castRapidRemaining[dex]=0.
        set UnitTypeMissile___castRapidInterval[dex]=0.
        set UnitTypeMissile___castAnim[dex]=null
        set UnitTypeMissile___castAnimScale[dex]=0.
        set UnitTypeMissile___castSoundWaitEnd[dex]=null
        set UnitTypeMissile___castSoundInterrupted[dex]=null
        set UnitTypeMissile___castSoundChannelComplete[dex]=null
        set UnitTypeMissile___castNormalPointData[dex]=0
        set UnitTypeMissile___castSpecialPointData[dex]=0
        set UnitTypeMissile___castNormalShots[dex]=0

        set s__SpellIndex_source[dex]=null
        set s__SpellIndex_target[dex]=null
        call s__SpellIndex_destroy(dex)
        set snd=null
    endfunction

    function UnitTypeMissile___FireMissile takes integer castDex returns nothing
        local unit source= s__SpellIndex_source[castDex]
        local player owner= s__SpellIndex_user[castDex]
        local integer unitType
        local real startZ
        local real flyZ
        local real arcHeight
        local real arc
        local real speed
        local real damage
        local real collision
        local real scale
        local real manaCost
        local string model
        local string overlayModel
        local string impactFx
        local integer pointDex= 0
        local boolean impactOnPath
        local boolean specialEnabled
        local integer specialAfterNormal
        local boolean isSpecial= false
        local string specialModel
        local string specialOverlay
        local string soundImpact
        local string soundLastMissile
        local string soundDummyClear
        local real specialDamageMult
        local real specialAreaMult
        local real specialSpeedMult
        local real specialMissileScaleMult
        local real specialDummyScaleMult
        local string dummyModel
        local real dummyScale
        local real dummyArea
        local real baseDummyScale
        local real specialDummyScale
        local integer mDex
        local integer missile

        if source == null or GetUnitTypeId(source) == 0 then
            set source=null
            set owner=null
            return
        endif

        set unitType=GetUnitTypeId(source)
        if not (HaveSavedInteger(Table__ht, (UnitTypeMissileLoadout___byType), ((unitType)))) then // INLINED!!
            set source=null
            set owner=null
            return
        endif

        set speed=(UnitTypeMissileLoadout___typeSpeed[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if speed < 1. then
            set speed=1.
        endif

        set damage=(UnitTypeMissileLoadout___typeDamage[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if damage < 0. then
            set damage=0.
        endif

        set collision=(UnitTypeMissileLoadout___typeMissileCollision[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if collision < 0. then
            set collision=0.
        endif

        set scale=(UnitTypeMissileLoadout___typeMissileScale[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if scale <= 0. then
            set scale=0.01
        endif

        set model=(UnitTypeMissileLoadout___typeModel[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set overlayModel=(UnitTypeMissileLoadout___typeOverlay[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set impactFx=(UnitTypeMissileLoadout___typeDummyImpactFx[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set impactOnPath=(UnitTypeMissileLoadout___typeImpactOnPath[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set soundImpact=(UnitTypeMissileLoadout___typeSoundImpact[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set soundLastMissile=(UnitTypeMissileLoadout___typeSoundLastMissile[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set soundDummyClear=(UnitTypeMissileLoadout___typeSoundDummyClear[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set specialEnabled=(UnitTypeMissileLoadout___typeSpecialEnabled[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set specialAfterNormal=(UnitTypeMissileLoadout___typeSpecialAfterNormalShots[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if specialAfterNormal < 1 then
            set specialAfterNormal=1
        endif
        if specialEnabled then
            if UnitTypeMissile___castNormalShots[castDex] >= specialAfterNormal then
                set isSpecial=true
                set UnitTypeMissile___castNormalShots[castDex]=0
            else
                set UnitTypeMissile___castNormalShots[castDex]=UnitTypeMissile___castNormalShots[castDex] + 1
            endif
        endif

        if isSpecial then
            set specialModel=(UnitTypeMissileLoadout___typeSpecialMissileModel[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
            set specialOverlay=(UnitTypeMissileLoadout___typeSpecialOverlayModel[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
            set specialDamageMult=(UnitTypeMissileLoadout___typeSpecialDamageMult[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
            set specialAreaMult=(UnitTypeMissileLoadout___typeSpecialAreaMult[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
            set specialSpeedMult=(UnitTypeMissileLoadout___typeSpecialSpeedMult[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
            set specialMissileScaleMult=(UnitTypeMissileLoadout___typeSpecialMissileScaleMult[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
            if specialDamageMult < 0. then
                set specialDamageMult=0.
            endif
            if specialAreaMult < 0. then
                set specialAreaMult=0.
            endif
            if specialSpeedMult <= 0. then
                set specialSpeedMult=0.01
            endif
            if specialMissileScaleMult <= 0. then
                set specialMissileScaleMult=0.01
            endif
            if ( specialModel != null ) and ( specialModel != "" ) then
                set model=specialModel
            endif
            if ( specialOverlay != null ) and ( specialOverlay != "" ) then
                set overlayModel=specialOverlay
            endif
            set damage=damage * specialDamageMult
            set collision=collision * specialAreaMult
            set speed=speed * specialSpeedMult
            set scale=scale * specialMissileScaleMult
            if speed < 1. then
                set speed=1.
            endif
            if scale <= 0. then
                set scale=0.01
            endif
        endif

        set startZ=(UnitTypeMissileLoadout___typeMissileStartZ[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set flyZ=(UnitTypeMissileLoadout___typeMissileFlyHeight[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set arcHeight=(UnitTypeMissileLoadout___typeMissileArc[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if arcHeight < 0. then
            set arcHeight=0.
        endif
        if UnitTypeMissile___castDistance[castDex] > 0. then
            set arc=Atan(( 4.0 * arcHeight ) / UnitTypeMissile___castDistance[castDex])
        else
            set arc=0.
        endif

        set manaCost=(UnitTypeMissileLoadout___typeManaCost[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if manaCost > 0. then
            call SetUnitState(source, UNIT_STATE_MANA, RMaxBJ(0., GetUnitState(source, UNIT_STATE_MANA) - manaCost))
        endif

        set mDex=s__SpellIndex__allocate()
        set s__SpellIndex_source[mDex]=source
        set s__SpellIndex_user[mDex]=owner

        set missile=s__Missile_create(UnitTypeMissile___castX[castDex] , UnitTypeMissile___castY[castDex] , startZ , UnitTypeMissile___castAngle[castDex] , UnitTypeMissile___castDistance[castDex] , flyZ)
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=owner
        set s__Missile_data[missile]=mDex
        call s__Missile__set_model(missile,model)
        call s__Missile__set_scale(missile,scale)
        set s__Missile_collision[missile]=collision
        call s__Missile__set_arc(missile,arc)
        set s__Missile_speed[(missile)]=((speed)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
        set s__Missile_damage[missile]=damage

        call s__UnitTypeMissile___UnitTypeMissileCore_launch(missile)
        if ( overlayModel != null ) and ( overlayModel != "" ) then
            set UnitTypeMissile___overlayFx[missile]=AddSpecialEffectTarget(overlayModel, s__Missile_dummy[missile], UnitTypeMissile___WRAP_ATTACH_POINT)
        else
            set UnitTypeMissile___overlayFx[missile]=null
        endif

        if isSpecial then
            set pointDex=UnitTypeMissile___castSpecialPointData[castDex]
            if pointDex == 0 then
                set dummyModel=(UnitTypeMissileLoadout___typeDummyModel[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
                if ( dummyModel != null ) and ( dummyModel != "" ) then
                    set dummyScale=(UnitTypeMissileLoadout___typeDummyScale[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
                    if dummyScale <= 0. then
                        set dummyScale=0.01
                    endif
                    set dummyArea=(UnitTypeMissileLoadout___typeDummyArea[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
                    if dummyArea <= 0. then
                        set dummyArea=100.
                    endif
                    set specialDummyScaleMult=(UnitTypeMissileLoadout___typeSpecialDummyScaleMult[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
                    if specialDummyScaleMult <= 0. then
                        set specialDummyScaleMult=0.01
                    endif
                    set baseDummyScale=dummyScale * ( dummyArea / 100. )
                    set specialDummyScale=baseDummyScale * specialDummyScaleMult
                    set pointDex=s__SpellIndex__allocate()
                    set UnitTypeMissile___castSpecialPointData[castDex]=pointDex
                    set UnitTypeMissile___pointDummy[pointDex]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), UnitTypeMissile___DUMMY_UNIT_ID, UnitTypeMissile___castTargetX[castDex], UnitTypeMissile___castTargetY[castDex], UnitTypeMissile___castAngle[castDex] * bj_RADTODEG)
                    call SetUnitScale(UnitTypeMissile___pointDummy[pointDex], specialDummyScale, specialDummyScale, specialDummyScale)
                    set UnitTypeMissile___pointFx[pointDex]=AddSpecialEffectTarget(dummyModel, UnitTypeMissile___pointDummy[pointDex], "origin")
                    call UnitAddAbility(UnitTypeMissile___pointDummy[pointDex], UnitTypeMissile___DUMMY_ABILITY)
                    call SetUnitAbilityLevel(UnitTypeMissile___pointDummy[pointDex], UnitTypeMissile___DUMMY_ABILITY, 1)
                    call UnitRemoveAbility(UnitTypeMissile___pointDummy[pointDex], UnitTypeMissile___DUMMY_ABILITY)
                    set UnitTypeMissile___pointImpactFx[pointDex]=impactFx
                    set UnitTypeMissile___pointSoundImpact[pointDex]=soundImpact
                    set UnitTypeMissile___pointSoundLastMissile[pointDex]=soundLastMissile
                    set UnitTypeMissile___pointSoundDummyClear[pointDex]=soundDummyClear
                    set UnitTypeMissile___pointPending[pointDex]=0
                    set UnitTypeMissile___pointImpactApplied[pointDex]=false
                    set UnitTypeMissile___pointClosed[pointDex]=false
                    set UnitTypeMissile___pointHadImpact[pointDex]=false
                endif
            endif
        else
            set pointDex=UnitTypeMissile___castNormalPointData[castDex]
            if ( pointDex == 0 ) and ( ( UnitTypeMissile___castDummy[castDex] != null ) or ( UnitTypeMissile___castFx[castDex] != null ) ) then
                set pointDex=s__SpellIndex__allocate()
                set UnitTypeMissile___castNormalPointData[castDex]=pointDex
                set UnitTypeMissile___pointDummy[pointDex]=UnitTypeMissile___castDummy[castDex]
                set UnitTypeMissile___pointFx[pointDex]=UnitTypeMissile___castFx[castDex]
                set UnitTypeMissile___pointImpactFx[pointDex]=impactFx
                set UnitTypeMissile___pointSoundImpact[pointDex]=soundImpact
                set UnitTypeMissile___pointSoundLastMissile[pointDex]=soundLastMissile
                set UnitTypeMissile___pointSoundDummyClear[pointDex]=soundDummyClear
                set UnitTypeMissile___pointPending[pointDex]=0
                set UnitTypeMissile___pointImpactApplied[pointDex]=false
                set UnitTypeMissile___pointClosed[pointDex]=false
                set UnitTypeMissile___pointHadImpact[pointDex]=false
                set UnitTypeMissile___castDummy[castDex]=null
                set UnitTypeMissile___castFx[castDex]=null
            endif
        endif

        if pointDex != 0 then
            set UnitTypeMissile___pointPending[pointDex]=UnitTypeMissile___pointPending[pointDex] + 1
            set UnitTypeMissile___pointByMissile[missile]=pointDex
            set UnitTypeMissile___pointDoneByMissile[missile]=false
        else
            set UnitTypeMissile___pointByMissile[missile]=0
            set UnitTypeMissile___pointDoneByMissile[missile]=true
        endif
        set UnitTypeMissile___impactOnPathByMissile[missile]=impactOnPath

        set source=null
        set owner=null
        set specialModel=null
        set specialOverlay=null
        set impactFx=null
        set soundImpact=null
        set soundLastMissile=null
        set soundDummyClear=null
        set dummyModel=null
    endfunction

    function UnitTypeMissile___OnFire takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!

        // Timer consumed; don't keep a stale handle in dex.clock.
        if s__SpellIndex_clock[dex] == t then
            set s__SpellIndex_clock[dex]=null
        endif
        call ReleaseTimer(t)
        set t=null

        if ( dex == 0 ) or ( s__SpellIndex_source[dex] == null ) or ( GetUnitTypeId(s__SpellIndex_source[dex]) == 0 ) then
            call UnitTypeMissile___Cleanup(dex , UnitTypeMissile___CLEANUP_REASON_NONE)
            return
        endif
        if not UnitAlive(s__SpellIndex_source[dex]) then
            call UnitTypeMissile___Cleanup(dex , UnitTypeMissile___CLEANUP_REASON_INTERRUPTED)
            return
        endif
        if not (s__IsUnitChanneling__OnChannel_channeling[GetUnitUserData((s__SpellIndex_source[dex]))]) then // INLINED!!
            call UnitTypeMissile___Cleanup(dex , UnitTypeMissile___CLEANUP_REASON_INTERRUPTED)
            return
        endif

        // Caster wait effect now persists during the whole cast and is removed in Cleanup.

        // Sound: wait finished and shot tick starts (fires each rapid-fire interval).
        call UnitTypeMissile___PlaySoundOnUnit(UnitTypeMissile___castSoundWaitEnd[dex] , s__SpellIndex_source[dex])
        // Rapid-fire animation: replay attack every interval.
        if ( UnitTypeMissile___castAnim[dex] != null ) and ( UnitTypeMissile___castAnim[dex] != "" ) then
            call SetUnitAnimation(s__SpellIndex_source[dex], UnitTypeMissile___castAnim[dex])
            call SetUnitTimeScale(s__SpellIndex_source[dex], UnitTypeMissile___castAnimScale[dex])
        endif

        call UnitTypeMissile___FireMissile(dex)

        if UnitTypeMissile___castUseRapid[dex] then
            set UnitTypeMissile___castRapidRemaining[dex]=UnitTypeMissile___castRapidRemaining[dex] - UnitTypeMissile___castRapidInterval[dex]
            if UnitTypeMissile___castRapidRemaining[dex] > 0. then
                set s__SpellIndex_clock[dex]=NewTimerEx(dex)
                call SetTimerDebugTag(s__SpellIndex_clock[dex] , TIMER_DEBUG_TAG_OTHER)
                call TimerStart(s__SpellIndex_clock[dex], UnitTypeMissile___castRapidInterval[dex], false, function UnitTypeMissile___OnFire)
                return
            endif
        endif

        // Wait for SPELL_FINISH to classify completion reliably.
        // This avoids marking "completed" from internal rapid-fire timer only.
        return
    endfunction

    function UnitTypeMissile___DelayedStartAnimation takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local unit source= s__SpellIndex_source[dex]
        local integer hid
        set UnitTypeMissile___delayedAnimTimer[dex]=null
        call ReleaseTimer(t)
        set t=null

        if ( source != null ) and UnitAlive(source) then
            set hid=GetHandleId(source)
            if (HaveSavedInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) and ( (LoadInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) == dex ) then // INLINED!!
                if ( UnitTypeMissile___castAnim[dex] != null ) and ( UnitTypeMissile___castAnim[dex] != "" ) then
                    call SetUnitAnimation(source, UnitTypeMissile___castAnim[dex])
                    call SetUnitTimeScale(source, UnitTypeMissile___castAnimScale[dex])
                endif
            endif
        endif
        set source=null
    endfunction

    function UnitTypeMissile___OnEffect takes nothing returns nothing
        local unit u= GetTriggerUnit()
        local integer unitType= GetUnitTypeId(u)
        local integer hid= GetHandleId(u)
        local real x= GetUnitX(u)
        local real y= GetUnitY(u)
        local real tx= GetSpellTargetX()
        local real ty= GetSpellTargetY()
        local real dx= tx - x
        local real dy= ty - y
        local integer dex
        local string dummyModel
        local real dummyScale
        local real dummyArea
        local real dummyDelay
        local string casterWaitFx
        local string castAnimLocal
        local real castTimeScale
        local real castDelay
        local real interval
        local real duration
        local string soundCastStart
        local string soundWaitStart
        local string soundWaitEnd
        local string soundInterrupted
        local string soundChannelComplete

        if not (HaveSavedInteger(Table__ht, (UnitTypeMissileLoadout___byType), ((unitType)))) then // INLINED!!
            // Cancel cast immediately when this unit type has no loadout config.
            call IssueImmediateOrder(u, "stop")
            set u=null
            return
        endif

        if (HaveSavedInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) then // INLINED!!
            call UnitTypeMissile___Cleanup((LoadInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) , UnitTypeMissile___CLEANUP_REASON_INTERRUPTED) // INLINED!!
        endif

        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=u
        set s__SpellIndex_user[dex]=GetOwningPlayer(u)
        set soundCastStart=(UnitTypeMissileLoadout___typeSoundCastStart[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set soundWaitStart=(UnitTypeMissileLoadout___typeSoundWaitStart[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set soundWaitEnd=(UnitTypeMissileLoadout___typeSoundWaitEnd[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set soundInterrupted=(UnitTypeMissileLoadout___typeSoundInterrupted[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set soundChannelComplete=(UnitTypeMissileLoadout___typeSoundChannelComplete[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set UnitTypeMissile___castSoundWaitEnd[dex]=soundWaitEnd
        set UnitTypeMissile___castSoundInterrupted[dex]=soundInterrupted
        set UnitTypeMissile___castSoundChannelComplete[dex]=soundChannelComplete

        // Sound: ability cast started.
        call UnitTypeMissile___PlaySoundOnUnit(soundCastStart , u)

        set UnitTypeMissile___castX[dex]=x
        set UnitTypeMissile___castY[dex]=y
        set UnitTypeMissile___castAngle[dex]=Atan2(dy, dx)
        set UnitTypeMissile___castDistance[dex]=SquareRoot(dx * dx + dy * dy)
        set UnitTypeMissile___castNormalPointData[dex]=0
        set UnitTypeMissile___castSpecialPointData[dex]=0
        set UnitTypeMissile___castNormalShots[dex]=0
        if UnitTypeMissile___castDistance[dex] <= 0. then
            set UnitTypeMissile___castDistance[dex]=1.
        endif
        set UnitTypeMissile___castTargetX[dex]=tx
        set UnitTypeMissile___castTargetY[dex]=ty
        set dummyModel=(UnitTypeMissileLoadout___typeDummyModel[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set dummyScale=(UnitTypeMissileLoadout___typeDummyScale[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set dummyArea=(UnitTypeMissileLoadout___typeDummyArea[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if dummyArea <= 0. then
            set dummyArea=100.
        endif
        set dummyDelay=(UnitTypeMissileLoadout___typeDummyDelay[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if dummyDelay < 0. then
            set dummyDelay=0.
        endif

        if ( dummyModel != null ) and ( dummyModel != "" ) then
            set UnitTypeMissile___castDummy[dex]=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), UnitTypeMissile___DUMMY_UNIT_ID, UnitTypeMissile___castTargetX[dex], UnitTypeMissile___castTargetY[dex], UnitTypeMissile___castAngle[dex] * bj_RADTODEG)
            call SetUnitScale(UnitTypeMissile___castDummy[dex], dummyScale * ( dummyArea / 100. ), dummyScale * ( dummyArea / 100. ), dummyScale * ( dummyArea / 100. ))
            set UnitTypeMissile___castFx[dex]=AddSpecialEffectTarget(dummyModel, UnitTypeMissile___castDummy[dex], "origin")
            call UnitAddAbility(UnitTypeMissile___castDummy[dex], UnitTypeMissile___DUMMY_ABILITY)
            call SetUnitAbilityLevel(UnitTypeMissile___castDummy[dex], UnitTypeMissile___DUMMY_ABILITY, 1)
            call UnitRemoveAbility(UnitTypeMissile___castDummy[dex], UnitTypeMissile___DUMMY_ABILITY)
        else
            set UnitTypeMissile___castDummy[dex]=null
            set UnitTypeMissile___castFx[dex]=null
        endif

        set casterWaitFx=(UnitTypeMissileLoadout___typeCasterWaitFx[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if ( casterWaitFx != null ) and ( casterWaitFx != "" ) then
            set UnitTypeMissile___castWaitFx[dex]=AddSpecialEffectTarget(casterWaitFx, u, "origin")
        else
            set UnitTypeMissile___castWaitFx[dex]=null
        endif
        // Sound: wait phase started.
        call UnitTypeMissile___PlaySoundOnUnit(soundWaitStart , u)

        set UnitTypeMissile___castUseRapid[dex]=(UnitTypeMissileLoadout___typeUseRapidFire[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set interval=(UnitTypeMissileLoadout___typeRapidFireInterval[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set duration=(UnitTypeMissileLoadout___typeRapidFireDuration[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if interval <= 0. then
            set interval=0.10
        endif
        if duration < 0. then
            set duration=0.
        endif
        set UnitTypeMissile___castRapidInterval[dex]=interval
        set UnitTypeMissile___castRapidRemaining[dex]=duration

        // Animation (immediate or delayed)
        set castAnimLocal=(UnitTypeMissileLoadout___typeCastAnimation[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set castDelay=(UnitTypeMissileLoadout___typeCastAnimDelay[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        set castTimeScale=(UnitTypeMissileLoadout___typeCastAnimTimeScale[UnitTypeMissileLoadout___SlotOfType((unitType))]) // INLINED!!
        if castTimeScale <= 0. then
            set castTimeScale=1.
        endif
        set UnitTypeMissile___castAnim[dex]=castAnimLocal
        set UnitTypeMissile___castAnimScale[dex]=castTimeScale
        if ( castAnimLocal != null ) and ( castAnimLocal != "" ) then
            if castDelay <= 0. then
                call SetUnitAnimation(u, castAnimLocal)
                call SetUnitTimeScale(u, castTimeScale)
            else
                set UnitTypeMissile___delayedAnimTimer[dex]=NewTimerEx(dex)
                call SetTimerDebugTag(UnitTypeMissile___delayedAnimTimer[dex] , TIMER_DEBUG_TAG_OTHER)
                call TimerStart(UnitTypeMissile___delayedAnimTimer[dex], castDelay, false, function UnitTypeMissile___DelayedStartAnimation)
            endif
        endif

        call SaveInteger(Table__ht, (UnitTypeMissile___activeData), (hid), ( dex)) // INLINED!!

        set s__SpellIndex_clock[dex]=NewTimerEx(dex)
        call SetTimerDebugTag(s__SpellIndex_clock[dex] , TIMER_DEBUG_TAG_OTHER)
        call TimerStart(s__SpellIndex_clock[dex], dummyDelay, false, function UnitTypeMissile___OnFire)

        set soundCastStart=null
        set soundWaitStart=null
        set soundWaitEnd=null
        set soundInterrupted=null
        set soundChannelComplete=null
        set u=null
    endfunction

    function UnitTypeMissile___OnInterrupted takes nothing returns nothing
        local unit u= GetTriggerUnit()
        local integer hid= GetHandleId(u)
        if (HaveSavedInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) then // INLINED!!
            // Ignore transient endcast/orders while the caster is still channeling.
            // This avoids cutting the active cast flow on internal retarget/recast.
            if (s__IsUnitChanneling__OnChannel_channeling[GetUnitUserData((u))]) then // INLINED!!
                set u=null
                return
            endif
            call UnitTypeMissile___Cleanup((LoadInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) , UnitTypeMissile___CLEANUP_REASON_INTERRUPTED) // INLINED!!
        endif
        set u=null
    endfunction

    function UnitTypeMissile___OnSpellFinish takes nothing returns nothing
        local unit u= GetTriggerUnit()
        local integer hid= GetHandleId(u)
        if (HaveSavedInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) then // INLINED!!
            call UnitTypeMissile___Cleanup((LoadInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) , UnitTypeMissile___CLEANUP_REASON_COMPLETED) // INLINED!!
        endif
        set u=null
    endfunction

    function UnitTypeMissile___OnDeath takes nothing returns nothing
        local unit u= GetTriggerUnit()
        local integer hid= GetHandleId(u)
        if (HaveSavedInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) then // INLINED!!
            call UnitTypeMissile___Cleanup((LoadInteger(Table__ht, (UnitTypeMissile___activeData), (hid))) , UnitTypeMissile___CLEANUP_REASON_INTERRUPTED) // INLINED!!
        endif
        set u=null
    endfunction

    function UnitTypeMissile___Init takes nothing returns nothing
        set UnitTypeMissile___activeData=s__Table_create()
        call RegisterSpellEffectEvent(UnitTypeMissile___MISSILE_ABILITY_ID , function UnitTypeMissile___OnEffect)
        call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_ENDCAST , function UnitTypeMissile___OnInterrupted)
        call RegisterSpellFinishEvent(UnitTypeMissile___MISSILE_ABILITY_ID , function UnitTypeMissile___OnSpellFinish)
        call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_DEATH , function UnitTypeMissile___OnDeath)
    endfunction



    function WaveProjectileBehaviors__CreateFxAtMissile takes integer missile,string fxPath,string attach returns nothing
        local effect fx
        if fxPath == "" then
            return
        endif
        if s__Missile_dummy[missile] != null then
            set fx=AddSpecialEffectTarget(fxPath, s__Missile_dummy[missile], attach)
        else
            set fx=AddSpecialEffect(fxPath, s__Missile_x[missile], s__Missile_y[missile])
        endif
        call DestroyEffect(fx)
        set fx=null
    endfunction

    function WaveProjectileBehaviors__CreateFxAtWidget takes widget w,string fxPath,string attach returns nothing
        local effect fx
        if fxPath == "" then
            return
        endif
        set fx=AddSpecialEffectTarget(fxPath, w, attach)
        call DestroyEffect(fx)
        set fx=null
    endfunction

    function WaveProjectileBehaviors__WaveProjectileCanHitUnit takes integer projectileId,integer missile,unit hit returns boolean
        if hit == null or not UnitAlive(hit) then
            return false
        endif
        if not IsUnitEnemy(hit, s__Missile_owner[missile]) then
            return false
        endif
        if not (WaveProjectileConfig___hitStructures[(projectileId)]) and IsUnitType(hit, UNIT_TYPE_STRUCTURE) then // INLINED!!
            return false
        endif
        return true
    endfunction

    function WaveProjectileBehaviors__WaveProjectileDamageUnit takes integer missile,unit hit,real damage returns nothing
        if damage <= 0. then
            return
        endif
        if s__Missile_source[missile] == null or GetUnitTypeId(s__Missile_source[missile]) == 0 then
            return
        endif
        call UnitDamageTarget(s__Missile_source[missile], hit, damage, false, false, WaveProjectileBehaviors__WAVE_PROJECTILE_ATTACK_TYPE, WaveProjectileBehaviors__WAVE_PROJECTILE_DAMAGE_TYPE, null)
    endfunction

    function WaveProjectileBehaviors__WaveProjectileDamageArea takes integer projectileId,integer missile,real x,real y,real radius,real damage returns nothing
        local unit hit
        if radius <= 0. or damage <= 0. then
            return
        endif
        if s__Missile_source[missile] == null or GetUnitTypeId(s__Missile_source[missile]) == 0 then
            return
        endif
        call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, x, y, radius, null)
        loop
            set hit=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
            exitwhen hit == null
            call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, hit)
            if WaveProjectileBehaviors__WaveProjectileCanHitUnit(projectileId , missile , hit) then
                call WaveProjectileBehaviors__WaveProjectileDamageUnit(missile , hit , damage)
            endif
        endloop
        set hit=null
    endfunction

    function WaveProjectileBehaviorOnUnit takes integer projectileId,integer missile,unit hit,real damage returns boolean
        local integer family= (WaveProjectileConfig___familyId[(projectileId)]) // INLINED!!
        if not WaveProjectileBehaviors__WaveProjectileCanHitUnit(projectileId , missile , hit) then
            return false
        endif

        if family == WAVE_PROJECTILE_FAMILY_MISSILE or family == WAVE_PROJECTILE_FAMILY_CONTROL or family == WAVE_PROJECTILE_FAMILY_SPECIAL then
            call WaveProjectileBehaviors__WaveProjectileDamageUnit(missile , hit , damage)
            call WaveProjectileBehaviors__CreateFxAtWidget(hit , (WaveProjectileConfig___impactFxPath[(projectileId)]) , (WaveProjectileConfig___impactFxAttach[(projectileId)])) // INLINED!!
            return (WaveProjectileConfig___stopOnUnit[(projectileId)]) // INLINED!!
        endif
        return false
    endfunction

    function WaveProjectileBehaviorOnDestructable takes integer projectileId,integer missile,destructable hit returns boolean
        if not (WaveProjectileConfig___collideDestructable[(projectileId)]) then // INLINED!!
            return false
        endif
        call WaveProjectileBehaviors__CreateFxAtMissile(missile , (WaveProjectileConfig___impactFxPath[(projectileId)]) , (WaveProjectileConfig___impactFxAttach[(projectileId)])) // INLINED!!
        return true
    endfunction

    function WaveProjectileBehaviorOnTerrain takes integer projectileId,integer missile returns boolean
        if not (WaveProjectileConfig___collideTerrain[(projectileId)]) then // INLINED!!
            return false
        endif
        call WaveProjectileBehaviors__CreateFxAtMissile(missile , (WaveProjectileConfig___impactFxPath[(projectileId)]) , (WaveProjectileConfig___impactFxAttach[(projectileId)])) // INLINED!!
        return true
    endfunction

    function WaveProjectileBehaviorOnRemove takes integer projectileId,integer missile returns nothing
        call WaveProjectileBehaviors__CreateFxAtMissile(missile , (WaveProjectileConfig___removeFxPath[(projectileId)]) , (WaveProjectileConfig___removeFxAttach[(projectileId)])) // INLINED!!
    endfunction

    function WaveProjectileBehaviorOnFinish takes integer projectileId,integer missile,real damage returns boolean
        local real radius= (WaveProjectileConfig___finishAoeRadius[(projectileId)]) // INLINED!!
        if radius > 0. then
            call WaveProjectileBehaviors__WaveProjectileDamageArea(projectileId , missile , s__Missile_x[missile] , s__Missile_y[missile] , radius , damage)
            call WaveProjectileBehaviors__CreateFxAtMissile(missile , (WaveProjectileConfig___impactFxPath[(projectileId)]) , (WaveProjectileConfig___impactFxAttach[(projectileId)])) // INLINED!!
        endif
        return true
    endfunction

//*******************************************************************************
// Guarda inteligencia y mana actual, sube INT a 500 y mana a full.
// Al disparar un orb: restaura INT y mana original y nivel de habilidad temporal (CD_LEVEL)
// Al finalizar cooldown: solo restaura nivel original de habilidad
// Compatible con Warcraft III 1.27
//*******************************************************************************


// Calcula cooldown según nivel
function LoadoutIntFullManaSwapNew__CooldownFromLevel takes integer level returns real
    local real t
    if level < 1 then
        set level=1
    endif
    set t=LoadoutIntFullManaSwapNew__ABILITY_CD_LEVEL1 + LoadoutIntFullManaSwapNew__ABILITY_CD_STEP * ( level - 1 )
    if t < LoadoutIntFullManaSwapNew__COOLDOWN_MIN then
        set t=LoadoutIntFullManaSwapNew__COOLDOWN_MIN
    endif
    return t
endfunction

// Solo restaura nivel de habilidad al terminar cooldown
function LoadoutIntFullManaSwapNew__OnCooldownFinish takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
    local unit u= s__SpellIndex_source[dex]

    if s__SpellIndex_clock[dex] == t then
        set s__SpellIndex_clock[dex]=null
    endif

    call ReleaseTimer(t)

    if GetUnitTypeId(u) != 0 then
        if GetUnitAbilityLevel(u, LoadoutIntFullManaSwapNew__trackedAbility[dex]) <= 0 then
            call UnitAddAbility(u, LoadoutIntFullManaSwapNew__trackedAbility[dex])
        endif
        call SetUnitAbilityLevel(u, LoadoutIntFullManaSwapNew__trackedAbility[dex], (PlayerMissileLoadout__orbLevel[PlayerMissileLoadout__SlotOfPlayer((GetOwningPlayer(s__SpellIndex_source[dex])))])) // INLINED!!
    endif

    call RemoveSavedInteger(Table__ht, (LoadoutIntFullManaSwapNew__byUnit), (GetHandleId(u))) // INLINED!!
    set LoadoutIntFullManaSwapNew__trackedAbility[dex]=0
    set LoadoutIntFullManaSwapNew__savedLevel[dex]=0
    set LoadoutIntFullManaSwapNew__savedInt[dex]=0
    set LoadoutIntFullManaSwapNew__savedMana[dex]=0.
    call s__SpellIndex_destroy(dex)
endfunction

// Al disparar un orb: aplica restauración de INT y mana, y nivel temporal
function LoadoutIntFullManaSwapNew__OnOrbEvent takes integer orbAbility returns nothing
    local unit u= GetTriggerUnit()
    local integer hid= GetHandleId(u)
    local integer dex
    local integer level

    if not (HaveSavedInteger(Table__ht, (LoadoutIntFullManaSwapNew__byUnit), (hid))) then // INLINED!!
        set u=null
        return
    endif

    set dex=(LoadInteger(Table__ht, (LoadoutIntFullManaSwapNew__byUnit), (hid))) // INLINED!!

    if LoadoutIntFullManaSwapNew__trackedAbility[dex] != orbAbility then
        set u=null
        return
    endif

    // Restaurar INT y mana original
    call SetHeroInt(u, LoadoutIntFullManaSwapNew__savedInt[dex], true)
    call SetUnitState(u, UNIT_STATE_MANA, LoadoutIntFullManaSwapNew__savedMana[dex])

    // Guardar nivel actual y aplicar nivel temporal
    set level=GetUnitAbilityLevel(u, orbAbility)
    if level < 1 then
        set level=LoadoutIntFullManaSwapNew__savedLevel[dex]
    endif
    if level < 1 then
        set level=1
    endif
    set LoadoutIntFullManaSwapNew__savedLevel[dex]=level

    call SetUnitAbilityLevel(u, orbAbility, LoadoutIntFullManaSwapNew__CD_LEVEL)
    
    // Timer para restaurar nivel original
    if s__SpellIndex_clock[dex] != null then
        call ReleaseTimer(s__SpellIndex_clock[dex])
    endif
    set s__SpellIndex_clock[dex]=NewTimerEx(dex)
    call SetTimerDebugTag(s__SpellIndex_clock[dex] , TIMER_DEBUG_TAG_OTHER)
    call TimerStart(s__SpellIndex_clock[dex], LoadoutIntFullManaSwapNew__CooldownFromLevel(LoadoutIntFullManaSwapNew__savedLevel[dex]), false, function LoadoutIntFullManaSwapNew__OnCooldownFinish)
    
    

    set u=null
endfunction

// Handlers para cada orbe
function LoadoutIntFullManaSwapNew__FunctionEventRay takes nothing returns nothing
    call LoadoutIntFullManaSwapNew__OnOrbEvent(LoadoutIntFullManaSwapNew__ABILITY_RAY)
endfunction

function LoadoutIntFullManaSwapNew__FunctionEventFire takes nothing returns nothing
    call LoadoutIntFullManaSwapNew__OnOrbEvent(LoadoutIntFullManaSwapNew__ABILITY_FIRE)
endfunction

function LoadoutIntFullManaSwapNew__FunctionEventPoison takes nothing returns nothing
    call LoadoutIntFullManaSwapNew__OnOrbEvent(LoadoutIntFullManaSwapNew__ABILITY_POISON)
endfunction

function LoadoutIntFullManaSwapNew__FunctionEventWind takes nothing returns nothing
    call LoadoutIntFullManaSwapNew__OnOrbEvent(LoadoutIntFullManaSwapNew__ABILITY_WIND)
endfunction

function LoadoutIntFullManaSwapNew__FunctionEventDark takes nothing returns nothing
    call LoadoutIntFullManaSwapNew__OnOrbEvent(LoadoutIntFullManaSwapNew__ABILITY_DARK)
endfunction

function LoadoutIntFullManaSwapNew__FunctionEventBlood takes nothing returns nothing
    call LoadoutIntFullManaSwapNew__OnOrbEvent(LoadoutIntFullManaSwapNew__ABILITY_BLOOD)
endfunction

// Inicializa tracking y aplica INT 500 + mana full
function LoadoutIntFullManaSwapNew__BeginGive takes unit u,integer orbAbility returns nothing
    local integer hid
    local integer level
    local integer dex

    if u == null or GetUnitTypeId(u) == 0 then
        return
    endif

    set level=(PlayerMissileLoadout__orbLevel[PlayerMissileLoadout__SlotOfPlayer((GetOwningPlayer(u)))]) // INLINED!!
    if level < 1 or level > LoadoutIntFullManaSwapNew__MAX_TRIGGER_LEVEL then
        return
    endif

    set hid=GetHandleId(u)
    if (HaveSavedInteger(Table__ht, (LoadoutIntFullManaSwapNew__byUnit), (hid))) then // INLINED!!
        return
    endif

    set dex=s__SpellIndex__allocate()
    set s__SpellIndex_source[dex]=u
    set s__SpellIndex_clock[dex]=null
    set LoadoutIntFullManaSwapNew__trackedAbility[dex]=orbAbility
    set LoadoutIntFullManaSwapNew__savedLevel[dex]=level
    set LoadoutIntFullManaSwapNew__savedInt[dex]=GetHeroInt(u, true)
    set LoadoutIntFullManaSwapNew__savedMana[dex]=GetUnitState(u, UNIT_STATE_MANA)
    
    // Subir INT temporal
    call SetHeroInt(u, 500, true)
    // Mana al máximo compatible con 1.27
    call SetUnitState(u, UNIT_STATE_MANA, GetUnitState(u, UNIT_STATE_MAX_MANA))

    call SaveInteger(Table__ht, (LoadoutIntFullManaSwapNew__byUnit), (hid), ( dex)) // INLINED!!
endfunction

function TriggerLoadoutIntFullManaSwapForAbility takes unit u,integer abilityRaw returns nothing
    if abilityRaw == LoadoutIntFullManaSwapNew__ABILITY_RAY then
        call LoadoutIntFullManaSwapNew__BeginGive(u , LoadoutIntFullManaSwapNew__ABILITY_RAY)
    elseif abilityRaw == LoadoutIntFullManaSwapNew__ABILITY_FIRE then
        call LoadoutIntFullManaSwapNew__BeginGive(u , LoadoutIntFullManaSwapNew__ABILITY_FIRE)
    elseif abilityRaw == LoadoutIntFullManaSwapNew__ABILITY_POISON then
        call LoadoutIntFullManaSwapNew__BeginGive(u , LoadoutIntFullManaSwapNew__ABILITY_POISON)
    elseif abilityRaw == LoadoutIntFullManaSwapNew__ABILITY_WIND then
        call LoadoutIntFullManaSwapNew__BeginGive(u , LoadoutIntFullManaSwapNew__ABILITY_WIND)
    elseif abilityRaw == LoadoutIntFullManaSwapNew__ABILITY_DARK then
        call LoadoutIntFullManaSwapNew__BeginGive(u , LoadoutIntFullManaSwapNew__ABILITY_DARK)
    elseif abilityRaw == LoadoutIntFullManaSwapNew__ABILITY_BLOOD then
        call LoadoutIntFullManaSwapNew__BeginGive(u , LoadoutIntFullManaSwapNew__ABILITY_BLOOD)
    endif
endfunction

function LoadoutIntFullMana takes unit u,integer abilityRaw returns nothing
    call TriggerLoadoutIntFullManaSwapForAbility(u , abilityRaw)
endfunction

function LoadoutIntFullManaSwapNew__Init takes nothing returns nothing
    set LoadoutIntFullManaSwapNew__byUnit=s__Table_create()
    call RegisterSpellFinishEvent(LoadoutIntFullManaSwapNew__ABILITY_RAY , function LoadoutIntFullManaSwapNew__FunctionEventRay)
    call RegisterSpellFinishEvent(LoadoutIntFullManaSwapNew__ABILITY_FIRE , function LoadoutIntFullManaSwapNew__FunctionEventFire)
    call RegisterSpellFinishEvent(LoadoutIntFullManaSwapNew__ABILITY_POISON , function LoadoutIntFullManaSwapNew__FunctionEventPoison)
    call RegisterSpellFinishEvent(LoadoutIntFullManaSwapNew__ABILITY_WIND , function LoadoutIntFullManaSwapNew__FunctionEventWind)
    call RegisterSpellFinishEvent(LoadoutIntFullManaSwapNew__ABILITY_DARK , function LoadoutIntFullManaSwapNew__FunctionEventDark)
    call RegisterSpellFinishEvent(LoadoutIntFullManaSwapNew__ABILITY_BLOOD , function LoadoutIntFullManaSwapNew__FunctionEventBlood)
endfunction

//**
//* User settings:
//* ==============

//**
//* Code:
//* =====
    

    function LoadoutLeap___IsPointJumpable takes real x,real y returns boolean
        if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
            return IsTerrainWalkable(x , y)
        endif
        return false
    endfunction


    // Poison DOT Logic
    function LoadoutLeap___PoisonListAdd takes integer dex returns nothing
        set LoadoutLeap___poisonPrev[dex]=0
        set LoadoutLeap___poisonNext[dex]=LoadoutLeap___poisonHead
        if LoadoutLeap___poisonHead != 0 then
            set LoadoutLeap___poisonPrev[LoadoutLeap___poisonHead]=dex
        endif
        set LoadoutLeap___poisonHead=dex
    endfunction

    function LoadoutLeap___PoisonListRemove takes integer dex returns nothing
        local integer p= LoadoutLeap___poisonPrev[dex]
        local integer n= LoadoutLeap___poisonNext[dex]
        if p != 0 then
            set LoadoutLeap___poisonNext[p]=n
        else
            set LoadoutLeap___poisonHead=n
        endif
        if n != 0 then
            set LoadoutLeap___poisonPrev[n]=p
        endif
        set LoadoutLeap___poisonPrev[dex]=0
        set LoadoutLeap___poisonNext[dex]=0
    endfunction

    function LoadoutLeap___PoisonDestroy takes integer dex returns nothing
        call LoadoutLeap___PoisonListRemove(dex)
        if LoadoutLeap___poisonFx[dex] != null then
            call DestroyEffect(LoadoutLeap___poisonFx[dex])
            set LoadoutLeap___poisonFx[dex]=null
        endif
        call s__SpellIndex_destroy(dex)
    endfunction

    function LoadoutLeap___OnPoisonTick takes nothing returns nothing
        local integer node= LoadoutLeap___poisonHead
        local integer nextNode
        local integer dex
        local unit target
        local integer ticks
        loop
            exitwhen node == 0
            set dex=(node)
            set nextNode=LoadoutLeap___poisonNext[node]
            set target=s__SpellIndex_target[dex]
            set ticks=R2I(s__SpellIndex_count[dex] - 1)

            if ( target == null ) or ( GetUnitTypeId(target) == 0 ) or ( not UnitAlive(target) ) or ( GetUnitTypeId(s__SpellIndex_source[dex]) == 0 ) then
                call LoadoutLeap___PoisonDestroy(dex)
            else
                call WaveRecordDamageCredit(s__SpellIndex_source[dex] , target)
                call UnitDamageTarget(s__SpellIndex_source[dex], target, s__SpellIndex_damage[dex], false, false, LoadoutLeap___ATTACK_TYPE, LoadoutLeap___DAMAGE_TYPE, null)
                call ShowCustomLoadoutText(target , "-" + FormatLoadoutDamageText(s__SpellIndex_damage[dex]) , LoadoutLeap___POISON_TEXT_R , LoadoutLeap___POISON_TEXT_G , LoadoutLeap___POISON_TEXT_B)
                if ticks <= 0 then
                    call LoadoutLeap___PoisonDestroy(dex)
                else
                    set s__SpellIndex_count[dex]=ticks
                endif
            endif
            set node=nextNode
        endloop
        if ( LoadoutLeap___poisonHead == 0 ) and ( LoadoutLeap___poisonTicker != null ) then
            call ReleaseTimer(LoadoutLeap___poisonTicker)
            set LoadoutLeap___poisonTicker=null
        endif
    endfunction

    function LoadoutLeap___ApplyPoison takes unit source,unit target,real damagePerSecond,real duration returns nothing
        local integer dex
        local integer ticks
        local real covered
        
        // Initial impact has no minus sign
        call WaveRecordDamageCredit(source , target)
        call UnitDamageTarget(source, target, damagePerSecond, false, false, LoadoutLeap___ATTACK_TYPE, LoadoutLeap___DAMAGE_TYPE, null)
        call ShowCustomLoadoutText(target , FormatLoadoutDamageText(damagePerSecond) , LoadoutLeap___POISON_TEXT_R , LoadoutLeap___POISON_TEXT_G , LoadoutLeap___POISON_TEXT_B)

        if duration <= 0. then
            return
        endif
        if LOADOUT_ORB_POISON_TICK_INTERVAL <= 0. then
            return
        endif

        set ticks=R2I(duration / LOADOUT_ORB_POISON_TICK_INTERVAL)
        set covered=I2R(ticks) * LOADOUT_ORB_POISON_TICK_INTERVAL
        if covered < duration then
            set ticks=ticks + 1
        endif
        if ticks < 1 then
            set ticks=1
        endif
        
        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_target[dex]=target
        set s__SpellIndex_damage[dex]=damagePerSecond
        if ( LoadoutLeap___POISON_DOT_FX != null ) and ( LoadoutLeap___POISON_DOT_FX != "" ) then
            set LoadoutLeap___poisonFx[dex]=AddSpecialEffectTarget(LoadoutLeap___POISON_DOT_FX, target, LoadoutLeap___POISON_DOT_FX_ATTACH)
        else
            set LoadoutLeap___poisonFx[dex]=null
        endif

        set s__SpellIndex_count[dex]=ticks
        call LoadoutLeap___PoisonListAdd(dex)
        if LoadoutLeap___poisonTicker == null then
            set LoadoutLeap___poisonTicker=(NewTimerEx(0)) // INLINED!!
            call SetTimerDebugTag(LoadoutLeap___poisonTicker , TIMER_DEBUG_TAG_LOADOUT_LEAP)
            call TimerStart(LoadoutLeap___poisonTicker, LOADOUT_ORB_POISON_TICK_INTERVAL, true, function LoadoutLeap___OnPoisonTick)
        endif
    endfunction

    // Impact Dummy cleanup
    function LoadoutLeap___ImpactListAdd takes integer id returns nothing
        set LoadoutLeap___impactPrev[id]=0
        set LoadoutLeap___impactNext[id]=LoadoutLeap___impactHead
        if LoadoutLeap___impactHead != 0 then
            set LoadoutLeap___impactPrev[LoadoutLeap___impactHead]=id
        endif
        set LoadoutLeap___impactHead=id
    endfunction

    function LoadoutLeap___ImpactListRemove takes integer id returns nothing
        local integer p= LoadoutLeap___impactPrev[id]
        local integer n= LoadoutLeap___impactNext[id]
        if p != 0 then
            set LoadoutLeap___impactNext[p]=n
        else
            set LoadoutLeap___impactHead=n
        endif
        if n != 0 then
            set LoadoutLeap___impactPrev[n]=p
        endif
        set LoadoutLeap___impactPrev[id]=0
        set LoadoutLeap___impactNext[id]=0
    endfunction

    function LoadoutLeap___DestroyImpactDummy takes integer id returns nothing
        call LoadoutLeap___ImpactListRemove(id)
        if LoadoutLeap___impactFx[id] != null then
            call DestroyEffect(LoadoutLeap___impactFx[id])
            set LoadoutLeap___impactFx[id]=null
        endif
        if LoadoutLeap___impactDummy[id] != null then
            call RemoveUnit(LoadoutLeap___impactDummy[id])
            set LoadoutLeap___impactDummy[id]=null
        endif
        set LoadoutLeap___impactRemaining[id]=0.0
        call s__SpellIndex_destroy((id))
    endfunction

    function LoadoutLeap___OnImpactTicker takes nothing returns nothing
        local integer node= LoadoutLeap___impactHead
        local integer nextNode
        loop
            exitwhen node == 0
            set nextNode=LoadoutLeap___impactNext[node]
            set LoadoutLeap___impactRemaining[node]=LoadoutLeap___impactRemaining[node] - 0.03125
            if LoadoutLeap___impactRemaining[node] <= 0.0 then
                call LoadoutLeap___DestroyImpactDummy(node)
            endif
            set node=nextNode
        endloop
        if ( LoadoutLeap___impactHead == 0 ) and ( LoadoutLeap___impactTicker != null ) then
            call ReleaseTimer(LoadoutLeap___impactTicker)
            set LoadoutLeap___impactTicker=null
        endif
    endfunction

    function LoadoutLeap___QueueImpactDummy takes unit whichDummy,string impactModel returns nothing
        local integer id
        if whichDummy == null or GetUnitTypeId(whichDummy) == 0 then
            return
        endif
        if impactModel == null or impactModel == "" then
            call RemoveUnit(whichDummy)
            return
        endif
        set id=s__SpellIndex__allocate()
        set LoadoutLeap___impactDummy[id]=whichDummy
        set LoadoutLeap___impactFx[id]=AddSpecialEffectTarget(impactModel, whichDummy, "origin")
        set LoadoutLeap___impactRemaining[id]=LoadoutLeap___IMPACT_FX_DURATION
        call LoadoutLeap___ImpactListAdd(id)
        if LoadoutLeap___impactTicker == null then
            set LoadoutLeap___impactTicker=(NewTimerEx(0)) // INLINED!!
            call SetTimerDebugTag(LoadoutLeap___impactTicker , TIMER_DEBUG_TAG_LOADOUT_LEAP)
            call TimerStart(LoadoutLeap___impactTicker, 0.03125, true, function LoadoutLeap___OnImpactTicker)
        endif
    endfunction

        function s__LoadoutLeap___LeapCore_onRemove takes integer missile returns boolean
            local integer dex= s__Missile_data[missile]
            
            // Clean up Caster Fx
            if LoadoutLeap___casterFx1[missile] != null then
                call DestroyEffect(LoadoutLeap___casterFx1[missile])
                set LoadoutLeap___casterFx1[missile]=null
            endif
            if LoadoutLeap___casterFx2[missile] != null then
                call DestroyEffect(LoadoutLeap___casterFx2[missile])
                set LoadoutLeap___casterFx2[missile]=null
            endif
            // Clean up Dummy Fx
            if LoadoutLeap___dummyFx1[missile] != null then
                call DestroyEffect(LoadoutLeap___dummyFx1[missile])
                set LoadoutLeap___dummyFx1[missile]=null
            endif
            if LoadoutLeap___dummyFx2[missile] != null then
                call DestroyEffect(LoadoutLeap___dummyFx2[missile])
                set LoadoutLeap___dummyFx2[missile]=null
            endif
            // Clean up Ray
            if LoadoutLeap___rayLightning[missile] != null then
                call DestroyLightning(LoadoutLeap___rayLightning[missile])
                set LoadoutLeap___rayLightning[missile]=null
            endif
            if LoadoutLeap___companionDummy[missile] != null then
                call RemoveUnit(LoadoutLeap___companionDummy[missile])
                set LoadoutLeap___companionDummy[missile]=null
            endif
            if LoadoutLeap___delayedAnimTimer[dex] != null then
                call ReleaseTimer(LoadoutLeap___delayedAnimTimer[dex])
                set LoadoutLeap___delayedAnimTimer[dex]=null
            endif
            
            // Re-enable target unit and reset tags
            if ( GetUnitTypeId(s__SpellIndex_source[dex]) != 0 ) then
                if (HaveSavedInteger(Table__ht, (LoadoutLeap___activeLeapMissileByUnit), (GetHandleId(s__SpellIndex_source[dex])))) and (LoadInteger(Table__ht, (LoadoutLeap___activeLeapMissileByUnit), (GetHandleId(s__SpellIndex_source[dex])))) == missile then // INLINED!!
                    call RemoveSavedInteger(Table__ht, (LoadoutLeap___activeLeapMissileByUnit), (GetHandleId(s__SpellIndex_source[dex]))) // INLINED!!
                endif
                if LoadoutLeap___ANIMATION_TAG != "" then
                    call AddUnitAnimationProperties(s__SpellIndex_source[dex], LoadoutLeap___ANIMATION_TAG, false)
                endif
                call SetUnitPathing(s__SpellIndex_source[dex], true)
                call SetUnitTimeScale(s__SpellIndex_source[dex], 1.0)
                call SetUnitFlyHeight(s__SpellIndex_source[dex], 0.0, 99999.)
                call UnitRemoveAbility(s__SpellIndex_source[dex], LoadoutLeap___BUFF_APPLIED_ID)
            endif
            
            call s__SpellIndex_destroy(dex)
            return true
        endfunction

        function s__LoadoutLeap___LeapCore_onPeriod takes integer missile returns boolean
            local integer dex= s__Missile_data[missile]
            local unit source= s__SpellIndex_source[dex]
            local unit companion= LoadoutLeap___companionDummy[missile]
            local real x= s__Missile_x[missile]
            local real y= s__Missile_y[missile]
            local real z= s__Missile_z[missile] + s__Missile_terrainZ[missile]
            local real flightOffset= (PlayerMissileLoadout__chosenLeapDummyFlightOffset[PlayerMissileLoadout__SlotOfPlayer((s__SpellIndex_user[dex]))]) // INLINED!!
            local unit enumUnit
            local real damage
            
            if ( GetUnitTypeId(source) == 0 ) or IsUnitType(source, UNIT_TYPE_DEAD) then
                return true // End leap if caster died
            endif

            if companion != null and GetUnitTypeId(companion) != 0 then
                call SetUnitX(companion, x)
                call SetUnitY(companion, y)
                call SetUnitFlyHeight(companion, z + flightOffset, 0.0)
            endif
            
            // Move Lightning for Ray
            if LoadoutLeap___bonusActive[missile] and LoadoutLeap___specialAbility[missile] == LOADOUT_ORB_ABILITY_RAY then
                if LoadoutLeap___rayLightning[missile] != null then
                    call MoveLightningEx(LoadoutLeap___rayLightning[missile], true, x, y, s__Missile_z[missile] + s__Missile_terrainZ[missile], x, y, s__Missile_terrainZ[missile])
                endif
                
                // Damage targets below
                set damage=LoadoutLeap___storedDamage[missile]
                call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, x, y, LoadoutLeap___BASE_IMPACT_AREA, null)
                loop
                    set enumUnit=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
                    exitwhen enumUnit == null
                    call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, enumUnit)
                    if IsUnitEnemy(enumUnit, s__SpellIndex_user[dex]) and not IsUnitType(enumUnit, UNIT_TYPE_DEAD) and not IsUnitType(enumUnit, UNIT_TYPE_MAGIC_IMMUNE) and ( not (HaveSavedHandle(Missile___HASH, (missile), GetHandleId((enumUnit)))) ) then // INLINED!!
                        call s__Missile_hitWidget(missile,enumUnit)
                        call WaveRecordDamageCredit(source , enumUnit)
                        call UnitDamageTarget(source, enumUnit, damage, false, false, LoadoutLeap___ATTACK_TYPE, LoadoutLeap___DAMAGE_TYPE, null)
                        call DestroyEffect(AddSpecialEffectTarget(LoadoutLeap___RAY_HIT_FX, enumUnit, LoadoutLeap___RAY_HIT_FX_ATTACH))
                    endif
                endloop
            endif

            return false
        endfunction

        function s__LoadoutLeap___LeapCore_applyImpact takes integer missile returns nothing
            local integer dex= s__Missile_data[missile]
            local unit source= s__SpellIndex_source[dex]
            local real x= s__Missile_x[missile]
            local real y= s__Missile_y[missile]
            local real baseArea= LoadoutLeap___BASE_IMPACT_AREA
            local real finalDamage= LoadoutLeap___storedDamage[missile]
            local real bloodMult
            local integer inst= LoadoutLeap___effectInstances[missile]
            local integer abilityChoice= LoadoutLeap___specialAbility[missile]
            local boolean bonus= LoadoutLeap___bonusActive[missile]
            local unit enumUnit
            local integer bloodPct
            local unit iDummy
            local sound s
            local string impactModel= (PlayerMissileLoadout__chosenLeapImpactFx[PlayerMissileLoadout__SlotOfPlayer((s__SpellIndex_user[dex]))]) // INLINED!!
            local real dummyScale= LoadoutLeap___IMPACT_DUMMY_BASE_SCALE

            call SetUnitFlyHeight(source, 0.0, 0.0)
            call UnitRemoveAbility(source, LoadoutLeap___BUFF_APPLIED_ID)
            
            if bonus and abilityChoice == LOADOUT_ORB_ABILITY_WIND then
                set baseArea=(LOADOUT_ORB_WIND_BASE_AOE + LOADOUT_ORB_WIND_AOE_PER_INSTANCE * LoadoutClampInstance((inst))) // INLINED!!
                set dummyScale=dummyScale + ( LoadoutLeap___WIND_SCALE_BONUS * inst )
            endif

            // Fire modifies raw damage.
            if bonus and abilityChoice == LOADOUT_ORB_ABILITY_FIRE then
                set finalDamage=(((LoadoutLeap___storedDamage[missile] )*1.0) * ( 1. + LOADOUT_ORB_FIRE_DAMAGE_PERCENT_PER_INSTANCE * LoadoutClampInstance(( inst)) )) // INLINED!!
            endif

            // Create Impact Dummy
            set iDummy=CreateUnit(s__SpellIndex_user[dex], 'dumi', x, y, 270)
            call UnitAddAbility(iDummy, 'Aloc') // Locust
            call PauseUnit(iDummy, true)
            call SetUnitScale(iDummy, dummyScale, dummyScale, dummyScale)
            
            if LoadoutLeap___IMPACT_SOUND != "" then
                set s=CreateSound(LoadoutLeap___IMPACT_SOUND, false, false, false, 10, 10, "")
                call SetSoundPosition(s, x, y, 0)
                call SetSoundVolume(s, 127)
                call StartSound(s)
                call KillSoundWhenDone(s)
                set s=null
            endif

            call LoadoutLeap___QueueImpactDummy(iDummy , impactModel)
            set iDummy=null

            // Area Damage
            call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, x, y, baseArea, null)
            loop
                set enumUnit=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
                exitwhen enumUnit == null
                
                if IsUnitEnemy(enumUnit, s__SpellIndex_user[dex]) and not IsUnitType(enumUnit, UNIT_TYPE_DEAD) and not IsUnitType(enumUnit, UNIT_TYPE_MAGIC_IMMUNE) then
                    // Ray: Normal damage
                    if abilityChoice == LOADOUT_ORB_ABILITY_RAY or not bonus then
                        call WaveRecordDamageCredit(source , enumUnit)
                        call UnitDamageTarget(source, enumUnit, finalDamage, false, false, LoadoutLeap___ATTACK_TYPE, LoadoutLeap___DAMAGE_TYPE, null)
                    
                    // Poison: DoT
                    elseif bonus and abilityChoice == LOADOUT_ORB_ABILITY_POISON then
                        call LoadoutLeap___ApplyPoison(source , enumUnit , (((LoadoutLeap___storedDamage[missile])*1.0) * LOADOUT_ORB_POISON_DAMAGE_MULT) , (LOADOUT_ORB_POISON_DURATION_PER_INSTANCE * LoadoutClampInstance((inst)))) // INLINED!!
                    
                    // Dark: Max HP %
                    elseif bonus and abilityChoice == LOADOUT_ORB_ABILITY_DARK then
                        set finalDamage=LoadoutLeap___storedDamage[missile] + LoadoutGetDarkBonus(enumUnit , inst)
                        call WaveRecordDamageCredit(source , enumUnit)
                        call UnitDamageTarget(source, enumUnit, finalDamage, false, false, LoadoutLeap___ATTACK_TYPE, LoadoutLeap___DAMAGE_TYPE, null)
                        call ShowCustomLoadoutText(enumUnit , FormatLoadoutDamageText(finalDamage) , LoadoutLeap___DARK_TEXT_R , LoadoutLeap___DARK_TEXT_G , LoadoutLeap___DARK_TEXT_B)

                    // Fire: Just display text
                    elseif bonus and abilityChoice == LOADOUT_ORB_ABILITY_FIRE then
                        call WaveRecordDamageCredit(source , enumUnit)
                        call UnitDamageTarget(source, enumUnit, finalDamage, false, false, LoadoutLeap___ATTACK_TYPE, LoadoutLeap___DAMAGE_TYPE, null)
                        call ShowCustomLoadoutText(enumUnit , FormatLoadoutDamageText(finalDamage) , LoadoutLeap___FIRE_TEXT_R , LoadoutLeap___FIRE_TEXT_G , LoadoutLeap___FIRE_TEXT_B)

                    // Blood: Just display text
                    elseif bonus and abilityChoice == LOADOUT_ORB_ABILITY_BLOOD then
                        set bloodMult=LoadoutGetBloodRandomMultiplier(inst)
                        set finalDamage=LoadoutLeap___storedDamage[missile] * bloodMult
                        set bloodPct=(R2I(((bloodMult)*1.0) * 100. + 0.5)) // INLINED!!
                        call WaveRecordDamageCredit(source , enumUnit)
                        call UnitDamageTarget(source, enumUnit, finalDamage, false, false, LoadoutLeap___ATTACK_TYPE, LoadoutLeap___DAMAGE_TYPE, null)
                        call ShowCustomLoadoutText(enumUnit , FormatLoadoutDamageText(finalDamage) + "   //" + I2S(bloodPct) + "%" , LoadoutLeap___BLOOD_TEXT_R , LoadoutLeap___BLOOD_TEXT_G , LoadoutLeap___BLOOD_TEXT_B)
                    
                    // Wind: Just damage
                    elseif bonus and abilityChoice == LOADOUT_ORB_ABILITY_WIND then
                        set finalDamage=(LOADOUT_ORB_WIND_BASE_DAMAGE + ((LoadoutLeap___storedDamage[missile])*1.0)) // INLINED!!
                        call WaveRecordDamageCredit(source , enumUnit)
                        call UnitDamageTarget(source, enumUnit, finalDamage, false, false, LoadoutLeap___ATTACK_TYPE, LoadoutLeap___DAMAGE_TYPE, null)
                    endif
                endif
                
                call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, enumUnit)
            endloop
        endfunction

        function s__LoadoutLeap___LeapCore_onFinish takes integer missile returns boolean
            call s__LoadoutLeap___LeapCore_applyImpact(missile)
            return true
        endfunction

        function s__LoadoutLeap___LeapCore_onCollide takes integer missile,unit hit returns boolean
            return false // Leap doesn't collide with units mid-air
        endfunction

        function s__LoadoutLeap___LeapCore_onDestructable takes integer missile,destructable dest returns boolean
            return false // Leap doesn't collide with trees
        endfunction

//Implemented from module MissileStruct:
        function s__LoadoutLeap___LeapCore_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__LoadoutLeap___LeapCore],missile)
            call Missile___StartPeriodic(si__LoadoutLeap___LeapCore)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__LoadoutLeap___LeapCore_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__LoadoutLeap___LeapCore_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__LoadoutLeap___LeapCore)
            endif
        endfunction
























        

        function s__LoadoutLeap___LeapCore_MissileAction___missileActionDest takes nothing returns nothing
            local destructable d= GetEnumDestructable()
            local integer this= s__Missile_temp
            if s__Missile_allocated[this] then
                call SaveDestructableHandle(Missile___HASH, this, GetHandleId(d), d)
                if s__LoadoutLeap___LeapCore_onDestructable(this , d) then
                    call s__LoadoutLeap___LeapCore_missileTerminateP(this)
                endif
            endif
            set d=null
        endfunction

    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__LoadoutLeap___LeapCore_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__LoadoutLeap___LeapCore])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__LoadoutLeap___LeapCore_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.

                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            set b=s__Missile_collisionType[this] == Missile_COLLISION_TYPE_RECTANGLE
                            if b then
                                call s__Missile_groupEnumUnitsRectangle(this)
                            else
                                call GroupEnumUnitsInRange(Missile___GROUP, s__Missile_x[this], s__Missile_y[this], s__Missile_collision[this] + Missile_MAXIMUM_COLLISION_SIZE, null)
                            endif
                            loop
                                set u=FirstOfGroup(Missile___GROUP)
                                exitwhen u == null
                                call GroupRemoveUnit(Missile___GROUP, u)
                                if not HaveSavedHandle(Missile___HASH, this, GetHandleId(u)) then
                                    if IsUnitInRange(u, s__Missile_dummy[this], s__Missile_collision[this]) or b then
                                        // Eventually run z collision checks.

                                            set collideZ=Missile_GetLocZ(GetUnitX(u) , GetUnitY(u)) + GetUnitFlyHeight(u) - s__Missile_terrainZ[this]
                                            if ( collideZ + GetUnitBodySize(u) >= s__Missile_z[this] - (s__Missile_collision[(this)]) ) and ( collideZ <= s__Missile_z[this] + (s__Missile_collision[(this)]) ) then // INLINED!!
                                                // Mark as hit.
                                                call SaveUnitHandle(Missile___HASH, this, GetHandleId(u), u)
                                                if s__LoadoutLeap___LeapCore_onCollide(this , u) then
                                                    call s__LoadoutLeap___LeapCore_missileTerminateP(this)
                                                    exitwhen true
                                                endif
                                            endif
    








                                    endif
                                endif
                            endloop
                        endif

                    
                    // Runs destructable collision.

                        // Check if the missile is not terminated.
                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            call s__Missile_checkDestCollision(this,function s__LoadoutLeap___LeapCore_MissileAction___missileActionDest)
                        endif

                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__LoadoutLeap___LeapCore_onFinish(this) then
                                call s__LoadoutLeap___LeapCore_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.





                
                    // Runs every Missile_TIMER_TIMEOUT.

                        if s__Missile_allocated[this] and s__LoadoutLeap___LeapCore_onPeriod(this) then
                            call s__LoadoutLeap___LeapCore_missileTerminateP(this)
                        endif

                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__LoadoutLeap___LeapCore_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__LoadoutLeap___LeapCore)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__LoadoutLeap___LeapCore )]=Condition(( function s__LoadoutLeap___LeapCore_missileIterateP)) // INLINED!!
        endfunction


    function LoadoutLeap___DelayedStartAnimation takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local unit source= s__SpellIndex_source[dex]
        set LoadoutLeap___delayedAnimTimer[dex]=null
        
        if ( GetUnitTypeId(source) != 0 ) and UnitAlive(source) then
            call SetUnitAnimation(source, LoadoutLeap___CAST_ANIMATION)
            if LoadoutLeap___ANIMATION_TAG != "" then
                call AddUnitAnimationProperties(source, LoadoutLeap___ANIMATION_TAG, true)
            endif
        endif
        
        call ReleaseTimer(t)
        set source=null
        set t=null
    endfunction

    function LoadoutLeap___OnEffect takes nothing returns nothing
        local unit source= GetTriggerUnit()
        local player owner= GetTriggerPlayer()
        local real x= GetUnitX(source)
        local real y= GetUnitY(source)
        local real tx= GetSpellTargetX()
        local real ty= GetSpellTargetY()
        local real dx= tx - x
        local real dy= ty - y
        local real distance= SquareRoot(dx * dx + dy * dy)
        local real arc= 0.0
        local real speed
        local real damage
        local integer instances
        local integer chosen
        local integer chosenLevel
        local integer dex
        local integer missile
        
        local string cFx1= (PlayerMissileLoadout__chosenLeapCasterFx1[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        local string cFx2= (PlayerMissileLoadout__chosenLeapCasterFx2[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        local string dFx1= (PlayerMissileLoadout__chosenLeapDummyFx1[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        local string dFx2= (PlayerMissileLoadout__chosenLeapDummyFx2[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        local real dummyScale= (PlayerMissileLoadout__chosenLeapDummyScale[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        local real companionFacing= Atan2(ty - y, tx - x) * bj_RADTODEG
        local integer companionUnitId= (PlayerMissileLoadout__chosenLeapCompanionUnitId[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        local unit buffDummy
        local unit companion

        if not LoadoutLeap___IsPointJumpable(tx , ty) then
            call SimError(owner , GetUnitName(source) + " can't jump there!")
            set source=null
            set owner=null
            return
        endif

        if not IsVisibleToPlayer(tx, ty, owner) then
            call SimError(owner , GetUnitName(source) + " needs vision at target!")
            set source=null
            set owner=null
            return
        endif

        set chosen=(PlayerMissileLoadout__chosenAbility[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        set chosenLevel=0
        if chosen != 0 then
            set chosenLevel=GetUnitAbilityLevel(source, chosen)
        endif

        if LoadoutLeap___USE_FIXED_TIME then
            if LoadoutLeap___FIXED_JUMP_TIME > 0.0 then
                set speed=distance / LoadoutLeap___FIXED_JUMP_TIME
            else
                set speed=LoadoutLeap___BASE_JUMP_SPEED
            endif
        else
            set speed=LoadoutLeap___BASE_JUMP_SPEED + (PlayerMissileLoadout__chosenSpeedBonus[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        endif

        if speed < 1.0 then
            set speed=1.0
        endif

        set damage=(PlayerMissileLoadout__chosenDamage[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        if damage < 0. then
            set damage=0.
        endif
        set instances=(PlayerMissileLoadout__chosenInstances[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        if instances < 1 then
            set instances=1
        endif

        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_user[dex]=owner
        set missile=s__Missile_createEx(source , tx , ty , 0.0)
        set s__Missile_data[missile]=dex
        call SaveInteger(Table__ht, (LoadoutLeap___activeLeapMissileByUnit), (GetHandleId(source)), ( missile)) // INLINED!!
        set s__Missile_collision[missile]=0.0 // Important so it doesnt collide
        if distance > 0.0 then
            set arc=Atan(( 4.0 * LoadoutLeap___BASE_JUMP_HEIGHT ) / distance)
        else
            set arc=0.0
        endif
        call s__Missile__set_arc(missile,arc)
        if LoadoutLeap___USE_FIXED_TIME and LoadoutLeap___FIXED_JUMP_TIME > 0.0 then
            call s__Missile_flightTime2Speed(missile,LoadoutLeap___FIXED_JUMP_TIME)
        else
            set s__Missile_speed[(missile)]=((speed)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
        endif

        set LoadoutLeap___specialAbility[missile]=chosen
        set LoadoutLeap___storedDamage[missile]=damage
        set LoadoutLeap___effectInstances[missile]=instances
        set LoadoutLeap___bonusActive[missile]=( chosen != 0 ) and ( chosenLevel > 0 )

        if companionUnitId == 0 then
            set companionUnitId=LoadoutLeap___COMPANION_DUMMY_FALLBACK_ID
        endif
        set companion=CreateUnit(owner, companionUnitId, x, y, 0.0)
        if companion != null and GetUnitTypeId(companion) != 0 then
            call UnitAddAbility(companion, 'Aloc')
            call UnitAddAbility(companion, 'Amrf')
            call UnitRemoveAbility(companion, 'Amrf')
            call SetUnitPathing(companion, false)
            call PauseUnit(companion, true)
            call SetUnitFacing(companion, companionFacing)
            call SetUnitScale(companion, dummyScale, dummyScale, dummyScale)
            call SetUnitFlyHeight(companion, 0.0, 0.0)
            set LoadoutLeap___companionDummy[missile]=companion
        else
            set LoadoutLeap___companionDummy[missile]=null
        endif
        
        // Add Crow Form so caster can fly
        if UnitAddAbility(source, 'Amrf') and UnitRemoveAbility(source, 'Amrf') then
        endif
        
        // Disable pathing so caster flies over things
        call SetUnitPathing(source, false)

        // Attach Caster FX
        if cFx1 != null and cFx1 != "" then
            set LoadoutLeap___casterFx1[missile]=AddSpecialEffectTarget(cFx1, source, "chest")
        endif
        if cFx2 != null and cFx2 != "" then
            set LoadoutLeap___casterFx2[missile]=AddSpecialEffectTarget(cFx2, source, "origin")
        endif
        // Attach Dummy FX
        if LoadoutLeap___companionDummy[missile] != null then
            if dFx1 != null and dFx1 != "" then
                set LoadoutLeap___dummyFx1[missile]=AddSpecialEffectTarget(dFx1, LoadoutLeap___companionDummy[missile], "chest")
            endif
            if dFx2 != null and dFx2 != "" then
                set LoadoutLeap___dummyFx2[missile]=AddSpecialEffectTarget(dFx2, LoadoutLeap___companionDummy[missile], "origin")
            endif
        endif

        // Special Ray init
        if LoadoutLeap___bonusActive[missile] and chosen == LOADOUT_ORB_ABILITY_RAY then
            set LoadoutLeap___rayLightning[missile]=AddLightningEx(LoadoutLeap___RAY_LIGHTNING_TYPE, true, x, y, 0.0, x, y, 0.0)
        endif

        set LoadoutLeap___delayedAnimTimer[dex]=NewTimerEx(dex)
        call SetTimerDebugTag(LoadoutLeap___delayedAnimTimer[dex] , TIMER_DEBUG_TAG_LOADOUT_LEAP)
        call TimerStart(LoadoutLeap___delayedAnimTimer[dex], LoadoutLeap___FIRST_ANIMATION_DELAY, false, function LoadoutLeap___DelayedStartAnimation)
        
        // Buff the caster during flight
        set buffDummy=CreateUnit(owner, 'dumi', x, y, 0)
        call UnitAddAbility(buffDummy, 'Aloc')
        call UnitAddAbility(buffDummy, LoadoutLeap___BUFF_CAST_ID)
        call IssueTargetOrderById(buffDummy, LoadoutLeap___ORDER_ID, source)
        call UnitApplyTimedLife(buffDummy, 'BTLF', 1.0)
        set buffDummy=null
        set companion=null
        
        call s__LoadoutLeap___LeapCore_launch(missile)

        set source=null
        set owner=null
    endfunction

    function CancelLoadoutLeapForUnit takes unit u returns nothing
        local integer hid
        local integer missile
        if u == null or GetUnitTypeId(u) == 0 then
            return
        endif
        set hid=GetHandleId(u)
        if hid != 0 and (HaveSavedInteger(Table__ht, (LoadoutLeap___activeLeapMissileByUnit), (hid))) then // INLINED!!
            set missile=(LoadInteger(Table__ht, (LoadoutLeap___activeLeapMissileByUnit), (hid))) // INLINED!!
            call RemoveSavedInteger(Table__ht, (LoadoutLeap___activeLeapMissileByUnit), (hid)) // INLINED!!
            if missile != 0 then
                call s__Missile_terminate(missile)
            endif
        elseif GetUnitAbilityLevel(u, LoadoutLeap___BUFF_APPLIED_ID) > 0 then
            call UnitRemoveAbility(u, LoadoutLeap___BUFF_APPLIED_ID)
            call SetUnitPathing(u, true)
            call SetUnitTimeScale(u, 1.0)
            call SetUnitFlyHeight(u, 0.0, 99999.)
        endif
    endfunction

    function LoadoutLeap___Init takes nothing returns nothing
        set LoadoutLeap___activeLeapMissileByUnit=s__Table_create()
        set LoadoutLeap___error=CreateSoundFromLabel("InterfaceError", false, false, false, 10, 10)
        call RegisterSpellEffectEvent(LoadoutLeap___LOADOUT_LEAP_SPELL , function LoadoutLeap___OnEffect)
    endfunction


    function SelectionSetupElement takes integer elementId,player p,unit hero returns nothing
        local integer abilityId
        local real speed
        local real damage
        local integer instances
        local string model
        local string overlay
        local string impactFx
        local string casterFx1= ""
        local string casterFx2= ""

        if elementId == 0 then
            set abilityId='AM05'
            set speed=0.
            set damage=1.
            set instances=1
            set model="Miss\\Shot Blue.mdx"
            set overlay="Miss\\Shot II Blue.mdx"
            set impactFx="Flamestrike Mystic II.mdx"
            set casterFx1="Miss\\Windwalk Blue Soul.mdx"
            set casterFx2="Miss\\Valiant Charge Royal.mdx"
        elseif elementId == 1 then
            set abilityId='AM03'
            set speed=0.
            set damage=1.
            set instances=1
            set model="Miss\\Shot Purple.mdx"
            set overlay="Miss\\Shot II Purple.mdx"
            set impactFx="Flamestrike Dark Void II.mdx"
            set casterFx1="Miss\\Windwalk.mdx"
            set casterFx2="Miss\\Valiant Charge Void.mdx"
        elseif elementId == 2 then
            set abilityId='AM01'
            set speed=0.
            set damage=1.
            set instances=1
            set model="Miss\\Shot Red.mdx"
            set overlay="Miss\\Shot II Red.mdx"
            set impactFx="Flamestrike Blood II.mdx"
            set casterFx1="Miss\\Windwalk Blood.mdx"
            set casterFx2="Miss\\Valiant Charge.mdx"
        elseif elementId == 3 then
            set abilityId='AM06'
            set speed=0.
            set damage=1.
            set instances=1
            set model="Miss\\Shot Yellow.mdx"
            set overlay="Miss\\Shot II Yellow.mdx"
            set impactFx="Flamestrike Fel II.mdx"
            set casterFx1="Miss\\Windwalk.mdx"
            set casterFx2="Miss\\Valiant Charge Holy.mdx"
        elseif elementId == 4 then
            set abilityId='AM02'
            set speed=0.
            set damage=1.
            set instances=1
            set model="Miss\\Shot Green.mdx"
            set overlay="Miss\\Shot II Green.mdx"
            set impactFx="Flamestrike Nature II.mdx"
            set casterFx1="Miss\\Windwalk Necro Soul.mdx"
            set casterFx2="Miss\\Valiant Charge Fel.mdx"
        else
            set abilityId='AM04'
            set speed=0.
            set damage=1.
            set instances=1
            set model="Miss\\Shot Orange.mdx"
            set overlay="Miss\\Shot II Orange.mdx"
            set impactFx="Flamestrike II.mdx"
            set casterFx1="Miss\\Windwalk Fire.mdx"
            set casterFx2="Miss\\Valiant Charge.mdx"
        endif

        // El PreSelect ya no otorga habilidad de orbe/elemento.
        // El elementId queda solo como perfil visual/color del proyectil.
        // Tier 1 usa Blue; futuros tiers pueden llamar esta config con otro elementId.
        call SetPlayerLeapCasterFx(p , casterFx1 , casterFx2)
        call SetPlayerMissileLoadout(p , abilityId , speed , damage , instances , model , overlay)
        call SetPlayerLeapImpactFx(p , impactFx)
    endfunction





    function WaveProjectileCore__WaveProjectileClampDamage takes integer projectileId,real damage returns real
        if damage > 0. then
            return damage
        endif
        return (WaveProjectileConfig___baseDamage[(projectileId)]) // INLINED!!
    endfunction

    function WaveProjectileCore__WaveProjectileApplyTemplate takes integer projectileId,unit source,integer missile,real damage returns nothing
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=GetOwningPlayer(source)
        call s__Missile__set_model(missile,(WaveProjectileConfig___modelPath[(projectileId)])) // INLINED!!
        call s__Missile__set_scale(missile,(WaveProjectileConfig___scaleValue[(projectileId)])) // INLINED!!
        set s__Missile_collision[missile]=(WaveProjectileConfig___collisionSize[(projectileId)]) // INLINED!!
        set s__Missile_damage[missile]=WaveProjectileCore__WaveProjectileClampDamage(projectileId , damage)
        set s__Missile_speed[(missile)]=(((WaveProjectileConfig___moveSpeed[(projectileId)]))*1.0) * Missile_TIMER_TIMEOUT // INLINED!!

        set WaveProjectileCore__WaveProjectileTypeByMissile[missile]=projectileId
        set WaveProjectileCore__WaveProjectileDamageByMissile[missile]=s__Missile_damage[missile]
    endfunction

        function s__WaveProjectileCore__WaveProjectileStruct_onCollide takes integer missile,unit hit returns boolean
            local integer projectileId= WaveProjectileCore__WaveProjectileTypeByMissile[missile]
            return WaveProjectileBehaviorOnUnit(projectileId , missile , hit , WaveProjectileCore__WaveProjectileDamageByMissile[missile])
        endfunction

        function s__WaveProjectileCore__WaveProjectileStruct_onDestructable takes integer missile,destructable hit returns boolean
            local integer projectileId= WaveProjectileCore__WaveProjectileTypeByMissile[missile]
            return WaveProjectileBehaviorOnDestructable(projectileId , missile , hit)
        endfunction

        function s__WaveProjectileCore__WaveProjectileStruct_onTerrain takes integer missile returns boolean
            local integer projectileId= WaveProjectileCore__WaveProjectileTypeByMissile[missile]
            return WaveProjectileBehaviorOnTerrain(projectileId , missile)
        endfunction

        function s__WaveProjectileCore__WaveProjectileStruct_onFinish takes integer missile returns boolean
            local integer projectileId= WaveProjectileCore__WaveProjectileTypeByMissile[missile]
            return WaveProjectileBehaviorOnFinish(projectileId , missile , WaveProjectileCore__WaveProjectileDamageByMissile[missile])
        endfunction

        function s__WaveProjectileCore__WaveProjectileStruct_onRemove takes integer missile returns boolean
            local integer projectileId= WaveProjectileCore__WaveProjectileTypeByMissile[missile]
            call WaveProjectileBehaviorOnRemove(projectileId , missile)
            set WaveProjectileCore__WaveProjectileTypeByMissile[missile]=0
            set WaveProjectileCore__WaveProjectileDamageByMissile[missile]=0.
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__WaveProjectileCore__WaveProjectileStruct_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__WaveProjectileCore__WaveProjectileStruct],missile)
            call Missile___StartPeriodic(si__WaveProjectileCore__WaveProjectileStruct)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__WaveProjectileCore__WaveProjectileStruct_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__WaveProjectileCore__WaveProjectileStruct_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__WaveProjectileCore__WaveProjectileStruct)
            endif
        endfunction
























        

        function s__WaveProjectileCore__WaveProjectileStruct_MissileAction___missileActionDest takes nothing returns nothing
            local destructable d= GetEnumDestructable()
            local integer this= s__Missile_temp
            if s__Missile_allocated[this] then
                call SaveDestructableHandle(Missile___HASH, this, GetHandleId(d), d)
                if s__WaveProjectileCore__WaveProjectileStruct_onDestructable(this , d) then
                    call s__WaveProjectileCore__WaveProjectileStruct_missileTerminateP(this)
                endif
            endif
            set d=null
        endfunction

    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__WaveProjectileCore__WaveProjectileStruct_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__WaveProjectileCore__WaveProjectileStruct])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__WaveProjectileCore__WaveProjectileStruct_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.

                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            set b=s__Missile_collisionType[this] == Missile_COLLISION_TYPE_RECTANGLE
                            if b then
                                call s__Missile_groupEnumUnitsRectangle(this)
                            else
                                call GroupEnumUnitsInRange(Missile___GROUP, s__Missile_x[this], s__Missile_y[this], s__Missile_collision[this] + Missile_MAXIMUM_COLLISION_SIZE, null)
                            endif
                            loop
                                set u=FirstOfGroup(Missile___GROUP)
                                exitwhen u == null
                                call GroupRemoveUnit(Missile___GROUP, u)
                                if not HaveSavedHandle(Missile___HASH, this, GetHandleId(u)) then
                                    if IsUnitInRange(u, s__Missile_dummy[this], s__Missile_collision[this]) or b then
                                        // Eventually run z collision checks.

                                            set collideZ=Missile_GetLocZ(GetUnitX(u) , GetUnitY(u)) + GetUnitFlyHeight(u) - s__Missile_terrainZ[this]
                                            if ( collideZ + GetUnitBodySize(u) >= s__Missile_z[this] - (s__Missile_collision[(this)]) ) and ( collideZ <= s__Missile_z[this] + (s__Missile_collision[(this)]) ) then // INLINED!!
                                                // Mark as hit.
                                                call SaveUnitHandle(Missile___HASH, this, GetHandleId(u), u)
                                                if s__WaveProjectileCore__WaveProjectileStruct_onCollide(this , u) then
                                                    call s__WaveProjectileCore__WaveProjectileStruct_missileTerminateP(this)
                                                    exitwhen true
                                                endif
                                            endif
    








                                    endif
                                endif
                            endloop
                        endif

                    
                    // Runs destructable collision.

                        // Check if the missile is not terminated.
                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            call s__Missile_checkDestCollision(this,function s__WaveProjectileCore__WaveProjectileStruct_MissileAction___missileActionDest)
                        endif

                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__WaveProjectileCore__WaveProjectileStruct_onFinish(this) then
                                call s__WaveProjectileCore__WaveProjectileStruct_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.

                        if s__Missile_allocated[this] and 0. > s__Missile_z[this] and s__WaveProjectileCore__WaveProjectileStruct_onTerrain(this) then
                            call s__WaveProjectileCore__WaveProjectileStruct_missileTerminateP(this)
                        endif

                
                    // Runs every Missile_TIMER_TIMEOUT.





                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__WaveProjectileCore__WaveProjectileStruct_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__WaveProjectileCore__WaveProjectileStruct)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__WaveProjectileCore__WaveProjectileStruct )]=Condition(( function s__WaveProjectileCore__WaveProjectileStruct_missileIterateP)) // INLINED!!
        endfunction

    function WaveProjectileLaunch takes integer projectileId,unit source,real startX,real startY,real angleInRadians,real damage returns integer
        local integer missile
        local real z
        if source == null or GetUnitTypeId(source) == 0 then
            return 0
        endif
        if not WaveProjectileIsRegistered(projectileId) then
            return 0
        endif
        set z=(WaveProjectileConfig___startZ[(projectileId)]) // INLINED!!
        set missile=s__Missile_create(startX , startY , z , angleInRadians , (WaveProjectileConfig___travelDistance[(projectileId)]) , z) // INLINED!!
        call WaveProjectileCore__WaveProjectileApplyTemplate(projectileId , source , missile , damage)
        call s__WaveProjectileCore__WaveProjectileStruct_launch(missile)
        return missile
    endfunction

    function WaveProjectileLaunchFromSourceAngle takes integer projectileId,unit source,real angleInRadians,real damage returns integer
        if source == null or GetUnitTypeId(source) == 0 then
            return 0
        endif
        return WaveProjectileLaunch(projectileId , source , GetUnitX(source) , GetUnitY(source) , angleInRadians , damage)
    endfunction

    function WaveProjectileLaunchFromSourceToPoint takes integer projectileId,unit source,real tx,real ty,real damage returns integer
        local real x
        local real y
        if source == null or GetUnitTypeId(source) == 0 then
            return 0
        endif
        set x=GetUnitX(source)
        set y=GetUnitY(source)
        return WaveProjectileLaunch(projectileId , source , x , y , Atan2(ty - y, tx - x) , damage)
    endfunction

    function WaveProjectileLaunchFromSourceToUnit takes integer projectileId,unit source,unit target,real damage returns integer
        if target == null or GetUnitTypeId(target) == 0 then
            return 0
        endif
        return WaveProjectileLaunchFromSourceToPoint(projectileId , source , GetUnitX(target) , GetUnitY(target) , damage)
    endfunction

    function WaveProjectileLaunchToPointExact takes integer projectileId,unit source,real startX,real startY,real tx,real ty,real damage returns integer
        local integer missile
        local real z
        if source == null or GetUnitTypeId(source) == 0 then
            return 0
        endif
        if not WaveProjectileIsRegistered(projectileId) then
            return 0
        endif
        set z=(WaveProjectileConfig___startZ[(projectileId)]) // INLINED!!
        set missile=s__Missile_createXYZ(startX , startY , z , tx , ty , z)
        call WaveProjectileCore__WaveProjectileApplyTemplate(projectileId , source , missile , damage)
        call s__WaveProjectileCore__WaveProjectileStruct_launch(missile)
        return missile
    endfunction

    function WaveProjectileLaunchFromSourceToPointExact takes integer projectileId,unit source,real tx,real ty,real damage returns integer
        if source == null or GetUnitTypeId(source) == 0 then
            return 0
        endif
        return WaveProjectileLaunchToPointExact(projectileId , source , GetUnitX(source) , GetUnitY(source) , tx , ty , damage)
    endfunction



function WeaponInventoryCore__WeaponInventoryKey takes integer pid,integer slot returns integer
    return pid * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + slot
endfunction

function WeaponInventoryCore__WeaponInventoryValidPid takes integer pid returns boolean
    return pid >= 0 and pid < bj_MAX_PLAYER_SLOTS
endfunction

function WeaponInventoryCore__WeaponInventoryValidSlot takes integer slot returns boolean
    return slot == WEAPON_INVENTORY_SLOT_1 or slot == WEAPON_INVENTORY_SLOT_2
endfunction

function WeaponInventoryCore__WeaponInventoryValidHero takes unit hero returns boolean
    return hero != null and GetUnitTypeId(hero) != 0
endfunction

function WeaponInventoryCore__WeaponInventoryMarkDirtyByPid takes integer pid returns nothing
    if WeaponInventoryCore__WeaponInventoryValidPid(pid) then
        set WeaponInventoryCore__WeaponInventoryHudVersion[pid]=WeaponInventoryCore__WeaponInventoryHudVersion[pid] + 1
    endif
endfunction

function WeaponInventoryCore__WeaponInventoryRemoveLegacyAbilities takes unit hero returns nothing
    local integer profileId= WEAPON_PROFILE_HANDGUN
    loop
        exitwhen profileId > WEAPON_PROFILE_LAST
        call UnitRemoveAbility(hero, WeaponProfileGetSelectorAbility(profileId))
        call UnitRemoveAbility(hero, WeaponProfileGetFireAbility(profileId))
        set profileId=profileId + 1
    endloop
endfunction

function WeaponInventoryCore__WeaponInventoryApplyProfileStats takes player p,integer profileId returns nothing
    call SetPlayerMissileDamageValue(p , WeaponProfileGetDamage(profileId))
    call SetPlayerMissileSpeedBonus(p , 0.00)
    call SetPlayerMissileModelPath(p , WeaponProfileGetTierMissileModel(profileId , 1))
    call SetPlayerMissileOverlayModelPath(p , "")
    call SetPlayerMissileInstanceCount(p , 1)
    call SetPlayerMissileUseRapidFireMissile(p , true)
    call SetPlayerMissileUseRapidFireControl(p , false)
endfunction

function WeaponInventoryCore__WeaponInventoryGetSoundPathA takes integer profileId returns string
    if profileId == WEAPON_PROFILE_SHOTGUN then
        return "war3mapImported\\MSX_Shotgun.wav"
    elseif profileId == WEAPON_PROFILE_HEAVY_MACHINE_GUN then
        return "war3mapImported\\MSX_Heavy_Machinegun.wav"
    elseif profileId == WEAPON_PROFILE_TWO_MACHINE_GUN then
        return "war3mapImported\\MS4_Two_Machinegun.wav"
    elseif profileId == WEAPON_PROFILE_ROCKET_LAUNCHER then
        return "war3mapImported\\MSX_Rocket_Launcher.wav"
    elseif profileId == WEAPON_PROFILE_ENEMY_CHASER then
        return "war3mapImported\\MSX_Enemy_Chaser.wav"
    elseif profileId == WEAPON_PROFILE_LASER_GUN then
        return "war3mapImported\\MSX_Laser_Gun.wav"
    elseif profileId == WEAPON_PROFILE_DROP_SHOT then
        return "war3mapImported\\MSX_Drop_Shot.wav"
    elseif profileId == WEAPON_PROFILE_FLAME_SHOT then
        return "war3mapImported\\MSX_Flame_Shot.wav"
    elseif profileId == WEAPON_PROFILE_IRON_LIZARD then
        return "war3mapImported\\MSX_Iron_Lizard.wav"
    elseif profileId == WEAPON_PROFILE_SUPER_GRENADE then
        return "war3mapImported\\MSX_Super_Grenade.wav"
    elseif profileId == WEAPON_PROFILE_THUNDER_SHOT then
        return "war3mapImported\\MS7_Thunder_Shot.wav"
    endif
    return ""
endfunction

function WeaponInventoryCore__WeaponInventoryGetSoundPathB takes integer profileId returns string
    if profileId == WEAPON_PROFILE_SHOTGUN then
        return "war3mapImported\\MS_Shotgun.wav"
    elseif profileId == WEAPON_PROFILE_HEAVY_MACHINE_GUN then
        return "war3mapImported\\MS_Heavy_Machinegun.wav"
    elseif profileId == WEAPON_PROFILE_TWO_MACHINE_GUN then
        return "war3mapImported\\MS5_Two_Machinegun.wav"
    elseif profileId == WEAPON_PROFILE_ROCKET_LAUNCHER then
        return "war3mapImported\\MS_Rocket_Launcher.wav"
    elseif profileId == WEAPON_PROFILE_LASER_GUN then
        return "war3mapImported\\MS2_Laser.wav"
    elseif profileId == WEAPON_PROFILE_FLAME_SHOT then
        return "war3mapImported\\MS_Flame_Shot.wav"
    endif
    return ""
endfunction

function WeaponInventoryCore__WeaponInventoryCreateSound takes string path returns sound
    local sound s
    if path == "" then
        return null
    endif
    call Preload(path)
    set s=CreateSound(path, false, false, false, 12700, 12700, "")
    call SetSoundVolume(s, 127)
    return s
endfunction

function WeaponInventoryCore__WeaponInventoryPlayLocalSound takes player p,sound s returns nothing
    if s != null and GetLocalPlayer() == p then
        call StartSound(s)
    endif
endfunction

function WeaponInventoryCore__WeaponInventoryPlayWeaponSoundNow takes player p,integer profileId returns nothing
    local sound s
    if profileId == WEAPON_PROFILE_HANDGUN or not WeaponProfileIsWeapon(profileId) then
        return
    endif
    set s=WeaponInventoryCore__WeaponInventorySoundA[profileId]
    if WeaponInventoryCore__WeaponInventorySoundB[profileId] != null and GetRandomInt(0, 1) == 1 then
        set s=WeaponInventoryCore__WeaponInventorySoundB[profileId]
    endif
    call WeaponInventoryCore__WeaponInventoryPlayLocalSound(p , s)
    set s=null
endfunction

function WeaponInventoryCore__WeaponInventoryPlayPendingWeaponSound takes nothing returns nothing
    local timer t= GetExpiredTimer()
    local integer pid= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
    local integer profileId= WeaponInventoryCore__WeaponInventoryPendingSoundProfile[pid]
    set WeaponInventoryCore__WeaponInventorySoundTimer[pid]=null
    set WeaponInventoryCore__WeaponInventoryPendingSoundProfile[pid]=WEAPON_PROFILE_NONE
    call WeaponInventoryCore__WeaponInventoryPlayWeaponSoundNow(Player(pid) , profileId)
    call ReleaseTimer(t)
    set t=null
endfunction

function WeaponInventoryCore__WeaponInventoryQueueWeaponSound takes player p,integer profileId returns nothing
    local integer pid= GetPlayerId(p)
    if not WeaponInventoryCore__WeaponInventoryValidPid(pid) or profileId == WEAPON_PROFILE_HANDGUN or not WeaponProfileIsWeapon(profileId) then
        return
    endif
    set WeaponInventoryCore__WeaponInventoryPendingSoundProfile[pid]=profileId
    if WeaponInventoryCore__WeaponInventorySoundTimer[pid] != null then
        return
    endif
    call WeaponInventoryCore__WeaponInventoryPlayLocalSound(p , WeaponInventoryCore__WeaponInventoryReloadSound)
    set WeaponInventoryCore__WeaponInventorySoundTimer[pid]=NewTimerEx(pid)
    call SetTimerDebugTag(WeaponInventoryCore__WeaponInventorySoundTimer[pid] , TIMER_DEBUG_TAG_OTHER)
    call TimerStart(WeaponInventoryCore__WeaponInventorySoundTimer[pid], 0.50, false, function WeaponInventoryCore__WeaponInventoryPlayPendingWeaponSound)
endfunction

function WeaponInventoryCore__WeaponInventoryInitSounds takes nothing returns nothing
    local integer profileId= WEAPON_PROFILE_HANDGUN
    set WeaponInventoryCore__WeaponInventoryReloadSound=WeaponInventoryCore__WeaponInventoryCreateSound("war3mapImported\\reloadweapon.wav")
    loop
        exitwhen profileId > WEAPON_PROFILE_LAST
        set WeaponInventoryCore__WeaponInventorySoundA[profileId]=WeaponInventoryCore__WeaponInventoryCreateSound(WeaponInventoryCore__WeaponInventoryGetSoundPathA(profileId))
        set WeaponInventoryCore__WeaponInventorySoundB[profileId]=WeaponInventoryCore__WeaponInventoryCreateSound(WeaponInventoryCore__WeaponInventoryGetSoundPathB(profileId))
        set profileId=profileId + 1
    endloop
endfunction

function WeaponInventoryGetHudVersion takes player p returns integer
    return WeaponInventoryCore__WeaponInventoryHudVersion[GetPlayerId(p)]
endfunction

function WeaponInventoryGetSlotProfile takes player p,integer slot returns integer
    local integer pid= GetPlayerId(p)
    local integer profileId
    if not WeaponInventoryCore__WeaponInventoryValidPid(pid) or not WeaponInventoryCore__WeaponInventoryValidSlot(slot) then
        return WEAPON_PROFILE_HANDGUN
    endif
    set profileId=WeaponInventoryCore__WeaponInventorySlotProfile[((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( slot))] // INLINED!!
    if not WeaponProfileIsWeapon(profileId) then
        return WEAPON_PROFILE_HANDGUN
    endif
    return profileId
endfunction

function WeaponInventoryGetSlotAmmo takes player p,integer slot returns integer
    local integer pid= GetPlayerId(p)
    local integer profileId= WeaponInventoryGetSlotProfile(p , slot)
    if profileId == WEAPON_PROFILE_HANDGUN then
        return WEAPON_AMMO_INFINITE
    endif
    if not WeaponInventoryCore__WeaponInventoryValidPid(pid) or not WeaponInventoryCore__WeaponInventoryValidSlot(slot) then
        return 0
    endif
    return WeaponInventoryCore__WeaponInventorySlotAmmo[((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( slot))] // INLINED!!
endfunction

function WeaponInventoryGetActiveSlot takes player p returns integer
    local integer pid= GetPlayerId(p)
    if not WeaponInventoryCore__WeaponInventoryValidPid(pid) then
        return WEAPON_INVENTORY_SLOT_1
    endif
    if not WeaponInventoryCore__WeaponInventoryValidSlot(WeaponInventoryCore__WeaponInventoryActiveSlot[pid]) then
        set WeaponInventoryCore__WeaponInventoryActiveSlot[pid]=WEAPON_INVENTORY_SLOT_1
    endif
    return WeaponInventoryCore__WeaponInventoryActiveSlot[pid]
endfunction

function WeaponInventoryGetActiveProfile takes player p returns integer
    return WeaponInventoryGetSlotProfile(p , WeaponInventoryGetActiveSlot(p))
endfunction

function WeaponInventoryGetActiveAmmo takes player p returns integer
    return WeaponInventoryGetSlotAmmo(p , WeaponInventoryGetActiveSlot(p))
endfunction

function WeaponInventorySetSlotWeapon takes player p,integer slot,integer profileId,integer ammo returns boolean
    local integer pid= GetPlayerId(p)
    local integer key
    if not WeaponInventoryCore__WeaponInventoryValidPid(pid) or not WeaponInventoryCore__WeaponInventoryValidSlot(slot) or not WeaponProfileIsWeapon(profileId) then
        return false
    endif
    set key=((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( slot)) // INLINED!!
    set WeaponInventoryCore__WeaponInventorySlotProfile[key]=profileId
    if profileId == WEAPON_PROFILE_HANDGUN then
        set WeaponInventoryCore__WeaponInventorySlotAmmo[key]=WEAPON_AMMO_INFINITE
    else
        if ammo < 0 then
            set ammo=0
        endif
        set WeaponInventoryCore__WeaponInventorySlotAmmo[key]=ammo
    endif
    call WeaponInventoryCore__WeaponInventoryMarkDirtyByPid(pid)
    if WeaponInventoryCore__WeaponInventoryActiveSlot[pid] == slot then
        call WeaponInventoryCore__WeaponInventoryApplyProfileStats(p , profileId)
    endif
    return true
endfunction

function WeaponInventoryResetSlotToHandgun takes player p,integer slot returns nothing
    call WeaponInventorySetSlotWeapon(p , slot , WEAPON_PROFILE_HANDGUN , WEAPON_AMMO_INFINITE)
endfunction

function WeaponInventorySetActiveSlot takes player p,integer slot returns boolean
    local integer pid= GetPlayerId(p)
    if not WeaponInventoryCore__WeaponInventoryValidPid(pid) or not WeaponInventoryCore__WeaponInventoryValidSlot(slot) then
        return false
    endif
    set WeaponInventoryCore__WeaponInventoryActiveSlot[pid]=slot
    call WeaponInventoryCore__WeaponInventoryApplyProfileStats(p , WeaponInventoryGetSlotProfile(p , slot))
    call WeaponInventoryCore__WeaponInventoryQueueWeaponSound(p , WeaponInventoryGetSlotProfile(p , slot))
    call WeaponInventoryCore__WeaponInventoryMarkDirtyByPid(pid)
    return true
endfunction

function WeaponInventoryEnsurePlayer takes player p returns nothing
    local integer pid= GetPlayerId(p)
    local unit hero= PlayerHero[pid]
    if not WeaponInventoryCore__WeaponInventoryValidPid(pid) then
        set hero=null
        return
    endif
    if not WeaponInventoryCore__WeaponInventoryValidSlot(WeaponInventoryCore__WeaponInventoryActiveSlot[pid]) then
        set WeaponInventoryCore__WeaponInventoryActiveSlot[pid]=WEAPON_INVENTORY_SLOT_1
    endif
    if not WeaponProfileIsWeapon(WeaponInventoryCore__WeaponInventorySlotProfile[((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( WEAPON_INVENTORY_SLOT_1))]) then // INLINED!!
        call WeaponInventorySetSlotWeapon((p ) , ( WEAPON_INVENTORY_SLOT_1) , WEAPON_PROFILE_HANDGUN , WEAPON_AMMO_INFINITE) // INLINED!!
    endif
    if not WeaponProfileIsWeapon(WeaponInventoryCore__WeaponInventorySlotProfile[((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( WEAPON_INVENTORY_SLOT_2))]) then // INLINED!!
        call WeaponInventorySetSlotWeapon((p ) , ( WEAPON_INVENTORY_SLOT_2) , WEAPON_PROFILE_HANDGUN , WEAPON_AMMO_INFINITE) // INLINED!!
    endif
    if WeaponInventoryCore__WeaponInventoryValidHero(hero) then
        call WeaponInventoryCore__WeaponInventoryRemoveLegacyAbilities(hero)
        if GetUnitAbilityLevel(hero, WEAPON_INVENTORY_FIRE_ABILITY) <= 0 then
            call UnitAddAbility(hero, WEAPON_INVENTORY_FIRE_ABILITY)
            call SetUnitAbilityLevel(hero, WEAPON_INVENTORY_FIRE_ABILITY, 1)
        endif
        if GetUnitAbilityLevel(hero, WEAPON_INVENTORY_SELECT_SLOT_1_ABILITY) <= 0 then
            call UnitAddAbility(hero, WEAPON_INVENTORY_SELECT_SLOT_1_ABILITY)
            call SetUnitAbilityLevel(hero, WEAPON_INVENTORY_SELECT_SLOT_1_ABILITY, 1)
        endif
        if GetUnitAbilityLevel(hero, WEAPON_INVENTORY_SELECT_SLOT_2_ABILITY) <= 0 then
            call UnitAddAbility(hero, WEAPON_INVENTORY_SELECT_SLOT_2_ABILITY)
            call SetUnitAbilityLevel(hero, WEAPON_INVENTORY_SELECT_SLOT_2_ABILITY, 1)
        endif
    endif
    call WeaponInventoryCore__WeaponInventoryApplyProfileStats(p , WeaponInventoryGetActiveProfile(p))
    call WeaponInventoryCore__WeaponInventoryMarkDirtyByPid(pid)
    set hero=null
endfunction

function WeaponInventoryGiveWeapon takes player p,integer profileId,integer ammo returns boolean
    local integer pid= GetPlayerId(p)
    local integer activeSlot
    local integer otherSlot
    local integer activeProfile
    local integer otherProfile
    local integer targetSlot
    local integer currentAmmo
    if not WeaponInventoryCore__WeaponInventoryValidPid(pid) or not WeaponProfileIsWeapon(profileId) then
        return false
    endif
    call WeaponInventoryEnsurePlayer(p)
    if profileId == WEAPON_PROFILE_HANDGUN then
        return true
    endif
    if ammo <= 0 then
        set ammo=WeaponProfileGetDefaultAmmo(profileId)
    endif
    if WeaponInventoryGetSlotProfile(p , WEAPON_INVENTORY_SLOT_1) == profileId then
        set currentAmmo=WeaponInventoryGetSlotAmmo(p , WEAPON_INVENTORY_SLOT_1)
        call WeaponInventorySetSlotWeapon(p , WEAPON_INVENTORY_SLOT_1 , profileId , currentAmmo + ammo)
        call WeaponInventoryCore__WeaponInventoryQueueWeaponSound(p , profileId)
        return true
    endif
    if WeaponInventoryGetSlotProfile(p , WEAPON_INVENTORY_SLOT_2) == profileId then
        set currentAmmo=WeaponInventoryGetSlotAmmo(p , WEAPON_INVENTORY_SLOT_2)
        call WeaponInventorySetSlotWeapon(p , WEAPON_INVENTORY_SLOT_2 , profileId , currentAmmo + ammo)
        call WeaponInventoryCore__WeaponInventoryQueueWeaponSound(p , profileId)
        return true
    endif

    set activeSlot=WeaponInventoryGetActiveSlot(p)
    set otherSlot=WEAPON_INVENTORY_SLOT_1
    if activeSlot == WEAPON_INVENTORY_SLOT_1 then
        set otherSlot=WEAPON_INVENTORY_SLOT_2
    endif
    set activeProfile=WeaponInventoryGetSlotProfile(p , activeSlot)
    set otherProfile=WeaponInventoryGetSlotProfile(p , otherSlot)
    if activeProfile == WEAPON_PROFILE_HANDGUN then
        set targetSlot=activeSlot
    elseif otherProfile == WEAPON_PROFILE_HANDGUN then
        set targetSlot=otherSlot
    else
        set targetSlot=activeSlot
    endif
    if WeaponInventorySetSlotWeapon(p , targetSlot , profileId , ammo) then
        call WeaponInventoryCore__WeaponInventoryQueueWeaponSound(p , profileId)
        return true
    endif
    return false
endfunction

function WeaponInventoryConsumeShotForProfile takes player p,integer profileId returns boolean
    local integer pid= GetPlayerId(p)
    local integer slot= WeaponInventoryGetActiveSlot(p)
    local integer key= ((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( slot)) // INLINED!!
    local integer ammo
    if not WeaponInventoryCore__WeaponInventoryValidPid(pid) or not WeaponProfileIsWeapon(profileId) then
        return false
    endif
    if profileId == WEAPON_PROFILE_HANDGUN then
        return true
    endif
    if WeaponInventoryCore__WeaponInventorySlotProfile[key] != profileId then
        return false
    endif
    set ammo=WeaponInventoryCore__WeaponInventorySlotAmmo[key]
    if ammo <= 0 then
        call WeaponInventorySetSlotWeapon((p ) , ( slot) , WEAPON_PROFILE_HANDGUN , WEAPON_AMMO_INFINITE) // INLINED!!
        return false
    endif
    set ammo=ammo - 1
    if ammo <= 0 then
        call WeaponInventorySetSlotWeapon((p ) , ( slot) , WEAPON_PROFILE_HANDGUN , WEAPON_AMMO_INFINITE) // INLINED!!
    else
        set WeaponInventoryCore__WeaponInventorySlotAmmo[key]=ammo
        call WeaponInventoryCore__WeaponInventoryMarkDirtyByPid(pid)
    endif
    return true
endfunction

function WeaponInventoryConsumeShot takes player p returns boolean
    return WeaponInventoryConsumeShotForProfile(p , WeaponInventoryGetActiveProfile(p))
endfunction

function WeaponInventoryCanStartFire takes player p returns boolean
    local integer profileId= WeaponInventoryGetActiveProfile(p)
    if profileId == WEAPON_PROFILE_HANDGUN then
        return true
    endif
    if WeaponInventoryGetActiveAmmo(p) > 0 then
        return true
    endif
    call WeaponInventorySetSlotWeapon((p ) , ( WeaponInventoryGetActiveSlot(p)) , WEAPON_PROFILE_HANDGUN , WEAPON_AMMO_INFINITE) // INLINED!!
    return false
endfunction

function WeaponInventoryResetActiveSlotOnDeath takes player p returns nothing
    call WeaponInventorySetSlotWeapon((p ) , ( WeaponInventoryGetActiveSlot(p)) , WEAPON_PROFILE_HANDGUN , WEAPON_AMMO_INFINITE) // INLINED!!
endfunction

function WeaponInventoryCore__Init takes nothing returns nothing
    local integer pid= 0
    call WeaponInventoryCore__WeaponInventoryInitSounds()
    loop
        exitwhen pid >= bj_MAX_PLAYER_SLOTS
        set WeaponInventoryCore__WeaponInventoryActiveSlot[pid]=WEAPON_INVENTORY_SLOT_1
        set WeaponInventoryCore__WeaponInventorySlotProfile[((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( WEAPON_INVENTORY_SLOT_1))]=WEAPON_PROFILE_HANDGUN // INLINED!!
        set WeaponInventoryCore__WeaponInventorySlotAmmo[((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( WEAPON_INVENTORY_SLOT_1))]=WEAPON_AMMO_INFINITE // INLINED!!
        set WeaponInventoryCore__WeaponInventorySlotProfile[((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( WEAPON_INVENTORY_SLOT_2))]=WEAPON_PROFILE_HANDGUN // INLINED!!
        set WeaponInventoryCore__WeaponInventorySlotAmmo[((pid ) * WeaponInventoryCore__WEAPON_INVENTORY_SLOT_STRIDE + ( WEAPON_INVENTORY_SLOT_2))]=WEAPON_AMMO_INFINITE // INLINED!!
        set WeaponInventoryCore__WeaponInventoryHudVersion[pid]=1
        set pid=pid + 1
    endloop
endfunction




    function LoadoutIronLizard__GetSafeFireInterval takes nothing returns real
        local real duration= WeaponProfileGetCastDuration(WEAPON_PROFILE_IRON_LIZARD)
        local integer count= WeaponProfileGetCastCount(WEAPON_PROFILE_IRON_LIZARD)
        if duration <= 0. then
            return 0.03125
        endif
        if count <= 0 then
            return duration
        endif
        return duration / I2R(count)
    endfunction

    function LoadoutIronLizard__FilterUnits takes unit target,player owner returns boolean
        return UnitAlive(target) and IsUnitEnemy(target, owner) and not IsUnitType(target, UNIT_TYPE_STRUCTURE)
    endfunction

    function LoadoutIronLizard__DamageUnit takes unit source,unit target,real amount returns boolean
        if amount <= 0. then
            return false
        endif
        if ( GetUnitTypeId(source) == 0 ) or ( GetUnitTypeId(target) == 0 ) then
            return false
        endif
        call WaveRecordDamageCredit(source , target)
        return UnitDamageTarget(source, target, amount, false, false, LoadoutIronLizard__ATTACK_TYPE, LoadoutIronLizard__DAMAGE_TYPE, null)
    endfunction

    function LoadoutIronLizard__ShowIronImpact takes unit target returns nothing
        local effect fx= AddSpecialEffectTarget(WeaponProfileGetMissileModel(WEAPON_PROFILE_IRON_LIZARD), target, LoadoutIronLizard__IMPACT_ATTACH)
        call DestroyEffect(fx)
        set fx=null
    endfunction

    function LoadoutIronLizard__BounceIronLizard takes integer missile,real normalX,real normalY returns boolean
        local real newAngle
        if LoadoutIronLizard__lizardBouncesLeft[missile] <= 0 then
            return true
        endif
        set LoadoutIronLizard__lizardBouncesLeft[missile]=LoadoutIronLizard__lizardBouncesLeft[missile] - 1
        set newAngle=2.00 * Atan2(normalY - s__Missile_y[missile], normalX - s__Missile_x[missile]) + bj_PI - s__Missile_angle[missile]
        call s__MissilePosition_move(s__Missile_impact[missile],s__Missile_x[missile] + LoadoutIronLizard__LIZARD_RANGE * Cos(newAngle) , s__Missile_y[missile] + LoadoutIronLizard__LIZARD_RANGE * Sin(newAngle) , LoadoutIronLizard__MISSILE_START_Z)
        call s__Missile_bounce(missile)
        call s__Missile_flushHitWidgets(missile)
        set s__Missile_recycle[missile]=false
        return false
    endfunction

        function s__LoadoutIronLizard__IronLizardCore_onCollide takes integer missile,unit hit returns boolean
            if not LoadoutIronLizard__FilterUnits(hit , LoadoutIronLizard__lizardOwner[missile]) then
                return false
            endif
            call LoadoutIronLizard__DamageUnit(LoadoutIronLizard__lizardSource[missile] , hit , LoadoutIronLizard__lizardDamage[missile])
            call LoadoutIronLizard__ShowIronImpact(hit)
            return false
        endfunction

        function s__LoadoutIronLizard__IronLizardCore_onDestructable takes integer missile,destructable hit returns boolean
            return false
        endfunction

        function s__LoadoutIronLizard__IronLizardCore_onTerrain takes integer missile returns boolean
            return LoadoutIronLizard__BounceIronLizard(missile , s__Missile_prevX[missile] , s__Missile_prevY[missile])
        endfunction

        function s__LoadoutIronLizard__IronLizardCore_onFinish takes integer missile returns boolean
            return true
        endfunction

        function s__LoadoutIronLizard__IronLizardCore_onRemove takes integer missile returns boolean
            set LoadoutIronLizard__lizardDamage[missile]=0.00
            set LoadoutIronLizard__lizardBouncesLeft[missile]=0
            set LoadoutIronLizard__lizardSource[missile]=null
            set LoadoutIronLizard__lizardOwner[missile]=null
            call s__SpellIndex_destroy((s__Missile_data[missile]))
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__LoadoutIronLizard__IronLizardCore_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__LoadoutIronLizard__IronLizardCore],missile)
            call Missile___StartPeriodic(si__LoadoutIronLizard__IronLizardCore)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__LoadoutIronLizard__IronLizardCore_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__LoadoutIronLizard__IronLizardCore_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__LoadoutIronLizard__IronLizardCore)
            endif
        endfunction
























        

        function s__LoadoutIronLizard__IronLizardCore_MissileAction___missileActionDest takes nothing returns nothing
            local destructable d= GetEnumDestructable()
            local integer this= s__Missile_temp
            if s__Missile_allocated[this] then
                call SaveDestructableHandle(Missile___HASH, this, GetHandleId(d), d)
                if s__LoadoutIronLizard__IronLizardCore_onDestructable(this , d) then
                    call s__LoadoutIronLizard__IronLizardCore_missileTerminateP(this)
                endif
            endif
            set d=null
        endfunction

    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__LoadoutIronLizard__IronLizardCore_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__LoadoutIronLizard__IronLizardCore])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__LoadoutIronLizard__IronLizardCore_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.

                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            set b=s__Missile_collisionType[this] == Missile_COLLISION_TYPE_RECTANGLE
                            if b then
                                call s__Missile_groupEnumUnitsRectangle(this)
                            else
                                call GroupEnumUnitsInRange(Missile___GROUP, s__Missile_x[this], s__Missile_y[this], s__Missile_collision[this] + Missile_MAXIMUM_COLLISION_SIZE, null)
                            endif
                            loop
                                set u=FirstOfGroup(Missile___GROUP)
                                exitwhen u == null
                                call GroupRemoveUnit(Missile___GROUP, u)
                                if not HaveSavedHandle(Missile___HASH, this, GetHandleId(u)) then
                                    if IsUnitInRange(u, s__Missile_dummy[this], s__Missile_collision[this]) or b then
                                        // Eventually run z collision checks.

                                            set collideZ=Missile_GetLocZ(GetUnitX(u) , GetUnitY(u)) + GetUnitFlyHeight(u) - s__Missile_terrainZ[this]
                                            if ( collideZ + GetUnitBodySize(u) >= s__Missile_z[this] - (s__Missile_collision[(this)]) ) and ( collideZ <= s__Missile_z[this] + (s__Missile_collision[(this)]) ) then // INLINED!!
                                                // Mark as hit.
                                                call SaveUnitHandle(Missile___HASH, this, GetHandleId(u), u)
                                                if s__LoadoutIronLizard__IronLizardCore_onCollide(this , u) then
                                                    call s__LoadoutIronLizard__IronLizardCore_missileTerminateP(this)
                                                    exitwhen true
                                                endif
                                            endif
    








                                    endif
                                endif
                            endloop
                        endif

                    
                    // Runs destructable collision.

                        // Check if the missile is not terminated.
                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            call s__Missile_checkDestCollision(this,function s__LoadoutIronLizard__IronLizardCore_MissileAction___missileActionDest)
                        endif

                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__LoadoutIronLizard__IronLizardCore_onFinish(this) then
                                call s__LoadoutIronLizard__IronLizardCore_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.

                        if s__Missile_allocated[this] and 0. > s__Missile_z[this] and s__LoadoutIronLizard__IronLizardCore_onTerrain(this) then
                            call s__LoadoutIronLizard__IronLizardCore_missileTerminateP(this)
                        endif

                
                    // Runs every Missile_TIMER_TIMEOUT.





                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__LoadoutIronLizard__IronLizardCore_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__LoadoutIronLizard__IronLizardCore)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__LoadoutIronLizard__IronLizardCore )]=Condition(( function s__LoadoutIronLizard__IronLizardCore_missileIterateP)) // INLINED!!
        endfunction

    function LoadoutIronLizard__LaunchIronLizard takes unit source,player owner,real angle returns nothing
        local real x= GetUnitX(source) + LoadoutIronLizard__MISSILE_FORWARD_OFFSET * Cos(angle)
        local real y= GetUnitY(source) + LoadoutIronLizard__MISSILE_FORWARD_OFFSET * Sin(angle)
        local integer missile= s__Missile_create(x , y , LoadoutIronLizard__MISSILE_START_Z , angle , LoadoutIronLizard__LIZARD_RANGE , LoadoutIronLizard__MISSILE_START_Z)
        local integer dex= s__SpellIndex__allocate()

        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_user[dex]=owner
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=owner
        set s__Missile_data[missile]=dex
        call s__Missile__set_model(missile,WeaponProfileGetTierMissileModel(WEAPON_PROFILE_IRON_LIZARD , 1))
        call s__Missile__set_scale(missile,WeaponProfileGetMissileScale(WEAPON_PROFILE_IRON_LIZARD))
        set s__Missile_collision[missile]=LoadoutIronLizard__MISSILE_COLLISION
        set s__Missile_speed[(missile)]=((WeaponProfileGetMissileSpeed(WEAPON_PROFILE_IRON_LIZARD))*1.0) * Missile_TIMER_TIMEOUT // INLINED!!

        set LoadoutIronLizard__lizardDamage[missile]=WeaponProfileGetDamage(WEAPON_PROFILE_IRON_LIZARD)
        set LoadoutIronLizard__lizardBouncesLeft[missile]=LoadoutIronLizard__LIZARD_MAX_BOUNCES
        set LoadoutIronLizard__lizardSource[missile]=source
        set LoadoutIronLizard__lizardOwner[missile]=owner

        call s__LoadoutIronLizard__IronLizardCore_launch(missile)
    endfunction

    function LoadoutIronLizard__CleanupCast takes integer dex returns nothing
        local integer id= 0
        if dex == 0 or s__SpellIndex_phase[dex] == - 999 then
            return
        endif
        set s__SpellIndex_phase[dex]=- 999
        if GetUnitTypeId(s__SpellIndex_source[dex]) != 0 then
            set id=GetHandleId(s__SpellIndex_source[dex])
            if (HaveSavedInteger(Table__ht, (LoadoutIronLizard__active), (id))) and ( (LoadInteger(Table__ht, (LoadoutIronLizard__active), (id))) == dex ) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (LoadoutIronLizard__active), (id)) // INLINED!!
            endif
        endif
        if s__SpellIndex_clock[dex] != null then
            call ReleaseTimer(s__SpellIndex_clock[dex])
            set s__SpellIndex_clock[dex]=null
        endif
        set LoadoutIronLizard__castAngle[dex]=0.00
        set LoadoutIronLizard__castTargetX[dex]=0.00
        set LoadoutIronLizard__castTargetY[dex]=0.00
        call s__SpellIndex_destroy(dex)
    endfunction

    function LoadoutIronLizard__FireCastShot takes integer dex returns nothing
        if GetUnitTypeId(s__SpellIndex_source[dex]) == 0 or not UnitAlive(s__SpellIndex_source[dex]) then
            return
        endif
        if not WeaponInventoryConsumeShotForProfile(s__SpellIndex_user[dex] , WEAPON_PROFILE_IRON_LIZARD) then
            return
        endif
        call SetUnitAnimation(s__SpellIndex_source[dex], "attack")
        call LoadoutIronLizard__LaunchIronLizard(s__SpellIndex_source[dex] , s__SpellIndex_user[dex] , LoadoutIronLizard__castAngle[dex])
    endfunction

    function LoadoutIronLizard__OnCastTick takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local real step= LoadoutIronLizard__GetSafeFireInterval()
        if s__SpellIndex_time[dex] <= 0. or GetUnitTypeId(s__SpellIndex_source[dex]) == 0 or not UnitAlive(s__SpellIndex_source[dex]) then
            call LoadoutIronLizard__CleanupCast(dex)
            set t=null
            return
        endif
        call LoadoutIronLizard__FireCastShot(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step
        if s__SpellIndex_time[dex] <= 0. then
            call LoadoutIronLizard__CleanupCast(dex)
        else
            call TimerStart(s__SpellIndex_clock[dex], step, false, function LoadoutIronLizard__OnCastTick)
        endif
        set t=null
    endfunction

    function LoadoutIronLizardFire takes unit source,player owner,real tx,real ty returns boolean
        local integer id= GetHandleId(source)
        local real duration= WeaponProfileGetCastDuration(WEAPON_PROFILE_IRON_LIZARD)
        local real step= LoadoutIronLizard__GetSafeFireInterval()
        local integer dex
        local real x= GetUnitX(source)
        local real y= GetUnitY(source)

        if (HaveSavedInteger(Table__ht, (LoadoutIronLizard__active), (id))) then // INLINED!!
            set dex=(LoadInteger(Table__ht, (LoadoutIronLizard__active), (id))) // INLINED!!
            if ( GetUnitTypeId(s__SpellIndex_source[dex]) != 0 ) and UnitAlive(s__SpellIndex_source[dex]) then
                set LoadoutIronLizard__castAngle[dex]=Atan2(ty - y, tx - x)
                set LoadoutIronLizard__castTargetX[dex]=tx
                set LoadoutIronLizard__castTargetY[dex]=ty
                set s__SpellIndex_time[dex]=duration
                call SetUnitAnimation(s__SpellIndex_source[dex], "attack")
                return true
            endif
            call LoadoutIronLizard__CleanupCast(dex)
        endif

        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_user[dex]=owner
        set s__SpellIndex_time[dex]=duration
        set s__SpellIndex_phase[dex]=1
        set LoadoutIronLizard__castAngle[dex]=Atan2(ty - y, tx - x)
        set LoadoutIronLizard__castTargetX[dex]=tx
        set LoadoutIronLizard__castTargetY[dex]=ty
        set s__SpellIndex_clock[dex]=null
        call SaveInteger(Table__ht, (LoadoutIronLizard__active), (id), ( dex)) // INLINED!!

        call LoadoutIronLizard__FireCastShot(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step
        if s__SpellIndex_time[dex] > 0. then
            set s__SpellIndex_clock[dex]=NewTimerEx(dex)
            call SetTimerDebugTag(s__SpellIndex_clock[dex] , TIMER_DEBUG_TAG_LOADOUT_MISSILE)
            call TimerStart(s__SpellIndex_clock[dex], step, false, function LoadoutIronLizard__OnCastTick)
        else
            call LoadoutIronLizard__CleanupCast(dex)
        endif

        return true
    endfunction

    function LoadoutIronLizard__OnEffect takes nothing returns nothing
        local unit source= GetTriggerUnit()
        local player owner= GetTriggerPlayer()
        call LoadoutIronLizardFire(source , owner , GetSpellTargetX() , GetSpellTargetY())
        set source=null
        set owner=null
    endfunction

    function LoadoutIronLizard__Init takes nothing returns nothing
        set LoadoutIronLizard__active=s__Table_create()
        call RegisterSpellEffectEvent(WeaponProfileGetFireAbility(WEAPON_PROFILE_IRON_LIZARD) , function LoadoutIronLizard__OnEffect)
    endfunction




    function LoadoutMetalSlugSpecial___MinReal takes real a,real b returns real
        if a < b then
            return a
        endif
        return b
    endfunction

    function LoadoutMetalSlugSpecial___GetSafeFireInterval takes integer profileId returns real
        local real duration= WeaponProfileGetCastDuration(profileId)
        local integer count= WeaponProfileGetCastCount(profileId)
        if duration <= 0. then
            return 0.03125
        endif
        if count <= 0 then
            return duration
        endif
        return duration / I2R(count)
    endfunction

    function LoadoutMetalSlugSpecial___FilterUnits takes unit target,player owner returns boolean
        return UnitAlive(target) and IsUnitEnemy(target, owner) and not IsUnitType(target, UNIT_TYPE_STRUCTURE)
    endfunction

    function LoadoutMetalSlugSpecial___DamageUnit takes unit source,unit target,real amount returns boolean
        if amount <= 0. then
            return false
        endif
        if ( GetUnitTypeId(source) == 0 ) or ( GetUnitTypeId(target) == 0 ) then
            return false
        endif
        call WaveRecordDamageCredit(source , target)
        return UnitDamageTarget(source, target, amount, false, false, LoadoutMetalSlugSpecial___ATTACK_TYPE, LoadoutMetalSlugSpecial___DAMAGE_TYPE, null)
    endfunction

    function LoadoutMetalSlugSpecial___DamageArea takes unit source,player owner,real x,real y,real radius,real amount returns nothing
        local unit u
        if amount <= 0. or radius <= 0. or GetUnitTypeId(source) == 0 then
            return
        endif
        call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, x, y, radius, null)
        loop
            set u=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
            exitwhen u == null
            call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, u)
            if LoadoutMetalSlugSpecial___FilterUnits(u , owner) then
                call LoadoutMetalSlugSpecial___DamageUnit(source , u , amount)
            endif
        endloop
        set u=null
    endfunction

    function LoadoutMetalSlugSpecial___ImpactFx takes integer profileId,real x,real y returns nothing
        local effect fx
        if profileId == WEAPON_PROFILE_DROP_SHOT then
            set fx=AddSpecialEffect(WeaponProfileGetMissileModel(profileId), x, y)
            call DestroyEffect(fx)
            set fx=null
        endif
    endfunction

    function LoadoutMetalSlugSpecial___ConfigureDropBounceSegment takes integer missile returns nothing
        local real remaining= LoadoutMetalSlugSpecial___missileMaxRange[missile] - LoadoutMetalSlugSpecial___missileTravel[missile]
        local real segment= LoadoutMetalSlugSpecial___MinReal(LoadoutMetalSlugSpecial___missileSpeed[missile] * LoadoutMetalSlugSpecial___DROP_BOUNCE_INTERVAL , remaining)
        if segment < 1.00 then
            set segment=1.00
        endif
        set LoadoutMetalSlugSpecial___missileSegmentRange[missile]=segment
        call s__MissilePosition_move(s__Missile_impact[missile],s__Missile_x[missile] + segment * Cos(s__Missile_angle[missile]) , s__Missile_y[missile] + segment * Sin(s__Missile_angle[missile]) , LoadoutMetalSlugSpecial___MISSILE_GROUND_Z)
        call s__Missile_bounce(missile)
        call s__Missile__set_arc(missile,LoadoutMetalSlugSpecial___DROP_BOUNCE_ARC)
        set s__Missile_recycle[missile]=false
    endfunction

        function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onCollide takes integer missile,unit hit returns boolean
            local integer profileId= LoadoutMetalSlugSpecial___missileProfile[missile]
            if profileId == WEAPON_PROFILE_ROCKET_LAUNCHER or profileId == WEAPON_PROFILE_SUPER_GRENADE then
                if not LoadoutMetalSlugSpecial___FilterUnits(hit , LoadoutMetalSlugSpecial___missileOwner[missile]) then
                    return false
                endif
                call LoadoutMetalSlugSpecial___DamageArea(LoadoutMetalSlugSpecial___missileSource[missile] , LoadoutMetalSlugSpecial___missileOwner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , LoadoutMetalSlugSpecial___missileArea[missile] , LoadoutMetalSlugSpecial___missileDamage[missile])
                return true
            endif
            return false
        endfunction

        function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onFinish takes integer missile returns boolean
            local integer profileId= LoadoutMetalSlugSpecial___missileProfile[missile]
            if profileId == WEAPON_PROFILE_DROP_SHOT then
                set LoadoutMetalSlugSpecial___missileTravel[missile]=LoadoutMetalSlugSpecial___missileTravel[missile] + LoadoutMetalSlugSpecial___missileSegmentRange[missile]
                call LoadoutMetalSlugSpecial___DamageArea(LoadoutMetalSlugSpecial___missileSource[missile] , LoadoutMetalSlugSpecial___missileOwner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , LoadoutMetalSlugSpecial___missileArea[missile] , LoadoutMetalSlugSpecial___missileDamage[missile])
                call LoadoutMetalSlugSpecial___ImpactFx(profileId , s__Missile_x[missile] , s__Missile_y[missile])
                if LoadoutMetalSlugSpecial___missileTravel[missile] >= LoadoutMetalSlugSpecial___missileMaxRange[missile] then
                    return true
                endif
                call s__Missile_flushHitWidgets(missile)
                call LoadoutMetalSlugSpecial___ConfigureDropBounceSegment(missile)
                return false
            endif
            if profileId == WEAPON_PROFILE_GRENADE or profileId == WEAPON_PROFILE_SUPER_GRENADE or profileId == WEAPON_PROFILE_ROCKET_LAUNCHER then
                call LoadoutMetalSlugSpecial___DamageArea(LoadoutMetalSlugSpecial___missileSource[missile] , LoadoutMetalSlugSpecial___missileOwner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , LoadoutMetalSlugSpecial___missileArea[missile] , LoadoutMetalSlugSpecial___missileDamage[missile])
            endif
            return true
        endfunction

        function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onDestructable takes integer missile,destructable hit returns boolean
            if LoadoutMetalSlugSpecial___missileProfile[missile] == WEAPON_PROFILE_GRENADE then
                return false
            endif
            call LoadoutMetalSlugSpecial___DamageArea(LoadoutMetalSlugSpecial___missileSource[missile] , LoadoutMetalSlugSpecial___missileOwner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , LoadoutMetalSlugSpecial___missileArea[missile] , LoadoutMetalSlugSpecial___missileDamage[missile])
            return true
        endfunction

        function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onTerrain takes integer missile returns boolean
            if LoadoutMetalSlugSpecial___missileProfile[missile] == WEAPON_PROFILE_GRENADE or LoadoutMetalSlugSpecial___missileProfile[missile] == WEAPON_PROFILE_DROP_SHOT then
                return false
            endif
            call LoadoutMetalSlugSpecial___DamageArea(LoadoutMetalSlugSpecial___missileSource[missile] , LoadoutMetalSlugSpecial___missileOwner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , LoadoutMetalSlugSpecial___missileArea[missile] , LoadoutMetalSlugSpecial___missileDamage[missile])
            return true
        endfunction

        function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onPeriod takes integer missile returns boolean
            local integer profileId= LoadoutMetalSlugSpecial___missileProfile[missile]
            local real accel
            if profileId == WEAPON_PROFILE_SHOTGUN or profileId == WEAPON_PROFILE_FLAME_SHOT then
                set LoadoutMetalSlugSpecial___missilePulseRemaining[missile]=LoadoutMetalSlugSpecial___missilePulseRemaining[missile] - Missile_TIMER_TIMEOUT
                if LoadoutMetalSlugSpecial___missilePulseRemaining[missile] <= 0. then
                    call LoadoutMetalSlugSpecial___DamageArea(LoadoutMetalSlugSpecial___missileSource[missile] , LoadoutMetalSlugSpecial___missileOwner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , LoadoutMetalSlugSpecial___missileArea[missile] , LoadoutMetalSlugSpecial___missileDamage[missile])
                    if profileId == WEAPON_PROFILE_FLAME_SHOT then
                        set LoadoutMetalSlugSpecial___missilePulseRemaining[missile]=LoadoutMetalSlugSpecial___FLAME_PULSE_INTERVAL
                    else
                        set LoadoutMetalSlugSpecial___missilePulseRemaining[missile]=LoadoutMetalSlugSpecial___PIERCING_PULSE_INTERVAL
                    endif
                endif
                set accel=WeaponProfileGetAcceleration(profileId)
                if accel > 0. then
                    set LoadoutMetalSlugSpecial___missileSpeed[missile]=LoadoutMetalSlugSpecial___missileSpeed[missile] + accel
                    set s__Missile_speed[(missile)]=((LoadoutMetalSlugSpecial___missileSpeed[missile])*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
                endif
            endif
            return false
        endfunction

        function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onRemove takes integer missile returns boolean
            set LoadoutMetalSlugSpecial___missileProfile[missile]=WEAPON_PROFILE_NONE
            set LoadoutMetalSlugSpecial___missileDamage[missile]=0.00
            set LoadoutMetalSlugSpecial___missileArea[missile]=0.00
            set LoadoutMetalSlugSpecial___missilePulseRemaining[missile]=0.00
            set LoadoutMetalSlugSpecial___missileSpeed[missile]=0.00
            set LoadoutMetalSlugSpecial___missileTravel[missile]=0.00
            set LoadoutMetalSlugSpecial___missileMaxRange[missile]=0.00
            set LoadoutMetalSlugSpecial___missileSegmentRange[missile]=0.00
            set LoadoutMetalSlugSpecial___missileSource[missile]=null
            set LoadoutMetalSlugSpecial___missileOwner[missile]=null
            call s__SpellIndex_destroy((s__Missile_data[missile]))
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__LoadoutMetalSlugSpecial___MetalSlugSpecialCore],missile)
            call Missile___StartPeriodic(si__LoadoutMetalSlugSpecial___MetalSlugSpecialCore)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__LoadoutMetalSlugSpecial___MetalSlugSpecialCore)
            endif
        endfunction
























        

