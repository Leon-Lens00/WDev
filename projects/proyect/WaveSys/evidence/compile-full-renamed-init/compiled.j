        return WavePriestSkills_WAVE_HMPR_AURA_VISUAL_MODEL
    endfunction

    function WavePriestSkills___WavePriestAdd takes integer auraId returns nothing
        set WavePriestSkills___WavePriestPrev[auraId]=0
        set WavePriestSkills___WavePriestNext[auraId]=WavePriestSkills___WavePriestHead
        if WavePriestSkills___WavePriestHead != 0 then
            set WavePriestSkills___WavePriestPrev[WavePriestSkills___WavePriestHead]=auraId
        endif
        set WavePriestSkills___WavePriestHead=auraId
    endfunction

    function WavePriestSkills___WavePriestRemove takes integer auraId returns nothing
        local integer p= WavePriestSkills___WavePriestPrev[auraId]
        local integer n= WavePriestSkills___WavePriestNext[auraId]
        if p != 0 then
            set WavePriestSkills___WavePriestNext[p]=n
        else
            set WavePriestSkills___WavePriestHead=n
        endif
        if n != 0 then
            set WavePriestSkills___WavePriestPrev[n]=p
        endif
        set WavePriestSkills___WavePriestPrev[auraId]=0
        set WavePriestSkills___WavePriestNext[auraId]=0
    endfunction

    function WavePriestSkills___WavePriestFindMemberIndex takes integer auraId,unit target returns integer
        local integer idx= 1
        loop
            exitwhen idx > WavePriestSkills___WavePriestMemberCount[auraId]
            if (LoadUnitHandle(Table__ht, (((WavePriestSkills___WavePriestMemberUnitByKey))), (((auraId ) * WavePriestSkills___WAVE_HMPR_MEMBER_STRIDE + ( idx))))) == target then // INLINED!!
                return idx
            endif
            set idx=idx + 1
        endloop
        return 0
    endfunction

    function WavePriestSkills___WavePriestAddMember takes integer auraId,unit target returns nothing
        local integer count
        local integer key
        if target == null or GetUnitTypeId(target) == 0 then
            return
        endif
        if WavePriestSkills___WavePriestFindMemberIndex(auraId , target) != 0 then
            call WavePriestSkills___WavePriestDebugTargetState("ADD_SKIP_EXISTS" , auraId , WavePriestSkills___WavePriestAuraType[auraId] , target)
            return
        endif
        set count=WavePriestSkills___WavePriestMemberCount[auraId] + 1
        set WavePriestSkills___WavePriestMemberCount[auraId]=count
        set key=((auraId ) * WavePriestSkills___WAVE_HMPR_MEMBER_STRIDE + ( count)) // INLINED!!
        call SaveUnitHandle(Table__ht, (((WavePriestSkills___WavePriestMemberUnitByKey))), (key), ( target)) // INLINED!!
        call SaveInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (key), ( GetHandleId(target))) // INLINED!!
        call WavePriestSkills___WavePriestDebugMsg("MEMBER_PUSH aura=" + I2S(auraId) + " type=" + WavePriestSkills___WavePriestAuraTypeName(WavePriestSkills___WavePriestAuraType[auraId]) + " count=" + I2S(WavePriestSkills___WavePriestMemberCount[auraId]) + " target=" + GetUnitName(target))
        if not WavePriestSkills___WavePriestApplyAuraEffect(auraId , WavePriestSkills___WavePriestAuraType[auraId] , target) then
            call RemoveSavedInteger(Table__ht, (WavePriestSkills___WavePriestMemberUnitByKey), (key)) // INLINED!!
            if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (key))) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (key)) // INLINED!!
            endif
            set WavePriestSkills___WavePriestMemberCount[auraId]=count - 1
            call WavePriestSkills___WavePriestDebugMsg("MEMBER_POP_ROLLBACK aura=" + I2S(auraId) + " type=" + WavePriestSkills___WavePriestAuraTypeName(WavePriestSkills___WavePriestAuraType[auraId]) + " count=" + I2S(WavePriestSkills___WavePriestMemberCount[auraId]) + " target=" + GetUnitName(target))
            call WavePriestSkills___WavePriestDebugTargetState("ADD_ROLLBACK" , auraId , WavePriestSkills___WavePriestAuraType[auraId] , target)
        else
            call WavePriestSkills___WavePriestDebugTargetState("ADD_OK" , auraId , WavePriestSkills___WavePriestAuraType[auraId] , target)
        endif
    endfunction

    function WavePriestSkills___WavePriestRemoveMemberAt takes integer auraId,integer index returns nothing
        local integer count= WavePriestSkills___WavePriestMemberCount[auraId]
        local integer key= ((auraId ) * WavePriestSkills___WAVE_HMPR_MEMBER_STRIDE + ( index)) // INLINED!!
        local integer lastKey= ((auraId ) * WavePriestSkills___WAVE_HMPR_MEMBER_STRIDE + ( count)) // INLINED!!
        local unit target= (LoadUnitHandle(Table__ht, (((WavePriestSkills___WavePriestMemberUnitByKey))), (key))) // INLINED!!
        local unit moved= null
        if index <= 0 or index > count then
            set target=null
            return
        endif
        if target != null and GetUnitTypeId(target) != 0 then
            call WavePriestSkills___WavePriestDebugTargetState("REMOVE_MEMBER" , auraId , WavePriestSkills___WavePriestAuraType[auraId] , target)
            call WavePriestSkills___WavePriestRemoveAuraEffect(auraId , WavePriestSkills___WavePriestAuraType[auraId] , target)
        endif
        if index != count then
            set moved=(LoadUnitHandle(Table__ht, (((WavePriestSkills___WavePriestMemberUnitByKey))), (lastKey))) // INLINED!!
            call SaveUnitHandle(Table__ht, (((WavePriestSkills___WavePriestMemberUnitByKey))), (key), ( moved)) // INLINED!!
            if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (lastKey))) then // INLINED!!
                call SaveInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (key), ( (LoadInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (lastKey))))) // INLINED!!
            elseif (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (key))) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (key)) // INLINED!!
            endif
        endif
        call RemoveSavedInteger(Table__ht, (WavePriestSkills___WavePriestMemberUnitByKey), (lastKey)) // INLINED!!
        if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (lastKey))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WavePriestSkills___WavePriestMemberHidByKey), (lastKey)) // INLINED!!
        endif
        set WavePriestSkills___WavePriestMemberCount[auraId]=count - 1
        call WavePriestSkills___WavePriestDebugMsg("MEMBER_POP aura=" + I2S(auraId) + " type=" + WavePriestSkills___WavePriestAuraTypeName(WavePriestSkills___WavePriestAuraType[auraId]) + " count=" + I2S(WavePriestSkills___WavePriestMemberCount[auraId]))
        set moved=null
        set target=null
    endfunction

    function WavePriestSkills___WavePriestRemoveAllMembers takes integer auraId returns nothing
        loop
            exitwhen WavePriestSkills___WavePriestMemberCount[auraId] <= 0
            call WavePriestSkills___WavePriestRemoveMemberAt(auraId , WavePriestSkills___WavePriestMemberCount[auraId])
        endloop
    endfunction

    function WavePriestSkills___WavePriestDestroyAura takes integer auraId returns nothing
        local unit source= WavePriestSkills___WavePriestSource[auraId]
        local integer hid= 0
        if auraId <= 0 then
            return
        endif
        call WavePriestSkills___WavePriestDebugMsg("DESTROY_AURA aura=" + I2S(auraId) + " type=" + WavePriestSkills___WavePriestAuraTypeName(WavePriestSkills___WavePriestAuraType[auraId]) + " members=" + I2S(WavePriestSkills___WavePriestMemberCount[auraId]))
        if source != null and GetUnitTypeId(source) != 0 then
            set hid=GetHandleId(source)
        endif
        call WavePriestSkills___WavePriestRemove(auraId)
        call WavePriestSkills___WavePriestRemoveAllMembers(auraId)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestActiveAuraByUnit), (hid))) and (LoadInteger(Table__ht, (WavePriestSkills___WavePriestActiveAuraByUnit), (hid))) == auraId then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WavePriestSkills___WavePriestActiveAuraByUnit), (hid)) // INLINED!!
        endif
        if WavePriestSkills___WavePriestVisualId[auraId] != 0 then
            call WaveSkillVisualDestroy(WavePriestSkills___WavePriestVisualId[auraId])
            set WavePriestSkills___WavePriestVisualId[auraId]=0
        endif
        set WavePriestSkills___WavePriestAuraType[auraId]=0
        set WavePriestSkills___WavePriestMemberCount[auraId]=0
        set WavePriestSkills___WavePriestSource[auraId]=null
        set WavePriestSkills___WavePriestRadius[auraId]=0.0
        set WavePriestSkills___WavePriestRemaining[auraId]=0.0
        if WavePriestSkills___WAVE_HMPR_DEBUG and WavePriestSkills___WavePriestHead == 0 and WavePriestSkills___WavePriestDebugFile != 0 then
            call s__File_close(WavePriestSkills___WavePriestDebugFile)
            set WavePriestSkills___WavePriestDebugFile=0
            set WavePriestSkills___WavePriestDebugFileSegment=WavePriestSkills___WavePriestDebugFileSegment + 1
            set WavePriestSkills___WavePriestDebugFileLineCount=0
        endif
    endfunction

    function WavePriestSkills___WavePriestProcessAura takes integer auraId returns nothing
        local unit source= WavePriestSkills___WavePriestSource[auraId]
        local unit target
        local integer idx
        call WavePriestSkills___WavePriestDebugMsg("TICK aura=" + I2S(auraId) + " type=" + WavePriestSkills___WavePriestAuraTypeName(WavePriestSkills___WavePriestAuraType[auraId]) + " members=" + I2S(WavePriestSkills___WavePriestMemberCount[auraId]) + " remaining=" + R2S(WavePriestSkills___WavePriestRemaining[auraId]))
        if not WavePriestSkills___WavePriestUnitAlive(source) then
            call WavePriestSkills___WavePriestDebugMsg("TICK_DESTROY_DEAD aura=" + I2S(auraId))
            call WavePriestSkills___WavePriestDestroyAura(auraId)
            return
        endif

        set WavePriestSkills___WavePriestRemaining[auraId]=WavePriestSkills___WavePriestRemaining[auraId] - WavePriestSkills___WAVE_HMPR_TICK
        if WavePriestSkills___WavePriestRemaining[auraId] <= 0.0 then
            call WavePriestSkills___WavePriestDebugMsg("TICK_DESTROY_TIMEOUT aura=" + I2S(auraId))
            call WavePriestSkills___WavePriestDestroyAura(auraId)
            return
        endif

        call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, GetUnitX(source), GetUnitY(source), WavePriestSkills___WavePriestRadius[auraId], null)
        loop
            set target=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
            exitwhen target == null
            call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, target)
            if WavePriestSkills___WavePriestTargetIsValid(source , target) then
                call WavePriestSkills___WavePriestAddMember(auraId , target)
            endif
        endloop

        set idx=WavePriestSkills___WavePriestMemberCount[auraId]
        loop
            exitwhen idx <= 0
            set target=(LoadUnitHandle(Table__ht, (((WavePriestSkills___WavePriestMemberUnitByKey))), (((auraId ) * WavePriestSkills___WAVE_HMPR_MEMBER_STRIDE + ( idx))))) // INLINED!!
            if target == null or GetUnitTypeId(target) == 0 then
                call WavePriestSkills___WavePriestDebugMsg("REMOVE_CAUSE_NULL aura=" + I2S(auraId) + " idx=" + I2S(idx))
                call WavePriestSkills___WavePriestRemoveMemberAt(auraId , idx)
            else
                if not WavePriestSkills___WavePriestTargetInAuraRange(source , target , WavePriestSkills___WavePriestRadius[auraId]) then
                    call WavePriestSkills___WavePriestDebugMsg("REMOVE_CAUSE_RANGE aura=" + I2S(auraId) + " idx=" + I2S(idx) + " target=" + GetUnitName(target))
                    call WavePriestSkills___WavePriestRemoveMemberAt(auraId , idx)
                endif
            endif
            set idx=idx - 1
        endloop

        set target=null
        set source=null
    endfunction

    function WavePriestSkills___WavePriestOnTick takes nothing returns nothing
        local integer auraId= WavePriestSkills___WavePriestHead
        local integer nextAuraId
        loop
            exitwhen auraId == 0
            set nextAuraId=WavePriestSkills___WavePriestNext[auraId]
            call WavePriestSkills___WavePriestProcessAura(auraId)
            set auraId=nextAuraId
        endloop
        if WavePriestSkills___WavePriestHead == 0 and WavePriestSkills___WavePriestTimerRunning then
            call PauseTimer(WavePriestSkills___WavePriestTimer)
            set WavePriestSkills___WavePriestTimerRunning=false
        endif
    endfunction

    function WavePriestSkills___WavePriestEnsureTimer takes nothing returns nothing
        if not WavePriestSkills___WavePriestTimerRunning then
            set WavePriestSkills___WavePriestTimerRunning=true
            call TimerStart(WavePriestSkills___WavePriestTimer, WavePriestSkills___WAVE_HMPR_TICK, true, function WavePriestSkills___WavePriestOnTick)
        endif
    endfunction

    function WavePriestSkills___WavePriestStartAura takes unit source,integer auraType returns nothing
        local integer auraId= WavePriestSkills___WavePriestCount + 1
        local integer hid= GetHandleId(source)
        set WavePriestSkills___WavePriestCount=auraId
        set WavePriestSkills___WavePriestAuraType[auraId]=auraType
        set WavePriestSkills___WavePriestMemberCount[auraId]=0
        set WavePriestSkills___WavePriestSource[auraId]=source
        if auraType == WavePriestSkills___WAVE_HMPR_AURA_TYPE_BOSS then
            set WavePriestSkills___WavePriestRadius[auraId]=WavePriestSkills_WAVE_HMPR_BOSS_AURA_RADIUS
            set WavePriestSkills___WavePriestRemaining[auraId]=WavePriestSkills_WAVE_HMPR_BOSS_AURA_DURATION
        else
            set WavePriestSkills___WavePriestRadius[auraId]=WavePriestSkills_WAVE_HMPR_AURA_RADIUS
            set WavePriestSkills___WavePriestRemaining[auraId]=WavePriestSkills_WAVE_HMPR_AURA_DURATION
        endif
        set WavePriestSkills___WavePriestVisualId[auraId]=WaveSkillVisualCreateFollowerScaled(source , WavePriestSkills___WavePriestVisualModelForType(auraType) , WaveSkillVisualShieldScaleForRadius(WavePriestSkills___WavePriestRadius[auraId]))
        call WavePriestSkills___WavePriestAdd(auraId)
        call SaveInteger(Table__ht, (WavePriestSkills___WavePriestActiveAuraByUnit), (hid), ( auraId)) // INLINED!!
        call IssueImmediateOrder(source, "stop")
        call SetUnitAnimation(source, "spell")
        call WavePriestSkills___WavePriestEnsureTimer()
        call WavePriestSkills___WavePriestDebugMsg("START_AURA aura=" + I2S(auraId) + " type=" + WavePriestSkills___WavePriestAuraTypeName(auraType) + " source=" + GetUnitName(source))
    endfunction

    function WavePriestSkills___WavePriestCleanupWaveDeath takes nothing returns nothing
        local unit deadUnit= (WaveEventUnit) // INLINED!!
        local integer hid
        local integer auraId
        local integer unitTypeId
        if deadUnit == null or GetUnitTypeId(deadUnit) == 0 then
            return
        endif
        set unitTypeId=GetUnitTypeId(deadUnit)
        if unitTypeId != WavePriestSkills_WAVE_HMPR_UNIT_ID and unitTypeId != WavePriestSkills_WAVE_HMPR_BOSS_UNIT_ID then
            return
        endif
        set hid=GetHandleId(deadUnit)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestNextCastMs), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WavePriestSkills___WavePriestNextCastMs), (hid)) // INLINED!!
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestActiveAuraByUnit), (hid))) then // INLINED!!
            set auraId=(LoadInteger(Table__ht, (WavePriestSkills___WavePriestActiveAuraByUnit), (hid))) // INLINED!!
            call WavePriestSkills___WavePriestDestroyAura(auraId)
        endif
    endfunction

    function WavePriestSkillsTryExecute takes unit source,unit target,integer nowMs returns boolean
        local integer hid
        local integer nextMs
        local integer auraType= 0
        if not WavePriestSkills___WavePriestUnitAlive(source) then
            return false
        endif
        if WavePriestSkills___WavePriestIsBoss(source) then
            set auraType=WavePriestSkills___WAVE_HMPR_AURA_TYPE_BOSS
        elseif WavePriestSkills___WavePriestIsNormal(source) then
            set auraType=WavePriestSkills___WAVE_HMPR_AURA_TYPE_NORMAL
        else
            return false
        endif
        if target == null or GetUnitTypeId(target) == 0 or not UnitAlive(target) or not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif

        set hid=GetHandleId(source)
        if hid == 0 then
            return false
        endif
        if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestActiveAuraByUnit), (hid))) and (LoadInteger(Table__ht, (WavePriestSkills___WavePriestActiveAuraByUnit), (hid))) != 0 then // INLINED!!
            return true
        endif
        if not (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestNextCastMs), (hid))) then // INLINED!!
            if auraType == WavePriestSkills___WAVE_HMPR_AURA_TYPE_BOSS then
                call SaveInteger(Table__ht, (WavePriestSkills___WavePriestNextCastMs), (hid), ( nowMs + WavePriestSkills___WavePriestRandomMsRange(WavePriestSkills_WAVE_HMPR_BOSS_INITIAL_DELAY_MIN , WavePriestSkills_WAVE_HMPR_BOSS_INITIAL_DELAY_MAX))) // INLINED!!
            else
                call SaveInteger(Table__ht, (WavePriestSkills___WavePriestNextCastMs), (hid), ( nowMs + WavePriestSkills___WavePriestRandomMsRange(WavePriestSkills_WAVE_HMPR_INITIAL_DELAY_MIN , WavePriestSkills_WAVE_HMPR_INITIAL_DELAY_MAX))) // INLINED!!
            endif
            return false
        endif

        set nextMs=(LoadInteger(Table__ht, (WavePriestSkills___WavePriestNextCastMs), (hid))) // INLINED!!
        if nowMs < nextMs then
            return false
        endif

        call WavePriestSkills___WavePriestStartAura(source , auraType)
        if auraType == WavePriestSkills___WAVE_HMPR_AURA_TYPE_BOSS then
            call SaveInteger(Table__ht, (WavePriestSkills___WavePriestNextCastMs), (hid), ( nowMs + WavePriestSkills___WavePriestRandomMsRange(WavePriestSkills_WAVE_HMPR_BOSS_COOLDOWN_MIN , WavePriestSkills_WAVE_HMPR_BOSS_COOLDOWN_MAX))) // INLINED!!
        else
            call SaveInteger(Table__ht, (WavePriestSkills___WavePriestNextCastMs), (hid), ( nowMs + WavePriestSkills___WavePriestRandomMsRange(WavePriestSkills_WAVE_HMPR_COOLDOWN_MIN , WavePriestSkills_WAVE_HMPR_COOLDOWN_MAX))) // INLINED!!
        endif
        return true
    endfunction

    function WavePriestSkills___Init takes nothing returns nothing
        set WavePriestSkills___WavePriestNextCastMs=s__Table_create()
        set WavePriestSkills___WavePriestActiveAuraByUnit=s__Table_create()
        set WavePriestSkills___WavePriestBaseScaleByUnit=s__Table_create()
        set WavePriestSkills___WavePriestNormalOwnerAuraByUnit=s__Table_create()
        set WavePriestSkills___WavePriestBossOwnerAuraByUnit=s__Table_create()
        set WavePriestSkills___WavePriestMemberUnitByKey=s__Table_create()
        set WavePriestSkills___WavePriestMemberHidByKey=s__Table_create()
        set WavePriestSkills___WavePriestTimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(WavePriestSkills___WavePriestTimer , TIMER_DEBUG_TAG_UNIT_SKILLS)
        call RegisterWaveDeathEvent(function WavePriestSkills___WavePriestCleanupWaveDeath)
    endfunction



    function WaveRangedSkills___WaveRangedBossLightningIndex takes integer castId,integer playerId returns integer
        return castId * bj_MAX_PLAYER_SLOTS + playerId
    endfunction

    function WaveRangedSkills___WaveRangedSecToMs takes real sec returns integer
        if sec <= 0.0 then
            return 0
        endif
        return R2I(sec * 1000.0 + 0.5)
    endfunction

    function WaveRangedSkills___WaveRangedRandomMsRange takes real minSec,real maxSec returns integer
        local real lo= minSec
        local real hi= maxSec
        if hi < lo then
            set lo=maxSec
            set hi=minSec
        endif
        if hi <= 0.0 then
            return 0
        endif
        if lo < 0.0 then
            set lo=0.0
        endif
        return WaveRangedSkills___WaveRangedSecToMs(GetRandomReal(lo, hi))
    endfunction

    function WaveRangedSkills___WaveRangedUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WaveRangedSkills___WaveRangedIsEnemyHeroOfSource takes unit source,unit target returns boolean
        if not WaveRangedSkills___WaveRangedUnitAlive(source) or not WaveRangedSkills___WaveRangedUnitAlive(target) then
            return false
        endif
        if not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif
        return IsUnitEnemy(target, GetOwningPlayer(source))
    endfunction

    function WaveRangedSkills___WaveRangedIsHrifBase takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WaveRangedSkills_WAVE_HRIF_UNIT_ID
    endfunction

    function WaveRangedSkills___WaveRangedIsHrifBoss takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WaveRangedSkills_WAVE_HRIF_BOSS_UNIT_ID
    endfunction

    function WaveRangedSkills___WaveRangedCastAdd takes integer castId returns nothing
        set WaveRangedSkills___WaveRangedCastPrev[castId]=0
        set WaveRangedSkills___WaveRangedCastNext[castId]=WaveRangedSkills___WaveRangedCastHead
        if WaveRangedSkills___WaveRangedCastHead != 0 then
            set WaveRangedSkills___WaveRangedCastPrev[WaveRangedSkills___WaveRangedCastHead]=castId
        endif
        set WaveRangedSkills___WaveRangedCastHead=castId
    endfunction

    function WaveRangedSkills___WaveRangedCastRemove takes integer castId returns nothing
        local integer p= WaveRangedSkills___WaveRangedCastPrev[castId]
        local integer n= WaveRangedSkills___WaveRangedCastNext[castId]
        if p != 0 then
            set WaveRangedSkills___WaveRangedCastNext[p]=n
        else
            set WaveRangedSkills___WaveRangedCastHead=n
        endif
        if n != 0 then
            set WaveRangedSkills___WaveRangedCastPrev[n]=p
        endif
        set WaveRangedSkills___WaveRangedCastPrev[castId]=0
        set WaveRangedSkills___WaveRangedCastNext[castId]=0
    endfunction

    function WaveRangedSkills___WaveRangedDestroyBossLightnings takes integer castId returns nothing
        local integer playerId= 0
        local integer lightningIndex
        loop
            exitwhen playerId >= bj_MAX_PLAYER_SLOTS
            set lightningIndex=((castId ) * bj_MAX_PLAYER_SLOTS + ( playerId)) // INLINED!!
            if WaveRangedSkills___WaveRangedBossLightningByIndex[lightningIndex] != null then
                call DestroyLightning(WaveRangedSkills___WaveRangedBossLightningByIndex[lightningIndex])
                set WaveRangedSkills___WaveRangedBossLightningByIndex[lightningIndex]=null
            endif
            set playerId=playerId + 1
        endloop
    endfunction

    function WaveRangedSkills___WaveRangedCastDestroy takes integer castId returns nothing
        local unit source= WaveRangedSkills___WaveRangedCastSource[castId]
        local integer hid= 0
        if source != null and GetUnitTypeId(source) != 0 then
            set hid=GetHandleId(source)
        endif
        call WaveRangedSkills___WaveRangedCastRemove(castId)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveRangedSkills___WaveRangedActiveCastByUnit), (hid))) and (LoadInteger(Table__ht, (WaveRangedSkills___WaveRangedActiveCastByUnit), (hid))) == castId then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveRangedSkills___WaveRangedActiveCastByUnit), (hid)) // INLINED!!
        endif
        if WaveRangedSkills___WaveRangedCastLightning[castId] != null then
            call DestroyLightning(WaveRangedSkills___WaveRangedCastLightning[castId])
            set WaveRangedSkills___WaveRangedCastLightning[castId]=null
        endif
        call WaveRangedSkills___WaveRangedDestroyBossLightnings(castId)
        if WaveRangedSkills___WaveRangedCastTargetMarker[castId] != 0 then
            call WaveSkillVisualDestroy(WaveRangedSkills___WaveRangedCastTargetMarker[castId])
            set WaveRangedSkills___WaveRangedCastTargetMarker[castId]=0
        endif
        if WaveRangedSkills___WaveRangedCastSourcePaused[castId] and source != null and GetUnitTypeId(source) != 0 then
            call PauseUnit(source, false)
        endif
        set WaveRangedSkills___WaveRangedCastMode[castId]=0
        set WaveRangedSkills___WaveRangedCastPhase[castId]=0
        set WaveRangedSkills___WaveRangedCastVolleyRemaining[castId]=0
        set WaveRangedSkills___WaveRangedCastVolleyAccumulator[castId]=0.0
        set WaveRangedSkills___WaveRangedCastSource[castId]=null
        set WaveRangedSkills___WaveRangedCastTarget[castId]=null
        set WaveRangedSkills___WaveRangedCastTargetX[castId]=0.0
        set WaveRangedSkills___WaveRangedCastTargetY[castId]=0.0
        set WaveRangedSkills___WaveRangedCastElapsed[castId]=0.0
        set WaveRangedSkills___WaveRangedCastSourcePaused[castId]=false
    endfunction

    function WaveRangedSkills___WaveRangedCreateHrifImpactMarker takes unit source,real tx,real ty returns nothing
        local real dx
        local real dy
        local real duration
        if not WaveRangedSkills___WaveRangedUnitAlive(source) then
            return
        endif
        set dx=tx - GetUnitX(source)
        set dy=ty - GetUnitY(source)
        set duration=SquareRoot(dx * dx + dy * dy) / WAVE_HRIF_PROJECTILE_SPEED
        if duration < 0.10 then
            set duration=0.10
        endif
        call WaveSkillVisualCreateTimedMarker(tx , ty , 0.0 , WaveRangedSkills_WAVE_HRIF_TARGET_MARKER_MODEL , WAVE_HRIF_PROJECTILE_FINISH_AOE , duration)
    endfunction

    function WaveRangedSkills___WaveRangedLaunchHrifProjectilePoint takes unit source,real tx,real ty returns nothing
        if not WaveRangedSkills___WaveRangedUnitAlive(source) then
            return
        endif
        call WaveRangedSkills___WaveRangedCreateHrifImpactMarker(source , tx , ty)
        call WaveProjectileLaunchFromSourceToPointExact(WAVE_PROJECTILE_TYPE_HRIF , source , tx , ty , WAVE_HRIF_PROJECTILE_DAMAGE)
    endfunction

    function WaveRangedSkills___WaveRangedLaunchHrifProjectile takes integer castId returns nothing
        call WaveRangedSkills___WaveRangedLaunchHrifProjectilePoint(WaveRangedSkills___WaveRangedCastSource[castId] , WaveRangedSkills___WaveRangedCastTargetX[castId] , WaveRangedSkills___WaveRangedCastTargetY[castId])
    endfunction

    function WaveRangedSkills___WaveRangedBossCountEnemyHeroes takes unit source returns integer
        local integer playerId= 0
        local integer count= 0
        local unit hero
        loop
            exitwhen playerId >= bj_MAX_PLAYER_SLOTS
            set hero=s__WaveRangedSkills___WaveRangedTrackedHeroByPlayer[playerId]
            if WaveRangedSkills___WaveRangedIsEnemyHeroOfSource(source , hero) then
                set count=count + 1
            endif
            set playerId=playerId + 1
        endloop
        set hero=null
        return count
    endfunction

    function WaveRangedSkills___WaveRangedBossFireVolley takes integer castId returns nothing
        local unit source= WaveRangedSkills___WaveRangedCastSource[castId]
        local unit hero
        local integer playerId= 0
        local boolean fired= false
        if not WaveRangedSkills___WaveRangedUnitAlive(source) then
            set source=null
            return
        endif
        call SetUnitAnimation(source, "attack")
        loop
            exitwhen playerId >= bj_MAX_PLAYER_SLOTS
            set hero=s__WaveRangedSkills___WaveRangedTrackedHeroByPlayer[playerId]
            if WaveRangedSkills___WaveRangedIsEnemyHeroOfSource(source , hero) then
                call WaveRangedSkills___WaveRangedLaunchHrifProjectilePoint(source , GetUnitX(hero) , GetUnitY(hero))
                set fired=true
            endif
            set playerId=playerId + 1
        endloop
        if ( not fired ) and WaveRangedSkills___WaveRangedIsEnemyHeroOfSource(source , WaveRangedSkills___WaveRangedCastTarget[castId]) then
            call WaveRangedSkills___WaveRangedLaunchHrifProjectilePoint(source , GetUnitX(WaveRangedSkills___WaveRangedCastTarget[castId]) , GetUnitY(WaveRangedSkills___WaveRangedCastTarget[castId]))
        endif
        set hero=null
        set source=null
    endfunction

    function WaveRangedSkills___WaveRangedBossCreateTelegraphs takes integer castId returns nothing
        local integer playerId= 0
        local integer lightningIndex
        local unit source= WaveRangedSkills___WaveRangedCastSource[castId]
        local unit hero
        local real sx
        local real sy
        if not WaveRangedSkills___WaveRangedUnitAlive(source) then
            set source=null
            return
        endif
        set sx=GetUnitX(source)
        set sy=GetUnitY(source)
        loop
            exitwhen playerId >= bj_MAX_PLAYER_SLOTS
            set hero=s__WaveRangedSkills___WaveRangedTrackedHeroByPlayer[playerId]
            if WaveRangedSkills___WaveRangedIsEnemyHeroOfSource(source , hero) then
                set lightningIndex=((castId ) * bj_MAX_PLAYER_SLOTS + ( playerId)) // INLINED!!
                set WaveRangedSkills___WaveRangedBossLightningByIndex[lightningIndex]=AddLightningEx(WaveRangedSkills_WAVE_HRIF_TELEGRAPH_LIGHTNING_CODE, true, sx, sy, WaveRangedSkills_WAVE_HRIF_LIGHTNING_SOURCE_Z, GetUnitX(hero), GetUnitY(hero), WaveRangedSkills_WAVE_HRIF_LIGHTNING_TARGET_Z)
            endif
            set playerId=playerId + 1
        endloop
        set hero=null
        set source=null
    endfunction

    function WaveRangedSkills___WaveRangedBossUpdateTelegraphs takes integer castId returns nothing
        local integer playerId= 0
        local integer lightningIndex
        local unit source= WaveRangedSkills___WaveRangedCastSource[castId]
        local unit hero
        local real sx
        local real sy
        if not WaveRangedSkills___WaveRangedUnitAlive(source) then
            set source=null
            return
        endif
        set sx=GetUnitX(source)
        set sy=GetUnitY(source)
        loop
            exitwhen playerId >= bj_MAX_PLAYER_SLOTS
            set lightningIndex=((castId ) * bj_MAX_PLAYER_SLOTS + ( playerId)) // INLINED!!
            set hero=s__WaveRangedSkills___WaveRangedTrackedHeroByPlayer[playerId]
            if WaveRangedSkills___WaveRangedBossLightningByIndex[lightningIndex] != null then
                if WaveRangedSkills___WaveRangedIsEnemyHeroOfSource(source , hero) then
                    call MoveLightningEx(WaveRangedSkills___WaveRangedBossLightningByIndex[lightningIndex], true, sx, sy, WaveRangedSkills_WAVE_HRIF_LIGHTNING_SOURCE_Z, GetUnitX(hero), GetUnitY(hero), WaveRangedSkills_WAVE_HRIF_LIGHTNING_TARGET_Z)
                else
                    call DestroyLightning(WaveRangedSkills___WaveRangedBossLightningByIndex[lightningIndex])
                    set WaveRangedSkills___WaveRangedBossLightningByIndex[lightningIndex]=null
                endif
            elseif WaveRangedSkills___WaveRangedIsEnemyHeroOfSource(source , hero) then
                set WaveRangedSkills___WaveRangedBossLightningByIndex[lightningIndex]=AddLightningEx(WaveRangedSkills_WAVE_HRIF_TELEGRAPH_LIGHTNING_CODE, true, sx, sy, WaveRangedSkills_WAVE_HRIF_LIGHTNING_SOURCE_Z, GetUnitX(hero), GetUnitY(hero), WaveRangedSkills_WAVE_HRIF_LIGHTNING_TARGET_Z)
            endif
            set playerId=playerId + 1
        endloop
        set hero=null
        set source=null
    endfunction

    function WaveRangedSkills___WaveRangedOnTick takes nothing returns nothing
        local integer castId= WaveRangedSkills___WaveRangedCastHead
        local integer nextCastId
        local unit source
        local unit target
        local real sx
        local real sy
        loop
            exitwhen castId == 0
            set nextCastId=WaveRangedSkills___WaveRangedCastNext[castId]
            set source=WaveRangedSkills___WaveRangedCastSource[castId]
            set target=WaveRangedSkills___WaveRangedCastTarget[castId]
            if not WaveRangedSkills___WaveRangedUnitAlive(source) then
                call WaveRangedSkills___WaveRangedCastDestroy(castId)
            elseif WaveRangedSkills___WaveRangedCastMode[castId] == WaveRangedSkills___WAVE_RANGED_MODE_HRIF then
                if WaveRangedSkills___WaveRangedUnitAlive(target) then
                    set WaveRangedSkills___WaveRangedCastTargetX[castId]=GetUnitX(target)
                    set WaveRangedSkills___WaveRangedCastTargetY[castId]=GetUnitY(target)
                endif
                set sx=GetUnitX(source)
                set sy=GetUnitY(source)
                if WaveRangedSkills___WaveRangedCastLightning[castId] != null then
                    call MoveLightningEx(WaveRangedSkills___WaveRangedCastLightning[castId], true, sx, sy, WaveRangedSkills_WAVE_HRIF_LIGHTNING_SOURCE_Z, WaveRangedSkills___WaveRangedCastTargetX[castId], WaveRangedSkills___WaveRangedCastTargetY[castId], WaveRangedSkills_WAVE_HRIF_LIGHTNING_TARGET_Z)
                endif
                set WaveRangedSkills___WaveRangedCastElapsed[castId]=WaveRangedSkills___WaveRangedCastElapsed[castId] + WaveRangedSkills_WAVE_HRIF_TELEGRAPH_TICK
                if WaveRangedSkills___WaveRangedCastElapsed[castId] >= WaveRangedSkills_WAVE_HRIF_TELEGRAPH_DURATION then
                    call WaveRangedSkills___WaveRangedLaunchHrifProjectile(castId)
                    call WaveRangedSkills___WaveRangedCastDestroy(castId)
                endif
            elseif WaveRangedSkills___WaveRangedCastMode[castId] == WaveRangedSkills___WAVE_RANGED_MODE_HRIF_BOSS then
                if WaveRangedSkills___WaveRangedCastPhase[castId] == WaveRangedSkills___WAVE_RANGED_PHASE_TELEGRAPH then
                    call WaveRangedSkills___WaveRangedBossUpdateTelegraphs(castId)
                    set WaveRangedSkills___WaveRangedCastElapsed[castId]=WaveRangedSkills___WaveRangedCastElapsed[castId] + WaveRangedSkills_WAVE_HRIF_TELEGRAPH_TICK
                    if WaveRangedSkills___WaveRangedCastElapsed[castId] >= WaveRangedSkills_WAVE_HRIF_BOSS_TELEGRAPH_DURATION then
                        call WaveRangedSkills___WaveRangedDestroyBossLightnings(castId)
                        set WaveRangedSkills___WaveRangedCastPhase[castId]=WaveRangedSkills___WAVE_RANGED_PHASE_VOLLEY
                        set WaveRangedSkills___WaveRangedCastElapsed[castId]=0.0
                        set WaveRangedSkills___WaveRangedCastVolleyAccumulator[castId]=0.0
                        call WaveRangedSkills___WaveRangedBossFireVolley(castId)
                        set WaveRangedSkills___WaveRangedCastVolleyRemaining[castId]=WaveRangedSkills___WaveRangedCastVolleyRemaining[castId] - 1
                        if WaveRangedSkills___WaveRangedCastVolleyRemaining[castId] <= 0 then
                            call WaveRangedSkills___WaveRangedCastDestroy(castId)
                        endif
                    endif
                else
                    set WaveRangedSkills___WaveRangedCastVolleyAccumulator[castId]=WaveRangedSkills___WaveRangedCastVolleyAccumulator[castId] + WaveRangedSkills_WAVE_HRIF_TELEGRAPH_TICK
                    loop
                        exitwhen WaveRangedSkills___WaveRangedCastVolleyRemaining[castId] <= 0 or WaveRangedSkills___WaveRangedCastVolleyAccumulator[castId] < WaveRangedSkills_WAVE_HRIF_BOSS_VOLLEY_INTERVAL
                        set WaveRangedSkills___WaveRangedCastVolleyAccumulator[castId]=WaveRangedSkills___WaveRangedCastVolleyAccumulator[castId] - WaveRangedSkills_WAVE_HRIF_BOSS_VOLLEY_INTERVAL
                        call WaveRangedSkills___WaveRangedBossFireVolley(castId)
                        set WaveRangedSkills___WaveRangedCastVolleyRemaining[castId]=WaveRangedSkills___WaveRangedCastVolleyRemaining[castId] - 1
                    endloop
                    if WaveRangedSkills___WaveRangedCastVolleyRemaining[castId] <= 0 then
                        call WaveRangedSkills___WaveRangedCastDestroy(castId)
                    endif
                endif
            else
                call WaveRangedSkills___WaveRangedCastDestroy(castId)
            endif
            set castId=nextCastId
        endloop

        if WaveRangedSkills___WaveRangedCastHead == 0 and WaveRangedSkills___WaveRangedTickRunning then
            call PauseTimer(WaveRangedSkills___WaveRangedTickTimer)
            set WaveRangedSkills___WaveRangedTickRunning=false
        endif

        set source=null
        set target=null
    endfunction

    function WaveRangedSkills___WaveRangedEnsureTickTimer takes nothing returns nothing
        if not WaveRangedSkills___WaveRangedTickRunning then
            set WaveRangedSkills___WaveRangedTickRunning=true
            call TimerStart(WaveRangedSkills___WaveRangedTickTimer, WaveRangedSkills_WAVE_HRIF_TELEGRAPH_TICK, true, function WaveRangedSkills___WaveRangedOnTick)
        endif
    endfunction

    function WaveRangedSkills___WaveRangedStartHrifCast takes unit source,unit target returns nothing
        local integer castId= WaveRangedSkills___WaveRangedCastCount + 1
        local integer hid= GetHandleId(source)
        local real tx= GetUnitX(target)
        local real ty= GetUnitY(target)
        local real angle= Atan2(ty - GetUnitY(source), tx - GetUnitX(source))

        set WaveRangedSkills___WaveRangedCastCount=castId
        set WaveRangedSkills___WaveRangedCastMode[castId]=WaveRangedSkills___WAVE_RANGED_MODE_HRIF
        set WaveRangedSkills___WaveRangedCastPhase[castId]=WaveRangedSkills___WAVE_RANGED_PHASE_TELEGRAPH
        set WaveRangedSkills___WaveRangedCastVolleyRemaining[castId]=0
        set WaveRangedSkills___WaveRangedCastVolleyAccumulator[castId]=0.0
        set WaveRangedSkills___WaveRangedCastSource[castId]=source
        set WaveRangedSkills___WaveRangedCastTarget[castId]=target
        set WaveRangedSkills___WaveRangedCastTargetX[castId]=tx
        set WaveRangedSkills___WaveRangedCastTargetY[castId]=ty
        set WaveRangedSkills___WaveRangedCastElapsed[castId]=0.0
        set WaveRangedSkills___WaveRangedCastLightning[castId]=null
        set WaveRangedSkills___WaveRangedCastTargetMarker[castId]=0
        set WaveRangedSkills___WaveRangedCastSourcePaused[castId]=false

        call WaveRangedSkills___WaveRangedCastAdd(castId)
        call SaveInteger(Table__ht, (WaveRangedSkills___WaveRangedActiveCastByUnit), (hid), ( castId)) // INLINED!!
        call IssueImmediateOrder(source, "stop")
        call SetUnitFacing(source, angle * bj_RADTODEG)
        call SetUnitAnimation(source, "attack")
        call WaveRangedSkills___WaveRangedEnsureTickTimer()
    endfunction

    function WaveRangedSkills___WaveRangedStartHrifBossCast takes unit source,unit target returns nothing
        local integer castId= WaveRangedSkills___WaveRangedCastCount + 1
        local integer hid= GetHandleId(source)
        local real tx= 0.0
        local real ty= 0.0
        local real angle

        if target != null and GetUnitTypeId(target) != 0 then
            set tx=GetUnitX(target)
            set ty=GetUnitY(target)
        else
            set tx=GetUnitX(source)
            set ty=GetUnitY(source)
        endif
        set angle=Atan2(ty - GetUnitY(source), tx - GetUnitX(source))

        set WaveRangedSkills___WaveRangedCastCount=castId
        set WaveRangedSkills___WaveRangedCastMode[castId]=WaveRangedSkills___WAVE_RANGED_MODE_HRIF_BOSS
        set WaveRangedSkills___WaveRangedCastPhase[castId]=WaveRangedSkills___WAVE_RANGED_PHASE_TELEGRAPH
        set WaveRangedSkills___WaveRangedCastVolleyRemaining[castId]=WaveRangedSkills_WAVE_HRIF_BOSS_VOLLEY_COUNT
        set WaveRangedSkills___WaveRangedCastVolleyAccumulator[castId]=0.0
        set WaveRangedSkills___WaveRangedCastSource[castId]=source
        set WaveRangedSkills___WaveRangedCastTarget[castId]=target
        set WaveRangedSkills___WaveRangedCastTargetX[castId]=tx
        set WaveRangedSkills___WaveRangedCastTargetY[castId]=ty
        set WaveRangedSkills___WaveRangedCastElapsed[castId]=0.0
        set WaveRangedSkills___WaveRangedCastLightning[castId]=null
        set WaveRangedSkills___WaveRangedCastSourcePaused[castId]=true

        call WaveRangedSkills___WaveRangedCastAdd(castId)
        call SaveInteger(Table__ht, (WaveRangedSkills___WaveRangedActiveCastByUnit), (hid), ( castId)) // INLINED!!
        call IssueImmediateOrder(source, "stop")
        call SetUnitFacing(source, angle * bj_RADTODEG)
        call SetUnitAnimation(source, "attack")
        call PauseUnit(source, true)
        call WaveRangedSkills___WaveRangedBossCreateTelegraphs(castId)
        call WaveRangedSkills___WaveRangedEnsureTickTimer()
    endfunction

    function WaveRangedSkills___WaveRangedCleanupDeadCaster takes nothing returns nothing
        local unit u= (WaveEventUnit) // INLINED!!
        local integer hid
        local integer castId
        local integer unitType
        if u == null then
            return
        endif
        set unitType=GetUnitTypeId(u)
        if unitType != WaveRangedSkills_WAVE_HRIF_UNIT_ID and unitType != WaveRangedSkills_WAVE_HRIF_BOSS_UNIT_ID then
            set u=null
            return
        endif
        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("WaveRangedCleanupDeadCaster enter " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
        endif
        set hid=GetHandleId(u)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveRangedSkills___WaveRangedActiveCastByUnit), (hid))) then // INLINED!!
            set castId=(LoadInteger(Table__ht, (WaveRangedSkills___WaveRangedActiveCastByUnit), (hid))) // INLINED!!
            if castId != 0 then
                call WaveRangedSkills___WaveRangedCastDestroy(castId)
            endif
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveRangedSkills___WaveRangedNextCastMs), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveRangedSkills___WaveRangedNextCastMs), (hid)) // INLINED!!
        endif
        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("WaveRangedCleanupDeadCaster exit " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
        endif
        set u=null
    endfunction

    function WaveRangedSkillsSetTrackedHeroForPlayer takes integer playerId,unit hero returns nothing
        if playerId < 0 or playerId >= bj_MAX_PLAYER_SLOTS then
            return
        endif
        if hero != null and GetUnitTypeId(hero) == 0 then
            set hero=null
        endif
        set s__WaveRangedSkills___WaveRangedTrackedHeroByPlayer[playerId]= hero
    endfunction

    function WaveRangedSkillsTryExecute takes unit source,unit target,integer nowMs returns boolean
        local integer hid
        local integer nextMs
        local boolean isBoss= false
        if not WaveRangedSkills___WaveRangedUnitAlive(source) then
            return false
        endif
        if WaveRangedSkills___WaveRangedIsHrifBoss(source) then
            set isBoss=true
        elseif not WaveRangedSkills___WaveRangedIsHrifBase(source) then
            return false
        endif
        if target == null or GetUnitTypeId(target) == 0 or not UnitAlive(target) or not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif

        set hid=GetHandleId(source)
        if hid == 0 then
            return false
        endif

        if (HaveSavedInteger(Table__ht, (WaveRangedSkills___WaveRangedActiveCastByUnit), (hid))) and (LoadInteger(Table__ht, (WaveRangedSkills___WaveRangedActiveCastByUnit), (hid))) != 0 then // INLINED!!
            return true
        endif

        if not (HaveSavedInteger(Table__ht, (WaveRangedSkills___WaveRangedNextCastMs), (hid))) then // INLINED!!
            if isBoss then
                call SaveInteger(Table__ht, (WaveRangedSkills___WaveRangedNextCastMs), (hid), ( nowMs + WaveRangedSkills___WaveRangedRandomMsRange(WaveRangedSkills_WAVE_HRIF_BOSS_INITIAL_DELAY_MIN , WaveRangedSkills_WAVE_HRIF_BOSS_INITIAL_DELAY_MAX))) // INLINED!!
            else
                call SaveInteger(Table__ht, (WaveRangedSkills___WaveRangedNextCastMs), (hid), ( nowMs + WaveRangedSkills___WaveRangedRandomMsRange(WaveRangedSkills_WAVE_HRIF_INITIAL_DELAY_MIN , WaveRangedSkills_WAVE_HRIF_INITIAL_DELAY_MAX))) // INLINED!!
            endif
            return false
        endif

        set nextMs=(LoadInteger(Table__ht, (WaveRangedSkills___WaveRangedNextCastMs), (hid))) // INLINED!!
        if nowMs < nextMs then
            return false
        endif

        if isBoss then
            if WaveRangedSkills___WaveRangedBossCountEnemyHeroes(source) > 0 then
                call WaveRangedSkills___WaveRangedStartHrifBossCast(source , target)
                call SaveInteger(Table__ht, (WaveRangedSkills___WaveRangedNextCastMs), (hid), ( nowMs + WaveRangedSkills___WaveRangedRandomMsRange(WaveRangedSkills_WAVE_HRIF_BOSS_COOLDOWN_MIN , WaveRangedSkills_WAVE_HRIF_BOSS_COOLDOWN_MAX))) // INLINED!!
                return true
            endif
            return false
        endif

        call WaveRangedSkills___WaveRangedStartHrifCast(source , target)
        call SaveInteger(Table__ht, (WaveRangedSkills___WaveRangedNextCastMs), (hid), ( nowMs + WaveRangedSkills___WaveRangedRandomMsRange(WaveRangedSkills_WAVE_HRIF_COOLDOWN_MIN , WaveRangedSkills_WAVE_HRIF_COOLDOWN_MAX))) // INLINED!!
        return true
    endfunction

    function WaveRangedSkills___Init takes nothing returns nothing
        set WaveRangedSkills___WaveRangedNextCastMs=s__Table_create()
        set WaveRangedSkills___WaveRangedActiveCastByUnit=s__Table_create()
        set WaveRangedSkills___WaveRangedTickTimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(WaveRangedSkills___WaveRangedTickTimer , TIMER_DEBUG_TAG_UNIT_SKILLS)

        // Reafirma el perfil base del proyectil para hrif desde la capa de skill.
        call WaveProjectileSetFinishAoe(WAVE_PROJECTILE_TYPE_HRIF , WAVE_HRIF_PROJECTILE_FINISH_AOE)

        // Hooks listos para cleanup y futuras extensiones.
        call RegisterWaveDeathEvent(function WaveRangedSkills___WaveRangedCleanupDeadCaster)
    endfunction



    function WaveSiegeSkills___WaveSiegeSecToMs takes real sec returns integer
        if sec <= 0.0 then
            return 0
        endif
        return R2I(sec * 1000.0 + 0.5)
    endfunction

    function WaveSiegeSkills___WaveSiegeRandomMsRange takes real minSec,real maxSec returns integer
        local real lo= minSec
        local real hi= maxSec
        if hi < lo then
            set lo=maxSec
            set hi=minSec
        endif
        if hi <= 0.0 then
            return 0
        endif
        if lo < 0.0 then
            set lo=0.0
        endif
        return WaveSiegeSkills___WaveSiegeSecToMs(GetRandomReal(lo, hi))
    endfunction

    function WaveSiegeSkills___WaveSiegeUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WaveSiegeSkills___WaveSiegeIsHmil takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WaveSiegeSkills_WAVE_HMIL_UNIT_ID
    endfunction

    function WaveSiegeSkills___WaveSiegeIsHmilBoss takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WaveSiegeSkills_WAVE_HMIL_BOSS_UNIT_ID
    endfunction

    function WaveSiegeSkills___WaveSiegeCanDamageTarget takes integer missile,unit hit returns boolean
        if hit == null or not UnitAlive(hit) then
            return false
        endif
        if not IsUnitEnemy(hit, s__Missile_owner[missile]) then
            return false
        endif
        return true
    endfunction

    function WaveSiegeSkills___WaveSiegeCreateImpactFx takes real x,real y returns nothing
        local effect fx= AddSpecialEffect(WaveSiegeSkills_WAVE_HMIL_IMPACT_FX, x, y)
        call DestroyEffect(fx)
        set fx=null
    endfunction

        function s__WaveSiegeSkills___WaveSiegeMissile_onFinish takes integer missile returns boolean
            local unit hit
            local unit source= s__Missile_source[missile]
            if source != null and GetUnitTypeId(source) != 0 then
                call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, WaveSiegeSkills___WaveSiegeMissileImpactX[missile], WaveSiegeSkills___WaveSiegeMissileImpactY[missile], WaveSiegeSkills___WaveSiegeMissileAoe[missile], null)
                loop
                    set hit=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
                    exitwhen hit == null
                    call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, hit)
                    if WaveSiegeSkills___WaveSiegeCanDamageTarget(missile , hit) then
                        call UnitDamageTarget(source, hit, WaveSiegeSkills___WaveSiegeMissileDamage[missile], false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    endif
                endloop
            endif
            call WaveSiegeSkills___WaveSiegeCreateImpactFx(WaveSiegeSkills___WaveSiegeMissileImpactX[missile] , WaveSiegeSkills___WaveSiegeMissileImpactY[missile])
            if WaveSiegeSkills___WaveSiegeMissileMarker[missile] != 0 then
                call WaveSkillVisualDestroy(WaveSiegeSkills___WaveSiegeMissileMarker[missile])
                set WaveSiegeSkills___WaveSiegeMissileMarker[missile]=0
            endif
            set hit=null
            set source=null
            return true
        endfunction

        function s__WaveSiegeSkills___WaveSiegeMissile_onRemove takes integer missile returns boolean
            set WaveSiegeSkills___WaveSiegeMissileDamage[missile]=0.0
            set WaveSiegeSkills___WaveSiegeMissileAoe[missile]=0.0
            set WaveSiegeSkills___WaveSiegeMissileImpactX[missile]=0.0
            set WaveSiegeSkills___WaveSiegeMissileImpactY[missile]=0.0
            if WaveSiegeSkills___WaveSiegeMissileMarker[missile] != 0 then
                call WaveSkillVisualDestroy(WaveSiegeSkills___WaveSiegeMissileMarker[missile])
                set WaveSiegeSkills___WaveSiegeMissileMarker[missile]=0
            endif
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__WaveSiegeSkills___WaveSiegeMissile_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__WaveSiegeSkills___WaveSiegeMissile],missile)
            call Missile___StartPeriodic(si__WaveSiegeSkills___WaveSiegeMissile)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__WaveSiegeSkills___WaveSiegeMissile_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__WaveSiegeSkills___WaveSiegeMissile_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__WaveSiegeSkills___WaveSiegeMissile)
            endif
        endfunction
























        













    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__WaveSiegeSkills___WaveSiegeMissile_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__WaveSiegeSkills___WaveSiegeMissile])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__WaveSiegeSkills___WaveSiegeMissile_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.







































                    
                    // Runs destructable collision.






                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__WaveSiegeSkills___WaveSiegeMissile_onFinish(this) then
                                call s__WaveSiegeSkills___WaveSiegeMissile_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.





                
                    // Runs every Missile_TIMER_TIMEOUT.





                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__WaveSiegeSkills___WaveSiegeMissile_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__WaveSiegeSkills___WaveSiegeMissile)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__WaveSiegeSkills___WaveSiegeMissile )]=Condition(( function s__WaveSiegeSkills___WaveSiegeMissile_missileIterateP)) // INLINED!!
        endfunction

    function WaveSiegeSkills___WaveSiegeLaunchProjectile takes unit source,real tx,real ty,real damage,real aoe returns nothing
        local integer missile
        local real sx
        local real sy
        if not WaveSiegeSkills___WaveSiegeUnitAlive(source) then
            return
        endif
        set sx=GetUnitX(source)
        set sy=GetUnitY(source)
        set missile=s__Missile_createXYZ(sx , sy , WaveSiegeSkills_WAVE_HMIL_PROJECTILE_START_Z , tx , ty , WaveSiegeSkills_WAVE_HMIL_PROJECTILE_START_Z)
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=GetOwningPlayer(source)
        call s__Missile__set_model(missile,WaveSiegeSkills_WAVE_HMIL_PROJECTILE_MODEL)
        call s__Missile__set_scale(missile,1.0)
        set s__Missile_collision[missile]=0.0
        set s__Missile_speed[(missile)]=((WaveSiegeSkills_WAVE_HMIL_PROJECTILE_SPEED)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
        call s__Missile__set_arc(missile,WaveSiegeSkills_WAVE_HMIL_PROJECTILE_ARC)

        set WaveSiegeSkills___WaveSiegeMissileDamage[missile]=damage
        set WaveSiegeSkills___WaveSiegeMissileAoe[missile]=aoe
        set WaveSiegeSkills___WaveSiegeMissileImpactX[missile]=tx
        set WaveSiegeSkills___WaveSiegeMissileImpactY[missile]=ty
        set WaveSiegeSkills___WaveSiegeMissileMarker[missile]=WaveSkillVisualCreateTimedMarker(tx , ty , 0.0 , WaveSiegeSkills_WAVE_HMIL_TARGET_MARKER_MODEL , aoe , 30.0)
        call s__WaveSiegeSkills___WaveSiegeMissile_launch(missile)
    endfunction

    function WaveSiegeSkills___WaveSiegeLaunchBossProjectiles takes unit source,unit primaryTarget returns nothing
        local integer launched= 0
        local integer i= 0
        local unit hero
        local real tx
        local real ty
        local real angle
        local real radius
        if not WaveSiegeSkills___WaveSiegeUnitAlive(source) then
            return
        endif
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS or launched >= WaveSiegeSkills_WAVE_HMIL_BOSS_PROJECTILE_COUNT
            set hero=PlayerHero[i]
            if WaveSiegeSkills___WaveSiegeUnitAlive(hero) and IsUnitEnemy(hero, GetOwningPlayer(source)) then
                call WaveSiegeSkills___WaveSiegeLaunchProjectile(source , GetUnitX(hero) , GetUnitY(hero) , WaveSiegeSkills_WAVE_HMIL_BOSS_IMPACT_DAMAGE , WaveSiegeSkills_WAVE_HMIL_BOSS_IMPACT_AOE)
                set launched=launched + 1
            endif
            set i=i + 1
        endloop

        if launched < WaveSiegeSkills_WAVE_HMIL_BOSS_PROJECTILE_COUNT and WaveSiegeSkills___WaveSiegeUnitAlive(primaryTarget) then
            loop
                exitwhen launched >= WaveSiegeSkills_WAVE_HMIL_BOSS_PROJECTILE_COUNT
                set angle=GetRandomReal(0.0, 360.0) * bj_DEGTORAD
                set radius=GetRandomReal(96.0, WaveSiegeSkills_WAVE_HMIL_BOSS_SECONDARY_RANDOM_RADIUS)
                set tx=GetUnitX(primaryTarget) + radius * Cos(angle)
                set ty=GetUnitY(primaryTarget) + radius * Sin(angle)
                call WaveSiegeSkills___WaveSiegeLaunchProjectile(source , tx , ty , WaveSiegeSkills_WAVE_HMIL_BOSS_IMPACT_DAMAGE , WaveSiegeSkills_WAVE_HMIL_BOSS_IMPACT_AOE)
                set launched=launched + 1
            endloop
        endif
        set hero=null
    endfunction

    function WaveSiegeSkills___WaveSiegeCleanupWaveDeath takes nothing returns nothing
        local unit deadUnit= (WaveEventUnit) // INLINED!!
        local integer hid
        if deadUnit == null or GetUnitTypeId(deadUnit) == 0 then
            return
        endif
        if GetUnitTypeId(deadUnit) == WaveSiegeSkills_WAVE_HMIL_UNIT_ID or GetUnitTypeId(deadUnit) == WaveSiegeSkills_WAVE_HMIL_BOSS_UNIT_ID then
            if WAVE_DEBUG_ENABLED then
                call WaveDebugLog("WaveSiegeCleanupWaveDeath enter " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
            endif
            set hid=GetHandleId(deadUnit)
            if hid != 0 and (HaveSavedInteger(Table__ht, (WaveSiegeSkills___WaveSiegeNextCastMs), (hid))) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (WaveSiegeSkills___WaveSiegeNextCastMs), (hid)) // INLINED!!
            endif
            if WAVE_DEBUG_ENABLED then
                call WaveDebugLog("WaveSiegeCleanupWaveDeath exit source " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
            endif
        endif
    endfunction

    function WaveSiegeSkillsTryExecute takes unit source,unit target,integer nowMs returns boolean
        return false
    endfunction

    function WaveSiegeSkills___Init takes nothing returns nothing
        set WaveSiegeSkills___WaveSiegeNextCastMs=s__Table_create()
        call RegisterWaveDeathEvent(function WaveSiegeSkills___WaveSiegeCleanupWaveDeath)
    endfunction



    function WaveSiegeZoneSkills__WaveSiegeZoneScaleForRadius takes real radius returns real
        if radius <= 0.0 then
            return 0.01
        endif
        return radius / 200.0
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneSecToMs takes real sec returns integer
        if sec <= 0.0 then
            return 0
        endif
        return R2I(sec * 1000.0 + 0.5)
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneRandomMsRange takes real minSec,real maxSec returns integer
        local real lo= minSec
        local real hi= maxSec
        if hi < lo then
            set lo=maxSec
            set hi=minSec
        endif
        if hi <= 0.0 then
            return 0
        endif
        if lo < 0.0 then
            set lo=0.0
        endif
        return WaveSiegeZoneSkills__WaveSiegeZoneSecToMs(GetRandomReal(lo, hi))
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneAddCast takes integer castId returns nothing
        set WaveSiegeZoneSkills__WaveSiegeZoneCastPrev[castId]=0
        set WaveSiegeZoneSkills__WaveSiegeZoneCastNext[castId]=WaveSiegeZoneSkills__WaveSiegeZoneCastHead
        if WaveSiegeZoneSkills__WaveSiegeZoneCastHead != 0 then
            set WaveSiegeZoneSkills__WaveSiegeZoneCastPrev[WaveSiegeZoneSkills__WaveSiegeZoneCastHead]=castId
        endif
        set WaveSiegeZoneSkills__WaveSiegeZoneCastHead=castId
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneRemoveCast takes integer castId returns nothing
        local integer p= WaveSiegeZoneSkills__WaveSiegeZoneCastPrev[castId]
        local integer n= WaveSiegeZoneSkills__WaveSiegeZoneCastNext[castId]
        if p != 0 then
            set WaveSiegeZoneSkills__WaveSiegeZoneCastNext[p]=n
        else
            set WaveSiegeZoneSkills__WaveSiegeZoneCastHead=n
        endif
        if n != 0 then
            set WaveSiegeZoneSkills__WaveSiegeZoneCastPrev[n]=p
        endif
        set WaveSiegeZoneSkills__WaveSiegeZoneCastPrev[castId]=0
        set WaveSiegeZoneSkills__WaveSiegeZoneCastNext[castId]=0
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneDestroyCast takes integer castId returns nothing
        local unit source= WaveSiegeZoneSkills__WaveSiegeZoneCastSource[castId]
        local integer hid= 0
        if source != null and GetUnitTypeId(source) != 0 then
            set hid=GetHandleId(source)
            if WaveSiegeZoneSkills__WaveSiegeZoneCastPaused[castId] then
                call PauseUnit(source, false)
            endif
        endif
        call WaveSiegeZoneSkills__WaveSiegeZoneRemoveCast(castId)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneActiveCastByUnit), (hid))) and (LoadInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneActiveCastByUnit), (hid))) == castId then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneActiveCastByUnit), (hid)) // INLINED!!
        endif
        set WaveSiegeZoneSkills__WaveSiegeZoneCastSource[castId]=null
        set WaveSiegeZoneSkills__WaveSiegeZoneCastTargetX[castId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneCastTargetY[castId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneCastRemaining[castId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneCastRadius[castId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneCastDamage[castId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneCastPaused[castId]=false
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneAdd takes integer zoneId returns nothing
        set WaveSiegeZoneSkills__WaveSiegeZonePrev[zoneId]=0
        set WaveSiegeZoneSkills__WaveSiegeZoneNext[zoneId]=WaveSiegeZoneSkills__WaveSiegeZoneHead
        if WaveSiegeZoneSkills__WaveSiegeZoneHead != 0 then
            set WaveSiegeZoneSkills__WaveSiegeZonePrev[WaveSiegeZoneSkills__WaveSiegeZoneHead]=zoneId
        endif
        set WaveSiegeZoneSkills__WaveSiegeZoneHead=zoneId
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneRemove takes integer zoneId returns nothing
        local integer p= WaveSiegeZoneSkills__WaveSiegeZonePrev[zoneId]
        local integer n= WaveSiegeZoneSkills__WaveSiegeZoneNext[zoneId]
        if p != 0 then
            set WaveSiegeZoneSkills__WaveSiegeZoneNext[p]=n
        else
            set WaveSiegeZoneSkills__WaveSiegeZoneHead=n
        endif
        if n != 0 then
            set WaveSiegeZoneSkills__WaveSiegeZonePrev[n]=p
        endif
        set WaveSiegeZoneSkills__WaveSiegeZonePrev[zoneId]=0
        set WaveSiegeZoneSkills__WaveSiegeZoneNext[zoneId]=0
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneDestroy takes integer zoneId returns nothing
        if zoneId <= 0 then
            return
        endif
        call WaveSiegeZoneSkills__WaveSiegeZoneRemove(zoneId)
        if WaveSiegeZoneSkills__WaveSiegeZoneFx[zoneId] != null then
            call DestroyEffect(WaveSiegeZoneSkills__WaveSiegeZoneFx[zoneId])
            set WaveSiegeZoneSkills__WaveSiegeZoneFx[zoneId]=null
        endif
        if WaveSiegeZoneSkills__WaveSiegeZoneAreaFx[zoneId] != null then
            call DestroyEffect(WaveSiegeZoneSkills__WaveSiegeZoneAreaFx[zoneId])
            set WaveSiegeZoneSkills__WaveSiegeZoneAreaFx[zoneId]=null
        endif
        if WaveSiegeZoneSkills__WaveSiegeZoneDummy[zoneId] != null and GetUnitTypeId(WaveSiegeZoneSkills__WaveSiegeZoneDummy[zoneId]) != 0 then
            call RemoveUnit(WaveSiegeZoneSkills__WaveSiegeZoneDummy[zoneId])
        endif
        set WaveSiegeZoneSkills__WaveSiegeZoneDummy[zoneId]=null
        set WaveSiegeZoneSkills__WaveSiegeZoneSource[zoneId]=null
        set WaveSiegeZoneSkills__WaveSiegeZoneOwner[zoneId]=null
        set WaveSiegeZoneSkills__WaveSiegeZoneX[zoneId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneY[zoneId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneRadius[zoneId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneDamage[zoneId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneRemaining[zoneId]=0.0
        set WaveSiegeZoneSkills__WaveSiegeZoneAccumulator[zoneId]=0.0
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneCreate takes unit source,real x,real y,real radius,real damage returns nothing
        local integer zoneId
        local unit dummy
        if not WaveSiegeZoneSkills__WaveSiegeZoneUnitAlive(source) then
            return
        endif
        set zoneId=WaveSiegeZoneSkills__WaveSiegeZoneCount + 1
        set WaveSiegeZoneSkills__WaveSiegeZoneCount=zoneId
        set dummy=CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), WaveSiegeZoneSkills__WAVE_HMTT_DUMMY_ID, x, y, 0.0)
        if dummy != null and GetUnitTypeId(dummy) != 0 then
            call UnitAddAbility(dummy, WaveSiegeZoneSkills__WAVE_HMTT_LOCUST_ID)
            call UnitAddAbility(dummy, WaveSiegeZoneSkills__WAVE_HMTT_INVUL_ID)
            call SetUnitPathing(dummy, false)
            call SetUnitScale(dummy, WaveSiegeZoneSkills__WaveSiegeZoneScaleForRadius(radius), WaveSiegeZoneSkills__WaveSiegeZoneScaleForRadius(radius), WaveSiegeZoneSkills__WaveSiegeZoneScaleForRadius(radius))
            set WaveSiegeZoneSkills__WaveSiegeZoneFx[zoneId]=AddSpecialEffectTarget(WaveSiegeZoneSkills_WAVE_HMTT_ZONE_MODEL, dummy, "origin")
            set WaveSiegeZoneSkills__WaveSiegeZoneAreaFx[zoneId]=AddSpecialEffectTarget(WaveSiegeZoneSkills_WAVE_HMTT_AREA_MODEL, dummy, "origin")
        endif
        set WaveSiegeZoneSkills__WaveSiegeZoneDummy[zoneId]=dummy
        set WaveSiegeZoneSkills__WaveSiegeZoneSource[zoneId]=source
        set WaveSiegeZoneSkills__WaveSiegeZoneOwner[zoneId]=GetOwningPlayer(source)
        set WaveSiegeZoneSkills__WaveSiegeZoneX[zoneId]=x
        set WaveSiegeZoneSkills__WaveSiegeZoneY[zoneId]=y
        set WaveSiegeZoneSkills__WaveSiegeZoneRadius[zoneId]=radius
        set WaveSiegeZoneSkills__WaveSiegeZoneDamage[zoneId]=damage
        set WaveSiegeZoneSkills__WaveSiegeZoneRemaining[zoneId]=WaveSiegeZoneSkills_WAVE_HMTT_ZONE_DURATION
        set WaveSiegeZoneSkills__WaveSiegeZoneAccumulator[zoneId]=0.0
        call WaveSiegeZoneSkills__WaveSiegeZoneAdd(zoneId)
        set dummy=null
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneApplyDamage takes integer zoneId returns nothing
        local unit hit
        local unit source= WaveSiegeZoneSkills__WaveSiegeZoneSource[zoneId]
        if WaveSiegeZoneSkills__WaveSiegeZoneOwner[zoneId] == null then
            set source=null
            return
        endif
        if source == null or GetUnitTypeId(source) == 0 then
            set source=WaveSiegeZoneSkills__WaveSiegeZoneDummy[zoneId]
        endif
        call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, WaveSiegeZoneSkills__WaveSiegeZoneX[zoneId], WaveSiegeZoneSkills__WaveSiegeZoneY[zoneId], WaveSiegeZoneSkills__WaveSiegeZoneRadius[zoneId], null)
        loop
            set hit=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
            exitwhen hit == null
            call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, hit)
            if UnitAlive(hit) and IsUnitEnemy(hit, WaveSiegeZoneSkills__WaveSiegeZoneOwner[zoneId]) then
                if source != null and GetUnitTypeId(source) != 0 then
                    call UnitDamageTarget(source, hit, WaveSiegeZoneSkills__WaveSiegeZoneDamage[zoneId], false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
            endif
        endloop
        set hit=null
        set source=null
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneOnTick takes nothing returns nothing
        local integer castId= WaveSiegeZoneSkills__WaveSiegeZoneCastHead
        local integer nextCastId
        local integer zoneId= WaveSiegeZoneSkills__WaveSiegeZoneHead
        local integer nextZoneId
        loop
            exitwhen castId == 0
            set nextCastId=WaveSiegeZoneSkills__WaveSiegeZoneCastNext[castId]
            if not WaveSiegeZoneSkills__WaveSiegeZoneUnitAlive(WaveSiegeZoneSkills__WaveSiegeZoneCastSource[castId]) then
                call WaveSiegeZoneSkills__WaveSiegeZoneDestroyCast(castId)
            else
                set WaveSiegeZoneSkills__WaveSiegeZoneCastRemaining[castId]=WaveSiegeZoneSkills__WaveSiegeZoneCastRemaining[castId] - WaveSiegeZoneSkills__WAVE_HMTT_TICK
                if WaveSiegeZoneSkills__WaveSiegeZoneCastRemaining[castId] <= 0.0 then
                    call WaveSiegeZoneSkills__WaveSiegeZoneCreate(WaveSiegeZoneSkills__WaveSiegeZoneCastSource[castId] , WaveSiegeZoneSkills__WaveSiegeZoneCastTargetX[castId] , WaveSiegeZoneSkills__WaveSiegeZoneCastTargetY[castId] , WaveSiegeZoneSkills__WaveSiegeZoneCastRadius[castId] , WaveSiegeZoneSkills__WaveSiegeZoneCastDamage[castId])
                    call WaveSiegeZoneSkills__WaveSiegeZoneDestroyCast(castId)
                endif
            endif
            set castId=nextCastId
        endloop

        loop
            exitwhen zoneId == 0
            set nextZoneId=WaveSiegeZoneSkills__WaveSiegeZoneNext[zoneId]
            set WaveSiegeZoneSkills__WaveSiegeZoneRemaining[zoneId]=WaveSiegeZoneSkills__WaveSiegeZoneRemaining[zoneId] - WaveSiegeZoneSkills__WAVE_HMTT_TICK
            set WaveSiegeZoneSkills__WaveSiegeZoneAccumulator[zoneId]=WaveSiegeZoneSkills__WaveSiegeZoneAccumulator[zoneId] + WaveSiegeZoneSkills__WAVE_HMTT_TICK
            loop
                exitwhen WaveSiegeZoneSkills__WaveSiegeZoneAccumulator[zoneId] < WaveSiegeZoneSkills_WAVE_HMTT_ZONE_TICK
                set WaveSiegeZoneSkills__WaveSiegeZoneAccumulator[zoneId]=WaveSiegeZoneSkills__WaveSiegeZoneAccumulator[zoneId] - WaveSiegeZoneSkills_WAVE_HMTT_ZONE_TICK
                call WaveSiegeZoneSkills__WaveSiegeZoneApplyDamage(zoneId)
            endloop
            if WaveSiegeZoneSkills__WaveSiegeZoneRemaining[zoneId] <= 0.0 then
                call WaveSiegeZoneSkills__WaveSiegeZoneDestroy(zoneId)
            endif
            set zoneId=nextZoneId
        endloop

        if WaveSiegeZoneSkills__WaveSiegeZoneCastHead == 0 and WaveSiegeZoneSkills__WaveSiegeZoneHead == 0 and WaveSiegeZoneSkills__WaveSiegeZoneTimerRunning then
            call PauseTimer(WaveSiegeZoneSkills__WaveSiegeZoneTimer)
            set WaveSiegeZoneSkills__WaveSiegeZoneTimerRunning=false
        endif
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneEnsureTimer takes nothing returns nothing
        if not WaveSiegeZoneSkills__WaveSiegeZoneTimerRunning then
            set WaveSiegeZoneSkills__WaveSiegeZoneTimerRunning=true
            call TimerStart(WaveSiegeZoneSkills__WaveSiegeZoneTimer, WaveSiegeZoneSkills__WAVE_HMTT_TICK, true, function WaveSiegeZoneSkills__WaveSiegeZoneOnTick)
        endif
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneStartCast takes unit source,real tx,real ty,real radius,real damage returns nothing
        local integer castId= WaveSiegeZoneSkills__WaveSiegeZoneCastCount + 1
        local integer hid= GetHandleId(source)
        set WaveSiegeZoneSkills__WaveSiegeZoneCastCount=castId
        set WaveSiegeZoneSkills__WaveSiegeZoneCastSource[castId]=source
        set WaveSiegeZoneSkills__WaveSiegeZoneCastTargetX[castId]=tx
        set WaveSiegeZoneSkills__WaveSiegeZoneCastTargetY[castId]=ty
        set WaveSiegeZoneSkills__WaveSiegeZoneCastRemaining[castId]=WaveSiegeZoneSkills_WAVE_HMTT_WINDUP
        set WaveSiegeZoneSkills__WaveSiegeZoneCastRadius[castId]=radius
        set WaveSiegeZoneSkills__WaveSiegeZoneCastDamage[castId]=damage
        set WaveSiegeZoneSkills__WaveSiegeZoneCastPaused[castId]=true
        call WaveSiegeZoneSkills__WaveSiegeZoneAddCast(castId)
        call SaveInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneActiveCastByUnit), (hid), ( castId)) // INLINED!!
        call IssueImmediateOrder(source, "stop")
        call SetUnitAnimation(source, "attack")
        call PauseUnit(source, true)
    endfunction

    function WaveSiegeZoneSkills__WaveSiegeZoneCleanupWaveDeath takes nothing returns nothing
        local unit deadUnit= (WaveEventUnit) // INLINED!!
        local integer hid
        local integer castId
        local integer unitTypeId
        if deadUnit == null or GetUnitTypeId(deadUnit) == 0 then
            return
        endif
        set unitTypeId=GetUnitTypeId(deadUnit)
        if unitTypeId != WaveSiegeZoneSkills_WAVE_HMTT_UNIT_ID and unitTypeId != WaveSiegeZoneSkills_WAVE_HMTT_BOSS_UNIT_ID then
            return
        endif
        set hid=GetHandleId(deadUnit)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneNextCastMs), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneNextCastMs), (hid)) // INLINED!!
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneActiveCastByUnit), (hid))) then // INLINED!!
            set castId=(LoadInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneActiveCastByUnit), (hid))) // INLINED!!
            call WaveSiegeZoneSkills__WaveSiegeZoneDestroyCast(castId)
        endif
    endfunction

    function WaveSiegeZoneSkillsTryExecute takes unit source,unit target,integer nowMs returns boolean
        local integer hid
        local integer nextMs
        local real radius
        local real damage
        local real dx
        local real dy
        local boolean isBoss= false
        if not WaveSiegeZoneSkills__WaveSiegeZoneUnitAlive(source) then
            return false
        endif
        if GetUnitTypeId(source) == WaveSiegeZoneSkills_WAVE_HMTT_BOSS_UNIT_ID then
            set isBoss=true
        elseif GetUnitTypeId(source) != WaveSiegeZoneSkills_WAVE_HMTT_UNIT_ID then
            return false
        endif
        if target == null or GetUnitTypeId(target) == 0 or not UnitAlive(target) or not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif
        set dx=GetUnitX(target) - GetUnitX(source)
        set dy=GetUnitY(target) - GetUnitY(source)
        if dx * dx + dy * dy > WaveSiegeZoneSkills_WAVE_HMTT_CAST_RANGE * WaveSiegeZoneSkills_WAVE_HMTT_CAST_RANGE then
            return false
        endif

        set hid=GetHandleId(source)
        if hid == 0 then
            return false
        endif
        if (HaveSavedInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneActiveCastByUnit), (hid))) and (LoadInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneActiveCastByUnit), (hid))) != 0 then // INLINED!!
            return true
        endif
        if not (HaveSavedInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneNextCastMs), (hid))) then // INLINED!!
            if isBoss then
                call SaveInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneNextCastMs), (hid), ( nowMs + WaveSiegeZoneSkills__WaveSiegeZoneRandomMsRange(WaveSiegeZoneSkills_WAVE_HMTT_BOSS_INITIAL_DELAY_MIN , WaveSiegeZoneSkills_WAVE_HMTT_BOSS_INITIAL_DELAY_MAX))) // INLINED!!
            else
                call SaveInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneNextCastMs), (hid), ( nowMs + WaveSiegeZoneSkills__WaveSiegeZoneRandomMsRange(WaveSiegeZoneSkills_WAVE_HMTT_INITIAL_DELAY_MIN , WaveSiegeZoneSkills_WAVE_HMTT_INITIAL_DELAY_MAX))) // INLINED!!
            endif
            return false
        endif

        set nextMs=(LoadInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneNextCastMs), (hid))) // INLINED!!
        if nowMs < nextMs then
            return false
        endif

        if isBoss then
            set radius=WaveSiegeZoneSkills_WAVE_HMTT_BOSS_RADIUS
            set damage=WaveSiegeZoneSkills_WAVE_HMTT_BOSS_DAMAGE
            call SaveInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneNextCastMs), (hid), ( nowMs + WaveSiegeZoneSkills__WaveSiegeZoneRandomMsRange(WaveSiegeZoneSkills_WAVE_HMTT_BOSS_COOLDOWN_MIN , WaveSiegeZoneSkills_WAVE_HMTT_BOSS_COOLDOWN_MAX))) // INLINED!!
        else
            set radius=WaveSiegeZoneSkills_WAVE_HMTT_RADIUS
            set damage=WaveSiegeZoneSkills_WAVE_HMTT_DAMAGE
            call SaveInteger(Table__ht, (WaveSiegeZoneSkills__WaveSiegeZoneNextCastMs), (hid), ( nowMs + WaveSiegeZoneSkills__WaveSiegeZoneRandomMsRange(WaveSiegeZoneSkills_WAVE_HMTT_COOLDOWN_MIN , WaveSiegeZoneSkills_WAVE_HMTT_COOLDOWN_MAX))) // INLINED!!
        endif

        call WaveSiegeZoneSkills__WaveSiegeZoneStartCast(source , GetUnitX(target) , GetUnitY(target) , radius , damage)
        call WaveSiegeZoneSkills__WaveSiegeZoneEnsureTimer()
        return true
    endfunction

    function WaveSiegeZoneSkills__Init takes nothing returns nothing
        set WaveSiegeZoneSkills__WaveSiegeZoneNextCastMs=s__Table_create()
        set WaveSiegeZoneSkills__WaveSiegeZoneActiveCastByUnit=s__Table_create()
        set WaveSiegeZoneSkills__WaveSiegeZoneTimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(WaveSiegeZoneSkills__WaveSiegeZoneTimer , TIMER_DEBUG_TAG_UNIT_SKILLS)
        call RegisterWaveDeathEvent(function WaveSiegeZoneSkills__WaveSiegeZoneCleanupWaveDeath)
    endfunction



    function WaveTrapSkills__WaveTrapSecToMs takes real sec returns integer
        if sec <= 0.0 then
            return 0
        endif
        return R2I(sec * 1000.0 + 0.5)
    endfunction

    function WaveTrapSkills__WaveTrapRandomMsRange takes real minSec,real maxSec returns integer
        local real lo= minSec
        local real hi= maxSec
        if hi < lo then
            set lo=maxSec
            set hi=minSec
        endif
        if hi <= 0.0 then
            return 0
        endif
        if lo < 0.0 then
            set lo=0.0
        endif
        return WaveTrapSkills__WaveTrapSecToMs(GetRandomReal(lo, hi))
    endfunction

    function WaveTrapSkills__WaveTrapUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WaveTrapSkills__WaveTrapTargetInCastRange takes unit source,unit target returns boolean
        local real dx
        local real dy
        if not WaveTrapSkills__WaveTrapUnitAlive(source) or not WaveTrapSkills__WaveTrapUnitAlive(target) then
            return false
        endif
        set dx=GetUnitX(target) - GetUnitX(source)
        set dy=GetUnitY(target) - GetUnitY(source)
        return dx * dx + dy * dy <= WaveTrapSkills_WAVE_HSOR_CAST_RANGE * WaveTrapSkills_WAVE_HSOR_CAST_RANGE
    endfunction

    function WaveTrapSkills__WaveTrapIsBoss takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WaveTrapSkills_WAVE_HSOR_BOSS_UNIT_ID
    endfunction

    function WaveTrapSkills__WaveTrapAddCast takes integer castId returns nothing
        set WaveTrapSkills__WaveTrapCastPrev[castId]=0
        set WaveTrapSkills__WaveTrapCastNext[castId]=WaveTrapSkills__WaveTrapCastHead
        if WaveTrapSkills__WaveTrapCastHead != 0 then
            set WaveTrapSkills__WaveTrapCastPrev[WaveTrapSkills__WaveTrapCastHead]=castId
        endif
        set WaveTrapSkills__WaveTrapCastHead=castId
    endfunction

    function WaveTrapSkills__WaveTrapRemoveCast takes integer castId returns nothing
        local integer p= WaveTrapSkills__WaveTrapCastPrev[castId]
        local integer n= WaveTrapSkills__WaveTrapCastNext[castId]
        if p != 0 then
            set WaveTrapSkills__WaveTrapCastNext[p]=n
        else
            set WaveTrapSkills__WaveTrapCastHead=n
        endif
        if n != 0 then
            set WaveTrapSkills__WaveTrapCastPrev[n]=p
        endif
        set WaveTrapSkills__WaveTrapCastPrev[castId]=0
        set WaveTrapSkills__WaveTrapCastNext[castId]=0
    endfunction

    function WaveTrapSkills__WaveTrapDestroyCast takes integer castId returns nothing
        local unit source= WaveTrapSkills__WaveTrapCastSource[castId]
        local integer hid= 0
        if source != null and GetUnitTypeId(source) != 0 then
            set hid=GetHandleId(source)
            if WaveTrapSkills__WaveTrapCastPaused[castId] then
                call PauseUnit(source, false)
            endif
        endif
        call WaveTrapSkills__WaveTrapRemoveCast(castId)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveTrapSkills__WaveTrapActiveCastByUnit), (hid))) and (LoadInteger(Table__ht, (WaveTrapSkills__WaveTrapActiveCastByUnit), (hid))) == castId then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveTrapSkills__WaveTrapActiveCastByUnit), (hid)) // INLINED!!
        endif
        set WaveTrapSkills__WaveTrapCastSource[castId]=null
        set WaveTrapSkills__WaveTrapCastTargetX[castId]=0.0
        set WaveTrapSkills__WaveTrapCastTargetY[castId]=0.0
        set WaveTrapSkills__WaveTrapCastRemaining[castId]=0.0
        set WaveTrapSkills__WaveTrapCastRadius[castId]=0.0
        set WaveTrapSkills__WaveTrapCastDuration[castId]=0.0
        set WaveTrapSkills__WaveTrapCastModel[castId]=""
        set WaveTrapSkills__WaveTrapCastPaused[castId]=false
    endfunction

    function WaveTrapSkills__WaveTrapAdd takes integer trapId returns nothing
        set WaveTrapSkills__WaveTrapPrev[trapId]=0
        set WaveTrapSkills__WaveTrapNext[trapId]=WaveTrapSkills__WaveTrapHead
        if WaveTrapSkills__WaveTrapHead != 0 then
            set WaveTrapSkills__WaveTrapPrev[WaveTrapSkills__WaveTrapHead]=trapId
        endif
        set WaveTrapSkills__WaveTrapHead=trapId
    endfunction

    function WaveTrapSkills__WaveTrapRemove takes integer trapId returns nothing
        local integer p= WaveTrapSkills__WaveTrapPrev[trapId]
        local integer n= WaveTrapSkills__WaveTrapNext[trapId]
        if p != 0 then
            set WaveTrapSkills__WaveTrapNext[p]=n
        else
            set WaveTrapSkills__WaveTrapHead=n
        endif
        if n != 0 then
            set WaveTrapSkills__WaveTrapPrev[n]=p
        endif
        set WaveTrapSkills__WaveTrapPrev[trapId]=0
        set WaveTrapSkills__WaveTrapNext[trapId]=0
    endfunction

    function WaveTrapSkills__WaveTrapDestroy takes integer trapId returns nothing
        if trapId <= 0 then
            return
        endif
        call WaveTrapSkills__WaveTrapRemove(trapId)
        if WaveTrapSkills__WaveTrapVisualId[trapId] != 0 then
            call WaveSkillVisualDestroy(WaveTrapSkills__WaveTrapVisualId[trapId])
            set WaveTrapSkills__WaveTrapVisualId[trapId]=0
        endif
        set WaveTrapSkills__WaveTrapOwner[trapId]=null
        set WaveTrapSkills__WaveTrapX[trapId]=0.0
        set WaveTrapSkills__WaveTrapY[trapId]=0.0
        set WaveTrapSkills__WaveTrapRadius[trapId]=0.0
        set WaveTrapSkills__WaveTrapRemaining[trapId]=0.0
    endfunction

    function WaveTrapSkills__WaveTrapPlant takes player owner,real x,real y,real radius,real duration,string modelPath returns nothing
        local integer trapId
        if owner == null or duration <= 0.0 or radius <= 0.0 then
            return
        endif
        set trapId=WaveTrapSkills__WaveTrapCount + 1
        set WaveTrapSkills__WaveTrapCount=trapId
        set WaveTrapSkills__WaveTrapOwner[trapId]=owner
        set WaveTrapSkills__WaveTrapX[trapId]=x
        set WaveTrapSkills__WaveTrapY[trapId]=y
        set WaveTrapSkills__WaveTrapRadius[trapId]=radius
        set WaveTrapSkills__WaveTrapRemaining[trapId]=duration
        set WaveTrapSkills__WaveTrapVisualId[trapId]=WaveSkillVisualCreateTimedMarkerScaled(x , y , 0.0 , modelPath , WaveSkillVisualShieldScaleForRadius(radius) , duration)
        call WaveTrapSkills__WaveTrapAdd(trapId)
    endfunction

    function WaveTrapSkills__WaveTrapCanCatchHero takes player owner,unit target returns boolean
        if owner == null or not WaveTrapSkills__WaveTrapUnitAlive(target) then
            return false
        endif
        if not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif
        if not IsUnitEnemy(target, owner) then
            return false
        endif
        if GetUnitAbilityLevel(target, 'Avul') > 0 then
            return false
        endif
        return true
    endfunction

        function s__WaveTrapSkills__WaveTrapMissile_plantFromMissile takes integer missile,real x,real y returns nothing
            if WaveTrapSkills__WaveTrapMissilePlanted[missile] then
                return
            endif
            set WaveTrapSkills__WaveTrapMissilePlanted[missile]=true
            call WaveTrapSkills__WaveTrapPlant(WaveTrapSkills__WaveTrapMissileOwner[missile] , x , y , WaveTrapSkills__WaveTrapMissileRadius[missile] , WaveTrapSkills__WaveTrapMissileDuration[missile] , WaveTrapSkills__WaveTrapMissileModel[missile])
        endfunction

        function s__WaveTrapSkills__WaveTrapMissile_onCollide takes integer missile,unit hit returns boolean
            if WaveTrapSkills__WaveTrapCanCatchHero(s__Missile_owner[missile] , hit) then
                call s__WaveTrapSkills__WaveTrapMissile_plantFromMissile(missile , GetUnitX(hit) , GetUnitY(hit))
                return true
            endif
            return false
        endfunction

        function s__WaveTrapSkills__WaveTrapMissile_onFinish takes integer missile returns boolean
            call s__WaveTrapSkills__WaveTrapMissile_plantFromMissile(missile , s__Missile_x[missile] , s__Missile_y[missile])
            return true
        endfunction

        function s__WaveTrapSkills__WaveTrapMissile_onRemove takes integer missile returns boolean
            set WaveTrapSkills__WaveTrapMissileOwner[missile]=null
            set WaveTrapSkills__WaveTrapMissileRadius[missile]=0.0
            set WaveTrapSkills__WaveTrapMissileDuration[missile]=0.0
            set WaveTrapSkills__WaveTrapMissileModel[missile]=""
            set WaveTrapSkills__WaveTrapMissilePlanted[missile]=false
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__WaveTrapSkills__WaveTrapMissile_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__WaveTrapSkills__WaveTrapMissile],missile)
            call Missile___StartPeriodic(si__WaveTrapSkills__WaveTrapMissile)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__WaveTrapSkills__WaveTrapMissile_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__WaveTrapSkills__WaveTrapMissile_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__WaveTrapSkills__WaveTrapMissile)
            endif
        endfunction
























        













    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__WaveTrapSkills__WaveTrapMissile_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__WaveTrapSkills__WaveTrapMissile])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__WaveTrapSkills__WaveTrapMissile_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.

                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            set b=s__Missile_collisionType[this] == Missile_COLLISION_TYPE_RECTANGLE
                            if b then
                                call s__Missile_groupEnumUnitsRectangle(this)
                            else
                                call GroupEnumUnitsInRange(Missile___GROUP, s__Missile_x[this], s__Missile_y[this], s__Missile_collision[this] + Missile_MAXIMUM_COLLISION_SIZE, null)
                            endif
                            loop
                                set u=FirstOfGroup(Missile___GROUP)
                                exitwhen u == null
                                call GroupRemoveUnit(Missile___GROUP, u)
                                if not HaveSavedHandle(Missile___HASH, this, GetHandleId(u)) then
                                    if IsUnitInRange(u, s__Missile_dummy[this], s__Missile_collision[this]) or b then
                                        // Eventually run z collision checks.

                                            set collideZ=Missile_GetLocZ(GetUnitX(u) , GetUnitY(u)) + GetUnitFlyHeight(u) - s__Missile_terrainZ[this]
                                            if ( collideZ + GetUnitBodySize(u) >= s__Missile_z[this] - (s__Missile_collision[(this)]) ) and ( collideZ <= s__Missile_z[this] + (s__Missile_collision[(this)]) ) then // INLINED!!
                                                // Mark as hit.
                                                call SaveUnitHandle(Missile___HASH, this, GetHandleId(u), u)
                                                if s__WaveTrapSkills__WaveTrapMissile_onCollide(this , u) then
                                                    call s__WaveTrapSkills__WaveTrapMissile_missileTerminateP(this)
                                                    exitwhen true
                                                endif
                                            endif
    








                                    endif
                                endif
                            endloop
                        endif

                    
                    // Runs destructable collision.






                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__WaveTrapSkills__WaveTrapMissile_onFinish(this) then
                                call s__WaveTrapSkills__WaveTrapMissile_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.





                
                    // Runs every Missile_TIMER_TIMEOUT.





                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__WaveTrapSkills__WaveTrapMissile_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__WaveTrapSkills__WaveTrapMissile)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__WaveTrapSkills__WaveTrapMissile )]=Condition(( function s__WaveTrapSkills__WaveTrapMissile_missileIterateP)) // INLINED!!
        endfunction

    function WaveTrapSkills__WaveTrapLaunchProjectile takes unit source,real tx,real ty,real radius,real duration,string modelPath returns nothing
        local integer missile
        local real sx
        local real sy
        if not WaveTrapSkills__WaveTrapUnitAlive(source) then
            return
        endif
        set sx=GetUnitX(source)
        set sy=GetUnitY(source)
        set missile=s__Missile_createXYZ(sx , sy , WaveTrapSkills_WAVE_HSOR_PROJECTILE_START_Z , tx , ty , WaveTrapSkills_WAVE_HSOR_PROJECTILE_START_Z)
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=GetOwningPlayer(source)
        call s__Missile__set_model(missile,modelPath)
        call s__Missile__set_scale(missile,WaveSkillVisualShieldScaleForRadius(radius))
        set s__Missile_collision[missile]=WaveTrapSkills_WAVE_HSOR_PROJECTILE_CATCH_RADIUS
        call s__Missile__set_arc(missile,WaveTrapSkills_WAVE_HSOR_PROJECTILE_ARC)
        set s__Missile_speed[(missile)]=((WaveTrapSkills_WAVE_HSOR_PROJECTILE_SPEED)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
        set WaveTrapSkills__WaveTrapMissileOwner[missile]=GetOwningPlayer(source)
        set WaveTrapSkills__WaveTrapMissileRadius[missile]=radius
        set WaveTrapSkills__WaveTrapMissileDuration[missile]=duration
        set WaveTrapSkills__WaveTrapMissileModel[missile]=modelPath
        set WaveTrapSkills__WaveTrapMissilePlanted[missile]=false
        call s__WaveTrapSkills__WaveTrapMissile_launch(missile)
    endfunction

    function WaveTrapSkills__WaveTrapStartCast takes unit source,real tx,real ty,real radius,real duration,string modelPath returns nothing
        local integer castId= WaveTrapSkills__WaveTrapCastCount + 1
        local integer hid= GetHandleId(source)
        set WaveTrapSkills__WaveTrapCastCount=castId
        set WaveTrapSkills__WaveTrapCastSource[castId]=source
        set WaveTrapSkills__WaveTrapCastTargetX[castId]=tx
        set WaveTrapSkills__WaveTrapCastTargetY[castId]=ty
        set WaveTrapSkills__WaveTrapCastRemaining[castId]=WaveTrapSkills_WAVE_HSOR_WINDUP
        set WaveTrapSkills__WaveTrapCastRadius[castId]=radius
        set WaveTrapSkills__WaveTrapCastDuration[castId]=duration
        set WaveTrapSkills__WaveTrapCastModel[castId]=modelPath
        set WaveTrapSkills__WaveTrapCastPaused[castId]=true
        call WaveTrapSkills__WaveTrapAddCast(castId)
        call SaveInteger(Table__ht, (WaveTrapSkills__WaveTrapActiveCastByUnit), (hid), ( castId)) // INLINED!!
        call IssueImmediateOrder(source, "stop")
        call SetUnitAnimation(source, "spell")
        call PauseUnit(source, true)
    endfunction

    function WaveTrapSkills__WaveTrapUpdateStuns takes nothing returns nothing
        local integer playerId= 0
        local integer trapId
        local unit hero
        local real dx
        local real dy
        loop
            exitwhen playerId >= bj_MAX_PLAYER_SLOTS
            set WaveTrapSkills__WaveTrapComputedStunByPlayer[playerId]=0.0
            set playerId=playerId + 1
        endloop

        set trapId=WaveTrapSkills__WaveTrapHead
        loop
            exitwhen trapId == 0
            set playerId=0
            loop
                exitwhen playerId >= bj_MAX_PLAYER_SLOTS
                set hero=PlayerHero[playerId]
                if WaveTrapSkills__WaveTrapCanCatchHero(WaveTrapSkills__WaveTrapOwner[trapId] , hero) then
                    set dx=GetUnitX(hero) - WaveTrapSkills__WaveTrapX[trapId]
                    set dy=GetUnitY(hero) - WaveTrapSkills__WaveTrapY[trapId]
                    if dx * dx + dy * dy <= WaveTrapSkills__WaveTrapRadius[trapId] * WaveTrapSkills__WaveTrapRadius[trapId] and WaveTrapSkills__WaveTrapRemaining[trapId] > WaveTrapSkills__WaveTrapComputedStunByPlayer[playerId] then
                        set WaveTrapSkills__WaveTrapComputedStunByPlayer[playerId]=WaveTrapSkills__WaveTrapRemaining[trapId]
                    endif
                endif
                set playerId=playerId + 1
            endloop
            set trapId=WaveTrapSkills__WaveTrapNext[trapId]
        endloop

        set playerId=0
        loop
            exitwhen playerId >= bj_MAX_PLAYER_SLOTS
            set hero=PlayerHero[playerId]
            if hero != null and GetUnitTypeId(hero) != 0 and WaveTrapSkills__WaveTrapComputedStunByPlayer[playerId] > 0.0 then
                if not WaveTrapSkills__WaveTrapHeroStunnedByPlayer[playerId] then
                    call IssueImmediateOrder(hero, "stop")
                    call PauseUnit(hero, true)
                    set WaveTrapSkills__WaveTrapHeroStunnedByPlayer[playerId]=true
                endif
            else
                if WaveTrapSkills__WaveTrapHeroStunnedByPlayer[playerId] and hero != null and GetUnitTypeId(hero) != 0 and UnitAlive(hero) then
                    call PauseUnit(hero, false)
                endif
                set WaveTrapSkills__WaveTrapHeroStunnedByPlayer[playerId]=false
            endif
            set playerId=playerId + 1
        endloop
        set hero=null
    endfunction

    function WaveTrapSkills__WaveTrapOnTick takes nothing returns nothing
        local integer castId= WaveTrapSkills__WaveTrapCastHead
        local integer nextCastId
        local integer trapId= WaveTrapSkills__WaveTrapHead
        local integer nextTrapId
        loop
            exitwhen castId == 0
            set nextCastId=WaveTrapSkills__WaveTrapCastNext[castId]
            if not WaveTrapSkills__WaveTrapUnitAlive(WaveTrapSkills__WaveTrapCastSource[castId]) then
                call WaveTrapSkills__WaveTrapDestroyCast(castId)
            else
                set WaveTrapSkills__WaveTrapCastRemaining[castId]=WaveTrapSkills__WaveTrapCastRemaining[castId] - WaveTrapSkills__WAVE_HSOR_TICK
                if WaveTrapSkills__WaveTrapCastRemaining[castId] <= 0.0 then
                    call WaveTrapSkills__WaveTrapLaunchProjectile(WaveTrapSkills__WaveTrapCastSource[castId] , WaveTrapSkills__WaveTrapCastTargetX[castId] , WaveTrapSkills__WaveTrapCastTargetY[castId] , WaveTrapSkills__WaveTrapCastRadius[castId] , WaveTrapSkills__WaveTrapCastDuration[castId] , WaveTrapSkills__WaveTrapCastModel[castId])
                    call WaveTrapSkills__WaveTrapDestroyCast(castId)
                endif
            endif
            set castId=nextCastId
        endloop

        loop
            exitwhen trapId == 0
            set nextTrapId=WaveTrapSkills__WaveTrapNext[trapId]
            set WaveTrapSkills__WaveTrapRemaining[trapId]=WaveTrapSkills__WaveTrapRemaining[trapId] - WaveTrapSkills__WAVE_HSOR_TICK
            if WaveTrapSkills__WaveTrapRemaining[trapId] <= 0.0 then
                call WaveTrapSkills__WaveTrapDestroy(trapId)
            endif
            set trapId=nextTrapId
        endloop

        call WaveTrapSkills__WaveTrapUpdateStuns()

    endfunction


    function WaveTrapSkills__WaveTrapCleanupWaveDeath takes nothing returns nothing
        local unit deadUnit= (WaveEventUnit) // INLINED!!
        local integer hid
        local integer castId
        local integer unitTypeId
        if deadUnit == null or GetUnitTypeId(deadUnit) == 0 then
            return
        endif
        set unitTypeId=GetUnitTypeId(deadUnit)
        if unitTypeId != WaveTrapSkills_WAVE_HSOR_UNIT_ID and unitTypeId != WaveTrapSkills_WAVE_HSOR_BOSS_UNIT_ID then
            return
        endif
        set hid=GetHandleId(deadUnit)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveTrapSkills__WaveTrapNextCastMs), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveTrapSkills__WaveTrapNextCastMs), (hid)) // INLINED!!
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveTrapSkills__WaveTrapActiveCastByUnit), (hid))) then // INLINED!!
            set castId=(LoadInteger(Table__ht, (WaveTrapSkills__WaveTrapActiveCastByUnit), (hid))) // INLINED!!
            call WaveTrapSkills__WaveTrapDestroyCast(castId)
        endif
    endfunction

    function WaveTrapSkills__WaveTrapOnPlayerUnitDeath takes nothing returns boolean
        local unit deadUnit= GetTriggerUnit()
        local integer playerId= 0
        if deadUnit == null then
            return false
        endif
        loop
            exitwhen playerId >= bj_MAX_PLAYER_SLOTS
            if PlayerHero[playerId] == deadUnit then
                if WaveTrapSkills__WaveTrapHeroStunnedByPlayer[playerId] then
                    call PauseUnit(deadUnit, false)
                    set WaveTrapSkills__WaveTrapHeroStunnedByPlayer[playerId]=false
                    set WaveTrapSkills__WaveTrapComputedStunByPlayer[playerId]=0.0
                endif
                set playerId=bj_MAX_PLAYER_SLOTS
            endif
            set playerId=playerId + 1
        endloop
        set deadUnit=null
        return false
    endfunction

    function WaveTrapSkillsTryExecute takes unit source,unit target,integer nowMs returns boolean
        local integer hid
        local integer nextMs
        local real radius
        local real duration
        local string modelPath
        local boolean isBoss= false
        if not WaveTrapSkills__WaveTrapUnitAlive(source) then
            return false
        endif
        if WaveTrapSkills__WaveTrapIsBoss(source) then
            set isBoss=true
        elseif GetUnitTypeId(source) != WaveTrapSkills_WAVE_HSOR_UNIT_ID then
            return false
        endif
        if target == null or GetUnitTypeId(target) == 0 or not UnitAlive(target) or not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif
        if not WaveTrapSkills__WaveTrapTargetInCastRange(source , target) then
            return false
        endif

        set hid=GetHandleId(source)
        if hid == 0 then
            return false
        endif
        if (HaveSavedInteger(Table__ht, (WaveTrapSkills__WaveTrapActiveCastByUnit), (hid))) and (LoadInteger(Table__ht, (WaveTrapSkills__WaveTrapActiveCastByUnit), (hid))) != 0 then // INLINED!!
            return true
        endif
        if not (HaveSavedInteger(Table__ht, (WaveTrapSkills__WaveTrapNextCastMs), (hid))) then // INLINED!!
            if isBoss then
                call SaveInteger(Table__ht, (WaveTrapSkills__WaveTrapNextCastMs), (hid), ( nowMs + WaveTrapSkills__WaveTrapRandomMsRange(WaveTrapSkills_WAVE_HSOR_BOSS_INITIAL_DELAY_MIN , WaveTrapSkills_WAVE_HSOR_BOSS_INITIAL_DELAY_MAX))) // INLINED!!
            else
                call SaveInteger(Table__ht, (WaveTrapSkills__WaveTrapNextCastMs), (hid), ( nowMs + WaveTrapSkills__WaveTrapRandomMsRange(WaveTrapSkills_WAVE_HSOR_INITIAL_DELAY_MIN , WaveTrapSkills_WAVE_HSOR_INITIAL_DELAY_MAX))) // INLINED!!
            endif
            return false
        endif

        set nextMs=(LoadInteger(Table__ht, (WaveTrapSkills__WaveTrapNextCastMs), (hid))) // INLINED!!
        if nowMs < nextMs then
            return false
        endif

        if isBoss then
            set radius=WaveTrapSkills_WAVE_HSOR_BOSS_TRAP_RADIUS
            set duration=WaveTrapSkills_WAVE_HSOR_BOSS_TRAP_DURATION
            set modelPath=WaveTrapSkills_WAVE_HSOR_BOSS_PROJECTILE_MODEL
            call SaveInteger(Table__ht, (WaveTrapSkills__WaveTrapNextCastMs), (hid), ( nowMs + WaveTrapSkills__WaveTrapRandomMsRange(WaveTrapSkills_WAVE_HSOR_BOSS_COOLDOWN_MIN , WaveTrapSkills_WAVE_HSOR_BOSS_COOLDOWN_MAX))) // INLINED!!
        else
            set radius=WaveTrapSkills_WAVE_HSOR_TRAP_RADIUS
            set duration=WaveTrapSkills_WAVE_HSOR_TRAP_DURATION
            set modelPath=WaveTrapSkills_WAVE_HSOR_PROJECTILE_MODEL
            call SaveInteger(Table__ht, (WaveTrapSkills__WaveTrapNextCastMs), (hid), ( nowMs + WaveTrapSkills__WaveTrapRandomMsRange(WaveTrapSkills_WAVE_HSOR_COOLDOWN_MIN , WaveTrapSkills_WAVE_HSOR_COOLDOWN_MAX))) // INLINED!!
        endif

        call WaveTrapSkills__WaveTrapStartCast(source , GetUnitX(target) , GetUnitY(target) , radius , duration , modelPath)
        return true
    endfunction

    function WaveTrapSkills__Init takes nothing returns nothing
        set WaveTrapSkills__WaveTrapNextCastMs=s__Table_create()
        set WaveTrapSkills__WaveTrapActiveCastByUnit=s__Table_create()
        set WaveTrapSkills__WaveTrapTimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(WaveTrapSkills__WaveTrapTimer , TIMER_DEBUG_TAG_UNIT_SKILLS)
        set WaveTrapSkills__WaveTrapTimerRunning=true
        call TimerStart(WaveTrapSkills__WaveTrapTimer, WaveTrapSkills__WAVE_HSOR_TICK, true, function WaveTrapSkills__WaveTrapOnTick)
        call RegisterWaveDeathEvent(function WaveTrapSkills__WaveTrapCleanupWaveDeath)
        call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_DEATH , function WaveTrapSkills__WaveTrapOnPlayerUnitDeath)
    endfunction



    function WaveWaveformSkills___WaveWaveformSecToMs takes real sec returns integer
        if sec <= 0.0 then
            return 0
        endif
        return R2I(sec * 1000.0 + 0.5)
    endfunction

    function WaveWaveformSkills___WaveWaveformRandomMsRange takes real minSec,real maxSec returns integer
        local real lo= minSec
        local real hi= maxSec
        if hi < lo then
            set lo=maxSec
            set hi=minSec
        endif
        if hi <= 0.0 then
            return 0
        endif
        if lo < 0.0 then
            set lo=0.0
        endif
        return WaveWaveformSkills___WaveWaveformSecToMs(GetRandomReal(lo, hi))
    endfunction

    function WaveWaveformSkills___WaveWaveformUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WaveWaveformSkills___WaveWaveformCreateImpactFx takes real x,real y returns nothing
        local effect fx= AddSpecialEffect(WaveWaveformSkills_WAVE_HWT3_IMPACT_FX, x, y)
        call DestroyEffect(fx)
        set fx=null
    endfunction

    function WaveWaveformSkills___WaveWaveformCanDamage takes integer missile,unit target returns boolean
        if target == null or not UnitAlive(target) then
            return false
        endif
        if not IsUnitEnemy(target, s__Missile_owner[missile]) then
            return false
        endif
        return true
    endfunction

        function s__WaveWaveformSkills___WaveWaveformMissile_onPeriod takes integer missile returns boolean
            local unit hit
            local unit source= s__Missile_source[missile]
            local real x= s__Missile_x[missile]
            local real y= s__Missile_y[missile]
            local effect fx
            if not WaveWaveformSkills___WaveWaveformUnitAlive(source) then
                set source=null
                return true
            endif
            set WaveWaveformSkills___WaveWaveformMissileTrailElapsed[missile]=WaveWaveformSkills___WaveWaveformMissileTrailElapsed[missile] + 0.03125
            loop
                exitwhen WaveWaveformSkills___WaveWaveformMissileTrailElapsed[missile] < WaveWaveformSkills_WAVE_HWT3_TRAIL_INTERVAL
                set WaveWaveformSkills___WaveWaveformMissileTrailElapsed[missile]=WaveWaveformSkills___WaveWaveformMissileTrailElapsed[missile] - WaveWaveformSkills_WAVE_HWT3_TRAIL_INTERVAL
                set fx=AddSpecialEffect(WaveWaveformSkills_WAVE_HWT3_TRAIL_FX, x, y)
                call DestroyEffect(fx)
                set fx=null
            endloop
            call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, x, y, WaveWaveformSkills___WaveWaveformMissileAoe[missile], null)
            loop
                set hit=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
                exitwhen hit == null
                call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, hit)
                if WaveWaveformSkills___WaveWaveformCanDamage(missile , hit) and not (HaveSavedHandle(Missile___HASH, (missile), GetHandleId((hit)))) then // INLINED!!
                    call s__Missile_hitWidget(missile,hit)
                    call UnitDamageTarget(source, hit, WaveWaveformSkills___WaveWaveformMissileDamage[missile], false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                endif
            endloop
            set hit=null
            set source=null
            return false
        endfunction

        function s__WaveWaveformSkills___WaveWaveformMissile_onFinish takes integer missile returns boolean
            local unit hit
            local unit source= s__Missile_source[missile]
            local real x= s__Missile_x[missile]
            local real y= s__Missile_y[missile]
            local effect fx
            if source != null and GetUnitTypeId(source) != 0 then
                call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, x, y, WaveWaveformSkills___WaveWaveformMissileAoe[missile], null)
                loop
                    set hit=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
                    exitwhen hit == null
                    call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, hit)
                    if WaveWaveformSkills___WaveWaveformCanDamage(missile , hit) then
                        call UnitDamageTarget(source, hit, WaveWaveformSkills___WaveWaveformMissileDamage[missile], false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    endif
                endloop
            endif
            call WaveWaveformSkills___WaveWaveformCreateImpactFx(x , y)
            set hit=null
            set source=null
            return true
        endfunction

        function s__WaveWaveformSkills___WaveWaveformMissile_onRemove takes integer missile returns boolean
            local unit source= s__Missile_source[missile]
            local integer hid= 0
            if source != null and GetUnitTypeId(source) != 0 then
                set hid=GetHandleId(source)
                if hid != 0 and (HaveSavedInteger(Table__ht, (WaveWaveformSkills___WaveWaveformActiveMissileByUnit), (hid))) and (LoadInteger(Table__ht, (WaveWaveformSkills___WaveWaveformActiveMissileByUnit), (hid))) == missile then // INLINED!!
                    call RemoveSavedInteger(Table__ht, (WaveWaveformSkills___WaveWaveformActiveMissileByUnit), (hid)) // INLINED!!
                endif
                call SetUnitPathing(source, true)
                call SetUnitTimeScale(source, 1.0)
                call SetUnitFlyHeight(source, 0.0, 99999.)
            endif
            set WaveWaveformSkills___WaveWaveformMissileAoe[missile]=0.0
            set WaveWaveformSkills___WaveWaveformMissileDamage[missile]=0.0
            set WaveWaveformSkills___WaveWaveformMissileTrailElapsed[missile]=0.0
            set source=null
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__WaveWaveformSkills___WaveWaveformMissile_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__WaveWaveformSkills___WaveWaveformMissile],missile)
            call Missile___StartPeriodic(si__WaveWaveformSkills___WaveWaveformMissile)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__WaveWaveformSkills___WaveWaveformMissile_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__WaveWaveformSkills___WaveWaveformMissile_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__WaveWaveformSkills___WaveWaveformMissile)
            endif
        endfunction
























        













    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__WaveWaveformSkills___WaveWaveformMissile_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__WaveWaveformSkills___WaveWaveformMissile])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__WaveWaveformSkills___WaveWaveformMissile_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.







































                    
                    // Runs destructable collision.






                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__WaveWaveformSkills___WaveWaveformMissile_onFinish(this) then
                                call s__WaveWaveformSkills___WaveWaveformMissile_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.





                
                    // Runs every Missile_TIMER_TIMEOUT.

                        if s__Missile_allocated[this] and s__WaveWaveformSkills___WaveWaveformMissile_onPeriod(this) then
                            call s__WaveWaveformSkills___WaveWaveformMissile_missileTerminateP(this)
                        endif

                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__WaveWaveformSkills___WaveWaveformMissile_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__WaveWaveformSkills___WaveWaveformMissile)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__WaveWaveformSkills___WaveWaveformMissile )]=Condition(( function s__WaveWaveformSkills___WaveWaveformMissile_missileIterateP)) // INLINED!!
        endfunction

    function WaveWaveformSkills___WaveWaveformLaunch takes unit source,real tx,real ty,real aoe,real damage returns nothing
        local integer missile
        if not WaveWaveformSkills___WaveWaveformUnitAlive(source) then
            return
        endif
        if UnitAddAbility(source, 'Amrf') and UnitRemoveAbility(source, 'Amrf') then
        endif
        call SetUnitPathing(source, false)
        call SetUnitFlyHeight(source, 60.0, 99999.)
        set missile=s__Missile_createEx(source , tx , ty , 0.0)
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=GetOwningPlayer(source)
        set s__Missile_collision[missile]=0.0
        set s__Missile_speed[(missile)]=((WaveWaveformSkills_WAVE_HWT3_SPEED)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
        set WaveWaveformSkills___WaveWaveformMissileAoe[missile]=aoe
        set WaveWaveformSkills___WaveWaveformMissileDamage[missile]=damage
        set WaveWaveformSkills___WaveWaveformMissileTrailElapsed[missile]=0.0
        call SaveInteger(Table__ht, (WaveWaveformSkills___WaveWaveformActiveMissileByUnit), (GetHandleId(source)), ( missile)) // INLINED!!
        call s__WaveWaveformSkills___WaveWaveformMissile_launch(missile)
    endfunction

    function WaveWaveformSkills___WaveWaveformCleanupWaveDeath takes nothing returns nothing
        local unit deadUnit= (WaveEventUnit) // INLINED!!
        local integer hid
        local integer missile
        local integer unitTypeId
        if deadUnit == null or GetUnitTypeId(deadUnit) == 0 then
            return
        endif
        set unitTypeId=GetUnitTypeId(deadUnit)
        if unitTypeId != WaveWaveformSkills_WAVE_HWT3_UNIT_ID and unitTypeId != WaveWaveformSkills_WAVE_HWT3_BOSS_UNIT_ID then
            return
        endif
        set hid=GetHandleId(deadUnit)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveWaveformSkills___WaveWaveformNextCastMs), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveWaveformSkills___WaveWaveformNextCastMs), (hid)) // INLINED!!
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveWaveformSkills___WaveWaveformActiveMissileByUnit), (hid))) then // INLINED!!
            set missile=(LoadInteger(Table__ht, (WaveWaveformSkills___WaveWaveformActiveMissileByUnit), (hid))) // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveWaveformSkills___WaveWaveformActiveMissileByUnit), (hid)) // INLINED!!
            if missile != 0 then
                call s__Missile_terminate(missile)
            endif
        endif
    endfunction

    function WaveWaveformSkillsTryExecute takes unit source,unit target,integer nowMs returns boolean
        local integer hid
        local integer nextMs
        local real aoe
        local real damage
        local boolean isBoss= false
        if not WaveWaveformSkills___WaveWaveformUnitAlive(source) then
            return false
        endif
        if GetUnitTypeId(source) == WaveWaveformSkills_WAVE_HWT3_BOSS_UNIT_ID then
            set isBoss=true
        elseif GetUnitTypeId(source) != WaveWaveformSkills_WAVE_HWT3_UNIT_ID then
            return false
        endif
        if target == null or GetUnitTypeId(target) == 0 or not UnitAlive(target) or not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif

        set hid=GetHandleId(source)
        if hid == 0 then
            return false
        endif
        if (HaveSavedInteger(Table__ht, (WaveWaveformSkills___WaveWaveformActiveMissileByUnit), (hid))) and (LoadInteger(Table__ht, (WaveWaveformSkills___WaveWaveformActiveMissileByUnit), (hid))) != 0 then // INLINED!!
            return true
        endif
        if not (HaveSavedInteger(Table__ht, (WaveWaveformSkills___WaveWaveformNextCastMs), (hid))) then // INLINED!!
            if isBoss then
                call SaveInteger(Table__ht, (WaveWaveformSkills___WaveWaveformNextCastMs), (hid), ( nowMs + WaveWaveformSkills___WaveWaveformRandomMsRange(WaveWaveformSkills_WAVE_HWT3_BOSS_INITIAL_DELAY_MIN , WaveWaveformSkills_WAVE_HWT3_BOSS_INITIAL_DELAY_MAX))) // INLINED!!
            else
                call SaveInteger(Table__ht, (WaveWaveformSkills___WaveWaveformNextCastMs), (hid), ( nowMs + WaveWaveformSkills___WaveWaveformRandomMsRange(WaveWaveformSkills_WAVE_HWT3_INITIAL_DELAY_MIN , WaveWaveformSkills_WAVE_HWT3_INITIAL_DELAY_MAX))) // INLINED!!
            endif
            return false
        endif

        set nextMs=(LoadInteger(Table__ht, (WaveWaveformSkills___WaveWaveformNextCastMs), (hid))) // INLINED!!
        if nowMs < nextMs then
            return false
        endif

        call IssueImmediateOrder(source, "stop")
        call SetUnitAnimation(source, "spell")
        if isBoss then
            set aoe=WaveWaveformSkills_WAVE_HWT3_BOSS_AOE
            set damage=WaveWaveformSkills_WAVE_HWT3_BOSS_DAMAGE
            call SaveInteger(Table__ht, (WaveWaveformSkills___WaveWaveformNextCastMs), (hid), ( nowMs + WaveWaveformSkills___WaveWaveformRandomMsRange(WaveWaveformSkills_WAVE_HWT3_BOSS_COOLDOWN_MIN , WaveWaveformSkills_WAVE_HWT3_BOSS_COOLDOWN_MAX))) // INLINED!!
        else
            set aoe=WaveWaveformSkills_WAVE_HWT3_AOE
            set damage=WaveWaveformSkills_WAVE_HWT3_DAMAGE
            call SaveInteger(Table__ht, (WaveWaveformSkills___WaveWaveformNextCastMs), (hid), ( nowMs + WaveWaveformSkills___WaveWaveformRandomMsRange(WaveWaveformSkills_WAVE_HWT3_COOLDOWN_MIN , WaveWaveformSkills_WAVE_HWT3_COOLDOWN_MAX))) // INLINED!!
        endif
        call WaveWaveformSkills___WaveWaveformLaunch(source , GetUnitX(target) , GetUnitY(target) , aoe , damage)
        return true
    endfunction

    function WaveWaveformSkills___Init takes nothing returns nothing
        set WaveWaveformSkills___WaveWaveformNextCastMs=s__Table_create()
        set WaveWaveformSkills___WaveWaveformActiveMissileByUnit=s__Table_create()
        call RegisterWaveDeathEvent(function WaveWaveformSkills___WaveWaveformCleanupWaveDeath)
    endfunction



    function IAManager___AILog takes string msg returns nothing
        if IAManager___AIDebugEnabled then
            call BJDebugMsg("[IAManager] " + msg)
        endif
    endfunction

    function IAManager___AILogLimited takes string msg returns nothing
        if not IAManager___AIDebugEnabled then
            return
        endif
        if IAManager___AIDebugLogsThisTick >= IAManager___AIDebugMaxLogsPerTick then
            return
        endif
        set IAManager___AIDebugLogsThisTick=IAManager___AIDebugLogsThisTick + 1
        call BJDebugMsg("[IAManager] " + msg)
    endfunction

    function IAManager___AIBossReinforcementRollInitialMs takes nothing returns integer
        return GetRandomInt(IAManager___AI_BOSS_REINFORCEMENT_INITIAL_MIN_MS, IAManager___AI_BOSS_REINFORCEMENT_INITIAL_MAX_MS)
    endfunction

    function IAManager___AIBossReinforcementRollCooldownMs takes nothing returns integer
        return GetRandomInt(IAManager___AI_BOSS_REINFORCEMENT_COOLDOWN_MIN_MS, IAManager___AI_BOSS_REINFORCEMENT_COOLDOWN_MAX_MS)
    endfunction

    function IAManager___AIBossReinforcementSupportsUnitType takes integer unitTypeId returns boolean
        return unitTypeId == 'zA01' or unitTypeId == 'zA02' or unitTypeId == 'zA03' or unitTypeId == 'zA04' or unitTypeId == 'zA05' or unitTypeId == 'zA06' or unitTypeId == 'zA07' or unitTypeId == 'zA08' or unitTypeId == 'zA09'
    endfunction

    function IAManager___AIBossReinforcementAnimationForUnitType takes integer unitTypeId returns string
        if unitTypeId == 'zA01' then
            return "attack"
        elseif unitTypeId == 'zA02' then
            return "stand victory"
        elseif unitTypeId == 'zA03' then
            return "spell"
        elseif unitTypeId == 'zA04' then
            return "stand victory"
        elseif unitTypeId == 'zA05' then
            return "spell"
        elseif unitTypeId == 'zA06' then
            return "spell"
        elseif unitTypeId == 'zA07' then
            return "stand victory"
        elseif unitTypeId == 'zA08' then
            return "attack"
        elseif unitTypeId == 'zA09' then
            return "Birth"
        endif
        return ""
    endfunction

    function IAManager___AIBossReinforcementApplySlots takes integer w,integer maxWave returns nothing
        if w == 0 then
            return
        endif
        if maxWave < 1 then
            return
        elseif maxWave > 10 then
            set maxWave=10
        endif

        call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HPEA , 'hpea' , 1 , false , 2 , 1 , 1 , - 1 , false , AI_PROFILE_MELEE , 0 , 0 , 1.00)
        if maxWave >= 2 then
            call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HMIL , 'hmil' , 1 , false , 2 , 1 , 2 , - 1 , false , AI_PROFILE_MELEE , 0 , 0 , 1.00)
        endif
        if maxWave >= 3 then
            call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HFOO , 'hfoo' , 1 , false , 2 , 1 , 3 , - 1 , false , AI_PROFILE_MELEE , 0 , 0 , 1.00)
        endif
        if maxWave >= 4 then
            call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HRIF , 'hrif' , 1 , false , 2 , 1 , 4 , - 1 , false , AI_PROFILE_WAVE4_SPELL , 0 , 0 , 1.00)
        endif
        if maxWave >= 5 then
            call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HKNI , 'hkni' , 1 , false , 2 , 1 , 5 , - 1 , false , AI_PROFILE_MELEE , 0 , 0 , 1.00)
        endif
        if maxWave >= 6 then
            call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HMTM , 'hmtm' , 1 , false , 2 , 1 , 6 , - 1 , false , AI_PROFILE_WAVE6_SPELL , 0 , 0 , 1.00)
        endif
        if maxWave >= 7 then
            call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HMPR , 'hmpr' , 1 , false , 2 , 1 , 7 , - 1 , false , AI_PROFILE_WAVE7_SPELL , 0 , 0 , 1.10)
        endif
        if maxWave >= 8 then
            call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HSOR , 'hsor' , 1 , false , 2 , 1 , 8 , - 1 , false , AI_PROFILE_WAVE8_SPELL , 0 , 0 , 1.20)
        endif
        if maxWave >= 9 then
            call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HMTT , 'hmtt' , 1 , false , 2 , 1 , 9 , - 1 , false , AI_PROFILE_WAVE9_SPELL , 0 , 0 , 1.00)
        endif
        if maxWave >= 10 then
            call s__Wave_upsertSlotExByPlayers(w,AI_STAGE1_SLOT_GROUP_HWT3 , 'hwt3' , 1 , false , 2 , 1 , 10 , - 1 , false , AI_PROFILE_WAVE10_SPELL , 0 , 0 , 1.00)
        endif
    endfunction

    function IAManager___AICalcDynamicBudget takes integer unitCount returns integer
        local integer b
        if unitCount <= 200 then
            set b=48
        elseif unitCount <= 500 then
            set b=72
        elseif unitCount <= 1000 then
            set b=96
        else
            set b=128
        endif
        return AIClampInt(b , IAManager___AI_MIN_BUDGET_PER_TICK , IAManager___AI_MAX_BUDGET_PER_TICK)
    endfunction

    function IAManager___AICalcDynamicTick takes integer unitCount,boolean combatSeen returns integer
        local integer t
        if unitCount <= 200 then
            set t=200
        elseif unitCount <= 500 then
            set t=250
        elseif unitCount <= 1000 then
            set t=300
        else
            set t=333
        endif
        if not combatSeen then
            set t=t + 50
        endif
        return AIClampInt(t , IAManager___AI_MIN_TICK_MS , IAManager___AI_MAX_TICK_MS)
    endfunction

    function IAManager___AIHasBehaviorFlag takes integer flags,integer mask returns boolean
        if mask <= 0 then
            return false
        endif
        return ModuloInteger(flags / mask, 2) == 1
    endfunction

    function IAManager___AIDebugPassesFilter takes unit u,integer waveId returns boolean
        if IAManager___AIDebugWaveFilter > 0 and waveId != IAManager___AIDebugWaveFilter then
            return false
        endif
        if IAManager___AIDebugUnitTypeFilter != 0 then
            if u == null then
                return false
            endif
            if GetUnitTypeId(u) != IAManager___AIDebugUnitTypeFilter then
                return false
            endif
        endif
        return true
    endfunction

    function IAManager___AIDistanceSqUnits takes unit a,unit b returns real
        local real dx
        local real dy
        set dx=GetUnitX(a) - GetUnitX(b)
        set dy=GetUnitY(a) - GetUnitY(b)
        return dx * dx + dy * dy
    endfunction

    function IAManager___AIDistanceSqPoint takes real x1,real y1,real x2,real y2 returns real
        local real dx= x1 - x2
        local real dy= y1 - y2
        return dx * dx + dy * dy
    endfunction

    function IAManager___AIGetKeepDistanceBandHalf takes real preferredRange returns real
        local real bandHalf
        if preferredRange <= 0.0 then
            return 72.0
        endif
        set bandHalf=preferredRange * 0.06
        if bandHalf < 72.0 then
            set bandHalf=72.0
        endif
        return bandHalf
    endfunction

    function IAManager___AIShouldUseKeepDistanceBand takes integer profileId returns boolean
        return profileId == AI_PROFILE_WAVE4_SPELL
    endfunction

    function IAManager___AIMaybeIssueMoveOrder takes unit u,integer hid,real x,real y returns nothing
        local boolean shouldIssue= true
        local real lastX
        local real lastY
        if (HaveSavedInteger(Table__ht, (IAManager___AIUnitLastOrderType), (hid))) and (LoadInteger(Table__ht, (IAManager___AIUnitLastOrderType), (hid))) == IAManager___AI_ORDER_MOVE then // INLINED!!
            set lastX=(LoadReal(Table__ht, (((IAManager___AIUnitLastOrderX))), (hid))) // INLINED!!
            set lastY=(LoadReal(Table__ht, (((IAManager___AIUnitLastOrderY))), (hid))) // INLINED!!
            if IAManager___AIDistanceSqPoint(lastX , lastY , x , y) <= ( 96.0 * 96.0 ) then
                set shouldIssue=false
            endif
        endif
        if shouldIssue and IssuePointOrder(u, "move", x, y) then
            call SaveInteger(Table__ht, (IAManager___AIUnitLastOrderType), (hid), ( IAManager___AI_ORDER_MOVE)) // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIUnitLastOrderTarget), (hid), ( 0)) // INLINED!!
            call SaveReal(Table__ht, (((IAManager___AIUnitLastOrderX))), (hid), (( x)*1.0)) // INLINED!!
            call SaveReal(Table__ht, (((IAManager___AIUnitLastOrderY))), (hid), (( y)*1.0)) // INLINED!!
        endif
    endfunction

    function IAManager___AIMoveToTargetRange takes unit u,unit target,integer hid,real desiredRange returns nothing
        local real angle
        local real x
        local real y
        if u == null or target == null then
            return
        endif
        if desiredRange < 64.0 then
            set desiredRange=64.0
        endif
        set angle=Atan2(GetUnitY(u) - GetUnitY(target), GetUnitX(u) - GetUnitX(target))
        set x=GetUnitX(target) + Cos(angle) * desiredRange
        set y=GetUnitY(target) + Sin(angle) * desiredRange
        call IAManager___AIMaybeIssueMoveOrder(u , hid , x , y)
    endfunction

    function IAManager___AIGetUnitHpPct takes unit u returns real
        local real maxHp= GetUnitState(u, UNIT_STATE_MAX_LIFE)
        if maxHp <= 0.0 then
            return 100.0
        endif
        return GetUnitState(u, UNIT_STATE_LIFE) * 100.0 / maxHp
    endfunction
    
    function IAManager___AIIsEnemyHero takes unit source,unit target returns boolean
        if source == null or target == null then
            return false
        endif
        if GetUnitTypeId(target) == 0 then
            return false
        endif
        if not UnitAlive(target) then
            return false
        endif
        if not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif
        if not IsUnitEnemy(target, GetOwningPlayer(source)) then
            return false
        endif
        return true
    endfunction

    function IAManager___AIGetFallbackObjectiveTarget takes unit source returns unit
        local unit target
        if source == null then
            return null
        endif
        set target=GetTenderUnit()
        if target == null or GetUnitTypeId(target) == 0 or not UnitAlive(target) then
            set target=null
            return null
        endif
        if not IsUnitEnemy(target, GetOwningPlayer(source)) then
            set target=null
            return null
        endif
        return target
    endfunction

    function IAManager___AIIsCombatObjective takes unit source,unit target returns boolean
        if IAManager___AIIsEnemyHero(source , target) then
            return true
        endif
        return IAManager___AIGetFallbackObjectiveTarget(source) == target
    endfunction

    function IAManager___AIHasAliveEnemyHeroTracked takes unit source returns boolean
        local integer i= 0
        local unit u
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set u=s__IAManager___AITrackedHeroByPlayer[i]
            if IAManager___AIIsEnemyHero(source , u) then
                set u=null
                return true
            endif
            set i=i + 1
        endloop
        set u=null
        return false
    endfunction

    function IAManager___AIGetNearestTrackedHeroDistSq takes unit source,boolean enemyOnly returns real
        local integer i= 0
        local unit u
        local real dSq
        local real best= - 1.0
        if source == null then
            return - 1.0
        endif
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set u=s__IAManager___AITrackedHeroByPlayer[i]
            if u != null and GetUnitTypeId(u) != 0 and UnitAlive(u) and IsUnitType(u, UNIT_TYPE_HERO) then
                if ( not enemyOnly ) or IAManager___AIIsEnemyHero(source , u) then
                    set dSq=IAManager___AIDistanceSqUnits(source , u)
                    if best < 0.0 or dSq < best then
                        set best=dSq
                    endif
                endif
            endif
            set i=i + 1
        endloop
        set u=null
        return best
    endfunction

    function IAManager___AICountEnemyHeroesInRadius takes unit source,real radius returns integer
        local integer count= 0
        local integer i= 0
        local unit u
        local boolean hasTracked= false
        local real radiusSq

        if source == null or radius <= 0.0 then
            return 0
        endif
        set radiusSq=radius * radius

        // Fast path: heroes registrados por jugador (ideal para mapas grandes).
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set u=s__IAManager___AITrackedHeroByPlayer[i]
            if u != null and GetUnitTypeId(u) != 0 and UnitAlive(u) and IsUnitType(u, UNIT_TYPE_HERO) then
                set hasTracked=true
                if IAManager___AIIsEnemyHero(source , u) and IAManager___AIDistanceSqUnits(source , u) <= radiusSq then
                    set count=count + 1
                endif
            endif
            set i=i + 1
        endloop
        if hasTracked then
            set u=null
            return count
        endif
        if not IAManager___AIUseGroupFallbackNoHeroes then
            set u=null
            return count
        endif

        call GroupEnumUnitsInRange(IAManager___AITempGroup, GetUnitX(source), GetUnitY(source), radius, null)
        loop
            set u=FirstOfGroup(IAManager___AITempGroup)
            exitwhen u == null
            call GroupRemoveUnit(IAManager___AITempGroup, u)
            if IAManager___AIIsEnemyHero(source , u) then
                set count=count + 1
            endif
        endloop

        set u=null
        return count
    endfunction

    function IAManager___AISelectTargetHero takes unit source,real acquireRange,integer behaviorFlags,real threatWeight returns unit
        local unit best= null
        local integer i= 0
        local unit u
        local real distSq
        local real acquireRangeSq
        local real hpPct
        local real score
        local real bestScore= - 999999.0
        local boolean hasTracked= false

        if source == null then
            return null
        endif
        if acquireRange <= 0.0 then
            set acquireRange=900.0
        endif
        if threatWeight <= 0.0 then
            set threatWeight=1.0
        endif
        set acquireRangeSq=acquireRange * acquireRange

        // Fast path: heroes registrados por jugador (ideal para mapas grandes).
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set u=s__IAManager___AITrackedHeroByPlayer[i]
            if u != null and GetUnitTypeId(u) != 0 and UnitAlive(u) and IsUnitType(u, UNIT_TYPE_HERO) then
                set hasTracked=true
                if IAManager___AIIsEnemyHero(source , u) then
                    set distSq=IAManager___AIDistanceSqUnits(source , u)
                    if distSq <= acquireRangeSq then
                        set score=acquireRangeSq - distSq

                        if IAManager___AIHasBehaviorFlag(behaviorFlags , AI_BEHAVIOR_LOW_HP_BIAS) then
                            set hpPct=IAManager___AIGetUnitHpPct(u)
                            if hpPct <= 60.0 then
                                set score=score + ( 60.0 - hpPct ) * 3.0
                            endif
                        endif

                        set score=score * threatWeight
                        if score > bestScore then
                            set bestScore=score
                            set best=u
                        endif
                    endif
                endif
            endif
            set i=i + 1
        endloop
        if hasTracked then
            set u=null
            return best
        endif
        if not IAManager___AIUseGroupFallbackNoHeroes then
            set u=null
            return best
        endif

        call GroupEnumUnitsInRange(IAManager___AITempGroup, GetUnitX(source), GetUnitY(source), acquireRange, null)
        loop
            set u=FirstOfGroup(IAManager___AITempGroup)
            exitwhen u == null
            call GroupRemoveUnit(IAManager___AITempGroup, u)

            if IAManager___AIIsEnemyHero(source , u) then
                set distSq=IAManager___AIDistanceSqUnits(source , u)
                set score=acquireRangeSq - distSq

                if IAManager___AIHasBehaviorFlag(behaviorFlags , AI_BEHAVIOR_LOW_HP_BIAS) then
                    set hpPct=IAManager___AIGetUnitHpPct(u)
                    if hpPct <= 60.0 then
                        set score=score + ( 60.0 - hpPct ) * 3.0
                    endif
                endif

                set score=score * threatWeight
                if score > bestScore then
                    set bestScore=score
                    set best=u
                endif
            endif
        endloop

        set u=null
        return best
    endfunction

    function IAManager___AISelectCombatObjective takes unit source,real acquireRange,integer behaviorFlags,real threatWeight returns unit
        local unit target= IAManager___AISelectTargetHero(source , acquireRange , behaviorFlags , threatWeight)
        if target != null then
            return target
        endif
        if IAManager___AIHasAliveEnemyHeroTracked(source) then
            return null
        endif
        return IAManager___AIGetFallbackObjectiveTarget(source)
    endfunction

    function IAManager___AISelectFarthestTrackedHero takes unit source returns unit
        local integer i= 0
        local unit best= null
        local unit u
        local real distSq
        local real bestDistSq= - 1.0

        if source == null then
            return null
        endif

        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set u=s__IAManager___AITrackedHeroByPlayer[i]
            if IAManager___AIIsEnemyHero(source , u) then
                set distSq=IAManager___AIDistanceSqUnits(source , u)
                if distSq > bestDistSq then
                    set bestDistSq=distSq
                    set best=u
                endif
            endif
            set i=i + 1
        endloop

        set u=null
        return best
    endfunction

    function IAManager___AIResetOrderState takes integer hid returns nothing
        call SaveInteger(Table__ht, (IAManager___AIUnitLastOrderType), (hid), ( IAManager___AI_ORDER_NONE)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitLastOrderTarget), (hid), ( 0)) // INLINED!!
        call SaveReal(Table__ht, (((IAManager___AIUnitLastOrderX))), (hid), (( 0.0)*1.0)) // INLINED!!
        call SaveReal(Table__ht, (((IAManager___AIUnitLastOrderY))), (hid), (( 0.0)*1.0)) // INLINED!!
    endfunction


    function IAManager___AICancelBossReinforcementCast takes integer hid returns nothing
        local integer cast
        if hid == 0 or not (HaveSavedInteger(Table__ht, (IAManager___AIBossReinforcementCastByUnit), (hid))) then // INLINED!!
            return
        endif
        set cast=((LoadInteger(Table__ht, (IAManager___AIBossReinforcementCastByUnit), (hid)))) // INLINED!!
        call RemoveSavedInteger(Table__ht, (IAManager___AIBossReinforcementCastByUnit), (hid)) // INLINED!!
        if s__IAManager___AIBossReinforcementCast_windupFx[cast] != null then
            call DestroyEffect(s__IAManager___AIBossReinforcementCast_windupFx[cast])
            set s__IAManager___AIBossReinforcementCast_windupFx[cast]=null
        endif
        if s__IAManager___AIBossReinforcementCast_castText[cast] != null then
            call DestroyTrackedTextTag(s__IAManager___AIBossReinforcementCast_castText[cast] , TEXTTAG_DEBUG_AI)
            set s__IAManager___AIBossReinforcementCast_castText[cast]=null
        endif
        if s__IAManager___AIBossReinforcementCast_boss[cast] != null and GetUnitTypeId(s__IAManager___AIBossReinforcementCast_boss[cast]) != 0 then
            call PauseUnit(s__IAManager___AIBossReinforcementCast_boss[cast], false)
        endif
        if s__IAManager___AIBossReinforcementCast_t[cast] != null then
            call ReleaseTimer(s__IAManager___AIBossReinforcementCast_t[cast])
            set s__IAManager___AIBossReinforcementCast_t[cast]=null
        endif
        set s__IAManager___AIBossReinforcementCast_boss[cast]=null
        set s__IAManager___AIBossReinforcementCast_wave[cast]=0
        call s__IAManager___AIBossReinforcementCast_deallocate(cast)
    endfunction

    function IAManager___AIBossReinforcementApply takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer castId= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local integer cast= castId
        local unit boss
        local integer w
        local integer hid= 0

        if castId != 0 then
            set boss=s__IAManager___AIBossReinforcementCast_boss[cast]
            set w=s__IAManager___AIBossReinforcementCast_wave[cast]
            set hid=s__IAManager___AIBossReinforcementCast_bossHid[cast]
            if hid != 0 and (HaveSavedInteger(Table__ht, (IAManager___AIBossReinforcementCastByUnit), (hid))) and (LoadInteger(Table__ht, (IAManager___AIBossReinforcementCastByUnit), (hid))) == castId then // INLINED!!
                call RemoveSavedInteger(Table__ht, (IAManager___AIBossReinforcementCastByUnit), (hid)) // INLINED!!
            endif
            if s__IAManager___AIBossReinforcementCast_windupFx[cast] != null then
                call DestroyEffect(s__IAManager___AIBossReinforcementCast_windupFx[cast])
                set s__IAManager___AIBossReinforcementCast_windupFx[cast]=null
            endif
            if boss != null and GetUnitTypeId(boss) != 0 then
                call PauseUnit(boss, false)
            endif
            if boss != null and GetUnitTypeId(boss) != 0 and UnitAlive(boss) and w != 0 and s__Wave_isOperational(w) and s__Wave__staticgetindex(boss) == w then
                if IAManager___AI_BOSS_REINFORCEMENT_APPLY_FX != "" then
                    call DestroyEffect(AddSpecialEffectTarget(IAManager___AI_BOSS_REINFORCEMENT_APPLY_FX, boss, IAManager___AI_BOSS_REINFORCEMENT_ATTACH_POINT))
                endif
                call IAManager___AIBossReinforcementApplySlots(w , s__Wave_waveIndex[w])
                call s__Wave_refreshBoard(w)
                if hid != 0 then
                    call SaveInteger(Table__ht, (IAManager___AIBossReinforcementNextMs), (hid), ( s__IAManager___AIBossReinforcementCast_startedAtMs[cast] + IAManager___AI_BOSS_REINFORCEMENT_WINDUP_MS + (GetRandomInt(IAManager___AI_BOSS_REINFORCEMENT_COOLDOWN_MIN_MS, IAManager___AI_BOSS_REINFORCEMENT_COOLDOWN_MAX_MS)))) // INLINED!!
                    call SaveInteger(Table__ht, (IAManager___AIUnitNextAbilityMs), (hid), ( s__IAManager___AIBossReinforcementCast_startedAtMs[cast] + IAManager___AI_BOSS_REINFORCEMENT_WINDUP_MS + AIIntervalToMs(AIGetProfileThinkInterval(s__IAManager___AIBossReinforcementCast_profileId[cast]) , 250))) // INLINED!!
                    call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( s__IAManager___AIBossReinforcementCast_startedAtMs[cast] + IAManager___AI_BOSS_REINFORCEMENT_WINDUP_MS + AIIntervalToMs(AIGetProfileOrderInterval(s__IAManager___AIBossReinforcementCast_profileId[cast]) , 350))) // INLINED!!
                endif
            endif
            set s__IAManager___AIBossReinforcementCast_castText[cast]=null
            set s__IAManager___AIBossReinforcementCast_boss[cast]=null
            set s__IAManager___AIBossReinforcementCast_wave[cast]=0
            call s__IAManager___AIBossReinforcementCast_deallocate(cast)
        endif

        call ReleaseTimer(t)
        set boss=null
        set w=0
        set t=null
    endfunction

    function IAManager___AITryBossReinforcement takes unit u,integer hid,integer waveId,integer profileId returns boolean
        local integer w
        local integer cast
        local string animation
        local integer unitTypeId
        local integer channelLockUntil
        local integer nextReinforcementMs

        if u == null or hid == 0 then
            return false
        endif

        if (HaveSavedInteger(Table__ht, (IAManager___AIBossReinforcementCastByUnit), (hid))) then // INLINED!!
            return true
        endif

        set unitTypeId=GetUnitTypeId(u)
        if not IAManager___AIBossReinforcementSupportsUnitType(unitTypeId) then
            return false
        endif

        set channelLockUntil=(LoadInteger(Table__ht, (IAManager___AIUnitChannelLockUntilMs), (hid))) // INLINED!!
        if IAManager___AIClockMs < channelLockUntil then
            return false
        endif

        if not (HaveSavedInteger(Table__ht, (IAManager___AIBossReinforcementNextMs), (hid))) then // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIBossReinforcementNextMs), (hid), ( IAManager___AIClockMs + (GetRandomInt(IAManager___AI_BOSS_REINFORCEMENT_INITIAL_MIN_MS, IAManager___AI_BOSS_REINFORCEMENT_INITIAL_MAX_MS)))) // INLINED!!
            return false
        endif
        set nextReinforcementMs=(LoadInteger(Table__ht, (IAManager___AIBossReinforcementNextMs), (hid))) // INLINED!!
        if IAManager___AIClockMs < nextReinforcementMs then
            return false
        endif

        set w=(waveId)
        if w == 0 or not s__Wave_isOperational(w) then
            return false
        endif

        call IssueImmediateOrder(u, "stop")
        call IAManager___AIResetOrderState(hid)

        set animation=IAManager___AIBossReinforcementAnimationForUnitType(unitTypeId)
        if animation != "" then
            call SetUnitAnimation(u, animation)
            call QueueUnitAnimationBJ(u, "stand")
        endif

        set cast=s__IAManager___AIBossReinforcementCast__allocate()
        set s__IAManager___AIBossReinforcementCast_boss[cast]=u
        set s__IAManager___AIBossReinforcementCast_wave[cast]=w
        set s__IAManager___AIBossReinforcementCast_bossHid[cast]=hid
        set s__IAManager___AIBossReinforcementCast_profileId[cast]=profileId
        set s__IAManager___AIBossReinforcementCast_startedAtMs[cast]=IAManager___AIClockMs
        if IAManager___AI_BOSS_REINFORCEMENT_START_FX != "" then
            set s__IAManager___AIBossReinforcementCast_windupFx[cast]=AddSpecialEffectTarget(IAManager___AI_BOSS_REINFORCEMENT_START_FX, u, IAManager___AI_BOSS_REINFORCEMENT_ATTACH_POINT)
        else
            set s__IAManager___AIBossReinforcementCast_windupFx[cast]=null
        endif
        set s__IAManager___AIBossReinforcementCast_castText[cast]=CreateTrackedTextTag(TEXTTAG_DEBUG_AI)
        call SetTextTagText(s__IAManager___AIBossReinforcementCast_castText[cast], IAManager___AI_BOSS_REINFORCEMENT_TEXT, IAManager___AI_BOSS_REINFORCEMENT_TEXT_SIZE)
        call SetTextTagPosUnit(s__IAManager___AIBossReinforcementCast_castText[cast], u, IAManager___AI_BOSS_REINFORCEMENT_TEXT_Z_OFFSET)
        call SetTextTagVelocity(s__IAManager___AIBossReinforcementCast_castText[cast], 0.0, IAManager___AI_BOSS_REINFORCEMENT_TEXT_RISE_SPEED)
        call SetTextTagLifespan(s__IAManager___AIBossReinforcementCast_castText[cast], IAManager___AI_BOSS_REINFORCEMENT_TEXT_LIFESPAN)
        call SetTextTagFadepoint(s__IAManager___AIBossReinforcementCast_castText[cast], IAManager___AI_BOSS_REINFORCEMENT_TEXT_FADEPOINT)
        call SetTextTagPermanent(s__IAManager___AIBossReinforcementCast_castText[cast], false)
        call TextTagDebug__TextTagDebugDec((TEXTTAG_DEBUG_AI)) // INLINED!!
        set s__IAManager___AIBossReinforcementCast_t[cast]=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(s__IAManager___AIBossReinforcementCast_t[cast] , TIMER_DEBUG_TAG_AI)
        call SaveInteger(TimerUtils___ht, 0, GetHandleId((s__IAManager___AIBossReinforcementCast_t[cast] )), ( cast)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIBossReinforcementCastByUnit), (hid), ( cast)) // INLINED!!
        call PauseUnit(u, true)

        call SaveInteger(Table__ht, (IAManager___AIUnitChannelLockUntilMs), (hid), ( IAManager___AIClockMs + IAManager___AI_BOSS_REINFORCEMENT_WINDUP_MS)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitNextAbilityMs), (hid), ( IAManager___AIClockMs + IAManager___AI_BOSS_REINFORCEMENT_WINDUP_MS)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + IAManager___AI_BOSS_REINFORCEMENT_WINDUP_MS)) // INLINED!!

        call TimerStart(s__IAManager___AIBossReinforcementCast_t[cast], I2R(IAManager___AI_BOSS_REINFORCEMENT_WINDUP_MS) * 0.001, false, function IAManager___AIBossReinforcementApply)
        set w=0
        return true
    endfunction

    function IAManager___AIInitTeleportState takes integer hid,integer profileId returns nothing
        local integer readyMs= IAManager___AIClockMs + AIGetRandomMsRange(AIGetProfileTeleportEntryDelayMin(profileId) , AIGetProfileTeleportEntryDelayMax(profileId) , 0 , IAManager___AI_TELEPORT_MIN_ENTRY_DELAY_MS)
        if AIGetProfileTeleportEnabled(profileId) then
            call SaveInteger(Table__ht, (IAManager___AIUnitTeleportReadyMs), (hid), ( readyMs)) // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIUnitNextTeleportMs), (hid), ( readyMs)) // INLINED!!
        else
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitTeleportReadyMs), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitNextTeleportMs), (hid)) // INLINED!!
        endif
    endfunction

    function IAManager___AIIsTeleportPointValid takes unit hero,real x,real y returns boolean
        if hero == null or GetUnitTypeId(hero) == 0 or not UnitAlive(hero) then
            return false
        endif
        if not IsVisibleToPlayer(x, y, GetOwningPlayer(hero)) then
            return false
        endif
        if not IsTerrainWalkable(x , y) then
            return false
        endif
        return true
    endfunction

    function IAManager___AITryFindTeleportPointInArc takes unit hero,real baseAngle,real angleSpan,real minOffset,real maxOffset,integer attempts returns boolean
        local integer i= 0
        local real angle
        local real offset
        local real halfSpan= angleSpan * 0.5
        local real heroX
        local real heroY

        if hero == null or attempts <= 0 then
            return false
        endif

        set heroX=GetUnitX(hero)
        set heroY=GetUnitY(hero)

        loop
            exitwhen i >= attempts
            set angle=baseAngle + AIGetRandomRealRange(- halfSpan , halfSpan)
            set offset=AIGetRandomRealRange(minOffset , maxOffset)
            set IAManager___AITeleportPointX=heroX + Cos(angle) * offset
            set IAManager___AITeleportPointY=heroY + Sin(angle) * offset
            if IAManager___AIIsTeleportPointValid(hero , IAManager___AITeleportPointX , IAManager___AITeleportPointY) then
                return true
            endif
            set i=i + 1
        endloop

        return false
    endfunction

    function IAManager___AIGetTeleportBaseAngle takes unit source,unit hero returns real
        local real heroFacing
        local real dx
        local real dy
        local real len
        local real dot
        local real tmp

        if hero == null then
            return 0.0
        endif
        set heroFacing=GetUnitFacing(hero) * bj_DEGTORAD
        set dx=GetUnitX(source) - GetUnitX(hero)
        set dy=GetUnitY(source) - GetUnitY(hero)
        set len=SquareRoot(dx * dx + dy * dy)
        if len <= 0.0 then
            return heroFacing + bj_PI
        endif
        set dot=Cos(heroFacing) * ( dx / len ) + Sin(heroFacing) * ( dy / len )
        if dot <= - IAManager___AI_TELEPORT_FRONTBACK_DOT_THRESHOLD then
            return heroFacing
        endif
        return heroFacing + bj_PI
    endfunction

    function IAManager___AITryFindTeleportPoint takes unit source,unit hero,real minOffset,real maxOffset returns boolean
        local real baseAngle
        local real tmp
        if hero == null then
            return false
        endif
        set minOffset=AIClampReal(minOffset , IAManager___AI_TELEPORT_MIN_OFFSET , 99999.0)
        set maxOffset=AIClampReal(maxOffset , IAManager___AI_TELEPORT_MIN_OFFSET , 99999.0)
        if maxOffset < minOffset then
            set tmp=minOffset
            set minOffset=maxOffset
            set maxOffset=tmp
        endif
        set baseAngle=IAManager___AIGetTeleportBaseAngle(source , hero)
        if IAManager___AITryFindTeleportPointInArc(hero , baseAngle , bj_PI , minOffset , maxOffset , IAManager___AI_TELEPORT_BACK_ATTEMPTS) then
            return true
        endif
        return IAManager___AITryFindTeleportPointInArc(hero , AIGetRandomRealRange(0.0 , 2.0 * bj_PI) , 2.0 * bj_PI , minOffset , maxOffset , IAManager___AI_TELEPORT_FALLBACK_ATTEMPTS)
    endfunction

    function IAManager___AITryTeleportByProfile takes unit u,unit currentTarget,integer hid,integer profileId returns boolean
        local unit blinkHero= currentTarget
        local integer nowMs= IAManager___AIClockMs
        local integer nextTeleport
        local integer readyMs
        local integer cooldownMs
        local real minOffset
        local real maxOffset
        local string preFxPath
        local effect fx

        if u == null or GetUnitTypeId(u) == 0 or not UnitAlive(u) then
            return false
        endif
        if not AIGetProfileTeleportEnabled(profileId) then
            return false
        endif
        if AIGetProfileTeleportPrioritizeFarthestTrackedHero(profileId) then
            set blinkHero=IAManager___AISelectFarthestTrackedHero(u)
        endif
        if blinkHero == null or not IAManager___AIIsEnemyHero(u , blinkHero) then
            return false
        endif

        if not (HaveSavedInteger(Table__ht, (IAManager___AIUnitTeleportReadyMs), (hid))) or not (HaveSavedInteger(Table__ht, (IAManager___AIUnitNextTeleportMs), (hid))) then // INLINED!!
            call IAManager___AIInitTeleportState(hid , profileId)
        endif
        set readyMs=(LoadInteger(Table__ht, (IAManager___AIUnitTeleportReadyMs), (hid))) // INLINED!!
        if nowMs < readyMs then
            return false
        endif
        set nextTeleport=(LoadInteger(Table__ht, (IAManager___AIUnitNextTeleportMs), (hid))) // INLINED!!
        if nowMs < nextTeleport then
            return false
        endif

        set minOffset=AIGetProfileTeleportOffsetMin(profileId)
        set maxOffset=AIGetProfileTeleportOffsetMax(profileId)
        if maxOffset <= 0.0 then
            return false
        endif
        if not IAManager___AITryFindTeleportPoint(u , blinkHero , minOffset , maxOffset) then
            return false
        endif

        set preFxPath=AIGetProfileTeleportPreFxPath(profileId)
        if preFxPath != "" then
            set fx=AddSpecialEffectTarget(preFxPath, u, IAManager___AI_TELEPORT_ATTACH_POINT)
            call DestroyEffect(fx)
            set fx=null
        endif

        call SetUnitX(u, IAManager___AITeleportPointX)
        call SetUnitY(u, IAManager___AITeleportPointY)
        call IAManager___AIResetOrderState(hid)
        call SaveUnitHandle(Table__ht, (((IAManager___AIUnitTarget))), (hid), ( blinkHero)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitNextRetargetMs), (hid), ( 0)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitNextAbilityMs), (hid), ( nowMs + AIIntervalToMs(AIGetProfileThinkInterval(profileId) , 250))) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( nowMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
        set cooldownMs=AIGetRandomMsRange(AIGetProfileTeleportCooldownMin(profileId) , AIGetProfileTeleportCooldownMax(profileId) , IAManager___AI_TELEPORT_MIN_COOLDOWN_MS , IAManager___AI_TELEPORT_MIN_COOLDOWN_MS)
        call SaveInteger(Table__ht, (IAManager___AIUnitNextTeleportMs), (hid), ( nowMs + cooldownMs)) // INLINED!!
        if IAManager___AIDebugEnabled then
            call IAManager___AILogLimited("TELEPORT ut=" + I2S(GetUnitTypeId(u)) + " target=" + I2S(GetUnitTypeId(blinkHero)) + " x=" + R2S(IAManager___AITeleportPointX) + " y=" + R2S(IAManager___AITeleportPointY))
        endif
        set blinkHero=null
        return true
    endfunction

    function IAManager___AIGetUnitCooldownTable takes integer hid,boolean createIfMissing returns integer
        local integer t
        if (HaveSavedInteger(Table__ht, (IAManager___AIUnitCooldownTables), (hid))) then // INLINED!!
            return ((LoadInteger(Table__ht, (IAManager___AIUnitCooldownTables), (hid)))) // INLINED!!
        endif
        if createIfMissing then
            set t=s__Table_create()
            call SaveInteger(Table__ht, (IAManager___AIUnitCooldownTables), (hid), ( t)) // INLINED!!
            return t
        endif
        return 0
    endfunction

    function IAManager___AIUpdateWaveUnitCountOnRemove takes integer waveId returns nothing
        local integer c
        if waveId == 0 or not (HaveSavedInteger(Table__ht, (IAManager___AIWaveUnitCount), (waveId))) then // INLINED!!
            return
        endif
        set c=(LoadInteger(Table__ht, (IAManager___AIWaveUnitCount), (waveId))) - 1 // INLINED!!
        if c < 0 then
            set c=0
        endif
        call SaveInteger(Table__ht, (IAManager___AIWaveUnitCount), (waveId), ( c)) // INLINED!!
        if c == 0 then
            call SaveInteger(Table__ht, (IAManager___AIWaveIsActive), (waveId), ( 0)) // INLINED!!
        endif
    endfunction

    function IAManager___AIRemoveUnitByIndex takes integer index returns nothing
        local integer last
        local unit u
        local unit moved
        local integer hid= 0
        local integer movedHid= 0
        local integer waveId= 0
        local integer cd

        if index < 1 or index > IAManager___AIUnitCount then
            return
        endif

        set last=IAManager___AIUnitCount
        set u=(LoadUnitHandle(Table__ht, (((IAManager___AIUnitByIndex))), (index))) // INLINED!!
        if u != null then
            set hid=GetHandleId(u)
            if (HaveSavedInteger(Table__ht, (IAManager___AIUnitWaveId), (hid))) then // INLINED!!
                set waveId=(LoadInteger(Table__ht, (IAManager___AIUnitWaveId), (hid))) // INLINED!!
            endif
        endif

        if index != last then
            set moved=(LoadUnitHandle(Table__ht, (((IAManager___AIUnitByIndex))), (last))) // INLINED!!
            call SaveUnitHandle(Table__ht, (((IAManager___AIUnitByIndex))), (index), ( moved)) // INLINED!!
            if moved != null then
                set movedHid=GetHandleId(moved)
                if movedHid != 0 then
                    call SaveInteger(Table__ht, (IAManager___AIIndexByUnit), (movedHid), ( index)) // INLINED!!
                endif
            endif
        endif

        call RemoveSavedInteger(Table__ht, (IAManager___AIUnitByIndex), (last)) // INLINED!!
        set IAManager___AIUnitCount=last - 1

        if hid != 0 then
            call IAManager___AICancelBossReinforcementCast(hid)
            call RemoveSavedInteger(Table__ht, (IAManager___AIIndexByUnit), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitWaveId), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitProfileId), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitLaneId), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitBehaviorFlags), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitThreatWeight), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitTarget), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitNextRetargetMs), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitNextAbilityMs), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitChannelLockUntilMs), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitNextTeleportMs), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitTeleportReadyMs), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitNextDebugMs), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitLastOrderType), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitLastOrderTarget), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitLastOrderX), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIUnitLastOrderY), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (IAManager___AIBossReinforcementNextMs), (hid)) // INLINED!!
            if (HaveSavedInteger(Table__ht, (IAManager___AIUnitCooldownTables), (hid))) then // INLINED!!
                set cd=((LoadInteger(Table__ht, (IAManager___AIUnitCooldownTables), (hid)))) // INLINED!!
                call s__Table_destroy(cd)
                call RemoveSavedInteger(Table__ht, (IAManager___AIUnitCooldownTables), (hid)) // INLINED!!
            endif
        endif

        call IAManager___AIUpdateWaveUnitCountOnRemove(waveId)

        if IAManager___AIUnitCount <= 0 then
            set IAManager___AIGlobalCursor=1
        elseif IAManager___AIGlobalCursor > IAManager___AIUnitCount then
            set IAManager___AIGlobalCursor=1
        endif

        set cd=0
        set moved=null
        set u=null
    endfunction

    function IAManager___AIAddOrUpdateUnit takes unit u,integer waveId,integer profileId,integer laneId,integer behaviorFlags,real threatWeight returns nothing
        local integer hid
        local integer idx
        local integer oldWaveId
        local integer oldProfileId

        if u == null or waveId == 0 then
            return
        endif
        if GetUnitTypeId(u) == 0 or not UnitAlive(u) then
            return
        endif

        set hid=GetHandleId(u)
        if profileId <= 0 then
            set profileId=AIGetDefaultProfileForUnitType(GetUnitTypeId(u))
        endif
        if profileId <= 0 then
            set profileId=AI_DEFAULT_PROFILE_ID
        endif
        if behaviorFlags == 0 then
            set behaviorFlags=AIGetProfileDefaultFlags(profileId)
        endif
        if threatWeight <= 0.0 then
            set threatWeight=1.0
        endif

        if (HaveSavedInteger(Table__ht, (IAManager___AIIndexByUnit), (hid))) then // INLINED!!
            set oldWaveId=(LoadInteger(Table__ht, (IAManager___AIUnitWaveId), (hid))) // INLINED!!
            set oldProfileId=(LoadInteger(Table__ht, (IAManager___AIUnitProfileId), (hid))) // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIUnitWaveId), (hid), ( waveId)) // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIUnitProfileId), (hid), ( profileId)) // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIUnitLaneId), (hid), ( laneId)) // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIUnitBehaviorFlags), (hid), ( behaviorFlags)) // INLINED!!
            call SaveReal(Table__ht, (((IAManager___AIUnitThreatWeight))), (hid), (( threatWeight)*1.0)) // INLINED!!
            if AIGetProfileTeleportEnabled(profileId) then
                if oldProfileId != profileId or not (HaveSavedInteger(Table__ht, (IAManager___AIUnitTeleportReadyMs), (hid))) or not (HaveSavedInteger(Table__ht, (IAManager___AIUnitNextTeleportMs), (hid))) then // INLINED!!
                    call IAManager___AIInitTeleportState(hid , profileId)
                endif
            else
                call RemoveSavedInteger(Table__ht, (IAManager___AIUnitNextTeleportMs), (hid)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (IAManager___AIUnitTeleportReadyMs), (hid)) // INLINED!!
            endif
            if oldWaveId != waveId then
                call IAManager___AIUpdateWaveUnitCountOnRemove(oldWaveId)
                call SaveInteger(Table__ht, (IAManager___AIWaveIsActive), (waveId), ( 1)) // INLINED!!
                if not (HaveSavedInteger(Table__ht, (IAManager___AIWaveIsPaused), (waveId))) then // INLINED!!
                    call SaveInteger(Table__ht, (IAManager___AIWaveIsPaused), (waveId), ( 0)) // INLINED!!
                endif
                call SaveInteger(Table__ht, (IAManager___AIWaveUnitCount), (waveId), ( (LoadInteger(Table__ht, (IAManager___AIWaveUnitCount), (waveId))) + 1)) // INLINED!!
            endif
            return
        endif

        set IAManager___AIUnitCount=IAManager___AIUnitCount + 1
        set idx=IAManager___AIUnitCount

        call SaveUnitHandle(Table__ht, (((IAManager___AIUnitByIndex))), (idx), ( u)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIIndexByUnit), (hid), ( idx)) // INLINED!!

        call SaveInteger(Table__ht, (IAManager___AIUnitWaveId), (hid), ( waveId)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitProfileId), (hid), ( profileId)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitLaneId), (hid), ( laneId)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitBehaviorFlags), (hid), ( behaviorFlags)) // INLINED!!
        call SaveReal(Table__ht, (((IAManager___AIUnitThreatWeight))), (hid), (( threatWeight)*1.0)) // INLINED!!
        call SaveUnitHandle(Table__ht, (((IAManager___AIUnitTarget))), (hid), ( null)) // INLINED!!

        call SaveInteger(Table__ht, (IAManager___AIUnitNextRetargetMs), (hid), ( 0)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( 0)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitNextAbilityMs), (hid), ( 0)) // INLINED!!
        call SaveInteger(Table__ht, (IAManager___AIUnitChannelLockUntilMs), (hid), ( 0)) // INLINED!!
        call IAManager___AIInitTeleportState(hid , profileId)
        call SaveInteger(Table__ht, (IAManager___AIUnitNextDebugMs), (hid), ( 0)) // INLINED!!
        call IAManager___AIResetOrderState(hid)

        call SaveInteger(Table__ht, (IAManager___AIWaveIsActive), (waveId), ( 1)) // INLINED!!
        if not (HaveSavedInteger(Table__ht, (IAManager___AIWaveIsPaused), (waveId))) then // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIWaveIsPaused), (waveId), ( 0)) // INLINED!!
        endif
        call SaveInteger(Table__ht, (IAManager___AIWaveUnitCount), (waveId), ( (LoadInteger(Table__ht, (IAManager___AIWaveUnitCount), (waveId))) + 1)) // INLINED!!
    endfunction

    function IAManager___AICleanupWave takes integer waveId returns nothing
        local integer i= IAManager___AIUnitCount
        local unit u
        local integer hid

        loop
            exitwhen i <= 0
            set u=(LoadUnitHandle(Table__ht, (((IAManager___AIUnitByIndex))), (i))) // INLINED!!
            if u != null then
                set hid=GetHandleId(u)
                if hid != 0 and (HaveSavedInteger(Table__ht, (IAManager___AIUnitWaveId), (hid))) and (LoadInteger(Table__ht, (IAManager___AIUnitWaveId), (hid))) == waveId then // INLINED!!
                    call IAManager___AIRemoveUnitByIndex(i)
                endif
            endif
            set i=i - 1
        endloop

        call RemoveSavedInteger(Table__ht, (IAManager___AIWaveIsActive), (waveId)) // INLINED!!
        call RemoveSavedInteger(Table__ht, (IAManager___AIWaveIsPaused), (waveId)) // INLINED!!
        call RemoveSavedInteger(Table__ht, (IAManager___AIWaveUnitCount), (waveId)) // INLINED!!
        call RemoveSavedInteger(Table__ht, (IAManager___AIWaveEnabledOverride), (waveId)) // INLINED!!

        set u=null
    endfunction

    function IAManager___AIIsWaveEnabled takes integer waveId returns boolean
        if (HaveSavedInteger(Table__ht, (IAManager___AIWaveEnabledOverride), (waveId))) then // INLINED!!
            return (LoadInteger(Table__ht, (IAManager___AIWaveEnabledOverride), (waveId))) == 1 // INLINED!!
        endif
        return true
    endfunction

    function IAManager___AITryCastByProfile takes unit u,unit target,integer hid,integer profileId,integer behaviorFlags returns boolean
        local integer slot= 1
        local integer count= AIGetProfileRuleCount(profileId)
        local integer bestSlot= 0
        local integer bestPriority= - 2147483647
        local integer abilityId
        local integer targetType
        local integer minEnemies
        local integer level
        local integer nowMs= IAManager___AIClockMs
        local integer minRangeOk
        local string orderString
        local real minRange
        local real maxRange
        local real selfHpMax
        local real enemyHpMax
        local real radius
        local real localCooldown
        local real distSq
        local real minRangeSq
        local real maxRangeSq
        local real selfHpPct
        local real enemyHpPct
        local integer isChanneling
        local real channelLockSeconds
        local boolean success= false
        local integer cdTable

        if count <= 0 or u == null or target == null then
            return false
        endif

        set distSq=IAManager___AIDistanceSqUnits(u , target)
        set selfHpPct=IAManager___AIGetUnitHpPct(u)
        set enemyHpPct=IAManager___AIGetUnitHpPct(target)
        set cdTable=IAManager___AIGetUnitCooldownTable(hid , true)

        loop
            exitwhen slot > count
            set abilityId=(LoadInteger(Table__ht, (AIProfiles__AIRuleAbilityId), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) // INLINED!!
            if abilityId != 0 then
                set orderString=(LoadStr(Table__ht, (((AIProfiles__AIRuleOrderString))), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) // INLINED!!
                if orderString != "" then
                    set level=GetUnitAbilityLevel(u, abilityId)
                    if level > 0 then
                        if not (HaveSavedInteger(Table__ht, (cdTable), (slot))) or nowMs >= (LoadInteger(Table__ht, (cdTable), (slot))) then // INLINED!!
                            // Compatibilidad 1.27b: sin nativas Blz para cooldown/mana cost.
                            // Se valida por reglas IA + resultado real de la orden.
                            set minRange=(LoadReal(Table__ht, (((AIProfiles__AIRuleMinRange))), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) // INLINED!!
                            set maxRange=(LoadReal(Table__ht, (((AIProfiles__AIRuleMaxRange))), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) // INLINED!!
                            set minRangeOk=1
                            set minRangeSq=minRange * minRange
                            set maxRangeSq=maxRange * maxRange

                            if minRange > 0.0 and distSq < minRangeSq then
                                set minRangeOk=0
                            endif
                            if maxRange > 0.0 and distSq > maxRangeSq then
                                set minRangeOk=0
                            endif

                            if minRangeOk == 1 then
                                set selfHpMax=(LoadReal(Table__ht, (((AIProfiles__AIRuleSelfHpMaxPct))), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) // INLINED!!
                                set enemyHpMax=(LoadReal(Table__ht, (((AIProfiles__AIRuleEnemyHpMaxPct))), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) // INLINED!!

                                if ( selfHpMax <= 0.0 or selfHpPct <= selfHpMax ) and ( enemyHpMax <= 0.0 or enemyHpPct <= enemyHpMax ) then
                                    set minEnemies=(LoadInteger(Table__ht, (AIProfiles__AIRuleMinEnemiesInRadius), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) // INLINED!!
                                    if minEnemies > 0 then
                                        set radius=(LoadReal(Table__ht, (((AIProfiles__AIRuleRadius))), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) // INLINED!!
                                        if radius <= 0.0 or IAManager___AICountEnemyHeroesInRadius(u , radius) < minEnemies then
                                            set minRangeOk=0
                                        endif
                                    endif

                                    if minRangeOk == 1 and (LoadInteger(Table__ht, (AIProfiles__AIRulePriority), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) > bestPriority then // INLINED!!
                                        set bestPriority=(LoadInteger(Table__ht, (AIProfiles__AIRulePriority), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( slot)))))) // INLINED!!
                                        set bestSlot=slot
                                    endif
                                endif
                            endif
                        endif
                    endif
                endif
            endif
            set slot=slot + 1
        endloop

        if bestSlot > 0 then
            set targetType=(LoadInteger(Table__ht, (AIProfiles__AIRuleTargetType), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( bestSlot)))))) // INLINED!!
            set orderString=(LoadStr(Table__ht, (((AIProfiles__AIRuleOrderString))), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( bestSlot)))))) // INLINED!!

            if targetType == AI_TARGET_NONE then
                set success=IssueImmediateOrder(u, orderString)
            elseif targetType == AI_TARGET_POINT then
                set success=IssuePointOrder(u, orderString, GetUnitX(target), GetUnitY(target))
            else
                set success=IssueTargetOrder(u, orderString, target)
            endif

            if success then
                set localCooldown=(LoadReal(Table__ht, (((AIProfiles__AIRuleLocalCooldown))), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( bestSlot)))))) // INLINED!!
                if localCooldown > 0.0 then
                    call SaveInteger(Table__ht, (cdTable), (bestSlot), ( nowMs + AIIntervalToMs(localCooldown , 0))) // INLINED!!
                endif
                set isChanneling=(LoadInteger(Table__ht, (AIProfiles__AIRuleIsChanneling), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( bestSlot)))))) // INLINED!!
                if isChanneling == 1 then
                    set channelLockSeconds=(LoadReal(Table__ht, (((AIProfiles__AIRuleChannelLock))), ((((profileId ) ) * AIProfiles__AI_RULE_KEY_STRIDE + ( ( bestSlot)))))) // INLINED!!
                    if channelLockSeconds <= 0.0 then
                        set channelLockSeconds=1.00
                    endif
                    call SaveInteger(Table__ht, (IAManager___AIUnitChannelLockUntilMs), (hid), ( nowMs + AIIntervalToMs(channelLockSeconds , 1000))) // INLINED!!
                else
                    call SaveInteger(Table__ht, (IAManager___AIUnitChannelLockUntilMs), (hid), ( 0)) // INLINED!!
                endif
                call IAManager___AIResetOrderState(hid)
            else
                // Backoff corto para evitar reintentos de orden cada think tick.
                call SaveInteger(Table__ht, (cdTable), (bestSlot), ( nowMs + IAManager___AI_CAST_FAIL_BACKOFF_MS)) // INLINED!!
            endif
        endif

        set cdTable=0
        return success
    endfunction

    function IAManager___AIMaybeIssueAttackOrder takes unit u,integer hid,unit target returns nothing
        local integer targetHid= 0
        if target != null then
            set targetHid=GetHandleId(target)
        endif
        if targetHid == 0 then
            return
        endif
        if (HaveSavedInteger(Table__ht, (IAManager___AIUnitLastOrderType), (hid))) and (LoadInteger(Table__ht, (IAManager___AIUnitLastOrderType), (hid))) == IAManager___AI_ORDER_ATTACK and (LoadInteger(Table__ht, (IAManager___AIUnitLastOrderTarget), (hid))) == targetHid then // INLINED!!
            return
        endif
        if IssueTargetOrder(u, "attack", target) then
            call SaveInteger(Table__ht, (IAManager___AIUnitLastOrderType), (hid), ( IAManager___AI_ORDER_ATTACK)) // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIUnitLastOrderTarget), (hid), ( targetHid)) // INLINED!!
            call SaveReal(Table__ht, (((IAManager___AIUnitLastOrderX))), (hid), (( 0.0)*1.0)) // INLINED!!
            call SaveReal(Table__ht, (((IAManager___AIUnitLastOrderY))), (hid), (( 0.0)*1.0)) // INLINED!!
        endif
    endfunction

function IAManager___AIApplyMovement takes unit u,unit target,integer hid,integer profileId,integer behaviorFlags returns nothing
        local real preferredRange= AIGetProfilePreferredRange(profileId)
        local real distSq
        local real bandHalf
        local real innerRange
        local real outerRange
        local real moveAwayRange
        local real moveCloseRange

        if preferredRange <= 0.0 then
            set preferredRange=180.0
        endif

        set distSq=IAManager___AIDistanceSqUnits(u , target)
        if IAManager___AIHasBehaviorFlag(behaviorFlags , AI_BEHAVIOR_KEEP_DISTANCE) then
            if ((profileId) == AI_PROFILE_WAVE4_SPELL) then // INLINED!!
                set bandHalf=IAManager___AIGetKeepDistanceBandHalf(preferredRange)
                set innerRange=preferredRange - bandHalf
                set outerRange=preferredRange + bandHalf
                if innerRange < 64.0 then
                    set innerRange=64.0
                endif
                if outerRange < innerRange then
                    set outerRange=innerRange
                endif

                if distSq < innerRange * innerRange then
                    set moveAwayRange=preferredRange + 64.0
                    call IAManager___AIMoveToTargetRange(u , target , hid , moveAwayRange)
                elseif distSq > outerRange * outerRange then
                    set moveCloseRange=preferredRange - 64.0
                    if moveCloseRange < 96.0 then
                        set moveCloseRange=96.0
                    endif
                    call IAManager___AIMoveToTargetRange(u , target , hid , moveCloseRange)
                else
                    call IAManager___AIMaybeIssueAttackOrder(u , hid , target)
                endif
            else
                if distSq < ( preferredRange * 0.75 ) * ( preferredRange * 0.75 ) then
                    set moveAwayRange=preferredRange
                    call IAManager___AIMoveToTargetRange(u , target , hid , moveAwayRange)
                else
                    call IAManager___AIMaybeIssueAttackOrder(u , hid , target)
                endif
            endif
        else
            call IAManager___AIMaybeIssueAttackOrder(u , hid , target)
        endif

        call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
    endfunction

    function IAManager___AIEvaluateUnit takes unit u returns boolean
        local integer hid
        local integer waveId
        local integer profileId
        local integer behaviorFlags
        local integer nextRetarget
        local integer nextAbility
        local integer nextOrder
        local integer nextDebug
        local boolean shouldRetarget= false
        local unit target
        local real leashRange
        local real leashRangeSq
        local real chaseBias
        local real acquireRange
        local real threatWeight
        local real nearTrackedEnemySq
        local real nearTrackedAnySq
        local real nearTrackedEnemyDist
        local real nearTrackedAnyDist
        local integer channelLockUntil
        local boolean casted

        if u == null then
            return false
        endif
        if GetUnitTypeId(u) == 0 or not UnitAlive(u) then
            return false
        endif

        set hid=GetHandleId(u)
        if hid == 0 or not (HaveSavedInteger(Table__ht, (IAManager___AIUnitWaveId), (hid))) then // INLINED!!
            return false
        endif

        set waveId=(LoadInteger(Table__ht, (IAManager___AIUnitWaveId), (hid))) // INLINED!!
        if not IAManager___AIIsWaveEnabled(waveId) then
            return false
        endif
        if (HaveSavedInteger(Table__ht, (IAManager___AIWaveIsPaused), (waveId))) and (LoadInteger(Table__ht, (IAManager___AIWaveIsPaused), (waveId))) == 1 then // INLINED!!
            return false
        endif

        set profileId=(LoadInteger(Table__ht, (IAManager___AIUnitProfileId), (hid))) // INLINED!!
        if profileId <= 0 then
            set profileId=AIGetDefaultProfileForUnitType(GetUnitTypeId(u))
            if profileId <= 0 then
                set profileId=AI_DEFAULT_PROFILE_ID
            endif
            call SaveInteger(Table__ht, (IAManager___AIUnitProfileId), (hid), ( profileId)) // INLINED!!
        endif

        set behaviorFlags=(LoadInteger(Table__ht, (IAManager___AIUnitBehaviorFlags), (hid))) // INLINED!!
        if behaviorFlags == 0 then
            set behaviorFlags=AIGetProfileDefaultFlags(profileId)
            call SaveInteger(Table__ht, (IAManager___AIUnitBehaviorFlags), (hid), ( behaviorFlags)) // INLINED!!
        endif

        if (HaveSavedReal(Table__ht, (((IAManager___AIUnitThreatWeight))), (hid))) then // INLINED!!
            set threatWeight=(LoadReal(Table__ht, (((IAManager___AIUnitThreatWeight))), (hid))) // INLINED!!
        else
            set threatWeight=1.0
            call SaveReal(Table__ht, (((IAManager___AIUnitThreatWeight))), (hid), (( threatWeight)*1.0)) // INLINED!!
        endif

        if IAManager___AITryBossReinforcement(u , hid , waveId , profileId) then
            return true
        endif

        set target=(LoadUnitHandle(Table__ht, (((IAManager___AIUnitTarget))), (hid))) // INLINED!!
        if target == null or not IAManager___AIIsCombatObjective(u , target) then
            set shouldRetarget=true
        else
            set leashRange=AIGetProfileLeashRange(profileId)
            if leashRange <= 0.0 then
                set leashRange=1400.0
            endif
            set chaseBias=AIGetProfileChaseBias(profileId)
            if chaseBias <= 0.0 then
                set chaseBias=1.0
            endif
            set leashRangeSq=( leashRange * chaseBias ) * ( leashRange * chaseBias )
            if IAManager___AIDistanceSqUnits(u , target) > leashRangeSq then
                set shouldRetarget=true
            endif
        endif

        set nextRetarget=(LoadInteger(Table__ht, (IAManager___AIUnitNextRetargetMs), (hid))) // INLINED!!
        if IAManager___AIClockMs >= nextRetarget then
            set shouldRetarget=true
        endif

        if shouldRetarget then
            set acquireRange=AIGetProfileAcquireRange(profileId)
            set target=IAManager___AISelectCombatObjective(u , acquireRange , behaviorFlags , threatWeight)
            call SaveUnitHandle(Table__ht, (((IAManager___AIUnitTarget))), (hid), ( target)) // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIUnitNextRetargetMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileRetargetInterval(profileId) , 500))) // INLINED!!
        endif

        if target == null then
            if IAManager___AIDebugEnabled and IAManager___AIDebugPassesFilter(u , waveId) then
                set nextDebug=(LoadInteger(Table__ht, (IAManager___AIUnitNextDebugMs), (hid))) // INLINED!!
                if IAManager___AIClockMs >= nextDebug then
                    set nearTrackedEnemySq=IAManager___AIGetNearestTrackedHeroDistSq(u , true)
                    set nearTrackedAnySq=IAManager___AIGetNearestTrackedHeroDistSq(u , false)
                    if nearTrackedEnemySq >= 0.0 then
                        set nearTrackedEnemyDist=SquareRoot(nearTrackedEnemySq)
                    else
                        set nearTrackedEnemyDist=- 1.0
                    endif
                    if nearTrackedAnySq >= 0.0 then
                        set nearTrackedAnyDist=SquareRoot(nearTrackedAnySq)
                    else
                        set nearTrackedAnyDist=- 1.0
                    endif
                    call IAManager___AILogLimited("IDLE no-target w=" + I2S(waveId) + " ut=" + I2S(GetUnitTypeId(u)) + " acq=" + R2S(acquireRange) + " nearestEnemyTracked=" + R2S(nearTrackedEnemyDist) + " nearestAnyTracked=" + R2S(nearTrackedAnyDist) + " fallback=" + I2S(AIBoolToInt(IAManager___AIUseGroupFallbackNoHeroes)))
                    call SaveInteger(Table__ht, (IAManager___AIUnitNextDebugMs), (hid), ( IAManager___AIClockMs + 1500)) // INLINED!!
                endif
            endif
            return false
        endif

        set channelLockUntil=(LoadInteger(Table__ht, (IAManager___AIUnitChannelLockUntilMs), (hid))) // INLINED!!
        if IAManager___AIClockMs < channelLockUntil then
            return true
        endif

        if IAManager___AITryTeleportByProfile(u , target , hid , profileId) then
            set target=null
            return true
        endif

        if WaveBarrierSkillsTryExecute(u , target , IAManager___AIClockMs) then
            call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
            set target=null
            return true
        endif

        if WaveAuraSkillsTryExecute(u , target , IAManager___AIClockMs) then
            call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
            set target=null
            return true
        endif

        if WaveRangedSkillsTryExecute(u , target , IAManager___AIClockMs) then
            call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
            set target=null
            return true
        endif

        if WaveSiegeSkillsTryExecute(u , target , IAManager___AIClockMs) then
            call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
            set target=null
            return true
        endif

        if WaveMortarSkillsTryExecute(u , target , IAManager___AIClockMs) then
            call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
            set target=null
            return true
        endif

        if WavePriestSkillsTryExecute(u , target , IAManager___AIClockMs) then
            call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
            set target=null
            return true
        endif

        if WaveTrapSkillsTryExecute(u , target , IAManager___AIClockMs) then
            call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
            set target=null
            return true
        endif

        if WaveSiegeZoneSkillsTryExecute(u , target , IAManager___AIClockMs) then
            call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
            set target=null
            return true
        endif

        if WaveWaveformSkillsTryExecute(u , target , IAManager___AIClockMs) then
            call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
            set target=null
            return true
        endif

        set nextAbility=(LoadInteger(Table__ht, (IAManager___AIUnitNextAbilityMs), (hid))) // INLINED!!
        if IAManager___AIClockMs >= nextAbility then
            set casted=IAManager___AITryCastByProfile(u , target , hid , profileId , behaviorFlags)
            call SaveInteger(Table__ht, (IAManager___AIUnitNextAbilityMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileThinkInterval(profileId) , 250))) // INLINED!!
            if casted then
                call SaveInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid), ( IAManager___AIClockMs + AIIntervalToMs(AIGetProfileOrderInterval(profileId) , 350))) // INLINED!!
                set target=null
                return true
            endif
        endif

        set nextOrder=(LoadInteger(Table__ht, (IAManager___AIUnitNextOrderMs), (hid))) // INLINED!!
        if IAManager___AIClockMs >= nextOrder then
            call IAManager___AIApplyMovement(u , target , hid , profileId , behaviorFlags)
        endif

        set target=null
        return true
    endfunction

    function IAManager___AIOnTick takes nothing returns nothing
        local integer processed= 0
        local integer idx
        local integer budget
        local integer nextTickMs
        local unit u
        local boolean combatSeen= false

        set IAManager___AIDebugLogsThisTick=0
        set IAManager___AIClockMs=IAManager___AIClockMs + IAManager___AICurrentTickMs

        if IAManager___AIUseDynamicScheduler then
            set budget=IAManager___AICalcDynamicBudget(IAManager___AIUnitCount)
        else
            set budget=IAManager___AIFixedBudget
        endif
        set budget=AIClampInt(budget , IAManager___AI_MIN_BUDGET_PER_TICK , IAManager___AI_MAX_BUDGET_PER_TICK)
        set IAManager___AICurrentBudget=budget

        if IAManager___AIUnitCount > 0 then
            loop
                exitwhen processed >= budget or IAManager___AIUnitCount <= 0

                if IAManager___AIGlobalCursor < 1 or IAManager___AIGlobalCursor > IAManager___AIUnitCount then
                    set IAManager___AIGlobalCursor=1
                endif

                set idx=IAManager___AIGlobalCursor
                set u=(LoadUnitHandle(Table__ht, (((IAManager___AIUnitByIndex))), (idx))) // INLINED!!
                set IAManager___AIGlobalCursor=idx + 1

                if u == null or GetUnitTypeId(u) == 0 or not UnitAlive(u) then
                    call IAManager___AIRemoveUnitByIndex(idx)
                else
                    if IAManager___AIEvaluateUnit(u) then
                        set combatSeen=true
                    endif
                endif

                set processed=processed + 1
            endloop
        endif

        if IAManager___AIUseDynamicScheduler then
            set nextTickMs=IAManager___AICalcDynamicTick(IAManager___AIUnitCount , combatSeen)
        else
            set nextTickMs=IAManager___AIFixedTickMs
        endif
        set IAManager___AICurrentTickMs=AIClampInt(nextTickMs , IAManager___AI_MIN_TICK_MS , IAManager___AI_MAX_TICK_MS)
        if IAManager___AIDebugEnabled and IAManager___AIClockMs >= IAManager___AINextPerfLogMs then
            call IAManager___AILogLimited("tick=" + I2S(IAManager___AICurrentTickMs) + " budget=" + I2S(IAManager___AICurrentBudget) + " units=" + I2S(IAManager___AIUnitCount) + " combatSeen=" + I2S(AIBoolToInt(combatSeen)))
            set IAManager___AINextPerfLogMs=IAManager___AIClockMs + 1000
        endif
        call TimerStart(IAManager___AITimer, I2R(IAManager___AICurrentTickMs) * 0.001, false, function IAManager___AIOnTick)

        set u=null
    endfunction

    function IAManager___AIOnWaveSpawn takes nothing returns nothing
        local integer w= (WaveEventWaveId) // INLINED!!
        local unit u= (WaveEventUnit) // INLINED!!
        local integer s= (WaveEventSlotId) // INLINED!!
        local integer profileId= 0
        local integer laneId= 0
        local integer behaviorFlags= 0
        local real threatWeight= 1.0

        if w == 0 or u == null then
            set u=null
            return
        endif

        if s != 0 then
            set profileId=s__WaveSlot_aiProfileId[s]
            set laneId=s__WaveSlot_laneId[s]
            set behaviorFlags=s__WaveSlot_behaviorFlags[s]
            set threatWeight=s__WaveSlot_threatWeight[s]
        endif

        if profileId <= 0 then
            set profileId=AIGetDefaultProfileForUnitType(GetUnitTypeId(u))
        endif
        if profileId <= 0 then
            set profileId=AI_DEFAULT_PROFILE_ID
        endif
        if behaviorFlags == 0 then
            set behaviorFlags=AIGetProfileDefaultFlags(profileId)
        endif
        if threatWeight <= 0.0 then
            set threatWeight=1.0
        endif

        call IAManager___AIAddOrUpdateUnit(u , w , profileId , laneId , behaviorFlags , threatWeight)
        if IAManager___AIBossReinforcementSupportsUnitType(GetUnitTypeId(u)) then
            call SaveInteger(Table__ht, (IAManager___AIBossReinforcementNextMs), (GetHandleId(u)), ( IAManager___AIClockMs + (GetRandomInt(IAManager___AI_BOSS_REINFORCEMENT_INITIAL_MIN_MS, IAManager___AI_BOSS_REINFORCEMENT_INITIAL_MAX_MS)))) // INLINED!!
        endif
        if IAManager___AIDebugEnabled and IAManager___AIDebugPassesFilter(u , w) then
            call IAManager___AILogLimited("SPAWN w=" + I2S(w) + " ut=" + I2S(GetUnitTypeId(u)) + " owner=" + I2S(GetPlayerId(GetOwningPlayer(u))) + " profile=" + I2S(profileId) + " flags=" + I2S(behaviorFlags) + " threat=" + R2S(threatWeight))
        endif

        set u=null
    endfunction

    function IAManager___AIOnWaveExternal takes nothing returns nothing
        local unit u= (WaveEventUnit) // INLINED!!
        local integer w= (WaveEventWaveId) // INLINED!!
        local integer s= (WaveEventSlotId) // INLINED!!
        local integer profileId= 0
        local integer laneId= 0
        local integer behaviorFlags= 0
        local real threatWeight= 1.0

        if w == 0 or u == null then
            set u=null
            return
        endif

        if s != 0 then
            set profileId=s__WaveSlot_aiProfileId[s]
            set laneId=s__WaveSlot_laneId[s]
            set behaviorFlags=s__WaveSlot_behaviorFlags[s]
            set threatWeight=s__WaveSlot_threatWeight[s]
        endif

        if profileId <= 0 then
            set profileId=AIGetDefaultProfileForUnitType(GetUnitTypeId(u))
        endif
        if profileId <= 0 then
            set profileId=AI_DEFAULT_PROFILE_ID
        endif
        if behaviorFlags == 0 then
            set behaviorFlags=AIGetProfileDefaultFlags(profileId)
        endif
        if threatWeight <= 0.0 then
            set threatWeight=1.0
        endif

        call IAManager___AIAddOrUpdateUnit(u , w , profileId , laneId , behaviorFlags , threatWeight)
        if IAManager___AIBossReinforcementSupportsUnitType(GetUnitTypeId(u)) then
            call SaveInteger(Table__ht, (IAManager___AIBossReinforcementNextMs), (GetHandleId(u)), ( IAManager___AIClockMs + (GetRandomInt(IAManager___AI_BOSS_REINFORCEMENT_INITIAL_MIN_MS, IAManager___AI_BOSS_REINFORCEMENT_INITIAL_MAX_MS)))) // INLINED!!
        endif
        set u=null
    endfunction

    function IAManager___AIOnWaveDeath takes nothing returns nothing
        local unit u= (WaveEventUnit) // INLINED!!
        local integer hid
        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("AIOnWaveDeath enter " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
        endif

        if u == null then
            if WAVE_DEBUG_ENABLED then
                call WaveDebugLog("AIOnWaveDeath exit unit=null")
            endif
            return
        endif

        set hid=GetHandleId(u)
        if hid != 0 and (HaveSavedInteger(Table__ht, (IAManager___AIIndexByUnit), (hid))) then // INLINED!!
            call IAManager___AIRemoveUnitByIndex((LoadInteger(Table__ht, (IAManager___AIIndexByUnit), (hid)))) // INLINED!!
        endif

        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("AIOnWaveDeath exit " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
        endif

        set u=null
    endfunction

    function IAManager___AIOnWavePause takes nothing returns nothing
        local integer w= (WaveEventWaveId) // INLINED!!
        if w != 0 then
            call SaveInteger(Table__ht, (IAManager___AIWaveIsPaused), (w), ( 1)) // INLINED!!
        endif
    endfunction

    function IAManager___AIOnWaveResume takes nothing returns nothing
        local integer w= (WaveEventWaveId) // INLINED!!
        if w != 0 then
            call SaveInteger(Table__ht, (IAManager___AIWaveIsPaused), (w), ( 0)) // INLINED!!
        endif
    endfunction

    function IAManager___AIOnWaveFinish takes nothing returns nothing
        local integer w= (WaveEventWaveId) // INLINED!!
        if w != 0 then
            if IAManager___AIDebugEnabled and ( IAManager___AIDebugWaveFilter == 0 or IAManager___AIDebugWaveFilter == w ) then
                call IAManager___AILogLimited("FINISH w=" + I2S(w) + " cleanup")
            endif
            call IAManager___AICleanupWave(w)
        endif
    endfunction

    function IAManager___AIOnWaveStart takes nothing returns nothing
        local integer w= (WaveEventWaveId) // INLINED!!
        if w != 0 then
            call SaveInteger(Table__ht, (IAManager___AIWaveIsActive), (w), ( 1)) // INLINED!!
            call SaveInteger(Table__ht, (IAManager___AIWaveIsPaused), (w), ( 0)) // INLINED!!
            if not (HaveSavedInteger(Table__ht, (IAManager___AIWaveUnitCount), (w))) then // INLINED!!
                call SaveInteger(Table__ht, (IAManager___AIWaveUnitCount), (w), ( 0)) // INLINED!!
            endif
        endif
    endfunction

    function AIEnableWave takes integer waveId,boolean enabled returns nothing
        if waveId <= 0 then
            return
        endif
        if enabled then
            call SaveInteger(Table__ht, (IAManager___AIWaveEnabledOverride), (waveId), ( 1)) // INLINED!!
        else
            call SaveInteger(Table__ht, (IAManager___AIWaveEnabledOverride), (waveId), ( 0)) // INLINED!!
        endif
    endfunction

    function AISetDebug takes boolean enabled returns nothing
        set IAManager___AIDebugEnabled=enabled
    endfunction

    function AISetDebugWaveFilter takes integer waveId returns nothing
        if waveId < 0 then
            set waveId=0
        endif
        set IAManager___AIDebugWaveFilter=waveId
    endfunction

    function AISetDebugUnitTypeFilter takes integer unitTypeId returns nothing
        set IAManager___AIDebugUnitTypeFilter=unitTypeId
    endfunction

    function AISetDebugMaxLogsPerTick takes integer maxLogs returns nothing
        if maxLogs < 1 then
            set maxLogs=1
        elseif maxLogs > 64 then
            set maxLogs=64
        endif
        set IAManager___AIDebugMaxLogsPerTick=maxLogs
    endfunction

    function AISetDynamicScheduler takes boolean enabled returns nothing
        set IAManager___AIUseDynamicScheduler=enabled
    endfunction

    function AISetFixedTickMs takes integer ms returns nothing
        set IAManager___AIFixedTickMs=AIClampInt(ms , IAManager___AI_MIN_TICK_MS , IAManager___AI_MAX_TICK_MS)
    endfunction

    function AISetFixedBudget takes integer budget returns nothing
        set IAManager___AIFixedBudget=AIClampInt(budget , IAManager___AI_MIN_BUDGET_PER_TICK , IAManager___AI_MAX_BUDGET_PER_TICK)
    endfunction

    function AIGetCurrentTickMs takes nothing returns integer
        return IAManager___AICurrentTickMs
    endfunction

    function AIGetCurrentBudget takes nothing returns integer
        return IAManager___AICurrentBudget
    endfunction

    // true: si no hay heroes registrados, usa GroupEnumUnitsInRange (modo compatible).
    // false: si no hay heroes registrados, no hace fallback por grupo (modo estricto/optimizado).
    function AISetUseGroupFallbackNoHeroes takes boolean enabled returns nothing
        set IAManager___AIUseGroupFallbackNoHeroes=enabled
    endfunction

    // Registra héroe objetivo por player id (0..bj_MAX_PLAYER_SLOTS-1).
    // Cuando hay al menos uno registrado, el targeting evita GroupEnumUnitsInRange.
    function AISetTrackedHeroForPlayer takes integer playerId,unit hero returns nothing
        if playerId < 0 or playerId >= bj_MAX_PLAYER_SLOTS then
            return
        endif
        if hero != null and GetUnitTypeId(hero) == 0 then
            set hero=null
        endif
        set s__IAManager___AITrackedHeroByPlayer[playerId]= hero
        call WaveRangedSkillsSetTrackedHeroForPlayer(playerId , hero)
        if IAManager___AIDebugEnabled then
            if hero != null then
                call IAManager___AILog("TrackedHero p=" + I2S(playerId) + " ut=" + I2S(GetUnitTypeId(hero)) + " owner=" + I2S(GetPlayerId(GetOwningPlayer(hero))))
            else
                call IAManager___AILog("TrackedHero p=" + I2S(playerId) + " cleared")
            endif
        endif
    endfunction

    // Helper: registra por owner de la unidad.
    function AISetTrackedHero takes unit hero returns nothing
        if hero == null or GetUnitTypeId(hero) == 0 then
            return
        endif
        call AISetTrackedHeroForPlayer(GetPlayerId(GetOwningPlayer(hero)) , hero)
    endfunction

    function AIClearTrackedHeroes takes nothing returns nothing
        local integer i= 0
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set s__IAManager___AITrackedHeroByPlayer[i]= null
            set i=i + 1
        endloop
    endfunction

    function AIDebugDumpTrackedHeroes takes nothing returns nothing
        local integer i= 0
        local unit u
        if not IAManager___AIDebugEnabled then
            return
        endif
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set u=s__IAManager___AITrackedHeroByPlayer[i]
            if u != null and GetUnitTypeId(u) != 0 then
                call BJDebugMsg("[IAManager] tracked[" + I2S(i) + "] ut=" + I2S(GetUnitTypeId(u)) + " owner=" + I2S(GetPlayerId(GetOwningPlayer(u))) + " alive=" + I2S(AIBoolToInt(UnitAlive(u))))
            else
                call BJDebugMsg("[IAManager] tracked[" + I2S(i) + "] = null")
            endif
            set i=i + 1
        endloop
        set u=null
    endfunction

    function IAManager___Init takes nothing returns nothing
        set IAManager___AIUnitByIndex=s__Table_create()
        set IAManager___AIIndexByUnit=s__Table_create()

        set IAManager___AIUnitWaveId=s__Table_create()
        set IAManager___AIUnitProfileId=s__Table_create()
        set IAManager___AIUnitLaneId=s__Table_create()
        set IAManager___AIUnitBehaviorFlags=s__Table_create()
        set IAManager___AIUnitThreatWeight=s__Table_create()

        set IAManager___AIUnitTarget=s__Table_create()
        set IAManager___AIUnitNextRetargetMs=s__Table_create()
        set IAManager___AIUnitNextOrderMs=s__Table_create()
        set IAManager___AIUnitNextAbilityMs=s__Table_create()
        set IAManager___AIUnitChannelLockUntilMs=s__Table_create()
        set IAManager___AIUnitNextTeleportMs=s__Table_create()
        set IAManager___AIUnitTeleportReadyMs=s__Table_create()
        set IAManager___AIUnitNextDebugMs=s__Table_create()
        set IAManager___AIUnitCooldownTables=s__Table_create()
        set IAManager___AIUnitLastOrderType=s__Table_create()
        set IAManager___AIUnitLastOrderTarget=s__Table_create()
        set IAManager___AIUnitLastOrderX=s__Table_create()
        set IAManager___AIUnitLastOrderY=s__Table_create()
        set IAManager___AIBossReinforcementNextMs=s__Table_create()
        set IAManager___AIBossReinforcementCastByUnit=s__Table_create()

        set IAManager___AIWaveIsActive=s__Table_create()
        set IAManager___AIWaveIsPaused=s__Table_create()
        set IAManager___AIWaveUnitCount=s__Table_create()
        set IAManager___AIWaveEnabledOverride=s__Table_create()

        set IAManager___AITempGroup=CreateGroup()
        set IAManager___AITimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(IAManager___AITimer , TIMER_DEBUG_TAG_AI)
        set IAManager___AIFixedTickMs=AIClampInt(IAManager___AIFixedTickMs , IAManager___AI_MIN_TICK_MS , IAManager___AI_MAX_TICK_MS)
        set IAManager___AIFixedBudget=AIClampInt(IAManager___AIFixedBudget , IAManager___AI_MIN_BUDGET_PER_TICK , IAManager___AI_MAX_BUDGET_PER_TICK)
        set IAManager___AICurrentTickMs=IAManager___AIFixedTickMs
        set IAManager___AICurrentBudget=IAManager___AIFixedBudget
        set IAManager___AINextPerfLogMs=0
        call TimerStart(IAManager___AITimer, I2R(IAManager___AICurrentTickMs) * 0.001, false, function IAManager___AIOnTick)

        call RegisterWaveStartEvent(function IAManager___AIOnWaveStart)
        call RegisterWaveSpawnEvent(function IAManager___AIOnWaveSpawn)
        call RegisterWaveExternalEvent(function IAManager___AIOnWaveExternal)
        call RegisterWaveDeathEvent(function IAManager___AIOnWaveDeath)
        call RegisterWavePauseEvent(function IAManager___AIOnWavePause)
        call RegisterWaveResumeEvent(function IAManager___AIOnWaveResume)
        call RegisterWaveFinishEvent(function IAManager___AIOnWaveFinish)

        call IAManager___AILog("Initialized")
    endfunction

//**
//* User settings:
//* ==============



    function LoadoutMissile__FilterUnits takes unit target,player owner returns boolean
        return UnitAlive(target) and IsUnitEnemy(target, owner) and not IsUnitType(target, UNIT_TYPE_STRUCTURE)
    endfunction


    function LoadoutMissile__DamageUnit takes unit source,unit target,real amount returns boolean
        if amount <= 0. then
            return false
        endif
        if ( GetUnitTypeId(source) == 0 ) or ( GetUnitTypeId(target) == 0 ) then
            return false
        endif
        call WaveRecordDamageCredit(source , target)
        return UnitDamageTarget(source, target, amount, false, false, LoadoutMissile__ATTACK_TYPE, LoadoutMissile__DAMAGE_TYPE, null)
    endfunction

    function LoadoutMissile__HealCasterOnHit takes unit source,player owner returns nothing
        local real healAmount
        if GetUnitTypeId(source) == 0 then
            return
        endif
        if not UnitAlive(source) then
            return
        endif
        set healAmount=(PlayerMissileLoadout__chosenHealOnHit[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        if healAmount <= 0. then
            return
        endif
        call SetUnitState(source, UNIT_STATE_LIFE, GetUnitState(source, UNIT_STATE_LIFE) + healAmount)
    endfunction

    function LoadoutMissile__DamageArea takes unit source,player owner,real x,real y,real radius,real amount returns nothing
        local unit u
        if amount <= 0. then
            return
        endif
        if GetUnitTypeId(source) == 0 then
            return
        endif
        call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, x, y, radius, null)
        loop
            set u=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
            exitwhen u == null
            call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, u)
            if LoadoutMissile__FilterUnits(u , owner) then
                call WaveRecordDamageCredit(source , u)
                call UnitDamageTarget(source, u, amount, false, false, LoadoutMissile__ATTACK_TYPE, LoadoutMissile__DAMAGE_TYPE, null)
            endif
        endloop
        set u=null
    endfunction

    function LoadoutMissile__GetBarrierProjectileKind takes integer missile returns integer
        if LoadoutMissile__bonusActive[missile] then
            if LoadoutMissile__specialAbility[missile] == LOADOUT_ORB_ABILITY_WIND then
                return WAVE_BARRIER_PROJECTILE_KIND_WIND
            endif
            if LoadoutMissile__specialAbility[missile] == LOADOUT_ORB_ABILITY_RAY then
                return WAVE_BARRIER_PROJECTILE_KIND_RAY
            endif
        endif
        return WAVE_BARRIER_PROJECTILE_KIND_NORMAL
    endfunction

    function LoadoutMissile__ResolveBarrierIntercept takes integer missile returns integer
        local integer interaction= WaveBarrierCheckPlayerProjectile(missile , s__Missile_owner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , LoadoutMissile__GetBarrierProjectileKind(missile))
        local real radius
        local real finalDamage
        if interaction == WAVE_BARRIER_INTERACTION_WIND then
            if LoadoutMissile__bonusActive[missile] and LoadoutMissile__specialAbility[missile] == LOADOUT_ORB_ABILITY_WIND then
                set radius=(LOADOUT_ORB_WIND_BASE_AOE + LOADOUT_ORB_WIND_AOE_PER_INSTANCE * LoadoutClampInstance((LoadoutMissile__effectInstances[missile]))) // INLINED!!
                set finalDamage=(LOADOUT_ORB_WIND_BASE_DAMAGE + ((LoadoutMissile__storedDamage[missile])*1.0)) // INLINED!!
                call LoadoutMissile__DamageArea(s__Missile_source[missile] , s__Missile_owner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , radius , finalDamage)
            endif
            return WAVE_BARRIER_INTERACTION_WIND
        endif
        if interaction == WAVE_BARRIER_INTERACTION_RAY then
            if LoadoutMissile__bonusActive[missile] and LoadoutMissile__specialAbility[missile] == LOADOUT_ORB_ABILITY_RAY and LoadoutMissile__rayHitsLeft[missile] > 0 then
                set LoadoutMissile__rayHitsLeft[missile]=LoadoutMissile__rayHitsLeft[missile] - 1
                return WAVE_BARRIER_INTERACTION_RAY
            endif
            return WAVE_BARRIER_INTERACTION_BLOCK
        endif
        return interaction
    endfunction

    function LoadoutMissile__PoisonListAdd takes integer dex returns nothing
        set LoadoutMissile__poisonPrev[dex]=0
        set LoadoutMissile__poisonNext[dex]=LoadoutMissile__poisonHead
        if LoadoutMissile__poisonHead != 0 then
            set LoadoutMissile__poisonPrev[LoadoutMissile__poisonHead]=dex
        endif
        set LoadoutMissile__poisonHead=dex
    endfunction

    function LoadoutMissile__PoisonListRemove takes integer dex returns nothing
        local integer p= LoadoutMissile__poisonPrev[dex]
        local integer n= LoadoutMissile__poisonNext[dex]
        if p != 0 then
            set LoadoutMissile__poisonNext[p]=n
        else
            set LoadoutMissile__poisonHead=n
        endif
        if n != 0 then
            set LoadoutMissile__poisonPrev[n]=p
        endif
        set LoadoutMissile__poisonPrev[dex]=0
        set LoadoutMissile__poisonNext[dex]=0
    endfunction

    function LoadoutMissile__PoisonDestroy takes integer dex returns nothing
        call LoadoutMissile__PoisonListRemove(dex)
        if LoadoutMissile__poisonFx[dex] != null then
            call DestroyEffect(LoadoutMissile__poisonFx[dex])
            set LoadoutMissile__poisonFx[dex]=null
        endif
        call s__SpellIndex_destroy(dex)
    endfunction

    function LoadoutMissile__OnPoisonTick takes nothing returns nothing
        local integer node= LoadoutMissile__poisonHead
        local integer nextNode
        local integer dex
        loop
            exitwhen node == 0
            set dex=(node)
            set nextNode=LoadoutMissile__poisonNext[node]
            if ( s__SpellIndex_count[dex] <= 0 ) or ( GetUnitTypeId(s__SpellIndex_target[dex]) == 0 ) or ( not UnitAlive(s__SpellIndex_target[dex]) ) or ( GetUnitTypeId(s__SpellIndex_source[dex]) == 0 ) then
                call LoadoutMissile__PoisonDestroy(dex)
            else
                call WaveRecordDamageCredit(s__SpellIndex_source[dex] , s__SpellIndex_target[dex])
                call UnitDamageTarget(s__SpellIndex_source[dex], s__SpellIndex_target[dex], s__SpellIndex_damage[dex], false, false, LoadoutMissile__ATTACK_TYPE, LoadoutMissile__DAMAGE_TYPE, null)
                call ShowCustomLoadoutText(s__SpellIndex_target[dex] , "-" + FormatLoadoutDamageText(s__SpellIndex_damage[dex]) , LoadoutMissile__POISON_TEXT_R , LoadoutMissile__POISON_TEXT_G , LoadoutMissile__POISON_TEXT_B)
                set s__SpellIndex_count[dex]=s__SpellIndex_count[dex] - 1
                if s__SpellIndex_count[dex] <= 0 then
                    call LoadoutMissile__PoisonDestroy(dex)
                endif
            endif
            set node=nextNode
        endloop
        if ( LoadoutMissile__poisonHead == 0 ) and ( LoadoutMissile__poisonTicker != null ) then
            call ReleaseTimer(LoadoutMissile__poisonTicker)
            set LoadoutMissile__poisonTicker=null
        endif
    endfunction

    function LoadoutMissile__ApplyPoison takes unit source,unit target,real damagePerSecond,real duration returns nothing
        local integer dex
        local integer ticks
        local real covered
        if ( GetUnitTypeId(source) == 0 ) or ( GetUnitTypeId(target) == 0 ) then
            return
        endif
        if damagePerSecond <= 0. then
            return
        endif
        if duration <= 0. then
            return
        endif
        if LOADOUT_ORB_POISON_TICK_INTERVAL <= 0. then
            return
        endif
        set ticks=R2I(duration / LOADOUT_ORB_POISON_TICK_INTERVAL)
        set covered=I2R(ticks) * LOADOUT_ORB_POISON_TICK_INTERVAL
        if covered < duration then
            set ticks=ticks + 1
        endif
        if ticks < 1 then
            set ticks=1
        endif
        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_target[dex]=target
        set s__SpellIndex_damage[dex]=damagePerSecond
        if ( LoadoutMissile__POISON_DOT_FX != "" ) then
            set LoadoutMissile__poisonFx[dex]=AddSpecialEffectTarget(LoadoutMissile__POISON_DOT_FX, target, LoadoutMissile__POISON_DOT_FX_ATTACH)
        else
            set LoadoutMissile__poisonFx[dex]=null
        endif

        // Impact damage.
        call WaveRecordDamageCredit(source , target)
        call UnitDamageTarget(source, target, damagePerSecond, false, false, LoadoutMissile__ATTACK_TYPE, LoadoutMissile__DAMAGE_TYPE, null)
        call ShowCustomLoadoutText(target , FormatLoadoutDamageText(damagePerSecond) , LoadoutMissile__POISON_TEXT_R , LoadoutMissile__POISON_TEXT_G , LoadoutMissile__POISON_TEXT_B)

        if ticks <= 0 then
            if LoadoutMissile__poisonFx[dex] != null then
                call DestroyEffect(LoadoutMissile__poisonFx[dex])
                set LoadoutMissile__poisonFx[dex]=null
            endif
            call s__SpellIndex_destroy(dex)
            return
        endif

        set s__SpellIndex_count[dex]=ticks
        call LoadoutMissile__PoisonListAdd(dex)
        if LoadoutMissile__poisonTicker == null then
            set LoadoutMissile__poisonTicker=(NewTimerEx(0)) // INLINED!!
            call SetTimerDebugTag(LoadoutMissile__poisonTicker , TIMER_DEBUG_TAG_LOADOUT_MISSILE)
            call TimerStart(LoadoutMissile__poisonTicker, LOADOUT_ORB_POISON_TICK_INTERVAL, true, function LoadoutMissile__OnPoisonTick)
        endif
    endfunction

        function s__LoadoutMissile__LoadoutCore_onCollide takes integer missile,unit hit returns boolean
            local real baseDamage= LoadoutMissile__storedDamage[missile]
            local real finalDamage= baseDamage
            local real extraDamage= 0.
            local real radius
            local boolean wasAlive
            local real bloodMult
            local integer remaining
            local integer bloodPct
            local integer inst= LoadoutMissile__effectInstances[missile]
            local integer abil= LoadoutMissile__specialAbility[missile]
            local integer barrierInteraction

            set barrierInteraction=LoadoutMissile__ResolveBarrierIntercept(missile)
            if barrierInteraction == WAVE_BARRIER_INTERACTION_BLOCK or barrierInteraction == WAVE_BARRIER_INTERACTION_WIND then
                return true
            endif
            if barrierInteraction == WAVE_BARRIER_INTERACTION_RAY then
                return false
            endif

            if not LoadoutMissile__FilterUnits(hit , s__Missile_owner[missile]) then
                return false
            endif

            if not LoadoutMissile__bonusActive[missile] then
                set wasAlive=UnitAlive(hit)
                call LoadoutMissile__DamageUnit(s__Missile_source[missile] , hit , baseDamage)
                call LoadoutMissile__HealCasterOnHit(s__Missile_source[missile] , s__Missile_owner[missile])
                return wasAlive and UnitAlive(hit)
            endif

            if abil == LOADOUT_ORB_ABILITY_RAY then
                set wasAlive=UnitAlive(hit)
                call LoadoutMissile__DamageUnit(s__Missile_source[missile] , hit , baseDamage)
                call LoadoutMissile__HealCasterOnHit(s__Missile_source[missile] , s__Missile_owner[missile])

                // rayHitsLeft means "how many units can be pierced".
                // If the hit unit dies, do not consume a pierce slot.
                if LoadoutMissile__rayHitsLeft[missile] > 0 then
                    set remaining=LoadoutMissile__rayHitsLeft[missile]
                    call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(baseDamage) + "/[" + I2S(remaining) + "]" , LoadoutMissile__RAY_TEXT_R , LoadoutMissile__RAY_TEXT_G , LoadoutMissile__RAY_TEXT_B)
                    if wasAlive and UnitAlive(hit) then
                        set LoadoutMissile__rayHitsLeft[missile]=LoadoutMissile__rayHitsLeft[missile] - 1
                    endif
                    return false
                endif
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(baseDamage) + "/[0]" , LoadoutMissile__RAY_TEXT_R , LoadoutMissile__RAY_TEXT_G , LoadoutMissile__RAY_TEXT_B)
                return true

            elseif abil == LOADOUT_ORB_ABILITY_FIRE then
                set finalDamage=(((baseDamage )*1.0) * ( 1. + LOADOUT_ORB_FIRE_DAMAGE_PERCENT_PER_INSTANCE * LoadoutClampInstance(( inst)) )) // INLINED!!
                set wasAlive=UnitAlive(hit)
                call LoadoutMissile__DamageUnit(s__Missile_source[missile] , hit , finalDamage)
                call LoadoutMissile__HealCasterOnHit(s__Missile_source[missile] , s__Missile_owner[missile])
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(finalDamage) , LoadoutMissile__FIRE_TEXT_R , LoadoutMissile__FIRE_TEXT_G , LoadoutMissile__FIRE_TEXT_B)
                return wasAlive and UnitAlive(hit)

            elseif abil == LOADOUT_ORB_ABILITY_POISON then
                set wasAlive=UnitAlive(hit)
                call LoadoutMissile__ApplyPoison(s__Missile_source[missile] , hit , (((baseDamage)*1.0) * LOADOUT_ORB_POISON_DAMAGE_MULT) , (LOADOUT_ORB_POISON_DURATION_PER_INSTANCE * LoadoutClampInstance((inst)))) // INLINED!!
                call LoadoutMissile__HealCasterOnHit(s__Missile_source[missile] , s__Missile_owner[missile])
                return wasAlive and UnitAlive(hit)

            elseif abil == LOADOUT_ORB_ABILITY_WIND then
                set radius=(LOADOUT_ORB_WIND_BASE_AOE + LOADOUT_ORB_WIND_AOE_PER_INSTANCE * LoadoutClampInstance((inst))) // INLINED!!
                set finalDamage=(LOADOUT_ORB_WIND_BASE_DAMAGE + ((baseDamage)*1.0)) // INLINED!!
                set wasAlive=UnitAlive(hit)
                call LoadoutMissile__DamageArea(s__Missile_source[missile] , s__Missile_owner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , radius , finalDamage)
                call LoadoutMissile__HealCasterOnHit(s__Missile_source[missile] , s__Missile_owner[missile])
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(finalDamage) + "/[" + FormatLoadoutDamageText(radius) + "]" , LoadoutMissile__WIND_TEXT_R , LoadoutMissile__WIND_TEXT_G , LoadoutMissile__WIND_TEXT_B)
                return wasAlive and UnitAlive(hit)

            elseif abil == LOADOUT_ORB_ABILITY_DARK then
                set extraDamage=LoadoutGetDarkBonus(hit , inst)
                set finalDamage=baseDamage + extraDamage
                set wasAlive=UnitAlive(hit)
                call LoadoutMissile__DamageUnit(s__Missile_source[missile] , hit , finalDamage)
                call LoadoutMissile__HealCasterOnHit(s__Missile_source[missile] , s__Missile_owner[missile])
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(finalDamage) , LoadoutMissile__DARK_TEXT_R , LoadoutMissile__DARK_TEXT_G , LoadoutMissile__DARK_TEXT_B)
                return wasAlive and UnitAlive(hit)

            elseif abil == LOADOUT_ORB_ABILITY_BLOOD then
                set bloodMult=LoadoutGetBloodRandomMultiplier(inst)
                set finalDamage=baseDamage * bloodMult
                set bloodPct=(R2I(((bloodMult)*1.0) * 100. + 0.5)) // INLINED!!
                set wasAlive=UnitAlive(hit)
                call LoadoutMissile__DamageUnit(s__Missile_source[missile] , hit , finalDamage)
                call LoadoutMissile__HealCasterOnHit(s__Missile_source[missile] , s__Missile_owner[missile])
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(finalDamage) + "   //" + I2S(bloodPct) + "%" , LoadoutMissile__CRIT_TEXT_R , LoadoutMissile__CRIT_TEXT_G , LoadoutMissile__CRIT_TEXT_B)
                return wasAlive and UnitAlive(hit)
            endif

            set wasAlive=UnitAlive(hit)
            call LoadoutMissile__DamageUnit(s__Missile_source[missile] , hit , baseDamage)
            call LoadoutMissile__HealCasterOnHit(s__Missile_source[missile] , s__Missile_owner[missile])
            return wasAlive and UnitAlive(hit)
        endfunction

        function s__LoadoutMissile__LoadoutCore_onFinish takes integer missile returns boolean
            return true
        endfunction

        function s__LoadoutMissile__LoadoutCore_onDestructable takes integer missile,destructable hit returns boolean
            return true
        endfunction

        function s__LoadoutMissile__LoadoutCore_onTerrain takes integer missile returns boolean
            return true
        endfunction

        function s__LoadoutMissile__LoadoutCore_onPeriod takes integer missile returns boolean
            local integer barrierInteraction= LoadoutMissile__ResolveBarrierIntercept(missile)
            if barrierInteraction == WAVE_BARRIER_INTERACTION_BLOCK or barrierInteraction == WAVE_BARRIER_INTERACTION_WIND then
                return true
            endif
            return false
        endfunction

        function s__LoadoutMissile__LoadoutCore_onRemove takes integer missile returns boolean
            if LoadoutMissile__overlayFx[missile] != null then
                call DestroyEffect(LoadoutMissile__overlayFx[missile])
            endif
            set LoadoutMissile__overlayFx[missile]=null
            set LoadoutMissile__specialAbility[missile]=0
            set LoadoutMissile__storedDamage[missile]=0.
            set LoadoutMissile__effectInstances[missile]=0
            set LoadoutMissile__rayHitsLeft[missile]=0
            set LoadoutMissile__bonusActive[missile]=false
            call WaveBarrierClearProjectileTrace(missile)
            call s__SpellIndex_destroy((s__Missile_data[missile]))
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__LoadoutMissile__LoadoutCore_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__LoadoutMissile__LoadoutCore],missile)
            call Missile___StartPeriodic(si__LoadoutMissile__LoadoutCore)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__LoadoutMissile__LoadoutCore_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__LoadoutMissile__LoadoutCore_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__LoadoutMissile__LoadoutCore)
            endif
        endfunction
























        

        function s__LoadoutMissile__LoadoutCore_MissileAction___missileActionDest takes nothing returns nothing
            local destructable d= GetEnumDestructable()
            local integer this= s__Missile_temp
            if s__Missile_allocated[this] then
                call SaveDestructableHandle(Missile___HASH, this, GetHandleId(d), d)
                if s__LoadoutMissile__LoadoutCore_onDestructable(this , d) then
                    call s__LoadoutMissile__LoadoutCore_missileTerminateP(this)
                endif
            endif
            set d=null
        endfunction

    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__LoadoutMissile__LoadoutCore_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__LoadoutMissile__LoadoutCore])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__LoadoutMissile__LoadoutCore_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.

                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            set b=s__Missile_collisionType[this] == Missile_COLLISION_TYPE_RECTANGLE
                            if b then
                                call s__Missile_groupEnumUnitsRectangle(this)
                            else
                                call GroupEnumUnitsInRange(Missile___GROUP, s__Missile_x[this], s__Missile_y[this], s__Missile_collision[this] + Missile_MAXIMUM_COLLISION_SIZE, null)
                            endif
                            loop
                                set u=FirstOfGroup(Missile___GROUP)
                                exitwhen u == null
                                call GroupRemoveUnit(Missile___GROUP, u)
                                if not HaveSavedHandle(Missile___HASH, this, GetHandleId(u)) then
                                    if IsUnitInRange(u, s__Missile_dummy[this], s__Missile_collision[this]) or b then
                                        // Eventually run z collision checks.

                                            set collideZ=Missile_GetLocZ(GetUnitX(u) , GetUnitY(u)) + GetUnitFlyHeight(u) - s__Missile_terrainZ[this]
                                            if ( collideZ + GetUnitBodySize(u) >= s__Missile_z[this] - (s__Missile_collision[(this)]) ) and ( collideZ <= s__Missile_z[this] + (s__Missile_collision[(this)]) ) then // INLINED!!
                                                // Mark as hit.
                                                call SaveUnitHandle(Missile___HASH, this, GetHandleId(u), u)
                                                if s__LoadoutMissile__LoadoutCore_onCollide(this , u) then
                                                    call s__LoadoutMissile__LoadoutCore_missileTerminateP(this)
                                                    exitwhen true
                                                endif
                                            endif
    








                                    endif
                                endif
                            endloop
                        endif

                    
                    // Runs destructable collision.

                        // Check if the missile is not terminated.
                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            call s__Missile_checkDestCollision(this,function s__LoadoutMissile__LoadoutCore_MissileAction___missileActionDest)
                        endif

                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__LoadoutMissile__LoadoutCore_onFinish(this) then
                                call s__LoadoutMissile__LoadoutCore_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.

                        if s__Missile_allocated[this] and 0. > s__Missile_z[this] and s__LoadoutMissile__LoadoutCore_onTerrain(this) then
                            call s__LoadoutMissile__LoadoutCore_missileTerminateP(this)
                        endif

                
                    // Runs every Missile_TIMER_TIMEOUT.

                        if s__Missile_allocated[this] and s__LoadoutMissile__LoadoutCore_onPeriod(this) then
                            call s__LoadoutMissile__LoadoutCore_missileTerminateP(this)
                        endif

                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__LoadoutMissile__LoadoutCore_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__LoadoutMissile__LoadoutCore)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__LoadoutMissile__LoadoutCore )]=Condition(( function s__LoadoutMissile__LoadoutCore_missileIterateP)) // INLINED!!
        endfunction

    function LoadoutMissile__Cleanup takes integer dex returns nothing
        local integer id= 0
        if dex == 0 or s__SpellIndex_phase[dex] == - 999 then
            return
        endif
        set s__SpellIndex_phase[dex]=- 999
        set id=GetHandleId(s__SpellIndex_source[dex])
        if (HaveSavedInteger(Table__ht, (LoadoutMissile__active), (id))) and ( (LoadInteger(Table__ht, (LoadoutMissile__active), (id))) == dex ) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (LoadoutMissile__active), (id)) // INLINED!!
        endif
        if ( GetUnitTypeId(s__SpellIndex_source[dex]) != 0 ) then
            call SetUnitTimeScale(s__SpellIndex_source[dex], LoadoutMissile__ANIMATION_TIME_SCALE_ON_END)
        endif
        if LoadoutMissile__delayedAnimTimer[dex] != null then
            call ReleaseTimer(LoadoutMissile__delayedAnimTimer[dex])
            set LoadoutMissile__delayedAnimTimer[dex]=null
        endif
        set LoadoutMissile__aim[dex]=0.
        set LoadoutMissile__activeWeaponProfile[dex]=WEAPON_PROFILE_NONE
        if s__SpellIndex_clock[dex] != null then
            call ReleaseTimer(s__SpellIndex_clock[dex])
            set s__SpellIndex_clock[dex]=null
        endif
        call s__SpellIndex_destroy(dex)
    endfunction

    function LoadoutMissile__DelayedStartAnimation takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local unit source= s__SpellIndex_source[dex]
        local integer id
        set LoadoutMissile__delayedAnimTimer[dex]=null
        if ( GetUnitTypeId(source) != 0 ) and UnitAlive(source) and ( s__SpellIndex_phase[dex] >= 0 ) then
            set id=GetHandleId(source)
            if (HaveSavedInteger(Table__ht, (LoadoutMissile__active), (id))) and ( (LoadInteger(Table__ht, (LoadoutMissile__active), (id))) == dex ) then // INLINED!!
                call SetUnitAnimation(source, LoadoutMissile__CAST_ANIMATION)
            endif
        endif
        call ReleaseTimer(t)
        set source=null
        set t=null
    endfunction

    function LoadoutMissile__LaunchSingleLoadoutMissile takes unit source,player owner,real angle,real lateralOffset,integer profileId returns nothing
        local real x= GetUnitX(source) + lateralOffset * Cos(angle + bj_PI / 2.)
        local real y= GetUnitY(source) + lateralOffset * Sin(angle + bj_PI / 2.)
        local string baseModel
        local string wrapModel
        local real speed
        local real damage
        local integer instances
        local integer chosen
        local integer chosenLevel
        local integer mDex
        local integer missile

        if not WeaponInventoryConsumeShotForProfile(owner , profileId) then
            return
        endif

        set missile=s__Missile_create(x , y , LoadoutMissile__MISSILE_START_Z , angle , WeaponProfileGetRange(profileId) , LoadoutMissile__MISSILE_START_Z)
        set mDex=s__SpellIndex__allocate()
        set chosen=(PlayerMissileLoadout__chosenAbility[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        set chosenLevel=0
        if chosen != 0 then
            set chosenLevel=GetUnitAbilityLevel(source, chosen)
        endif

        set speed=WeaponProfileGetMissileSpeed(profileId) + (PlayerMissileLoadout__chosenSpeedBonus[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        if speed < LoadoutMissile__MIN_MISSILE_SPEED then
            set speed=LoadoutMissile__MIN_MISSILE_SPEED
        endif
        set damage=WeaponProfileGetDamage(profileId)
        if damage < 0. then
            set damage=0.
        endif
        set instances=(PlayerMissileLoadout__chosenInstances[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        if instances < 1 then
            set instances=1
        endif

        set baseModel=WeaponProfileGetTierMissileModel(profileId , 1)
        if ( baseModel == "" ) then
            set baseModel=LoadoutMissile__BASE_MISSILE_MODEL
        endif
        set wrapModel=(PlayerMissileLoadout__chosenOverlayPath[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!

        set s__SpellIndex_source[mDex]=source
        set s__SpellIndex_user[mDex]=owner
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=owner
        set s__Missile_data[missile]=mDex
        call s__Missile__set_model(missile,baseModel)
        call s__Missile__set_scale(missile,WeaponProfileGetMissileScale(profileId))
        set s__Missile_collision[missile]=LoadoutMissile__MISSILE_COLLISION
        set s__Missile_speed[(missile)]=((speed)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!

        set LoadoutMissile__specialAbility[missile]=chosen
        set LoadoutMissile__storedDamage[missile]=damage
        set LoadoutMissile__effectInstances[missile]=instances
        set LoadoutMissile__rayHitsLeft[missile]=(LoadoutClampInstance((LoadoutMissile__effectInstances[missile]))) // INLINED!!
        set LoadoutMissile__bonusActive[missile]=( chosen != 0 ) and ( chosenLevel > 0 ) and ( chosenLevel < 5 )
        if LoadoutMissile__bonusActive[missile] then
            call TriggerLoadoutIntFullManaSwapForAbility((source ) , ( chosen)) // INLINED!!
        endif

        if LoadoutMissile__bonusActive[missile] and ( wrapModel != "" ) then
            set LoadoutMissile__overlayFx[missile]=AddSpecialEffectTarget(wrapModel, s__Missile_dummy[missile], LoadoutMissile__WRAP_ATTACH_POINT)
        else
            set LoadoutMissile__overlayFx[missile]=null
        endif

        call s__LoadoutMissile__LoadoutCore_launch(missile)
    endfunction

    function LoadoutMissile__FireMissile takes integer dex returns nothing
        local unit source= s__SpellIndex_source[dex]
        local player owner= s__SpellIndex_user[dex]
        local real angle= LoadoutMissile__aim[dex]
        local integer profileId= LoadoutMissile__activeWeaponProfile[dex]

        if not WeaponProfileIsWeapon(profileId) then
            set profileId=WEAPON_PROFILE_HANDGUN
        endif

        if WeaponProfileGetBehavior(profileId) == WEAPON_BEHAVIOR_DOUBLE_STRAIGHT then
            call LoadoutMissile__LaunchSingleLoadoutMissile(source , owner , angle , - 42.00 , profileId)
            call LoadoutMissile__LaunchSingleLoadoutMissile(source , owner , angle , 42.00 , profileId)
        else
            call LoadoutMissile__LaunchSingleLoadoutMissile(source , owner , angle , 0.00 , profileId)
        endif

        set source=null
        set owner=null
    endfunction

    function GetLoadoutMissileMoveCastDuration takes nothing returns real
        return WeaponProfileGetCastDuration(WEAPON_PROFILE_HANDGUN)
    endfunction

    function GetLoadoutMissileMoveCastDurationForAbility takes integer abilityId returns real
        local integer profileId= WeaponProfileFromFireAbility(abilityId)
        if not WeaponProfileIsWeapon(profileId) then
            set profileId=WEAPON_PROFILE_HANDGUN
        endif
        return WeaponProfileGetCastDuration(profileId)
    endfunction

    function LoadoutMissile__GetSafeFireInterval takes integer profileId returns real
        local real duration= WeaponProfileGetCastDuration(profileId)
        local integer count= WeaponProfileGetCastCount(profileId)
        if duration <= 0. then
            return 0.03125
        endif
        if count <= 0 then
            return duration
        endif
        return duration / I2R(count)
    endfunction

    function LoadoutMissile__OnPeriodic takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local real step= LoadoutMissile__GetSafeFireInterval(LoadoutMissile__activeWeaponProfile[dex])

        if ( GetUnitTypeId(s__SpellIndex_source[dex]) == 0 ) or ( not UnitAlive(s__SpellIndex_source[dex]) ) or ( s__SpellIndex_phase[dex] < 0 ) then
            call LoadoutMissile__Cleanup(dex)
            set t=null
            return
        endif

        if s__SpellIndex_time[dex] <= 0. then
            call LoadoutMissile__Cleanup(dex)
            set t=null
            return
        endif

        call SetUnitAnimation(s__SpellIndex_source[dex], LoadoutMissile__CAST_ANIMATION)
        call LoadoutMissile__FireMissile(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step

        if s__SpellIndex_time[dex] <= 0. then
            call LoadoutMissile__Cleanup(dex)
        endif

        set t=null
    endfunction

    function LoadoutMissile__MarkCanceled takes unit whichUnit returns nothing
        local integer id= GetHandleId(whichUnit)
        if (HaveSavedInteger(Table__ht, (LoadoutMissile__active), (id))) then // INLINED!!
            // A running cast session is refreshed by recast; orders should not kill it.
            return
        endif
    endfunction

    function LoadoutMissile__OnOrder takes nothing returns nothing
        call LoadoutMissile__MarkCanceled(GetTriggerUnit())
    endfunction

    function LoadoutMissile__OnPointOrder takes nothing returns nothing
        call LoadoutMissile__MarkCanceled(GetTriggerUnit())
    endfunction

    function LoadoutMissile__OnTargetOrder takes nothing returns nothing
        call LoadoutMissile__MarkCanceled(GetTriggerUnit())
    endfunction

    function LoadoutMissileFireProfile takes unit source,player owner,integer profileId,real tx,real ty returns boolean
        local integer id= GetHandleId(source)
        local integer dex
        local real x= GetUnitX(source)
        local real y= GetUnitY(source)
        local boolean useRapid
        local real duration
        local real step

        if not WeaponProfileIsWeapon(profileId) then
            set profileId=WEAPON_PROFILE_HANDGUN
        endif
        set duration=WeaponProfileGetCastDuration(profileId)
        set step=LoadoutMissile__GetSafeFireInterval(profileId)

        if (HaveSavedInteger(Table__ht, (LoadoutMissile__active), (id))) then // INLINED!!
            set dex=(LoadInteger(Table__ht, (LoadoutMissile__active), (id))) // INLINED!!
            if ( s__SpellIndex_phase[dex] >= 0 ) and ( GetUnitTypeId(s__SpellIndex_source[dex]) != 0 ) and UnitAlive(s__SpellIndex_source[dex]) then
                set LoadoutMissile__aim[dex]=Atan2(ty - y, tx - x)
                set LoadoutMissile__activeWeaponProfile[dex]=profileId
                set s__SpellIndex_time[dex]=duration
                call SetUnitTimeScale(source, LoadoutMissile__RAPID_FIRE_ANIMATION_TIME_SCALE)
                return true
            endif
            call LoadoutMissile__Cleanup(dex)
        endif

        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_user[dex]=owner
        set useRapid=(PlayerMissileLoadout__chosenUseRapidFireMissile[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        set LoadoutMissile__activeWeaponProfile[dex]=profileId
        if useRapid and ( duration > 0. ) then
            set s__SpellIndex_time[dex]=duration
        else
            set s__SpellIndex_time[dex]=0.
        endif
        set s__SpellIndex_phase[dex]=1
        set s__SpellIndex_clock[dex]=NewTimerEx(dex)
        call SetTimerDebugTag(s__SpellIndex_clock[dex] , TIMER_DEBUG_TAG_LOADOUT_MISSILE)

        set LoadoutMissile__aim[dex]=Atan2(ty - y, tx - x)
        call SaveInteger(Table__ht, (LoadoutMissile__active), (id), ( dex)) // INLINED!!

        call SetUnitTimeScale(source, LoadoutMissile__RAPID_FIRE_ANIMATION_TIME_SCALE)
        set LoadoutMissile__delayedAnimTimer[dex]=NewTimerEx(dex)
        call SetTimerDebugTag(LoadoutMissile__delayedAnimTimer[dex] , TIMER_DEBUG_TAG_LOADOUT_MISSILE)
        call TimerStart(LoadoutMissile__delayedAnimTimer[dex], LoadoutMissile__FIRST_ANIMATION_DELAY, false, function LoadoutMissile__DelayedStartAnimation)
        call LoadoutMissile__FireMissile(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step

        if s__SpellIndex_time[dex] > 0. then
            call TimerStart(s__SpellIndex_clock[dex], step, true, function LoadoutMissile__OnPeriodic)
        else
            call LoadoutMissile__Cleanup(dex)
        endif

        return true
    endfunction

    function LoadoutMissile__OnEffect takes nothing returns nothing
        local unit source= GetTriggerUnit()
        local player owner= GetTriggerPlayer()
        call LoadoutMissileFireProfile(source , owner , WeaponProfileFromFireAbility(GetSpellAbilityId()) , GetSpellTargetX() , GetSpellTargetY())
        set source=null
        set owner=null
    endfunction

    function LoadoutMissile__Init takes nothing returns nothing
        set LoadoutMissile__active=s__Table_create()
        call RegisterSpellEffectEvent(LoadoutMissile__LOADOUT_MISSILE_SPELL , function LoadoutMissile__OnEffect)
        call RegisterSpellEffectEvent(LoadoutMissile__LOADOUT_MISSILE_RIFLE_SPELL , function LoadoutMissile__OnEffect)
        call RegisterSpellEffectEvent(LoadoutMissile__LOADOUT_MISSILE_ASSAULT_SPELL , function LoadoutMissile__OnEffect)
        call RegisterSpellEffectEvent(LoadoutMissile__LOADOUT_MISSILE_LASER_SPELL , function LoadoutMissile__OnEffect)
        // Iron Lizard has a dedicated billiard-bounce behavior in LoadoutIronLizard.
        //call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_ORDER, function OnOrder)
        call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER , function LoadoutMissile__OnPointOrder)
        call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER , function LoadoutMissile__OnTargetOrder)
    endfunction

//******************************************************************************
// Shotgun-style burst spell that reuses TimerUtils, LoadoutMissile orb behavior.
//******************************************************************************



    function LoadoutRocketLauncher___FilterUnits takes unit target,player owner returns boolean
        return UnitAlive(target) and IsUnitEnemy(target, owner) and not IsUnitType(target, UNIT_TYPE_STRUCTURE)
    endfunction

    function LoadoutRocketLauncher___DamageUnit takes unit source,unit target,real amount returns boolean
        if amount <= 0. then
            return false
        endif
        if ( GetUnitTypeId(source) == 0 ) or ( GetUnitTypeId(target) == 0 ) then
            return false
        endif
        call WaveRecordDamageCredit(source , target)
        return UnitDamageTarget(source, target, amount, false, false, LoadoutRocketLauncher___ATTACK_TYPE, LoadoutRocketLauncher___DAMAGE_TYPE, null)
    endfunction

    function LoadoutRocketLauncher___DamageArea takes unit source,player owner,real x,real y,real radius,real amount returns nothing
        local unit u
        if amount <= 0. or GetUnitTypeId(source) == 0 then
            return
        endif
        call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, x, y, radius, null)
        loop
            set u=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
            exitwhen u == null
            call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, u)
            if LoadoutRocketLauncher___FilterUnits(u , owner) then
                call WaveRecordDamageCredit(source , u)
                call UnitDamageTarget(source, u, amount, false, false, LoadoutRocketLauncher___ATTACK_TYPE, LoadoutRocketLauncher___DAMAGE_TYPE, null)
            endif
        endloop
        set u=null
    endfunction

    function LoadoutRocketLauncher___GetBarrierProjectileKind takes integer missile returns integer
        if LoadoutRocketLauncher___bonusActive[missile] then
            if LoadoutRocketLauncher___specialAbility[missile] == LOADOUT_ORB_ABILITY_WIND then
                return WAVE_BARRIER_PROJECTILE_KIND_WIND
            endif
            if LoadoutRocketLauncher___specialAbility[missile] == LOADOUT_ORB_ABILITY_RAY then
                return WAVE_BARRIER_PROJECTILE_KIND_RAY
            endif
        endif
        return WAVE_BARRIER_PROJECTILE_KIND_NORMAL
    endfunction

    function LoadoutRocketLauncher___ResolveBarrierIntercept takes integer missile returns integer
        local integer interaction= WaveBarrierCheckPlayerProjectile(missile , s__Missile_owner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , LoadoutRocketLauncher___GetBarrierProjectileKind(missile))
        local real radius
        local real finalDamage
        if interaction == WAVE_BARRIER_INTERACTION_WIND then
            if LoadoutRocketLauncher___bonusActive[missile] and LoadoutRocketLauncher___specialAbility[missile] == LOADOUT_ORB_ABILITY_WIND then
                set radius=(LOADOUT_ORB_WIND_BASE_AOE + LOADOUT_ORB_WIND_AOE_PER_INSTANCE * LoadoutClampInstance((LoadoutRocketLauncher___effectInstances[missile]))) // INLINED!!
                set finalDamage=(LOADOUT_ORB_WIND_BASE_DAMAGE + ((LoadoutRocketLauncher___storedDamage[missile])*1.0)) // INLINED!!
                call LoadoutRocketLauncher___DamageArea(s__Missile_source[missile] , s__Missile_owner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , radius , finalDamage)
            endif
            return WAVE_BARRIER_INTERACTION_WIND
        endif
        if interaction == WAVE_BARRIER_INTERACTION_RAY then
            if LoadoutRocketLauncher___bonusActive[missile] and LoadoutRocketLauncher___specialAbility[missile] == LOADOUT_ORB_ABILITY_RAY and LoadoutRocketLauncher___rayHitsLeft[missile] > 0 then
                set LoadoutRocketLauncher___rayHitsLeft[missile]=LoadoutRocketLauncher___rayHitsLeft[missile] - 1
                return WAVE_BARRIER_INTERACTION_RAY
            endif
            return WAVE_BARRIER_INTERACTION_BLOCK
        endif
        return interaction
    endfunction

    function LoadoutRocketLauncher___IsHomingTargetValid takes integer missile,unit target returns boolean
        return target != null and GetUnitTypeId(target) != 0 and LoadoutRocketLauncher___FilterUnits(target , s__Missile_owner[missile])
    endfunction

    function LoadoutRocketLauncher___FindHomingTarget takes integer missile returns unit
        local unit u
        local unit chosen= null
        local real dx
        local real dy
        local real distSq
        local real bestSq= 0.

        call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, s__Missile_x[missile], s__Missile_y[missile], LoadoutRocketLauncher___HOMING_SEARCH_RADIUS, null)
        loop
            set u=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
            exitwhen u == null
            call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, u)
            if LoadoutRocketLauncher___IsHomingTargetValid(missile , u) then
                set dx=GetUnitX(u) - s__Missile_x[missile]
                set dy=GetUnitY(u) - s__Missile_y[missile]
                set distSq=dx * dx + dy * dy
                if chosen == null or distSq < bestSq then
                    set chosen=u
                    set bestSq=distSq
                endif
            endif
        endloop

        set u=null
        return chosen
    endfunction

    function LoadoutRocketLauncher___ResumeStraightFlight takes integer missile returns nothing
        call s__MissilePosition_move(s__Missile_impact[missile],s__Missile_x[missile] + LoadoutRocketLauncher___SHOT_DISTANCE * Cos(s__Missile_angle[missile]) , s__Missile_y[missile] + LoadoutRocketLauncher___SHOT_DISTANCE * Sin(s__Missile_angle[missile]) , s__Missile_z[missile])
        call s__Missile_bounce(missile)
        call s__Missile__set_curve(missile,0.)
        set s__Missile_turn[missile]=0.
    endfunction

    function LoadoutRocketLauncher___RefreshHoming takes integer missile returns nothing
        local unit target= s__Missile_target[missile]

        set LoadoutRocketLauncher___homingScanRemaining[missile]=LoadoutRocketLauncher___homingScanRemaining[missile] - Missile_TIMER_TIMEOUT
        if LoadoutRocketLauncher___IsHomingTargetValid(missile , target) then
            return
        endif

        if target != null then
            set s__Missile_target[missile]=null
            call LoadoutRocketLauncher___ResumeStraightFlight(missile)
        endif

        if LoadoutRocketLauncher___homingScanRemaining[missile] > 0. then
            return
        endif

        set LoadoutRocketLauncher___homingScanRemaining[missile]=LoadoutRocketLauncher___HOMING_SCAN_INTERVAL
        set target=LoadoutRocketLauncher___FindHomingTarget(missile)
        if target != null then
            set s__Missile_target[missile]=target
            set s__Missile_turn[missile]=LoadoutRocketLauncher___HOMING_TURN_RATE
        endif

        set target=null
    endfunction

    function LoadoutRocketLauncher___ContinueHomingAfterKill takes integer missile returns boolean
        set s__Missile_target[missile]=null
        set LoadoutRocketLauncher___homingScanRemaining[missile]=0.
        call LoadoutRocketLauncher___ResumeStraightFlight(missile)
        return false
    endfunction

    function GetLoadoutRocketLauncherMoveCastDuration takes nothing returns real
        return WeaponProfileGetCastDuration(WEAPON_PROFILE_ENEMY_CHASER)
    endfunction

    function LoadoutRocketLauncher___GetSafeFireInterval takes nothing returns real
        local real duration= WeaponProfileGetCastDuration(WEAPON_PROFILE_ENEMY_CHASER)
        local integer count= WeaponProfileGetCastCount(WEAPON_PROFILE_ENEMY_CHASER)
        if duration <= 0. then
            return 0.03125
        endif
        if count <= 0 then
            return duration
        endif
        return duration / I2R(count)
    endfunction

    function LoadoutRocketLauncher___PoisonListAdd takes integer dex returns nothing
        set LoadoutRocketLauncher___poisonPrev[dex]=0
        set LoadoutRocketLauncher___poisonNext[dex]=LoadoutRocketLauncher___poisonHead
        if LoadoutRocketLauncher___poisonHead != 0 then
            set LoadoutRocketLauncher___poisonPrev[LoadoutRocketLauncher___poisonHead]=dex
        endif
        set LoadoutRocketLauncher___poisonHead=dex
    endfunction

    function LoadoutRocketLauncher___PoisonListRemove takes integer dex returns nothing
        local integer p= LoadoutRocketLauncher___poisonPrev[dex]
        local integer n= LoadoutRocketLauncher___poisonNext[dex]
        if p != 0 then
            set LoadoutRocketLauncher___poisonNext[p]=n
        else
            set LoadoutRocketLauncher___poisonHead=n
        endif
        if n != 0 then
            set LoadoutRocketLauncher___poisonPrev[n]=p
        endif
        set LoadoutRocketLauncher___poisonPrev[dex]=0
        set LoadoutRocketLauncher___poisonNext[dex]=0
    endfunction

    function LoadoutRocketLauncher___PoisonDestroy takes integer dex returns nothing
        call LoadoutRocketLauncher___PoisonListRemove(dex)
        if LoadoutRocketLauncher___poisonFx[dex] != null then
            call DestroyEffect(LoadoutRocketLauncher___poisonFx[dex])
            set LoadoutRocketLauncher___poisonFx[dex]=null
        endif
        call s__SpellIndex_destroy(dex)
    endfunction

    function LoadoutRocketLauncher___OnPoisonTick takes nothing returns nothing
        local integer node= LoadoutRocketLauncher___poisonHead
        local integer nextNode
        local integer dex
        loop
            exitwhen node == 0
            set dex=(node)
            set nextNode=LoadoutRocketLauncher___poisonNext[node]
            if ( s__SpellIndex_count[dex] <= 0 ) or ( GetUnitTypeId(s__SpellIndex_target[dex]) == 0 ) or ( not UnitAlive(s__SpellIndex_target[dex]) ) or ( GetUnitTypeId(s__SpellIndex_source[dex]) == 0 ) then
                call LoadoutRocketLauncher___PoisonDestroy(dex)
            else
                call WaveRecordDamageCredit(s__SpellIndex_source[dex] , s__SpellIndex_target[dex])
                call UnitDamageTarget(s__SpellIndex_source[dex], s__SpellIndex_target[dex], s__SpellIndex_damage[dex], false, false, LoadoutRocketLauncher___ATTACK_TYPE, LoadoutRocketLauncher___DAMAGE_TYPE, null)
                call ShowCustomLoadoutText(s__SpellIndex_target[dex] , "-" + FormatLoadoutDamageText(s__SpellIndex_damage[dex]) , LoadoutRocketLauncher___POISON_TEXT_R , LoadoutRocketLauncher___POISON_TEXT_G , LoadoutRocketLauncher___POISON_TEXT_B)
                set s__SpellIndex_count[dex]=s__SpellIndex_count[dex] - 1
                if s__SpellIndex_count[dex] <= 0 then
                    call LoadoutRocketLauncher___PoisonDestroy(dex)
                endif
            endif
            set node=nextNode
        endloop
        if ( LoadoutRocketLauncher___poisonHead == 0 ) and ( LoadoutRocketLauncher___poisonTicker != null ) then
            call ReleaseTimer(LoadoutRocketLauncher___poisonTicker)
            set LoadoutRocketLauncher___poisonTicker=null
        endif
    endfunction

    function LoadoutRocketLauncher___ApplyPoison takes unit source,unit target,real damagePerSecond,real duration returns nothing
        local integer dex
        local integer ticks
        local real covered
        if ( GetUnitTypeId(source) == 0 ) or ( GetUnitTypeId(target) == 0 ) then
            return
        endif
        if damagePerSecond <= 0. or duration <= 0. or LOADOUT_ORB_POISON_TICK_INTERVAL <= 0. then
            return
        endif
        set ticks=R2I(duration / LOADOUT_ORB_POISON_TICK_INTERVAL)
        set covered=I2R(ticks) * LOADOUT_ORB_POISON_TICK_INTERVAL
        if covered < duration then
            set ticks=ticks + 1
        endif
        if ticks < 1 then
            set ticks=1
        endif
        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_target[dex]=target
        set s__SpellIndex_damage[dex]=damagePerSecond
        if ( LoadoutRocketLauncher___POISON_DOT_FX != "" ) then
            set LoadoutRocketLauncher___poisonFx[dex]=AddSpecialEffectTarget(LoadoutRocketLauncher___POISON_DOT_FX, target, LoadoutRocketLauncher___POISON_DOT_FX_ATTACH)
        else
            set LoadoutRocketLauncher___poisonFx[dex]=null
        endif

        call WaveRecordDamageCredit(source , target)
        call UnitDamageTarget(source, target, damagePerSecond, false, false, LoadoutRocketLauncher___ATTACK_TYPE, LoadoutRocketLauncher___DAMAGE_TYPE, null)
        call ShowCustomLoadoutText(target , FormatLoadoutDamageText(damagePerSecond) , LoadoutRocketLauncher___POISON_TEXT_R , LoadoutRocketLauncher___POISON_TEXT_G , LoadoutRocketLauncher___POISON_TEXT_B)

        set s__SpellIndex_count[dex]=ticks
        call LoadoutRocketLauncher___PoisonListAdd(dex)
        if LoadoutRocketLauncher___poisonTicker == null then
            set LoadoutRocketLauncher___poisonTicker=(NewTimerEx(0)) // INLINED!!
            call SetTimerDebugTag(LoadoutRocketLauncher___poisonTicker , TIMER_DEBUG_TAG_LOADOUT_ROCKET)
            call TimerStart(LoadoutRocketLauncher___poisonTicker, LOADOUT_ORB_POISON_TICK_INTERVAL, true, function LoadoutRocketLauncher___OnPoisonTick)
        endif
    endfunction

        function s__LoadoutRocketLauncher___RocketLauncherCore_onCollide takes integer missile,unit hit returns boolean
            local real baseDamage= LoadoutRocketLauncher___storedDamage[missile]
            local real finalDamage= baseDamage
            local real extraDamage= 0.
            local real radius
            local boolean wasAlive
            local real bloodMult
            local integer remaining
            local integer bloodPct
            local integer inst= LoadoutRocketLauncher___effectInstances[missile]
            local integer abil= LoadoutRocketLauncher___specialAbility[missile]
            local integer barrierInteraction

            set barrierInteraction=LoadoutRocketLauncher___ResolveBarrierIntercept(missile)
            if barrierInteraction == WAVE_BARRIER_INTERACTION_BLOCK or barrierInteraction == WAVE_BARRIER_INTERACTION_WIND then
                return true
            endif
            if barrierInteraction == WAVE_BARRIER_INTERACTION_RAY then
                return false
            endif

            if not LoadoutRocketLauncher___FilterUnits(hit , s__Missile_owner[missile]) then
                return false
            endif

            if not LoadoutRocketLauncher___bonusActive[missile] then
                set wasAlive=UnitAlive(hit)
                call LoadoutRocketLauncher___DamageUnit(s__Missile_source[missile] , hit , baseDamage)
                if wasAlive and not UnitAlive(hit) then
                    return LoadoutRocketLauncher___ContinueHomingAfterKill(missile)
                endif
                return true
            endif

            if abil == LOADOUT_ORB_ABILITY_RAY then
                set wasAlive=UnitAlive(hit)
                call LoadoutRocketLauncher___DamageUnit(s__Missile_source[missile] , hit , baseDamage)
                if LoadoutRocketLauncher___rayHitsLeft[missile] > 0 then
                    set remaining=LoadoutRocketLauncher___rayHitsLeft[missile]
                    call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(baseDamage) + "/[" + I2S(remaining) + "]" , LoadoutRocketLauncher___RAY_TEXT_R , LoadoutRocketLauncher___RAY_TEXT_G , LoadoutRocketLauncher___RAY_TEXT_B)
                    if wasAlive and UnitAlive(hit) then
                        set LoadoutRocketLauncher___rayHitsLeft[missile]=LoadoutRocketLauncher___rayHitsLeft[missile] - 1
                    endif
                    return false
                endif
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(baseDamage) + "/[0]" , LoadoutRocketLauncher___RAY_TEXT_R , LoadoutRocketLauncher___RAY_TEXT_G , LoadoutRocketLauncher___RAY_TEXT_B)
                if wasAlive and not UnitAlive(hit) then
                    return LoadoutRocketLauncher___ContinueHomingAfterKill(missile)
                endif
                return true
            elseif abil == LOADOUT_ORB_ABILITY_FIRE then
                set finalDamage=(((baseDamage )*1.0) * ( 1. + LOADOUT_ORB_FIRE_DAMAGE_PERCENT_PER_INSTANCE * LoadoutClampInstance(( inst)) )) // INLINED!!
                set wasAlive=UnitAlive(hit)
                call LoadoutRocketLauncher___DamageUnit(s__Missile_source[missile] , hit , finalDamage)
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(finalDamage) , LoadoutRocketLauncher___FIRE_TEXT_R , LoadoutRocketLauncher___FIRE_TEXT_G , LoadoutRocketLauncher___FIRE_TEXT_B)
                if wasAlive and not UnitAlive(hit) then
                    return LoadoutRocketLauncher___ContinueHomingAfterKill(missile)
                endif
                return true
            elseif abil == LOADOUT_ORB_ABILITY_POISON then
                set wasAlive=UnitAlive(hit)
                call LoadoutRocketLauncher___ApplyPoison(s__Missile_source[missile] , hit , (((baseDamage)*1.0) * LOADOUT_ORB_POISON_DAMAGE_MULT) , (LOADOUT_ORB_POISON_DURATION_PER_INSTANCE * LoadoutClampInstance((inst)))) // INLINED!!
                if wasAlive and not UnitAlive(hit) then
                    return LoadoutRocketLauncher___ContinueHomingAfterKill(missile)
                endif
                return true
            elseif abil == LOADOUT_ORB_ABILITY_WIND then
                set radius=(LOADOUT_ORB_WIND_BASE_AOE + LOADOUT_ORB_WIND_AOE_PER_INSTANCE * LoadoutClampInstance((inst))) // INLINED!!
                set finalDamage=(LOADOUT_ORB_WIND_BASE_DAMAGE + ((baseDamage)*1.0)) // INLINED!!
                set wasAlive=UnitAlive(hit)
                call LoadoutRocketLauncher___DamageArea(s__Missile_source[missile] , s__Missile_owner[missile] , s__Missile_x[missile] , s__Missile_y[missile] , radius , finalDamage)
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(finalDamage) + "/[" + FormatLoadoutDamageText(radius) + "]" , LoadoutRocketLauncher___WIND_TEXT_R , LoadoutRocketLauncher___WIND_TEXT_G , LoadoutRocketLauncher___WIND_TEXT_B)
                if wasAlive and not UnitAlive(hit) then
                    return LoadoutRocketLauncher___ContinueHomingAfterKill(missile)
                endif
                return true
            elseif abil == LOADOUT_ORB_ABILITY_DARK then
                set extraDamage=LoadoutGetDarkBonus(hit , inst)
                set finalDamage=baseDamage + extraDamage
                set wasAlive=UnitAlive(hit)
                call LoadoutRocketLauncher___DamageUnit(s__Missile_source[missile] , hit , finalDamage)
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(finalDamage) , LoadoutRocketLauncher___DARK_TEXT_R , LoadoutRocketLauncher___DARK_TEXT_G , LoadoutRocketLauncher___DARK_TEXT_B)
                if wasAlive and not UnitAlive(hit) then
                    return LoadoutRocketLauncher___ContinueHomingAfterKill(missile)
                endif
                return true
            elseif abil == LOADOUT_ORB_ABILITY_BLOOD then
                set bloodMult=LoadoutGetBloodRandomMultiplier(inst)
                set finalDamage=baseDamage * bloodMult
                set bloodPct=(R2I(((bloodMult)*1.0) * 100. + 0.5)) // INLINED!!
                set wasAlive=UnitAlive(hit)
                call LoadoutRocketLauncher___DamageUnit(s__Missile_source[missile] , hit , finalDamage)
                call ShowCustomLoadoutText(hit , FormatLoadoutDamageText(finalDamage) + "   //" + I2S(bloodPct) + "%" , LoadoutRocketLauncher___CRIT_TEXT_R , LoadoutRocketLauncher___CRIT_TEXT_G , LoadoutRocketLauncher___CRIT_TEXT_B)
                if wasAlive and not UnitAlive(hit) then
                    return LoadoutRocketLauncher___ContinueHomingAfterKill(missile)
                endif
                return true
            endif

            set wasAlive=UnitAlive(hit)
            call LoadoutRocketLauncher___DamageUnit(s__Missile_source[missile] , hit , baseDamage)
            if wasAlive and not UnitAlive(hit) then
                return LoadoutRocketLauncher___ContinueHomingAfterKill(missile)
            endif
            return true
        endfunction

        function s__LoadoutRocketLauncher___RocketLauncherCore_onFinish takes integer missile returns boolean
            return true
        endfunction

        function s__LoadoutRocketLauncher___RocketLauncherCore_onDestructable takes integer missile,destructable hit returns boolean
            return true
        endfunction

        function s__LoadoutRocketLauncher___RocketLauncherCore_onTerrain takes integer missile returns boolean
            return true
        endfunction

        function s__LoadoutRocketLauncher___RocketLauncherCore_onPeriod takes integer missile returns boolean
            local integer barrierInteraction= LoadoutRocketLauncher___ResolveBarrierIntercept(missile)
            if barrierInteraction == WAVE_BARRIER_INTERACTION_BLOCK or barrierInteraction == WAVE_BARRIER_INTERACTION_WIND then
                return true
            endif
            call LoadoutRocketLauncher___RefreshHoming(missile)
            return false
        endfunction

        function s__LoadoutRocketLauncher___RocketLauncherCore_onRemove takes integer missile returns boolean
            if LoadoutRocketLauncher___overlayFx[missile] != null then
                call DestroyEffect(LoadoutRocketLauncher___overlayFx[missile])
            endif
            set LoadoutRocketLauncher___overlayFx[missile]=null
            set LoadoutRocketLauncher___specialAbility[missile]=0
            set LoadoutRocketLauncher___storedDamage[missile]=0.
            set LoadoutRocketLauncher___effectInstances[missile]=0
            set LoadoutRocketLauncher___rayHitsLeft[missile]=0
            set LoadoutRocketLauncher___bonusActive[missile]=false
            set LoadoutRocketLauncher___homingScanRemaining[missile]=0.
            set s__Missile_target[missile]=null
            set s__Missile_turn[missile]=0.
            call WaveBarrierClearProjectileTrace(missile)
            call s__SpellIndex_destroy((s__Missile_data[missile]))
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__LoadoutRocketLauncher___RocketLauncherCore_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__LoadoutRocketLauncher___RocketLauncherCore],missile)
            call Missile___StartPeriodic(si__LoadoutRocketLauncher___RocketLauncherCore)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__LoadoutRocketLauncher___RocketLauncherCore_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__LoadoutRocketLauncher___RocketLauncherCore_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__LoadoutRocketLauncher___RocketLauncherCore)
            endif
        endfunction
























        

        function s__LoadoutRocketLauncher___RocketLauncherCore_MissileAction___missileActionDest takes nothing returns nothing
            local destructable d= GetEnumDestructable()
            local integer this= s__Missile_temp
            if s__Missile_allocated[this] then
                call SaveDestructableHandle(Missile___HASH, this, GetHandleId(d), d)
                if s__LoadoutRocketLauncher___RocketLauncherCore_onDestructable(this , d) then
                    call s__LoadoutRocketLauncher___RocketLauncherCore_missileTerminateP(this)
                endif
            endif
            set d=null
        endfunction

    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__LoadoutRocketLauncher___RocketLauncherCore_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__LoadoutRocketLauncher___RocketLauncherCore])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__LoadoutRocketLauncher___RocketLauncherCore_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.

                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            set b=s__Missile_collisionType[this] == Missile_COLLISION_TYPE_RECTANGLE
                            if b then
                                call s__Missile_groupEnumUnitsRectangle(this)
                            else
                                call GroupEnumUnitsInRange(Missile___GROUP, s__Missile_x[this], s__Missile_y[this], s__Missile_collision[this] + Missile_MAXIMUM_COLLISION_SIZE, null)
                            endif
                            loop
                                set u=FirstOfGroup(Missile___GROUP)
                                exitwhen u == null
                                call GroupRemoveUnit(Missile___GROUP, u)
                                if not HaveSavedHandle(Missile___HASH, this, GetHandleId(u)) then
                                    if IsUnitInRange(u, s__Missile_dummy[this], s__Missile_collision[this]) or b then
                                        // Eventually run z collision checks.

                                            set collideZ=Missile_GetLocZ(GetUnitX(u) , GetUnitY(u)) + GetUnitFlyHeight(u) - s__Missile_terrainZ[this]
                                            if ( collideZ + GetUnitBodySize(u) >= s__Missile_z[this] - (s__Missile_collision[(this)]) ) and ( collideZ <= s__Missile_z[this] + (s__Missile_collision[(this)]) ) then // INLINED!!
                                                // Mark as hit.
                                                call SaveUnitHandle(Missile___HASH, this, GetHandleId(u), u)
                                                if s__LoadoutRocketLauncher___RocketLauncherCore_onCollide(this , u) then
                                                    call s__LoadoutRocketLauncher___RocketLauncherCore_missileTerminateP(this)
                                                    exitwhen true
                                                endif
                                            endif
    








                                    endif
                                endif
                            endloop
                        endif

                    
                    // Runs destructable collision.

                        // Check if the missile is not terminated.
                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            call s__Missile_checkDestCollision(this,function s__LoadoutRocketLauncher___RocketLauncherCore_MissileAction___missileActionDest)
                        endif

                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__LoadoutRocketLauncher___RocketLauncherCore_onFinish(this) then
                                call s__LoadoutRocketLauncher___RocketLauncherCore_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.

                        if s__Missile_allocated[this] and 0. > s__Missile_z[this] and s__LoadoutRocketLauncher___RocketLauncherCore_onTerrain(this) then
                            call s__LoadoutRocketLauncher___RocketLauncherCore_missileTerminateP(this)
                        endif

                
                    // Runs every Missile_TIMER_TIMEOUT.

                        if s__Missile_allocated[this] and s__LoadoutRocketLauncher___RocketLauncherCore_onPeriod(this) then
                            call s__LoadoutRocketLauncher___RocketLauncherCore_missileTerminateP(this)
                        endif

                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__LoadoutRocketLauncher___RocketLauncherCore_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__LoadoutRocketLauncher___RocketLauncherCore)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__LoadoutRocketLauncher___RocketLauncherCore )]=Condition(( function s__LoadoutRocketLauncher___RocketLauncherCore_missileIterateP)) // INLINED!!
        endfunction

    function LoadoutRocketLauncher___LaunchBurstMissile takes unit source,player owner,real x,real y,real angle,integer chosen,boolean burstBonus,real damage,integer instances,string baseModel,string wrapModel returns nothing
        local integer mDex= s__SpellIndex__allocate()
        local integer missile= s__Missile_create(x , y , LoadoutRocketLauncher___MISSILE_START_Z , angle , LoadoutRocketLauncher___SHOT_DISTANCE , LoadoutRocketLauncher___MISSILE_START_Z)
        local real speed= WeaponProfileGetMissileSpeed(WEAPON_PROFILE_ENEMY_CHASER) + (PlayerMissileLoadout__chosenSpeedBonus[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!

        if speed < LoadoutRocketLauncher___MIN_MISSILE_SPEED then
            set speed=LoadoutRocketLauncher___MIN_MISSILE_SPEED
        endif
        set s__SpellIndex_source[mDex]=source
        set s__SpellIndex_user[mDex]=owner
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=owner
        set s__Missile_data[missile]=mDex
        call s__Missile__set_model(missile,baseModel)
        call s__Missile__set_scale(missile,WeaponProfileGetMissileScale(WEAPON_PROFILE_ENEMY_CHASER))
        set s__Missile_collision[missile]=LoadoutRocketLauncher___MISSILE_COLLISION
        set s__Missile_speed[(missile)]=((speed)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
        set s__Missile_turn[missile]=0.
        set s__Missile_target[missile]=null

        set LoadoutRocketLauncher___specialAbility[missile]=chosen
        set LoadoutRocketLauncher___storedDamage[missile]=damage
        set LoadoutRocketLauncher___effectInstances[missile]=instances
        set LoadoutRocketLauncher___rayHitsLeft[missile]=(LoadoutClampInstance((instances))) // INLINED!!
        set LoadoutRocketLauncher___bonusActive[missile]=burstBonus
        set LoadoutRocketLauncher___homingScanRemaining[missile]=0.

        if burstBonus and ( wrapModel != "" ) then
            set LoadoutRocketLauncher___overlayFx[missile]=AddSpecialEffectTarget(wrapModel, s__Missile_dummy[missile], LoadoutRocketLauncher___WRAP_ATTACH_POINT)
        else
            set LoadoutRocketLauncher___overlayFx[missile]=null
        endif

        call s__LoadoutRocketLauncher___RocketLauncherCore_launch(missile)
    endfunction

    function LoadoutRocketLauncher___BurstOffsetForShot takes integer shot,integer burstCount returns real
        local integer pairIndex
        if burstCount <= 0 then
            return 0.0
        endif
        if ModuloInteger(burstCount, 2) == 1 then
            if shot == 0 then
                return 0.0
            endif
            set pairIndex=( shot + 1 ) / 2
            if ModuloInteger(shot, 2) == 1 then
                return I2R(pairIndex)
            endif
            return - I2R(pairIndex)
        endif
        set pairIndex=shot / 2
        if ModuloInteger(shot, 2) == 0 then
            return - ( I2R(pairIndex) + 0.5 )
        endif
        return I2R(pairIndex) + 0.5
    endfunction

    function LoadoutRocketLauncher___BurstStop takes integer dex returns nothing
        if LoadoutRocketLauncher___burstTimer[dex] != null then
            call ReleaseTimer(LoadoutRocketLauncher___burstTimer[dex])
            set LoadoutRocketLauncher___burstTimer[dex]=null
        endif
        set LoadoutRocketLauncher___burstShotIndex[dex]=0
        set LoadoutRocketLauncher___burstBaseAngle[dex]=0.0
        set LoadoutRocketLauncher___burstX[dex]=0.0
        set LoadoutRocketLauncher___burstY[dex]=0.0
        set LoadoutRocketLauncher___burstDamage[dex]=0.0
        set LoadoutRocketLauncher___burstInstances[dex]=0
        set LoadoutRocketLauncher___burstChosen[dex]=0
        set LoadoutRocketLauncher___burstBonusActive[dex]=false
        set LoadoutRocketLauncher___burstBaseModel[dex]=""
        set LoadoutRocketLauncher___burstWrapModel[dex]=""
    endfunction

    function LoadoutRocketLauncher___GetBurstStaggerInterval takes nothing returns real
        local real step= LoadoutRocketLauncher___GetSafeFireInterval()
        local real burstStep

        if LoadoutRocketLauncher___BURST_COUNT <= 1 then
            return 0.03125
        endif

        set burstStep=step / I2R(LoadoutRocketLauncher___BURST_COUNT)
        if burstStep <= 0. then
            return LoadoutRocketLauncher___BURST_STAGGER_INTERVAL
        endif
        if burstStep < LoadoutRocketLauncher___BURST_STAGGER_INTERVAL then
            return burstStep
        endif
        return LoadoutRocketLauncher___BURST_STAGGER_INTERVAL
    endfunction

    function LoadoutRocketLauncher___BurstLaunchShot takes integer dex,integer shot returns nothing
        local integer burstCount= LoadoutRocketLauncher___BURST_COUNT
        local real angle
        if shot < 0 or shot >= burstCount then
            return
        endif
        if not WeaponInventoryConsumeShotForProfile(s__SpellIndex_user[dex] , WEAPON_PROFILE_ENEMY_CHASER) then
            return
        endif
        set angle=LoadoutRocketLauncher___burstBaseAngle[dex] + ( LoadoutRocketLauncher___BurstOffsetForShot(shot , burstCount) * LoadoutRocketLauncher___BURST_SPREAD_DEG ) * bj_DEGTORAD
        call LoadoutRocketLauncher___LaunchBurstMissile(s__SpellIndex_source[dex] , s__SpellIndex_user[dex] , LoadoutRocketLauncher___burstX[dex] , LoadoutRocketLauncher___burstY[dex] , angle , LoadoutRocketLauncher___burstChosen[dex] , LoadoutRocketLauncher___burstBonusActive[dex] , LoadoutRocketLauncher___burstDamage[dex] , LoadoutRocketLauncher___burstInstances[dex] , LoadoutRocketLauncher___burstBaseModel[dex] , LoadoutRocketLauncher___burstWrapModel[dex])
    endfunction

    function LoadoutRocketLauncher___Cleanup takes integer dex returns nothing
        local integer id= 0
        if dex == 0 or s__SpellIndex_phase[dex] == - 999 then
            return
        endif
        set s__SpellIndex_phase[dex]=- 999
        set id=GetHandleId(s__SpellIndex_source[dex])
        if (HaveSavedInteger(Table__ht, (LoadoutRocketLauncher___active), (id))) and ( (LoadInteger(Table__ht, (LoadoutRocketLauncher___active), (id))) == dex ) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (LoadoutRocketLauncher___active), (id)) // INLINED!!
        endif
        if GetUnitTypeId(s__SpellIndex_source[dex]) != 0 then
            call SetUnitTimeScale(s__SpellIndex_source[dex], LoadoutRocketLauncher___ANIMATION_TIME_SCALE_ON_END)
        endif
        if LoadoutRocketLauncher___delayedAnimTimer[dex] != null then
            call ReleaseTimer(LoadoutRocketLauncher___delayedAnimTimer[dex])
            set LoadoutRocketLauncher___delayedAnimTimer[dex]=null
        endif
        call LoadoutRocketLauncher___BurstStop(dex)
        set LoadoutRocketLauncher___aim[dex]=0.
        if s__SpellIndex_clock[dex] != null then
            call ReleaseTimer(s__SpellIndex_clock[dex])
            set s__SpellIndex_clock[dex]=null
        endif
        call s__SpellIndex_destroy(dex)
    endfunction

    function LoadoutRocketLauncher___OnBurstTick takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local integer shot

        if dex == 0 then
            call ReleaseTimer(t)
            set t=null
            return
        endif

        if ( LoadoutRocketLauncher___burstTimer[dex] != t ) then
            set t=null
            return
        endif

        if ( LoadoutRocketLauncher___burstShotIndex[dex] >= LoadoutRocketLauncher___BURST_COUNT ) or ( GetUnitTypeId(s__SpellIndex_source[dex]) == 0 ) or ( not UnitAlive(s__SpellIndex_source[dex]) ) or ( s__SpellIndex_phase[dex] < 0 ) then
            set LoadoutRocketLauncher___burstTimer[dex]=null
            call LoadoutRocketLauncher___Cleanup(dex)
            call ReleaseTimer(t)
            set t=null
            return
        endif

        set shot=LoadoutRocketLauncher___burstShotIndex[dex]
        call LoadoutRocketLauncher___BurstLaunchShot(dex , shot)
        set LoadoutRocketLauncher___burstShotIndex[dex]=shot + 1

        if LoadoutRocketLauncher___burstShotIndex[dex] >= LoadoutRocketLauncher___BURST_COUNT then
            if s__SpellIndex_time[dex] <= 0. then
                set LoadoutRocketLauncher___burstTimer[dex]=null
                call LoadoutRocketLauncher___Cleanup(dex)
                call ReleaseTimer(t)
                set t=null
                return
            else
                call LoadoutRocketLauncher___BurstStop(dex)
            endif
        endif

        set t=null
    endfunction

    function LoadoutRocketLauncher___FireBurst takes integer dex returns nothing
        local unit source= s__SpellIndex_source[dex]
        local player owner= s__SpellIndex_user[dex]
        local real x= GetUnitX(source)
        local real y= GetUnitY(source)
        local real baseAngle= LoadoutRocketLauncher___aim[dex]
        local string baseModel= WeaponProfileGetTierMissileModel(WEAPON_PROFILE_ENEMY_CHASER , 1)
        local string wrapModel= (PlayerMissileLoadout__chosenOverlayPath[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        local real damage= WeaponProfileGetDamage(WEAPON_PROFILE_ENEMY_CHASER) * LoadoutRocketLauncher___BASE_DAMAGE_MULT
        local integer instances= (PlayerMissileLoadout__chosenInstances[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        local integer chosen= (PlayerMissileLoadout__chosenAbility[PlayerMissileLoadout__SlotOfPlayer((owner))]) // INLINED!!
        local integer chosenLevel= 0
        local boolean burstBonus
        local integer i= 0
        local real mid
        local real angle

        if GetUnitTypeId(source) == 0 then
            set source=null
            set owner=null
            return
        endif

        if chosen != 0 then
            set chosenLevel=GetUnitAbilityLevel(source, chosen)
        endif
        set burstBonus=( chosen != 0 ) and ( chosenLevel > 0 ) and ( chosenLevel < 5 )
        if burstBonus then
            call TriggerLoadoutIntFullManaSwapForAbility((source ) , ( chosen)) // INLINED!!
        endif

        if instances < 1 then
            set instances=1
        endif
        if damage < 0. then
            set damage=0.
        endif
        if ( baseModel == "" ) then
            set baseModel=LoadoutRocketLauncher___BASE_MISSILE_MODEL
        endif

        set LoadoutRocketLauncher___burstBaseAngle[dex]=baseAngle
        set LoadoutRocketLauncher___burstX[dex]=x
        set LoadoutRocketLauncher___burstY[dex]=y
        set LoadoutRocketLauncher___burstDamage[dex]=damage
        set LoadoutRocketLauncher___burstInstances[dex]=instances
        set LoadoutRocketLauncher___burstChosen[dex]=chosen
        set LoadoutRocketLauncher___burstBonusActive[dex]=burstBonus
        set LoadoutRocketLauncher___burstBaseModel[dex]=baseModel
        set LoadoutRocketLauncher___burstWrapModel[dex]=wrapModel
        set LoadoutRocketLauncher___burstShotIndex[dex]=0

        call LoadoutRocketLauncher___BurstLaunchShot(dex , 0)
        set LoadoutRocketLauncher___burstShotIndex[dex]=1

        if LoadoutRocketLauncher___BURST_COUNT > 1 then
            set LoadoutRocketLauncher___burstTimer[dex]=NewTimerEx(dex)
            call SetTimerDebugTag(LoadoutRocketLauncher___burstTimer[dex] , TIMER_DEBUG_TAG_LOADOUT_ROCKET)
            call TimerStart(LoadoutRocketLauncher___burstTimer[dex], LoadoutRocketLauncher___GetBurstStaggerInterval(), true, function LoadoutRocketLauncher___OnBurstTick)
        else
            call LoadoutRocketLauncher___BurstStop(dex)
        endif
        set source=null
        set owner=null
    endfunction

    function LoadoutRocketLauncher___DelayedStartAnimation takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local unit source= s__SpellIndex_source[dex]
        local integer id
        set LoadoutRocketLauncher___delayedAnimTimer[dex]=null
        if ( GetUnitTypeId(source) != 0 ) and UnitAlive(source) and ( s__SpellIndex_phase[dex] >= 0 ) then
            set id=GetHandleId(source)
            if (HaveSavedInteger(Table__ht, (LoadoutRocketLauncher___active), (id))) and ( (LoadInteger(Table__ht, (LoadoutRocketLauncher___active), (id))) == dex ) then // INLINED!!
                call SetUnitAnimation(source, LoadoutRocketLauncher___CAST_ANIMATION)
            endif
        endif
        call ReleaseTimer(t)
        set source=null
        set t=null
    endfunction

    function LoadoutRocketLauncher___OnPeriodic takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local real step= LoadoutRocketLauncher___GetSafeFireInterval()

        if ( GetUnitTypeId(s__SpellIndex_source[dex]) == 0 ) or ( not UnitAlive(s__SpellIndex_source[dex]) ) or ( s__SpellIndex_phase[dex] < 0 ) then
            call LoadoutRocketLauncher___Cleanup(dex)
            set t=null
            return
        endif

        if s__SpellIndex_time[dex] <= 0. then
            if LoadoutRocketLauncher___burstTimer[dex] == null then
                call LoadoutRocketLauncher___Cleanup(dex)
            endif
            set t=null
            return
        endif

        call SetUnitAnimation(s__SpellIndex_source[dex], LoadoutRocketLauncher___CAST_ANIMATION)
        call LoadoutRocketLauncher___FireBurst(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step

        if ( s__SpellIndex_time[dex] <= 0. ) and ( LoadoutRocketLauncher___burstTimer[dex] == null ) then
            call LoadoutRocketLauncher___Cleanup(dex)
        endif
        set t=null
    endfunction

    function LoadoutRocketLauncher___MarkCanceled takes unit whichUnit returns nothing
        local integer id= GetHandleId(whichUnit)
        if (HaveSavedInteger(Table__ht, (LoadoutRocketLauncher___active), (id))) then // INLINED!!
            // A running cast session is refreshed by recast; orders should not kill it.
            return
        endif
    endfunction

    function LoadoutRocketLauncher___OnOrder takes nothing returns nothing
        call LoadoutRocketLauncher___MarkCanceled(GetTriggerUnit())
    endfunction

    function LoadoutRocketLauncher___OnPointOrder takes nothing returns nothing
        call LoadoutRocketLauncher___MarkCanceled(GetTriggerUnit())
    endfunction

    function LoadoutRocketLauncher___OnTargetOrder takes nothing returns nothing
        call LoadoutRocketLauncher___MarkCanceled(GetTriggerUnit())
    endfunction

    function LoadoutRocketLauncherFire takes unit source,player owner,real tx,real ty returns boolean
        local integer id= GetHandleId(source)
        local integer dex
        local real x= GetUnitX(source)
        local real y= GetUnitY(source)
        local real step= LoadoutRocketLauncher___GetSafeFireInterval()
        local boolean useRapid
        local real duration= WeaponProfileGetCastDuration(WEAPON_PROFILE_ENEMY_CHASER)

        set useRapid=true

        if (HaveSavedInteger(Table__ht, (LoadoutRocketLauncher___active), (id))) then // INLINED!!
            set dex=(LoadInteger(Table__ht, (LoadoutRocketLauncher___active), (id))) // INLINED!!
            if ( s__SpellIndex_phase[dex] >= 0 ) and ( GetUnitTypeId(s__SpellIndex_source[dex]) != 0 ) and UnitAlive(s__SpellIndex_source[dex]) then
                set LoadoutRocketLauncher___aim[dex]=Atan2(ty - y, tx - x)
                // If a rocket burst is still emitting missiles, do not promote
                // this recast into dex.time > 0. Otherwise the last burst tick
                // only stops the burst timer and leaves active[dex] stuck with
                // no periodic timer, making future casts return without firing.
                if LoadoutRocketLauncher___burstTimer[dex] != null then
                    call SetUnitTimeScale(source, LoadoutRocketLauncher___RAPID_FIRE_ANIMATION_TIME_SCALE)
                    return true
                endif
                set s__SpellIndex_time[dex]=duration
                call SetUnitTimeScale(source, LoadoutRocketLauncher___RAPID_FIRE_ANIMATION_TIME_SCALE)
                return true
            endif
            call LoadoutRocketLauncher___Cleanup(dex)
        endif

        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_user[dex]=owner
        if useRapid and ( duration > 0. ) then
            set s__SpellIndex_time[dex]=duration
        else
            set s__SpellIndex_time[dex]=0.
        endif
        set s__SpellIndex_phase[dex]=1
        set s__SpellIndex_clock[dex]=NewTimerEx(dex)
        call SetTimerDebugTag(s__SpellIndex_clock[dex] , TIMER_DEBUG_TAG_LOADOUT_ROCKET)
        set LoadoutRocketLauncher___aim[dex]=Atan2(ty - y, tx - x)
        call SaveInteger(Table__ht, (LoadoutRocketLauncher___active), (id), ( dex)) // INLINED!!

        call SetUnitTimeScale(source, LoadoutRocketLauncher___RAPID_FIRE_ANIMATION_TIME_SCALE)
        set LoadoutRocketLauncher___delayedAnimTimer[dex]=NewTimerEx(dex)
        call SetTimerDebugTag(LoadoutRocketLauncher___delayedAnimTimer[dex] , TIMER_DEBUG_TAG_LOADOUT_ROCKET)
        call TimerStart(LoadoutRocketLauncher___delayedAnimTimer[dex], LoadoutRocketLauncher___FIRST_ANIMATION_DELAY, false, function LoadoutRocketLauncher___DelayedStartAnimation)
        call LoadoutRocketLauncher___FireBurst(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step

        if s__SpellIndex_time[dex] > 0. then
            call TimerStart(s__SpellIndex_clock[dex], step, true, function LoadoutRocketLauncher___OnPeriodic)
        elseif LoadoutRocketLauncher___burstTimer[dex] == null then
            call LoadoutRocketLauncher___Cleanup(dex)
        endif

        return true
    endfunction

    function LoadoutRocketLauncher___OnEffect takes nothing returns nothing
        local unit source= GetTriggerUnit()
        local player owner= GetTriggerPlayer()
        call LoadoutRocketLauncherFire(source , owner , GetSpellTargetX() , GetSpellTargetY())
        set source=null
        set owner=null
    endfunction

    function LoadoutRocketLauncher___Init takes nothing returns nothing
        set LoadoutRocketLauncher___active=s__Table_create()
        call RegisterSpellEffectEvent(LoadoutRocketLauncher___LOADOUT_ROCKET_LAUNCHER_SPELL , function LoadoutRocketLauncher___OnEffect)
        //call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_ORDER, function OnOrder)
        call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER , function LoadoutRocketLauncher___OnPointOrder)
        call RegisterPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER , function LoadoutRocketLauncher___OnTargetOrder)
    endfunction


    function Trig_gg_Actions takes nothing returns nothing
        call s__SelectionSystem_start()

        set TerrainReplace___TerrainReplaceDebugEnabled=(false) // INLINED!!
        call TerrainReplaceSetBatchTilesPerTick(64)
        call ApplyDefaultTerrainReplaceFromCenterAsync(- 1536. , 24064. , 40 , 40 , 40 , 40)
        // Ejemplo:
        // call BJDebugMsg("Tiles cambiados: " + I2S(ApplyDefaultTerrainReplaceRect(gg_rct_Intro_Zone_000)))
    endfunction

    // Compatibilidad con trigger clasico, pero sin gg_trg_gg.
    function AuditInit_gg takes nothing returns nothing
        local trigger t= CreateTrigger()
        call TriggerRegisterTimerEventSingle(t, 1.00)
        call TriggerAddAction(t, function Trig_gg_Actions)
        set t=null
    endfunction

    function MapBootstrap___Init takes nothing returns nothing
        call AuditInit_gg()
    endfunction


//------------------------------------------------------------------------------
// Config inicial de point groups para SwlsWave.
//
// Nota:
//   - El rawcode del marker es configurable. Acá queda un placeholder estable
//     para que el sistema compile y el usuario lo cambie por su marker real.
//   - Si no hay markers en el rect, el grupo queda vacío y StageExample usa
//     fallback manual.
//------------------------------------------------------------------------------

    function WavePointGroupsConfig__Init takes nothing returns nothing
        set WavePointGroups___WPGDebugEnabled=(false) // INLINED!!

        // Grupo representativo para reemplazar bloques de w.addPoint manuales.
        call WavePointGroupRegister("Stage1_ThePueblo" , gg_rct_ZoneThePueblo , WavePointGroupsConfig__WPG_MARKER_RAWCODE)
        //call WavePointGroupRegister("Stage1_SidePath", gg_rct_Intro_Zone_001, WPG_MARKER_RAWCODE)
        //call WavePointGroupRegister("Stage1_BossZone", gg_rct_Intro_Zone_002, WPG_MARKER_RAWCODE)

        call WavePointGroupsBuild()
    endfunction



    function WaveStreaks___WaveNow takes nothing returns real
        return TimerGetElapsed(WaveStreaks___WaveClockTimer)
    endfunction

    function WaveStreaks___WaveClockNoop takes nothing returns nothing
    endfunction

    function WaveStreaks___WaveWrapQueueIndex takes integer i returns integer
        if i > WaveStreaks___WAVE_STREAK_QUEUE_MAX then
            return 1
        endif
        return i
    endfunction

    function WaveStreaks___WaveBroadcastText takes string msg returns nothing
        local integer i= 0
        local integer u
        if msg == null or msg == "" then
            return
        endif
        loop
            exitwhen i >= s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            call DisplayTimedTextToPlayer((s__User_handle[(u)]), 0.0, 0.0, WaveStreaks___WAVE_STREAK_MESSAGE_DURATION, msg) // INLINED!!
            set i=i + 1
        endloop
    endfunction

    function WaveStreaks___WavePlaySoundGlobal takes string path returns nothing
        local sound s
        if path == null or path == "" then
            return
        endif
        set s=CreateSound(path, false, false, false, 10, 10, "")
        call StartSound(s)
        call KillSoundWhenDone(s)
        set s=null
    endfunction

    function WaveStreaks___WaveQueuePopAndEmit takes nothing returns nothing
        local integer idx
        local string soundPath
        local string msg

        if WaveStreaks___WaveQueueCount <= 0 then
            return
        endif

        set idx=WaveStreaks___WaveQueueRead
        set WaveStreaks___WaveQueueRead=WaveStreaks___WaveWrapQueueIndex(WaveStreaks___WaveQueueRead + 1)
        set WaveStreaks___WaveQueueCount=WaveStreaks___WaveQueueCount - 1

        set soundPath=WaveStreaks___WaveQueueSoundPath[idx]
        set msg=WaveStreaks___WaveQueueText[idx]
        set WaveStreaks___WaveQueueSoundPath[idx]=""
        set WaveStreaks___WaveQueueText[idx]=""
        set WaveStreaks___WaveQueueKind[idx]=WaveStreaks___WAVE_QUEUE_KIND_GENERIC
        set WaveStreaks___WaveQueuePid[idx]=- 1

        call WaveStreaks___WaveBroadcastText(msg)
        call WaveStreaks___WavePlaySoundGlobal(soundPath)
    endfunction

    function WaveStreaks___WaveQueueOnTick takes nothing returns nothing
        if WaveStreaks___WaveQueueCount <= 0 then
            set WaveStreaks___WaveQueueRunning=false
            call PauseTimer(WaveStreaks___WaveQueueTimer)
            return
        endif

        if WaveStreaks___WaveQueueCooldown > 0.00 then
            set WaveStreaks___WaveQueueCooldown=WaveStreaks___WaveQueueCooldown - WaveStreaks___WAVE_STREAK_QUEUE_TICK
            return
        endif

        call WaveStreaks___WaveQueuePopAndEmit()
        set WaveStreaks___WaveQueueCooldown=WaveStreaks___WaveQueueGapSec
    endfunction

    function WaveStreaks___WaveQueueDropPendingByKindAndPid takes integer kind,integer pid returns nothing
        local integer i= 0
        local integer idx= WaveStreaks___WaveQueueRead
        local integer kept= 0
        local integer writeIdx

        if WaveStreaks___WaveQueueCount <= 0 then
            return
        endif

        loop
            exitwhen i >= WaveStreaks___WaveQueueCount
            if not ( WaveStreaks___WaveQueueKind[idx] == kind and WaveStreaks___WaveQueuePid[idx] == pid ) then
                set kept=kept + 1
                set WaveStreaks___WaveQueueTmpSoundPath[kept]=WaveStreaks___WaveQueueSoundPath[idx]
                set WaveStreaks___WaveQueueTmpText[kept]=WaveStreaks___WaveQueueText[idx]
                set WaveStreaks___WaveQueueTmpKind[kept]=WaveStreaks___WaveQueueKind[idx]
                set WaveStreaks___WaveQueueTmpPid[kept]=WaveStreaks___WaveQueuePid[idx]
            endif
            set WaveStreaks___WaveQueueSoundPath[idx]=""
            set WaveStreaks___WaveQueueText[idx]=""
            set WaveStreaks___WaveQueueKind[idx]=WaveStreaks___WAVE_QUEUE_KIND_GENERIC
            set WaveStreaks___WaveQueuePid[idx]=- 1
            set idx=WaveStreaks___WaveWrapQueueIndex(idx + 1)
            set i=i + 1
        endloop

        set WaveStreaks___WaveQueueRead=1
        set WaveStreaks___WaveQueueWrite=1
        set WaveStreaks___WaveQueueCount=0
        set i=1
        loop
            exitwhen i > kept
            set writeIdx=WaveStreaks___WaveQueueWrite
            set WaveStreaks___WaveQueueSoundPath[writeIdx]=WaveStreaks___WaveQueueTmpSoundPath[i]
            set WaveStreaks___WaveQueueText[writeIdx]=WaveStreaks___WaveQueueTmpText[i]
            set WaveStreaks___WaveQueueKind[writeIdx]=WaveStreaks___WaveQueueTmpKind[i]
            set WaveStreaks___WaveQueuePid[writeIdx]=WaveStreaks___WaveQueueTmpPid[i]
            set WaveStreaks___WaveQueueWrite=WaveStreaks___WaveWrapQueueIndex(WaveStreaks___WaveQueueWrite + 1)
            set WaveStreaks___WaveQueueCount=WaveStreaks___WaveQueueCount + 1
            set i=i + 1
        endloop
    endfunction

    function WaveStreaks___WaveQueuePushTyped takes string soundPath,string msg,integer kind,integer pid returns nothing
        local integer idx
        if ( soundPath == null or soundPath == "" ) and ( msg == null or msg == "" ) then
            return
        endif

        set idx=WaveStreaks___WaveQueueWrite
        set WaveStreaks___WaveQueueSoundPath[idx]=soundPath
        set WaveStreaks___WaveQueueText[idx]=msg
        set WaveStreaks___WaveQueueKind[idx]=kind
        set WaveStreaks___WaveQueuePid[idx]=pid
        set WaveStreaks___WaveQueueWrite=WaveStreaks___WaveWrapQueueIndex(WaveStreaks___WaveQueueWrite + 1)

        if WaveStreaks___WaveQueueCount < WaveStreaks___WAVE_STREAK_QUEUE_MAX then
            set WaveStreaks___WaveQueueCount=WaveStreaks___WaveQueueCount + 1
        else
            // Cola llena: descarta el m?s viejo.
            set WaveStreaks___WaveQueueRead=WaveStreaks___WaveWrapQueueIndex(WaveStreaks___WaveQueueRead + 1)
        endif

        if not WaveStreaks___WaveQueueRunning then
            set WaveStreaks___WaveQueueRunning=true
            set WaveStreaks___WaveQueueCooldown=0.00
            call TimerStart(WaveStreaks___WaveQueueTimer, WaveStreaks___WAVE_STREAK_QUEUE_TICK, true, function WaveStreaks___WaveQueueOnTick)
        endif
    endfunction

    function WaveStreaks___WaveGetStreakTier takes integer kills returns integer
        local integer t= WaveStreaks___WAVE_STREAK_MAX_TIERS
        loop
            exitwhen t <= 0
            if kills >= WaveStreaks___WaveStreakThresholds[t] then
                return t
            endif
            set t=t - 1
        endloop
        return 0
    endfunction

    function WaveStreaks___WaveGetMultiTier takes integer kills returns integer
        local integer t= WaveStreaks___WAVE_MULTI_MAX_TIERS
        loop
            exitwhen t <= 0
            if kills >= WaveStreaks___WaveMultiThresholds[t] then
                return t
            endif
            set t=t - 1
        endloop
        return 0
    endfunction

    function WaveStreaks___WaveGetStreakMaxRepeatStep takes nothing returns integer
        local integer step= WaveStreaks___WaveStreakThresholds[WaveStreaks___WAVE_STREAK_MAX_TIERS] - WaveStreaks___WaveStreakThresholds[WaveStreaks___WAVE_STREAK_MAX_TIERS - 1]
        if step < 1 then
            set step=1
        endif
        return step
    endfunction

    function WaveStreaks___WaveGetMultiMaxRepeatStep takes nothing returns integer
        local integer step= WaveStreaks___WaveMultiThresholds[WaveStreaks___WAVE_MULTI_MAX_TIERS] - WaveStreaks___WaveMultiThresholds[WaveStreaks___WAVE_MULTI_MAX_TIERS - 1]
        if step < 1 then
            set step=1
        endif
        return step
    endfunction

    function WaveStreaks___WaveGetStreakTierName takes integer tier returns string
        if tier <= 1 then
            return "Killing Spree"
        elseif tier == 2 then
            return "Dominating"
        elseif tier == 3 then
            return "Mega Kill"
        elseif tier == 4 then
            return "Unstoppable"
        elseif tier == 5 then
            return "Wicked Sick"
        elseif tier == 6 then
            return "Monster Kill"
        elseif tier == 7 then
            return "Godlike"
        endif
        return "Beyond Godlike"
    endfunction

    function WaveStreaks___WaveGetMultiTierName takes integer tier returns string
        if tier <= 1 then
            return "Double Kill"
        elseif tier == 2 then
            return "Triple Kill"
        elseif tier == 3 then
            return "Ultra Kill"
        endif
        return "Rampage"
    endfunction

    function WaveStreaks___WaveGetOwnerPlayerId takes unit u returns integer
        local integer pid
        local integer hid
        if u == null then
            return - 1
        endif
        set hid=GetHandleId(u)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveExternalOwnerPidByUnit), (hid))) then // INLINED!!
            set pid=(LoadInteger(Table__ht, (WaveExternalOwnerPidByUnit), (hid))) // INLINED!!
        else
            set pid=GetPlayerId(GetOwningPlayer(u))
        endif
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return - 1
        endif
        // Los owners default del sistema wave tambi?n deben contar para rachas,
        // aunque no est?n en la lista de jugadores humanos activos.
        if WaveIsDefaultOwnerPlayerId(pid) then
            return pid
        endif
        // Para el resto de jugadores, solo creditamos si est?n realmente activos.
        if not s__User_isPlaying[((pid))] then // INLINED!!
            return - 1
        endif
        return pid
    endfunction

    function WaveStreaks___WaveGetHeroPlayerId takes unit hero returns integer
        local integer pid
        if hero == null then
            return - 1
        endif
        set pid=GetPlayerId(GetOwningPlayer(hero))
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return - 1
        endif
        if PlayerHero[pid] != hero then
            return - 1
        endif
        return pid
    endfunction

    function WaveStreaks___WaveResetPlayerState takes integer pid returns nothing
        set WaveStreaks___WavePlayerStreakKills[pid]=0
        set WaveStreaks___WavePlayerMultiKills[pid]=0
        set WaveStreaks___WavePlayerMultiExpireAt[pid]=0.0
        set WaveStreaks___WavePlayerLastStreakTier[pid]=0
        set WaveStreaks___WavePlayerLastMultiTier[pid]=0
        set WaveStreaks___WavePlayerLastStreakAnnouncedKills[pid]=0
        set WaveStreaks___WavePlayerLastMultiAnnouncedKills[pid]=0
    endfunction

    function WaveStreaks___WaveGetPlayerNameColoredById takes integer pid returns string
        local integer u
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return "Player " + I2S(pid)
        endif
        set u=((pid)) // INLINED!!
        if s__User_isPlaying[u] then
            return s__User__get_nameColored(u)
        endif
        return GetPlayerName(Player(pid))
    endfunction

    function WaveStreaks___WaveFormatKillUnits takes integer kills returns string
        return I2S(kills) + " kill units"
    endfunction

    function WaveStreaks___WaveQueueFirstBlood takes integer pid,integer waveId returns nothing
        call WaveStreaks___WaveQueuePushTyped(WaveStreaks___WaveStreakFirstBloodSoundPath , WaveStreaks___WaveGetPlayerNameColoredById(pid) + " |cffff3333FIRST BLOOD|r (Wave " + I2S(waveId) + ")" , WaveStreaks___WAVE_QUEUE_KIND_FIRST_BLOOD , pid)
    endfunction

    function WaveStreaks___WaveQueueFinisher takes integer pid,integer waveId returns nothing
        call WaveStreaks___WaveQueuePushTyped(WaveStreaks___WaveFinisherSoundPath , WaveStreaks___WaveGetPlayerNameColoredById(pid) + " |cff33ff66termino la Wave " + I2S(waveId) + "|r matando al ultimo enemigo" , WaveStreaks___WAVE_QUEUE_KIND_WAVE_FINISHER , pid)
        set WaveStreaks___WaveQueueCooldown=0.00
    endfunction

    function WaveStreaks___WaveQueueStreakTier takes integer pid,integer tier,integer kills returns nothing
        call WaveStreaks___WaveQueueDropPendingByKindAndPid(WaveStreaks___WAVE_QUEUE_KIND_STREAK , pid)
        call WaveStreaks___WaveQueuePushTyped(WaveStreaks___WaveStreakKillSoundPath[tier] , WaveStreaks___WaveGetPlayerNameColoredById(pid) + " |cffffff00" + WaveStreaks___WaveGetStreakTierName(tier) + "|r (" + (I2S((kills)) + " kill units") + ")" , WaveStreaks___WAVE_QUEUE_KIND_STREAK , pid) // INLINED!!
        set WaveStreaks___WaveQueueCooldown=0.00
    endfunction

    function WaveStreaks___WaveQueueMultiTier takes integer pid,integer tier,integer kills returns nothing
        call WaveStreaks___WaveQueueDropPendingByKindAndPid(WaveStreaks___WAVE_QUEUE_KIND_MULTI , pid)
        call WaveStreaks___WaveQueuePushTyped(WaveStreaks___WaveMultiKillSoundPath[tier] , WaveStreaks___WaveGetPlayerNameColoredById(pid) + " |cff66ccff" + WaveStreaks___WaveGetMultiTierName(tier) + "|r (" + (I2S((kills)) + " kill units") + ")" , WaveStreaks___WAVE_QUEUE_KIND_MULTI , pid) // INLINED!!
        set WaveStreaks___WaveQueueCooldown=0.00
    endfunction

    function WaveStreaks___WaveQueueBreakStreak takes integer pid,integer kills returns nothing
        call WaveStreaks___WaveQueuePushTyped(WaveStreaks___WaveStreakBreakSoundPath , WaveStreaks___WaveGetPlayerNameColoredById(pid) + " |cffff6666perdió su racha|r (" + I2S(kills) + ")" , WaveStreaks___WAVE_QUEUE_KIND_BREAK_STREAK , pid)
    endfunction

    function WaveStreaks___WaveQueueBreakMulti takes integer pid,integer tier returns nothing
        if tier <= 2 then
            call WaveStreaks___WaveQueuePushTyped(WaveStreaks___WaveMultiBreakLowSoundPath , WaveStreaks___WaveGetPlayerNameColoredById(pid) + " |cff66ccffperdió su multi kill|r (I-II)" , WaveStreaks___WAVE_QUEUE_KIND_BREAK_MULTI , pid)
        else
            call WaveStreaks___WaveQueuePushTyped(WaveStreaks___WaveMultiBreakHighSoundPath , WaveStreaks___WaveGetPlayerNameColoredById(pid) + " |cff66ccffperdió su multi kill|r (III-IV)" , WaveStreaks___WAVE_QUEUE_KIND_BREAK_MULTI , pid)
        endif
    endfunction

    function WaveStreaks___WaveStreakOnWaveStart takes nothing returns nothing
        local integer w= (WaveEventWaveId) // INLINED!!
        if w != 0 then
            call SaveInteger(Table__ht, (WaveStreaks___WaveFirstBloodDoneByWave), (w), ( 0)) // INLINED!!
            call SaveInteger(Table__ht, (WaveStreaks___WaveFinisherDoneByWave), (w), ( 0)) // INLINED!!
        endif
    endfunction

    function WaveStreaks___WaveStreakOnWaveFinish takes nothing returns nothing
        local integer w= (WaveEventWaveId) // INLINED!!
        if w != 0 and (HaveSavedInteger(Table__ht, (WaveStreaks___WaveFirstBloodDoneByWave), (w))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveStreaks___WaveFirstBloodDoneByWave), (w)) // INLINED!!
        endif
        if w != 0 and (HaveSavedInteger(Table__ht, (WaveStreaks___WaveFinisherDoneByWave), (w))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveStreaks___WaveFinisherDoneByWave), (w)) // INLINED!!
        endif
    endfunction

    function WaveStreaks___WaveStreakOnWaveDeath takes nothing returns nothing
        local unit dead= (WaveEventUnit) // INLINED!!
        local unit killer= (WaveEventKiller) // INLINED!!
        local integer w= (WaveEventWaveId) // INLINED!!
        local integer waveId= w
        local integer pid= - 1
        local integer killerPid= - 1
        local integer fallbackPid= - 1
        local integer streakTier
        local integer multiTier
        local integer repeatStep
        local string resolutionState= "native"
        local string returnReason= "none"
        local boolean eventExternal= (WaveEventIsExternal) // INLINED!!
        local boolean eventBoss= (WaveEventIsBoss) // INLINED!!

        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("WaveStreakOnWaveDeath enter " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
        endif
        set killerPid=WaveStreaks___WaveGetOwnerPlayerId(killer)
        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("WaveStreakOnWaveDeath after killerPid pid=" + I2S(killerPid) + " w=" + I2S(waveId) + " dead=" + WaveDebugUnitSummary(dead) + " killer=" + WaveDebugUnitSummary(killer))
        endif
        if killerPid >= 0 then
            set pid=killerPid
        else
            set resolutionState="fallback"
            // Native killer resolution failed (proxy/script damage), fall back
            // to the last tracked damage credit for this dead wave unit.
            set fallbackPid=WaveGetDamageCreditOwnerPid(dead)
            set pid=fallbackPid
        endif
        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("WaveStreakOnWaveDeath after fallback pid=" + I2S(pid) + " fallbackPid=" + I2S(fallbackPid) + " resolution=" + resolutionState + " w=" + I2S(waveId))
        endif
        call WaveClearDamageCredit(dead)
        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("WaveStreakOnWaveDeath after clear damage credit w=" + I2S(waveId) + " dead=" + WaveDebugUnitSummary(dead))
        endif
        if pid < 0 then
            set returnReason="pid_unresolved_after_fallback"
        endif
        if WAVE_DEBUG_ENABLED and ( eventExternal or eventBoss or killerPid < 0 or pid < 0 ) then
            call WaveDebugLog("WaveStreakOnWaveDeath w=" + I2S(waveId) + " dead=" + WaveDebugUnitSummary(dead) + " killer=" + WaveDebugUnitSummary(killer) + " killerPid=" + I2S(killerPid) + " fallbackPid=" + I2S(fallbackPid) + " resolvedPid=" + I2S(pid) + " resolution=" + resolutionState + " external=" + I2S(WaveDebugBoolToInt(eventExternal)) + " boss=" + I2S(WaveDebugBoolToInt(eventBoss)) + " return=" + returnReason)
        endif
        if pid < 0 then
            return
        endif
        call PrisonerDropTrySpawnForPid(dead , pid)

        // First Blood por wave (solo heroe -> wave).
        if waveId != 0 then
            if ( not (HaveSavedInteger(Table__ht, (WaveStreaks___WaveFirstBloodDoneByWave), (waveId))) ) or (LoadInteger(Table__ht, (WaveStreaks___WaveFirstBloodDoneByWave), (waveId))) == 0 then // INLINED!!
                call SaveInteger(Table__ht, (WaveStreaks___WaveFirstBloodDoneByWave), (waveId), ( 1)) // INLINED!!
                call WaveStreaks___WaveQueueFirstBlood(pid , waveId)
            endif
            if (s__Wave_totalKilled[(w)]) <= 0 and ( ( not (HaveSavedInteger(Table__ht, (WaveStreaks___WaveFinisherDoneByWave), (waveId))) ) or (LoadInteger(Table__ht, (WaveStreaks___WaveFinisherDoneByWave), (waveId))) == 0 ) then // INLINED!!
                call SaveInteger(Table__ht, (WaveStreaks___WaveFinisherDoneByWave), (waveId), ( 1)) // INLINED!!
                call WaveStreaks___WaveQueueFinisher(pid , waveId)
            endif
        endif

        if s__User_isPlaying[((pid))] then // INLINED!!
            set WaveStreaks___WavePlayerTotalKills[pid]=WaveStreaks___WavePlayerTotalKills[pid] + 1
        endif

        // Kill streak.
        set WaveStreaks___WavePlayerStreakKills[pid]=WaveStreaks___WavePlayerStreakKills[pid] + 1
        set streakTier=WaveStreaks___WaveGetStreakTier(WaveStreaks___WavePlayerStreakKills[pid])
        if streakTier > WaveStreaks___WavePlayerLastStreakTier[pid] then
            call WaveStreaks___WaveQueueStreakTier(pid , streakTier , WaveStreaks___WavePlayerStreakKills[pid])
            set WaveStreaks___WavePlayerLastStreakTier[pid]=streakTier
            set WaveStreaks___WavePlayerLastStreakAnnouncedKills[pid]=WaveStreaks___WavePlayerStreakKills[pid]
        elseif streakTier == WaveStreaks___WAVE_STREAK_MAX_TIERS and WaveStreaks___WavePlayerLastStreakTier[pid] == WaveStreaks___WAVE_STREAK_MAX_TIERS then
            set repeatStep=WaveStreaks___WaveGetStreakMaxRepeatStep()
            if WaveStreaks___WavePlayerStreakKills[pid] >= WaveStreaks___WavePlayerLastStreakAnnouncedKills[pid] + repeatStep then
                call WaveStreaks___WaveQueueStreakTier(pid , streakTier , WaveStreaks___WavePlayerStreakKills[pid])
                set WaveStreaks___WavePlayerLastStreakAnnouncedKills[pid]=WaveStreaks___WavePlayerStreakKills[pid]
            endif
        endif

        // Multi kill (orden: streak primero, luego multikill).
        if (TimerGetElapsed(WaveStreaks___WaveClockTimer)) <= WaveStreaks___WavePlayerMultiExpireAt[pid] then // INLINED!!
            set WaveStreaks___WavePlayerMultiKills[pid]=WaveStreaks___WavePlayerMultiKills[pid] + 1
        else
            set WaveStreaks___WavePlayerMultiKills[pid]=1
            set WaveStreaks___WavePlayerLastMultiTier[pid]=0
            set WaveStreaks___WavePlayerLastMultiAnnouncedKills[pid]=0
        endif
        set WaveStreaks___WavePlayerMultiExpireAt[pid]=(TimerGetElapsed(WaveStreaks___WaveClockTimer)) + WaveStreaks___WaveMultiKillWindowSec // INLINED!!

        set multiTier=WaveStreaks___WaveGetMultiTier(WaveStreaks___WavePlayerMultiKills[pid])
        if multiTier > WaveStreaks___WavePlayerLastMultiTier[pid] then
            call WaveStreaks___WaveQueueMultiTier(pid , multiTier , WaveStreaks___WavePlayerMultiKills[pid])
            set WaveStreaks___WavePlayerLastMultiTier[pid]=multiTier
            set WaveStreaks___WavePlayerLastMultiAnnouncedKills[pid]=WaveStreaks___WavePlayerMultiKills[pid]
        elseif multiTier == WaveStreaks___WAVE_MULTI_MAX_TIERS and WaveStreaks___WavePlayerLastMultiTier[pid] == WaveStreaks___WAVE_MULTI_MAX_TIERS then
            set repeatStep=WaveStreaks___WaveGetMultiMaxRepeatStep()
            if WaveStreaks___WavePlayerMultiKills[pid] >= WaveStreaks___WavePlayerLastMultiAnnouncedKills[pid] + repeatStep then
                call WaveStreaks___WaveQueueMultiTier(pid , multiTier , WaveStreaks___WavePlayerMultiKills[pid])
                set WaveStreaks___WavePlayerLastMultiAnnouncedKills[pid]=WaveStreaks___WavePlayerMultiKills[pid]
            endif
        endif
        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("WaveStreakOnWaveDeath exit " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss))) + " pid=" + I2S(pid) + " resolution=" + resolutionState + " return=" + returnReason) // INLINED!!
        endif
    endfunction

    function WaveStreaks___WaveStreakOnAnyDeath takes nothing returns nothing
        local unit dead= GetTriggerUnit()
        local unit killer= GetKillingUnit()
        local integer pid= WaveStreaks___WaveGetHeroPlayerId(dead)
        local integer multiTier

        if pid < 0 then
            set dead=null
            set killer=null
            return
        endif

        set multiTier=0
        if (TimerGetElapsed(WaveStreaks___WaveClockTimer)) <= WaveStreaks___WavePlayerMultiExpireAt[pid] then // INLINED!!
            set multiTier=WaveStreaks___WaveGetMultiTier(WaveStreaks___WavePlayerMultiKills[pid])
        endif

        if multiTier > 0 then
            call WaveStreaks___WaveQueueBreakMulti(pid , multiTier)
        elseif WaveStreaks___WavePlayerStreakKills[pid] > 0 then
            call WaveStreaks___WaveQueueBreakStreak(pid , WaveStreaks___WavePlayerStreakKills[pid])
        endif

        set WaveStreaks___WavePlayerTotalDeaths[pid]=WaveStreaks___WavePlayerTotalDeaths[pid] + 1
        call WaveStreaks___WaveResetPlayerState(pid)

        set dead=null
        set killer=null
    endfunction

    function GetWavePlayerCurrentStreak takes integer pid returns integer
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return 0
        endif
        return WaveStreaks___WavePlayerStreakKills[pid]
    endfunction

    function GetWavePlayerCurrentMulti takes integer pid returns integer
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return 0
        endif
        if (TimerGetElapsed(WaveStreaks___WaveClockTimer)) > WaveStreaks___WavePlayerMultiExpireAt[pid] then // INLINED!!
            return 0
        endif
        return WaveStreaks___WavePlayerMultiKills[pid]
    endfunction

    function GetWavePlayerTotalKills takes integer pid returns integer
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return 0
        endif
        return WaveStreaks___WavePlayerTotalKills[pid]
    endfunction

    function GetWavePlayerTotalDeaths takes integer pid returns integer
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return 0
        endif
        return WaveStreaks___WavePlayerTotalDeaths[pid]
    endfunction

    function SetWaveStreakMultiKillWindow takes real sec returns nothing
        if sec < 0.10 then
            set sec=0.10
        endif
        set WaveStreaks___WaveMultiKillWindowSec=sec
    endfunction

    function SetWaveStreakQueueGap takes real sec returns nothing
        if sec < 0.00 then
            set sec=0.00
        endif
        set WaveStreaks___WaveQueueGapSec=sec
    endfunction

    function SetWaveStreakFirstBloodSound takes string path returns nothing
        set WaveStreaks___WaveStreakFirstBloodSoundPath=path
    endfunction

    function SetWaveStreakKillStreakSound takes integer tier,string path returns nothing
        if tier < 1 or tier > WaveStreaks___WAVE_STREAK_MAX_TIERS then
            return
        endif
        set WaveStreaks___WaveStreakKillSoundPath[tier]=path
    endfunction

    function SetWaveStreakMultiKillSound takes integer tier,string path returns nothing
        if tier < 1 or tier > WaveStreaks___WAVE_MULTI_MAX_TIERS then
            return
        endif
        set WaveStreaks___WaveMultiKillSoundPath[tier]=path
    endfunction

    function SetWaveStreakBreakSound takes string path returns nothing
        set WaveStreaks___WaveStreakBreakSoundPath=path
    endfunction

    function SetWaveStreakMultiBreakLowSound takes string path returns nothing
        set WaveStreaks___WaveMultiBreakLowSoundPath=path
    endfunction

    function SetWaveStreakMultiBreakHighSound takes string path returns nothing
        set WaveStreaks___WaveMultiBreakHighSoundPath=path
    endfunction

    function SetWaveStreakFinisherSound takes string path returns nothing
        set WaveStreaks___WaveFinisherSoundPath=path
    endfunction

    function SetWaveStreakKillStreakThreshold takes integer tier,integer kills returns nothing
        if tier < 1 or tier > WaveStreaks___WAVE_STREAK_MAX_TIERS then
            return
        endif
        if kills < 1 then
            set kills=1
        endif
        set WaveStreaks___WaveStreakThresholds[tier]=kills
    endfunction

    function SetWaveStreakMultiKillThreshold takes integer tier,integer kills returns nothing
        if tier < 1 or tier > WaveStreaks___WAVE_MULTI_MAX_TIERS then
            return
        endif
        if kills < 1 then
            set kills=1
        endif
        set WaveStreaks___WaveMultiThresholds[tier]=kills
    endfunction

    function SetWaveStreakKillStreakStep takes integer killsPerTier returns nothing
        local integer tier= 1
        if killsPerTier < 1 then
            set killsPerTier=1
        endif
        loop
            exitwhen tier > WaveStreaks___WAVE_STREAK_MAX_TIERS
            call SetWaveStreakKillStreakThreshold(tier , tier * killsPerTier)
            set tier=tier + 1
        endloop
    endfunction

    function SetWaveStreakMultiKillStep takes integer killsPerTier returns nothing
        local integer tier= 1
        if killsPerTier < 1 then
            set killsPerTier=1
        endif
        loop
            exitwhen tier > WaveStreaks___WAVE_MULTI_MAX_TIERS
            call SetWaveStreakMultiKillThreshold(tier , tier * killsPerTier)
            set tier=tier + 1
        endloop
    endfunction

    // Config default centralizada en este sistema para evitar dependencias circulares.
    function WaveStreaks___ApplyWaveStreakDefaultConfig takes nothing returns nothing
        // Ventanas de tiempo
        call SetWaveStreakMultiKillWindow(WaveStreaks___WAVE_DEFAULT_MULTI_WINDOW)
        call SetWaveStreakQueueGap(WaveStreaks___WAVE_DEFAULT_QUEUE_GAP)

        // Sonidos globales
        set WaveStreaks___WaveStreakFirstBloodSoundPath=(WaveStreaks___WAVE_DEFAULT_SOUND_FIRST_BLOOD) // INLINED!!
        set WaveStreaks___WaveStreakBreakSoundPath=(WaveStreaks___WAVE_DEFAULT_SOUND_STREAK_BREAK) // INLINED!!
        set WaveStreaks___WaveMultiBreakLowSoundPath=(WaveStreaks___WAVE_DEFAULT_SOUND_MULTI_BREAK_LOW) // INLINED!!
        set WaveStreaks___WaveMultiBreakHighSoundPath=(WaveStreaks___WAVE_DEFAULT_SOUND_MULTI_BREAK_HIGH) // INLINED!!
        set WaveStreaks___WaveFinisherSoundPath=(WaveStreaks___WAVE_DEFAULT_SOUND_WAVE_FINISHER) // INLINED!!

        // Kill Streak (8 escalones)
        call SetWaveStreakKillStreakSound(1 , WaveStreaks___WAVE_DEFAULT_SOUND_STREAK_1)
        call SetWaveStreakKillStreakSound(2 , WaveStreaks___WAVE_DEFAULT_SOUND_STREAK_2)
        call SetWaveStreakKillStreakSound(3 , WaveStreaks___WAVE_DEFAULT_SOUND_STREAK_3)
        call SetWaveStreakKillStreakSound(4 , WaveStreaks___WAVE_DEFAULT_SOUND_STREAK_4)
        call SetWaveStreakKillStreakSound(5 , WaveStreaks___WAVE_DEFAULT_SOUND_STREAK_5)
        call SetWaveStreakKillStreakSound(6 , WaveStreaks___WAVE_DEFAULT_SOUND_STREAK_6)
        call SetWaveStreakKillStreakSound(7 , WaveStreaks___WAVE_DEFAULT_SOUND_STREAK_7)
        call SetWaveStreakKillStreakSound(8 , WaveStreaks___WAVE_DEFAULT_SOUND_STREAK_8)

        // Multi Kill (4 escalones)
        call SetWaveStreakMultiKillSound(1 , WaveStreaks___WAVE_DEFAULT_SOUND_MULTI_1)
        call SetWaveStreakMultiKillSound(2 , WaveStreaks___WAVE_DEFAULT_SOUND_MULTI_2)
        call SetWaveStreakMultiKillSound(3 , WaveStreaks___WAVE_DEFAULT_SOUND_MULTI_3)
        call SetWaveStreakMultiKillSound(4 , WaveStreaks___WAVE_DEFAULT_SOUND_MULTI_4)

        // Escalones por step configurable
        call SetWaveStreakKillStreakStep(30)
        call SetWaveStreakMultiKillStep(10)
    endfunction

    function WaveStreaks___Init takes nothing returns nothing
        local trigger t= CreateTrigger()
        local integer i= 0

        set WaveStreaks___WaveFirstBloodDoneByWave=s__Table_create()
        set WaveStreaks___WaveFinisherDoneByWave=s__Table_create()
        set WaveStreaks___WaveClockTimer=(NewTimerEx(0)) // INLINED!!
        set WaveStreaks___WaveQueueTimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(WaveStreaks___WaveClockTimer , TIMER_DEBUG_TAG_WAVE_CORE)
        call SetTimerDebugTag(WaveStreaks___WaveQueueTimer , TIMER_DEBUG_TAG_WAVE_CORE)
        call TimerStart(WaveStreaks___WaveClockTimer, 999999.0, false, function WaveStreaks___WaveClockNoop)

        call WaveStreaks___ApplyWaveStreakDefaultConfig()

        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            call WaveStreaks___WaveResetPlayerState(i)
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_DEATH, null)
            set i=i + 1
        endloop
        call TriggerAddAction(t, function WaveStreaks___WaveStreakOnAnyDeath)

        call RegisterWaveStartEvent(function WaveStreaks___WaveStreakOnWaveStart)
        call RegisterWaveFinishEvent(function WaveStreaks___WaveStreakOnWaveFinish)
        call RegisterWaveDeathEvent(function WaveStreaks___WaveStreakOnWaveDeath)
    endfunction


//===========================================================================
// Loadout MoveCast integration config
// - Registers every Metal Slug weapon fire ability.
// - MoveCast uses a fixed directional session duration independent of
//   weapon profile cast durations.
//===========================================================================


    function LoadoutMoveCastConfi___RegisterWeaponMoveCast takes integer abilityId,string orderName returns nothing
        call RegisterMovementSpell(abilityId , orderName)
        call ConfigureMovementSpellCastSession(abilityId , LoadoutMoveCastConfi___LOADOUT_MOVECAST_FIXED_DURATION , true , LoadoutMoveCastConfi___LOADOUT_MOVECAST_MAX_SMART_RECASTS)
    endfunction

    function LoadoutMoveCastConfi___Init takes nothing returns nothing
        if LoadoutMoveCastConfi___LOADOUT_MOVECAST_ENABLED then
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0A1' , "avatar")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0A3' , "banish")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0A4' , "barkskin")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0A5' , "cripple")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0A6' , "barkskinon")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0A7' , "battleroar")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0A8' , "channel")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0A9' , "chainlightning")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0AA' , "carrionswarm")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0AB' , "breathoffire")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0AC' , "blizzard")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0AD' , "clusterrockets")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast('U0AE' , "thunderbolt")
            call LoadoutMoveCastConfi___RegisterWeaponMoveCast(WEAPON_INVENTORY_FIRE_ABILITY , "channel")
        endif
    endfunction



    function WaveMultiboard__MBSetCell takes multiboard board,integer row,integer column,string value,real width returns nothing
        local multiboarditem boardItem= MultiboardGetItem(board, row, column)
        call MultiboardSetItemStyle(boardItem, true, false)
        call MultiboardSetItemWidth(boardItem, width)
        call MultiboardSetItemValue(boardItem, value)
        call MultiboardReleaseItem(boardItem)
        set boardItem=null
    endfunction

    function WaveMultiboard__MBEnsureLayout takes multiboard board returns nothing
        if board == null then
            return
        endif
        if MultiboardGetColumnCount(board) != WaveMultiboard__MB_COLUMN_COUNT then
            call MultiboardSetColumnCount(board, WaveMultiboard__MB_COLUMN_COUNT)
        endif
        if MultiboardGetRowCount(board) != WaveMultiboard__MB_ROW_COUNT then
            call MultiboardSetRowCount(board, WaveMultiboard__MB_ROW_COUNT)
        endif
    endfunction

    function WaveMultiboard__MBWaveStateText takes integer w returns string
        if s__Wave_isDestroyed[w] or s__Wave_isFinishing[w] then
            return "|cFFB0B0B0Finalizada|r"
        endif
        if s__Wave_isPaused[w] then
            return "|cFFFFFF00Pausada|r"
        endif
        if s__Wave_isRunning[w] then
            return "|cFF66FF99Activa|r"
        endif
        return "|cFFC0C0C0Inactiva|r"
    endfunction

    function WaveMultiboard__MBWaveTitle takes integer w returns string
        return WaveMultiboard__MBWaveStateText(w) + " |cFFFFFFFFWave |r|cFFE6E6E6" + I2S(s__Wave_waveIndex[w]) + "|r|cFFFF8C00/|r|cFFE6E6E6" + I2S(s__Wave_waveTotal[w]) + "|r |cFFFFFFFF| |r |cFFFFFFFFToKill |r|cFFFF3333" + I2S(s__Wave_totalKilled[w]) + "|r|cFFFF8C00/|r|cFFCC66FF" + I2S(s__Wave_totalToSpawn[w]) + "|r"
    endfunction

    function WaveMultiboard__MBWaveCell takes integer w returns string
        return "|cFFE6E6E6W|r|cFFC0C0C0a|r|cFF8C8C8Cv|r|cFF707070e|r|cFFFFFFFF: |r|cFFE6E6E6" + I2S(s__Wave_waveIndex[w]) + "|r|cFFFF8C00/|r|cFFC0C0C0" + I2S(s__Wave_waveTotal[w]) + "|r"
    endfunction

    function WaveMultiboard__MBToSpawnCell takes integer w returns string
        return "|cFFFFD700T|r|cFFFFC300o|r|cFFFFA500S|r|cFFFF8C00pawn|r|cFFFFFFFF: |r|cffff0000" + I2S(s__Wave_remainingUnits[w]) + "|r|cFFFF8C00/|r|cFFFFD700" + I2S(s__Wave_remainingUnits[w] + s__Wave_remainingBosses[w]) + "|r|cFFFF8C00/|r|cFF0080FF" + I2S(s__Wave_remainingBosses[w]) + "|r"
    endfunction

    function WaveMultiboard__MBUnitsCell takes integer w returns string
        return "|cFFFF6666U|r|cFFFF4C4Cn|r|cFFFF3333i|r|cFFFF1A1At|r|cFFCC0000s|r|cFFFFFFFF: |r|cFFCC66FF" + I2S(s__Wave_killsDoneUnits[w]) + "|r|cFFFF8C00/|r|cFF00FF00" + I2S(s__Wave_activeUnits[w]) + "|r|cFFFF8C00/|r|cffff0000" + I2S(s__Wave_totalUnits[w]) + "|r"
    endfunction

    function WaveMultiboard__MBBossCell takes integer w returns string
        return "|cFF00FFFFB|r|cFF00E5FFo|r|cFF00CCFFs|r|cFF00B2FFs|r|cFFFFFFFF: |r|cFFCC66FF" + I2S(s__Wave_killsDoneBoss[w]) + "|r|cFFFF8C00/|r|cFF00FF00" + I2S(s__Wave_activeBosses[w]) + "|r|cFFFF8C00/|r|cFF0080FF" + I2S(s__Wave_totalBosses[w]) + "|r"
    endfunction

    function WaveMultiboard__MBToKillCell takes integer w returns string
        return "|cFFCC66FFT|r|cFFB24CFFo|r|cFF9933FFK|r|cFF7F1AFFill|r|cFFFFFFFF: |r|cFFFF3333" + I2S(s__Wave_totalKilled[w]) + "|r|cFFFF8C00/|r|cFFCC66FF" + I2S(s__Wave_totalToSpawn[w]) + "|r"
    endfunction

    function WaveMultiboard__MBOnMapCell takes integer w returns string
        return "|cFF66FF99O|r|cFF4DFF88n|r|cFF33FF77M|r|cFF1AFF66a|r|cFF00CC55p|r|cFFFFFFFF: |r|cFF00FF00" + I2S(s__Wave_activeOnMap[w]) + "|r"
    endfunction

    function WaveMultiboard__MBPlayerIsActive takes integer pid returns boolean
        if pid < 0 or pid >= WaveMultiboard__MB_MAX_PLAYERS then
            return false
        endif
        return s__User_isPlaying[((pid))] // INLINED!!
    endfunction

    function WaveMultiboard__MBActivePlayerCount takes nothing returns integer
        local integer pid= 0
        local integer count= 0
        loop
            exitwhen pid >= WaveMultiboard__MB_MAX_PLAYERS
            if WaveMultiboard__MBPlayerIsActive(pid) then
                set count=count + 1
            endif
            set pid=pid + 1
        endloop
        return count
    endfunction

    function WaveMultiboard__MBPlayersCell takes nothing returns string
        return "|cFF66FF99Jug|r|cFFFFFFFF: |r|cFFFFFFCC" + I2S(WaveMultiboard__MBActivePlayerCount()) + "|r|cFFFF8C00/|r|cFFFFFFCC" + I2S(WaveMultiboard__MB_MAX_PLAYERS) + "|r"
    endfunction

    function WaveMultiboard__MBPlayerStatusText takes integer pid returns string
        if WaveMultiboard__MBPlayerIsActive(pid) then
            return "|cFF66FF99Activo|r"
        endif
        return "|cFFFF6666Descon.|r"
    endfunction

    function WaveMultiboard__MBPlayerColorHex takes integer pid returns string
        if pid == 0 then
            return "|cffff0303"
        elseif pid == 1 then
            return "|cff0042ff"
        elseif pid == 2 then
            return "|cff1ce6b9"
        elseif pid == 3 then
            return "|cff540081"
        elseif pid == 4 then
            return "|cfffffc01"
        elseif pid == 5 then
            return "|cfffe8a0e"
        elseif pid == 6 then
            return "|cff20c000"
        elseif pid == 7 then
            return "|cffe55bb0"
        endif
        return "|cffffffff"
    endfunction

    function WaveMultiboard__MBPlayerSlotFallbackName takes integer pid returns string
        if pid == 0 then
            return "Rojo"
        elseif pid == 1 then
            return "Azul"
        elseif pid == 2 then
            return "Teal"
        elseif pid == 3 then
            return "Morado"
        elseif pid == 4 then
            return "Amarillo"
        elseif pid == 5 then
            return "Naranja"
        elseif pid == 6 then
            return "Verde"
        elseif pid == 7 then
            return "Rosa"
        endif
        return "Slot"
    endfunction

    function WaveMultiboard__MBPlayerNameText takes integer pid returns string
        local string playerName= GetPlayerName(Player(pid))
        if playerName == "" then
            set playerName=WaveMultiboard__MBPlayerSlotFallbackName(pid)
        endif
        return WaveMultiboard__MBPlayerColorHex(pid) + playerName + "|r"
    endfunction

    function WaveMultiboard__MBPlayerKillsText takes integer pid returns string
        return "|cFFFFFF00K|r|cFFFFFFFF: |r|cFFFFFFCC" + I2S(GetWavePlayerTotalKills(pid)) + "|r"
    endfunction

    function WaveMultiboard__MBPlayerStreakText takes integer pid returns string
        return "|cFFFF9933R|r|cFFFFFFFF: |r|cFFFFCC66" + I2S(GetWavePlayerCurrentStreak(pid)) + "|r"
    endfunction

    function WaveMultiboard__MBPlayerMultiText takes integer pid returns string
        return "|cFF66CCFFM|r|cFFFFFFFF: |r|cFF99E6FF" + I2S(GetWavePlayerCurrentMulti(pid)) + "|r"
    endfunction

    function WaveMultiboard__MBPlayerDeathsText takes integer pid returns string
        return "|cFFFF6666D|r|cFFFFFFFF: |r|cFFFFB3B3" + I2S(GetWavePlayerTotalDeaths(pid)) + "|r"
    endfunction

    function WaveMultiboard__MBPlayerLivesText takes integer pid returns string
        return "|cFF66FF99V|r|cFFFFFFFF: |r|cFFCCFFDD" + I2S((HeroLivesGetCurrent((pid)))) + "|r" // INLINED!!
    endfunction

    function WaveMultiboard__MBDebugInUse takes nothing returns string
        return "|cFF66CCFFInUse|r|cFFFFFFFF: |r|cFFFFFF00" + I2S((TimerUtils___borrowedTimers)) + "|r" // INLINED!!
    endfunction

    function WaveMultiboard__MBDebugCap takes nothing returns string
        return "|cFF66FF99Cap|r|cFFFFFFFF: |r|cFFCCFFDD" + I2S((TimerUtils___QUANTITY)) + "|r" // INLINED!!
    endfunction

    function WaveMultiboard__MBDebugPeak takes nothing returns string
        return "|cFFFFCC66Peak|r|cFFFFFFFF: |r|cFFFFE0B3" + I2S((TimerUtils___peakBorrowedTimers)) + "|r" // INLINED!!
    endfunction

    function WaveMultiboard__MBDebugAvail takes nothing returns string
        return "|cFF9999FFAvail|r|cFFFFFFFF: |r|cFFD6D6FF" + I2S((TimerUtils___tN)) + "|r" // INLINED!!
    endfunction

    function WaveMultiboard__MBLoadoutDebugCell takes string label,string color,integer tag returns string
        return color + label + "|r|cFFFFFFFF: |r|cFFFFFF00" + I2S(GetTimerDebugLive(tag)) + "|r|cFFFF8C00/|r|cFFFFCC66" + I2S(GetTimerDebugPeak(tag)) + "|r"
    endfunction

    function WaveMultiboard__MBTaggedDebugCell takes string label,string color,integer tag returns string
        return color + label + "|r|cFFFFFFFF: |r|cFFFFFF00" + I2S(GetTimerDebugLive(tag)) + "|r|cFFFF8C00/|r|cFFFFCC66" + I2S(GetTimerDebugPeak(tag)) + "|r"
    endfunction

    function WaveMultiboard__MBTextTagTotalCell takes string label,string color,integer liveValue,integer peakValue returns string
        return color + label + "|r|cFFFFFFFF: |r|cFFFFFF00" + I2S(liveValue) + "|r|cFFFF8C00/|r|cFFFFCC66" + I2S(peakValue) + "|r"
    endfunction

    function BMT1 takes nothing returns nothing
        local integer w
        local integer row
        local integer pid

        if CurrentBoardContext == null then
            return
        endif

        set w=(LoadInteger(Table__ht, (WaveByBoard), (GetHandleId(CurrentBoardContext)))) // INLINED!!
        if w == 0 then
            return
        endif

        call WaveMultiboard__MBEnsureLayout(s__Wave_board[w])
        call MultiboardSetTitleText(s__Wave_board[w], WaveMultiboard__MBWaveTitle(w))

        // Row 0: metricas completas de la wave con layout fijo.
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_WAVE , 0 , WaveMultiboard__MBWaveCell(w) , 0.08)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_WAVE , 1 , WaveMultiboard__MBToSpawnCell(w) , 0.14)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_WAVE , 2 , WaveMultiboard__MBUnitsCell(w) , 0.13)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_WAVE , 3 , WaveMultiboard__MBBossCell(w) , 0.11)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_WAVE , 4 , WaveMultiboard__MBToKillCell(w) , 0.12)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_WAVE , 5 , ("|cFF66FF99O|r|cFF4DFF88n|r|cFF33FF77M|r|cFF1AFF66a|r|cFF00CC55p|r|cFFFFFFFF: |r|cFF00FF00" + I2S(s__Wave_activeOnMap[(w)]) + "|r") , 0.09) // INLINED!!
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_WAVE , 6 , ("|cFF66FF99Jug|r|cFFFFFFFF: |r|cFFFFFFCC" + I2S(WaveMultiboard__MBActivePlayerCount()) + "|r|cFFFF8C00/|r|cFFFFFFCC" + I2S(WaveMultiboard__MB_MAX_PLAYERS) + "|r") , 0.08) // INLINED!!

        // Rows 1..8: slots fijos rojo..rosa. Nunca mover debug por AmountPlaying.
        set pid=0
        loop
            exitwhen pid >= WaveMultiboard__MB_MAX_PLAYERS
            set row=WaveMultiboard__MB_ROW_PLAYER_START + pid

            call WaveMultiboard__MBSetCell(s__Wave_board[w] , row , 0 , WaveMultiboard__MBPlayerNameText(pid) , 0.14)
            call WaveMultiboard__MBSetCell(s__Wave_board[w] , row , 1 , WaveMultiboard__MBPlayerStatusText(pid) , 0.09)
            call WaveMultiboard__MBSetCell(s__Wave_board[w] , row , 2 , ("|cFFFFFF00K|r|cFFFFFFFF: |r|cFFFFFFCC" + I2S(GetWavePlayerTotalKills((pid))) + "|r") , 0.09) // INLINED!!
            call WaveMultiboard__MBSetCell(s__Wave_board[w] , row , 3 , ("|cFFFF9933R|r|cFFFFFFFF: |r|cFFFFCC66" + I2S(GetWavePlayerCurrentStreak((pid))) + "|r") , 0.09) // INLINED!!
            call WaveMultiboard__MBSetCell(s__Wave_board[w] , row , 4 , ("|cFF66CCFFM|r|cFFFFFFFF: |r|cFF99E6FF" + I2S(GetWavePlayerCurrentMulti((pid))) + "|r") , 0.08) // INLINED!!
            call WaveMultiboard__MBSetCell(s__Wave_board[w] , row , 5 , ("|cFFFF6666D|r|cFFFFFFFF: |r|cFFFFB3B3" + I2S(GetWavePlayerTotalDeaths((pid))) + "|r") , 0.09) // INLINED!!
            call WaveMultiboard__MBSetCell(s__Wave_board[w] , row , 6 , ("|cFF66FF99V|r|cFFFFFFFF: |r|cFFCCFFDD" + I2S((HeroLivesGetCurrent(((pid))))) + "|r") , 0.08) // INLINED!!

            set pid=pid + 1
        endloop

        // Fila debug general: TimerUtils
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_TIMER , 0 , "|cFFBBBBBBDebug Timer|r" , 0.14)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_TIMER , 1 , ("|cFF66CCFFInUse|r|cFFFFFFFF: |r|cFFFFFF00" + I2S((TimerUtils___borrowedTimers)) + "|r") , 0.09) // INLINED!!
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_TIMER , 2 , ("|cFF66FF99Cap|r|cFFFFFFFF: |r|cFFCCFFDD" + I2S((TimerUtils___QUANTITY)) + "|r") , 0.09) // INLINED!!
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_TIMER , 3 , ("|cFFFFCC66Peak|r|cFFFFFFFF: |r|cFFFFE0B3" + I2S((TimerUtils___peakBorrowedTimers)) + "|r") , 0.09) // INLINED!!
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_TIMER , 4 , ("|cFF9999FFAvail|r|cFFFFFFFF: |r|cFFD6D6FF" + I2S((TimerUtils___tN)) + "|r") , 0.09) // INLINED!!
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_TIMER , 5 , "" , 0.09)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_TIMER , 6 , "" , 0.08)

        // Fila debug loadouts: live/peak por sistema
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_LOADOUT , 0 , "|cFFBBBBBBDebug Load|r" , 0.14)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_LOADOUT , 1 , WaveMultiboard__MBLoadoutDebugCell("Ctrl" , "|cFFFF6666" , TIMER_DEBUG_TAG_LOADOUT_CONTROL) , 0.09)
