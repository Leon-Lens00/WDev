    function WaveTest___WaveCountPlayingUsers takes nothing returns integer
        local integer i= 0
        local integer count= 0
        local player p
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set p=Player(i)
            if ( GetPlayerSlotState(p) == PLAYER_SLOT_STATE_PLAYING ) and ( GetPlayerController(p) == MAP_CONTROL_USER ) then
                set count=count + 1
            endif
            set i=i + 1
        endloop
        set p=null
        if count < 1 then
            set count=1
        endif
        return count
    endfunction

    function WaveTest___WaveHandleAffiliateDeath takes integer hid returns nothing
        local integer aw
        local integer terminateMode= 0
        if (HaveSavedInteger(Table__ht, (WaveAffiliateWaveByUnit), (hid))) then // INLINED!!
            set aw=((LoadInteger(Table__ht, (WaveAffiliateWaveByUnit), (hid)))) // INLINED!!
            if (HaveSavedInteger(Table__ht, (WaveAffiliateModeByUnit), (hid))) then // INLINED!!
                set terminateMode=(LoadInteger(Table__ht, (WaveAffiliateModeByUnit), (hid))) // INLINED!!
            endif
            call RemoveSavedInteger(Table__ht, (WaveAffiliateWaveByUnit), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAffiliateModeByUnit), (hid)) // INLINED!!
            if ( aw != 0 ) and ( not s__Wave_isDestroyed[aw] ) then
                if s__Wave_affiliateUnitHid[aw] == hid then
                    set s__Wave_affiliateUnitHid[aw]=0
                    set s__Wave_affiliateTerminateMode[aw]=0
                endif
                call sc__Wave_terminate(aw,terminateMode == 1)
            endif
        endif
    endfunction

    //==================================================
    // Callback del timer
    //==================================================
    function Wave_onTick takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer hid= GetHandleId(t)
        local integer w

        if (HaveSavedInteger(Table__ht, (WaveByTimer), (hid))) then // INLINED!!
            set w=((LoadInteger(Table__ht, (WaveByTimer), (hid)))) // INLINED!!
            call sc__Wave_onTick(w)
        endif
        set t=null
    endfunction

    //==================================================
    // Spawn
    //==================================================
    function PendingSpawn_execute takes nothing returns nothing
            local timer t= GetExpiredTimer()
            local integer ps= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
            local unit u

            if ( ps == 0 ) then
                call ReleaseTimer(t)
                set t=null
                return
            endif
            if ( s__PendingSpawn_wave[ps] == 0 ) or s__Wave_isDestroyed[s__PendingSpawn_wave[ps]] or ( s__Wave_waveToken[s__PendingSpawn_wave[ps]] != s__PendingSpawn_waveToken[ps] ) then
                if ( s__PendingSpawn_wave[ps] != 0 ) and ( not s__Wave_isDestroyed[s__PendingSpawn_wave[ps]] ) and ( s__Wave_waveToken[s__PendingSpawn_wave[ps]] != s__PendingSpawn_waveToken[ps] ) then
                    call sc__Wave_cancelReservedSpawn(s__PendingSpawn_wave[ps],s__PendingSpawn_slot[ps] , s__PendingSpawn_pid[ps] , ( not s__Wave_cancelPendingPermanently[s__PendingSpawn_wave[ps]] ))
                    call sc__Wave_tryDestroyAfterTermination(s__PendingSpawn_wave[ps])
                endif
                call ReleaseTimer(t)
                call s__PendingSpawn_deallocate(ps)
                set t=null
                return
            endif

            set u=CreateUnit(s__WaveSlot_owner[s__PendingSpawn_slot[ps]], s__WaveSlot_unitId[s__PendingSpawn_slot[ps]], s__PendingSpawn_x[ps], s__PendingSpawn_y[ps], 270.0)
            if ( u == null ) or ( GetUnitTypeId(u) == 0 ) then
                call sc__Wave_cancelReservedSpawn(s__PendingSpawn_wave[ps],s__PendingSpawn_slot[ps] , s__PendingSpawn_pid[ps] , true)
                call ReleaseTimer(t)
                call s__PendingSpawn_deallocate(ps)
                set t=null
                set u=null
                return
            endif
            if ( s__WaveSlot_fxId[s__PendingSpawn_slot[ps]] > 0 ) and ( s__WaveSlot_fxId[s__PendingSpawn_slot[ps]] <= FX_MAX ) then
                call DestroyEffect(AddSpecialEffectTarget(FX_UnitOut[s__WaveSlot_fxId[s__PendingSpawn_slot[ps]]], u, "origin"))
            endif

            call sc__Wave_registerWaveUnit(s__PendingSpawn_wave[ps],u , s__PendingSpawn_slot[ps] , s__WaveSlot_isBoss[s__PendingSpawn_slot[ps]] , false)

            call ReleaseTimer(t)
            call s__PendingSpawn_deallocate(ps)

            set t=null
            set u=null
    endfunction

