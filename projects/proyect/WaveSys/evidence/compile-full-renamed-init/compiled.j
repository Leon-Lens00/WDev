function sa__MovementData_onMoveTick takes nothing returns boolean

        local timer t= GetExpiredTimer()
        local integer this= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local real sx
        local real sy
        local real dx
        local real dy
        local real distSq
        local real dist
        local real step
        local real nx
        local real ny
        if this == 0 then
            set t=null
return true
        endif
        if s__MovementData_moveTim[this] != t then
            set t=null
return true
        endif
        if ( s__MovementData_source[this] == null ) or ( GetUnitTypeId(s__MovementData_source[this]) == 0 ) or ( not UnitAlive(s__MovementData_source[this]) ) then
            call s__MovementData_destroy(this)
            set t=null
return true
        endif
        if MovementSystem__IsLeapBuffActive(s__MovementData_source[this]) then
            call s__MovementData_destroy(this)
            set t=null
return true
        endif
        if ( not s__MovementData_sessionActive[this] ) or ( not s__MovementData_hasMovePoint[this] ) then
            call s__MovementData_stopMovement(this)
            set t=null
return true
        endif
        set sx=GetUnitX(s__MovementData_source[this])
        set sy=GetUnitY(s__MovementData_source[this])
        set dx=s__MovementData_moveX[this] - sx
        set dy=s__MovementData_moveY[this] - sy
        set distSq=dx * dx + dy * dy
        if distSq <= MovementSystem__ARRIVAL_THRESHOLD_SQ then
            call s__MovementData_endSession(this)
            set t=null
return true
        endif
        set dist=SquareRoot(distSq)
        set step=GetUnitMoveSpeed(s__MovementData_source[this]) * MovementSystem__INTERVAL
        if step <= 0. then
            call s__MovementData_endSessionByCollision(this)
            set t=null
return true
        endif
        if step > dist then
            set step=dist
        endif
        set nx=sx + dx / dist * step
        set ny=sy + dy / dist * step
        if not IsTerrainWalkable(nx , ny) then
            call s__MovementData_endSessionByCollision(this)
            set t=null
return true
        endif
        call SetUnitX(s__MovementData_source[this], nx)
        call SetUnitY(s__MovementData_source[this], ny)
        call s__MovementData_syncCastTextTagPosition(this)
        set t=null
   return true
endfunction
function sa__MovementData_onSessionTick takes nothing returns boolean

        local timer t= GetExpiredTimer()
        local integer this= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        if this == 0 then
            set t=null
return true
        endif
        if s__MovementData_sessionTim[this] != t then
            set t=null
return true
        endif
        if ( s__MovementData_source[this] == null ) or ( GetUnitTypeId(s__MovementData_source[this]) == 0 ) or ( not UnitAlive(s__MovementData_source[this]) ) then
            call s__MovementData_destroy(this)
            set t=null
return true
        endif
        if MovementSystem__IsLeapBuffActive(s__MovementData_source[this]) then
            call s__MovementData_destroy(this)
            set t=null
return true
        endif
        set s__MovementData_sessionRemaining[this]=s__MovementData_sessionRemaining[this] - MovementSystem__INTERVAL
        if s__MovementData_sessionRemaining[this] <= 0. then
            call s__MovementData_endSessionAndRestoreMovement(this)
        else
            call s__MovementData_refreshCastTextTag(this)
        endif
        set t=null
   return true
endfunction
function sa__MovementData_onPulse takes nothing returns boolean

        local timer t= GetExpiredTimer()
        local integer this= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        if this == 0 then
            set t=null
return true
        endif
        if s__MovementData_pulseTim[this] != t then
            set t=null
return true
        endif
        set s__MovementData_pulseTim[this]=null
        if ( s__MovementData_source[this] == null ) or ( GetUnitTypeId(s__MovementData_source[this]) == 0 ) or ( not UnitAlive(s__MovementData_source[this]) ) then
            call ReleaseTimer(t)
            set t=null
return true
        endif
        if MovementSystem__IsLeapBuffActive(s__MovementData_source[this]) then
            call s__MovementData_destroy(this)
            call ReleaseTimer(t)
            set t=null
return true
        endif
        if s__MovementData_sessionActive[this] and s__MovementData_hasAimPoint[this] and ( s__MovementData_lastCastOrderId[this] != 0 ) then
            if ( s__MovementData_lastCastTargetUnit[this] != null ) and ( GetUnitTypeId(s__MovementData_lastCastTargetUnit[this]) != 0 ) and UnitAlive(s__MovementData_lastCastTargetUnit[this]) then
                call IssueTargetOrderById(s__MovementData_source[this], s__MovementData_lastCastOrderId[this], s__MovementData_lastCastTargetUnit[this])
            else
                call IssuePointOrderById(s__MovementData_source[this], s__MovementData_lastCastOrderId[this], s__MovementData_aimX[this], s__MovementData_aimY[this])
            endif
        endif
        call ReleaseTimer(t)
        set t=null
   return true
endfunction
