    //==================================================
    // Trigger de muerte
    //==================================================
    function WaveTest___OnUnitDeath takes nothing returns nothing
        local unit u= GetDyingUnit()
        local unit killer= GetKillingUnit()
        local integer hid= GetHandleId(u)
        local integer w
        local integer s
        local integer pid
        local integer ownerPid= - 1
        local integer slotUnitId= - 1
        local boolean isBoss= false
        local boolean isExternal= false
        local string deathKind= "normal"

        if (HaveSavedInteger(Table__ht, (WaveByUnit), (hid))) then // INLINED!!
            set w=((LoadInteger(Table__ht, (WaveByUnit), (hid)))) // INLINED!!
            if w == 0 then
                call WaveDebugLog("OnUnitDeath reject reason=wave_missing unit=" + WaveDebugUnitSummary(u) + " killer=" + WaveDebugUnitSummary(killer) + " hid=" + I2S(hid))
                call RemoveSavedInteger(Table__ht, (WaveByUnit), (hid)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (SlotByUnit), (hid)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (ExternalIsBoss), (hid)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (WaveExternalOwnerPidByUnit), (hid)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (WaveExternalSpawnFxByUnit), (hid)) // INLINED!!
                call WaveTest___WaveHandleAffiliateDeath(hid)
                set u=null
                return
            endif
            if s__Wave_isDestroyed[w] then
                call WaveDebugLog("OnUnitDeath reject reason=wave_destroyed unit=" + WaveDebugUnitSummary(u) + " killer=" + WaveDebugUnitSummary(killer) + " wave=" + I2S(w) + " hid=" + I2S(hid))
                call s__Wave_untrackUnitByHandle(w,hid)
                call RemoveSavedInteger(Table__ht, (WaveByUnit), (hid)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (SlotByUnit), (hid)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (ExternalIsBoss), (hid)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (WaveExternalOwnerPidByUnit), (hid)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (WaveExternalSpawnFxByUnit), (hid)) // INLINED!!
                call WaveTest___WaveHandleAffiliateDeath(hid)
                set u=null
                return
            endif

            set s__Wave_activeOnMap[w]=s__Wave_activeOnMap[w] - 1
            set s__Wave_totalKilled[w]=s__Wave_totalKilled[w] - 1
            set s__Wave_killsDone[w]=s__Wave_killsDone[w] + 1

            if (HaveSavedInteger(Table__ht, (SlotByUnit), (hid))) then // INLINED!!
                set s=((LoadInteger(Table__ht, (SlotByUnit), (hid)))) // INLINED!!
                set slotUnitId=s__WaveSlot_unitId[s]
                if s__WaveSlot_owner[s] != null then
                    set ownerPid=GetPlayerId(s__WaveSlot_owner[s])
                endif
                set pid=ownerPid
                if ( pid >= 0 ) and ( pid < WAVE_TRACKED_PLAYER_SLOTS ) then
                    set s___Wave_activeByPlayer[s__Wave_activeByPlayer[w]+pid]=s___Wave_activeByPlayer[s__Wave_activeByPlayer[w]+pid] - 1
                endif
                set s__WaveSlot_active[s]=s__WaveSlot_active[s] - 1
                if s__WaveSlot_isBoss[s] then
                    set isBoss=true
                    set s__Wave_activeBosses[w]=s__Wave_activeBosses[w] - 1
                    set s__Wave_totalKilledBoss[w]=s__Wave_totalKilledBoss[w] - 1
                    set s__Wave_killsDoneBoss[w]=s__Wave_killsDoneBoss[w] + 1
                else
                    set s__Wave_activeUnits[w]=s__Wave_activeUnits[w] - 1
                    set s__Wave_totalKilledUnits[w]=s__Wave_totalKilledUnits[w] - 1
                    set s__Wave_killsDoneUnits[w]=s__Wave_killsDoneUnits[w] + 1
                endif
            elseif (HaveSavedInteger(Table__ht, (ExternalIsBoss), (hid))) then // INLINED!!
                set isExternal=true
                if (HaveSavedInteger(Table__ht, (WaveExternalOwnerPidByUnit), (hid))) then // INLINED!!
                    set pid=(LoadInteger(Table__ht, (WaveExternalOwnerPidByUnit), (hid))) // INLINED!!
                    set ownerPid=pid
                    if ( pid >= 0 ) and ( pid < WAVE_TRACKED_PLAYER_SLOTS ) then
                        set s___Wave_activeByPlayer[s__Wave_activeByPlayer[w]+pid]=s___Wave_activeByPlayer[s__Wave_activeByPlayer[w]+pid] - 1
                        if s___Wave_activeByPlayer[s__Wave_activeByPlayer[w]+pid] < 0 then
                            set s___Wave_activeByPlayer[s__Wave_activeByPlayer[w]+pid]=0
                        endif
                    endif
                endif
                if (LoadInteger(Table__ht, (ExternalIsBoss), (hid))) == 1 then // INLINED!!
                    set isBoss=true
                    set s__Wave_activeBosses[w]=s__Wave_activeBosses[w] - 1
                    set s__Wave_totalKilledBoss[w]=s__Wave_totalKilledBoss[w] - 1
                    set s__Wave_killsDoneBoss[w]=s__Wave_killsDoneBoss[w] + 1
                else
                    set s__Wave_activeUnits[w]=s__Wave_activeUnits[w] - 1
                    set s__Wave_totalKilledUnits[w]=s__Wave_totalKilledUnits[w] - 1
                    set s__Wave_killsDoneUnits[w]=s__Wave_killsDoneUnits[w] + 1
                endif
            endif

            if isExternal and isBoss then
                set deathKind="external_boss"
            elseif isExternal then
                set deathKind="external"
            elseif isBoss then
                set deathKind="boss"
            endif

            if WAVE_DEBUG_ENABLED then
                call WaveDebugLog("OnUnitDeath w=" + I2S(w) + " kind=" + deathKind + " unit=" + WaveDebugUnitSummary(u) + " killer=" + WaveDebugUnitSummary(killer) + " external=" + I2S(WaveDebugBoolToInt(isExternal)) + " boss=" + I2S(WaveDebugBoolToInt(isBoss)) + " ownerPid=" + I2S(ownerPid) + " slotUnitId=" + I2S(slotUnitId) + " hid=" + I2S(hid))
            endif

            call s__Wave_untrackUnitByHandle(w,hid)
            call WaveTest___WaveFireDeath(w , u , killer , s , isBoss , isExternal)

            call RemoveSavedInteger(Table__ht, (WaveByUnit), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (SlotByUnit), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (ExternalIsBoss), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveExternalOwnerPidByUnit), (hid)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveExternalSpawnFxByUnit), (hid)) // INLINED!!
            call s__Wave_tryDestroyAfterTermination(w)
        endif

        call WaveTest___WaveHandleAffiliateDeath(hid)

        set killer=null
        set u=null
    endfunction

    function registerExternalUnit takes unit source,unit summoned,boolean isBoss returns nothing
            local integer srcId= GetHandleId(source)
            local integer w

            if not (HaveSavedInteger(Table__ht, (WaveByUnit), (srcId))) then // INLINED!!
                return
            endif
            set w=((LoadInteger(Table__ht, (WaveByUnit), (srcId)))) // INLINED!!
            if w == 0 then
                return
            endif
            call s__Wave_registerExternalUnit(w,source , summoned , isBoss)
    endfunction

    function GetWaveByUnit takes unit u returns integer
        if u == null then
            return 0
        endif
        if not (HaveSavedInteger(Table__ht, (WaveByUnit), (GetHandleId(u)))) then // INLINED!!
            return 0
        endif
        return ((LoadInteger(Table__ht, (WaveByUnit), (GetHandleId(u))))) // INLINED!!
    endfunction

    function WaveIsDefaultOwnerPlayerId takes integer pid returns boolean
        return ( pid >= WAVE_DEFAULT_OWNER_MIN ) and ( pid <= WAVE_DEFAULT_OWNER_MAX ) and ( pid < bj_MAX_PLAYER_SLOTS )
    endfunction

    function WaveGetDefaultOwnerCount takes nothing returns integer
        return WAVE_DEFAULT_OWNER_MAX - WAVE_DEFAULT_OWNER_MIN + 1
    endfunction

    function WaveGetSpawnFxIdForUnit takes unit u returns integer
        local integer hid
        local integer s
        if u == null or GetUnitTypeId(u) == 0 then
            return 0
        endif
        set s=GetWaveSlotByUnit(u)
        if s != 0 then
            return s__WaveSlot_fxId[s]
        endif
        set hid=GetHandleId(u)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveExternalSpawnFxByUnit), (hid))) then // INLINED!!
            return (LoadInteger(Table__ht, (WaveExternalSpawnFxByUnit), (hid))) // INLINED!!
        endif
        return 0
    endfunction

    function WaveCanSpawnUnitFromDefaultOwnerPid takes unit source,integer pid returns boolean
        local integer w
        if source == null or GetUnitTypeId(source) == 0 then
            return false
        endif
        if not WaveIsDefaultOwnerPlayerId(pid) or pid >= WAVE_TRACKED_PLAYER_SLOTS then
            return false
        endif
        set w=GetWaveByUnit(source)
        if w == 0 or s__Wave_isDestroyed[w] then
            return false
        endif
        return s___Wave_activeByPlayer[s__Wave_activeByPlayer[w]+pid] < s__Wave_perPlayerLimit[w]
    endfunction

    function WaveSpawnUnitFromDefaultOwnerPid takes unit source,integer unitTypeId,integer pid,real x,real y returns unit
        local integer w
        local unit summoned
        local integer fxId
        if unitTypeId == 0 then
            return null
        endif
        if not WaveCanSpawnUnitFromDefaultOwnerPid(source , pid) then
            return null
        endif
        set w=GetWaveByUnit(source)
        if w == 0 or s__Wave_isDestroyed[w] then
            return null
        endif
        set fxId=WaveGetSpawnFxIdForUnit(source)
        if fxId > 0 and fxId <= FX_MAX then
            call DestroyEffect(AddSpecialEffect(FX_UnitIn[fxId], x, y))
        endif
        set summoned=CreateUnit(Player(pid), unitTypeId, x, y, 270.0)
        if summoned == null or GetUnitTypeId(summoned) == 0 then
            set summoned=null
            return null
        endif
        if fxId > 0 and fxId <= FX_MAX then
            call DestroyEffect(AddSpecialEffectTarget(FX_UnitOut[fxId], summoned, "origin"))
        endif
        if fxId > 0 then
            call SaveInteger(Table__ht, (WaveExternalSpawnFxByUnit), (GetHandleId(summoned)), ( fxId)) // INLINED!!
        endif
        return summoned
    endfunction

    function WaveSpawnUnitFromDefaultOwners takes unit source,integer unitTypeId,real x,real y returns unit
        local integer w
        local integer pid
        local unit summoned
        if source == null or GetUnitTypeId(source) == 0 or unitTypeId == 0 then
            return null
        endif
        set w=GetWaveByUnit(source)
        if w == 0 or s__Wave_isDestroyed[w] then
            return null
        endif
        set pid=s__Wave_pickDefaultOwnerPid(w)
        if pid < 0 then
            return null
        endif
        set summoned=WaveSpawnUnitFromDefaultOwnerPid(source , unitTypeId , pid , x , y)
        return summoned
    endfunction
    
    //==================================================
    // Init
    //==================================================
    function WaveTest___Init takes nothing returns nothing
        local trigger t= CreateTrigger()
        local integer i= 0

        set WaveByUnit=s__Table_create()
        set WaveByTimer=s__Table_create()
        set SlotByUnit=s__Table_create()
        set WaveByBoard=s__Table_create()
        set ExternalIsBoss=s__Table_create()
        set WaveActiveUnitByKey=s__Table_create()
        set WaveActivePosByUnit=s__Table_create()
        set WaveAffiliateWaveByUnit=s__Table_create()
        set WaveAffiliateModeByUnit=s__Table_create()
        set WaveExternalOwnerPidByUnit=s__Table_create()
        set WaveExternalSpawnFxByUnit=s__Table_create()
        set WaveEvtStart=CreateTrigger()
        set WaveEvtPause=CreateTrigger()
        set WaveEvtResume=CreateTrigger()
        set WaveEvtFinish=CreateTrigger()
        set WaveEvtSpawn=CreateTrigger()
        set WaveEvtDeath=CreateTrigger()
        set WaveEvtExternal=CreateTrigger()
        call InitFX()

        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            call TriggerRegisterPlayerUnitEvent(t, Player(i), EVENT_PLAYER_UNIT_DEATH, null)
            set i=i + 1
        endloop

        call TriggerAddAction(t, function WaveTest___OnUnitDeath)
    endfunction 




    function s__SelectionSystem_executeElement takes integer u returns nothing
        call SelectionSetupElement(SelectionGetHeroProjectileElementId(SelectionSystem__heroChoice[s__User_id[u]]) , (s__User_handle[(u)]) , PlayerHero[s__User_id[u]]) // INLINED!!
        call SelectionSetupHeroVisual(SelectionSystem__heroChoice[s__User_id[u]] , (s__User_handle[(u)])) // INLINED!!
    endfunction

    function s__SelectionSystem_finishSelection takes integer u returns nothing
        if SelectionSystem__finished[s__User_id[u]] then
            return
        endif
        call SelectionEnsureHeroCreated(u , SelectionSystem__heroChoice[s__User_id[u]])
        call DialogDisplay((s__User_handle[(u)]), SelectionSystem__heroDialog[s__User_id[u]], false) // INLINED!!
        call s__SelectionSystem_executeElement(u)
        set SelectionSystem__finished[s__User_id[u]]=true
        set SelectionSystem__totalFinished=SelectionSystem__totalFinished + 1
    endfunction

    function s__SelectionSystem_startHeroPhase takes nothing returns nothing
        local integer i= 0
        local integer u

        set SelectionSystem__selectionPhase=SelectionSystem__SELECTION_PHASE_HERO
        if SelectionSystem__selectionTimer == null then
            set SelectionSystem__selectionTimer=CreateTimer()
        endif

        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            if not SelectionSystem__heroChosen[s__User_id[u]] then
                call DialogDisplay((s__User_handle[(u)]), SelectionSystem__heroDialog[s__User_id[u]], true) // INLINED!!
            endif
            set i=i + 1
        endloop

        call TimerStart(SelectionSystem__selectionTimer, SelectionSystem__SELECTION_PHASE_TIMEOUT, false, function sc__SelectionSystem_onHeroTimeout)
    endfunction

    function s__SelectionSystem_randomizeMissingHeroes takes nothing returns nothing
        local integer i= 0
        local integer u
        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            if not SelectionSystem__heroChosen[s__User_id[u]] then
                set SelectionSystem__heroChoice[s__User_id[u]]=GetRandomInt(0, 5)
                set SelectionSystem__heroChosen[s__User_id[u]]=true
            endif
            if SelectionSystem__heroChosen[s__User_id[u]] and not SelectionSystem__finished[s__User_id[u]] then
                call s__SelectionSystem_finishSelection(u)
            endif
            set i=i + 1
        endloop
    endfunction

    function s__SelectionSystem_onHeroTimeout takes nothing returns nothing
        call s__SelectionSystem_randomizeMissingHeroes()
        call TriggerEvaluate(st__SelectionSystem_checkAllFinished) // INLINED!!
    endfunction

    function s__SelectionSystem_checkAllFinished takes nothing returns nothing
        if SelectionSystem__selectionPhase != SelectionSystem__SELECTION_PHASE_NONE and SelectionSystem__totalFinished >= s__User_AmountPlaying then
            set SelectionSystem__selectionPhase=SelectionSystem__SELECTION_PHASE_NONE
            call PauseTimer(SelectionSystem__selectionTimer)
            call TriggerEvaluate(st__SelectionSystem_onAllSelected) // INLINED!!
        endif
    endfunction

    function s__SelectionSystem_onAllSelected takes nothing returns nothing
        call SelectionStartGameAfterAllSelected()
    endfunction

    function s__SelectionSystem_onClick takes nothing returns nothing
        local player p= GetTriggerPlayer()
        local integer u= (GetPlayerId((p))) // INLINED!!
        local integer i= 0
        local integer index

        loop
            exitwhen i == 6
            set index=s__User_id[u] * 6 + i

            if GetClickedButton() == SelectionSystem__heroButton[index] and SelectionSystem__selectionPhase == SelectionSystem__SELECTION_PHASE_HERO then
                set SelectionSystem__heroChoice[s__User_id[u]]=i
                set SelectionSystem__heroChosen[s__User_id[u]]=true
                call s__SelectionSystem_finishSelection(u)
                call s__SelectionSystem_checkAllFinished()
                return
            endif

            set i=i + 1
        endloop
    endfunction

    function s__SelectionSystem_createDialogs takes nothing returns nothing
        local integer i= 0
        local integer u
        local integer index

        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!

            set SelectionSystem__heroDialog[s__User_id[u]]=DialogCreate()
            call DialogSetMessage(SelectionSystem__heroDialog[s__User_id[u]], "Elige tu heroe")
            set index=s__User_id[u] * 6
            set SelectionSystem__heroButton[index + 0]=DialogAddButton(SelectionSystem__heroDialog[s__User_id[u]], "Kael", 0)
            set SelectionSystem__heroButton[index + 1]=DialogAddButton(SelectionSystem__heroDialog[s__User_id[u]], "Military", 0)
            set SelectionSystem__heroButton[index + 2]=DialogAddButton(SelectionSystem__heroDialog[s__User_id[u]], "Lob", 0)
            set SelectionSystem__heroButton[index + 3]=DialogAddButton(SelectionSystem__heroDialog[s__User_id[u]], "Yetix", 0)
            set SelectionSystem__heroButton[index + 4]=DialogAddButton(SelectionSystem__heroDialog[s__User_id[u]], "Shinigami", 0)
            set SelectionSystem__heroButton[index + 5]=DialogAddButton(SelectionSystem__heroDialog[s__User_id[u]], "Yoshi", 0)
            call DialogDisplay((s__User_handle[(u)]), SelectionSystem__heroDialog[s__User_id[u]], false) // INLINED!!

            set i=i + 1
        endloop
    endfunction

    function s__SelectionSystem_start takes nothing returns nothing
        local integer i= 0
        local integer u

        call s__SelectionSystem_createDialogs()
        call ShowInitialWaveMultiboard()
        set SelectionSystem__selectionPhase=SelectionSystem__SELECTION_PHASE_HERO

        if SelectionSystem__selectionTimer == null then
            set SelectionSystem__selectionTimer=CreateTimer()
        endif

        set SelectionSystem__dialogTrig=CreateTrigger()
        call TriggerAddAction(SelectionSystem__dialogTrig, function s__SelectionSystem_onClick)

        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!

            call TriggerRegisterDialogEvent(SelectionSystem__dialogTrig, SelectionSystem__heroDialog[s__User_id[u]])
            call DialogDisplay((s__User_handle[(u)]), SelectionSystem__heroDialog[s__User_id[u]], true) // INLINED!!

            set i=i + 1
        endloop

        call TimerStart(SelectionSystem__selectionTimer, SelectionSystem__SELECTION_PHASE_TIMEOUT, false, function s__SelectionSystem_onHeroTimeout)
    endfunction





    function WaveAuraSkills__WaveAuraMemberKey takes integer auraId,integer index returns integer
        return auraId * WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE + index
    endfunction

    function WaveAuraSkills__WaveAuraClearMemberState takes integer key,integer hid,unit target returns nothing
        if target != null and GetUnitTypeId(target) != 0 and (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitInventoryGranted), (hid))) and (LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitInventoryGranted), (hid))) != 0 then // INLINED!!
            call UnitRemoveAbility(target, WaveAuraSkills__WAVE_AURA_TEMP_INVENTORY_ABILITY_ID)
        endif
        if (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitInventoryGranted), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitInventoryGranted), (hid)) // INLINED!!
        endif
        if key != 0 and (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberHidByKey), (key))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberHidByKey), (key)) // INLINED!!
        endif
        call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (hid)) // INLINED!!
        if (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitMemberIndex), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitMemberIndex), (hid)) // INLINED!!
        endif
    endfunction

    function WaveAuraSkills__WaveAuraSecToMs takes real sec returns integer
        if sec <= 0.0 then
            return 0
        endif
        return R2I(sec * 1000.0 + 0.5)
    endfunction

    function WaveAuraSkills__WaveAuraRandomMsRange takes real minSec,real maxSec returns integer
        local real lo= minSec
        local real hi= maxSec
        if hi < lo then
            set lo=maxSec
            set hi=minSec
        endif
        if hi <= 0.0 then
            return 0
        endif
        if lo < 0.0 then
            set lo=0.0
        endif
        return WaveAuraSkills__WaveAuraSecToMs(GetRandomReal(lo, hi))
    endfunction

    function WaveAuraSkills__WaveAuraBoolToInt takes boolean b returns integer
        if b then
            return 1
        endif
        return 0
    endfunction

    function WaveAuraSkills__WaveAuraUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WaveAuraSkills__WaveAuraUnitWaveId takes unit u returns integer
        if u == null or GetUnitTypeId(u) == 0 then
            return 0
        endif
        return s__Wave__staticgetindex(u)
    endfunction

    function WaveAuraSkills__WaveAuraDebugUnitSummary takes unit u returns string
        local integer waveId
        if u == null then
            return "null"
        endif
        set waveId=WaveAuraSkills__WaveAuraUnitWaveId(u)
        return GetUnitName(u) + " ut=" + I2S(GetUnitTypeId(u)) + " hid=" + I2S(GetHandleId(u)) + " ownerPid=" + I2S(GetPlayerId(GetOwningPlayer(u))) + " wave=" + I2S(waveId)
    endfunction

    function WaveAuraSkills__WaveAuraDebugPassesFilter takes unit source returns boolean
        local integer unitTypeId
        local integer waveId
        if not WaveAuraSkills__WAVE_AURA_DEBUG_ENABLED then
            return false
        endif
        if source == null or GetUnitTypeId(source) == 0 then
            return false
        endif
        set unitTypeId=GetUnitTypeId(source)
        if WaveAuraSkills__WAVE_AURA_DEBUG_UNIT_TYPE_FILTER != 0 and unitTypeId != WaveAuraSkills__WAVE_AURA_DEBUG_UNIT_TYPE_FILTER then
            return false
        endif
        if WaveAuraSkills__WAVE_AURA_DEBUG_WAVE_FILTER > 0 then
            set waveId=WaveAuraSkills__WaveAuraUnitWaveId(source)
            if waveId != WaveAuraSkills__WAVE_AURA_DEBUG_WAVE_FILTER then
                return false
            endif
        endif
        return true
    endfunction

    function WaveAuraSkills__WaveAuraDebugLog takes string msg returns nothing
        if not WaveAuraSkills__WAVE_AURA_DEBUG_ENABLED then
            return
        endif
        if WaveAuraSkills__WaveAuraDebugLogsThisTick >= WaveAuraSkills__WAVE_AURA_DEBUG_MAX_LOGS_PER_TICK then
            return
        endif
        set WaveAuraSkills__WaveAuraDebugLogsThisTick=WaveAuraSkills__WaveAuraDebugLogsThisTick + 1
        call BJDebugMsg("[WaveAura] " + msg)
    endfunction

    function WaveAuraSkills__WaveAuraTargetDebugDetails takes unit source,unit target returns string
        local integer sourceWave= 0
        local integer targetWave= 0
        local integer targetHid= 0
        local integer ownerAuraId= 0
        local boolean waveManaged= false
        if target == null or GetUnitTypeId(target) == 0 then
            return "target=null"
        endif
        set waveManaged=IsWaveManagedUnit(target)
        set sourceWave=WaveAuraSkills__WaveAuraUnitWaveId(source)
        set targetWave=WaveAuraSkills__WaveAuraUnitWaveId(target)
        set targetHid=GetHandleId(target)
        if targetHid != 0 and (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (targetHid))) then // INLINED!!
            set ownerAuraId=(LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (targetHid))) // INLINED!!
        endif
        return "waveManaged=" + I2S(WaveAuraSkills__WaveAuraBoolToInt(waveManaged)) + " sourceWave=" + I2S(sourceWave) + " targetWave=" + I2S(targetWave) + " hero=" + I2S(WaveAuraSkills__WaveAuraBoolToInt(IsUnitType(target, UNIT_TYPE_HERO))) + " structure=" + I2S(WaveAuraSkills__WaveAuraBoolToInt(IsUnitType(target, UNIT_TYPE_STRUCTURE))) + " ownerAuraId=" + I2S(ownerAuraId)
    endfunction

    function WaveAuraSkills__WaveAuraTargetRejectReason takes integer auraId,unit source,unit target returns string
        local integer sourceWave
        local integer targetWave
        local integer targetHid
        if not WaveAuraSkills__WaveAuraUnitAlive(source) then
            return "source_dead"
        endif
        if not WaveAuraSkills__WaveAuraUnitAlive(target) then
            return "target_dead_or_invalid"
        endif
        if GetUnitAbilityLevel(target, WaveAuraSkills_WAVE_HKNI_PHASE_BUFF_ID) > 0 then
            return "phase_buff_active"
        endif
        if not IsWaveManagedUnit(target) then
            return "target_not_wave_managed"
        endif
        set sourceWave=WaveAuraSkills__WaveAuraUnitWaveId(source)
        set targetWave=WaveAuraSkills__WaveAuraUnitWaveId(target)
        if sourceWave != targetWave then
            return "wave_mismatch srcWave=" + I2S(sourceWave) + " targetWave=" + I2S(targetWave)
        endif
        if IsUnitType(target, UNIT_TYPE_HERO) or IsUnitType(target, UNIT_TYPE_STRUCTURE) then
            return "hero_or_structure"
        endif
        set targetHid=GetHandleId(target)
        if targetHid != 0 and (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (targetHid))) and (LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (targetHid))) != auraId then // INLINED!!
            return "owned_by_other_aura ownerAuraId=" + I2S((LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (targetHid)))) // INLINED!!
        endif
        return ""
    endfunction

    function WaveAuraSkills__WaveAuraIsHkni takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WaveAuraSkills_WAVE_HKNI_UNIT_ID
    endfunction

    function WaveAuraSkills__WaveAuraIsHkniBoss takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WaveAuraSkills_WAVE_HKNI_BOSS_UNIT_ID
    endfunction

    function WaveAuraSkills__WaveAuraVisualModelForSource takes unit source returns string
        if WaveAuraSkills__WaveAuraIsHkniBoss(source) then
            return WaveAuraSkills_WAVE_HKNI_BOSS_AURA_VISUAL_MODEL
        endif
        return WaveAuraSkills_WAVE_HKNI_AURA_VISUAL_MODEL
    endfunction

    function WaveAuraSkills__WaveAuraIsValidTarget takes integer auraId,unit source,unit target returns boolean
        return WaveAuraSkills__WaveAuraTargetRejectReason(auraId , source , target) == ""
    endfunction

    function WaveAuraSkills__WaveAuraAdd takes integer auraId returns nothing
        set WaveAuraSkills__WaveAuraPrev[auraId]=0
        set WaveAuraSkills__WaveAuraNext[auraId]=WaveAuraSkills__WaveAuraHead
        if WaveAuraSkills__WaveAuraHead != 0 then
            set WaveAuraSkills__WaveAuraPrev[WaveAuraSkills__WaveAuraHead]=auraId
        endif
        set WaveAuraSkills__WaveAuraHead=auraId
    endfunction

    function WaveAuraSkills__WaveAuraRemove takes integer auraId returns nothing
        local integer p= WaveAuraSkills__WaveAuraPrev[auraId]
        local integer n= WaveAuraSkills__WaveAuraNext[auraId]
        if p != 0 then
            set WaveAuraSkills__WaveAuraNext[p]=n
        else
            set WaveAuraSkills__WaveAuraHead=n
        endif
        if n != 0 then
            set WaveAuraSkills__WaveAuraPrev[n]=p
        endif
        set WaveAuraSkills__WaveAuraPrev[auraId]=0
        set WaveAuraSkills__WaveAuraNext[auraId]=0
    endfunction

    function WaveAuraSkills__WaveAuraRemoveMember takes integer auraId,integer hid,unit target,string reason returns nothing
        local integer index
        local integer last
        local integer key
        local integer lastKey
        local unit moved
        local unit source= WaveAuraSkills__WaveAuraSource[auraId]
        local integer inventoryGranted= 0
        if hid == 0 or not (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (hid))) or (LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (hid))) != auraId then // INLINED!!
            return
        endif
        set index=(LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitMemberIndex), (hid))) // INLINED!!
        set last=WaveAuraSkills__WaveAuraMemberCount[auraId]
        if index <= 0 or index > last then
            set key=((auraId ) * WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE + ( index)) // INLINED!!
            call WaveAuraSkills__WaveAuraClearMemberState(key , hid , target)
            return
        endif
        if target != null and GetUnitTypeId(target) != 0 then
            if WaveAuraSkills__WaveAuraDebugPassesFilter(source) then
                call WaveAuraSkills__WaveAuraDebugLog("removeMember auraId=" + I2S(auraId) + " reason=" + reason + " source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " inventoryAbility=" + I2S(WaveAuraSkills__WAVE_AURA_TEMP_INVENTORY_ABILITY_ID) + " item=" + I2S(WaveAuraSkills_WAVE_HKNI_PHASE_ITEM_ID) + " buff=" + I2S(WaveAuraSkills_WAVE_HKNI_PHASE_BUFF_ID))
            endif
            call UnitRemoveBuffBJ(WaveAuraSkills_WAVE_HKNI_PHASE_BUFF_ID, target)
            set key=((auraId ) * WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE + ( index)) // INLINED!!
            call WaveAuraSkills__WaveAuraClearMemberState(key , hid , target)
            set WaveAuraSkills__WaveAuraDebugRemovalCount[auraId]=WaveAuraSkills__WaveAuraDebugRemovalCount[auraId] + 1
        endif
        set key=((auraId ) * WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE + ( index)) // INLINED!!
        set lastKey=((auraId ) * WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE + ( last)) // INLINED!!
        if index != last then
            set moved=(LoadUnitHandle(Table__ht, (((WaveAuraSkills__WaveAuraMemberUnitByKey))), (lastKey))) // INLINED!!
            call SaveUnitHandle(Table__ht, (((WaveAuraSkills__WaveAuraMemberUnitByKey))), (key), ( moved)) // INLINED!!
            if moved != null and GetUnitTypeId(moved) != 0 then
                call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberHidByKey), (key), ( GetHandleId(moved))) // INLINED!!
                call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitMemberIndex), (GetHandleId(moved)), ( index)) // INLINED!!
            endif
        endif
        call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberUnitByKey), (lastKey)) // INLINED!!
        call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberHidByKey), (lastKey)) // INLINED!!
        call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (hid)) // INLINED!!
        if (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitMemberIndex), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitMemberIndex), (hid)) // INLINED!!
        endif
        set WaveAuraSkills__WaveAuraMemberCount[auraId]=last - 1
        set moved=null
    endfunction

    function WaveAuraSkills__WaveAuraRemoveAllMembers takes integer auraId returns nothing
        local integer last
        local integer key
        local unit target
        loop
            set last=WaveAuraSkills__WaveAuraMemberCount[auraId]
            exitwhen last <= 0
            set key=((auraId ) * WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE + ( last)) // INLINED!!
            set target=(LoadUnitHandle(Table__ht, (((WaveAuraSkills__WaveAuraMemberUnitByKey))), (key))) // INLINED!!
        if target != null and GetUnitTypeId(target) != 0 then
            call WaveAuraSkills__WaveAuraRemoveMember(auraId , GetHandleId(target) , target , "destroy_cleanup")
        else
            if (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberHidByKey), (key))) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberHidByKey), (key)) // INLINED!!
            endif
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberUnitByKey), (key)) // INLINED!!
            set WaveAuraSkills__WaveAuraMemberCount[auraId]=last - 1
            endif
            set target=null
        endloop
    endfunction

    function WaveAuraSkills__WaveAuraDestroyVisual takes integer auraId returns nothing
        if auraId <= 0 then
            return
        endif
        if WaveAuraSkills__WaveAuraVisualFx[auraId] != 0 then
            call WaveSkillVisualDestroy(WaveAuraSkills__WaveAuraVisualFx[auraId])
            set WaveAuraSkills__WaveAuraVisualFx[auraId]=0
        endif
    endfunction

    function WaveAuraSkills__WaveAuraDestroy takes integer auraId,string reason returns nothing
        local unit source= WaveAuraSkills__WaveAuraSource[auraId]
        local integer hid= 0
        if source != null and GetUnitTypeId(source) != 0 then
            set hid=GetHandleId(source)
        endif
        if WaveAuraSkills__WaveAuraDebugPassesFilter(source) then
            call WaveAuraSkills__WaveAuraDebugLog("destroy auraId=" + I2S(auraId) + " reason=" + reason + " source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " remainingSec=" + R2S(WaveAuraSkills__WaveAuraRemaining[auraId]) + " members=" + I2S(WaveAuraSkills__WaveAuraMemberCount[auraId]) + " sweepToken=" + I2S(WaveAuraSkills__WaveAuraSweepToken[auraId]))
        endif
        call WaveAuraSkills__WaveAuraRemoveAllMembers(auraId)
        call WaveAuraSkills__WaveAuraRemove(auraId)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid))) and (LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid))) == auraId then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid)) // INLINED!!
        endif
        call WaveAuraSkills__WaveAuraDestroyVisual(auraId)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraVisualByUnit), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraVisualByUnit), (hid)) // INLINED!!
        endif
        set WaveAuraSkills__WaveAuraSweepToken[auraId]=0
        set WaveAuraSkills__WaveAuraMemberCount[auraId]=0
        set WaveAuraSkills__WaveAuraSource[auraId]=null
        set WaveAuraSkills__WaveAuraRadius[auraId]=0.0
        set WaveAuraSkills__WaveAuraRemaining[auraId]=0.0
    endfunction

    function WaveAuraSkills__WaveAuraApplyTarget takes integer auraId,unit target returns nothing
        local integer hid= GetHandleId(target)
        local integer index
        local boolean addedInventory= false
        local item rune= null
        if hid == 0 then
            return
        endif
        if not (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (hid))) then // INLINED!!
            if WaveAuraSkills__WaveAuraMemberCount[auraId] >= ( WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE - 1 ) then
                return
            endif
            set addedInventory=UnitAddAbility(target, WaveAuraSkills__WAVE_AURA_TEMP_INVENTORY_ABILITY_ID)
            set rune=UnitAddItemById(target, WaveAuraSkills_WAVE_HKNI_PHASE_ITEM_ID)
            if rune == null then
                if addedInventory then
                    call UnitRemoveAbility(target, WaveAuraSkills__WAVE_AURA_TEMP_INVENTORY_ABILITY_ID)
                endif
                return
            endif
            if WaveAuraSkills__WaveAuraDebugPassesFilter(WaveAuraSkills__WaveAuraSource[auraId]) then
                call WaveAuraSkills__WaveAuraDebugLog("applyTarget auraId=" + I2S(auraId) + " action=grantRune source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(WaveAuraSkills__WaveAuraSource[auraId]) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " item=" + I2S(WaveAuraSkills_WAVE_HKNI_PHASE_ITEM_ID) + " inventoryAbility=" + I2S(WaveAuraSkills__WAVE_AURA_TEMP_INVENTORY_ABILITY_ID) + " addedInventory=" + I2S(WaveAuraSkills__WaveAuraBoolToInt(addedInventory)))
            endif
            call RemoveItem(rune)
            set rune=null
            if addedInventory then
                call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitInventoryGranted), (hid), ( 1)) // INLINED!!
            endif
            set index=WaveAuraSkills__WaveAuraMemberCount[auraId] + 1
            set WaveAuraSkills__WaveAuraMemberCount[auraId]=index
            call SaveUnitHandle(Table__ht, (((WaveAuraSkills__WaveAuraMemberUnitByKey))), (((auraId ) * WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE + ( index))), ( target)) // INLINED!!
            call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberHidByKey), (((auraId ) * WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE + ( index))), ( hid)) // INLINED!!
            call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitOwnerAura), (hid), ( auraId)) // INLINED!!
            call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraUnitMemberIndex), (hid), ( index)) // INLINED!!
        endif
        call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraSeenTokenByUnit), (hid), ( WaveAuraSkills__WaveAuraSweepToken[auraId])) // INLINED!!
        set rune=null
    endfunction

    function WaveAuraSkills__WaveAuraEnum takes nothing returns nothing
        local integer auraId= WaveAuraSkills__WaveAuraEnumAuraId
        local unit source= WaveAuraSkills__WaveAuraSource[auraId]
        local unit target= GetFilterUnit()
        local string rejectReason
        set WaveAuraSkills__WaveAuraDebugEnumCount[auraId]=WaveAuraSkills__WaveAuraDebugEnumCount[auraId] + 1
        if WaveAuraSkills__WaveAuraDebugPassesFilter(source) and WaveAuraSkills__WaveAuraDebugRawEnumLogs[auraId] < WaveAuraSkills__WAVE_AURA_DEBUG_MAX_RAW_ENUM_LOGS_PER_TICK then
            call WaveAuraSkills__WaveAuraDebugLog("enumRaw auraId=" + I2S(auraId) + " source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " targetTypeId=" + I2S(GetUnitTypeId(target)) + " targetHid=" + I2S(GetHandleId(target)))
            set WaveAuraSkills__WaveAuraDebugRawEnumLogs[auraId]=WaveAuraSkills__WaveAuraDebugRawEnumLogs[auraId] + 1
        endif
        set rejectReason=WaveAuraSkills__WaveAuraTargetRejectReason(auraId , source , target)
        if rejectReason == "" then
            set WaveAuraSkills__WaveAuraDebugApplyCount[auraId]=WaveAuraSkills__WaveAuraDebugApplyCount[auraId] + 1
            call WaveAuraSkills__WaveAuraApplyTarget(auraId , target)
        else
            set WaveAuraSkills__WaveAuraDebugRejectCount[auraId]=WaveAuraSkills__WaveAuraDebugRejectCount[auraId] + 1
            if WaveAuraSkills__WaveAuraDebugPassesFilter(source) then
                if target == null or GetUnitTypeId(target) == 0 then
                    if WaveAuraSkills__WaveAuraDebugNullRejectLogs[auraId] < WaveAuraSkills__WAVE_AURA_DEBUG_MAX_NULL_REJECT_LOGS_PER_TICK then
                        call WaveAuraSkills__WaveAuraDebugLog("enumRejectNull auraId=" + I2S(auraId) + " source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " reason=" + rejectReason)
                        set WaveAuraSkills__WaveAuraDebugNullRejectLogs[auraId]=WaveAuraSkills__WaveAuraDebugNullRejectLogs[auraId] + 1
                    endif
                elseif WaveAuraSkills__WaveAuraDebugRejectLogs[auraId] < WaveAuraSkills__WAVE_AURA_DEBUG_MAX_REJECT_LOGS_PER_TICK then
                    call WaveAuraSkills__WaveAuraDebugLog("enumReject auraId=" + I2S(auraId) + " source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " reason=" + rejectReason + " details=" + WaveAuraSkills__WaveAuraTargetDebugDetails(source , target))
                    set WaveAuraSkills__WaveAuraDebugRejectLogs[auraId]=WaveAuraSkills__WaveAuraDebugRejectLogs[auraId] + 1
                endif
            endif
        endif
        set source=null
        set target=null
    endfunction

    function WaveAuraSkills__WaveAuraSweepMembers takes integer auraId returns nothing
        local integer index= WaveAuraSkills__WaveAuraMemberCount[auraId]
        local integer key
        local unit target
        local integer hid
        loop
            exitwhen index <= 0
            set key=((auraId ) * WaveAuraSkills__WAVE_AURA_MEMBER_STRIDE + ( index)) // INLINED!!
            set target=(LoadUnitHandle(Table__ht, (((WaveAuraSkills__WaveAuraMemberUnitByKey))), (key))) // INLINED!!
            if target == null or GetUnitTypeId(target) == 0 then
                call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraMemberUnitByKey), (key)) // INLINED!!
                set WaveAuraSkills__WaveAuraMemberCount[auraId]=WaveAuraSkills__WaveAuraMemberCount[auraId] - 1
            else
                set hid=GetHandleId(target)
                if not WaveAuraSkills__WaveAuraUnitAlive(target) then
                    call WaveAuraSkills__WaveAuraRemoveMember(auraId , hid , target , "sweep_lost_contact")
                endif
            endif
            set index=index - 1
            set target=null
        endloop
    endfunction

    function WaveAuraSkills__WaveAuraTick takes nothing returns nothing
        local integer auraId= WaveAuraSkills__WaveAuraHead
        local integer nextAuraId
        local unit source
        set WaveAuraSkills__WaveAuraDebugLogsThisTick=0
        loop
            exitwhen auraId == 0
            set nextAuraId=WaveAuraSkills__WaveAuraNext[auraId]
            set source=WaveAuraSkills__WaveAuraSource[auraId]
            if not WaveAuraSkills__WaveAuraUnitAlive(source) then
                call WaveAuraSkills__WaveAuraDestroy(auraId , "source_dead")
            else
                set WaveAuraSkills__WaveAuraDebugEnumCount[auraId]=0
                set WaveAuraSkills__WaveAuraDebugApplyCount[auraId]=0
                set WaveAuraSkills__WaveAuraDebugRejectCount[auraId]=0
                set WaveAuraSkills__WaveAuraDebugRemovalCount[auraId]=0
                set WaveAuraSkills__WaveAuraDebugRejectLogs[auraId]=0
                set WaveAuraSkills__WaveAuraDebugNullRejectLogs[auraId]=0
                set WaveAuraSkills__WaveAuraDebugRawEnumLogs[auraId]=0
                set WaveAuraSkills__WaveAuraRemaining[auraId]=WaveAuraSkills__WaveAuraRemaining[auraId] - WaveAuraSkills_WAVE_HKNI_AURA_REFRESH_INTERVAL
                if WaveAuraSkills__WaveAuraRemaining[auraId] <= 0.0 then
                    if WaveAuraSkills__WaveAuraDebugPassesFilter(source) then
                        call WaveAuraSkills__WaveAuraDebugLog("tickExpire auraId=" + I2S(auraId) + " source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " remainingSec=" + R2S(WaveAuraSkills__WaveAuraRemaining[auraId]))
                    endif
                    call WaveAuraSkills__WaveAuraDestroy(auraId , "duration_expired")
                else
                    set WaveAuraSkills__WaveAuraSweepToken[auraId]=WaveAuraSkills__WaveAuraSweepToken[auraId] + 1
                    if WaveAuraSkills__WaveAuraSweepToken[auraId] <= 0 then
                        set WaveAuraSkills__WaveAuraSweepToken[auraId]=1
                    endif
                    set WaveAuraSkills__WaveAuraEnumAuraId=auraId
                    call GroupEnumUnitsInRange(WaveAuraSkills__WaveAuraEnumGroup, GetUnitX(source), GetUnitY(source), WaveAuraSkills__WaveAuraRadius[auraId], Condition(function WaveAuraSkills__WaveAuraEnum))
                    call GroupClear(WaveAuraSkills__WaveAuraEnumGroup)
                    call WaveAuraSkills__WaveAuraSweepMembers(auraId)
                    if WaveAuraSkills__WaveAuraDebugPassesFilter(source) then
                        call WaveAuraSkills__WaveAuraDebugLog("tick auraId=" + I2S(auraId) + " source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " remainingSec=" + R2S(WaveAuraSkills__WaveAuraRemaining[auraId]) + " radius=" + R2S(WaveAuraSkills__WaveAuraRadius[auraId]) + " sweepToken=" + I2S(WaveAuraSkills__WaveAuraSweepToken[auraId]) + " enum=" + I2S(WaveAuraSkills__WaveAuraDebugEnumCount[auraId]) + " applied=" + I2S(WaveAuraSkills__WaveAuraDebugApplyCount[auraId]) + " rejected=" + I2S(WaveAuraSkills__WaveAuraDebugRejectCount[auraId]) + " removed=" + I2S(WaveAuraSkills__WaveAuraDebugRemovalCount[auraId]) + " members=" + I2S(WaveAuraSkills__WaveAuraMemberCount[auraId]))
                    endif
                endif
            endif
            set auraId=nextAuraId
            set source=null
        endloop

        if WaveAuraSkills__WaveAuraHead == 0 and WaveAuraSkills__WaveAuraTimerRunning then
            call PauseTimer(WaveAuraSkills__WaveAuraTimer)
            set WaveAuraSkills__WaveAuraTimerRunning=false
        endif
    endfunction

    function WaveAuraSkills__WaveAuraEnsureTimer takes nothing returns nothing
        if not WaveAuraSkills__WaveAuraTimerRunning then
            set WaveAuraSkills__WaveAuraTimerRunning=true
            call TimerStart(WaveAuraSkills__WaveAuraTimer, WaveAuraSkills_WAVE_HKNI_AURA_REFRESH_INTERVAL, true, function WaveAuraSkills__WaveAuraTick)
        endif
    endfunction

    function WaveAuraSkills__WaveAuraStart takes unit source,real radius,real duration returns nothing
        local integer auraId= WaveAuraSkills__WaveAuraCount + 1
        local integer hid= GetHandleId(source)
        local integer visualFx= 0
        set WaveAuraSkills__WaveAuraCount=auraId
        set WaveAuraSkills__WaveAuraSource[auraId]=source
        set WaveAuraSkills__WaveAuraRadius[auraId]=radius
        set WaveAuraSkills__WaveAuraRemaining[auraId]=duration
        set WaveAuraSkills__WaveAuraSweepToken[auraId]=0
        set WaveAuraSkills__WaveAuraMemberCount[auraId]=0
        set WaveAuraSkills__WaveAuraDebugEnumCount[auraId]=0
        set WaveAuraSkills__WaveAuraDebugApplyCount[auraId]=0
        set WaveAuraSkills__WaveAuraDebugRejectCount[auraId]=0
        set WaveAuraSkills__WaveAuraDebugRemovalCount[auraId]=0
        set WaveAuraSkills__WaveAuraDebugRejectLogs[auraId]=0
        set WaveAuraSkills__WaveAuraDebugNullRejectLogs[auraId]=0
        set WaveAuraSkills__WaveAuraDebugRawEnumLogs[auraId]=0
        call WaveAuraSkills__WaveAuraAdd(auraId)
        call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid), ( auraId)) // INLINED!!
        if WaveAuraSkills__WaveAuraDebugPassesFilter(source) then
            call WaveAuraSkills__WaveAuraDebugLog("start auraId=" + I2S(auraId) + " source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " radius=" + R2S(radius) + " durationSec=" + R2S(duration) + " visual=" + WaveAuraSkills__WaveAuraVisualModelForSource(source) + " hid=" + I2S(hid))
        endif
        call SetUnitAnimation(source, "attack")
        if (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraVisualByUnit), (hid))) then // INLINED!!
            call WaveSkillVisualDestroy((LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraVisualByUnit), (hid)))) // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraVisualByUnit), (hid)) // INLINED!!
        endif
        set visualFx=WaveSkillVisualCreateFollowerScaled(source , WaveAuraSkills__WaveAuraVisualModelForSource(source) , WaveSkillVisualShieldScaleForRadius(radius))
        set WaveAuraSkills__WaveAuraVisualFx[auraId]=visualFx
        call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraVisualByUnit), (hid), ( visualFx)) // INLINED!!
        call WaveAuraSkills__WaveAuraEnsureTimer()
    endfunction

    function WaveAuraSkills__WaveAuraCleanupDeadSource takes nothing returns nothing
        local unit u= (WaveEventUnit) // INLINED!!
        local integer hid
        local integer auraId
        local integer unitType
        if u == null then
            return
        endif
        set unitType=GetUnitTypeId(u)
        if unitType != WaveAuraSkills_WAVE_HKNI_UNIT_ID and unitType != WaveAuraSkills_WAVE_HKNI_BOSS_UNIT_ID then
            set u=null
            return
        endif
        if WaveAuraSkills__WaveAuraDebugPassesFilter(u) then
            call WaveAuraSkills__WaveAuraDebugLog("cleanupDeadSource enter source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(u) + " waveDeath=" + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
        endif
        set hid=GetHandleId(u)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid))) then // INLINED!!
            set auraId=(LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid))) // INLINED!!
            if auraId != 0 then
                call WaveAuraSkills__WaveAuraDestroy(auraId , "wave_death_event")
            endif
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid)) // INLINED!!
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraVisualByUnit), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraVisualByUnit), (hid)) // INLINED!!
        endif
        if WaveAuraSkills__WaveAuraDebugPassesFilter(u) then
            call WaveAuraSkills__WaveAuraDebugLog("cleanupDeadSource exit source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(u) + " waveDeath=" + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
        endif
        set u=null
    endfunction

    function WaveAuraSkillsTryExecute takes unit source,unit target,integer nowMs returns boolean
        local integer hid
        local integer nextMs
        local boolean isBoss= false
        local boolean debugOn
        if not WaveAuraSkills__WaveAuraUnitAlive(source) then
            if WaveAuraSkills__WaveAuraDebugPassesFilter(source) then
                call WaveAuraSkills__WaveAuraDebugLog("tryExecute reject reason=source_dead source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " nowMs=" + I2S(nowMs))
            endif
            return false
        endif
        set debugOn=WaveAuraSkills__WaveAuraDebugPassesFilter(source)
        if WaveAuraSkills__WaveAuraIsHkniBoss(source) then
            set isBoss=true
        elseif not WaveAuraSkills__WaveAuraIsHkni(source) then
            if debugOn then
                call WaveAuraSkills__WaveAuraDebugLog("tryExecute reject reason=source_type_mismatch source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " nowMs=" + I2S(nowMs))
            endif
            return false
        endif
        if target == null or GetUnitTypeId(target) == 0 or not UnitAlive(target) or not IsUnitType(target, UNIT_TYPE_HERO) then
            if debugOn then
                call WaveAuraSkills__WaveAuraDebugLog("tryExecute reject reason=target_invalid_or_not_hero source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " nowMs=" + I2S(nowMs))
            endif
            return false
        endif

        set hid=GetHandleId(source)
        if hid == 0 then
            if debugOn then
                call WaveAuraSkills__WaveAuraDebugLog("tryExecute reject reason=source_handle_zero source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " nowMs=" + I2S(nowMs))
            endif
            return false
        endif

        if (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid))) and (LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid))) != 0 then // INLINED!!
            if debugOn and WaveAuraSkills__WAVE_AURA_DEBUG_LOG_ACTIVE_AURA_EXISTS then
                call WaveAuraSkills__WaveAuraDebugLog("tryExecute reject reason=active_aura_exists source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " auraId=" + I2S((LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid)))) + " nowMs=" + I2S(nowMs)) // INLINED!!
            endif
            return false
        endif

        if not (HaveSavedInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid))) then // INLINED!!
            if isBoss then
                call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid), ( nowMs + WaveAuraSkills__WaveAuraRandomMsRange(WaveAuraSkills_WAVE_HKNI_BOSS_INITIAL_DELAY_MIN , WaveAuraSkills_WAVE_HKNI_BOSS_INITIAL_DELAY_MAX))) // INLINED!!
            else
                call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid), ( nowMs + WaveAuraSkills__WaveAuraRandomMsRange(WaveAuraSkills_WAVE_HKNI_INITIAL_DELAY_MIN , WaveAuraSkills_WAVE_HKNI_INITIAL_DELAY_MAX))) // INLINED!!
            endif
            if debugOn then
                call WaveAuraSkills__WaveAuraDebugLog("tryExecute arm reason=seed_initial_delay source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " nextMs=" + I2S((LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid)))) + " nowMs=" + I2S(nowMs) + " boss=" + I2S(WaveAuraSkills__WaveAuraBoolToInt(isBoss))) // INLINED!!
            endif
            return false
        endif

        set nextMs=(LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid))) // INLINED!!
        if nowMs < nextMs then
            if debugOn then
                call WaveAuraSkills__WaveAuraDebugLog("tryExecute reject reason=waiting_cooldown source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " nowMs=" + I2S(nowMs) + " nextMs=" + I2S(nextMs) + " waitMs=" + I2S(nextMs - nowMs) + " boss=" + I2S(WaveAuraSkills__WaveAuraBoolToInt(isBoss)))
            endif
            return false
        endif

        if isBoss then
            call WaveAuraSkills__WaveAuraStart(source , WaveAuraSkills_WAVE_HKNI_BOSS_AURA_RADIUS , WaveAuraSkills_WAVE_HKNI_BOSS_AURA_DURATION)
            call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid), ( nowMs + WaveAuraSkills__WaveAuraRandomMsRange(WaveAuraSkills_WAVE_HKNI_BOSS_COOLDOWN_MIN , WaveAuraSkills_WAVE_HKNI_BOSS_COOLDOWN_MAX))) // INLINED!!
            if debugOn then
                call WaveAuraSkills__WaveAuraDebugLog("tryExecute start reason=ready source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " auraId=" + I2S((LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid)))) + " radius=" + R2S(WaveAuraSkills_WAVE_HKNI_BOSS_AURA_RADIUS) + " durationSec=" + R2S(WaveAuraSkills_WAVE_HKNI_BOSS_AURA_DURATION) + " nextMs=" + I2S((LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid)))) + " nowMs=" + I2S(nowMs) + " boss=1") // INLINED!!
            endif
            return true
        endif

        call WaveAuraSkills__WaveAuraStart(source , WaveAuraSkills_WAVE_HKNI_AURA_RADIUS , WaveAuraSkills_WAVE_HKNI_AURA_DURATION)
        call SaveInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid), ( nowMs + WaveAuraSkills__WaveAuraRandomMsRange(WaveAuraSkills_WAVE_HKNI_COOLDOWN_MIN , WaveAuraSkills_WAVE_HKNI_COOLDOWN_MAX))) // INLINED!!
        if debugOn then
            call WaveAuraSkills__WaveAuraDebugLog("tryExecute start reason=ready source=" + WaveAuraSkills__WaveAuraDebugUnitSummary(source) + " target=" + WaveAuraSkills__WaveAuraDebugUnitSummary(target) + " auraId=" + I2S((LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraActiveAuraByUnit), (hid)))) + " radius=" + R2S(WaveAuraSkills_WAVE_HKNI_AURA_RADIUS) + " durationSec=" + R2S(WaveAuraSkills_WAVE_HKNI_AURA_DURATION) + " nextMs=" + I2S((LoadInteger(Table__ht, (WaveAuraSkills__WaveAuraNextCastMs), (hid)))) + " nowMs=" + I2S(nowMs) + " boss=0") // INLINED!!
        endif
        return true
    endfunction

    function WaveAuraSetDebug takes boolean enabled returns nothing
        set WaveAuraSkills__WAVE_AURA_DEBUG_ENABLED=enabled
        set WaveAuraSkills__WaveAuraDebugLogsThisTick=0
    endfunction

    function WaveAuraSetDebugWaveFilter takes integer waveId returns nothing
        if waveId < 0 then
            set waveId=0
        endif
        set WaveAuraSkills__WAVE_AURA_DEBUG_WAVE_FILTER=waveId
        set WaveAuraSkills__WaveAuraDebugLogsThisTick=0
    endfunction

    function WaveAuraSetDebugUnitTypeFilter takes integer unitTypeId returns nothing
        if unitTypeId < 0 then
            set unitTypeId=0
        endif
        set WaveAuraSkills__WAVE_AURA_DEBUG_UNIT_TYPE_FILTER=unitTypeId
        set WaveAuraSkills__WaveAuraDebugLogsThisTick=0
    endfunction

    function WaveAuraSetDebugMaxLogsPerTick takes integer maxLogs returns nothing
        if maxLogs < 1 then
            set maxLogs=1
        elseif maxLogs > 200 then
            set maxLogs=200
        endif
        set WaveAuraSkills__WAVE_AURA_DEBUG_MAX_LOGS_PER_TICK=maxLogs
        set WaveAuraSkills__WaveAuraDebugLogsThisTick=0
    endfunction

    function WaveAuraSetDebugMaxRejectLogsPerTick takes integer maxLogs returns nothing
        if maxLogs < 0 then
            set maxLogs=0
        elseif maxLogs > 64 then
            set maxLogs=64
        endif
        set WaveAuraSkills__WAVE_AURA_DEBUG_MAX_REJECT_LOGS_PER_TICK=maxLogs
        set WaveAuraSkills__WaveAuraDebugLogsThisTick=0
    endfunction

    function WaveAuraSkills__Init takes nothing returns nothing
        set WaveAuraSkills__WaveAuraNextCastMs=s__Table_create()
        set WaveAuraSkills__WaveAuraActiveAuraByUnit=s__Table_create()
        set WaveAuraSkills__WaveAuraUnitOwnerAura=s__Table_create()
        set WaveAuraSkills__WaveAuraUnitMemberIndex=s__Table_create()
        set WaveAuraSkills__WaveAuraMemberUnitByKey=s__Table_create()
        set WaveAuraSkills__WaveAuraMemberHidByKey=s__Table_create()
        set WaveAuraSkills__WaveAuraSeenTokenByUnit=s__Table_create()
        set WaveAuraSkills__WaveAuraVisualByUnit=s__Table_create()
        set WaveAuraSkills__WaveAuraUnitInventoryGranted=s__Table_create()
        set WaveAuraSkills__WaveAuraEnumGroup=CreateGroup()
        set WaveAuraSkills__WaveAuraTimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(WaveAuraSkills__WaveAuraTimer , TIMER_DEBUG_TAG_UNIT_SKILLS)

        call RegisterWaveDeathEvent(function WaveAuraSkills__WaveAuraCleanupDeadSource)
    endfunction



    function WaveBarrierSkills___WaveBarrierSecToMs takes real sec returns integer
        if sec <= 0.0 then
            return 0
        endif
        return R2I(sec * 1000.0 + 0.5)
    endfunction

    function WaveBarrierSkills___WaveBarrierRandomMsRange takes real minSec,real maxSec returns integer
        local real lo= minSec
        local real hi= maxSec
        if hi < lo then
            set lo=maxSec
            set hi=minSec
        endif
        if hi <= 0.0 then
            return 0
        endif
        if lo < 0.0 then
            set lo=0.0
        endif
        return WaveBarrierSkills___WaveBarrierSecToMs(GetRandomReal(lo, hi))
    endfunction

    function WaveBarrierSkills___WaveBarrierUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WaveBarrierSkills___WaveBarrierIsHfoo takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WaveBarrierSkills_WAVE_HFOO_UNIT_ID
    endfunction

    function WaveBarrierSkills___WaveBarrierIsHfooBoss takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WaveBarrierSkills_WAVE_HFOO_BOSS_UNIT_ID
    endfunction

    function WaveBarrierSkills___WaveBarrierVisualModelForSource takes unit source returns string
        if WaveBarrierSkills___WaveBarrierIsHfooBoss(source) then
            return WaveBarrierSkills_WAVE_HFOO_BOSS_BARRIER_VISUAL_MODEL
        endif
        return WaveBarrierSkills_WAVE_HFOO_BARRIER_VISUAL_MODEL
    endfunction

    function WaveBarrierSkills___WaveBarrierAdd takes integer barrierId returns nothing
        set WaveBarrierSkills___WaveBarrierPrev[barrierId]=0
        set WaveBarrierSkills___WaveBarrierNext[barrierId]=WaveBarrierSkills___WaveBarrierHead
        if WaveBarrierSkills___WaveBarrierHead != 0 then
            set WaveBarrierSkills___WaveBarrierPrev[WaveBarrierSkills___WaveBarrierHead]=barrierId
        endif
        set WaveBarrierSkills___WaveBarrierHead=barrierId
    endfunction

    function WaveBarrierSkills___WaveBarrierRemove takes integer barrierId returns nothing
        local integer p= WaveBarrierSkills___WaveBarrierPrev[barrierId]
        local integer n= WaveBarrierSkills___WaveBarrierNext[barrierId]
        if p != 0 then
            set WaveBarrierSkills___WaveBarrierNext[p]=n
        else
            set WaveBarrierSkills___WaveBarrierHead=n
        endif
        if n != 0 then
            set WaveBarrierSkills___WaveBarrierPrev[n]=p
        endif
        set WaveBarrierSkills___WaveBarrierPrev[barrierId]=0
        set WaveBarrierSkills___WaveBarrierNext[barrierId]=0
    endfunction

    function WaveBarrierSkills___WaveBarrierContains takes integer barrierId,player projectileOwner,real x,real y returns boolean
        local unit source= WaveBarrierSkills___WaveBarrierSource[barrierId]
        local real dx
        local real dy
        local real radius
        if barrierId <= 0 or projectileOwner == null then
            return false
        endif
        if not WaveBarrierSkills___WaveBarrierUnitAlive(source) then
            return false
        endif
        if not IsPlayerEnemy(projectileOwner, GetOwningPlayer(source)) then
            return false
        endif
        set radius=WaveBarrierSkills___WaveBarrierRadius[barrierId]
        set dx=x - GetUnitX(source)
        set dy=y - GetUnitY(source)
        return dx * dx + dy * dy <= radius * radius
    endfunction

    function WaveBarrierSkills___WaveBarrierFindAt takes player projectileOwner,real x,real y returns integer
        local integer barrierId= WaveBarrierSkills___WaveBarrierHead
        loop
            exitwhen barrierId == 0
            if WaveBarrierSkills___WaveBarrierContains(barrierId , projectileOwner , x , y) then
                return barrierId
            endif
            set barrierId=WaveBarrierSkills___WaveBarrierNext[barrierId]
        endloop
        return 0
    endfunction

    function WaveBarrierSkills___WaveBarrierDestroyVisual takes integer barrierId returns nothing
        if barrierId <= 0 then
            return
        endif
        if WaveBarrierSkills___WaveBarrierVisualFx[barrierId] != 0 then
            call WaveSkillVisualDestroy(WaveBarrierSkills___WaveBarrierVisualFx[barrierId])
            set WaveBarrierSkills___WaveBarrierVisualFx[barrierId]=0
        endif
    endfunction

    function WaveBarrierSkills___WaveBarrierDestroy takes integer barrierId returns nothing
        local unit source= WaveBarrierSkills___WaveBarrierSource[barrierId]
        local integer hid= 0
        if barrierId <= 0 then
            return
        endif
        if source != null and GetUnitTypeId(source) != 0 then
            set hid=GetHandleId(source)
        endif
        call WaveBarrierSkills___WaveBarrierRemove(barrierId)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierActiveBarrierByUnit), (hid))) and (LoadInteger(Table__ht, (WaveBarrierSkills___WaveBarrierActiveBarrierByUnit), (hid))) == barrierId then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierActiveBarrierByUnit), (hid)) // INLINED!!
        endif
        if source != null and GetUnitTypeId(source) != 0 then
            call AddUnitAnimationProperties(source, WaveBarrierSkills_WAVE_HFOO_DEFEND_TAG, false)
        endif
        call WaveBarrierSkills___WaveBarrierDestroyVisual(barrierId)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierVisualByUnit), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierVisualByUnit), (hid)) // INLINED!!
        endif
        set WaveBarrierSkills___WaveBarrierSource[barrierId]=null
        set WaveBarrierSkills___WaveBarrierRadius[barrierId]=0.0
        set WaveBarrierSkills___WaveBarrierRemaining[barrierId]=0.0
    endfunction

    function WaveBarrierSkills___WaveBarrierTick takes nothing returns nothing
        local integer barrierId= WaveBarrierSkills___WaveBarrierHead
        local integer nextBarrierId
        local unit source
        loop
            exitwhen barrierId == 0
            set nextBarrierId=WaveBarrierSkills___WaveBarrierNext[barrierId]
            set source=WaveBarrierSkills___WaveBarrierSource[barrierId]
            if not WaveBarrierSkills___WaveBarrierUnitAlive(source) then
                call WaveBarrierSkills___WaveBarrierDestroy(barrierId)
            else
                set WaveBarrierSkills___WaveBarrierRemaining[barrierId]=WaveBarrierSkills___WaveBarrierRemaining[barrierId] - WaveBarrierSkills_WAVE_HFOO_BARRIER_TICK
                if WaveBarrierSkills___WaveBarrierRemaining[barrierId] <= 0.0 then
                    call WaveBarrierSkills___WaveBarrierDestroy(barrierId)
                endif
            endif
            set barrierId=nextBarrierId
            set source=null
        endloop

        if WaveBarrierSkills___WaveBarrierHead == 0 and WaveBarrierSkills___WaveBarrierTimerRunning then
            call PauseTimer(WaveBarrierSkills___WaveBarrierTimer)
            set WaveBarrierSkills___WaveBarrierTimerRunning=false
        endif
    endfunction

    function WaveBarrierSkills___WaveBarrierEnsureTimer takes nothing returns nothing
        if not WaveBarrierSkills___WaveBarrierTimerRunning then
            set WaveBarrierSkills___WaveBarrierTimerRunning=true
            call TimerStart(WaveBarrierSkills___WaveBarrierTimer, WaveBarrierSkills_WAVE_HFOO_BARRIER_TICK, true, function WaveBarrierSkills___WaveBarrierTick)
        endif
    endfunction

    function WaveBarrierSkills___WaveBarrierStart takes unit source,real radius,real duration returns nothing
        local integer barrierId= WaveBarrierSkills___WaveBarrierCount + 1
        local integer hid= GetHandleId(source)
        local integer visualFx= 0
        set WaveBarrierSkills___WaveBarrierCount=barrierId
        set WaveBarrierSkills___WaveBarrierSource[barrierId]=source
        set WaveBarrierSkills___WaveBarrierRadius[barrierId]=radius
        set WaveBarrierSkills___WaveBarrierRemaining[barrierId]=duration
        call WaveBarrierSkills___WaveBarrierAdd(barrierId)
        call SaveInteger(Table__ht, (WaveBarrierSkills___WaveBarrierActiveBarrierByUnit), (hid), ( barrierId)) // INLINED!!
        call IssueImmediateOrder(source, "stop")
        call SetUnitAnimation(source, "stand")
        call AddUnitAnimationProperties(source, WaveBarrierSkills_WAVE_HFOO_DEFEND_TAG, true)
        if (HaveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierVisualByUnit), (hid))) then // INLINED!!
            call WaveSkillVisualDestroy((LoadInteger(Table__ht, (WaveBarrierSkills___WaveBarrierVisualByUnit), (hid)))) // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierVisualByUnit), (hid)) // INLINED!!
        endif
        set visualFx=WaveSkillVisualCreateFollowerScaled(source , WaveBarrierSkills___WaveBarrierVisualModelForSource(source) , WaveSkillVisualShieldScaleForRadius(radius))
        set WaveBarrierSkills___WaveBarrierVisualFx[barrierId]=visualFx
        call SaveInteger(Table__ht, (WaveBarrierSkills___WaveBarrierVisualByUnit), (hid), ( visualFx)) // INLINED!!
        call WaveBarrierSkills___WaveBarrierEnsureTimer()
    endfunction

    function WaveBarrierSetProjectileInteraction takes integer projectileKind,integer interaction returns nothing
        if projectileKind <= 0 then
            return
        endif
        if interaction < WAVE_BARRIER_INTERACTION_NONE or interaction > WAVE_BARRIER_INTERACTION_RAY then
            return
        endif
        set WaveBarrierSkills___WaveBarrierProjectileInteractionByKind[projectileKind]=interaction
    endfunction

    function WaveBarrierClearProjectileTrace takes integer projectileId returns nothing
        if projectileId <= 0 then
            return
        endif
        set WaveBarrierSkills___WaveBarrierProjectileBarrierId[projectileId]=0
    endfunction

    function WaveBarrierCheckPlayerProjectile takes integer projectileId,player projectileOwner,real x,real y,integer projectileKind returns integer
        local integer currentBarrierId
        local integer foundBarrierId
        if projectileId <= 0 or projectileOwner == null then
            return WAVE_BARRIER_INTERACTION_NONE
        endif

        set currentBarrierId=WaveBarrierSkills___WaveBarrierProjectileBarrierId[projectileId]
        if currentBarrierId != 0 and WaveBarrierSkills___WaveBarrierContains(currentBarrierId , projectileOwner , x , y) then
            return WAVE_BARRIER_INTERACTION_NONE
        endif

        set WaveBarrierSkills___WaveBarrierProjectileBarrierId[projectileId]=0
        set foundBarrierId=WaveBarrierSkills___WaveBarrierFindAt(projectileOwner , x , y)
        if foundBarrierId == 0 then
            return WAVE_BARRIER_INTERACTION_NONE
        endif

        set WaveBarrierSkills___WaveBarrierProjectileBarrierId[projectileId]=foundBarrierId
        if projectileKind <= 0 then
            set projectileKind=WAVE_BARRIER_PROJECTILE_KIND_NORMAL
        endif
        return WaveBarrierSkills___WaveBarrierProjectileInteractionByKind[projectileKind]
    endfunction

    function WaveBarrierSkillsTryExecute takes unit source,unit target,integer nowMs returns boolean
        local integer hid
        local integer nextMs
        local boolean isBoss= false
        if not WaveBarrierSkills___WaveBarrierUnitAlive(source) then
            return false
        endif
        if WaveBarrierSkills___WaveBarrierIsHfooBoss(source) then
            set isBoss=true
        elseif not WaveBarrierSkills___WaveBarrierIsHfoo(source) then
            return false
        endif
        if target == null or GetUnitTypeId(target) == 0 or not UnitAlive(target) or not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif

        set hid=GetHandleId(source)
        if hid == 0 then
            return false
        endif

        if (HaveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierActiveBarrierByUnit), (hid))) and (LoadInteger(Table__ht, (WaveBarrierSkills___WaveBarrierActiveBarrierByUnit), (hid))) != 0 then // INLINED!!
            return true
        endif

        if not (HaveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierNextCastMs), (hid))) then // INLINED!!
            if isBoss then
                call SaveInteger(Table__ht, (WaveBarrierSkills___WaveBarrierNextCastMs), (hid), ( nowMs + WaveBarrierSkills___WaveBarrierRandomMsRange(WaveBarrierSkills_WAVE_HFOO_BOSS_INITIAL_DELAY_MIN , WaveBarrierSkills_WAVE_HFOO_BOSS_INITIAL_DELAY_MAX))) // INLINED!!
            else
                call SaveInteger(Table__ht, (WaveBarrierSkills___WaveBarrierNextCastMs), (hid), ( nowMs + WaveBarrierSkills___WaveBarrierRandomMsRange(WaveBarrierSkills_WAVE_HFOO_INITIAL_DELAY_MIN , WaveBarrierSkills_WAVE_HFOO_INITIAL_DELAY_MAX))) // INLINED!!
            endif
            return false
        endif

        set nextMs=(LoadInteger(Table__ht, (WaveBarrierSkills___WaveBarrierNextCastMs), (hid))) // INLINED!!
        if nowMs < nextMs then
            return false
        endif

        if isBoss then
            call WaveBarrierSkills___WaveBarrierStart(source , WaveBarrierSkills_WAVE_HFOO_BOSS_BARRIER_RADIUS , WaveBarrierSkills_WAVE_HFOO_BOSS_BARRIER_DURATION)
            call SaveInteger(Table__ht, (WaveBarrierSkills___WaveBarrierNextCastMs), (hid), ( nowMs + WaveBarrierSkills___WaveBarrierRandomMsRange(WaveBarrierSkills_WAVE_HFOO_BOSS_COOLDOWN_MIN , WaveBarrierSkills_WAVE_HFOO_BOSS_COOLDOWN_MAX))) // INLINED!!
            return true
        endif

        call WaveBarrierSkills___WaveBarrierStart(source , WaveBarrierSkills_WAVE_HFOO_BARRIER_RADIUS , WaveBarrierSkills_WAVE_HFOO_BARRIER_DURATION)
        call SaveInteger(Table__ht, (WaveBarrierSkills___WaveBarrierNextCastMs), (hid), ( nowMs + WaveBarrierSkills___WaveBarrierRandomMsRange(WaveBarrierSkills_WAVE_HFOO_COOLDOWN_MIN , WaveBarrierSkills_WAVE_HFOO_COOLDOWN_MAX))) // INLINED!!
        return true
    endfunction

    function WaveBarrierSkills___WaveBarrierCleanupDeadSource takes nothing returns nothing
        local unit u= (WaveEventUnit) // INLINED!!
        local integer hid
        local integer barrierId
        local integer unitType
        if u == null then
            return
        endif
        set unitType=GetUnitTypeId(u)
        if unitType != WaveBarrierSkills_WAVE_HFOO_UNIT_ID and unitType != WaveBarrierSkills_WAVE_HFOO_BOSS_UNIT_ID then
            set u=null
            return
        endif
        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("WaveBarrierCleanupDeadSource enter " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
        endif
        set hid=GetHandleId(u)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierActiveBarrierByUnit), (hid))) then // INLINED!!
            set barrierId=(LoadInteger(Table__ht, (WaveBarrierSkills___WaveBarrierActiveBarrierByUnit), (hid))) // INLINED!!
            if barrierId != 0 then
                call WaveBarrierSkills___WaveBarrierDestroy(barrierId)
            endif
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierNextCastMs), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierNextCastMs), (hid)) // INLINED!!
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierVisualByUnit), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveBarrierSkills___WaveBarrierVisualByUnit), (hid)) // INLINED!!
        endif
        if WAVE_DEBUG_ENABLED then
            call WaveDebugLog("WaveBarrierCleanupDeadSource exit " + ("w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss)))) // INLINED!!
        endif
        set u=null
    endfunction

    function WaveBarrierSkills___Init takes nothing returns nothing
        set WaveBarrierSkills___WaveBarrierNextCastMs=s__Table_create()
        set WaveBarrierSkills___WaveBarrierActiveBarrierByUnit=s__Table_create()
        set WaveBarrierSkills___WaveBarrierVisualByUnit=s__Table_create()
        set WaveBarrierSkills___WaveBarrierTimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(WaveBarrierSkills___WaveBarrierTimer , TIMER_DEBUG_TAG_UNIT_SKILLS)

        set WaveBarrierSkills___WaveBarrierProjectileInteractionByKind[WAVE_BARRIER_PROJECTILE_KIND_NORMAL]=WAVE_BARRIER_INTERACTION_BLOCK
        set WaveBarrierSkills___WaveBarrierProjectileInteractionByKind[WAVE_BARRIER_PROJECTILE_KIND_WIND]=WAVE_BARRIER_INTERACTION_WIND
        set WaveBarrierSkills___WaveBarrierProjectileInteractionByKind[WAVE_BARRIER_PROJECTILE_KIND_RAY]=WAVE_BARRIER_INTERACTION_RAY

        call RegisterWaveDeathEvent(function WaveBarrierSkills___WaveBarrierCleanupDeadSource)
    endfunction



    function WaveMortarSkills__WaveMortarSecToMs takes real sec returns integer
        if sec <= 0.0 then
            return 0
        endif
        return R2I(sec * 1000.0 + 0.5)
    endfunction

    function WaveMortarSkills__WaveMortarRandomMsRange takes real minSec,real maxSec returns integer
        local real lo= minSec
        local real hi= maxSec
        if hi < lo then
            set lo=maxSec
            set hi=minSec
        endif
        if hi <= 0.0 then
            return 0
        endif
        if lo < 0.0 then
            set lo=0.0
        endif
        return WaveMortarSkills__WaveMortarSecToMs(GetRandomReal(lo, hi))
    endfunction

    function WaveMortarSkills__WaveMortarUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WaveMortarSkills__WaveMortarTargetInCastRange takes unit source,unit target returns boolean
        local real dx
        local real dy
        if not WaveMortarSkills__WaveMortarUnitAlive(source) or not WaveMortarSkills__WaveMortarUnitAlive(target) then
            return false
        endif
        set dx=GetUnitX(target) - GetUnitX(source)
        set dy=GetUnitY(target) - GetUnitY(source)
        return dx * dx + dy * dy <= WaveMortarSkills_WAVE_HMTM_CAST_RANGE * WaveMortarSkills_WAVE_HMTM_CAST_RANGE
    endfunction

    function WaveMortarSkills__WaveMortarCanDamageTarget takes integer missile,unit hit returns boolean
        if hit == null or not UnitAlive(hit) then
            return false
        endif
        if not IsUnitEnemy(hit, s__Missile_owner[missile]) then
            return false
        endif
        return true
    endfunction

    function WaveMortarSkills__WaveMortarTravelDuration takes real sx,real sy,real tx,real ty returns real
        local real dx= tx - sx
        local real dy= ty - sy
        local real duration= SquareRoot(dx * dx + dy * dy) / WaveMortarSkills_WAVE_HMTM_PROJECTILE_SPEED
        if duration < 0.10 then
            set duration=0.10
        endif
        return duration
    endfunction

    function WaveMortarSkills__WaveMortarCreateImpactFx takes real x,real y returns nothing
        local effect fx= AddSpecialEffect(WaveMortarSkills_WAVE_HMTM_IMPACT_FX, x, y)
        call DestroyEffect(fx)
        set fx=null
    endfunction

        function s__WaveMortarSkills__WaveMortarMissile_onFinish takes integer missile returns boolean
            local unit hit
            local unit source= s__Missile_source[missile]
            if source != null and GetUnitTypeId(source) != 0 then
                call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, WaveMortarSkills__WaveMortarMissileImpactX[missile], WaveMortarSkills__WaveMortarMissileImpactY[missile], WaveMortarSkills__WaveMortarMissileAoe[missile], null)
                loop
                    set hit=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
                    exitwhen hit == null
                    call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, hit)
                    if WaveMortarSkills__WaveMortarCanDamageTarget(missile , hit) then
                        call UnitDamageTarget(source, hit, WaveMortarSkills__WaveMortarMissileDamage[missile], false, false, ATTACK_TYPE_NORMAL, DAMAGE_TYPE_MAGIC, null)
                    endif
                endloop
            endif
            call WaveMortarSkills__WaveMortarCreateImpactFx(WaveMortarSkills__WaveMortarMissileImpactX[missile] , WaveMortarSkills__WaveMortarMissileImpactY[missile])
            if WaveMortarSkills__WaveMortarMissileMarker[missile] != 0 then
                call WaveSkillVisualDestroy(WaveMortarSkills__WaveMortarMissileMarker[missile])
                set WaveMortarSkills__WaveMortarMissileMarker[missile]=0
            endif
            set hit=null
            set source=null
            return true
        endfunction

        function s__WaveMortarSkills__WaveMortarMissile_onRemove takes integer missile returns boolean
            set WaveMortarSkills__WaveMortarMissileDamage[missile]=0.0
            set WaveMortarSkills__WaveMortarMissileAoe[missile]=0.0
            set WaveMortarSkills__WaveMortarMissileImpactX[missile]=0.0
            set WaveMortarSkills__WaveMortarMissileImpactY[missile]=0.0
            if WaveMortarSkills__WaveMortarMissileMarker[missile] != 0 then
                call WaveSkillVisualDestroy(WaveMortarSkills__WaveMortarMissileMarker[missile])
                set WaveMortarSkills__WaveMortarMissileMarker[missile]=0
            endif
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__WaveMortarSkills__WaveMortarMissile_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__WaveMortarSkills__WaveMortarMissile],missile)
            call Missile___StartPeriodic(si__WaveMortarSkills__WaveMortarMissile)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__WaveMortarSkills__WaveMortarMissile_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__WaveMortarSkills__WaveMortarMissile_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__WaveMortarSkills__WaveMortarMissile)
            endif
        endfunction
























        













    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__WaveMortarSkills__WaveMortarMissile_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__WaveMortarSkills__WaveMortarMissile])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__WaveMortarSkills__WaveMortarMissile_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.







































                    
                    // Runs destructable collision.






                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__WaveMortarSkills__WaveMortarMissile_onFinish(this) then
                                call s__WaveMortarSkills__WaveMortarMissile_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.





                
                    // Runs every Missile_TIMER_TIMEOUT.





                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__WaveMortarSkills__WaveMortarMissile_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__WaveMortarSkills__WaveMortarMissile)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__WaveMortarSkills__WaveMortarMissile )]=Condition(( function s__WaveMortarSkills__WaveMortarMissile_missileIterateP)) // INLINED!!
        endfunction

    function WaveMortarSkills__WaveMortarLaunchProjectile takes unit source,real tx,real ty,real damage,real aoe returns nothing
        local integer missile
        local real sx
        local real sy
        if not WaveMortarSkills__WaveMortarUnitAlive(source) then
            return
        endif
        set sx=GetUnitX(source)
        set sy=GetUnitY(source)
        set missile=s__Missile_createXYZ(sx , sy , WaveMortarSkills_WAVE_HMTM_PROJECTILE_START_Z , tx , ty , WaveMortarSkills_WAVE_HMTM_PROJECTILE_START_Z)
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=GetOwningPlayer(source)
        call s__Missile__set_model(missile,WaveMortarSkills_WAVE_HMTM_PROJECTILE_MODEL)
        call s__Missile__set_scale(missile,WaveSkillVisualScaleForRadius(aoe))
        set s__Missile_collision[missile]=0.0
        set s__Missile_speed[(missile)]=((WaveMortarSkills_WAVE_HMTM_PROJECTILE_SPEED)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!
        call s__Missile__set_arc(missile,WaveMortarSkills_WAVE_HMTM_PROJECTILE_ARC)

        set WaveMortarSkills__WaveMortarMissileDamage[missile]=damage
        set WaveMortarSkills__WaveMortarMissileAoe[missile]=aoe
        set WaveMortarSkills__WaveMortarMissileImpactX[missile]=tx
        set WaveMortarSkills__WaveMortarMissileImpactY[missile]=ty
        set WaveMortarSkills__WaveMortarMissileMarker[missile]=WaveSkillVisualCreateTimedMarker(tx , ty , 0.0 , WaveMortarSkills_WAVE_HMTM_TARGET_MARKER_MODEL , aoe , WaveMortarSkills__WaveMortarTravelDuration(sx , sy , tx , ty))
        call s__WaveMortarSkills__WaveMortarMissile_launch(missile)
    endfunction

    function WaveMortarSkills__WaveMortarBarrageAdd takes integer barrageId returns nothing
        set WaveMortarSkills__WaveMortarBarragePrev[barrageId]=0
        set WaveMortarSkills__WaveMortarBarrageNext[barrageId]=WaveMortarSkills__WaveMortarBarrageHead
        if WaveMortarSkills__WaveMortarBarrageHead != 0 then
            set WaveMortarSkills__WaveMortarBarragePrev[WaveMortarSkills__WaveMortarBarrageHead]=barrageId
        endif
        set WaveMortarSkills__WaveMortarBarrageHead=barrageId
    endfunction

    function WaveMortarSkills__WaveMortarBarrageRemove takes integer barrageId returns nothing
        local integer p= WaveMortarSkills__WaveMortarBarragePrev[barrageId]
        local integer n= WaveMortarSkills__WaveMortarBarrageNext[barrageId]
        if p != 0 then
            set WaveMortarSkills__WaveMortarBarrageNext[p]=n
        else
            set WaveMortarSkills__WaveMortarBarrageHead=n
        endif
        if n != 0 then
            set WaveMortarSkills__WaveMortarBarragePrev[n]=p
        endif
        set WaveMortarSkills__WaveMortarBarragePrev[barrageId]=0
        set WaveMortarSkills__WaveMortarBarrageNext[barrageId]=0
    endfunction

    function WaveMortarSkills__WaveMortarBarrageDestroy takes integer barrageId returns nothing
        local unit source= WaveMortarSkills__WaveMortarBarrageSource[barrageId]
        local integer hid= 0
        if source != null and GetUnitTypeId(source) != 0 then
            set hid=GetHandleId(source)
            call PauseUnit(source, false)
        endif
        call WaveMortarSkills__WaveMortarBarrageRemove(barrageId)
        if hid != 0 and (HaveSavedInteger(Table__ht, (WaveMortarSkills__WaveMortarActiveBarrageByUnit), (hid))) and (LoadInteger(Table__ht, (WaveMortarSkills__WaveMortarActiveBarrageByUnit), (hid))) == barrageId then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveMortarSkills__WaveMortarActiveBarrageByUnit), (hid)) // INLINED!!
        endif
        set WaveMortarSkills__WaveMortarBarrageShotsRemaining[barrageId]=0
        set WaveMortarSkills__WaveMortarBarrageAccumulator[barrageId]=0.0
        set WaveMortarSkills__WaveMortarBarrageSource[barrageId]=null
    endfunction

    function WaveMortarSkills__WaveMortarFireBossRound takes integer barrageId returns nothing
        local unit source= WaveMortarSkills__WaveMortarBarrageSource[barrageId]
        local integer playerId= 0
        local unit hero
        local boolean fired= false
        if not WaveMortarSkills__WaveMortarUnitAlive(source) then
            set source=null
            return
        endif
        call SetUnitAnimation(source, "attack")
        loop
            exitwhen playerId >= bj_MAX_PLAYER_SLOTS
            set hero=PlayerHero[playerId]
            if WaveMortarSkills__WaveMortarUnitAlive(hero) and IsUnitType(hero, UNIT_TYPE_HERO) and IsUnitEnemy(hero, GetOwningPlayer(source)) then
                call WaveMortarSkills__WaveMortarLaunchProjectile(source , GetUnitX(hero) , GetUnitY(hero) , WaveMortarSkills_WAVE_HMTM_BOSS_IMPACT_DAMAGE , WaveMortarSkills_WAVE_HMTM_BOSS_IMPACT_AOE)
                set fired=true
            endif
            set playerId=playerId + 1
        endloop
        if not fired then
            call WaveMortarSkills__WaveMortarLaunchProjectile(source , GetUnitX(source) , GetUnitY(source) , WaveMortarSkills_WAVE_HMTM_BOSS_IMPACT_DAMAGE , WaveMortarSkills_WAVE_HMTM_BOSS_IMPACT_AOE)
        endif
        set hero=null
        set source=null
    endfunction

    function WaveMortarSkills__WaveMortarOnBarrageTick takes nothing returns nothing
        local integer barrageId= WaveMortarSkills__WaveMortarBarrageHead
        local integer nextBarrageId
        loop
            exitwhen barrageId == 0
            set nextBarrageId=WaveMortarSkills__WaveMortarBarrageNext[barrageId]
            if not WaveMortarSkills__WaveMortarUnitAlive(WaveMortarSkills__WaveMortarBarrageSource[barrageId]) then
                call WaveMortarSkills__WaveMortarBarrageDestroy(barrageId)
            else
                set WaveMortarSkills__WaveMortarBarrageAccumulator[barrageId]=WaveMortarSkills__WaveMortarBarrageAccumulator[barrageId] + WaveMortarSkills_WAVE_HMTM_BARRAGE_TICK
                loop
                    exitwhen WaveMortarSkills__WaveMortarBarrageShotsRemaining[barrageId] <= 0 or WaveMortarSkills__WaveMortarBarrageAccumulator[barrageId] < WaveMortarSkills_WAVE_HMTM_BOSS_VOLLEY_INTERVAL
                    set WaveMortarSkills__WaveMortarBarrageAccumulator[barrageId]=WaveMortarSkills__WaveMortarBarrageAccumulator[barrageId] - WaveMortarSkills_WAVE_HMTM_BOSS_VOLLEY_INTERVAL
                    call WaveMortarSkills__WaveMortarFireBossRound(barrageId)
                    set WaveMortarSkills__WaveMortarBarrageShotsRemaining[barrageId]=WaveMortarSkills__WaveMortarBarrageShotsRemaining[barrageId] - 1
                endloop
                if WaveMortarSkills__WaveMortarBarrageShotsRemaining[barrageId] <= 0 then
                    call WaveMortarSkills__WaveMortarBarrageDestroy(barrageId)
                endif
            endif
            set barrageId=nextBarrageId
        endloop
        if WaveMortarSkills__WaveMortarBarrageHead == 0 and WaveMortarSkills__WaveMortarBarrageTimerRunning then
            call PauseTimer(WaveMortarSkills__WaveMortarBarrageTimer)
            set WaveMortarSkills__WaveMortarBarrageTimerRunning=false
        endif
    endfunction

    function WaveMortarSkills__WaveMortarEnsureBarrageTimer takes nothing returns nothing
        if not WaveMortarSkills__WaveMortarBarrageTimerRunning then
            set WaveMortarSkills__WaveMortarBarrageTimerRunning=true
            call TimerStart(WaveMortarSkills__WaveMortarBarrageTimer, WaveMortarSkills_WAVE_HMTM_BARRAGE_TICK, true, function WaveMortarSkills__WaveMortarOnBarrageTick)
        endif
    endfunction

    function WaveMortarSkills__WaveMortarStartBossBarrage takes unit source returns nothing
        local integer barrageId= WaveMortarSkills__WaveMortarBarrageCount + 1
        local integer hid= GetHandleId(source)
        set WaveMortarSkills__WaveMortarBarrageCount=barrageId
        set WaveMortarSkills__WaveMortarBarrageShotsRemaining[barrageId]=WaveMortarSkills_WAVE_HMTM_BOSS_VOLLEY_COUNT
        set WaveMortarSkills__WaveMortarBarrageAccumulator[barrageId]=WaveMortarSkills_WAVE_HMTM_BOSS_VOLLEY_INTERVAL
        set WaveMortarSkills__WaveMortarBarrageSource[barrageId]=source
        call WaveMortarSkills__WaveMortarBarrageAdd(barrageId)
        call SaveInteger(Table__ht, (WaveMortarSkills__WaveMortarActiveBarrageByUnit), (hid), ( barrageId)) // INLINED!!
        call IssueImmediateOrder(source, "stop")
        call SetUnitAnimation(source, "attack")
        call PauseUnit(source, true)
        call WaveMortarSkills__WaveMortarEnsureBarrageTimer()
    endfunction

    function WaveMortarSkills__WaveMortarCleanupWaveDeath takes nothing returns nothing
        local unit deadUnit= (WaveEventUnit) // INLINED!!
        local integer hid
        local integer barrageId
        if deadUnit == null or GetUnitTypeId(deadUnit) == 0 then
            return
        endif
        if GetUnitTypeId(deadUnit) == WaveMortarSkills_WAVE_HMTM_UNIT_ID or GetUnitTypeId(deadUnit) == WaveMortarSkills_WAVE_HMTM_BOSS_UNIT_ID then
            set hid=GetHandleId(deadUnit)
            if hid != 0 and (HaveSavedInteger(Table__ht, (WaveMortarSkills__WaveMortarNextCastMs), (hid))) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (WaveMortarSkills__WaveMortarNextCastMs), (hid)) // INLINED!!
            endif
            if hid != 0 and (HaveSavedInteger(Table__ht, (WaveMortarSkills__WaveMortarActiveBarrageByUnit), (hid))) then // INLINED!!
                set barrageId=(LoadInteger(Table__ht, (WaveMortarSkills__WaveMortarActiveBarrageByUnit), (hid))) // INLINED!!
                call WaveMortarSkills__WaveMortarBarrageDestroy(barrageId)
            endif
        endif
    endfunction

    function WaveMortarSkillsTryExecute takes unit source,unit target,integer nowMs returns boolean
        local integer hid
        local integer nextMs
        local boolean isBoss= false
        if not WaveMortarSkills__WaveMortarUnitAlive(source) then
            return false
        endif
        if GetUnitTypeId(source) == WaveMortarSkills_WAVE_HMTM_BOSS_UNIT_ID then
            set isBoss=true
        elseif GetUnitTypeId(source) != WaveMortarSkills_WAVE_HMTM_UNIT_ID then
            return false
        endif
        if target == null or GetUnitTypeId(target) == 0 or not UnitAlive(target) or not IsUnitType(target, UNIT_TYPE_HERO) then
            return false
        endif
        if not WaveMortarSkills__WaveMortarTargetInCastRange(source , target) then
            return false
        endif

        set hid=GetHandleId(source)
        if hid == 0 then
            return false
        endif

        if isBoss and (HaveSavedInteger(Table__ht, (WaveMortarSkills__WaveMortarActiveBarrageByUnit), (hid))) then // INLINED!!
            return true
        endif

        if not (HaveSavedInteger(Table__ht, (WaveMortarSkills__WaveMortarNextCastMs), (hid))) then // INLINED!!
            if isBoss then
                call SaveInteger(Table__ht, (WaveMortarSkills__WaveMortarNextCastMs), (hid), ( nowMs + WaveMortarSkills__WaveMortarRandomMsRange(WaveMortarSkills_WAVE_HMTM_BOSS_INITIAL_DELAY_MIN , WaveMortarSkills_WAVE_HMTM_BOSS_INITIAL_DELAY_MAX))) // INLINED!!
            else
                call SaveInteger(Table__ht, (WaveMortarSkills__WaveMortarNextCastMs), (hid), ( nowMs + WaveMortarSkills__WaveMortarRandomMsRange(WaveMortarSkills_WAVE_HMTM_INITIAL_DELAY_MIN , WaveMortarSkills_WAVE_HMTM_INITIAL_DELAY_MAX))) // INLINED!!
            endif
            return false
        endif

        set nextMs=(LoadInteger(Table__ht, (WaveMortarSkills__WaveMortarNextCastMs), (hid))) // INLINED!!
        if nowMs < nextMs then
            return false
        endif

        if isBoss then
            call WaveMortarSkills__WaveMortarStartBossBarrage(source)
            call SaveInteger(Table__ht, (WaveMortarSkills__WaveMortarNextCastMs), (hid), ( nowMs + WaveMortarSkills__WaveMortarRandomMsRange(WaveMortarSkills_WAVE_HMTM_BOSS_COOLDOWN_MIN , WaveMortarSkills_WAVE_HMTM_BOSS_COOLDOWN_MAX))) // INLINED!!
            return true
        endif

        call IssueImmediateOrder(source, "stop")
        call SetUnitAnimation(source, "attack")
        call WaveMortarSkills__WaveMortarLaunchProjectile(source , GetUnitX(target) , GetUnitY(target) , WaveMortarSkills_WAVE_HMTM_IMPACT_DAMAGE , WaveMortarSkills_WAVE_HMTM_IMPACT_AOE)
        call SaveInteger(Table__ht, (WaveMortarSkills__WaveMortarNextCastMs), (hid), ( nowMs + WaveMortarSkills__WaveMortarSecToMs(WaveMortarSkills_WAVE_HMTM_COOLDOWN))) // INLINED!!
        return true
    endfunction

    function WaveMortarSkills__Init takes nothing returns nothing
        set WaveMortarSkills__WaveMortarNextCastMs=s__Table_create()
        set WaveMortarSkills__WaveMortarActiveBarrageByUnit=s__Table_create()
        set WaveMortarSkills__WaveMortarBarrageTimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(WaveMortarSkills__WaveMortarBarrageTimer , TIMER_DEBUG_TAG_UNIT_SKILLS)
        call RegisterWaveDeathEvent(function WaveMortarSkills__WaveMortarCleanupWaveDeath)
    endfunction


    function WaveGetPointCount takes integer w returns integer
        if w == 0 then
            return 0
        endif
        return s__Wave_pointCount[w]
    endfunction

    function WaveGetPointX takes integer w,integer pointIndex returns real
        if w == 0 then
            return 0.0
        endif
        if pointIndex < 0 or pointIndex >= s__Wave_pointCount[w] then
            return 0.0
        endif
        return s___Wave_pointX[s__Wave_pointX[w]+pointIndex]
    endfunction

    function WaveGetPointY takes integer w,integer pointIndex returns real
        if w == 0 then
            return 0.0
        endif
        if pointIndex < 0 or pointIndex >= s__Wave_pointCount[w] then
            return 0.0
        endif
        return s___Wave_pointY[s__Wave_pointY[w]+pointIndex]
    endfunction


//------------------------------------------------------------------------------
// WavePointGroups
//------------------------------------------------------------------------------
// Carga puntos desde rects + unidades marcador en el init del mapa.
//
// Flujo:
//   1) Registrar grupos por nombre/rect/rawcode.
//   2) Build una sola vez.
//   3) Aplicar el grupo a una instancia Wave con un solo call.
//
// Orden determinista:
//   - Y descendente
//   - X ascendente
//
// Dedupe:
//   - Dos puntos se consideran iguales si difieren <= 0.1 en X e Y.
//
// Notas:
//   - Las unidades marcador se eliminan del mapa luego de capturar su punto.
//   - Si no existen markers en el rect, el grupo queda vacío.
//------------------------------------------------------------------------------

    function WavePointGroups___WPG_GroupKey takes integer groupId,integer pointIndex returns integer
        return groupId * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + pointIndex
    endfunction

    function WavePointGroups___WPG_SafeHash takes string name returns integer
        local integer h= StringHash(name)
        if h < 0 then
            set h=- h
        endif
        return h
    endfunction

    function WavePointGroups___WPG_AbsReal takes real value returns real
        if value < 0. then
            return - value
        endif
        return value
    endfunction

    function WavePointGroups___WPG_GetGroupId takes string groupName returns integer
        local integer hash
        if ( groupName == null ) or ( groupName == "" ) then
            return 0
        endif
        if WavePointGroups___WPGGroupByHash == 0 then
            return 0
        endif
        set hash=WavePointGroups___WPG_SafeHash(groupName)
        if (HaveSavedInteger(Table__ht, (WavePointGroups___WPGGroupByHash), (hash))) then // INLINED!!
            return (LoadInteger(Table__ht, (WavePointGroups___WPGGroupByHash), (hash))) // INLINED!!
        endif
        return 0
    endfunction

    function WavePointGroups___WPG_IsSamePoint takes integer groupId,integer pointIndex,real x,real y returns boolean
        local integer key= ((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( pointIndex)) // INLINED!!
        return WavePointGroups___WPG_AbsReal(WavePointGroups___WPGGroupPointX[key] - x) <= WavePointGroups___WPG_POINT_EPSILON and WavePointGroups___WPG_AbsReal(WavePointGroups___WPGGroupPointY[key] - y) <= WavePointGroups___WPG_POINT_EPSILON
    endfunction

    function WavePointGroups___WPG_BoolToInt takes boolean b returns integer
        if b then
            return 1
        endif
        return 0
    endfunction

    function WavePointGroups___WPG_AddPointToGroup takes integer groupId,real x,real y returns boolean
        local integer count= WavePointGroups___WPGGroupPointCount[groupId]
        local integer i= 0
        local integer key

        if groupId <= 0 or groupId > WavePointGroups___WPG_MAX_GROUPS then
            return false
        endif

        loop
            exitwhen i >= count
            if WavePointGroups___WPG_IsSamePoint(groupId , i , x , y) then
                return false
            endif
            set i=i + 1
        endloop

        if count >= WavePointGroups___WPG_MAX_POINTS_PER_GROUP then
            if WavePointGroups___WPGDebugEnabled then
                call BJDebugMsg("[WavePointGroups] group '" + WavePointGroups___WPGGroupName[groupId] + "' full (" + I2S(WavePointGroups___WPG_MAX_POINTS_PER_GROUP) + ")")
            endif
            return false
        endif

        set key=((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( count)) // INLINED!!
        set WavePointGroups___WPGGroupPointX[key]=x
        set WavePointGroups___WPGGroupPointY[key]=y
        set WavePointGroups___WPGGroupPointCount[groupId]=count + 1
        return true
    endfunction

    function WavePointGroups___WPG_SortGroup takes integer groupId returns nothing
        local integer count= WavePointGroups___WPGGroupPointCount[groupId]
        local integer i= 1
        local integer j
        local integer keyI
        local integer keyJ
        local real x
        local real y

        loop
            exitwhen i >= count
            set keyI=((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( i)) // INLINED!!
            set x=WavePointGroups___WPGGroupPointX[keyI]
            set y=WavePointGroups___WPGGroupPointY[keyI]
            set j=i - 1
            loop
                exitwhen j < 0
                set keyJ=((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( j)) // INLINED!!
                if ( WavePointGroups___WPGGroupPointY[keyJ] > y ) or ( ( WavePointGroups___WPGGroupPointY[keyJ] == y ) and ( WavePointGroups___WPGGroupPointX[keyJ] <= x ) ) then
                    exitwhen true
                endif
                set WavePointGroups___WPGGroupPointX[((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( j + 1))]=WavePointGroups___WPGGroupPointX[keyJ] // INLINED!!
                set WavePointGroups___WPGGroupPointY[((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( j + 1))]=WavePointGroups___WPGGroupPointY[keyJ] // INLINED!!
                set j=j - 1
            endloop
            set WavePointGroups___WPGGroupPointX[((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( j + 1))]=x // INLINED!!
            set WavePointGroups___WPGGroupPointY[((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( j + 1))]=y // INLINED!!
            set i=i + 1
        endloop
    endfunction

    function WavePointGroups___WPG_ClearGroupPoints takes integer groupId returns nothing
        set WavePointGroups___WPGGroupPointCount[groupId]=0
        set WavePointGroups___WPGGroupBuilt[groupId]=false
    endfunction

    function WavePointGroups___WPG_BuildOneGroup takes integer groupId returns nothing
        local unit u
        local integer markerRawcode= WavePointGroups___WPGGroupMarkerRawcode[groupId]
        local rect area= WavePointGroups___WPGGroupRect[groupId]
        local integer beforeCount

        call WavePointGroups___WPG_ClearGroupPoints(groupId)

        if ( area == null ) or ( markerRawcode == 0 ) then
            if WavePointGroups___WPGDebugEnabled then
                call BJDebugMsg("[WavePointGroups] skip '" + WavePointGroups___WPGGroupName[groupId] + "' reason=no_rect_or_marker")
            endif
            return
        endif

        call GroupClear(WavePointGroups___WPGTempGroup)
        call GroupEnumUnitsInRect(WavePointGroups___WPGTempGroup, area, null)
        loop
            set u=FirstOfGroup(WavePointGroups___WPGTempGroup)
            exitwhen u == null
            call GroupRemoveUnit(WavePointGroups___WPGTempGroup, u)
            if GetUnitTypeId(u) == markerRawcode then
                call WavePointGroups___WPG_AddPointToGroup(groupId , GetUnitX(u) , GetUnitY(u))
                call RemoveUnit(u)
            endif
        endloop
        call WavePointGroups___WPG_SortGroup(groupId)
        set WavePointGroups___WPGGroupBuilt[groupId]=true

        if WavePointGroups___WPGDebugEnabled then
            set beforeCount=WavePointGroups___WPGGroupPointCount[groupId]
            call BJDebugMsg("[WavePointGroups] built '" + WavePointGroups___WPGGroupName[groupId] + "' points=" + I2S(beforeCount))
        endif

        set u=null
        set area=null
    endfunction

    function WavePointGroupsSetDebug takes boolean enabled returns nothing
        set WavePointGroups___WPGDebugEnabled=enabled
    endfunction

    function WavePointGroupsClear takes nothing returns nothing
        local integer i= 1
        local integer hash
        if WavePointGroups___WPGGroupByHash != 0 then
            call FlushChildHashtable(Table__ht, (WavePointGroups___WPGGroupByHash)) // INLINED!!
        endif
        set WavePointGroups___WPGGroupCount=0
        loop
            exitwhen i > WavePointGroups___WPG_MAX_GROUPS
            set WavePointGroups___WPGGroupName[i]=""
            set WavePointGroups___WPGGroupRect[i]=null
            set WavePointGroups___WPGGroupMarkerRawcode[i]=0
            set WavePointGroups___WPGGroupSortMode[i]=WavePointGroups___WPG_SORT_Y_DESC_X_ASC
            set WavePointGroups___WPGGroupRegistered[i]=false
            set WavePointGroups___WPGGroupBuilt[i]=false
            set WavePointGroups___WPGGroupPointCount[i]=0
            set i=i + 1
        endloop
    endfunction

    function WavePointGroupRegister takes string groupName,rect area,integer markerRawcode returns integer
        local integer hash
        local integer groupId
        if ( groupName == null ) or ( groupName == "" ) or ( area == null ) or ( markerRawcode == 0 ) then
            return 0
        endif
        set hash=WavePointGroups___WPG_SafeHash(groupName)
        if (HaveSavedInteger(Table__ht, (WavePointGroups___WPGGroupByHash), (hash))) then // INLINED!!
            set groupId=(LoadInteger(Table__ht, (WavePointGroups___WPGGroupByHash), (hash))) // INLINED!!
        else
            set groupId=WavePointGroups___WPGGroupCount + 1
            if groupId > WavePointGroups___WPG_MAX_GROUPS then
                if WavePointGroups___WPGDebugEnabled then
                    call BJDebugMsg("[WavePointGroups] cannot register '" + groupName + "' reason=max_groups")
                endif
                return 0
            endif
            set WavePointGroups___WPGGroupCount=groupId
            call SaveInteger(Table__ht, (WavePointGroups___WPGGroupByHash), (hash), ( groupId)) // INLINED!!
        endif

        set WavePointGroups___WPGGroupName[groupId]=groupName
        set WavePointGroups___WPGGroupRect[groupId]=area
        set WavePointGroups___WPGGroupMarkerRawcode[groupId]=markerRawcode
        set WavePointGroups___WPGGroupSortMode[groupId]=WavePointGroups___WPG_SORT_Y_DESC_X_ASC
        set WavePointGroups___WPGGroupRegistered[groupId]=true
        set WavePointGroups___WPGGroupBuilt[groupId]=false
        set WavePointGroups___WPGGroupPointCount[groupId]=0
        return groupId
    endfunction

    function WavePointGroupCount takes string groupName returns integer
        local integer groupId= WavePointGroups___WPG_GetGroupId(groupName)
        if groupId <= 0 then
            return 0
        endif
        return WavePointGroups___WPGGroupPointCount[groupId]
    endfunction

    function WavePointGroupGetPointX takes string groupName,integer pointIndex returns real
        local integer groupId= WavePointGroups___WPG_GetGroupId(groupName)
        if groupId <= 0 then
            return 0.0
        endif
        if pointIndex < 0 or pointIndex >= WavePointGroups___WPGGroupPointCount[groupId] then
            return 0.0
        endif
        return WavePointGroups___WPGGroupPointX[((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( pointIndex))] // INLINED!!
    endfunction

    function WavePointGroupGetPointY takes string groupName,integer pointIndex returns real
        local integer groupId= WavePointGroups___WPG_GetGroupId(groupName)
        if groupId <= 0 then
            return 0.0
        endif
        if pointIndex < 0 or pointIndex >= WavePointGroups___WPGGroupPointCount[groupId] then
            return 0.0
        endif
        return WavePointGroups___WPGGroupPointY[((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( pointIndex))] // INLINED!!
    endfunction

    function WavePointGroupsBuild takes nothing returns nothing
        local integer i= 1
        if WavePointGroups___WPGGroupByHash == 0 then
            return
        endif
        loop
            exitwhen i > WavePointGroups___WPGGroupCount
            if WavePointGroups___WPGGroupRegistered[i] then
                call WavePointGroups___WPG_BuildOneGroup(i)
            endif
            set i=i + 1
        endloop
    endfunction

    function WavePointGroupApplyToWave takes integer w,string groupName returns integer
        local integer groupId= WavePointGroups___WPG_GetGroupId(groupName)
        local integer i= 0
        local integer count
        if ( w == 0 ) or ( groupId <= 0 ) then
            return 0
        endif
        set count=WavePointGroups___WPGGroupPointCount[groupId]
        loop
            exitwhen i >= count
            call s__Wave_addPoint(w,WavePointGroups___WPGGroupPointX[((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( i))] , WavePointGroups___WPGGroupPointY[((groupId ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( i))]) // INLINED!!
            set i=i + 1
        endloop
        return count
    endfunction

    function WavePointGroupsDebugDump takes nothing returns nothing
        local integer i= 1
        local integer j
        local integer count
        if not WavePointGroups___WPGDebugEnabled then
            return
        endif
        loop
            exitwhen i > WavePointGroups___WPGGroupCount
            if WavePointGroups___WPGGroupRegistered[i] then
                set count=WavePointGroups___WPGGroupPointCount[i]
                call BJDebugMsg("[WavePointGroups] '" + WavePointGroups___WPGGroupName[i] + "' count=" + I2S(count) + " built=" + I2S(WavePointGroups___WPG_BoolToInt(WavePointGroups___WPGGroupBuilt[i])))
                set j=0
                loop
                    exitwhen j >= count
                    call BJDebugMsg("[WavePointGroups]   #" + I2S(j) + " x=" + R2S(WavePointGroups___WPGGroupPointX[((i ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( j))]) + " y=" + R2S(WavePointGroups___WPGGroupPointY[((i ) * WavePointGroups___WPG_MAX_POINTS_PER_GROUP + ( j))])) // INLINED!!
                    set j=j + 1
                endloop
            endif
            set i=i + 1
        endloop
    endfunction

    function WavePointGroups___Init takes nothing returns nothing
        set WavePointGroups___WPGGroupByHash=s__Table_create()
        set WavePointGroups___WPGTempGroup=CreateGroup()
        call WavePointGroupsClear()
    endfunction



    function WavePriestSkills___WavePriestMemberKey takes integer auraId,integer index returns integer
        return auraId * WavePriestSkills___WAVE_HMPR_MEMBER_STRIDE + index
    endfunction

    function WavePriestSkills___WavePriestSecToMs takes real sec returns integer
        if sec <= 0.0 then
            return 0
        endif
        return R2I(sec * 1000.0 + 0.5)
    endfunction

    function WavePriestSkills___WavePriestRandomMsRange takes real minSec,real maxSec returns integer
        local real lo= minSec
        local real hi= maxSec
        if hi < lo then
            set lo=maxSec
            set hi=minSec
        endif
        if hi <= 0.0 then
            return 0
        endif
        if lo < 0.0 then
            set lo=0.0
        endif
        return WavePriestSkills___WavePriestSecToMs(GetRandomReal(lo, hi))
    endfunction

    function WavePriestSkills___WavePriestUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WavePriestSkills___WavePriestTargetIsValid takes unit source,unit target returns boolean
        local integer sourceWave
        local integer targetWave
        local integer unitTypeId
        if not WavePriestSkills___WavePriestUnitAlive(source) or not WavePriestSkills___WavePriestUnitAlive(target) then
            return false
        endif
        if source == target then
            return false
        endif
        if not IsWaveManagedUnit(target) then
            return false
        endif
        if not IsUnitAlly(target, GetOwningPlayer(source)) then
            return false
        endif
        if IsUnitType(target, UNIT_TYPE_HERO) or IsUnitType(target, UNIT_TYPE_STRUCTURE) then
            return false
        endif
        set unitTypeId=GetUnitTypeId(target)
        if unitTypeId == WavePriestSkills___WAVE_ANY_BOSS_1 or unitTypeId == WavePriestSkills___WAVE_ANY_BOSS_2 or unitTypeId == WavePriestSkills___WAVE_ANY_BOSS_3 or unitTypeId == WavePriestSkills___WAVE_ANY_BOSS_4 or unitTypeId == WavePriestSkills___WAVE_ANY_BOSS_5 or unitTypeId == WavePriestSkills___WAVE_ANY_BOSS_6 or unitTypeId == WavePriestSkills___WAVE_ANY_BOSS_7 or unitTypeId == WavePriestSkills___WAVE_ANY_BOSS_8 or unitTypeId == WavePriestSkills___WAVE_ANY_BOSS_9 then
            return false
        endif
        if unitTypeId == WavePriestSkills_WAVE_HMPR_UNIT_ID or unitTypeId == WavePriestSkills_WAVE_HMPR_BOSS_UNIT_ID then
            return false
        endif
        set sourceWave=s__Wave__staticgetindex(source)
        set targetWave=s__Wave__staticgetindex(target)
        if sourceWave == 0 or targetWave == 0 or sourceWave != targetWave then
            return false
        endif
        return true
    endfunction

    function WavePriestSkills___WavePriestIsNormal takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WavePriestSkills_WAVE_HMPR_UNIT_ID
    endfunction

    function WavePriestSkills___WavePriestIsBoss takes unit source returns boolean
        return source != null and GetUnitTypeId(source) == WavePriestSkills_WAVE_HMPR_BOSS_UNIT_ID
    endfunction

    function WavePriestSkills___WavePriestAuraTypeName takes integer auraType returns string
        if auraType == WavePriestSkills___WAVE_HMPR_AURA_TYPE_BOSS then
            return "BOSS"
        endif
        return "NORMAL"
    endfunction

    function WavePriestSkills___WavePriestDebugMsg takes string msg returns nothing
        local string line
        if WavePriestSkills___WAVE_HMPR_DEBUG then
            set line="[WavePriest] " + msg
            call BJDebugMsg("|cffffcc00" + line + "|r")
            if (s__FileIO___LocalFileTest_success) then // INLINED!!
                if WavePriestSkills___WavePriestDebugFile == 0 then
                    set WavePriestSkills___WavePriestDebugFile=s__File_open(WavePriestSkills___WAVE_HMPR_DEBUG_FILE_FOLDER , "WavePriestDebug_" + I2S(WavePriestSkills___WavePriestDebugFileSegment) , s__FileIO___FlagG_WRITE)
                    set WavePriestSkills___WavePriestDebugFileLineCount=0
                endif
                call s__File_write(WavePriestSkills___WavePriestDebugFile,line)
                set WavePriestSkills___WavePriestDebugFileLineCount=WavePriestSkills___WavePriestDebugFileLineCount + 1
                if WavePriestSkills___WavePriestDebugFileLineCount >= WavePriestSkills___WAVE_HMPR_DEBUG_FILE_BATCH then
                    call s__File_close(WavePriestSkills___WavePriestDebugFile)
                    set WavePriestSkills___WavePriestDebugFile=0
                    set WavePriestSkills___WavePriestDebugFileSegment=WavePriestSkills___WavePriestDebugFileSegment + 1
                    set WavePriestSkills___WavePriestDebugFileLineCount=0
                endif
            endif
        endif
        set line=null
    endfunction

    function WavePriestSkills___WavePriestDebugTargetState takes string action,integer auraId,integer auraType,unit target returns nothing
        local integer hid= 0
        local integer normalOwner= 0
        local integer bossOwner= 0
        local integer normalLevel= 0
        local integer bossLevel= 0
        local string unitName= "null"
        if not WavePriestSkills___WAVE_HMPR_DEBUG then
            return
        endif
        if target != null and GetUnitTypeId(target) != 0 then
            set hid=GetHandleId(target)
            set unitName=GetUnitName(target)
            set normalLevel=GetUnitAbilityLevel(target, WavePriestSkills_WAVE_HMPR_NORMAL_PASSIVE_ID)
            set bossLevel=GetUnitAbilityLevel(target, WavePriestSkills_WAVE_HMPR_BOSS_PASSIVE_ID)
            if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestNormalOwnerAuraByUnit), (hid))) then // INLINED!!
                set normalOwner=(LoadInteger(Table__ht, (WavePriestSkills___WavePriestNormalOwnerAuraByUnit), (hid))) // INLINED!!
            endif
            if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestBossOwnerAuraByUnit), (hid))) then // INLINED!!
                set bossOwner=(LoadInteger(Table__ht, (WavePriestSkills___WavePriestBossOwnerAuraByUnit), (hid))) // INLINED!!
            endif
        endif
        call WavePriestSkills___WavePriestDebugMsg(action + " aura=" + I2S(auraId) + " type=" + WavePriestSkills___WavePriestAuraTypeName(auraType) + " target=" + unitName + " hid=" + I2S(hid) + " nOwner=" + I2S(normalOwner) + " bOwner=" + I2S(bossOwner) + " nLvl=" + I2S(normalLevel) + " bLvl=" + I2S(bossLevel))
    endfunction

    function WavePriestSkills___WavePriestTargetInAuraRange takes unit source,unit target,real radius returns boolean
        local real dx
        local real dy
        if not WavePriestSkills___WavePriestTargetIsValid(source , target) then
            return false
        endif
        set dx=GetUnitX(target) - GetUnitX(source)
        set dy=GetUnitY(target) - GetUnitY(source)
        return dx * dx + dy * dy <= radius * radius
    endfunction

    function WavePriestSkills___WavePriestRefreshScale takes unit target returns nothing
        local integer hid
        local real baseScale= 1.0
        local real nextScale
        if target == null or GetUnitTypeId(target) == 0 then
            return
        endif
        set hid=GetHandleId(target)
        if hid != 0 and (HaveSavedReal(Table__ht, (((WavePriestSkills___WavePriestBaseScaleByUnit))), (hid))) then // INLINED!!
            set baseScale=(LoadReal(Table__ht, (((WavePriestSkills___WavePriestBaseScaleByUnit))), (hid))) // INLINED!!
        endif
        set nextScale=baseScale
        if hid != 0 and (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestNormalOwnerAuraByUnit), (hid))) then // INLINED!!
            set nextScale=nextScale + WavePriestSkills_WAVE_HMPR_AURA_SCALE_BONUS
        endif
        if hid != 0 and (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestBossOwnerAuraByUnit), (hid))) then // INLINED!!
            set nextScale=nextScale + WavePriestSkills_WAVE_HMPR_BOSS_AURA_SCALE_BONUS
        endif
        if nextScale < 0.10 then
            set nextScale=0.10
        endif
        call SetUnitScale(target, nextScale, nextScale, nextScale)
        if hid != 0 and ( not (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestNormalOwnerAuraByUnit), (hid))) ) and ( not (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestBossOwnerAuraByUnit), (hid))) ) and (HaveSavedReal(Table__ht, (((WavePriestSkills___WavePriestBaseScaleByUnit))), (hid))) then // INLINED!!
            call RemoveSavedReal(Table__ht, (((WavePriestSkills___WavePriestBaseScaleByUnit))), (hid)) // INLINED!!
        endif
    endfunction

    function WavePriestSkills___WavePriestConfiguredBaseScale takes unit target returns real
        local integer unitTypeId
        if target == null or GetUnitTypeId(target) == 0 then
            return 1.0
        endif
        set unitTypeId=GetUnitTypeId(target)
        // Si algún tipo necesita escala base distinta, se declara acá.
        // En 1.27b no tenemos un native seguro para leer la escala real del object data.
        if unitTypeId == 0 then
            return 1.0
        endif
        return 1.0
    endfunction

    function WavePriestSkills___WavePriestApplyAuraEffect takes integer auraId,integer auraType,unit target returns boolean
        local integer hid
        if target == null or GetUnitTypeId(target) == 0 then
            return false
        endif
        set hid=GetHandleId(target)
        if hid == 0 then
            return false
        endif
        if not (HaveSavedReal(Table__ht, (((WavePriestSkills___WavePriestBaseScaleByUnit))), (hid))) then // INLINED!!
            call SaveReal(Table__ht, (((WavePriestSkills___WavePriestBaseScaleByUnit))), (hid), (( WavePriestSkills___WavePriestConfiguredBaseScale(target))*1.0)) // INLINED!!
        endif
        if auraType == WavePriestSkills___WAVE_HMPR_AURA_TYPE_BOSS then
            if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestBossOwnerAuraByUnit), (hid))) or GetUnitAbilityLevel(target, WavePriestSkills_WAVE_HMPR_BOSS_PASSIVE_ID) > 0 then // INLINED!!
                call WavePriestSkills___WavePriestDebugTargetState("APPLY_REJECT" , auraId , auraType , target)
                return false
            endif
            call SaveInteger(Table__ht, (WavePriestSkills___WavePriestBossOwnerAuraByUnit), (hid), ( auraId)) // INLINED!!
            if GetUnitAbilityLevel(target, WavePriestSkills_WAVE_HMPR_BOSS_PASSIVE_ID) <= 0 then
                call UnitAddAbility(target, WavePriestSkills_WAVE_HMPR_BOSS_PASSIVE_ID)
            endif
        else
            if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestNormalOwnerAuraByUnit), (hid))) or GetUnitAbilityLevel(target, WavePriestSkills_WAVE_HMPR_NORMAL_PASSIVE_ID) > 0 then // INLINED!!
                call WavePriestSkills___WavePriestDebugTargetState("APPLY_REJECT" , auraId , auraType , target)
                return false
            endif
            call SaveInteger(Table__ht, (WavePriestSkills___WavePriestNormalOwnerAuraByUnit), (hid), ( auraId)) // INLINED!!
            if GetUnitAbilityLevel(target, WavePriestSkills_WAVE_HMPR_NORMAL_PASSIVE_ID) <= 0 then
                call UnitAddAbility(target, WavePriestSkills_WAVE_HMPR_NORMAL_PASSIVE_ID)
            endif
        endif
        call WavePriestSkills___WavePriestRefreshScale(target)
        call WavePriestSkills___WavePriestDebugTargetState("APPLY_OK" , auraId , auraType , target)
        return true
    endfunction

    function WavePriestSkills___WavePriestRemoveAuraEffect takes integer auraId,integer auraType,unit target returns nothing
        local integer hid
        if target == null or GetUnitTypeId(target) == 0 then
            return
        endif
        set hid=GetHandleId(target)
        if hid == 0 then
            return
        endif
        call WavePriestSkills___WavePriestDebugTargetState("REMOVE_BEGIN" , auraId , auraType , target)
        if auraType == WavePriestSkills___WAVE_HMPR_AURA_TYPE_BOSS then
            if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestBossOwnerAuraByUnit), (hid))) and (LoadInteger(Table__ht, (WavePriestSkills___WavePriestBossOwnerAuraByUnit), (hid))) == auraId then // INLINED!!
                call RemoveSavedInteger(Table__ht, (WavePriestSkills___WavePriestBossOwnerAuraByUnit), (hid)) // INLINED!!
                if GetUnitAbilityLevel(target, WavePriestSkills_WAVE_HMPR_BOSS_PASSIVE_ID) > 0 then
                    call UnitRemoveAbility(target, WavePriestSkills_WAVE_HMPR_BOSS_PASSIVE_ID)
                endif
            endif
        else
            if (HaveSavedInteger(Table__ht, (WavePriestSkills___WavePriestNormalOwnerAuraByUnit), (hid))) and (LoadInteger(Table__ht, (WavePriestSkills___WavePriestNormalOwnerAuraByUnit), (hid))) == auraId then // INLINED!!
                call RemoveSavedInteger(Table__ht, (WavePriestSkills___WavePriestNormalOwnerAuraByUnit), (hid)) // INLINED!!
                if GetUnitAbilityLevel(target, WavePriestSkills_WAVE_HMPR_NORMAL_PASSIVE_ID) > 0 then
                    call UnitRemoveAbility(target, WavePriestSkills_WAVE_HMPR_NORMAL_PASSIVE_ID)
                endif
            endif
        endif
        call WavePriestSkills___WavePriestRefreshScale(target)
        call WavePriestSkills___WavePriestDebugTargetState("REMOVE_END" , auraId , auraType , target)
    endfunction

    function WavePriestSkills___WavePriestVisualModelForType takes integer auraType returns string
        if auraType == WavePriestSkills___WAVE_HMPR_AURA_TYPE_BOSS then
