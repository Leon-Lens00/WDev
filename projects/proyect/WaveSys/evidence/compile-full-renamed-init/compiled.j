    function UnitTypeMissileConfig__Configure_hpea takes nothing returns nothing
        local integer unitType= 'hpea'
        local real speed= UnitTypeMissileConfig__DEFAULT_SPEED
        local real damage= UnitTypeMissileConfig__DEFAULT_DAMAGE
        local string missileModel= UnitTypeMissileConfig__DEFAULT_MISSILE_MODEL
        local string overlayModel= UnitTypeMissileConfig__DEFAULT_OVERLAY_MODEL
        local boolean useRapidFire= UnitTypeMissileConfig__DEFAULT_USE_RAPID_FIRE
        local real rapidFireDuration= UnitTypeMissileConfig__DEFAULT_RAPID_FIRE_DURATION
        local real rapidFireInterval= UnitTypeMissileConfig__DEFAULT_RAPID_FIRE_INTERVAL
        local string castAnimation= UnitTypeMissileConfig__DEFAULT_CAST_ANIMATION
        local real castAnimationDelay= UnitTypeMissileConfig__DEFAULT_CAST_ANIMATION_DELAY
        local real castAnimationTimeScale= UnitTypeMissileConfig__DEFAULT_CAST_ANIMATION_TIME_SCALE
        local string casterWaitFx= UnitTypeMissileConfig__DEFAULT_CASTER_WAIT_FX
        local string dummyModel= UnitTypeMissileConfig__DEFAULT_DUMMY_MODEL
        local string dummyImpactFx= UnitTypeMissileConfig__DEFAULT_DUMMY_IMPACT_FX
        local real dummyScale= UnitTypeMissileConfig__DEFAULT_DUMMY_SCALE
        local real dummyArea= UnitTypeMissileConfig__DEFAULT_DUMMY_AREA
        local real dummyDelay= UnitTypeMissileConfig__DEFAULT_DUMMY_DELAY
        local real missileArc= UnitTypeMissileConfig__DEFAULT_MISSILE_ARC
        local real missileStartZ= UnitTypeMissileConfig__DEFAULT_MISSILE_START_Z
        local real missileFlyHeight= UnitTypeMissileConfig__DEFAULT_MISSILE_FLY_HEIGHT
        local real missileCollision= UnitTypeMissileConfig__DEFAULT_MISSILE_COLLISION
        local real missileScale= UnitTypeMissileConfig__DEFAULT_MISSILE_SCALE
        local boolean impactOnPath= UnitTypeMissileConfig__DEFAULT_IMPACT_ON_PATH
        local boolean specialEnabled= UnitTypeMissileConfig__DEFAULT_SPECIAL_ENABLED
        local integer specialAfterNormalShots= UnitTypeMissileConfig__DEFAULT_SPECIAL_AFTER_NORMAL_SHOTS
        local string specialMissileModel= UnitTypeMissileConfig__DEFAULT_SPECIAL_MISSILE_MODEL
        local string specialOverlayModel= UnitTypeMissileConfig__DEFAULT_SPECIAL_OVERLAY_MODEL
        local real specialDamageMult= UnitTypeMissileConfig__DEFAULT_SPECIAL_DAMAGE_MULT
        local real specialAreaMult= UnitTypeMissileConfig__DEFAULT_SPECIAL_AREA_MULT
        local real specialSpeedMult= UnitTypeMissileConfig__DEFAULT_SPECIAL_SPEED_MULT
        local real specialMissileScaleMult= UnitTypeMissileConfig__DEFAULT_SPECIAL_MISSILE_SCALE_MULT
        local real specialDummyScaleMult= UnitTypeMissileConfig__DEFAULT_SPECIAL_DUMMY_SCALE_MULT
        local string soundCastStart= UnitTypeMissileConfig__DEFAULT_SOUND_CAST_START
        local string soundWaitStart= UnitTypeMissileConfig__DEFAULT_SOUND_WAIT_START
        local string soundWaitEnd= UnitTypeMissileConfig__DEFAULT_SOUND_WAIT_END
        local string soundImpact= UnitTypeMissileConfig__DEFAULT_SOUND_IMPACT
        local string soundLastMissile= UnitTypeMissileConfig__DEFAULT_SOUND_LAST_MISSILE
        local string soundDummyClear= UnitTypeMissileConfig__DEFAULT_SOUND_DUMMY_CLEAR
        local string soundInterrupted= UnitTypeMissileConfig__DEFAULT_SOUND_INTERRUPTED
        local string soundChannelComplete= UnitTypeMissileConfig__DEFAULT_SOUND_CHANNEL_COMPLETE
        local real manaCost= UnitTypeMissileConfig__DEFAULT_MANA_COST
        // Overrides de hpea aqui.
        call SetUnitTypeMissileLoadout(unitType , speed , damage , missileModel , overlayModel)
        call SetUnitTypeUseRapidFire(unitType , useRapidFire , rapidFireDuration , rapidFireInterval)
        call SetUnitTypeCastAnimation(unitType , castAnimation , castAnimationDelay , castAnimationTimeScale)
        call SetUnitTypeCasterWaitFx(unitType , casterWaitFx)
        call SetUnitTypeDummyConfig(unitType , dummyModel , dummyScale , dummyDelay)
        call SetUnitTypeDummyImpactFx(unitType , dummyImpactFx)
        call SetUnitTypeDummyArea(unitType , dummyArea)
        call SetUnitTypeMissileConfig(unitType , missileArc , missileFlyHeight , missileCollision , missileScale)
        call SetUnitTypeImpactOnPath(unitType , impactOnPath)
        call SetUnitTypeSpecialMissile(unitType , specialEnabled , specialAfterNormalShots , specialMissileModel , specialOverlayModel)
        call SetUnitTypeSpecialMultipliers(unitType , specialDamageMult , specialAreaMult , specialSpeedMult , specialMissileScaleMult , specialDummyScaleMult)
        call SetUnitTypeMissileSounds(unitType , soundCastStart , soundWaitStart , soundWaitEnd , soundImpact , soundLastMissile , soundDummyClear , soundInterrupted , soundChannelComplete)
        call SetUnitTypeMissileStartZ(unitType , missileStartZ)
        call SetUnitTypeManaCost(unitType , manaCost)
    endfunction
