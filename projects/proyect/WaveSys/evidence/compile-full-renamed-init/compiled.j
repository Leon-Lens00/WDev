                set s__UIButton_customValue[(s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (slot)])]=slot // INLINED!!
                set s__UIButton_selectUnit[(s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (slot)])]=s__Client_unit[this] // INLINED!!
                set s__UIButton_onLeftClick[(s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (slot)])]=MenuClient_FuncLClickSlot // INLINED!!
                set s__UIButton_onRightClick[(s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (slot)])]=MenuClient_FuncRClickSlot // INLINED!!
            endif
        endfunction

        function s__Client_create takes unit u returns integer
            local integer this= s__Client__allocate()
            local real x1= s__Client_X + s__Client_SLOT_OFFSET_ROWLEFT_X
            local real y1= s__Client_Y - s__Client_SLOT_OFFSET_Y

            set s__Client_unit[this]=u
            set s__Client_player[this]=GetOwningPlayer(u)
            set s__Client_user[this]=(GetPlayerId((s__Client_player[this]))) // INLINED!!
            set s__Client_displayed[this]=false
            set s__Client_camera[this]=0

            if MenuClient__WaveStatusText[s__User_id[s__Client_user[this]]] == null or MenuClient__WaveStatusText[s__User_id[s__Client_user[this]]] == "" then
                set MenuClient__WaveStatusText[s__User_id[s__Client_user[this]]]="Wave"
            endif

            set s__Client_UnitsIndex[GetUnitUserData(u)]=this

            set s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (s__Client_SLOT_CAMERA_UP )]= ( s__UIButton_create(x1 + ( s__Client_SLOT_WIDTH * 0.75 ) - 1.00 , y1 - ( s__Client_SLOT_HEIGHT * 5 ) + 1.05 , s__Client_SLOT_WIDTH , s__Client_SLOT_HEIGHT , 10 , 'M00G')) // INLINED!!
            set s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (s__Client_SLOT_CAMERA_DOWN )]= ( s__UIButton_create(x1 + ( s__Client_SLOT_WIDTH * 0.75 ) - 1.10 , y1 - ( s__Client_SLOT_HEIGHT * 5 ) + 1.05 , s__Client_SLOT_WIDTH , s__Client_SLOT_HEIGHT , 10 , 'M00H')) // INLINED!!
            call s__Client_setupCameraButton(this,s__Client_SLOT_CAMERA_UP)
            call s__Client_setupCameraButton(this,s__Client_SLOT_CAMERA_DOWN)

            set s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WAVE_STATUS]= s__UIText_createEx((s__User_handle[(s__Client_user[this])]) , s__Client_X + s__Client_HERO_NAME_X , s__Client_HERO_NAME_Y + 0.22 , 1) // INLINED!!
            call s__Client_setWaveStatusTitle(this,MenuClient__WaveStatusText[s__User_id[s__Client_user[this]]])

            set s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_1]= s__UIPicture_create(s__Client_WEAPON_HUD_X , s__Client_WEAPON_HUD_Y , s__Client_WEAPON_HUD_ICON_SIZE , s__Client_WEAPON_HUD_ICON_SIZE * SCREEN_ASPECT_RATIO , 8 , WeaponProfileGetTexture(WEAPON_PROFILE_HANDGUN))
            set s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_2]= s__UIPicture_create(s__Client_WEAPON_HUD_X , s__Client_WEAPON_HUD_Y - s__Client_WEAPON_HUD_GAP_Y , s__Client_WEAPON_HUD_ICON_SIZE , s__Client_WEAPON_HUD_ICON_SIZE * SCREEN_ASPECT_RATIO , 8 , WeaponProfileGetTexture(WEAPON_PROFILE_HANDGUN))
            set s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_1]= s__UIText_createEx((s__User_handle[(s__Client_user[this])]) , s__Client_WEAPON_HUD_TEXT_X , s__Client_WEAPON_HUD_TEXT_Y , 1) // INLINED!!
            set s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_2]= s__UIText_createEx((s__User_handle[(s__Client_user[this])]) , s__Client_WEAPON_HUD_TEXT_X , s__Client_WEAPON_HUD_TEXT_Y - s__Client_WEAPON_HUD_TEXT_GAP_Y , 1) // INLINED!!
            set MenuClient__WeaponHudLastVersion[s__User_id[s__Client_user[this]]]=- 1
            call s__Client_refreshWeaponHud(this)

            return this
        endfunction

        function s__Client_destroy takes integer this returns nothing
            local integer i= 0
            call sc__Client_show(this,false , s__Client_camera[this])
            loop
                exitwhen i == s__Client_MAX_SLOTS
                if (s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (i)]) != 0 then // INLINED!!
                    call s__UIButton_destroy((s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (i)])) // INLINED!!
                    set s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (i )]= ( 0) // INLINED!!
                endif
                if s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + i] != 0 then
                    call s__UIPicture_destroy(s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + i])
                    set s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + i]= 0
                endif
                if s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + i] != 0 then
                    call s__UIText_destroy(s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + i])
                    set s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + i]= 0
                endif
                set i=i + 1
            endloop
            set s__Client_UnitsIndex[GetUnitUserData(s__Client_unit[this])]=0
            call s__Client_deallocate(this)
        endfunction

        function s__Client_onDisplay takes nothing returns nothing
            local integer user= (s__User_LocalId)
            local integer equipment= (s__Client_UnitsIndex[GetUnitUserData((s__Client_PlayerCurrentUnit[s__User_id[user]]))]) // INLINED!!
            local real x
            local real y
            local real z

            if equipment == 0 or not s__Client_displayed[equipment] or s__User_Local != s__User_handle[user] then
                return
            endif
            if s__Client_unit[equipment] == null or GetUnitTypeId(s__Client_unit[equipment]) == 0 then
                return
            endif

            set x=GetUnitX(s__Client_unit[equipment])
            set y=GetUnitY(s__Client_unit[equipment])
            call MenuClient__EnsureMenuCameraSettings(s__User_id[user])
            if MenuClient__PlayerMenuFogAppliedHeight[s__User_id[user]] != MenuClient__PlayerMenuCameraHeight[s__User_id[user]] then
                call MenuClient__ApplyMenuCameraFog(s__User_handle[user] , MenuClient__PlayerMenuCameraHeight[s__User_id[user]])
                set MenuClient__PlayerMenuFogAppliedHeight[s__User_id[user]]=MenuClient__PlayerMenuCameraHeight[s__User_id[user]]
            endif
            set z=GetTerrainZ(x , y) + MenuClient__PlayerMenuCameraHeight[s__User_id[user]] + GetUnitDefaultFlyHeight(s__Client_unit[equipment])
            call s__Camera_setPosition(s__Client_camera[equipment],x , y - MenuClient__PlayerMenuCameraOffset[s__User_id[user]] , z)
            call s__Client_refreshWeaponHud(equipment)

            if s__Camera_applyCameraForPlayer(s__Client_camera[equipment],s__User_handle[user] , false) then
                call s__Interface_updateAll(true , true , true)
            endif
        endfunction

        function s__Client_applyVisualState takes integer this returns nothing
            if (s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (s__Client_SLOT_CAMERA_UP)]) != 0 then // INLINED!!
                call s__UIButton_showPlayer((s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (s__Client_SLOT_CAMERA_UP)]),s__User_handle[s__Client_user[this]] , s__Client_displayed[this] , s__Client_camera[this]) // INLINED!!
            endif
            if (s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (s__Client_SLOT_CAMERA_DOWN)]) != 0 then // INLINED!!
                call s__UIButton_showPlayer((s__s__Client_buttons[( s__User_id[s__Client_user[(this)]] * s__Client_MAX_SLOTS ) + (s__Client_SLOT_CAMERA_DOWN)]),s__User_handle[s__Client_user[this]] , s__Client_displayed[this] , s__Client_camera[this]) // INLINED!!
            endif
            if s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WAVE_STATUS] != 0 then
                call SetTextTagText(s__UIText_text[s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WAVE_STATUS]], s__Client_getWaveStatusText(s__User_id[s__Client_user[this]]), 8 * 0.0027)
                call s__UIText_setPosition(s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WAVE_STATUS],s__Client_X + s__Client_HERO_NAME_X , s__Client_HERO_NAME_Y + 0.22)
                call s__UIText_show(s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WAVE_STATUS],s__Client_displayed[this] , s__Client_camera[this])
            endif
            call s__Client_refreshWeaponHud(this)
            if s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_1] != 0 then
                call s__UIPicture_setPosition(s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_1],s__Client_WEAPON_HUD_X , s__Client_WEAPON_HUD_Y)
                call s__UIPicture_showPlayer(s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_1],s__User_handle[s__Client_user[this]] , s__Client_displayed[this] , s__Client_camera[this])
            endif
            if s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_2] != 0 then
                call s__UIPicture_setPosition(s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_2],s__Client_WEAPON_HUD_X , s__Client_WEAPON_HUD_Y - s__Client_WEAPON_HUD_GAP_Y)
                call s__UIPicture_showPlayer(s__s__Client_pictures[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_PICTURE_WEAPON_SLOT_2],s__User_handle[s__Client_user[this]] , s__Client_displayed[this] , s__Client_camera[this])
            endif
            if s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_1] != 0 then
                call s__UIText_setPosition(s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_1],s__Client_WEAPON_HUD_TEXT_X , s__Client_WEAPON_HUD_TEXT_Y)
                call s__UIText_show(s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_1],s__Client_displayed[this] , s__Client_camera[this])
            endif
            if s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_2] != 0 then
                call s__UIText_setPosition(s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_2],s__Client_WEAPON_HUD_TEXT_X , s__Client_WEAPON_HUD_TEXT_Y - s__Client_WEAPON_HUD_TEXT_GAP_Y)
                call s__UIText_show(s__s__Client_title[( s__User_id[s__Client_user[this]] * s__Client_MAX_SLOTS ) + s__Client_TEXT_WEAPON_SLOT_2],s__Client_displayed[this] , s__Client_camera[this])
            endif
        endfunction

        function s__Client_show takes integer this,boolean flag,integer cam returns nothing
            local integer current= 0
            local boolean wasDisplayed= s__Client_displayed[this]

            set s__Client_camera[this]=cam

            if flag then
                if not wasDisplayed then
                    set s__Client_DisplayCount=s__Client_DisplayCount + 1
                    if s__Client_DisplayCount >= 1 then
                        call PauseTimer(s__Client_UpdateTimer)
                        call TimerStart(s__Client_UpdateTimer, 0.01, true, function s__Client_onDisplay)
                    endif
                endif

                if s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]] != null then
                    set current=(s__Client_UnitsIndex[GetUnitUserData((s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]]))]) // INLINED!!
                endif
                if s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]] != null and s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]] != s__Client_unit[this] and current != 0 and current != this then
                    call s__Client_show(current,false , s__Client_camera[this])
                endif
                set s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]]=s__Client_unit[this]
            elseif wasDisplayed then
                if s__Client_DisplayCount > 0 then
                    set s__Client_DisplayCount=s__Client_DisplayCount - 1
                endif
                if s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]] == s__Client_unit[this] then
                    set s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]]=null
                endif
                if s__Client_DisplayCount == 0 then
                    call PauseTimer(s__Client_UpdateTimer)
                else
                    call PauseTimer(s__Client_UpdateTimer)
                    call TimerStart(s__Client_UpdateTimer, 0.03125, true, function s__Client_onDisplay)
                endif
                call MenuClient__ResetMenuCameraFog(s__Client_player[this])
                set MenuClient__PlayerMenuFogAppliedHeight[s__User_id[s__Client_user[this]]]=- 1.
                if s__User_Local == s__Client_player[this] then
                    call ResetToGameCamera(0)
                endif
            endif

            set s__Client_displayed[this]=flag
            call s__Client_applyVisualState(this)
        endfunction

        function s__Client_onInit takes nothing returns nothing
            set s__Client_UpdateTimer=CreateTimer()
            set s__Client_Initialized=true
        endfunction

    function MenuClientRefreshEnemyPreviewForActivePlayers takes nothing returns nothing
        // Compatibilidad temporal: RestTime ya no debe pedir previews al MenuClient minimal.
    endfunction

    function MenuClientClearEnemyPreviewForActivePlayers takes nothing returns nothing
        // Compatibilidad temporal: no hay previews/modelos que limpiar.
    endfunction

    function MenuClient__ExecuteCameraButton takes integer client,integer pid,integer slot returns nothing
        if slot == s__Client_SLOT_CAMERA_UP then
            call MenuClient__StepMenuCameraHeight(pid , (500.)) // INLINED!!
        elseif slot == s__Client_SLOT_CAMERA_DOWN then
            call MenuClient__StepMenuCameraHeight(pid , - (500.)) // INLINED!!
        endif

        call s__Client_setWaveStatusTitle(client,MenuClient__WaveStatusText[pid])
        call s__Client_show(client,true , s__Client_camera[client])
    endfunction

    function MenuClient__LeftClickCameraButton takes nothing returns boolean
        local integer but= (UserInterface___ClickedButton) // INLINED!!
        local player p= (UserInterface___ClickingPlayer) // INLINED!!
        local integer pid= GetPlayerId(p)
        local integer client= (s__Client_UnitsIndex[GetUnitUserData((s__Client_PlayerCurrentUnit[pid]))]) // INLINED!!

        if client != 0 and p == s__User_handle[s__Client_user[client]] and s__User_Local == p then
            call SelectUnit(s__Client_unit[client], true)
        endif

        set p=null
        return false
    endfunction

    function MenuClient__RightClickCameraButton takes nothing returns boolean
        local integer but= (UserInterface___ClickedButton) // INLINED!!
        local player p= (UserInterface___ClickingPlayer) // INLINED!!
        local integer pid= GetPlayerId(p)
        local integer client= (s__Client_UnitsIndex[GetUnitUserData((s__Client_PlayerCurrentUnit[pid]))]) // INLINED!!
        local integer slot= 0

        if but != 0 then
            set slot=s__UIButton_customValue[but]
        endif
        if client == 0 or p != s__User_handle[s__Client_user[client]] then
            set p=null
            return false
        endif

        if MenuClient_PlayerLastButton[pid] == but and MenuClient_PlayerLastSlot[pid] == slot + 1 then
            set MenuClient_PlayerLastButton[pid]=0
            set MenuClient_PlayerLastSlot[pid]=0
            call MenuClient__ExecuteCameraButton(client , pid , slot)
        else
            set MenuClient_PlayerLastButton[pid]=but
            set MenuClient_PlayerLastSlot[pid]=slot + 1
        endif

        if s__User_Local == p then
            call SelectUnit(s__Client_unit[client], true)
        endif

        set p=null
        return false
    endfunction

    function MenuClient__Init takes nothing returns nothing
        local integer user= s__User_first
        loop
            exitwhen user == s__User_NULL
            set MenuClient__PlayerMenuCameraHeight[s__User_id[user]]=(500.) // INLINED!!
            set MenuClient__PlayerMenuCameraOffset[s__User_id[user]]=(467.) // INLINED!!
            set MenuClient__PlayerMenuFogAppliedHeight[s__User_id[user]]=- 1.
            set MenuClient__WeaponHudLastVersion[s__User_id[user]]=- 1
            set MenuClient__WaveStatusText[s__User_id[user]]="Wave"
            set MenuClient_PlayerLastSlot[s__User_id[user]]=0
            set MenuClient_PlayerLastButton[s__User_id[user]]=0
            set user=s__User_next[user]
        endloop
        set MenuClient_FuncLClickSlot=Filter(function MenuClient__LeftClickCameraButton)
        set MenuClient_FuncRClickSlot=Filter(function MenuClient__RightClickCameraButton)
    endfunction




function PrisonerDropSystem___PrisonerDistanceSq takes real ax,real ay,real bx,real by returns real
    local real dx= ax - bx
    local real dy= ay - by
    return dx * dx + dy * dy
endfunction

function PrisonerDropSystem___PrisonerAnyActive takes nothing returns boolean
    local integer i= 0
    loop
        exitwhen i >= PrisonerDropSystem___PRISONER_CAP
        if PrisonerDropSystem___PrisonerUnit[i] != null then
            return true
        endif
        set i=i + 1
    endloop
    set i=0
    loop
        exitwhen i >= PrisonerDropSystem___PICKUP_CAP
        if PrisonerDropSystem___PickupUnit[i] != null then
            return true
        endif
        set i=i + 1
    endloop
    return false
endfunction

function PrisonerDropSystem___PrisonerClear takes integer i returns nothing
    if PrisonerDropSystem___PrisonerUnit[i] != null then
        call RemoveUnit(PrisonerDropSystem___PrisonerUnit[i])
    endif
    set PrisonerDropSystem___PrisonerUnit[i]=null
    set PrisonerDropSystem___PrisonerOwnerPid[i]=- 1
    set PrisonerDropSystem___PrisonerProfile[i]=WEAPON_PROFILE_NONE
    set PrisonerDropSystem___PrisonerState[i]=0
    set PrisonerDropSystem___PrisonerStateTime[i]=0.00
    set PrisonerDropSystem___PrisonerWanderTime[i]=0.00
    set PrisonerDropSystem___PrisonerLifeTime[i]=0.00
endfunction

function PrisonerDropSystem___PickupClear takes integer i,boolean killFirst returns nothing
    if PrisonerDropSystem___PickupUnit[i] != null then
        if killFirst then
            call KillUnit(PrisonerDropSystem___PickupUnit[i])
        endif
        call RemoveUnit(PrisonerDropSystem___PickupUnit[i])
    endif
    set PrisonerDropSystem___PickupUnit[i]=null
    set PrisonerDropSystem___PickupOwnerPid[i]=- 1
    set PrisonerDropSystem___PickupProfile[i]=WEAPON_PROFILE_NONE
    set PrisonerDropSystem___PickupLifeTime[i]=0.00
endfunction

function PrisonerDropSystem___PrisonerAlloc takes nothing returns integer
    local integer i= 0
    loop
        exitwhen i >= PrisonerDropSystem___PRISONER_CAP
        if PrisonerDropSystem___PrisonerUnit[i] == null then
            return i
        endif
        set i=i + 1
    endloop
    return - 1
endfunction

function PrisonerDropSystem___PickupAlloc takes nothing returns integer
    local integer i= 0
    loop
        exitwhen i >= PrisonerDropSystem___PICKUP_CAP
        if PrisonerDropSystem___PickupUnit[i] == null then
            return i
        endif
        set i=i + 1
    endloop
    return - 1
endfunction

function PrisonerDropSystem___PrisonerRandomProfile takes nothing returns integer
    return GetRandomInt(WEAPON_PROFILE_SHOTGUN, WEAPON_PROFILE_LAST)
endfunction

function PrisonerDropSystem___PickupCreate takes integer pid,integer profileId,real x,real y,real facing returns nothing
    local integer slot= PrisonerDropSystem___PickupAlloc()
    local integer unitTypeId= WeaponProfileGetPickupUnitType(profileId)
    if slot < 0 or unitTypeId == 0 then
        return
    endif
    set PrisonerDropSystem___PickupUnit[slot]=CreateUnit(Player(pid), unitTypeId, x, y, facing)
    if PrisonerDropSystem___PickupUnit[slot] == null then
        set PrisonerDropSystem___PickupOwnerPid[slot]=- 1
        set PrisonerDropSystem___PickupProfile[slot]=WEAPON_PROFILE_NONE
        return
    endif
    call UnitAddAbility(PrisonerDropSystem___PickupUnit[slot], 'Avul')
    call UnitAddAbility(PrisonerDropSystem___PickupUnit[slot], 'Aloc')
    set PrisonerDropSystem___PickupOwnerPid[slot]=pid
    set PrisonerDropSystem___PickupProfile[slot]=profileId
    set PrisonerDropSystem___PickupLifeTime[slot]=0.00
endfunction

function PrisonerDropSystem___PrisonerBeginRescue takes integer i,unit hero returns nothing
    local real dx= GetUnitX(hero) - GetUnitX(PrisonerDropSystem___PrisonerUnit[i])
    local real dy= GetUnitY(hero) - GetUnitY(PrisonerDropSystem___PrisonerUnit[i])
    call IssueImmediateOrder(PrisonerDropSystem___PrisonerUnit[i], "stop")
    call SetUnitFacing(PrisonerDropSystem___PrisonerUnit[i], Atan2(dy, dx) * bj_RADTODEG)
    call SetUnitAnimation(PrisonerDropSystem___PrisonerUnit[i], "attack")
    call PauseUnit(PrisonerDropSystem___PrisonerUnit[i], true)
    if PrisonerDropSystem___PrisonerRescueSound != null then
        call StartSound(PrisonerDropSystem___PrisonerRescueSound)
    endif
    set PrisonerDropSystem___PrisonerState[i]=1
    set PrisonerDropSystem___PrisonerStateTime[i]=0.00
endfunction

function PrisonerDropSystem___PrisonerDropWeapon takes integer i returns nothing
    local real facing= GetUnitFacing(PrisonerDropSystem___PrisonerUnit[i])
    local real angle= facing * bj_DEGTORAD
    local real x= GetUnitX(PrisonerDropSystem___PrisonerUnit[i]) + PrisonerDropSystem___PRISONER_DROP_OFFSET * Cos(angle)
    local real y= GetUnitY(PrisonerDropSystem___PrisonerUnit[i]) + PrisonerDropSystem___PRISONER_DROP_OFFSET * Sin(angle)
    call PrisonerDropSystem___PickupCreate(PrisonerDropSystem___PrisonerOwnerPid[i] , PrisonerDropSystem___PrisonerProfile[i] , x , y , facing)
    call PauseUnit(PrisonerDropSystem___PrisonerUnit[i], false)
    call SetUnitAnimation(PrisonerDropSystem___PrisonerUnit[i], "stand")
    call SetUnitFlyHeight(PrisonerDropSystem___PrisonerUnit[i], PrisonerDropSystem___PRISONER_ASCEND_TARGET, PrisonerDropSystem___PRISONER_ASCEND_SPEED)
    set PrisonerDropSystem___PrisonerState[i]=2
    set PrisonerDropSystem___PrisonerStateTime[i]=0.00
endfunction

function PrisonerDropSystem___PrisonerUpdateWander takes integer i returns nothing
    local real x
    local real y
    set PrisonerDropSystem___PrisonerWanderTime[i]=PrisonerDropSystem___PrisonerWanderTime[i] + PrisonerDropSystem___PRISONER_TICK
    if PrisonerDropSystem___PrisonerWanderTime[i] < PrisonerDropSystem___PRISONER_WANDER_INTERVAL then
        return
    endif
    set PrisonerDropSystem___PrisonerWanderTime[i]=0.00
    if GetRandomInt(0, 2) == 0 then
        call IssueImmediateOrder(PrisonerDropSystem___PrisonerUnit[i], "stop")
    else
        set x=GetUnitX(PrisonerDropSystem___PrisonerUnit[i]) + GetRandomReal(- PrisonerDropSystem___PRISONER_WANDER_RADIUS, PrisonerDropSystem___PRISONER_WANDER_RADIUS)
        set y=GetUnitY(PrisonerDropSystem___PrisonerUnit[i]) + GetRandomReal(- PrisonerDropSystem___PRISONER_WANDER_RADIUS, PrisonerDropSystem___PRISONER_WANDER_RADIUS)
        call IssuePointOrder(PrisonerDropSystem___PrisonerUnit[i], "move", x, y)
    endif
endfunction

function PrisonerDropSystem___PrisonerUpdateActive takes integer i returns nothing
    local unit hero= PlayerHero[PrisonerDropSystem___PrisonerOwnerPid[i]]
    local real px= GetUnitX(PrisonerDropSystem___PrisonerUnit[i])
    local real py= GetUnitY(PrisonerDropSystem___PrisonerUnit[i])
    if hero != null and GetUnitTypeId(hero) != 0 and UnitAlive(hero) then
        if PrisonerDropSystem___PrisonerDistanceSq(px , py , GetUnitX(hero) , GetUnitY(hero)) <= PrisonerDropSystem___PRISONER_RESCUE_RANGE * PrisonerDropSystem___PRISONER_RESCUE_RANGE then
            call PrisonerDropSystem___PrisonerBeginRescue(i , hero)
        else
            call PrisonerDropSystem___PrisonerUpdateWander(i)
        endif
    else
        call PrisonerDropSystem___PrisonerUpdateWander(i)
    endif
    set hero=null
endfunction

function PrisonerDropSystem___PrisonerUpdateRescueDelay takes integer i returns nothing
    set PrisonerDropSystem___PrisonerStateTime[i]=PrisonerDropSystem___PrisonerStateTime[i] + PrisonerDropSystem___PRISONER_TICK
    if PrisonerDropSystem___PrisonerStateTime[i] >= PrisonerDropSystem___PRISONER_RESCUE_DELAY then
        call PrisonerDropSystem___PrisonerDropWeapon(i)
    endif
endfunction

function PrisonerDropSystem___PrisonerUpdateAscend takes integer i returns nothing
    set PrisonerDropSystem___PrisonerStateTime[i]=PrisonerDropSystem___PrisonerStateTime[i] + PrisonerDropSystem___PRISONER_TICK
    if GetUnitFlyHeight(PrisonerDropSystem___PrisonerUnit[i]) >= PrisonerDropSystem___PRISONER_ASCEND_TARGET - 25.00 or PrisonerDropSystem___PrisonerStateTime[i] >= ( PrisonerDropSystem___PRISONER_ASCEND_TARGET / PrisonerDropSystem___PRISONER_ASCEND_SPEED ) + 1.00 then
        call PrisonerDropSystem___PrisonerClear(i)
    endif
endfunction

function PrisonerDropSystem___PickupUpdate takes integer i returns nothing
    local integer playerIndex= 0
    local integer u
    local unit hero
    loop
        exitwhen playerIndex >= s__User_AmountPlaying
        set u=(s__User_PlayingPlayer[(playerIndex)]) // INLINED!!
        set hero=PlayerHero[s__User_id[u]]
        if hero != null and GetUnitTypeId(hero) != 0 and UnitAlive(hero) then
            if PrisonerDropSystem___PrisonerDistanceSq(GetUnitX(PrisonerDropSystem___PickupUnit[i]) , GetUnitY(PrisonerDropSystem___PickupUnit[i]) , GetUnitX(hero) , GetUnitY(hero)) <= PrisonerDropSystem___PRISONER_PICKUP_RANGE * PrisonerDropSystem___PRISONER_PICKUP_RANGE then
                call WeaponInventoryGiveWeapon((s__User_handle[(u)]) , PrisonerDropSystem___PickupProfile[i] , WeaponProfileGetDefaultAmmo(PrisonerDropSystem___PickupProfile[i])) // INLINED!!
                call PrisonerDropSystem___PickupClear(i , true)
                set hero=null
                return
            endif
        endif
        set playerIndex=playerIndex + 1
    endloop
    set hero=null

    if PrisonerDropSystem___PickupOwnerPid[i] >= 0 and PrisonerDropSystem___PickupOwnerPid[i] < bj_MAX_PLAYER_SLOTS and not s__User_isPlaying[((PrisonerDropSystem___PickupOwnerPid[i]))] then // INLINED!!
        if PrisonerDropSystem___PickupUnit[i] != null then
            call PrisonerDropSystem___PickupClear(i , true)
            return
        endif
    endif

    set PrisonerDropSystem___PickupLifeTime[i]=PrisonerDropSystem___PickupLifeTime[i] + PrisonerDropSystem___PRISONER_TICK
    if PrisonerDropSystem___PickupLifeTime[i] >= PrisonerDropSystem___PICKUP_LIFETIME then
        call PrisonerDropSystem___PickupClear(i , false)
    endif
endfunction

function PrisonerDropSystem___PrisonerTick takes nothing returns nothing
    local integer i= 0
    loop
        exitwhen i >= PrisonerDropSystem___PRISONER_CAP
        if PrisonerDropSystem___PrisonerUnit[i] != null then
            set PrisonerDropSystem___PrisonerLifeTime[i]=PrisonerDropSystem___PrisonerLifeTime[i] + PrisonerDropSystem___PRISONER_TICK
            if PrisonerDropSystem___PrisonerLifeTime[i] >= PrisonerDropSystem___PRISONER_LIFETIME and PrisonerDropSystem___PrisonerState[i] == 0 then
                call PrisonerDropSystem___PrisonerClear(i)
            elseif PrisonerDropSystem___PrisonerState[i] == 0 then
                call PrisonerDropSystem___PrisonerUpdateActive(i)
            elseif PrisonerDropSystem___PrisonerState[i] == 1 then
                call PrisonerDropSystem___PrisonerUpdateRescueDelay(i)
            elseif PrisonerDropSystem___PrisonerState[i] == 2 then
                call PrisonerDropSystem___PrisonerUpdateAscend(i)
            endif
        endif
        set i=i + 1
    endloop
    set i=0
    loop
        exitwhen i >= PrisonerDropSystem___PICKUP_CAP
        if PrisonerDropSystem___PickupUnit[i] != null then
            call PrisonerDropSystem___PickupUpdate(i)
        endif
        set i=i + 1
    endloop
    if not PrisonerDropSystem___PrisonerAnyActive() and PrisonerDropSystem___PrisonerTicker != null then
        call PauseTimer(PrisonerDropSystem___PrisonerTicker)
    endif
endfunction

function PrisonerDropSystem___PrisonerEnsureTicker takes nothing returns nothing
    if PrisonerDropSystem___PrisonerTicker == null then
        set PrisonerDropSystem___PrisonerTicker=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(PrisonerDropSystem___PrisonerTicker , TIMER_DEBUG_TAG_OTHER)
    endif
    call TimerStart(PrisonerDropSystem___PrisonerTicker, PrisonerDropSystem___PRISONER_TICK, true, function PrisonerDropSystem___PrisonerTick)
endfunction

function PrisonerDropTrySpawnForPid takes unit killedEnemy,integer pid returns boolean
    local integer slot
    local integer profileId
    local real x
    local real y
    if killedEnemy == null or GetUnitTypeId(killedEnemy) == 0 then
        return false
    endif
    if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
        return false
    endif
    if PlayerHero[pid] == null or GetUnitTypeId(PlayerHero[pid]) == 0 then
        return false
    endif
    if GetRandomReal(0.00, 100.00) > PrisonerDropSystem___PRISONER_DROP_CHANCE then
        return false
    endif
    set slot=PrisonerDropSystem___PrisonerAlloc()
    if slot < 0 then
        return false
    endif
    set profileId=(GetRandomInt(WEAPON_PROFILE_SHOTGUN, WEAPON_PROFILE_LAST)) // INLINED!!
    set x=GetUnitX(killedEnemy)
    set y=GetUnitY(killedEnemy)
    set PrisonerDropSystem___PrisonerUnit[slot]=CreateUnit(Player(pid), WEAPON_PRISONER_UNIT_TYPE, x, y, GetRandomReal(0.00, 360.00))
    if PrisonerDropSystem___PrisonerUnit[slot] == null then
        call PrisonerDropSystem___PrisonerClear(slot)
        return false
    endif
    call UnitAddAbility(PrisonerDropSystem___PrisonerUnit[slot], 'Avul')
    call UnitAddAbility(PrisonerDropSystem___PrisonerUnit[slot], 'Aloc')
    call UnitAddAbility(PrisonerDropSystem___PrisonerUnit[slot], 'Amrf')
    call UnitRemoveAbility(PrisonerDropSystem___PrisonerUnit[slot], 'Amrf')
    set PrisonerDropSystem___PrisonerOwnerPid[slot]=pid
    set PrisonerDropSystem___PrisonerProfile[slot]=profileId
    set PrisonerDropSystem___PrisonerState[slot]=0
    set PrisonerDropSystem___PrisonerStateTime[slot]=0.00
    set PrisonerDropSystem___PrisonerWanderTime[slot]=PrisonerDropSystem___PRISONER_WANDER_INTERVAL
    set PrisonerDropSystem___PrisonerLifeTime[slot]=0.00
    call PrisonerDropSystem___PrisonerEnsureTicker()
    return true
endfunction

function PrisonerDropTrySpawn takes unit killedEnemy returns boolean
    return PrisonerDropTrySpawnForPid(killedEnemy , WaveGetDamageCreditOwnerPid(killedEnemy))
endfunction

function PrisonerDropSystem___Init takes nothing returns nothing
    local integer i= 0
    call Preload(PrisonerDropSystem___PRISONER_RESCUE_SOUND_PATH)
    set PrisonerDropSystem___PrisonerRescueSound=CreateSound(PrisonerDropSystem___PRISONER_RESCUE_SOUND_PATH, false, false, false, 12700, 12700, "")
    call SetSoundVolume(PrisonerDropSystem___PrisonerRescueSound, 127)
    loop
        exitwhen i >= PrisonerDropSystem___PRISONER_CAP
        set PrisonerDropSystem___PrisonerOwnerPid[i]=- 1
        set PrisonerDropSystem___PrisonerProfile[i]=WEAPON_PROFILE_NONE
        set i=i + 1
    endloop
    set i=0
    loop
        exitwhen i >= PrisonerDropSystem___PICKUP_CAP
        set PrisonerDropSystem___PickupOwnerPid[i]=- 1
        set PrisonerDropSystem___PickupProfile[i]=WEAPON_PROFILE_NONE
        set i=i + 1
    endloop
endfunction



// Compatibility layer for older systems that still call the previous
// weapon-selection API. The actual Metal Slug inventory lives in
// WeaponInventoryCore/WeaponInventorySystem.

function PlayerHasWeaponProfile takes player p,integer profileId returns boolean
    return profileId == WEAPON_PROFILE_HANDGUN or WeaponInventoryGetSlotProfile(p , WEAPON_INVENTORY_SLOT_1) == profileId or WeaponInventoryGetSlotProfile(p , WEAPON_INVENTORY_SLOT_2) == profileId
endfunction

function GetPlayerActiveWeaponProfile takes player p returns integer
    return WeaponInventoryGetActiveProfile(p)
endfunction

function SetPlayerActiveWeaponProfile takes player p,integer profileId returns boolean
    if not WeaponProfileIsWeapon(profileId) then
        return false
    endif
    if profileId != WEAPON_PROFILE_HANDGUN and not PlayerHasWeaponProfile(p , profileId) then
        call WeaponInventoryGiveWeapon(p , profileId , WeaponProfileGetDefaultAmmo(profileId))
    endif
    if WeaponInventoryGetSlotProfile(p , WEAPON_INVENTORY_SLOT_1) == profileId then
        return WeaponInventorySetActiveSlot(p , WEAPON_INVENTORY_SLOT_1)
    endif
    if WeaponInventoryGetSlotProfile(p , WEAPON_INVENTORY_SLOT_2) == profileId then
        return WeaponInventorySetActiveSlot(p , WEAPON_INVENTORY_SLOT_2)
    endif
    call WeaponInventorySetSlotWeapon((p ) , ( WeaponInventoryGetActiveSlot(p)) , WEAPON_PROFILE_HANDGUN , WEAPON_AMMO_INFINITE) // INLINED!!
    return WeaponInventorySetActiveSlot(p , WeaponInventoryGetActiveSlot(p))
endfunction

function UnlockPlayerWeaponProfile takes player p,integer profileId returns boolean
    if profileId == WEAPON_PROFILE_HANDGUN then
        call WeaponInventoryEnsurePlayer(p)
        return true
    endif
    return WeaponInventoryGiveWeapon(p , profileId , WeaponProfileGetDefaultAmmo(profileId))
endfunction

function RefreshPlayerWeaponSelectors takes player p returns nothing
    call WeaponInventoryEnsurePlayer(p)
endfunction

function EnsurePlayerDefaultWeaponProfile takes player p returns nothing
    call WeaponInventoryEnsurePlayer(p)
endfunction




    function HeroLives___HeroLivesIsTrackedPlayer takes integer pid returns boolean
        return pid >= 0 and pid < bj_MAX_PLAYER_SLOTS and s__User_isPlaying[((pid))] // INLINED!!
    endfunction

    function HeroLives___HeroLivesClearFx takes integer pid returns nothing
        if HeroLives___HeroLivesFx[pid] != null then
            call DestroyEffect(HeroLives___HeroLivesFx[pid])
            set HeroLives___HeroLivesFx[pid]=null
        endif
    endfunction

    function HeroLives___HeroLivesAbort takes integer pid returns nothing
        local timer t= HeroLives___HeroLivesTimer[pid]
        local unit hero= PlayerHero[pid]

        set HeroLives___HeroLivesTimer[pid]=null
        if t != null then
            call ReleaseTimer(t)
        endif

        if hero != null and GetUnitTypeId(hero) != 0 then
            call SetUnitInvulnerable(hero, false)
        endif

        call HeroLives___HeroLivesClearFx(pid)
        set HeroLives___HeroLivesState[pid]=0
        set HeroLives___HeroLivesDeathX[pid]=0.0
        set HeroLives___HeroLivesDeathY[pid]=0.0

        set hero=null
        set t=null
    endfunction

    function HeroLivesGetCurrent takes integer pid returns integer
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return 0
        endif
        return HeroLives___HeroLivesCurrent[pid]
    endfunction

    function HeroLivesGetRemaining takes integer pid returns integer
        return HeroLivesGetCurrent(pid)
    endfunction

    function HeroLivesSetCurrent takes integer pid,integer lives returns nothing
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return
        endif
        if lives < 0 then
            set lives=0
        endif
        set HeroLives___HeroLivesCurrent[pid]=lives
    endfunction

    function HeroLivesCancelPlayerState takes integer pid returns nothing
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return
        endif
        call HeroLives___HeroLivesAbort(pid)
    endfunction

    function HeroLivesInitHero takes integer pid,unit hero returns nothing
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return
        endif
        if hero == null or GetUnitTypeId(hero) == 0 then
            return
        endif
        call HeroLives___HeroLivesAbort(pid)
        set HeroLives___HeroLivesCurrent[pid]=HeroLives_HERO_LIVES_BASE
    endfunction

    function HeroLivesRefreshActivePlayers takes nothing returns nothing
        local integer i= 0
        local integer u

        loop
            exitwhen i >= s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            call HeroLives___HeroLivesAbort(s__User_id[u])
            set HeroLives___HeroLivesCurrent[s__User_id[u]]=HeroLives_HERO_LIVES_BASE
            set i=i + 1
        endloop
    endfunction

    function HeroLivesRefreshAll takes nothing returns nothing
        call HeroLivesRefreshActivePlayers()
    endfunction

    function HeroLives___HeroLivesEndInvulnerability takes nothing returns boolean
        local timer t= GetExpiredTimer()
        local integer pid= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local unit hero= PlayerHero[pid]

        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            call ReleaseTimer(t)
            set t=null
            return false
        endif

        if hero != null and GetUnitTypeId(hero) != 0 then
            call SetUnitInvulnerable(hero, false)
        endif
        call HeroLives___HeroLivesClearFx(pid)
        set HeroLives___HeroLivesState[pid]=0
        set HeroLives___HeroLivesTimer[pid]=null
        call ReleaseTimer(t)

        set hero=null
        set t=null
        return false
    endfunction

    function HeroLives___HeroLivesStartInvulnerability takes integer pid returns nothing
        local unit hero= PlayerHero[pid]
        local timer t= HeroLives___HeroLivesTimer[pid]

        if hero == null or GetUnitTypeId(hero) == 0 then
            set hero=null
            set t=null
            return
        endif

        call SetUnitInvulnerable(hero, true)
        call HeroLives___HeroLivesClearFx(pid)
        if HeroLives_HERO_LIVES_INVULN_FX != "" then
            set HeroLives___HeroLivesFx[pid]=AddSpecialEffectTarget(HeroLives_HERO_LIVES_INVULN_FX, hero, "origin")
        endif
        set HeroLives___HeroLivesState[pid]=2
        if t == null then
            set t=(NewTimerEx(0)) // INLINED!!
            call SetTimerDebugTag(t , TIMER_DEBUG_TAG_OTHER)
            set HeroLives___HeroLivesTimer[pid]=t
        endif
        call SaveInteger(TimerUtils___ht, 0, GetHandleId((t )), ( pid)) // INLINED!!
        call TimerStart(t, HeroLives_HERO_LIVES_INVULN_DURATION, false, function HeroLives___HeroLivesEndInvulnerability)

        set hero=null
        set t=null
    endfunction

    function HeroLives___HeroLivesReviveHero takes integer pid returns nothing
        local unit hero= PlayerHero[pid]
        local real x= HeroLives___HeroLivesDeathX[pid]
        local real y= HeroLives___HeroLivesDeathY[pid]
        local effect fx

        if hero == null or GetUnitTypeId(hero) == 0 then
            call HeroLives___HeroLivesAbort(pid)
            set hero=null
            return
        endif

        if not IsUnitType(hero, UNIT_TYPE_DEAD) then
            call HeroLives___HeroLivesAbort(pid)
            set hero=null
            return
        endif

        if ReviveHero(hero, x, y, true) then
            call SetUnitState(hero, UNIT_STATE_LIFE, GetUnitState(hero, UNIT_STATE_MAX_LIFE))
            call SetUnitState(hero, UNIT_STATE_MANA, GetUnitState(hero, UNIT_STATE_MAX_MANA))
            call WeaponInventoryEnsurePlayer((Player(pid))) // INLINED!!
            if HeroLives_HERO_LIVES_REVIVE_FX != "" then
                set fx=AddSpecialEffect(HeroLives_HERO_LIVES_REVIVE_FX, x, y)
                call DestroyEffect(fx)
                set fx=null
            endif
            call HeroLives___HeroLivesStartInvulnerability(pid)
        else
            call HeroLives___HeroLivesAbort(pid)
        endif

        set hero=null
    endfunction

    function HeroLives___HeroLivesOnReviveTimer takes nothing returns boolean
        local timer t= GetExpiredTimer()
        local integer pid= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local unit hero= PlayerHero[pid]

        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            call ReleaseTimer(t)
            set t=null
            return false
        endif

        if not HeroLives___HeroLivesIsTrackedPlayer(pid) then
            call HeroLives___HeroLivesAbort(pid)
            set hero=null
            set t=null
            return false
        endif

        if HeroLives___HeroLivesState[pid] == 1 then
            if hero == null or GetUnitTypeId(hero) == 0 then
                call HeroLives___HeroLivesAbort(pid)
            elseif not IsUnitType(hero, UNIT_TYPE_DEAD) then
                call HeroLives___HeroLivesAbort(pid)
            else
                call HeroLives___HeroLivesReviveHero(pid)
            endif
        else
            call HeroLives___HeroLivesAbort(pid)
        endif

        set hero=null
        set t=null
        return false
    endfunction

    function HeroLives___HeroLivesHandleDeath takes unit hero returns nothing
        local integer pid= GetPlayerId(GetOwningPlayer(hero))
        local integer u

        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            set hero=null
            return
        endif

        set u=((pid)) // INLINED!!
        if not s__User_isPlaying[u] then
            set hero=null
            return
        endif
        if PlayerHero[pid] != hero then
            set hero=null
            return
        endif

        call HeroLives___HeroLivesAbort(pid)

        if not isWavez then
            set hero=null
            return
        endif
        if HeroLives___HeroLivesCurrent[pid] <= 0 then
            set hero=null
            return
        endif

        set HeroLives___HeroLivesDeathX[pid]=GetUnitX(hero)
        set HeroLives___HeroLivesDeathY[pid]=GetUnitY(hero)
        set HeroLives___HeroLivesCurrent[pid]=HeroLives___HeroLivesCurrent[pid] - 1
        set HeroLives___HeroLivesState[pid]=1
        call WeaponInventoryResetActiveSlotOnDeath(Player(pid))

        if HeroLives___HeroLivesTimer[pid] == null then
            set HeroLives___HeroLivesTimer[pid]=(NewTimerEx(0)) // INLINED!!
            call SetTimerDebugTag(HeroLives___HeroLivesTimer[pid] , TIMER_DEBUG_TAG_OTHER)
        endif
        call SaveInteger(TimerUtils___ht, 0, GetHandleId((HeroLives___HeroLivesTimer[pid] )), ( pid)) // INLINED!!
        call TimerStart(HeroLives___HeroLivesTimer[pid], HeroLives_HERO_LIVES_REVIVE_DELAY, false, function HeroLives___HeroLivesOnReviveTimer)

        set hero=null
    endfunction

    function HeroLives___HeroLivesOnDeath takes nothing returns boolean
        local unit hero= GetDyingUnit()

        if hero == null or GetUnitTypeId(hero) == 0 then
            set hero=null
            return false
        endif
        if not IsUnitType(hero, UNIT_TYPE_HERO) then
            set hero=null
            return false
        endif

        call HeroLives___HeroLivesHandleDeath(hero)

        set hero=null
        return false
    endfunction

    function HeroLives___HeroLivesOnLeave takes nothing returns boolean
        local integer pid= GetPlayerId(GetTriggerPlayer())

        if pid >= 0 and pid < bj_MAX_PLAYER_SLOTS then
            call HeroLives___HeroLivesAbort(pid)
            set HeroLives___HeroLivesCurrent[pid]=HeroLives_HERO_LIVES_BASE
        endif

        return false
    endfunction

    function ReviveAndHealHeroes takes nothing returns nothing
        local integer i= 0
        local integer u
        local unit h

        loop
            exitwhen i >= s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            set h=PlayerHero[s__User_id[u]]

            if h != null then
                if IsUnitType(h, UNIT_TYPE_DEAD) then
                    call ReviveHero(h, GetUnitX(h), GetUnitY(h), true)
                endif

                call SetUnitState(h, UNIT_STATE_LIFE, GetUnitState(h, UNIT_STATE_MAX_LIFE))
                call SetUnitState(h, UNIT_STATE_MANA, GetUnitState(h, UNIT_STATE_MAX_MANA))
            endif

            set i=i + 1
        endloop
    endfunction

    function HeroLives___Init takes nothing returns nothing
        local integer i= 0

        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            set HeroLives___HeroLivesCurrent[i]=HeroLives_HERO_LIVES_BASE
            set HeroLives___HeroLivesState[i]=0
            set HeroLives___HeroLivesTimer[i]=null
            set HeroLives___HeroLivesFx[i]=null
            set HeroLives___HeroLivesDeathX[i]=0.0
            set HeroLives___HeroLivesDeathY[i]=0.0
            set i=i + 1
        endloop

        set HeroLives___HeroLivesDeathTrigger=CreateTrigger()
        set HeroLives___HeroLivesLeaveTrigger=CreateTrigger()

        set i=0
        loop
            exitwhen i >= bj_MAX_PLAYER_SLOTS
            call TriggerRegisterPlayerUnitEvent(HeroLives___HeroLivesDeathTrigger, Player(i), EVENT_PLAYER_UNIT_DEATH, null)
            call TriggerRegisterPlayerEvent(HeroLives___HeroLivesLeaveTrigger, Player(i), EVENT_PLAYER_LEAVE)
            set i=i + 1
        endloop

        call TriggerAddCondition(HeroLives___HeroLivesDeathTrigger, Condition(function HeroLives___HeroLivesOnDeath))
        call TriggerAddCondition(HeroLives___HeroLivesLeaveTrigger, Condition(function HeroLives___HeroLivesOnLeave))
    endfunction


    function RestTimeMenuApplyStatusForActivePlayers takes nothing returns nothing
        local integer i= 0
        local integer u
        local unit hero
        local integer client
        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            set hero=PlayerHero[s__User_id[u]]
            if hero != null and GetUnitTypeId(hero) != 0 then
                set client=(s__Client_UnitsIndex[GetUnitUserData((hero))]) // INLINED!!
                if client != 0 then
                    call s__Client_setWaveStatusTitle(client,RestStatusText)
                endif
            endif
            set i=i + 1
        endloop
        set hero=null
    endfunction

    function RestTimeMenuCloseTenderForActivePlayers takes nothing returns nothing
        // No-op: RestTime ya no abre/cierra paneles especiales del MenuClient.
    endfunction

    function RestTimeMenuShowClientsForActivePlayers takes nothing returns nothing
        // No-op: el MenuClient minimal se muestra desde Selection/Stage, no desde RestTime.
    endfunction



    function SelectionCreateClients takes nothing returns nothing
        local integer i= 0
        local integer u
        local unit hero
        local integer client

        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            set hero=PlayerHero[s__User_id[u]]

            if hero != null and GetUnitTypeId(hero) != 0 then
                if (s__Client_UnitsIndex[GetUnitUserData((hero))]) == 0 then // INLINED!!
                    set client=s__Client_create(hero)
                else
                    set client=(s__Client_UnitsIndex[GetUnitUserData((hero))]) // INLINED!!
                endif
            endif

            set i=i + 1
        endloop
    endfunction

    function SelectionShowClients takes nothing returns nothing
        local integer i= 0
        local integer u
        local unit hero
        local integer client

        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            set hero=PlayerHero[s__User_id[u]]

            if hero != null and GetUnitTypeId(hero) != 0 then
                set client=(s__Client_UnitsIndex[GetUnitUserData((hero))]) // INLINED!!

                if client != 0 and PlayerCamera[s__User_id[u]] != 0 then
                    call s__Client_show(client,true , PlayerCamera[s__User_id[u]])
                endif

                if s__User_Local == s__User_handle[u] then
                    call SelectUnit(hero, true)
                    call PanCameraToTimed(GetUnitX(hero), GetUnitY(hero), 0)
                endif
            endif

            set i=i + 1
        endloop
    endfunction



    function SelectionSetupHeroVisual takes integer heroId,player p returns nothing
        local string dummyFx1= ""
        local string dummyFx2= ""
        local real dummyScale= .1
        local real dummyOffset= 0.

        if heroId == 0 then
            set dummyScale=1.25
        elseif heroId == 1 then
            set dummyScale=1.25
        elseif heroId == 2 then
            set dummyScale=1.25
        elseif heroId == 3 then
            set dummyScale=1.25
        elseif heroId == 4 then
            set dummyScale=1.25
        elseif heroId == 5 then
            set dummyScale=1.25
        endif

        call SetPlayerLeapDummyFx(p , dummyFx1 , dummyFx2)
        call SetPlayerLeapDummyScale(p , dummyScale)
        call SetPlayerLeapDummyFlightOffset(p , dummyOffset)
        call SetPlayerOrbLevel(p , 1)
        call SetPlayerMissileHealOnHit(p , 0.00)
        call SetPlayerPointsOfMana(p , 1)
        call SetPlayerMissileDamageValue(p , WeaponProfileGetDamage(WEAPON_PROFILE_HANDGUN))
        call SetPlayerMissileUseRapidFire(p , true)
        call WeaponInventoryEnsurePlayer((p)) // INLINED!!
    endfunction



    function RestTimeSetBoardTitle takes string title returns nothing
        if SwlsMultiboard != null then
            call MultiboardSetTitleText(SwlsMultiboard, title)
            call MultiboardDisplay(SwlsMultiboard, true)
        endif
    endfunction

    function RestTimeSetStatusForActivePlayers takes string statusText returns nothing
        set RestStatusText=statusText
        call RestTimeMenuApplyStatusForActivePlayers()
    endfunction

    function RestTimeCloseTenderForActivePlayers takes nothing returns nothing
        local integer i= 0
        local integer u
        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            set s__isTender[s__User_id[u]]= false
            set i=i + 1
        endloop
        call RestTimeMenuCloseTenderForActivePlayers()
    endfunction

    function RestTimeShowClientsForActivePlayers takes nothing returns nothing
        call RestTimeMenuShowClientsForActivePlayers()
    endfunction




    function SelectionEnsureHeroCreated takes integer u,integer heroChoice returns nothing
        local player p= (s__User_handle[(u)]) // INLINED!!
        if PlayerHero[s__User_id[u]] != null and GetUnitTypeId(PlayerHero[s__User_id[u]]) != 0 then
            return
        endif

        set PlayerHero[s__User_id[u]]=CreateUnit(p, SelectionGetHeroUnitId(heroChoice), SelectionHeroSpawn__SELECTION_SPAWN_X, SelectionHeroSpawn__SELECTION_SPAWN_Y, 270.)
        call SILENCE_TESTUNIT_AMOV(PlayerHero[s__User_id[u]])
        call HeroLivesInitHero(s__User_id[u] , PlayerHero[s__User_id[u]])

        if PlayerCamera[s__User_id[u]] == 0 then
            set PlayerCamera[s__User_id[u]]=s__Camera_create()
        endif

        call SetPlayerAllianceStateBJ(Player(bj_PLAYER_NEUTRAL_EXTRA), s__User_handle[u], bj_ALLIANCE_ALLIED_VISION)
        call SetPlayerAllianceStateBJ(s__User_handle[u], Player(bj_PLAYER_NEUTRAL_EXTRA), bj_ALLIANCE_ALLIED_VISION)
    endfunction



    function RestTimeStopPhaseTimer takes nothing returns nothing
        if RestPhaseTimer != null then
            call PauseTimer(RestPhaseTimer)
        endif
    endfunction

    function RestTimeCountdown__RestTimeSetCountdownStatus takes nothing returns nothing
        if RestPhaseState == REST_PHASE_PURCHASE then
            call RestTimeSetStatusForActivePlayers("InterMission: " + I2S(RestPhaseRemaining))
            call RestTimeSetBoardTitle("|cFFFFFF99Descanso|r |cFFFFFFFFWave |r|cFFE6E6E6" + I2S(TargetWave) + "|r|cFFFF8C00/|r|cFFE6E6E610|r |cFFFFFFFF- Tienda: |r|cFF66FF99" + I2S(RestPhaseRemaining) + "|r")
        elseif RestPhaseState == REST_PHASE_INITIAL then
            call RestTimeSetStatusForActivePlayers("WaveIn: " + I2S(RestPhaseRemaining))
            call RestTimeSetBoardTitle("|cFFFFFF99Preparando|r |cFFFFFFFFWave |r|cFFE6E6E6" + I2S(TargetWave) + "|r|cFFFF8C00/|r|cFFE6E6E610|r |cFFFFFFFF- Inicia en: |r|cFF66CCFF" + I2S(RestPhaseRemaining) + "|r")
        endif
    endfunction

    function RestTimeLaunchCurrentWave takes nothing returns nothing
        call RestTimeCloseTenderForActivePlayers()
        set RestPhaseState=REST_PHASE_NONE
        set RestPhaseRemaining=0
        call RestTimeSetStatusForActivePlayers("Wave " + I2S(TargetWave))
        call RestTimeSetBoardTitle("|cFF66FF99Activa|r |cFFFFFFFFWave |r|cFFE6E6E6" + I2S(TargetWave) + "|r|cFFFF8C00/|r|cFFE6E6E610|r")
        call RestTimeStopPhaseTimer()
        if SwlsWaveStartTrigger != null then
            call TriggerExecute(SwlsWaveStartTrigger)
        elseif WaveTgg != null and WaveTgg != "" then
            call ExecuteFunc(WaveTgg)
        endif
    endfunction

    function RestTimeCountdown__RestTimePhaseTick takes nothing returns nothing
        set RestPhaseRemaining=RestPhaseRemaining - 1
        if RestPhaseRemaining <= 0 then
            call RestTimeLaunchCurrentWave()
            return
        endif
        call RestTimeCountdown__RestTimeSetCountdownStatus()
    endfunction

    function RestTimeBeginCountdown takes integer seconds,integer phaseState returns nothing
        if seconds < 1 then
            set seconds=1
        endif
        if RestPhaseTimer == null then
            set RestPhaseTimer=CreateTimer()
        endif
        set RestPhaseState=phaseState
        set RestPhaseRemaining=seconds
        if phaseState == REST_PHASE_PURCHASE then
            set RestSurvivalEndSequenceActive=false
            call RestTimeSetStatusForActivePlayers("TimeOfPurchase: " + I2S(RestPhaseRemaining))
            call RestTimeSetBoardTitle("|cFFFFFF99Descanso|r |cFFFFFFFFWave |r|cFFE6E6E6" + I2S(TargetWave) + "|r|cFFFF8C00/|r|cFFE6E6E610|r |cFFFFFFFF- Tienda: |r|cFF66FF99" + I2S(RestPhaseRemaining) + "|r")
        else
            call RestTimeCountdown__RestTimeSetCountdownStatus()
        endif
        call PauseTimer(RestPhaseTimer)
        call TimerStart(RestPhaseTimer, REST_PHASE_TICK_SEC, true, function RestTimeCountdown__RestTimePhaseTick)
    endfunction



    function RestTimeCompleteSurvivalEndSequence takes nothing returns nothing
        local integer i= 0
        local integer u
        set RestSurvivalEndSequenceActive=false
        call RestTimeStopSurvivalEndSound()
        call BJDebugMsg("|cff66ff66Mapa completado|r")
        call RestTimeSetBoardTitle("|cFF66FF66Mapa completado|r")
        call RestTimeSetStatusForActivePlayers("|cff66ff66Mapa completado|r")
        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            call CustomVictoryBJ((s__User_handle[(u)]), true, true) // INLINED!!
            set i=i + 1
        endloop
    endfunction

    function RestTimeSurvivalEnd__RestTimeOnSurvivalEndTimer takes nothing returns nothing
        if RestSurvivalEndTimer != null then
            call PauseTimer(RestSurvivalEndTimer)
            call DestroyTimer(RestSurvivalEndTimer)
            set RestSurvivalEndTimer=null
        endif
        call RestTimeCompleteSurvivalEndSequence()
    endfunction

    function RestTimeStartSurvivalEndSequence takes nothing returns nothing
        if RestSurvivalEndSequenceActive then
            return
        endif
        set RestSurvivalEndSequenceActive=true
        if RestPhaseTimer != null then
            call PauseTimer(RestPhaseTimer)
        endif
        call BJDebugMsg("|cff66ff66Superaste las 10 waves|r")
        call RestTimeSetBoardTitle("|cFF66FF66Superaste las 10 waves|r")
        call RestTimeSetStatusForActivePlayers("|cff66ff66Superaste las 10 waves|r")
        call RestTimeStartSurvivalEndSound()
        if RestSurvivalEndTimer == null then
            set RestSurvivalEndTimer=CreateTimer()
        endif
        call PauseTimer(RestSurvivalEndTimer)
        call TimerStart(RestSurvivalEndTimer, REST_SURVIVAL_END_DELAY, false, function RestTimeSurvivalEnd__RestTimeOnSurvivalEndTimer)
    endfunction



    function RestTimeEndFlow___RestTimeRewardActivePlayers takes nothing returns nothing
        local integer i= 0
        local integer u
        local integer currentGold
        loop
            exitwhen i == s__User_AmountPlaying
            set u=(s__User_PlayingPlayer[(i)]) // INLINED!!
            set currentGold=GetPlayerState((s__User_handle[(u)]), PLAYER_STATE_RESOURCE_GOLD) // INLINED!!
            call SetPlayerState((s__User_handle[(u)]), PLAYER_STATE_RESOURCE_GOLD, currentGold + REST_GOLD_REWARD) // INLINED!!
            set i=i + 1
        endloop
    endfunction

    function RestTimeEndFlow___RestTimeAnimateTender takes nothing returns nothing
        if GetTenderUnit() != null then
            call SetUnitAnimation(GetTenderUnit(), "Birth")
            call QueueUnitAnimationBJ(GetTenderUnit(), "stand")
        endif
    endfunction

    function RestTimeOnWaveFinished takes string nextWaveFunc returns nothing
        if SwlsMultiboard != null then
            call MultiboardSetTitleText(SwlsMultiboard, "|cFF66FF99Wave completada|r")
        endif
        set TargetWave=TargetWave + 1
        set WaveTgg=nextWaveFunc
        set isWavez=false

        call HeroLivesRefreshActivePlayers()
        call ReviveAndHealHeroes()

        if TargetWave >= REST_FINAL_WAVE_DONE then
            if SwlsSound != null then
                call StopSound(SwlsSound, true, false)
                set SwlsSound=null
            endif
            call RestTimeStartSurvivalEndSequence()
            return
        endif

        if SwlsSound != null then
            call SetSoundVolume(SwlsSound, R2I(I2R(SwlsSoundWaveVolume) * 0.50))
        endif
        call RestTimeEndFlow___RestTimeRewardActivePlayers()
        call RestTimeEndFlow___RestTimeAnimateTender()
        call RestTimeBeginCountdown(REST_PURCHASE_COUNTDOWN , REST_PHASE_PURCHASE)
    endfunction



    function CloseTenderForActivePlayers takes nothing returns nothing
        call RestTimeCloseTenderForActivePlayers()
    endfunction

    function StartInitialWaveCountdown takes nothing returns nothing
        call RestTimeBeginCountdown(REST_INITIAL_WAVE_COUNTDOWN , REST_PHASE_INITIAL)
    endfunction

    function StartPurchaseCountdown takes nothing returns nothing
        call RestTimeBeginCountdown(REST_PURCHASE_COUNTDOWN , REST_PHASE_PURCHASE)
    endfunction

    function endF takes string nextWaveFunc returns nothing
        call RestTimeOnWaveFinished(nextWaveFunc)
    endfunction



    function SelectionStartGameAfterAllSelected takes nothing returns nothing
        call SelectionCreateClients()
        call SelectionShowClients()
        call ShowInitialWaveMultiboard()
        set WaveTgg="Trig_w1_Actions"
        call RestTimeBeginCountdown(REST_INITIAL_WAVE_COUNTDOWN , REST_PHASE_INITIAL) // INLINED!!
    endfunction


    


    function WaveTest___WavePushEventContext takes integer w,unit u,unit killer,integer s,boolean isBoss,boolean isExternal returns nothing
        set WaveEventWaveId=w
        set WaveEventUnit=u
        set WaveEventKiller=killer
        set WaveEventSlotId=s
        set WaveEventIsBoss=isBoss
        set WaveEventIsExternal=isExternal
    endfunction

    function WaveTest___WaveClearEventContext takes nothing returns nothing
        set WaveEventWaveId=0
        set WaveEventUnit=null
        set WaveEventKiller=null
        set WaveEventSlotId=0
        set WaveEventIsBoss=false
        set WaveEventIsExternal=false
    endfunction

    function WaveDebugBoolToInt takes boolean b returns integer
        if b then
            return 1
        endif
        return 0
    endfunction

    function WaveDebugUnitSummary takes unit u returns string
        local integer hid
        local integer ownerPid
        if u == null then
            return "null"
        endif
        set hid=GetHandleId(u)
        set ownerPid=GetPlayerId(GetOwningPlayer(u))
        return GetUnitName(u) + " ut=" + I2S(GetUnitTypeId(u)) + " hid=" + I2S(hid) + " ownerPid=" + I2S(ownerPid)
    endfunction

    function WaveDebugLog takes string msg returns nothing
        if WAVE_DEBUG_ENABLED then
            call BJDebugMsg(WAVE_DEBUG_PREFIX + " " + msg)
        endif
    endfunction

    function WaveDeathDebugContextSummary takes nothing returns string
        return "w=" + I2S(WaveEventWaveId) + " unit=" + WaveDebugUnitSummary(WaveEventUnit) + " killer=" + WaveDebugUnitSummary(WaveEventKiller) + " slot=" + I2S(WaveEventSlotId) + " external=" + I2S(WaveDebugBoolToInt(WaveEventIsExternal)) + " boss=" + I2S(WaveDebugBoolToInt(WaveEventIsBoss))
    endfunction

    function WaveTest___WaveExecEvent takes trigger t returns nothing
        local integer waveId
        local integer slotId
        local unit eventUnit
        local unit eventKiller
        local boolean eventBoss
        local boolean eventExternal
        if t != null then
            if WAVE_DEBUG_ENABLED and t == WaveEvtDeath then
                set waveId=WaveEventWaveId
                set slotId=WaveEventSlotId
                set eventUnit=WaveEventUnit
                set eventKiller=WaveEventKiller
                set eventBoss=WaveEventIsBoss
                set eventExternal=WaveEventIsExternal
                call WaveDebugLog("WaveExecEvent enter WaveEvtDeath w=" + I2S(waveId) + " unit=" + WaveDebugUnitSummary(eventUnit) + " killer=" + WaveDebugUnitSummary(eventKiller) + " slot=" + I2S(slotId) + " external=" + I2S(WaveDebugBoolToInt(eventExternal)) + " boss=" + I2S(WaveDebugBoolToInt(eventBoss)))
            endif
            call TriggerExecute(t)
            if WAVE_DEBUG_ENABLED and t == WaveEvtDeath then
                call WaveDebugLog("WaveExecEvent exit WaveEvtDeath w=" + I2S(waveId) + " unit=" + WaveDebugUnitSummary(eventUnit) + " killer=" + WaveDebugUnitSummary(eventKiller) + " slot=" + I2S(slotId) + " external=" + I2S(WaveDebugBoolToInt(eventExternal)) + " boss=" + I2S(WaveDebugBoolToInt(eventBoss)))
            endif
            set eventUnit=null
            set eventKiller=null
        endif
    endfunction

    function WaveTest___WaveFireStart takes integer w returns nothing
        call WaveTest___WavePushEventContext(w , null , null , 0 , false , false)
        call WaveTest___WaveExecEvent(WaveEvtStart)
        call WaveTest___WaveClearEventContext()
    endfunction

