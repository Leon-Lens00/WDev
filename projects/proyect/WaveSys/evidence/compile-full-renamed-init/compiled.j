        //*  implement your Alloc module here.
    
        //*  Add or remove struct members you to needs.
        //*  Units.
        //* Effects.
        //* Timer.
        //*  Damage options.
        //*  Misc.
        
        //*  Conditionally destroy an handle on instance.destroy().
        
        function s__SpellIndex_destroy takes integer this returns nothing
//textmacro instance: SPELL_INDEX_CHECK_MEMBER("fx", "Effect")
            if s__SpellIndex_fx[this] != null then
                call DestroyEffect(s__SpellIndex_fx[this])
                set s__SpellIndex_fx[this]=null
            endif
//end of: SPELL_INDEX_CHECK_MEMBER("fx", "Effect")
//textmacro instance: SPELL_INDEX_CHECK_MEMBER("splat", "Ubersplat")
            if s__SpellIndex_splat[this] != null then
                call DestroyUbersplat(s__SpellIndex_splat[this])
                set s__SpellIndex_splat[this]=null
            endif
//end of: SPELL_INDEX_CHECK_MEMBER("splat", "Ubersplat")
//textmacro instance: SPELL_INDEX_CHECK_MEMBER("flash", "Lightning")
            if s__SpellIndex_flash[this] != null then
                call DestroyLightning(s__SpellIndex_flash[this])
                set s__SpellIndex_flash[this]=null
            endif
//end of: SPELL_INDEX_CHECK_MEMBER("flash", "Lightning")
            set s__SpellIndex_target[this]=null
            set s__SpellIndex_clock[this]=null
            set s__SpellIndex_source[this]=null
            call s__SpellIndex_deallocate(this)
        endfunction
    




    function WaveDamageCredit__WaveDamageCreditNow takes nothing returns real
        return TimerGetElapsed(WaveDamageCredit__WaveDamageCreditClock)
    endfunction

    function WaveDamageCredit__WaveDamageCreditResolveOwnerPid takes unit source returns integer
        local integer pid
        if source == null or GetUnitTypeId(source) == 0 then
            return - 1
        endif
        set pid=GetPlayerId(GetOwningPlayer(source))
        if pid < 0 or pid >= bj_MAX_PLAYER_SLOTS then
            return - 1
        endif
        return pid
    endfunction

    function WaveRecordDamageCredit takes unit source,unit target returns nothing
        local integer hid
        local integer pid
        if source == null or target == null then
            return
        endif
        if GetUnitTypeId(source) == 0 or GetUnitTypeId(target) == 0 then
            return
        endif
        set pid=WaveDamageCredit__WaveDamageCreditResolveOwnerPid(source)
        if pid < 0 then
            return
        endif
        set hid=GetHandleId(target)
        call SaveInteger(Table__ht, (WaveDamageCredit__WaveDamageCreditOwnerPidByTarget), (hid), ( pid)) // INLINED!!
        call SaveInteger(Table__ht, (WaveDamageCredit__WaveDamageCreditSourceHidByTarget), (hid), ( GetHandleId(source))) // INLINED!!
        call SaveReal(Table__ht, (((WaveDamageCredit__WaveDamageCreditTimeByTarget))), (hid), (( (TimerGetElapsed(WaveDamageCredit__WaveDamageCreditClock)))*1.0)) // INLINED!!
        call HealthBarsNotifyEnemyDamaged(source , target)
    endfunction

    function WaveClearDamageCredit takes unit target returns nothing
        local integer hid
        if target == null or GetUnitTypeId(target) == 0 then
            return
        endif
        set hid=GetHandleId(target)
        if (HaveSavedInteger(Table__ht, (WaveDamageCredit__WaveDamageCreditOwnerPidByTarget), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveDamageCredit__WaveDamageCreditOwnerPidByTarget), (hid)) // INLINED!!
        endif
        if (HaveSavedInteger(Table__ht, (WaveDamageCredit__WaveDamageCreditSourceHidByTarget), (hid))) then // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveDamageCredit__WaveDamageCreditSourceHidByTarget), (hid)) // INLINED!!
        endif
        if (HaveSavedReal(Table__ht, (((WaveDamageCredit__WaveDamageCreditTimeByTarget))), (hid))) then // INLINED!!
            call RemoveSavedReal(Table__ht, (((WaveDamageCredit__WaveDamageCreditTimeByTarget))), (hid)) // INLINED!!
        endif
    endfunction

    function WaveGetDamageCreditOwnerPid takes unit target returns integer
        local integer hid
        local real age
        if target == null or GetUnitTypeId(target) == 0 then
            return - 1
        endif
        set hid=GetHandleId(target)
        if not (HaveSavedInteger(Table__ht, (WaveDamageCredit__WaveDamageCreditOwnerPidByTarget), (hid))) then // INLINED!!
            return - 1
        endif
        set age=(TimerGetElapsed(WaveDamageCredit__WaveDamageCreditClock)) - (LoadReal(Table__ht, (((WaveDamageCredit__WaveDamageCreditTimeByTarget))), (hid))) // INLINED!!
        if age < 0.00 or age > WaveDamageCredit__WAVE_DAMAGE_CREDIT_TTL then
            call WaveClearDamageCredit(target)
            return - 1
        endif
        return (LoadInteger(Table__ht, (WaveDamageCredit__WaveDamageCreditOwnerPidByTarget), (hid))) // INLINED!!
    endfunction

    function WaveDamageCredit__WaveDamageCreditClockNoop takes nothing returns nothing
    endfunction

    function WaveDamageCredit__Init takes nothing returns nothing
        set WaveDamageCredit__WaveDamageCreditOwnerPidByTarget=s__Table_create()
        set WaveDamageCredit__WaveDamageCreditSourceHidByTarget=s__Table_create()
        set WaveDamageCredit__WaveDamageCreditTimeByTarget=s__Table_create()
        set WaveDamageCredit__WaveDamageCreditClock=CreateTimer()
        call TimerStart(WaveDamageCredit__WaveDamageCreditClock, 864000.00, false, function WaveDamageCredit__WaveDamageCreditClockNoop)
    endfunction


    function PlayerMissileLoadout__SlotOfPlayer takes player p returns integer
        local integer hid
        local integer slot
        if p == null then
            return 1
        endif
        set hid=GetHandleId(p)
        if (HaveSavedInteger(Table__ht, (PlayerMissileLoadout__byHandle), (hid))) then // INLINED!!
            return (LoadInteger(Table__ht, (PlayerMissileLoadout__byHandle), (hid))) // INLINED!!
        endif
        set slot=GetPlayerId(p) + 1
        if slot < 1 then
            set slot=1
        elseif slot > PlayerMissileLoadout__MAX_PLAYER_SLOTS then
            set slot=PlayerMissileLoadout__MAX_PLAYER_SLOTS
        endif
        call SaveInteger(Table__ht, (PlayerMissileLoadout__byHandle), (hid), ( slot)) // INLINED!!
        return slot
    endfunction

    function SetPlayerMissileLoadout takes player p,integer abilityRawcode,real speedBonus,real damageValue,integer instanceCount,string missileModelPath,string overlayModelPath returns nothing
        local integer slot= PlayerMissileLoadout__SlotOfPlayer(p)
        if instanceCount < 1 then
            set instanceCount=1
        endif
        set PlayerMissileLoadout__chosenAbility[slot]=abilityRawcode
        set PlayerMissileLoadout__chosenSpeedBonus[slot]=speedBonus
        set PlayerMissileLoadout__chosenDamage[slot]=damageValue
        set PlayerMissileLoadout__chosenInstances[slot]=instanceCount
        set PlayerMissileLoadout__chosenModelPath[slot]=missileModelPath
        set PlayerMissileLoadout__chosenOverlayPath[slot]=overlayModelPath
    endfunction

