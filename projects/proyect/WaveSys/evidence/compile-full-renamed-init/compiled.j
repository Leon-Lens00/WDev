        function s__DummyCaster_DummyCaster__N__onInit takes nothing returns nothing

                set s__UnitDex_Enabled=(false) // INLINED!!
                set DummyCaster__u=CreateUnit(DummyCaster__PLAYER_OWNER, UNITS_DUMMY_CASTER, 0, 0, 0)
