                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onFinish(this) then
                                call s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.

                        if s__Missile_allocated[this] and 0. > s__Missile_z[this] and s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onTerrain(this) then
                            call s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_missileTerminateP(this)
                        endif

                
                    // Runs every Missile_TIMER_TIMEOUT.

                        if s__Missile_allocated[this] and s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_onPeriod(this) then
                            call s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_missileTerminateP(this)
                        endif

                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__LoadoutMetalSlugSpecial___MetalSlugSpecialCore)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__LoadoutMetalSlugSpecial___MetalSlugSpecialCore )]=Condition(( function s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_missileIterateP)) // INLINED!!
        endfunction

    function LoadoutMetalSlugSpecial___LaunchSpecialMissile takes unit source,player owner,integer profileId,real angle,real targetX,real targetY returns nothing
        local real x= GetUnitX(source) + LoadoutMetalSlugSpecial___DEFAULT_COLLISION * Cos(angle)
        local real y= GetUnitY(source) + LoadoutMetalSlugSpecial___DEFAULT_COLLISION * Sin(angle)
        local real range= WeaponProfileGetRange(profileId)
        local real endZ= LoadoutMetalSlugSpecial___MISSILE_START_Z
        local integer missile
        local integer dex= s__SpellIndex__allocate()
        local real speed= WeaponProfileGetMissileSpeed(profileId)

        if profileId == WEAPON_PROFILE_GRENADE then
            set angle=Atan2(targetY - y, targetX - x)
            set range=SquareRoot(( targetX - x ) * ( targetX - x ) + ( targetY - y ) * ( targetY - y ))
            set range=LoadoutMetalSlugSpecial___MinReal(range , WeaponProfileGetRange(profileId))
            set endZ=LoadoutMetalSlugSpecial___MISSILE_GROUND_Z
        elseif profileId == WEAPON_PROFILE_DROP_SHOT then
            set endZ=LoadoutMetalSlugSpecial___MISSILE_GROUND_Z
        endif
        if range < 1.00 then
            set range=1.00
        endif
        set missile=s__Missile_create(x , y , LoadoutMetalSlugSpecial___MISSILE_START_Z , angle , range , endZ)

        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_user[dex]=owner
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=owner
        set s__Missile_data[missile]=dex
        call s__Missile__set_model(missile,WeaponProfileGetTierMissileModel(profileId , 1))
        call s__Missile__set_scale(missile,WeaponProfileGetMissileScale(profileId))
        set s__Missile_collision[missile]=LoadoutMetalSlugSpecial___DEFAULT_COLLISION
        if profileId == WEAPON_PROFILE_GRENADE then
            call s__Missile__set_arc(missile,LoadoutMetalSlugSpecial___GRENADE_ARC)
        endif
        set s__Missile_speed[(missile)]=((speed)*1.0) * Missile_TIMER_TIMEOUT // INLINED!!

        set LoadoutMetalSlugSpecial___missileProfile[missile]=profileId
        set LoadoutMetalSlugSpecial___missileDamage[missile]=WeaponProfileGetDamage(profileId)
        set LoadoutMetalSlugSpecial___missileArea[missile]=WeaponProfileGetArea(profileId)
        if profileId == WEAPON_PROFILE_DROP_SHOT then
            set LoadoutMetalSlugSpecial___missilePulseRemaining[missile]=LoadoutMetalSlugSpecial___DROP_BOUNCE_INTERVAL
        else
            set LoadoutMetalSlugSpecial___missilePulseRemaining[missile]=0.00
        endif
        set LoadoutMetalSlugSpecial___missileSpeed[missile]=speed
        set LoadoutMetalSlugSpecial___missileTravel[missile]=0.00
        set LoadoutMetalSlugSpecial___missileMaxRange[missile]=range
        set LoadoutMetalSlugSpecial___missileSegmentRange[missile]=range
        set LoadoutMetalSlugSpecial___missileSource[missile]=source
        set LoadoutMetalSlugSpecial___missileOwner[missile]=owner

        if profileId == WEAPON_PROFILE_DROP_SHOT then
            call LoadoutMetalSlugSpecial___ConfigureDropBounceSegment(missile)
        endif

        call s__LoadoutMetalSlugSpecial___MetalSlugSpecialCore_launch(missile)
    endfunction

    function LoadoutMetalSlugSpecial___CleanupCast takes integer dex returns nothing
        local integer id= 0
        if dex == 0 or s__SpellIndex_phase[dex] == - 999 then
            return
        endif
        set s__SpellIndex_phase[dex]=- 999
        if GetUnitTypeId(s__SpellIndex_source[dex]) != 0 then
            set id=GetHandleId(s__SpellIndex_source[dex])
            if (HaveSavedInteger(Table__ht, (LoadoutMetalSlugSpecial___active), (id))) and ( (LoadInteger(Table__ht, (LoadoutMetalSlugSpecial___active), (id))) == dex ) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (LoadoutMetalSlugSpecial___active), (id)) // INLINED!!
            endif
        endif
        if s__SpellIndex_clock[dex] != null then
            call ReleaseTimer(s__SpellIndex_clock[dex])
            set s__SpellIndex_clock[dex]=null
        endif
        set LoadoutMetalSlugSpecial___castProfile[dex]=WEAPON_PROFILE_NONE
        set LoadoutMetalSlugSpecial___castAngle[dex]=0.00
        set LoadoutMetalSlugSpecial___castTargetX[dex]=0.00
        set LoadoutMetalSlugSpecial___castTargetY[dex]=0.00
        call s__SpellIndex_destroy(dex)
    endfunction

    function LoadoutMetalSlugSpecial___FireCastShot takes integer dex returns nothing
        if GetUnitTypeId(s__SpellIndex_source[dex]) == 0 or not UnitAlive(s__SpellIndex_source[dex]) then
            return
        endif
        if not WeaponInventoryConsumeShotForProfile(s__SpellIndex_user[dex] , LoadoutMetalSlugSpecial___castProfile[dex]) then
            return
        endif
        call SetUnitAnimation(s__SpellIndex_source[dex], "attack")
        call LoadoutMetalSlugSpecial___LaunchSpecialMissile(s__SpellIndex_source[dex] , s__SpellIndex_user[dex] , LoadoutMetalSlugSpecial___castProfile[dex] , LoadoutMetalSlugSpecial___castAngle[dex] , LoadoutMetalSlugSpecial___castTargetX[dex] , LoadoutMetalSlugSpecial___castTargetY[dex])
    endfunction

    function LoadoutMetalSlugSpecial___OnCastTick takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local real step= LoadoutMetalSlugSpecial___GetSafeFireInterval(LoadoutMetalSlugSpecial___castProfile[dex])
        if s__SpellIndex_time[dex] <= 0. or GetUnitTypeId(s__SpellIndex_source[dex]) == 0 or not UnitAlive(s__SpellIndex_source[dex]) then
            call LoadoutMetalSlugSpecial___CleanupCast(dex)
            set t=null
            return
        endif
        call LoadoutMetalSlugSpecial___FireCastShot(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step
        if s__SpellIndex_time[dex] <= 0. then
            call LoadoutMetalSlugSpecial___CleanupCast(dex)
        else
            call TimerStart(s__SpellIndex_clock[dex], step, false, function LoadoutMetalSlugSpecial___OnCastTick)
        endif
        set t=null
    endfunction

    function LoadoutMetalSlugSpecialFireProfile takes unit source,player owner,integer profileId,real tx,real ty returns boolean
        local integer id= GetHandleId(source)
        local real duration= WeaponProfileGetCastDuration(profileId)
        local real step= LoadoutMetalSlugSpecial___GetSafeFireInterval(profileId)
        local integer dex
        local real x= GetUnitX(source)
        local real y= GetUnitY(source)

        if not WeaponProfileIsWeapon(profileId) then
            return false
        endif

        if (HaveSavedInteger(Table__ht, (LoadoutMetalSlugSpecial___active), (id))) then // INLINED!!
            set dex=(LoadInteger(Table__ht, (LoadoutMetalSlugSpecial___active), (id))) // INLINED!!
            if ( GetUnitTypeId(s__SpellIndex_source[dex]) != 0 ) and UnitAlive(s__SpellIndex_source[dex]) then
                set LoadoutMetalSlugSpecial___castProfile[dex]=profileId
                set LoadoutMetalSlugSpecial___castAngle[dex]=Atan2(ty - y, tx - x)
                set LoadoutMetalSlugSpecial___castTargetX[dex]=tx
                set LoadoutMetalSlugSpecial___castTargetY[dex]=ty
                set s__SpellIndex_time[dex]=duration
                call SetUnitAnimation(s__SpellIndex_source[dex], "attack")
                return true
            endif
            call LoadoutMetalSlugSpecial___CleanupCast(dex)
        endif

        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_user[dex]=owner
        set s__SpellIndex_time[dex]=duration
        set s__SpellIndex_phase[dex]=1
        set LoadoutMetalSlugSpecial___castProfile[dex]=profileId
        set LoadoutMetalSlugSpecial___castAngle[dex]=Atan2(ty - y, tx - x)
        set LoadoutMetalSlugSpecial___castTargetX[dex]=tx
        set LoadoutMetalSlugSpecial___castTargetY[dex]=ty
        set s__SpellIndex_clock[dex]=null
        call SaveInteger(Table__ht, (LoadoutMetalSlugSpecial___active), (id), ( dex)) // INLINED!!

        call LoadoutMetalSlugSpecial___FireCastShot(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step
        if s__SpellIndex_time[dex] > 0. then
            set s__SpellIndex_clock[dex]=NewTimerEx(dex)
            call SetTimerDebugTag(s__SpellIndex_clock[dex] , TIMER_DEBUG_TAG_LOADOUT_MISSILE)
            call TimerStart(s__SpellIndex_clock[dex], step, false, function LoadoutMetalSlugSpecial___OnCastTick)
        else
            call LoadoutMetalSlugSpecial___CleanupCast(dex)
        endif

        return true
    endfunction

    function LoadoutMetalSlugSpecial___OnEffect takes nothing returns nothing
        local unit source= GetTriggerUnit()
        local player owner= GetTriggerPlayer()
        call LoadoutMetalSlugSpecialFireProfile(source , owner , WeaponProfileFromFireAbility(GetSpellAbilityId()) , GetSpellTargetX() , GetSpellTargetY())
        set source=null
        set owner=null
    endfunction

    function LoadoutMetalSlugSpecial___Init takes nothing returns nothing
        set LoadoutMetalSlugSpecial___active=s__Table_create()
        call RegisterSpellEffectEvent(WeaponProfileGetFireAbility(WEAPON_PROFILE_SHOTGUN) , function LoadoutMetalSlugSpecial___OnEffect)
        call RegisterSpellEffectEvent(WeaponProfileGetFireAbility(WEAPON_PROFILE_ROCKET_LAUNCHER) , function LoadoutMetalSlugSpecial___OnEffect)
        call RegisterSpellEffectEvent(WeaponProfileGetFireAbility(WEAPON_PROFILE_GRENADE) , function LoadoutMetalSlugSpecial___OnEffect)
        call RegisterSpellEffectEvent(WeaponProfileGetFireAbility(WEAPON_PROFILE_DROP_SHOT) , function LoadoutMetalSlugSpecial___OnEffect)
        call RegisterSpellEffectEvent(WeaponProfileGetFireAbility(WEAPON_PROFILE_FLAME_SHOT) , function LoadoutMetalSlugSpecial___OnEffect)
        call RegisterSpellEffectEvent(WeaponProfileGetFireAbility(WEAPON_PROFILE_SUPER_GRENADE) , function LoadoutMetalSlugSpecial___OnEffect)
    endfunction




    function LoadoutThunderShot__GetSafeFireInterval takes nothing returns real
        local real duration= WeaponProfileGetCastDuration(WEAPON_PROFILE_THUNDER_SHOT)
        local integer count= WeaponProfileGetCastCount(WEAPON_PROFILE_THUNDER_SHOT)
        if duration <= 0. then
            return 0.03125
        endif
        if count <= 0 then
            return duration
        endif
        return duration / I2R(count)
    endfunction

    function LoadoutThunderShot__FilterUnits takes unit target,player owner returns boolean
        return UnitAlive(target) and IsUnitEnemy(target, owner) and not IsUnitType(target, UNIT_TYPE_STRUCTURE)
    endfunction

    function LoadoutThunderShot__DamageUnit takes unit source,unit target,real amount returns boolean
        if amount <= 0. then
            return false
        endif
        if ( GetUnitTypeId(source) == 0 ) or ( GetUnitTypeId(target) == 0 ) then
            return false
        endif
        call WaveRecordDamageCredit(source , target)
        return UnitDamageTarget(source, target, amount, false, false, LoadoutThunderShot__ATTACK_TYPE, LoadoutThunderShot__DAMAGE_TYPE, null)
    endfunction

    function LoadoutThunderShot__ShowThunderImpact takes unit target returns nothing
        local effect fx= AddSpecialEffectTarget(WeaponProfileGetMissileModel(WEAPON_PROFILE_THUNDER_SHOT), target, LoadoutThunderShot__IMPACT_ATTACH)
        call DestroyEffect(fx)
        set fx=null
    endfunction

    function LoadoutThunderShot__ConfigureThunderWaveSegment takes integer missile returns boolean
        local real remaining= LoadoutThunderShot__THUNDER_FREE_TRAVEL_RANGE - s__Missile_distance[missile]
        local real segment
        if remaining <= 0.00 then
            return false
        endif
        set segment=remaining
        if segment > LoadoutThunderShot__THUNDER_WAVE_SEGMENT_RANGE then
            set segment=LoadoutThunderShot__THUNDER_WAVE_SEGMENT_RANGE
        endif
        call s__MissilePosition_move(s__Missile_impact[missile],s__Missile_x[missile] + segment * Cos(s__Missile_angle[missile]) , s__Missile_y[missile] + segment * Sin(s__Missile_angle[missile]) , LoadoutThunderShot__MISSILE_START_Z)
        call s__Missile_bounce(missile)
        set s__Missile_target[missile]=null
        set s__Missile_turn[missile]=0.00
        call s__Missile__set_curve(missile,LoadoutThunderShot__THUNDER_WAVE_CURVE * I2R(LoadoutThunderShot__thunderWaveSign[missile]))
        set LoadoutThunderShot__thunderWaveSign[missile]=- LoadoutThunderShot__thunderWaveSign[missile]
        set s__Missile_recycle[missile]=false
        return true
    endfunction

    function LoadoutThunderShot__FindThunderTarget takes integer missile,unit excluded returns unit
        local unit u
        local unit chosen= null
        local real dx
        local real dy
        local real distSq
        local real bestSq= 0.00
        call GroupEnumUnitsInRange(s__SpellIndex_GLOBAL_GROUP, s__Missile_x[missile], s__Missile_y[missile], LoadoutThunderShot__THUNDER_SEARCH_RADIUS, null)
        loop
            set u=FirstOfGroup(s__SpellIndex_GLOBAL_GROUP)
            exitwhen u == null
            call GroupRemoveUnit(s__SpellIndex_GLOBAL_GROUP, u)
            if u != excluded and LoadoutThunderShot__FilterUnits(u , LoadoutThunderShot__thunderOwner[missile]) then
                set dx=GetUnitX(u) - s__Missile_x[missile]
                set dy=GetUnitY(u) - s__Missile_y[missile]
                set distSq=dx * dx + dy * dy
                if chosen == null or distSq < bestSq then
                    set chosen=u
                    set bestSq=distSq
                endif
            endif
        endloop
        set u=null
        return chosen
    endfunction

    function LoadoutThunderShot__AssignThunderTarget takes integer missile,unit target returns nothing
        if target != null and LoadoutThunderShot__FilterUnits(target , LoadoutThunderShot__thunderOwner[missile]) then
            set s__Missile_target[missile]=target
            set s__Missile_turn[missile]=LoadoutThunderShot__THUNDER_TURN_RATE
            call s__Missile__set_curve(missile,0.00)
            set s__Missile_recycle[missile]=false
        else
            set s__Missile_target[missile]=null
            set s__Missile_turn[missile]=0.00
            call LoadoutThunderShot__ConfigureThunderWaveSegment(missile)
        endif
    endfunction

    function LoadoutThunderShot__RefreshThunderTarget takes integer missile returns nothing
        local unit target= s__Missile_target[missile]
        set LoadoutThunderShot__thunderScanRemaining[missile]=LoadoutThunderShot__thunderScanRemaining[missile] - Missile_TIMER_TIMEOUT
        if target != null and LoadoutThunderShot__FilterUnits(target , LoadoutThunderShot__thunderOwner[missile]) then
            set target=null
            return
        endif
        if LoadoutThunderShot__thunderScanRemaining[missile] > 0. then
            set target=null
            return
        endif
        set LoadoutThunderShot__thunderScanRemaining[missile]=LoadoutThunderShot__THUNDER_SCAN_INTERVAL
        set target=LoadoutThunderShot__FindThunderTarget(missile , null)
        if target != null then
            call LoadoutThunderShot__AssignThunderTarget(missile , target)
        endif
        set target=null
    endfunction

    function LoadoutThunderShot__FindNextThunderTarget takes integer missile,unit excluded,unit fallback returns unit
        local unit target= LoadoutThunderShot__FindThunderTarget(missile , excluded)
        if target == null and fallback != null and LoadoutThunderShot__FilterUnits(fallback , LoadoutThunderShot__thunderOwner[missile]) then
            set target=fallback
        endif
        return target
    endfunction

        function s__LoadoutThunderShot__ThunderShotCore_onCollide takes integer missile,unit hit returns boolean
            local unit nextTarget
            local boolean wasAlive
            if not LoadoutThunderShot__FilterUnits(hit , LoadoutThunderShot__thunderOwner[missile]) then
                return false
            endif
            set wasAlive=UnitAlive(hit)
            call LoadoutThunderShot__DamageUnit(LoadoutThunderShot__thunderSource[missile] , hit , LoadoutThunderShot__thunderDamage[missile])
            call LoadoutThunderShot__ShowThunderImpact(hit)
            set LoadoutThunderShot__thunderHitsLeft[missile]=LoadoutThunderShot__thunderHitsLeft[missile] - 1
            set LoadoutThunderShot__thunderLastHit[missile]=hit
            if LoadoutThunderShot__thunderHitsLeft[missile] <= 0 then
                set hit=null
                return true
            endif

            call s__Missile_enableHitAfter(missile,hit , LoadoutThunderShot__THUNDER_REPEAT_INTERVAL)
            set nextTarget=LoadoutThunderShot__FindThunderTarget(missile , hit)
            if nextTarget == null then
                if wasAlive and UnitAlive(hit) then
                    set nextTarget=hit
                else
                    set hit=null
                    return true
                endif
            endif
            call LoadoutThunderShot__AssignThunderTarget(missile , nextTarget)
            set nextTarget=null
            set hit=null
            return false
        endfunction

        function s__LoadoutThunderShot__ThunderShotCore_onPeriod takes integer missile returns boolean
            call LoadoutThunderShot__RefreshThunderTarget(missile)
            return false
        endfunction

        function s__LoadoutThunderShot__ThunderShotCore_onFinish takes integer missile returns boolean
            local unit nextTarget
            if LoadoutThunderShot__thunderHitsLeft[missile] <= 0 then
                return true
            endif
            set nextTarget=LoadoutThunderShot__FindNextThunderTarget(missile , null , LoadoutThunderShot__thunderLastHit[missile])
            if nextTarget != null then
                call LoadoutThunderShot__AssignThunderTarget(missile , nextTarget)
                set nextTarget=null
                return false
            endif
            set nextTarget=null
            if LoadoutThunderShot__thunderLastHit[missile] != null then
                return true
            endif
            return not LoadoutThunderShot__ConfigureThunderWaveSegment(missile)
        endfunction

        function s__LoadoutThunderShot__ThunderShotCore_onDestructable takes integer missile,destructable hit returns boolean
            return false
        endfunction

        function s__LoadoutThunderShot__ThunderShotCore_onTerrain takes integer missile returns boolean
            return false
        endfunction

        function s__LoadoutThunderShot__ThunderShotCore_onRemove takes integer missile returns boolean
            set LoadoutThunderShot__thunderDamage[missile]=0.00
            set LoadoutThunderShot__thunderHitsLeft[missile]=0
            set LoadoutThunderShot__thunderScanRemaining[missile]=0.00
            set LoadoutThunderShot__thunderWaveSign[missile]=0
            set LoadoutThunderShot__thunderLastHit[missile]=null
            set LoadoutThunderShot__thunderSource[missile]=null
            set LoadoutThunderShot__thunderOwner[missile]=null
            set s__Missile_target[missile]=null
            set s__Missile_turn[missile]=0.00
            call s__SpellIndex_destroy((s__Missile_data[missile]))
            return true
        endfunction

//Implemented from module MissileStruct:
        function s__LoadoutThunderShot__ThunderShotCore_launch takes integer missile returns nothing



// NO_DEBUG:             debug set missile.launched = true
            //
            call s__Missile_insertFront(Missile___missileList[si__LoadoutThunderShot__ThunderShotCore],missile)
            call Missile___StartPeriodic(si__LoadoutThunderShot__ThunderShotCore)
        endfunction
        // Called from missileIterate. "P" to avoid code collision.
        function s__LoadoutThunderShot__ThunderShotCore_missileTerminateP takes integer node returns nothing
            if s__Missile_allocated[node] then


                        if s__LoadoutThunderShot__ThunderShotCore_onRemove(node) and GetUnitTypeId(s__Missile_dummy[node]) == Missile_DUMMY_UNIT_ID then
                            call s__Missile___RecycleBin_recycle(s__Missile_dummy[node])
                            set s__Missile_dummy[(node)]=null // INLINED!!
                        endif




            
                call s__Missile_terminate(node)
                call Missile___StopPeriodic(si__LoadoutThunderShot__ThunderShotCore)
            endif
        endfunction
























        

        function s__LoadoutThunderShot__ThunderShotCore_MissileAction___missileActionDest takes nothing returns nothing
            local destructable d= GetEnumDestructable()
            local integer this= s__Missile_temp
            if s__Missile_allocated[this] then
                call SaveDestructableHandle(Missile___HASH, this, GetHandleId(d), d)
                if s__LoadoutThunderShot__ThunderShotCore_onDestructable(this , d) then
                    call s__LoadoutThunderShot__ThunderShotCore_missileTerminateP(this)
                endif
            endif
            set d=null
        endfunction

    
        // Runs every Missile_TIMER_TIMEOUT for this struct.
        function s__LoadoutThunderShot__ThunderShotCore_missileIterateP takes nothing returns boolean
            local integer this= (s__Missile_Missile___MissileStructure___first[(Missile___missileList[si__LoadoutThunderShot__ThunderShotCore])]) // INLINED!!
            local integer node
            local real collideZ
            local boolean b
            local unit u
            
            loop
                exitwhen 0 == this
                set node=(s__Missile_Missile___MissileStructure___next[(this)]) // The linked list should not lose the next node. // INLINED!!
               
                if s__Missile_wantDestroy[this] then
                    call s__LoadoutThunderShot__ThunderShotCore_missileTerminateP(this)
                else
                    if s__Missile_stackSize[this] > 0 then
                        call s__Missile_updateStack(this)
                    endif
                    
                    // Runs unit collision.

                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            set b=s__Missile_collisionType[this] == Missile_COLLISION_TYPE_RECTANGLE
                            if b then
                                call s__Missile_groupEnumUnitsRectangle(this)
                            else
                                call GroupEnumUnitsInRange(Missile___GROUP, s__Missile_x[this], s__Missile_y[this], s__Missile_collision[this] + Missile_MAXIMUM_COLLISION_SIZE, null)
                            endif
                            loop
                                set u=FirstOfGroup(Missile___GROUP)
                                exitwhen u == null
                                call GroupRemoveUnit(Missile___GROUP, u)
                                if not HaveSavedHandle(Missile___HASH, this, GetHandleId(u)) then
                                    if IsUnitInRange(u, s__Missile_dummy[this], s__Missile_collision[this]) or b then
                                        // Eventually run z collision checks.

                                            set collideZ=Missile_GetLocZ(GetUnitX(u) , GetUnitY(u)) + GetUnitFlyHeight(u) - s__Missile_terrainZ[this]
                                            if ( collideZ + GetUnitBodySize(u) >= s__Missile_z[this] - (s__Missile_collision[(this)]) ) and ( collideZ <= s__Missile_z[this] + (s__Missile_collision[(this)]) ) then // INLINED!!
                                                // Mark as hit.
                                                call SaveUnitHandle(Missile___HASH, this, GetHandleId(u), u)
                                                if s__LoadoutThunderShot__ThunderShotCore_onCollide(this , u) then
                                                    call s__LoadoutThunderShot__ThunderShotCore_missileTerminateP(this)
                                                    exitwhen true
                                                endif
                                            endif
    








                                    endif
                                endif
                            endloop
                        endif

                    
                    // Runs destructable collision.

                        // Check if the missile is not terminated.
                        if s__Missile_allocated[this] and 0. < s__Missile_collision[this] then
                            call s__Missile_checkDestCollision(this,function s__LoadoutThunderShot__ThunderShotCore_MissileAction___missileActionDest)
                        endif

                    
                    // Runs item collision.






                
                    // Runs when the destination is reached.
                    if s__Missile_recycle[this] and s__Missile_allocated[this] then

                            if s__LoadoutThunderShot__ThunderShotCore_onFinish(this) then
                                call s__LoadoutThunderShot__ThunderShotCore_missileTerminateP(this)
                            endif



                    endif
                
                    // Runs on terrian collision.

                        if s__Missile_allocated[this] and 0. > s__Missile_z[this] and s__LoadoutThunderShot__ThunderShotCore_onTerrain(this) then
                            call s__LoadoutThunderShot__ThunderShotCore_missileTerminateP(this)
                        endif

                
                    // Runs every Missile_TIMER_TIMEOUT.

                        if s__Missile_allocated[this] and s__LoadoutThunderShot__ThunderShotCore_onPeriod(this) then
                            call s__LoadoutThunderShot__ThunderShotCore_missileTerminateP(this)
                        endif

                endif
                set this=node
            endloop
            
            set u=null



                return false

        endfunction
        
        function s__LoadoutThunderShot__ThunderShotCore_MissileStruct__onInit takes nothing returns nothing
            set Missile___missileList[(si__LoadoutThunderShot__ThunderShotCore)]=s__Missile_allocateCollection() // INLINED!!
            set Missile___expression[(si__LoadoutThunderShot__ThunderShotCore )]=Condition(( function s__LoadoutThunderShot__ThunderShotCore_missileIterateP)) // INLINED!!
        endfunction

    function LoadoutThunderShot__LaunchThunderShot takes unit source,player owner,real angle returns nothing
        local real x= GetUnitX(source) + LoadoutThunderShot__MISSILE_FORWARD_OFFSET * Cos(angle)
        local real y= GetUnitY(source) + LoadoutThunderShot__MISSILE_FORWARD_OFFSET * Sin(angle)
        local integer missile= s__Missile_create(x , y , LoadoutThunderShot__MISSILE_START_Z , angle , WeaponProfileGetRange(WEAPON_PROFILE_THUNDER_SHOT) , LoadoutThunderShot__MISSILE_START_Z)
        local integer dex= s__SpellIndex__allocate()

        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_user[dex]=owner
        set s__Missile_source[missile]=source
        set s__Missile_owner[missile]=owner
        set s__Missile_data[missile]=dex
        call s__Missile__set_model(missile,WeaponProfileGetTierMissileModel(WEAPON_PROFILE_THUNDER_SHOT , 1))
        call s__Missile__set_scale(missile,WeaponProfileGetMissileScale(WEAPON_PROFILE_THUNDER_SHOT))
        set s__Missile_collision[missile]=LoadoutThunderShot__MISSILE_COLLISION
        set s__Missile_speed[(missile)]=((WeaponProfileGetMissileSpeed(WEAPON_PROFILE_THUNDER_SHOT))*1.0) * Missile_TIMER_TIMEOUT // INLINED!!

        set LoadoutThunderShot__thunderDamage[missile]=WeaponProfileGetDamage(WEAPON_PROFILE_THUNDER_SHOT)
        set LoadoutThunderShot__thunderHitsLeft[missile]=LoadoutThunderShot__THUNDER_MAX_HITS
        set LoadoutThunderShot__thunderScanRemaining[missile]=0.00
        set LoadoutThunderShot__thunderWaveSign[missile]=1
        set LoadoutThunderShot__thunderLastHit[missile]=null
        set LoadoutThunderShot__thunderSource[missile]=source
        set LoadoutThunderShot__thunderOwner[missile]=owner
        call LoadoutThunderShot__ConfigureThunderWaveSegment(missile)

        call s__LoadoutThunderShot__ThunderShotCore_launch(missile)
    endfunction

    function LoadoutThunderShot__CleanupCast takes integer dex returns nothing
        local integer id= 0
        if dex == 0 or s__SpellIndex_phase[dex] == - 999 then
            return
        endif
        set s__SpellIndex_phase[dex]=- 999
        if GetUnitTypeId(s__SpellIndex_source[dex]) != 0 then
            set id=GetHandleId(s__SpellIndex_source[dex])
            if (HaveSavedInteger(Table__ht, (LoadoutThunderShot__active), (id))) and ( (LoadInteger(Table__ht, (LoadoutThunderShot__active), (id))) == dex ) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (LoadoutThunderShot__active), (id)) // INLINED!!
            endif
        endif
        if s__SpellIndex_clock[dex] != null then
            call ReleaseTimer(s__SpellIndex_clock[dex])
            set s__SpellIndex_clock[dex]=null
        endif
        set LoadoutThunderShot__castAngle[dex]=0.00
        set LoadoutThunderShot__castTargetX[dex]=0.00
        set LoadoutThunderShot__castTargetY[dex]=0.00
        call s__SpellIndex_destroy(dex)
    endfunction

    function LoadoutThunderShot__FireCastShot takes integer dex returns nothing
        if GetUnitTypeId(s__SpellIndex_source[dex]) == 0 or not UnitAlive(s__SpellIndex_source[dex]) then
            return
        endif
        if not WeaponInventoryConsumeShotForProfile(s__SpellIndex_user[dex] , WEAPON_PROFILE_THUNDER_SHOT) then
            return
        endif
        call SetUnitAnimation(s__SpellIndex_source[dex], "attack")
        call LoadoutThunderShot__LaunchThunderShot(s__SpellIndex_source[dex] , s__SpellIndex_user[dex] , LoadoutThunderShot__castAngle[dex])
    endfunction

    function LoadoutThunderShot__OnCastTick takes nothing returns nothing
        local timer t= GetExpiredTimer()
        local integer dex= (LoadInteger(TimerUtils___ht, 0, GetHandleId((t)))) // INLINED!!
        local real step= LoadoutThunderShot__GetSafeFireInterval()
        if s__SpellIndex_time[dex] <= 0. or GetUnitTypeId(s__SpellIndex_source[dex]) == 0 or not UnitAlive(s__SpellIndex_source[dex]) then
            call LoadoutThunderShot__CleanupCast(dex)
            set t=null
            return
        endif
        call LoadoutThunderShot__FireCastShot(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step
        if s__SpellIndex_time[dex] <= 0. then
            call LoadoutThunderShot__CleanupCast(dex)
        else
            call TimerStart(s__SpellIndex_clock[dex], step, false, function LoadoutThunderShot__OnCastTick)
        endif
        set t=null
    endfunction

    function LoadoutThunderShotFire takes unit source,player owner,real tx,real ty returns boolean
        local integer id= GetHandleId(source)
        local real duration= WeaponProfileGetCastDuration(WEAPON_PROFILE_THUNDER_SHOT)
        local real step= LoadoutThunderShot__GetSafeFireInterval()
        local integer dex
        local real x= GetUnitX(source)
        local real y= GetUnitY(source)

        if (HaveSavedInteger(Table__ht, (LoadoutThunderShot__active), (id))) then // INLINED!!
            set dex=(LoadInteger(Table__ht, (LoadoutThunderShot__active), (id))) // INLINED!!
            if ( GetUnitTypeId(s__SpellIndex_source[dex]) != 0 ) and UnitAlive(s__SpellIndex_source[dex]) then
                set LoadoutThunderShot__castAngle[dex]=Atan2(ty - y, tx - x)
                set LoadoutThunderShot__castTargetX[dex]=tx
                set LoadoutThunderShot__castTargetY[dex]=ty
                set s__SpellIndex_time[dex]=duration
                call SetUnitAnimation(s__SpellIndex_source[dex], "attack")
                return true
            endif
            call LoadoutThunderShot__CleanupCast(dex)
        endif

        set dex=s__SpellIndex__allocate()
        set s__SpellIndex_source[dex]=source
        set s__SpellIndex_user[dex]=owner
        set s__SpellIndex_time[dex]=duration
        set s__SpellIndex_phase[dex]=1
        set LoadoutThunderShot__castAngle[dex]=Atan2(ty - y, tx - x)
        set LoadoutThunderShot__castTargetX[dex]=tx
        set LoadoutThunderShot__castTargetY[dex]=ty
        set s__SpellIndex_clock[dex]=null
        call SaveInteger(Table__ht, (LoadoutThunderShot__active), (id), ( dex)) // INLINED!!

        call LoadoutThunderShot__FireCastShot(dex)
        set s__SpellIndex_time[dex]=s__SpellIndex_time[dex] - step
        if s__SpellIndex_time[dex] > 0. then
            set s__SpellIndex_clock[dex]=NewTimerEx(dex)
            call SetTimerDebugTag(s__SpellIndex_clock[dex] , TIMER_DEBUG_TAG_LOADOUT_MISSILE)
            call TimerStart(s__SpellIndex_clock[dex], step, false, function LoadoutThunderShot__OnCastTick)
        else
            call LoadoutThunderShot__CleanupCast(dex)
        endif

        return true
    endfunction

    function LoadoutThunderShot__OnEffect takes nothing returns nothing
        local unit source= GetTriggerUnit()
        local player owner= GetTriggerPlayer()
        call LoadoutThunderShotFire(source , owner , GetSpellTargetX() , GetSpellTargetY())
        set source=null
        set owner=null
    endfunction

    function LoadoutThunderShot__Init takes nothing returns nothing
        set LoadoutThunderShot__active=s__Table_create()
        call RegisterSpellEffectEvent(WeaponProfileGetFireAbility(WEAPON_PROFILE_THUNDER_SHOT) , function LoadoutThunderShot__OnEffect)
    endfunction




     function MenuClient_HERO_WINDOW_NAME takes unit u returns string
