        function s__Wave__staticgetindex takes unit u returns integer
            local integer hid
            if u == null then
                return 0
            endif
            set hid=GetHandleId(u)
            if (HaveSavedInteger(Table__ht, (WaveByUnit), (hid))) then // INLINED!!
                return (LoadInteger(Table__ht, (WaveByUnit), (hid))) // INLINED!!
            endif
            return 0
        endfunction 

        function s__Wave_create takes integer PlayerLim,integer nearChance,real sec,multiboard mb,string titleFunc,integer wIndex,integer wTotal,string onFinishFuncName returns integer
            local integer this= s__Wave__allocate()
            local integer i= 0

            set WaveTokenSeed=WaveTokenSeed + 1
            set s__Wave_waveToken[this]=WaveTokenSeed
            set s__Wave_isDestroyed[this]=false
            set s__Wave_titleFunc[this]=titleFunc
            set s__Wave_waveIndex[this]=wIndex
            set s__Wave_waveTotal[this]=wTotal
            set s__Wave_finishFuncName[this]=onFinishFuncName

            if mb != null then
                set s__Wave_board[this]=mb
                call SaveInteger(Table__ht, (WaveByBoard), (GetHandleId(mb)), ( this)) // INLINED!!
            else
                set s__Wave_board[this]=null
            endif

            set s__Wave_pointCount[this]=0
            if nearChance < 0 then
                set nearChance=0
            elseif nearChance > 100 then
                set nearChance=100
            endif
            set s__Wave_nearUnitChance[this]=nearChance
            set s__Wave_nearUnitCount[this]=0
            set s__Wave_slotCount[this]=0
            set s__Wave_activeOnMap[this]=0
            set s__Wave_activeTrackedCount[this]=0
            set s__Wave_perPlayerLimit[this]=PlayerLim
            if s__Wave_perPlayerLimit[this] < 1 then
                set s__Wave_perPlayerLimit[this]=1
            endif
            if sec <= 0.0 then
                set sec=0.25
            endif
            set s__Wave_interval[this]=sec
            set s__Wave_additionalPerPlayerPct[this]=100.0

            set s__Wave_totalToSpawn[this]=0
            set s__Wave_totalUnits[this]=0
            set s__Wave_totalBosses[this]=0

            set s__Wave_remainingToSpawn[this]=0
            set s__Wave_remainingUnits[this]=0
            set s__Wave_remainingBosses[this]=0

            set s__Wave_activeBosses[this]=0
            set s__Wave_activeUnits[this]=0

            set s__Wave_totalKilled[this]=0
            set s__Wave_totalKilledUnits[this]=0
            set s__Wave_totalKilledBoss[this]=0

            set s__Wave_killsDone[this]=0
            set s__Wave_killsDoneUnits[this]=0
            set s__Wave_killsDoneBoss[this]=0

            set s__Wave_isRunning[this]=false
            set s__Wave_isPaused[this]=false
            set s__Wave_isFinishing[this]=false
            set s__Wave_terminateRequested[this]=false
            set s__Wave_cancelPendingPermanently[this]=false
            set s__Wave_suppressEndCallback[this]=false
            set s__Wave_finishEventFired[this]=false
            set s__Wave_affiliateUnitHid[this]=0
            set s__Wave_affiliateTerminateMode[this]=0
            set s__Wave_tickCounter[this]=0

            loop
                exitwhen i >= WAVE_TRACKED_PLAYER_SLOTS
                set s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+i]=0
                set i=i + 1
            endloop

            return this
        endfunction

        function s__Wave_findSlotByGroupForOwner takes integer this,integer slotGroupId,integer uId,boolean isBoss,player p returns integer
            local integer i= 0
            local integer s

            if slotGroupId <= 0 or p == null then
                return 0
            endif

            loop
                exitwhen i >= s__Wave_slotCount[this]
                set s=s___Wave_slots[s__Wave_slots[this]+i]
                if s != 0 and s__WaveSlot_slotGroupId[s] == slotGroupId and s__WaveSlot_owner[s] == p and s__WaveSlot_unitId[s] == uId and s__WaveSlot_isBoss[s] == isBoss then
                    return s
                endif
                set i=i + 1
            endloop

            return 0
        endfunction

        function s__Wave_extendSlotInternal takes integer this,integer s,integer amount returns nothing
            if s == 0 or amount <= 0 then
                return
            endif

            set s__WaveSlot_remaining[s]=s__WaveSlot_remaining[s] + amount
            set s__WaveSlot_total[s]=s__WaveSlot_total[s] + amount

            set s__Wave_totalToSpawn[this]=s__Wave_totalToSpawn[this] + amount
            set s__Wave_remainingToSpawn[this]=s__Wave_remainingToSpawn[this] + amount
            set s__Wave_totalKilled[this]=s__Wave_totalKilled[this] + amount

            if s__WaveSlot_isBoss[s] then
                set s__Wave_totalBosses[this]=s__Wave_totalBosses[this] + amount
                set s__Wave_remainingBosses[this]=s__Wave_remainingBosses[this] + amount
                set s__Wave_totalKilledBoss[this]=s__Wave_totalKilledBoss[this] + amount
            else
                set s__Wave_totalUnits[this]=s__Wave_totalUnits[this] + amount
                set s__Wave_remainingUnits[this]=s__Wave_remainingUnits[this] + amount
                set s__Wave_totalKilledUnits[this]=s__Wave_totalKilledUnits[this] + amount
            endif

            call sc__Wave_clampCoreCounters(this)
        endfunction

        // Agregar un tipo de unidad (base interna)
        function s__Wave_addSlotInternal takes integer this,integer slotGroupId,integer uId,integer amount,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,player p,integer aiProfileId,integer laneId,integer behaviorFlags,real threatWeight returns nothing
            local integer s

            if s__Wave_isDestroyed[this] or s__Wave_isFinishing[this] or s__Wave_terminateRequested[this] then
                return
            endif

            if slotGroupId > 0 then
                set s=s__Wave_findSlotByGroupForOwner(this,slotGroupId , uId , isBoss , p)
                if s != 0 then
                    call s__Wave_extendSlotInternal(this,s , amount)
                    return
                endif
            endif

            set s=s__WaveSlot__allocate()

            if s__Wave_slotCount[this] >= WAVE_MAX_SLOTS then
                call s__WaveSlot_deallocate(s)
                return
            endif
            if ( uId == 0 ) or ( amount <= 0 ) or ( p == null ) then
                call s__WaveSlot_deallocate(s)
                return
            endif
            if lim < 1 then
                set lim=1
            endif
            if fxId < 0 then
                set fxId=0
            elseif fxId > FX_MAX then
                set fxId=FX_MAX
            endif

            set s__WaveSlot_unitId[s]=uId
            set s__WaveSlot_remaining[s]=amount
            set s__WaveSlot_active[s]=0
            set s__WaveSlot_limit[s]=lim
            set s__WaveSlot_owner[s]=p
            set s__WaveSlot_priority[s]=prio
            set s__WaveSlot_fxId[s]=fxId
            set s__WaveSlot_killGate[s]=killGate

            set s__WaveSlot_total[s]=amount
            set s__WaveSlot_slotGroupId[s]=slotGroupId
            
            set s__WaveSlot_isBoss[s]=isBoss
            set s__WaveSlot_aiProfileId[s]=aiProfileId
            set s__WaveSlot_laneId[s]=laneId
            set s__WaveSlot_behaviorFlags[s]=behaviorFlags
            if threatWeight <= 0.0 then
                set threatWeight=1.0
            endif
            set s__WaveSlot_threatWeight[s]=threatWeight

            set s___Wave_slots[s__Wave_slots[this]+s__Wave_slotCount[this]]=s
            set s__Wave_slotCount[this]=s__Wave_slotCount[this] + 1

            // Global
            set s__Wave_totalToSpawn[this]=s__Wave_totalToSpawn[this] + amount
            set s__Wave_remainingToSpawn[this]=s__Wave_remainingToSpawn[this] + amount

            set s__Wave_totalKilled[this]=s__Wave_totalKilled[this] + amount

            if isBoss then
                // Boss
                set s__Wave_totalBosses[this]=s__Wave_totalBosses[this] + amount
                set s__Wave_remainingBosses[this]=s__Wave_remainingBosses[this] + amount
                set s__Wave_totalKilledBoss[this]=s__Wave_totalKilledBoss[this] + amount
            else
                // Unidades normales
                set s__Wave_totalUnits[this]=s__Wave_totalUnits[this] + amount
                set s__Wave_remainingUnits[this]=s__Wave_remainingUnits[this] + amount
                set s__Wave_totalKilledUnits[this]=s__Wave_totalKilledUnits[this] + amount
            endif
        endfunction

        // Agregar un tipo de unidad (compatibilidad actual)
        function s__Wave_addSlot takes integer this,integer uId,integer amount,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,player p returns nothing
            call s__Wave_addSlotInternal(this,0 , uId , amount , lim , prio , fxId , killGate , isBoss , p , 0 , 0 , 0 , 1.0)
        endfunction

        // VersiÃƒÂ³n extendida para IA: perfil/carril/banderas/peso
        function s__Wave_addSlotEx takes integer this,integer uId,integer amount,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,player p,integer aiProfileId,integer laneId,integer behaviorFlags,real threatWeight returns nothing
            call s__Wave_addSlotInternal(this,0 , uId , amount , lim , prio , fxId , killGate , isBoss , p , aiProfileId , laneId , behaviorFlags , threatWeight)
        endfunction

        function s__Wave_setAdditionalPerPlayerPercent takes integer this,real pct returns nothing
            if pct < 0.0 then
                set pct=0.0
            endif
            set s__Wave_additionalPerPlayerPct[this]=pct
        endfunction

        function s__Wave_getAdditionalPerPlayerPercent takes integer this returns real
            return s__Wave_additionalPerPlayerPct[this]
        endfunction

        function s__Wave_setFinishFunctionName takes integer this,string funcName returns nothing
            set s__Wave_finishFuncName[this]=funcName
        endfunction

        function s__Wave_getFinishFunctionName takes integer this returns string
            return s__Wave_finishFuncName[this]
        endfunction

        function s__Wave_computeScaledAmount takes integer this,integer baseAmount,integer playersCount,real pct returns integer
            local real addPerPlayer
            local integer extraPlayers
            local integer amount
            if baseAmount <= 0 then
                return 0
            endif
            if playersCount < 1 then
                set playersCount=1
            endif
            if pct < 0.0 then
                set pct=0.0
            endif
            set extraPlayers=playersCount - 1
            if extraPlayers <= 0 then
                return baseAmount
            endif
            set addPerPlayer=I2R(baseAmount) * ( pct * 0.01 )
            set amount=baseAmount + R2I(I2R(extraPlayers) * addPerPlayer + 0.5)
            if amount < baseAmount then
                set amount=baseAmount
            endif
            return amount
        endfunction

        function s__Wave_addSlotScaledForDefaultPlayers takes integer this,integer slotGroupId,integer uId,integer baseAmount,real pct,boolean scaleWithActivePlayers,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,integer aiProfileId,integer laneId,integer behaviorFlags,real threatWeight returns nothing
            local integer ownerId= WAVE_DEFAULT_OWNER_MIN
            local integer amount= baseAmount
            if scaleWithActivePlayers then
                set amount=s__Wave_computeScaledAmount(this,baseAmount , WaveTest___WaveCountPlayingUsers() , pct)
            endif
            loop
                exitwhen ownerId > WAVE_DEFAULT_OWNER_MAX
                call s__Wave_addSlotInternal(this,slotGroupId , uId , amount , lim , prio , fxId , killGate , isBoss , Player(ownerId) , aiProfileId , laneId , behaviorFlags , threatWeight)
                set ownerId=ownerId + 1
            endloop
        endfunction

        function s__Wave_pickDefaultOwnerPid takes integer this returns integer
            local integer pid= WAVE_DEFAULT_OWNER_MIN
            local integer bestPid= - 1
            local integer bestCount= 0
            loop
                exitwhen pid > WAVE_DEFAULT_OWNER_MAX
                if pid < WAVE_TRACKED_PLAYER_SLOTS then
                    if s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] < s__Wave_perPlayerLimit[this] then
                        if bestPid < 0 or s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] < bestCount then
                            set bestPid=pid
                            set bestCount=s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid]
                        endif
                    endif
                endif
                set pid=pid + 1
            endloop
            return bestPid
        endfunction

        // Modo nativo del sistema: crea slots para Player(8..12) en una sola llamada.
        function s__Wave_addSlotByPlayers takes integer this,integer uId,integer baseAmount,boolean scaleWithActivePlayers,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss returns nothing
            call s__Wave_addSlotScaledForDefaultPlayers(this,0 , uId , baseAmount , s__Wave_additionalPerPlayerPct[this] , scaleWithActivePlayers , lim , prio , fxId , killGate , isBoss , 0 , 0 , 0 , 1.0)
        endfunction

        function s__Wave_addSlotByPlayersPct takes integer this,integer uId,integer baseAmount,real pct,boolean scaleWithActivePlayers,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss returns nothing
            call s__Wave_addSlotScaledForDefaultPlayers(this,0 , uId , baseAmount , pct , scaleWithActivePlayers , lim , prio , fxId , killGate , isBoss , 0 , 0 , 0 , 1.0)
        endfunction

        function s__Wave_addSlotExByPlayers takes integer this,integer uId,integer baseAmount,boolean scaleWithActivePlayers,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,integer aiProfileId,integer laneId,integer behaviorFlags,real threatWeight returns nothing
            call s__Wave_addSlotScaledForDefaultPlayers(this,0 , uId , baseAmount , s__Wave_additionalPerPlayerPct[this] , scaleWithActivePlayers , lim , prio , fxId , killGate , isBoss , aiProfileId , laneId , behaviorFlags , threatWeight)
        endfunction

        function s__Wave_upsertSlotExByPlayers takes integer this,integer slotGroupId,integer uId,integer baseAmount,boolean scaleWithActivePlayers,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,integer aiProfileId,integer laneId,integer behaviorFlags,real threatWeight returns nothing
            if slotGroupId <= 0 then
                call s__Wave_addSlotExByPlayers(this,uId , baseAmount , scaleWithActivePlayers , lim , prio , fxId , killGate , isBoss , aiProfileId , laneId , behaviorFlags , threatWeight)
                return
            endif
            call s__Wave_addSlotScaledForDefaultPlayers(this,slotGroupId , uId , baseAmount , s__Wave_additionalPerPlayerPct[this] , scaleWithActivePlayers , lim , prio , fxId , killGate , isBoss , aiProfileId , laneId , behaviorFlags , threatWeight)
        endfunction

        // Variante explÃƒÆ’Ã‚Â­cita por jugador para casos especiales.
        function s__Wave_addSlotByPlayer takes integer this,integer uId,integer baseAmount,boolean scaleWithActivePlayers,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,player p returns nothing
            local integer amount= baseAmount
            if scaleWithActivePlayers then
                set amount=s__Wave_computeScaledAmount(this,baseAmount , WaveTest___WaveCountPlayingUsers() , s__Wave_additionalPerPlayerPct[this])
            endif
            call s__Wave_addSlotInternal(this,0 , uId , amount , lim , prio , fxId , killGate , isBoss , p , 0 , 0 , 0 , 1.0)
        endfunction

        function s__Wave_addSlotByPlayerPct takes integer this,integer uId,integer baseAmount,real pct,boolean scaleWithActivePlayers,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,player p returns nothing
            local integer amount= baseAmount
            if scaleWithActivePlayers then
                set amount=s__Wave_computeScaledAmount(this,baseAmount , WaveTest___WaveCountPlayingUsers() , pct)
            endif
            call s__Wave_addSlotInternal(this,0 , uId , amount , lim , prio , fxId , killGate , isBoss , p , 0 , 0 , 0 , 1.0)
        endfunction

        function s__Wave_addSlotExByPlayer takes integer this,integer uId,integer baseAmount,boolean scaleWithActivePlayers,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,player p,integer aiProfileId,integer laneId,integer behaviorFlags,real threatWeight returns nothing
            local integer amount= baseAmount
            if scaleWithActivePlayers then
                set amount=s__Wave_computeScaledAmount(this,baseAmount , WaveTest___WaveCountPlayingUsers() , s__Wave_additionalPerPlayerPct[this])
            endif
            call s__Wave_addSlotInternal(this,0 , uId , amount , lim , prio , fxId , killGate , isBoss , p , aiProfileId , laneId , behaviorFlags , threatWeight)
        endfunction

        function s__Wave_upsertSlotExByPlayer takes integer this,integer slotGroupId,integer uId,integer baseAmount,boolean scaleWithActivePlayers,integer lim,integer prio,integer fxId,integer killGate,boolean isBoss,player p,integer aiProfileId,integer laneId,integer behaviorFlags,real threatWeight returns nothing
            local integer amount= baseAmount
            if slotGroupId <= 0 then
                call s__Wave_addSlotExByPlayer(this,uId , baseAmount , scaleWithActivePlayers , lim , prio , fxId , killGate , isBoss , p , aiProfileId , laneId , behaviorFlags , threatWeight)
                return
            endif
            if scaleWithActivePlayers then
                set amount=s__Wave_computeScaledAmount(this,baseAmount , WaveTest___WaveCountPlayingUsers() , s__Wave_additionalPerPlayerPct[this])
            endif
            call s__Wave_addSlotInternal(this,slotGroupId , uId , amount , lim , prio , fxId , killGate , isBoss , p , aiProfileId , laneId , behaviorFlags , threatWeight)
        endfunction

        function s__Wave_registerWaveUnit takes integer this,unit u,integer s,boolean isBoss,boolean isExternal returns nothing
            local integer hid
            if ( u == null ) or ( GetUnitTypeId(u) == 0 ) then
                return
            endif
            set hid=GetHandleId(u)
            call SaveInteger(Table__ht, (WaveByUnit), (hid), ( this)) // INLINED!!
            if s != 0 then
                call SaveInteger(Table__ht, (SlotByUnit), (hid), ( s)) // INLINED!!
                call RemoveSavedInteger(Table__ht, (ExternalIsBoss), (hid)) // INLINED!!
            else
                call RemoveSavedInteger(Table__ht, (SlotByUnit), (hid)) // INLINED!!
                if isExternal then
                    if isBoss then
                        call SaveInteger(Table__ht, (ExternalIsBoss), (hid), ( 1)) // INLINED!!
                    else
                        call SaveInteger(Table__ht, (ExternalIsBoss), (hid), ( 0)) // INLINED!!
                    endif
                else
                    call RemoveSavedInteger(Table__ht, (ExternalIsBoss), (hid)) // INLINED!!
                endif
            endif
            call sc__Wave_trackActiveUnit(this,u)
            call WaveTest___WaveFireSpawn(this , u , s , isBoss , isExternal)
            if isExternal then
                call WaveTest___WaveFireExternal(this , u , s , isBoss , true)
            endif
        endfunction

        function s__Wave_registerExternalUnit takes integer this,unit source,unit summoned,boolean isBoss returns nothing
            local integer srcId= GetHandleId(source)
            local integer summonedId= GetHandleId(summoned)
            local integer w
            local integer ownerPid
            local integer srcFxId

            if ( source == null ) or ( summoned == null ) then
                call WaveDebugLog("registerExternalUnit reject reason=null_source_or_summoned source=" + WaveDebugUnitSummary(source) + " summoned=" + WaveDebugUnitSummary(summoned) + " boss=" + I2S(WaveDebugBoolToInt(isBoss)))
                return
            endif
            if GetUnitTypeId(summoned) == 0 then
                call WaveDebugLog("registerExternalUnit reject reason=summoned_type_zero source=" + WaveDebugUnitSummary(source) + " summoned=" + WaveDebugUnitSummary(summoned) + " boss=" + I2S(WaveDebugBoolToInt(isBoss)))
                return
            endif

            // El invocador NO pertenece a ninguna wave ? ignorar
            if not (HaveSavedInteger(Table__ht, (WaveByUnit), (srcId))) then // INLINED!!
                call WaveDebugLog("registerExternalUnit reject reason=source_not_tracked source=" + WaveDebugUnitSummary(source) + " summoned=" + WaveDebugUnitSummary(summoned) + " boss=" + I2S(WaveDebugBoolToInt(isBoss)))
                return
            endif

            set w=((LoadInteger(Table__ht, (WaveByUnit), (srcId)))) // INLINED!!
            if ( w == 0 ) or s__Wave_isDestroyed[w] then
                call WaveDebugLog("registerExternalUnit reject reason=wave_invalid source=" + WaveDebugUnitSummary(source) + " summoned=" + WaveDebugUnitSummary(summoned) + " wave=" + I2S(w) + " boss=" + I2S(WaveDebugBoolToInt(isBoss)))
                return
            endif

            // Seguridad extra: no doble registro
            if (HaveSavedInteger(Table__ht, (WaveByUnit), (GetHandleId(summoned)))) then // INLINED!!
                call WaveDebugLog("registerExternalUnit reject reason=summoned_already_tracked source=" + WaveDebugUnitSummary(source) + " summoned=" + WaveDebugUnitSummary(summoned) + " wave=" + I2S(w) + " boss=" + I2S(WaveDebugBoolToInt(isBoss)))
                return
            endif

            set ownerPid=GetPlayerId(GetOwningPlayer(summoned))
            if ( ownerPid >= 0 ) and ( ownerPid < WAVE_TRACKED_PLAYER_SLOTS ) then
                set s___Wave_activeByPlayer[s__Wave_activeByPlayer[w]+ownerPid]=s___Wave_activeByPlayer[s__Wave_activeByPlayer[w]+ownerPid] + 1
            endif

            set srcFxId=0
            if (HaveSavedInteger(Table__ht, (SlotByUnit), (srcId))) then // INLINED!!
                set srcFxId=s__WaveSlot_fxId[((LoadInteger(Table__ht, (SlotByUnit), (srcId))))] // INLINED!!
            elseif (HaveSavedInteger(Table__ht, (WaveExternalSpawnFxByUnit), (srcId))) then // INLINED!!
                set srcFxId=(LoadInteger(Table__ht, (WaveExternalSpawnFxByUnit), (srcId))) // INLINED!!
            endif
            if srcFxId > 0 then
                call SaveInteger(Table__ht, (WaveExternalSpawnFxByUnit), (GetHandleId(summoned)), ( srcFxId)) // INLINED!!
            endif

            set s__Wave_activeOnMap[w]=s__Wave_activeOnMap[w] + 1
            set s__Wave_totalToSpawn[w]=s__Wave_totalToSpawn[w] + 1
            set s__Wave_totalKilled[w]=s__Wave_totalKilled[w] + 1

            if isBoss then
                //set w.remainingBosses = w.remainingBosses + 1
                set s__Wave_totalBosses[w]=s__Wave_totalBosses[w] + 1
                set s__Wave_totalKilledBoss[w]=s__Wave_totalKilledBoss[w] + 1
                set s__Wave_activeBosses[w]=s__Wave_activeBosses[w] + 1
            else
                //set w.remainingUnits = w.remainingUnits + 1
                set s__Wave_totalUnits[w]=s__Wave_totalUnits[w] + 1
                set s__Wave_totalKilledUnits[w]=s__Wave_totalKilledUnits[w] + 1
                set s__Wave_activeUnits[w]=s__Wave_activeUnits[w] + 1
            endif

            if ownerPid >= 0 then
                call SaveInteger(Table__ht, (WaveExternalOwnerPidByUnit), (summonedId), ( ownerPid)) // INLINED!!
            endif

            call s__Wave_registerWaveUnit(w,summoned , 0 , isBoss , true)
            call WaveDebugLog("registerExternalUnit wave=" + I2S(w) + " source=" + WaveDebugUnitSummary(source) + " summoned=" + WaveDebugUnitSummary(summoned) + " ownerPid=" + I2S(ownerPid) + " external=1 boss=" + I2S(WaveDebugBoolToInt(isBoss)))

        endfunction


        function s__Wave_addPoint takes integer this,real x,real y returns nothing
            if s__Wave_pointCount[this] >= WAVE_MAX_POINTS then
                return
            endif
            set s___Wave_pointX[s__Wave_pointX[this]+s__Wave_pointCount[this]]=x
            set s___Wave_pointY[s__Wave_pointY[this]+s__Wave_pointCount[this]]=y
            set s__Wave_pointCount[this]=s__Wave_pointCount[this] + 1
        endfunction

        function s__Wave_addNearUnit takes integer this,unit u returns nothing
            if s__Wave_nearUnitCount[this] >= WAVE_MAX_NEAR_UNITS then
                return
            endif
            if ( u == null ) or ( GetUnitTypeId(u) == 0 ) then
                return
            endif
            set s___Wave_nearUnits[s__Wave_nearUnits[this]+s__Wave_nearUnitCount[this]]=u
            set s__Wave_nearUnitCount[this]=s__Wave_nearUnitCount[this] + 1
        endfunction

        function s__Wave_clearAffiliateUnit takes integer this returns nothing
            if s__Wave_affiliateUnitHid[this] <= 0 then
                return
            endif
            if (HaveSavedInteger(Table__ht, (WaveAffiliateWaveByUnit), (s__Wave_affiliateUnitHid[this]))) and ( (LoadInteger(Table__ht, (WaveAffiliateWaveByUnit), (s__Wave_affiliateUnitHid[this]))) == this ) then // INLINED!!
                call RemoveSavedInteger(Table__ht, (WaveAffiliateWaveByUnit), (s__Wave_affiliateUnitHid[this])) // INLINED!!
                call RemoveSavedInteger(Table__ht, (WaveAffiliateModeByUnit), (s__Wave_affiliateUnitHid[this])) // INLINED!!
            endif
            set s__Wave_affiliateUnitHid[this]=0
            set s__Wave_affiliateTerminateMode[this]=0
        endfunction

        // Vincula esta wave a una unidad externa.
        // Cuando esa unidad muera, la wave se termina:
        //   forceKillOnDeath = false -> terminate(false)
        //   forceKillOnDeath = true  -> terminate(true)
        function s__Wave_setAffiliateUnit takes integer this,unit anchor,boolean forceKillOnDeath returns nothing
            local integer hid
            local integer oldWave

            call s__Wave_clearAffiliateUnit(this)
            if ( anchor == null ) or ( GetUnitTypeId(anchor) == 0 ) then
                return
            endif

            set hid=GetHandleId(anchor)
            if (HaveSavedInteger(Table__ht, (WaveAffiliateWaveByUnit), (hid))) then // INLINED!!
                set oldWave=((LoadInteger(Table__ht, (WaveAffiliateWaveByUnit), (hid)))) // INLINED!!
                if ( oldWave != 0 ) and ( oldWave != this ) then
                    set s__Wave_affiliateUnitHid[oldWave]=0
                    set s__Wave_affiliateTerminateMode[oldWave]=0
                endif
            endif

            call SaveInteger(Table__ht, (WaveAffiliateWaveByUnit), (hid), ( this)) // INLINED!!
            if forceKillOnDeath then
                call SaveInteger(Table__ht, (WaveAffiliateModeByUnit), (hid), ( 1)) // INLINED!!
                set s__Wave_affiliateTerminateMode[this]=1
            else
                call SaveInteger(Table__ht, (WaveAffiliateModeByUnit), (hid), ( 0)) // INLINED!!
                set s__Wave_affiliateTerminateMode[this]=0
            endif
            set s__Wave_affiliateUnitHid[this]=hid
        endfunction

        function s__Wave_activeKey takes integer this,integer index returns integer
            return this * WAVE_ACTIVE_STRIDE + index
        endfunction

        function s__Wave_trackActiveUnit takes integer this,unit u returns nothing
            local integer hid
            local integer index
            if u == null then
                return
            endif
            if s__Wave_activeTrackedCount[this] >= ( WAVE_ACTIVE_STRIDE - 1 ) then
                return
            endif
            set hid=GetHandleId(u)
            if (HaveSavedInteger(Table__ht, (WaveActivePosByUnit), (hid))) then // INLINED!!
                return
            endif
            set index=s__Wave_activeTrackedCount[this] + 1
            set s__Wave_activeTrackedCount[this]=index
            call SaveUnitHandle(Table__ht, (((WaveActiveUnitByKey))), (((this) * WAVE_ACTIVE_STRIDE + (index))), ( u)) // INLINED!!
            call SaveInteger(Table__ht, (WaveActivePosByUnit), (hid), ( index)) // INLINED!!
        endfunction

        function s__Wave_untrackUnitByHandle takes integer this,integer hid returns nothing
            local integer index
            local integer last
            local integer key
            local integer movedKey
            local unit moved
            if not (HaveSavedInteger(Table__ht, (WaveActivePosByUnit), (hid))) then // INLINED!!
                return
            endif
            set index=(LoadInteger(Table__ht, (WaveActivePosByUnit), (hid))) // INLINED!!
            set last=s__Wave_activeTrackedCount[this]
            if ( index <= 0 ) or ( index > last ) then
                call RemoveSavedInteger(Table__ht, (WaveActivePosByUnit), (hid)) // INLINED!!
                return
            endif

            set key=((this) * WAVE_ACTIVE_STRIDE + (index)) // INLINED!!
            set movedKey=((this) * WAVE_ACTIVE_STRIDE + (last)) // INLINED!!
            if index != last then
                set moved=(LoadUnitHandle(Table__ht, (((WaveActiveUnitByKey))), (movedKey))) // INLINED!!
                call SaveUnitHandle(Table__ht, (((WaveActiveUnitByKey))), (key), ( moved)) // INLINED!!
                if moved != null then
                    call SaveInteger(Table__ht, (WaveActivePosByUnit), (GetHandleId(moved)), ( index)) // INLINED!!
                endif
            endif

            call RemoveSavedInteger(Table__ht, (WaveActiveUnitByKey), (movedKey)) // INLINED!!
            call RemoveSavedInteger(Table__ht, (WaveActivePosByUnit), (hid)) // INLINED!!
            set s__Wave_activeTrackedCount[this]=last - 1
            set moved=null
        endfunction

        function s__Wave_getActiveIndexedCount takes integer this returns integer
            return s__Wave_activeTrackedCount[this]
        endfunction

        function s__Wave_getActiveIndexedUnit takes integer this,integer index returns unit
            if ( index < 1 ) or ( index > s__Wave_activeTrackedCount[this] ) then
                return null
            endif
            return (LoadUnitHandle(Table__ht, (((WaveActiveUnitByKey))), (((this) * WAVE_ACTIVE_STRIDE + (index))))) // INLINED!!
        endfunction

        function s__Wave_clampCoreCounters takes integer this returns nothing
            if s__Wave_activeOnMap[this] < 0 then
                set s__Wave_activeOnMap[this]=0
            endif
            if s__Wave_activeUnits[this] < 0 then
                set s__Wave_activeUnits[this]=0
            endif
            if s__Wave_activeBosses[this] < 0 then
                set s__Wave_activeBosses[this]=0
            endif
            if s__Wave_remainingToSpawn[this] < 0 then
                set s__Wave_remainingToSpawn[this]=0
            endif
            if s__Wave_remainingUnits[this] < 0 then
                set s__Wave_remainingUnits[this]=0
            endif
            if s__Wave_remainingBosses[this] < 0 then
                set s__Wave_remainingBosses[this]=0
            endif
            if s__Wave_totalToSpawn[this] < 0 then
                set s__Wave_totalToSpawn[this]=0
            endif
            if s__Wave_totalUnits[this] < 0 then
                set s__Wave_totalUnits[this]=0
            endif
            if s__Wave_totalBosses[this] < 0 then
                set s__Wave_totalBosses[this]=0
            endif
            if s__Wave_totalKilled[this] < 0 then
                set s__Wave_totalKilled[this]=0
            endif
            if s__Wave_totalKilledUnits[this] < 0 then
                set s__Wave_totalKilledUnits[this]=0
            endif
            if s__Wave_totalKilledBoss[this] < 0 then
                set s__Wave_totalKilledBoss[this]=0
            endif
        endfunction

        function s__Wave_cancelSlotRemaining takes integer this,integer s returns nothing
            local integer canceled
            if s == 0 then
                return
            endif
            set canceled=s__WaveSlot_remaining[s]
            if canceled <= 0 then
                return
            endif
            set s__WaveSlot_remaining[s]=0
            set s__Wave_remainingToSpawn[this]=s__Wave_remainingToSpawn[this] - canceled
            set s__Wave_totalToSpawn[this]=s__Wave_totalToSpawn[this] - canceled
            set s__Wave_totalKilled[this]=s__Wave_totalKilled[this] - canceled
            if s__WaveSlot_isBoss[s] then
                set s__Wave_remainingBosses[this]=s__Wave_remainingBosses[this] - canceled
                set s__Wave_totalBosses[this]=s__Wave_totalBosses[this] - canceled
                set s__Wave_totalKilledBoss[this]=s__Wave_totalKilledBoss[this] - canceled
            else
                set s__Wave_remainingUnits[this]=s__Wave_remainingUnits[this] - canceled
                set s__Wave_totalUnits[this]=s__Wave_totalUnits[this] - canceled
                set s__Wave_totalKilledUnits[this]=s__Wave_totalKilledUnits[this] - canceled
            endif
        endfunction

        function s__Wave_cancelAllPendingSlots takes integer this returns nothing
            local integer i= 0
            loop
                exitwhen i >= s__Wave_slotCount[this]
                call s__Wave_cancelSlotRemaining(this,s___Wave_slots[s__Wave_slots[this]+i])
                set i=i + 1
            endloop
            call s__Wave_clampCoreCounters(this)
        endfunction

        function s__Wave_cancelReservedSpawn takes integer this,integer s,integer pid,boolean restoreRemaining returns nothing
            if s == 0 then
                return
            endif

            set s__WaveSlot_active[s]=s__WaveSlot_active[s] - 1
            if s__WaveSlot_active[s] < 0 then
                set s__WaveSlot_active[s]=0
            endif

            if ( pid >= 0 ) and ( pid < WAVE_TRACKED_PLAYER_SLOTS ) then
                set s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid]=s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] - 1
                if s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] < 0 then
                    set s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid]=0
                endif
            endif

            set s__Wave_activeOnMap[this]=s__Wave_activeOnMap[this] - 1
            if s__WaveSlot_isBoss[s] then
                set s__Wave_activeBosses[this]=s__Wave_activeBosses[this] - 1
            else
                set s__Wave_activeUnits[this]=s__Wave_activeUnits[this] - 1
            endif

            if restoreRemaining then
                set s__WaveSlot_remaining[s]=s__WaveSlot_remaining[s] + 1
                set s__Wave_remainingToSpawn[this]=s__Wave_remainingToSpawn[this] + 1
                if s__WaveSlot_isBoss[s] then
                    set s__Wave_remainingBosses[this]=s__Wave_remainingBosses[this] + 1
                else
                    set s__Wave_remainingUnits[this]=s__Wave_remainingUnits[this] + 1
                endif
            else
                set s__Wave_totalToSpawn[this]=s__Wave_totalToSpawn[this] - 1
                set s__Wave_totalKilled[this]=s__Wave_totalKilled[this] - 1
                if s__WaveSlot_isBoss[s] then
                    set s__Wave_totalBosses[this]=s__Wave_totalBosses[this] - 1
                    set s__Wave_totalKilledBoss[this]=s__Wave_totalKilledBoss[this] - 1
                else
                    set s__Wave_totalUnits[this]=s__Wave_totalUnits[this] - 1
                    set s__Wave_totalKilledUnits[this]=s__Wave_totalKilledUnits[this] - 1
                endif
            endif
            call s__Wave_clampCoreCounters(this)
        endfunction

        function s__Wave_tryDestroyAfterTermination takes integer this returns nothing
            if s__Wave_isDestroyed[this] then
                return
            endif
            if s__Wave_terminateRequested[this] and s__Wave_activeOnMap[this] <= 0 then
                call sc__Wave_fireFinishEventOnce(this)
                call sc__Wave_destroyWave(this)
            endif
        endfunction

        function s__Wave_killAllTrackedUnits takes integer this returns nothing
            local integer i= (s__Wave_activeTrackedCount[(this)]) // INLINED!!
            local unit u
            loop
                exitwhen i < 1 or s__Wave_isDestroyed[this]
                set u=s__Wave_getActiveIndexedUnit(this,i)
                if ( u != null ) and ( GetUnitTypeId(u) != 0 ) and UnitAlive(u) then
                    call KillUnit(u)
                endif
                set i=i - 1
            endloop
            set u=null
        endfunction

        // modeKillAlive = false:
        //   cancela por completo lo pendiente y espera a que mueran las unidades vivas.
        // modeKillAlive = true:
        //   cancela pendiente y mata todas las unidades vivas de la instancia.
        function s__Wave_terminate takes integer this,boolean modeKillAlive returns nothing
            if s__Wave_isDestroyed[this] then
                return
            endif
            set s__Wave_terminateRequested[this]=true
            set s__Wave_cancelPendingPermanently[this]=true
            // Al terminar por API tambiÃ©n queremos ejecutar callback final (RestTime/endF).
            set s__Wave_suppressEndCallback[this]=false
            set s__Wave_isRunning[this]=false
            set s__Wave_isPaused[this]=true
            set s__Wave_isFinishing[this]=true

            if s__Wave_loopTimer[this] != null then
                call PauseTimer(s__Wave_loopTimer[this])
            endif

            call s__Wave_cancelAllPendingSlots(this)
            set s__Wave_waveToken[this]=s__Wave_waveToken[this] + 1

            if modeKillAlive then
                call s__Wave_killAllTrackedUnits(this)
            endif

            // Al terminar por API, forzamos refresco inmediato de multiboard.
            call sc__Wave_refreshBoard(this)

            call s__Wave_tryDestroyAfterTermination(this)
        endfunction

        function s__Wave_compactNearUnits takes integer this returns nothing
            local integer i= 0
            local integer write= 0
            local unit u
            loop
                exitwhen i >= s__Wave_nearUnitCount[this]
                set u=s___Wave_nearUnits[s__Wave_nearUnits[this]+i]
                if ( u != null ) and ( GetUnitTypeId(u) != 0 ) then
                    set s___Wave_nearUnits[s__Wave_nearUnits[this]+write]=u
                    set write=write + 1
                endif
                set i=i + 1
            endloop
            set s__Wave_nearUnitCount[this]=write
            set u=null
        endfunction

        function s__Wave_getRandomPointIndex takes integer this returns integer
            if s__Wave_pointCount[this] == 0 then
                call WaveDebugLog("getRandomPointIndex reject reason=no_points")
                return - 1
            endif
            return GetRandomInt(0, s__Wave_pointCount[this] - 1)
        endfunction

        function s__Wave_tryGetNearUnitPoint takes integer this,real radius returns boolean
            local integer tries= 10
            local integer index
            local unit u
            local real angle
            local real dist
            local real x
            local real y

            if s__Wave_nearUnitCount[this] == 0 then
                return false
            endif

            loop
                exitwhen tries <= 0

                set index=GetRandomInt(0, s__Wave_nearUnitCount[this] - 1)
                set u=s___Wave_nearUnits[s__Wave_nearUnits[this]+index]

                if u != null and GetUnitTypeId(u) != 0 and UnitAlive(u) then
                    set angle=GetRandomReal(0.0, 6.28318)
                    set dist=GetRandomReal(64.0, radius)

                    set x=GetUnitX(u) + dist * Cos(angle)
                    set y=GetUnitY(u) + dist * Sin(angle)

                    // false = caminable
                    if not IsTerrainPathable(x, y, PATHING_TYPE_WALKABILITY) then
                        set s__Wave_spawnX[this]=x
                        set s__Wave_spawnY[this]=y
                        return true
                    endif
                endif

                set tries=tries - 1
            endloop

            return false
        endfunction

        function s__Wave_selectSpawnPoint takes integer this,real radius returns boolean
            local integer roll
            local integer pIndex

            set roll=GetRandomInt(1, 100)

            // Intentar spawn cerca de unidad
            if roll <= s__Wave_nearUnitChance[this] then
                if s__Wave_tryGetNearUnitPoint(this,radius) then
                    return true
                endif
            endif

            // Fallback a puntos base
            set pIndex=s__Wave_getRandomPointIndex(this)
            if pIndex >= 0 then
                set s__Wave_spawnX[this]=s___Wave_pointX[s__Wave_pointX[this]+pIndex]
                set s__Wave_spawnY[this]=s___Wave_pointY[s__Wave_pointY[this]+pIndex]
                return true
            endif

            return false
        endfunction

        // Iniciar la wave
        function s__Wave_start takes integer this returns nothing
            if s__Wave_isDestroyed[this] or ( s__Wave_loopTimer[this] != null ) then
                return
            endif
            set s__Wave_loopTimer[this]=(NewTimerEx(0)) // INLINED!!
            call SetTimerDebugTag(s__Wave_loopTimer[this] , TIMER_DEBUG_TAG_WAVE_CORE)
            call SaveInteger(Table__ht, (WaveByTimer), (GetHandleId(s__Wave_loopTimer[this])), ( this)) // INLINED!!
            call TimerStart(s__Wave_loopTimer[this], s__Wave_interval[this], true, function Wave_onTick)
            set s__Wave_isRunning[this]=true
            set s__Wave_isPaused[this]=false
            set s__Wave_isFinishing[this]=false
            set s__Wave_tickCounter[this]=0
            call WaveTest___WaveFireStart(this)
        endfunction

        function s__Wave_pause takes integer this returns nothing
            if s__Wave_isDestroyed[this] or ( not s__Wave_isRunning[this] ) or s__Wave_isPaused[this] then
                return
            endif
            if s__Wave_loopTimer[this] != null then
                call PauseTimer(s__Wave_loopTimer[this])
            endif
            set s__Wave_isPaused[this]=true
            call WaveTest___WaveFirePause(this)
        endfunction

        function s__Wave_resume takes integer this returns nothing
            if s__Wave_isDestroyed[this] or ( not s__Wave_isRunning[this] ) or ( not s__Wave_isPaused[this] ) then
                return
            endif
            if s__Wave_loopTimer[this] != null then
                call TimerStart(s__Wave_loopTimer[this], s__Wave_interval[this], true, function Wave_onTick)
            endif
            set s__Wave_isPaused[this]=false
            call WaveTest___WaveFireResume(this)
        endfunction

        //==================================================
        function s__Wave_isTrackedPid takes integer this,integer pid returns boolean
            return ( pid >= 0 ) and ( pid < WAVE_TRACKED_PLAYER_SLOTS )
        endfunction

        function s__Wave_killGatePassed takes integer this,integer s returns boolean
            if s__WaveSlot_killGate[s] == - 1 then
                return true
            endif
            return s__Wave_totalKilled[this] <= s__WaveSlot_killGate[s]
        endfunction

        //==================================================
        // Elegir slot ()
        //==================================================
        function s__Wave_pickSlot takes integer this returns integer
            local integer i= 0
            local integer validCount= 0
            local integer pick
            local integer s
            local integer pid
            local integer maxPrio= - 1

            // 1. Encontrar prioridad mÃ¡s alta vÃ¡lida
            loop
                exitwhen i >= s__Wave_slotCount[this]
                set s=s___Wave_slots[s__Wave_slots[this]+i]
                set pid=GetPlayerId(s__WaveSlot_owner[s])

                if s__Wave_isTrackedPid(this,pid) and s__WaveSlot_remaining[s] > 0 and s__WaveSlot_active[s] < s__WaveSlot_limit[s] and s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] < s__Wave_perPlayerLimit[this] then
                    if s__Wave_killGatePassed(this,s) then
                        if s__WaveSlot_priority[s] > maxPrio then
                            set maxPrio=s__WaveSlot_priority[s]
                        endif
                    endif
                endif

                set i=i + 1
            endloop

            if maxPrio < 0 then
                return 0
            endif


            // 2. Contar slots con esa prioridad
            set i=0
            loop
                exitwhen i >= s__Wave_slotCount[this]
                set s=s___Wave_slots[s__Wave_slots[this]+i]
                set pid=GetPlayerId(s__WaveSlot_owner[s])

                if s__Wave_isTrackedPid(this,pid) and s__WaveSlot_priority[s] == maxPrio and s__WaveSlot_remaining[s] > 0 and s__WaveSlot_active[s] < s__WaveSlot_limit[s] and s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] < s__Wave_perPlayerLimit[this] then
                    if s__Wave_killGatePassed(this,s) then
                        set validCount=validCount + 1
                    endif
                endif

                set i=i + 1
            endloop

            // 3. Elegir random entre ellos
            if validCount <= 0 then
                return 0
            endif
            set pick=GetRandomInt(1, validCount)

            set i=0
            loop
                exitwhen i >= s__Wave_slotCount[this]
                set s=s___Wave_slots[s__Wave_slots[this]+i]
                set pid=GetPlayerId(s__WaveSlot_owner[s])

                if s__Wave_isTrackedPid(this,pid) and s__WaveSlot_priority[s] == maxPrio and s__WaveSlot_remaining[s] > 0 and s__WaveSlot_active[s] < s__WaveSlot_limit[s] and s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] < s__Wave_perPlayerLimit[this] then
                    if s__Wave_killGatePassed(this,s) then
                        set pick=pick - 1
                        if pick == 0 then
                            return s
                        endif
                    endif
                endif

                set i=i + 1
            endloop

            return 0 // seguridad
        endfunction

        //==================================================
        function s__Wave_trySpawn takes integer this returns nothing
            local integer s
            local integer pid
            local integer ps
            
            set s=s__Wave_pickSlot(this)

            if s == 0 then
                return
            endif

            if not s__Wave_selectSpawnPoint(this,256.0) then
                return
            endif

            set pid=GetPlayerId(s__WaveSlot_owner[s])
            if not s__Wave_isTrackedPid(this,pid) then
                return
            endif

            set s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid]=s___Wave_activeByPlayer[s__Wave_activeByPlayer[this]+pid] + 1
            set s__WaveSlot_remaining[s]=s__WaveSlot_remaining[s] - 1
            set s__WaveSlot_active[s]=s__WaveSlot_active[s] + 1
            set s__Wave_activeOnMap[this]=s__Wave_activeOnMap[this] + 1

            set s__Wave_remainingToSpawn[this]=s__Wave_remainingToSpawn[this] - 1

            if s__WaveSlot_isBoss[s] then
                set s__Wave_remainingBosses[this]=s__Wave_remainingBosses[this] - 1
                set s__Wave_activeBosses[this]=s__Wave_activeBosses[this] + 1
            else
                set s__Wave_remainingUnits[this]=s__Wave_remainingUnits[this] - 1
                set s__Wave_activeUnits[this]=s__Wave_activeUnits[this] + 1
            endif

            // 2. Crear pending spawn
            set ps=s__PendingSpawn__allocate()
            set s__PendingSpawn_wave[ps]=this
            set s__PendingSpawn_slot[ps]=s
            set s__PendingSpawn_pid[ps]=pid
            set s__PendingSpawn_waveToken[ps]=s__Wave_waveToken[this]
            set s__PendingSpawn_x[ps]=s__Wave_spawnX[this]
            set s__PendingSpawn_y[ps]=s__Wave_spawnY[this]

            if s__WaveSlot_fxId[s] > 0 and s__WaveSlot_fxId[s] <= FX_MAX then
                call DestroyEffect(AddSpecialEffect(FX_UnitIn[s__WaveSlot_fxId[s]], s__PendingSpawn_x[ps], s__PendingSpawn_y[ps]))
            endif

            // 4. Timer de spawn real
            set s__PendingSpawn_t[ps]=(NewTimerEx(0)) // INLINED!!
            call SetTimerDebugTag(s__PendingSpawn_t[ps] , TIMER_DEBUG_TAG_WAVE_CORE)
            call SaveInteger(TimerUtils___ht, 0, GetHandleId((s__PendingSpawn_t[ps] )), ( ps)) // INLINED!!
            call TimerStart(s__PendingSpawn_t[ps], 1.50, false, function PendingSpawn_execute)

        endfunction

        //==================================================
        function s__Wave_allSlotsEmpty takes integer this returns boolean
            local integer i= 0
            loop
                exitwhen i >= s__Wave_slotCount[this]
                if s__WaveSlot_remaining[s___Wave_slots[s__Wave_slots[this]+i]] > 0 then
                    return false
                endif
                set i=i + 1
            endloop
            return true
        endfunction

        // API semÃƒÂ¡ntica para IA/UI (sin romper legacy)
        function s__Wave_getToKillRemaining takes integer this returns integer
            return s__Wave_totalKilled[this]
        endfunction

        function s__Wave_getToKillUnitsRemaining takes integer this returns integer
            return s__Wave_totalKilledUnits[this]
        endfunction

        function s__Wave_getToKillBossRemaining takes integer this returns integer
            return s__Wave_totalKilledBoss[this]
        endfunction

        function s__Wave_getKillsDone takes integer this returns integer
            return s__Wave_killsDone[this]
        endfunction

        function s__Wave_getKillsDoneUnits takes integer this returns integer
            return s__Wave_killsDoneUnits[this]
        endfunction

        function s__Wave_getKillsDoneBoss takes integer this returns integer
            return s__Wave_killsDoneBoss[this]
        endfunction

        function s__Wave_isOperational takes integer this returns boolean
            return s__Wave_isRunning[this] and ( not s__Wave_isPaused[this] ) and ( not s__Wave_isDestroyed[this] )
        endfunction

        function s__Wave_refreshBoard takes integer this returns nothing
            if s__Wave_board[this] != null and s__Wave_titleFunc[this] != "" then
                set CurrentBoardContext=s__Wave_board[this]
                call ExecuteFunc(s__Wave_titleFunc[this])
                set CurrentBoardContext=null
            endif
        endfunction

        //==================================================
        function s__Wave_onTick takes integer this returns nothing
            if s__Wave_isDestroyed[this] or s__Wave_isPaused[this] then
                return
            endif
            set s__Wave_tickCounter[this]=s__Wave_tickCounter[this] + 1
            if ModuloInteger(s__Wave_tickCounter[this], 16) == 0 then
                call s__Wave_compactNearUnits(this)
            endif
            call s__Wave_trySpawn(this)

            call s__Wave_refreshBoard(this)

            if s__Wave_allSlotsEmpty(this) and s__Wave_activeOnMap[this] <= 0 then
                call sc__Wave_finish(this)
            endif
        endfunction

        //==================================================
        function s__Wave_fireFinishEventOnce takes integer this returns nothing
            if s__Wave_finishEventFired[this] then
                return
            endif
            set s__Wave_finishEventFired[this]=true
            call WaveTest___WaveFireFinish(this)
        endfunction

        //==================================================
        function s__Wave_finish takes integer this returns nothing
            if s__Wave_isDestroyed[this] or s__Wave_isFinishing[this] then
                return
            endif
            set s__Wave_isFinishing[this]=true
            call s__Wave_fireFinishEventOnce(this)
            call sc__Wave_destroyWave(this)
        endfunction

        function s__Wave_destroyWave takes integer this returns nothing
            local integer i= 0
            local integer hid
            local integer key
            local unit u

            if s__Wave_isDestroyed[this] then
                return
            endif
            set s__Wave_isDestroyed[this]=true
            set s__Wave_isRunning[this]=false
            set s__Wave_isPaused[this]=false

            // Timer
            if s__Wave_loopTimer[this] != null then
                call PauseTimer(s__Wave_loopTimer[this])
                call ReleaseTimer(s__Wave_loopTimer[this])
                call RemoveSavedInteger(Table__ht, (WaveByTimer), (GetHandleId(s__Wave_loopTimer[this]))) // INLINED!!
                set s__Wave_loopTimer[this]=null
            endif

            // Active units index cleanup
            set i=1
            loop
                exitwhen i > s__Wave_activeTrackedCount[this]
                set key=((this) * WAVE_ACTIVE_STRIDE + (i)) // INLINED!!
                set u=(LoadUnitHandle(Table__ht, (((WaveActiveUnitByKey))), (key))) // INLINED!!
                if u != null then
                    set hid=GetHandleId(u)
                    call RemoveSavedInteger(Table__ht, (WaveByUnit), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (SlotByUnit), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (ExternalIsBoss), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (WaveExternalOwnerPidByUnit), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (WaveExternalSpawnFxByUnit), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (WaveActivePosByUnit), (hid)) // INLINED!!
                endif
                call RemoveSavedInteger(Table__ht, (WaveActiveUnitByKey), (key)) // INLINED!!
                set i=i + 1
            endloop
            set s__Wave_activeTrackedCount[this]=0
            set u=null

            // Multiboard
            if s__Wave_board[this] != null then
                call RemoveSavedInteger(Table__ht, (WaveByBoard), (GetHandleId(s__Wave_board[this]))) // INLINED!!
                set s__Wave_board[this]=null
                set s__Wave_titleFunc[this]=""
            endif

            // endFunct
            if ( not s__Wave_suppressEndCallback[this] ) and s__Wave_finishFuncName[this] != "" then
                // RestTime: recibe el nombre de la funciÃƒÂ³n a ejecutar luego.
                call RestTimeOnWaveFinished((s__Wave_finishFuncName[this])) // INLINED!!
            endif

            // Slots
            set i=0
            loop
                exitwhen i >= s__Wave_slotCount[this]
                call s__WaveSlot_deallocate(s___Wave_slots[s__Wave_slots[this]+i])
                set s___Wave_slots[s__Wave_slots[this]+i]=0
                set i=i + 1
            endloop

            set s__Wave_nearUnitCount[this]=0
            set s__Wave_pointCount[this]=0
            call s__Wave_clearAffiliateUnit(this)

            call s__Wave_deallocate(this)
        endfunction

