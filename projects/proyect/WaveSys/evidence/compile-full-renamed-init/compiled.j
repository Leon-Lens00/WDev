        function s__File__get_localFileScriptName takes nothing returns string
            return "C:\\!! AllowLocalFiles\\AllowLocalFiles.bat"
        endfunction
        
        function s__File_open takes string mapName,string fileName,integer flag returns integer
            local integer this= s__File_recycler[0]
            
            if ( 0 == this ) then
                set this=s__File_instanceCount + 1
                set s__File_instanceCount=this
            else
                set s__File_recycler[0]=s__File_recycler[this]
            endif
            
            set s__File_fileIndex[this]=- 2147483648
            
            set s__File_mapName[this]=mapName
            set s__File_fileName[this]=fileName
            
            set s__File_flag[this]=flag
            
            if ( flag == s__FileIO___FlagG_READ ) then
                //if reading, go to previous file index so that the reader can auto load up the file
                set s__File_fileIndex[this]=s__File_fileIndex[this] - 1
                set s__File_dataIndex[this]=16
            elseif ( flag == s__FileIO___FlagG_WRITE ) then
                //open file for writing
                call PreloadGenClear()
                call PreloadGenStart()
            endif
            
            return this
        endfunction
        
        //loads file and returns lines out of file
        function s__File_loadline takes integer this returns nothing
            local integer i
            
            //if there are no more lines in the file, load next file
            if ( 16 == s__File_dataIndex[this] ) then
                set s__File_dataIndex[this]=0
                set s__File_fileIndex[this]=s__File_fileIndex[this] + 1
                
                //store current player names
                set i=15
                loop
                    set s__File_pname[i]=GetPlayerName(Player(i))
                
                    exitwhen 0 == i
                    set i=i - 1
                endloop
                
                //load file (sets the player names to lines in file)
                call Preloader(s__File_SAVE_GAME_FOLDER + "\\" + s__File_mapName[this] + "\\" + s__File_fileName[this] + I2S(s__File_fileIndex[this]))
                
                //flush file buffer
                call FlushChildHashtable(s__File_stringTable, this)
                
                //load lines from file to file buffer and return player names to normal
                set i=15
                loop
                    if ( s__File_pname[i] != GetPlayerName(Player(i)) ) then
                        call SaveStr(s__File_stringTable, this, i, SubString(GetPlayerName(Player(i)), 1, StringLength(GetPlayerName(Player(i)))))
                        call SetPlayerName(Player(i), s__File_pname[i])
                    endif
                
                    exitwhen 0 == i
                    set i=i - 1
                endloop
            endif
            
            //add next line of file to data
            set s__File_data[this]=s__File_data[this] + LoadStr(s__File_stringTable, this, s__File_dataIndex[this])
            set s__File_dataIndex[this]=s__File_dataIndex[this] + 1
        endfunction
        
        function s__File_read takes integer this returns string
            local integer length
            local string data= ""
            
// NO_DEBUG:             debug if (flag != Flag.READ) then
// NO_DEBUG:                 debug call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,60000,"FILE IO ERROR: ATTEMPT TO READ TO FILE OPEN FOR WRITING")
// NO_DEBUG:                 debug return null
// NO_DEBUG:             debug endif
            
            //if there is no data at the moment, get next line from file
            if ( StringLength(s__File_data[this]) < 4 ) then
                call s__File_loadline(this)
                
                //if there is no next line, return null
                if ( StringLength(s__File_data[this]) < 4 ) then
                    return null
                endif
            endif
            
            //get the length of the data (# of characters that make it up)
            set length=S2I(SubString(s__File_data[this], 0, 4))
            set s__File_data[this]=SubString(s__File_data[this], 4, StringLength(s__File_data[this]))
            
            loop
                if ( length > StringLength(s__File_data[this]) ) then
                    //if the length is greater than the data currently in the buffer, dump the
                    //entire buffer to the data being returned and get the next line
                    set length=length - StringLength(s__File_data[this])
                    set data=data + s__File_data[this]
                    set s__File_data[this]=""
                    call s__File_loadline(this)
                else
                    //if the length is less than the data in the buffer, dump that data
                    //from the buffer
                    set data=data + SubString(s__File_data[this], 0, length)
                    set s__File_data[this]=SubString(s__File_data[this], length, StringLength(s__File_data[this]))
                    set length=0
                    
                    return data
                endif
            endloop
            
            return null
        endfunction
        
        function s__File_write takes integer this,string data returns nothing
            local integer length= StringLength(data)
            local integer digits= 0
            local boolean done= false
            
// NO_DEBUG:             debug if (flag != Flag.WRITE) then
// NO_DEBUG:                 debug call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,60000,"FILE IO ERROR: ATTEMPT TO WRITE TO FILE OPEN FOR READING")
// NO_DEBUG:                 debug return
// NO_DEBUG:             debug endif
            
            //first, retrieve the # of digits for the length
            loop
                set digits=digits + 1
                set length=length / 10
                exitwhen 0 == length
            endloop
            
            //add the extra digits to and length to buffer
            set s__File_data[this]=s__File_data[this] + s__File_extra0[digits] + I2S(StringLength(data))
            
            loop
                if ( StringLength(data) > 400 ) then
                    //if the length of the data is greater than 400, throw first 400 chars into buffer
                    set s__File_data[this]=s__File_data[this] + SubString(data, 0, 400)
                    set data=SubString(data, 400, StringLength(data))
                else
                    //if the length isn't greater than 400, throw it all into the buffer
                    set s__File_data[this]=s__File_data[this] + data
                    set data=""
                    set done=true
                endif
                
                loop
                    //throw the data into file in sets of MAX_LINE_LENGTH chars until there is not
                    //enough data in the buffer to completely fill a line
                    exitwhen StringLength(s__File_data[this]) < s__File_MAX_LINE_LENGTH
                    call Preload("\")\r\n\tcall SetPlayerName(Player(" + I2S(s__File_dataIndex[this]) + "), \" " + SubString(s__File_data[this], 0, s__File_MAX_LINE_LENGTH) + "\")\r\n//")
                    set s__File_data[this]=SubString(s__File_data[this], s__File_MAX_LINE_LENGTH, StringLength(s__File_data[this]))
                    
                    set s__File_dataIndex[this]=s__File_dataIndex[this] + 1
                    if ( s__File_dataIndex[this] == 16 ) then
                        //start a new file
                        
                        set s__File_dataIndex[this]=0
                        
                        call Preload("\" )\r\nendfunction\r\nfunction AAA takes nothing returns nothing \r\n//")
                        call PreloadGenEnd(s__File_SAVE_GAME_FOLDER + "\\" + s__File_mapName[this] + "\\" + s__File_fileName[this] + I2S(s__File_fileIndex[this]))
                        
                        set s__File_fileIndex[this]=s__File_fileIndex[this] + 1
                        call PreloadGenClear()
                        call PreloadGenStart()
                    endif
                endloop
                
                exitwhen done
            endloop
        endfunction
        
        function s__File_close takes integer this returns nothing
            if ( s__File_flag[this] == s__FileIO___FlagG_READ ) then
                //flush the read buffer
                call FlushChildHashtable(s__File_stringTable, this)
            elseif ( s__File_flag[this] == s__FileIO___FlagG_WRITE ) then
                //write remaining of data to file and close it out
                call Preload("\")\r\n\tcall SetPlayerName(Player(" + I2S(s__File_dataIndex[this]) + "), \" " + s__File_data[this] + "\")\r\n//")
                call Preload("\" )\r\nendfunction\r\nfunction AAA takes nothing returns nothing \r\n//")
                call PreloadGenEnd(s__File_SAVE_GAME_FOLDER + "\\" + s__File_mapName[this] + "\\" + s__File_fileName[this] + I2S(s__File_fileIndex[this]))
            endif
            
            //deallocate and reset
            set s__File_recycler[this]=s__File_recycler[0]
            set s__File_recycler[0]=this
            
            set s__File_dataIndex[this]=0
            set s__File_data[this]=""
        endfunction
        
        function s__File_init takes nothing returns nothing
            set s__File_extra0[1]="000"
            set s__File_extra0[2]="00"
            set s__File_extra0[3]="0"
            set s__File_extra0[4]=""
            
            set s__File_stringTable=InitHashtable()
        endfunction
        
//Implemented from module FileIO___FileInit:
        function s__File_FileIO___FileInit__onInit takes nothing returns nothing
            call s__File_init()
        endfunction



