        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_SYSTEMS , 4 , WaveMultiboard__MBTaggedDebugCell("Move" , "|cFFFFCC66" , TIMER_DEBUG_TAG_MOVECAST) , 0.09)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_SYSTEMS , 5 , WaveMultiboard__MBTaggedDebugCell("Other" , "|cFFD6B3FF" , TIMER_DEBUG_TAG_OTHER) , 0.09)
        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_SYSTEMS , 6 , "" , 0.08)

        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_TEXTTAGS , 0 , "|cFFBBBBBBDebug Tags|r" , 0.14)
