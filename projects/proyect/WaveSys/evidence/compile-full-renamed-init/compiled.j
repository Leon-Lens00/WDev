        call WaveMultiboard__MBSetCell(s__Wave_board[w] , WaveMultiboard__MB_ROW_DEBUG_TEXTTAGS , 3 , WaveMultiboard__MBTextTagTotalCell("Move" , "|cFFFFCC66" , GetTextTagDebugLive(TEXTTAG_DEBUG_MOVECAST) , GetTextTagDebugPeak(TEXTTAG_DEBUG_MOVECAST)) , 0.09)
