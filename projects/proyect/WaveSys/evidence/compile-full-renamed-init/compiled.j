    function UnitTypeMissileLoadout___Init takes nothing returns nothing
        set UnitTypeMissileLoadout___byType=s__Table_create()
    endfunction


    function InitDefaultWaveOwnerResearches takes nothing returns nothing
        local integer i= 8
        local integer researchedLevel= s__User_AmountPlaying

        loop
            exitwhen i > 12
            call SetPlayerTechResearched(Player(i), 'Rhar', researchedLevel)
            set i=i + 1
        endloop
    endfunction




    function WaveSkillVisuals___WaveSkillVisualUnitAlive takes unit u returns boolean
        return u != null and GetUnitTypeId(u) != 0 and UnitAlive(u)
    endfunction

    function WaveSkillVisualScaleForRadius takes real radius returns real
        if radius <= 0.0 then
            return 0.01
        endif
        return radius / 100.0
    endfunction

    function WaveSkillVisualShieldScaleForRadius takes real radius returns real
        if radius <= 0.0 then
            return 0.01
        endif
        return radius / 300.0
    endfunction

    function WaveSkillVisuals___WaveSkillVisualAdd takes integer visualId returns nothing
        set WaveSkillVisuals___WaveSkillVisualPrev[visualId]=0
        set WaveSkillVisuals___WaveSkillVisualNext[visualId]=WaveSkillVisuals___WaveSkillVisualHead
        if WaveSkillVisuals___WaveSkillVisualHead != 0 then
            set WaveSkillVisuals___WaveSkillVisualPrev[WaveSkillVisuals___WaveSkillVisualHead]=visualId
        endif
        set WaveSkillVisuals___WaveSkillVisualHead=visualId
    endfunction

    function WaveSkillVisuals___WaveSkillVisualRemove takes integer visualId returns nothing
        local integer p= WaveSkillVisuals___WaveSkillVisualPrev[visualId]
        local integer n= WaveSkillVisuals___WaveSkillVisualNext[visualId]
        if p != 0 then
            set WaveSkillVisuals___WaveSkillVisualNext[p]=n
        else
            set WaveSkillVisuals___WaveSkillVisualHead=n
        endif
        if n != 0 then
            set WaveSkillVisuals___WaveSkillVisualPrev[n]=p
        endif
        set WaveSkillVisuals___WaveSkillVisualPrev[visualId]=0
        set WaveSkillVisuals___WaveSkillVisualNext[visualId]=0
    endfunction

    function WaveSkillVisuals___WaveSkillVisualCreateDummy takes real x,real y,real facing,real scale returns unit
        local unit dummy= CreateUnit(Player(PLAYER_NEUTRAL_PASSIVE), WaveSkillVisuals_WAVE_SKILL_VISUAL_DUMMY_ID, x, y, facing)
        if dummy != null and GetUnitTypeId(dummy) != 0 then
            call UnitAddAbility(dummy, WaveSkillVisuals_WAVE_SKILL_VISUAL_LOCUST_ID)
            call UnitAddAbility(dummy, WaveSkillVisuals_WAVE_SKILL_VISUAL_INVUL_ID)
            call SetUnitPathing(dummy, false)
            call SetUnitScale(dummy, scale, scale, scale)
        endif
        return dummy
    endfunction

    function WaveSkillVisualDestroy takes integer visualId returns nothing
        local unit dummy
        if visualId <= 0 or WaveSkillVisuals___WaveSkillVisualKind[visualId] == 0 then
            return
        endif
        call WaveSkillVisuals___WaveSkillVisualRemove(visualId)
        set dummy=WaveSkillVisuals___WaveSkillVisualDummy[visualId]
        if WaveSkillVisuals___WaveSkillVisualFx[visualId] != null then
            call DestroyEffect(WaveSkillVisuals___WaveSkillVisualFx[visualId])
            set WaveSkillVisuals___WaveSkillVisualFx[visualId]=null
        endif
        if dummy != null and GetUnitTypeId(dummy) != 0 then
            call RemoveUnit(dummy)
        endif
        set WaveSkillVisuals___WaveSkillVisualDummy[visualId]=null
        set WaveSkillVisuals___WaveSkillVisualSource[visualId]=null
        set WaveSkillVisuals___WaveSkillVisualKind[visualId]=0
        set WaveSkillVisuals___WaveSkillVisualRemaining[visualId]=0.0
    endfunction

    function WaveSkillVisualSetPosition takes integer visualId,real x,real y,real facing returns nothing
        local unit dummy= WaveSkillVisuals___WaveSkillVisualDummy[visualId]
        if visualId <= 0 or dummy == null or GetUnitTypeId(dummy) == 0 then
            set dummy=null
            return
        endif
        call SetUnitX(dummy, x)
        call SetUnitY(dummy, y)
        call SetUnitFacing(dummy, facing)
        set dummy=null
    endfunction

    function WaveSkillVisualSetRemaining takes integer visualId,real duration returns nothing
        if visualId <= 0 then
            return
        endif
        if duration <= 0.0 then
            call WaveSkillVisualDestroy(visualId)
            return
        endif
        set WaveSkillVisuals___WaveSkillVisualRemaining[visualId]=duration
    endfunction

    function WaveSkillVisuals___WaveSkillVisualTick takes nothing returns nothing
        local integer visualId= WaveSkillVisuals___WaveSkillVisualHead
        local integer nextVisualId
        local unit source
        loop
            exitwhen visualId == 0
            set nextVisualId=WaveSkillVisuals___WaveSkillVisualNext[visualId]
            if WaveSkillVisuals___WaveSkillVisualKind[visualId] == WaveSkillVisuals___WAVE_SKILL_VISUAL_KIND_FOLLOWER then
                set source=WaveSkillVisuals___WaveSkillVisualSource[visualId]
                if not WaveSkillVisuals___WaveSkillVisualUnitAlive(source) then
                    call WaveSkillVisualDestroy(visualId)
                else
                    call WaveSkillVisualSetPosition(visualId , GetUnitX(source) , GetUnitY(source) , GetUnitFacing(source))
                endif
            elseif WaveSkillVisuals___WaveSkillVisualKind[visualId] == WaveSkillVisuals___WAVE_SKILL_VISUAL_KIND_TIMED then
                set WaveSkillVisuals___WaveSkillVisualRemaining[visualId]=WaveSkillVisuals___WaveSkillVisualRemaining[visualId] - WaveSkillVisuals_WAVE_SKILL_VISUAL_TICK
                if WaveSkillVisuals___WaveSkillVisualRemaining[visualId] <= 0.0 then
                    call WaveSkillVisualDestroy(visualId)
                endif
            else
                call WaveSkillVisualDestroy(visualId)
            endif
            set visualId=nextVisualId
            set source=null
        endloop

        if WaveSkillVisuals___WaveSkillVisualHead == 0 and WaveSkillVisuals___WaveSkillVisualTimerRunning then
            call PauseTimer(WaveSkillVisuals___WaveSkillVisualTimer)
            set WaveSkillVisuals___WaveSkillVisualTimerRunning=false
        endif
    endfunction

    function WaveSkillVisuals___WaveSkillVisualEnsureTimer takes nothing returns nothing
        if not WaveSkillVisuals___WaveSkillVisualTimerRunning then
            set WaveSkillVisuals___WaveSkillVisualTimerRunning=true
            call TimerStart(WaveSkillVisuals___WaveSkillVisualTimer, WaveSkillVisuals_WAVE_SKILL_VISUAL_TICK, true, function WaveSkillVisuals___WaveSkillVisualTick)
        endif
    endfunction

    function WaveSkillVisualCreateFollowerScaled takes unit source,string modelPath,real scale returns integer
        local integer visualId
        local unit dummy
        if not WaveSkillVisuals___WaveSkillVisualUnitAlive(source) or modelPath == "" then
            return 0
        endif
        set visualId=WaveSkillVisuals___WaveSkillVisualCount + 1
        set WaveSkillVisuals___WaveSkillVisualCount=visualId
        set dummy=WaveSkillVisuals___WaveSkillVisualCreateDummy(GetUnitX(source) , GetUnitY(source) , GetUnitFacing(source) , scale)
        if dummy == null or GetUnitTypeId(dummy) == 0 then
            set dummy=null
            return 0
        endif
        set WaveSkillVisuals___WaveSkillVisualKind[visualId]=WaveSkillVisuals___WAVE_SKILL_VISUAL_KIND_FOLLOWER
        set WaveSkillVisuals___WaveSkillVisualSource[visualId]=source
        set WaveSkillVisuals___WaveSkillVisualDummy[visualId]=dummy
        set WaveSkillVisuals___WaveSkillVisualFx[visualId]=AddSpecialEffectTarget(modelPath, dummy, WaveSkillVisuals_WAVE_SKILL_VISUAL_ATTACH_POINT)
        set WaveSkillVisuals___WaveSkillVisualRemaining[visualId]=0.0
        call WaveSkillVisuals___WaveSkillVisualAdd(visualId)
        call WaveSkillVisuals___WaveSkillVisualEnsureTimer()
        set dummy=null
        return visualId
    endfunction

    function WaveSkillVisualCreateFollower takes unit source,string modelPath,real radius returns integer
        return WaveSkillVisualCreateFollowerScaled(source , modelPath , WaveSkillVisualScaleForRadius(radius))
    endfunction

    function WaveSkillVisualCreateTimedMarkerScaled takes real x,real y,real facing,string modelPath,real scale,real duration returns integer
        local integer visualId
        local unit dummy
        if modelPath == "" or duration <= 0.0 then
            return 0
        endif
        set visualId=WaveSkillVisuals___WaveSkillVisualCount + 1
        set WaveSkillVisuals___WaveSkillVisualCount=visualId
        set dummy=WaveSkillVisuals___WaveSkillVisualCreateDummy(x , y , facing , scale)
        if dummy == null or GetUnitTypeId(dummy) == 0 then
            set dummy=null
            return 0
        endif
        set WaveSkillVisuals___WaveSkillVisualKind[visualId]=WaveSkillVisuals___WAVE_SKILL_VISUAL_KIND_TIMED
        set WaveSkillVisuals___WaveSkillVisualSource[visualId]=null
        set WaveSkillVisuals___WaveSkillVisualDummy[visualId]=dummy
        set WaveSkillVisuals___WaveSkillVisualFx[visualId]=AddSpecialEffectTarget(modelPath, dummy, WaveSkillVisuals_WAVE_SKILL_VISUAL_ATTACH_POINT)
        set WaveSkillVisuals___WaveSkillVisualRemaining[visualId]=duration
        call WaveSkillVisuals___WaveSkillVisualAdd(visualId)
        call WaveSkillVisuals___WaveSkillVisualEnsureTimer()
        set dummy=null
        return visualId
    endfunction

    function WaveSkillVisualCreateTimedMarker takes real x,real y,real facing,string modelPath,real radius,real duration returns integer
        return WaveSkillVisualCreateTimedMarkerScaled(x , y , facing , modelPath , WaveSkillVisualScaleForRadius(radius) , duration)
    endfunction

    function WaveSkillVisuals___Init takes nothing returns nothing
        set WaveSkillVisuals___WaveSkillVisualTimer=(NewTimerEx(0)) // INLINED!!
        call SetTimerDebugTag(WaveSkillVisuals___WaveSkillVisualTimer , TIMER_DEBUG_TAG_UNIT_SKILLS)
        set WaveSkillVisuals___WaveSkillVisualTimerRunning=true
        call TimerStart(WaveSkillVisuals___WaveSkillVisualTimer, WaveSkillVisuals_WAVE_SKILL_VISUAL_TICK, true, function WaveSkillVisuals___WaveSkillVisualTick)
    endfunction



