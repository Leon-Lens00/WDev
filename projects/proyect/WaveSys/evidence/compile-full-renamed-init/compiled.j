    function AudioPreloadConfig__PreloadMapResourcesTick takes nothing returns nothing
        local string path= AudioPreloadConfig__GetPreloadSoundPath(AudioPreloadConfig__PreloadResCursor)
        if path == "" then
            call PauseTimer(AudioPreloadConfig__PreloadResTimer)
            call DestroyTimer(AudioPreloadConfig__PreloadResTimer)
            set AudioPreloadConfig__PreloadResTimer=null
            return
        endif
        call AudioPreloadConfig__WarmupSound(path)
        set AudioPreloadConfig__PreloadResCursor=AudioPreloadConfig__PreloadResCursor + 1
    endfunction

    function PreloadMapResources takes nothing returns nothing
        set AudioPreloadConfig__PreloadResCursor=1
        if AudioPreloadConfig__PreloadResTimer != null then
            call PauseTimer(AudioPreloadConfig__PreloadResTimer)
            call DestroyTimer(AudioPreloadConfig__PreloadResTimer)
        endif
        set AudioPreloadConfig__PreloadResTimer=CreateTimer()
        call TimerStart(AudioPreloadConfig__PreloadResTimer, 0.10, true, function AudioPreloadConfig__PreloadMapResourcesTick)
    endfunction


//*************************************************
//* BoundSentinel
//* -------------
//*  Don't leave your units unsupervised, naughty
//* them may try to get out of the map bounds and
//* crash your game.
//*
//*  To implement, just get a vJass compiler and
//* copy this library/trigger to your map.
//*
//*************************************************

//==================================================

   //=========================================================================================

   //=======================================================================
   function BoundSentinel__dis takes nothing returns nothing
    local unit u=GetTriggerUnit()
    local real x=GetUnitX(u)
    local real y=GetUnitY(u)

       if ( x > BoundSentinel__maxx ) then
           set x=BoundSentinel__maxx
       elseif ( x < BoundSentinel__minx ) then
           set x=BoundSentinel__minx
       endif
       if ( y > BoundSentinel__maxy ) then
           set y=BoundSentinel__maxy
       elseif ( y < BoundSentinel__miny ) then
           set y=BoundSentinel__miny
       endif
       call SetUnitX(u, x)
       call SetUnitY(u, y)
    set u=null
   endfunction

   function BoundSentinel__init takes nothing returns nothing
    local trigger t=CreateTrigger()
    local region r=CreateRegion()
    local rect rc

       set BoundSentinel__minx=GetCameraBoundMinX() - BoundSentinel__EXTRA
       set BoundSentinel__miny=GetCameraBoundMinY() - BoundSentinel__EXTRA
       set BoundSentinel__maxx=GetCameraBoundMaxX() + BoundSentinel__EXTRA
       set BoundSentinel__maxy=GetCameraBoundMaxY() + BoundSentinel__EXTRA
       set rc=Rect(BoundSentinel__minx, BoundSentinel__miny, BoundSentinel__maxx, BoundSentinel__maxy)
       call RegionAddRect(r, rc)
       call RemoveRect(rc)

       call TriggerRegisterLeaveRegion(t, r, null)
       call TriggerAddAction(t, function BoundSentinel__dis)

    //this is not necessary but I'll do it anyway:
    set t=null
    set r=null
    set rc=null
   endfunction


    // Compatibilidad con GUI-style init.
    // El trigger de seleccion del heroe fue removido porque MenuClient ya se muestra desde Selection/RestTime.
    function AuditInit_ShowMenuClient takes nothing returns nothing
    endfunction


    

    function EnemyPreviewConfig__ClampEnemyPreviewWave takes integer waveId returns integer
        if waveId < 1 then
            return 1
        endif
        if waveId > EnemyPreviewConfig__ENEMY_PREVIEW_MAX_WAVES then
            return EnemyPreviewConfig__ENEMY_PREVIEW_MAX_WAVES
        endif
        return waveId
    endfunction

    function EnemyPreviewSetModelPath takes integer waveId,string path returns nothing
        set waveId=EnemyPreviewConfig__ClampEnemyPreviewWave(waveId)
        if path == null then
            set path=""
        endif
        set EnemyPreviewConfig__EnemyPreviewModelPath[waveId]=path
    endfunction

    function EnemyPreviewGetModelPath takes integer waveId returns string
        set waveId=EnemyPreviewConfig__ClampEnemyPreviewWave(waveId)
        if EnemyPreviewConfig__EnemyPreviewModelPath[waveId] == null then
            return ""
        endif
        return EnemyPreviewConfig__EnemyPreviewModelPath[waveId]
    endfunction

    function EnemyPreviewSetModelScale takes integer waveId,real scale returns nothing
        set waveId=EnemyPreviewConfig__ClampEnemyPreviewWave(waveId)
        if scale <= 0.0 then
            set scale=1.00
        endif
        set EnemyPreviewConfig__EnemyPreviewModelScale[waveId]=scale
    endfunction

    function EnemyPreviewGetModelScale takes integer waveId returns real
        set waveId=EnemyPreviewConfig__ClampEnemyPreviewWave(waveId)
        if EnemyPreviewConfig__EnemyPreviewModelScale[waveId] <= 0.0 then
            return 1.00
        endif
        return EnemyPreviewConfig__EnemyPreviewModelScale[waveId]
    endfunction

    function EnemyPreviewSetModel takes integer waveId,string path,real scale returns nothing
        call EnemyPreviewSetModelPath(waveId , path)
        call EnemyPreviewSetModelScale(waveId , scale)
    endfunction

    function EnemyPreviewSetText takes integer waveId,string text returns nothing
        set waveId=EnemyPreviewConfig__ClampEnemyPreviewWave(waveId)
        if text == null then
            set text=""
        endif
        set EnemyPreviewConfig__EnemyPreviewText[waveId]=text
    endfunction

    function EnemyPreviewGetText takes integer waveId returns string
        set waveId=EnemyPreviewConfig__ClampEnemyPreviewWave(waveId)
        if EnemyPreviewConfig__EnemyPreviewText[waveId] == null or EnemyPreviewConfig__EnemyPreviewText[waveId] == "" then
            return "Enemy info\nNo preview yet"
        endif
        return EnemyPreviewConfig__EnemyPreviewText[waveId]
    endfunction

