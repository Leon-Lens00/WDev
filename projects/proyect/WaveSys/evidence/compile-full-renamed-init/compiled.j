function sa__Wave_destroyWave takes nothing returns boolean
local integer this=f__arg_this
            local integer i= 0
            local integer hid
            local integer key
            local unit u
            if s__Wave_isDestroyed[this] then
return true
            endif
            set s__Wave_isDestroyed[this]=true
            set s__Wave_isRunning[this]=false
            set s__Wave_isPaused[this]=false
            if s__Wave_loopTimer[this] != null then
                call PauseTimer(s__Wave_loopTimer[this])
                call ReleaseTimer(s__Wave_loopTimer[this])
                call RemoveSavedInteger(Table__ht, (WaveByTimer), (GetHandleId(s__Wave_loopTimer[this]))) // INLINED!!
                set s__Wave_loopTimer[this]=null
            endif
            set i=1
            loop
                exitwhen i > s__Wave_activeTrackedCount[this]
                set key=((this) * WAVE_ACTIVE_STRIDE + (i)) // INLINED!!
                set u=(LoadUnitHandle(Table__ht, (((WaveActiveUnitByKey))), (key))) // INLINED!!
                if u != null then
                    set hid=GetHandleId(u)
                    call RemoveSavedInteger(Table__ht, (WaveByUnit), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (SlotByUnit), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (ExternalIsBoss), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (WaveExternalOwnerPidByUnit), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (WaveExternalSpawnFxByUnit), (hid)) // INLINED!!
                    call RemoveSavedInteger(Table__ht, (WaveActivePosByUnit), (hid)) // INLINED!!
                endif
                call RemoveSavedInteger(Table__ht, (WaveActiveUnitByKey), (key)) // INLINED!!
                set i=i + 1
            endloop
            set s__Wave_activeTrackedCount[this]=0
            set u=null
            if s__Wave_board[this] != null then
                call RemoveSavedInteger(Table__ht, (WaveByBoard), (GetHandleId(s__Wave_board[this]))) // INLINED!!
                set s__Wave_board[this]=null
                set s__Wave_titleFunc[this]=""
            endif
            if ( not s__Wave_suppressEndCallback[this] ) and s__Wave_finishFuncName[this] != "" then
                call RestTimeOnWaveFinished((s__Wave_finishFuncName[this])) // INLINED!!
            endif
            set i=0
            loop
                exitwhen i >= s__Wave_slotCount[this]
                call s__WaveSlot_deallocate(s___Wave_slots[s__Wave_slots[this]+i])
                set s___Wave_slots[s__Wave_slots[this]+i]=0
                set i=i + 1
            endloop
            set s__Wave_nearUnitCount[this]=0
            set s__Wave_pointCount[this]=0
            call s__Wave_clearAffiliateUnit(this)
            call s__Wave_deallocate(this)
   return true
endfunction
function sa__Client_show takes nothing returns boolean
local integer this=f__arg_this
local boolean flag=f__arg_boolean1
local integer cam=f__arg_integer1
            local integer current= 0
            local boolean wasDisplayed= s__Client_displayed[this]
            set s__Client_camera[this]=cam
            if flag then
                if not wasDisplayed then
                    set s__Client_DisplayCount=s__Client_DisplayCount + 1
                    if s__Client_DisplayCount >= 1 then
                        call PauseTimer(s__Client_UpdateTimer)
                        call TimerStart(s__Client_UpdateTimer, 0.01, true, function s__Client_onDisplay)
                    endif
                endif
                if s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]] != null then
                    set current=(s__Client_UnitsIndex[GetUnitUserData((s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]]))]) // INLINED!!
                endif
                if s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]] != null and s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]] != s__Client_unit[this] and current != 0 and current != this then
                    call s__Client_show(current,false , s__Client_camera[this])
                endif
                set s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]]=s__Client_unit[this]
            elseif wasDisplayed then
                if s__Client_DisplayCount > 0 then
                    set s__Client_DisplayCount=s__Client_DisplayCount - 1
                endif
                if s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]] == s__Client_unit[this] then
                    set s__Client_PlayerCurrentUnit[s__User_id[s__Client_user[this]]]=null
                endif
                if s__Client_DisplayCount == 0 then
                    call PauseTimer(s__Client_UpdateTimer)
                else
                    call PauseTimer(s__Client_UpdateTimer)
                    call TimerStart(s__Client_UpdateTimer, 0.03125, true, function s__Client_onDisplay)
                endif
                call MenuClient__ResetMenuCameraFog(s__Client_player[this])
                set MenuClient__PlayerMenuFogAppliedHeight[s__User_id[s__Client_user[this]]]=- 1.
                if s__User_Local == s__Client_player[this] then
                    call ResetToGameCamera(0)
                endif
            endif
            set s__Client_displayed[this]=flag
            call s__Client_applyVisualState(this)
   return true
endfunction
