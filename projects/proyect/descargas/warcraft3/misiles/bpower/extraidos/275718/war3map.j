    if ( not ( GetTriggerUnit() == gg_unit_nfro_0025 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Click_Any_Unit_Func001Func001Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == gg_unit_ewsp_0024 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Click_Any_Unit_Func001Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == gg_unit_hgyr_0023 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Click_Any_Unit_Func001C takes nothing returns boolean
    if ( not ( GetTriggerUnit() == gg_unit_hsor_0022 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Click_Any_Unit_Actions takes nothing returns nothing
    if ( Trig_Click_Any_Unit_Func001C() ) then
        call TriggerExecute(gg_trg_Click_Sorceress)
    else
        if ( Trig_Click_Any_Unit_Func001Func001C() ) then
            call ConditionalTriggerExecute(gg_trg_Click_Gyrocopter)
        else
            if ( Trig_Click_Any_Unit_Func001Func001Func001C() ) then
                call ConditionalTriggerExecute(gg_trg_Click_Wisp)
            else
                if ( Trig_Click_Any_Unit_Func001Func001Func001Func001C() ) then
                    call ConditionalTriggerExecute(gg_trg_Click_Frog)
                else
                endif
            endif
        endif
    endif
endfunction

