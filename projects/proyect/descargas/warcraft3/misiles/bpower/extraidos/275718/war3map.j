//===========================================================================
// Trigger: Click Sorceress
//===========================================================================
function Trig_Click_Sorceress_Func002C takes nothing returns boolean
    if ( not ( udg_EVENT_MISSILE_COLLIDE_DEST == udg_Missile__EventId ) ) then
        return false
    endif
    return true
endfunction

function Trig_Click_Sorceress_Actions takes nothing returns nothing
    // Demo of missile collides with a destructable. 
    if ( Trig_Click_Sorceress_Func002C() ) then
        call DisplayTextToForce(GetPlayersAll(), ( "Sorceress missile just hit " + GetDestructableName(udg_Missile__DestructableHit) ))
        call SetDestructableAnimationBJ(udg_Missile__DestructableHit, "stand hit")
        set udg_Missile__WantDestroy=true
    else
        set bj_forLoopAIndex=1
        set bj_forLoopAIndexEnd=5
        loop
            exitwhen bj_forLoopAIndex > bj_forLoopAIndexEnd
            call TriggerExecute(gg_trg_Missile_Configurate)
            set udg_Missile__Origin=GetUnitLoc(gg_unit_hsor_0022)
            set udg_Missile__OriginZ=50.00
            set udg_Missile__Impact=Location(- 1950.00, 400.00)
            set udg_Missile__ImpactZ=0.00
            set udg_Missile__Speed=500.00
            set udg_Missile__Collision=64.00
            set udg_Missile__Arc=GetRandomReal(15.00, 65.00)
            set udg_Missile__Curve=GetRandomReal(- 15.00, 15.00)
            set udg_Missile__Model="Abilities\\Weapons\\DemonHunterMissile\\DemonHunterMissile.mdl"
            // Set trigger with should run on missile events.
            set udg_Missile__OnCollideDestructable=gg_trg_Click_Sorceress
            call TriggerExecute(gg_trg_Missile)
            call TriggerSleepAction(0.35)
            set bj_forLoopAIndex=bj_forLoopAIndex + 1
        endloop
    endif
endfunction

