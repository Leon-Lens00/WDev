//===========================================================================
// Trigger: Click Frog
//===========================================================================
function Trig_Click_Frog_Func001Func001C takes nothing returns boolean
    if ( not ( IsUnitEnemy(udg_Missile__UnitHit, udg_Missile__Owner) == true ) ) then
        return false
    endif
    if ( not ( udg_Missile__UnitHit != gg_unit_nfro_0025 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Click_Frog_Func001C takes nothing returns boolean
    if ( not ( udg_Missile__EventId == udg_EVENT_MISSILE_COLLIDE_UNIT ) ) then
        return false
    endif
    return true
endfunction

function Trig_Click_Frog_Actions takes nothing returns nothing
    if ( Trig_Click_Frog_Func001C() ) then
        if ( Trig_Click_Frog_Func001Func001C() ) then
            call CreateTextTagUnitBJ("TRIGSTR_025", udg_Missile__UnitHit, 0, 10, 100, 100, 100, 0)
            call SetTextTagPermanentBJ(GetLastCreatedTextTag(), false)
            call SetTextTagLifespanBJ(GetLastCreatedTextTag(), 1.00)
            set udg_Missile__WantDestroy=true
        else
        endif
    else
        call TriggerExecute(gg_trg_Missile_Configurate)
        set udg_Missile__Owner=Player(0)
        // When can also let Missile build an origin from a source unit. 
        set udg_Missile__Source=gg_unit_nfro_0025
        set udg_Missile__OriginZ=0.00
        // When can also let Missile build an impact from a distance and radian angle value. 
        set udg_Missile__Distance=1300.00
        set udg_Missile__Angle=Deg2Rad(90)
        set udg_Missile__Arc=GetRandomReal(15.00, 65.00)
        set udg_Missile__ImpactZ=55.00
        set udg_Missile__Speed=500.00
        set udg_Missile__Collision=32.00
        set udg_Missile__Model="Abilities\\Weapons\\RedDragonBreath\\RedDragonMissile.mdl"
        set udg_Missile__OnCollideUnit=gg_trg_Click_Frog
        call TriggerExecute(gg_trg_Missile)
    endif
endfunction

