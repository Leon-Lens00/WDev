{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wc3-forge:scene:v2",
  "title": "Classic tropical recomposition profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source",
    "source_sha256",
    "install",
    "dotnet",
    "host",
    "seed",
    "sample",
    "edit",
    "path_width",
    "collision_radius",
    "trees",
    "plants",
    "rocks",
    "wfc_tries",
    "mode",
    "shadows",
    "recompose",
    "wfc_steps"
  ],
  "properties": {
    "format": {
      "const": "wc3-scene-spec-v2"
    },
    "mode": {
      "const": "whole-map-recompose"
    },
    "shadows": {
      "const": "omit"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "install": {
      "type": "string",
      "minLength": 1
    },
    "dotnet": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "sample": {
      "$ref": "#/$defs/rect"
    },
    "edit": {
      "$ref": "#/$defs/rect"
    },
    "protected": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 0
    },
    "path": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 0
    },
    "path_width": {
      "type": "number",
      "minimum": 128,
      "maximum": 1024
    },
    "collision_radius": {
      "type": "number",
      "minimum": 1
    },
    "trees": {
      "$ref": "#/$defs/assets"
    },
    "plants": {
      "$ref": "#/$defs/assets"
    },
    "rocks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 4
      }
    },
    "waterfall": {
      "type": "object",
      "description": "Legacy zero-value field emitted by the shared Go serializer; unused in recomposition."
    },
    "wfc_tries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "wfc_steps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "recompose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seeds",
        "layout_attempts",
        "min_displacement",
        "max_source_iou",
        "compositions"
      ],
      "properties": {
        "seeds": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "layout_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "min_displacement": {
          "type": "number",
          "minimum": 1536
        },
        "max_source_iou": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.7
        },
        "compositions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/composition"
          }
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/point"
        },
        "max": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 4
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "blend",
        "rotations",
        "anchors"
      ],
      "properties": {
        "id": {
          "enum": [
            "circle",
            "temple",
            "platform",
            "lagoon",
            "bridge",
            "waterfall"
          ]
        },
        "source": {
          "$ref": "#/$defs/rect"
        },
        "blend": {
          "type": "number",
          "minimum": 256,
          "maximum": 1024
        },
        "rotations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": 0
          }
        },
        "anchors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/point"
          }
        },
        "adjustments": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/point"
          }
        }
      }
    }
  }
}
