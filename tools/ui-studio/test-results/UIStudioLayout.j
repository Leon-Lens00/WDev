// UI Studio | Warcraft III 1.27b | InventorySys 1.4.1
// Import this library alongside UserInterface. Call factories synchronously.
// Factories create controls; existing inventory callbacks must be retained.
// Example: UIStudioButton("inventory.slot.0", runtimeTexture).
// Pass -1 to use the designed texture; pass 0 for no texture.
// Dynamic show()/tooltip code must use UIStudioX/Y to retain edited positions.
// Model heroes are metadata only; keep Equipment.charModel and its attachment.
library UIStudioLayout initializer Init requires UserInterface
globals
    private hashtable H = InitHashtable()
endglobals
function UIStudioX takes string id returns real
    return LoadReal(H, StringHash(id), 0)
endfunction
function UIStudioY takes string id returns real
    return LoadReal(H, StringHash(id), 1)
endfunction
function UIStudioWidth takes string id returns real
    return LoadReal(H, StringHash(id), 2)
endfunction
function UIStudioHeight takes string id returns real
    return LoadReal(H, StringHash(id), 3)
endfunction
function UIStudioVisible takes string id returns boolean
    return LoadBoolean(H, StringHash(id), 10)
endfunction
function UIStudioAction takes string id, boolean rightClick returns string
    if rightClick then
        return LoadStr(H, StringHash(id), 12)
    endif
    return LoadStr(H, StringHash(id), 11)
endfunction
function UIStudioButton takes string id, integer texture returns UIButton
    local integer k = StringHash(id)
    local UIButton b
    if texture == -1 then
        set texture = LoadInteger(H,k,5)
    endif
    set b = UIButton.create(LoadReal(H,k,0),LoadReal(H,k,1),LoadReal(H,k,2),LoadReal(H,k,3),LoadReal(H,k,4),texture)
    call SetUnitVertexColor(b.picture, LoadInteger(H,k,20), LoadInteger(H,k,21), LoadInteger(H,k,22), LoadInteger(H,k,23))
    return b
endfunction
function UIStudioPicture takes string id, integer texture returns UIPicture
    local integer k = StringHash(id)
    local UIPicture pic
    if texture == -1 then
        set texture = LoadInteger(H,k,5)
    endif
    if LoadInteger(H,k,13) != 0 then
        set pic = UIPicture.createEx(LoadReal(H,k,16),LoadReal(H,k,17),LoadReal(H,k,4),LoadReal(H,k,14),LoadInteger(H,k,13),LoadReal(H,k,18),LoadReal(H,k,19),texture)
    else
        set pic = UIPicture.create(LoadReal(H,k,0),LoadReal(H,k,1),LoadReal(H,k,2),LoadReal(H,k,3),LoadReal(H,k,4),texture)
    endif
    call SetUnitVertexColor(pic.picture, LoadInteger(H,k,20), LoadInteger(H,k,21), LoadInteger(H,k,22), LoadInteger(H,k,23))
    return pic
endfunction
function UIStudioText takes string id, player p returns UIText
    local integer k = StringHash(id)
    local UIText t = UIText.createEx(p,LoadReal(H,k,0),LoadReal(H,k,1),LoadReal(H,k,4))
    call SetTextTagText(t.text,LoadStr(H,k,6),LoadReal(H,k,7)*0.0023)
    call SetTextTagColor(t.text, LoadInteger(H,k,20), LoadInteger(H,k,21), LoadInteger(H,k,22), LoadInteger(H,k,23))
    return t
endfunction
